// ============================================================================
// PROBLEM 3: Bitwise Access Control Token & Hardware Flag Manager
// Category:  Basic / Intermediate - Operating Systems & Security Architecture
//
// PROBLEM DESCRIPTION:
// In operating system kernels, file system drivers, and low-latency security
// subsystems, access permissions and device status flags are packed into
// compact bitmasks (e.g. u32) to conserve memory, enable atomic hardware
// testing, and execute authorization checks in a single CPU cycle.
//
// Requirements:
// 1. Define permission bit constants using bitwise shifts (<<):
//    - PERM_READ    = 1 << 0  (0x01)
//    - PERM_WRITE   = 1 << 1  (0x02)
//    - PERM_EXECUTE = 1 << 2  (0x04)
//    - PERM_DELETE  = 1 << 3  (0x08)
//    - PERM_ADMIN   = 1 << 4  (0x10)
//    - PERM_AUDIT   = 1 << 5  (0x20)
// 2. Implement access control functions using Velo's native bitwise operators:
//    - has_perm(mask: u32, flag: u32) -> bool       (Testing with &)
//    - grant_perm(mask: @u32, flag: u32)            (Setting with |=)
//    - revoke_perm(mask: @u32, flag: u32)           (Clearing with &= ~)
//    - toggle_perm(mask: @u32, flag: u32)           (Inverting with ^=)
// 3. Simulate a secure multi-user role authorization pipeline:
//    - Initialize a 'Guest' session with READ-only access.
//    - Promote to 'Editor' (grant WRITE).
//    - Attempt privileged system flush (requires ADMIN and AUDIT flags).
//    - Elevate to 'SuperAdmin' (grant ADMIN and AUDIT).
//    - Perform security downgrade (revoke WRITE to enforce read-only audit mode).
// 4. Print bitmask state representations and verify access gates.
// ============================================================================

use sys.io

let PERM_READ: u32    = 1 << 0
let PERM_WRITE: u32   = 1 << 1
let PERM_EXEC: u32    = 1 << 2
let PERM_DELETE: u32  = 1 << 3
let PERM_ADMIN: u32   = 1 << 4
let PERM_AUDIT: u32   = 1 << 5

act has_perm(mask: u32, flag: u32) -> bool {
    return (mask & flag) == flag
}

act grant_perm(mask: @u32, flag: u32) {
    mask.@ |= flag
}

act revoke_perm(mask: @u32, flag: u32) {
    mask.@ &= ~flag
}

act toggle_perm(mask: @u32, flag: u32) {
    mask.@ ^= flag
}

act describe_token(name: string, mask: u32) {
    io.println("--- Security Token Status for [{name}] ---")
    io.println("  Raw Mask Value : {mask}")
    let r = has_perm(mask, PERM_READ)
    let w = has_perm(mask, PERM_WRITE)
    let x = has_perm(mask, PERM_EXEC)
    let d = has_perm(mask, PERM_DELETE)
    let a = has_perm(mask, PERM_ADMIN)
    let au = has_perm(mask, PERM_AUDIT)

    io.println("  [R] READ    : {r}")
    io.println("  [W] WRITE   : {w}")
    io.println("  [X] EXEC    : {x}")
    io.println("  [D] DELETE  : {d}")
    io.println("  [A] ADMIN   : {a}")
    io.println("  [L] AUDIT   : {au}")
}

act authorize_action(action_name: string, user_mask: u32, required_flags: u32) -> bool {
    if (user_mask & required_flags) == required_flags {
        io.println("  [ACCESS GRANTED] Action '{action_name}' permitted.")
        return true
    } else {
        io.println("  [ACCESS DENIED]  Action '{action_name}' rejected! Insufficient privilege flags.")
        return false
    }
}

act main() -> i32 {
    io.println("==================================================")
    io.println("    BITWISE RBAC SECURITY TOKEN SYSTEM            ")
    io.println("==================================================")

    mut token: u32 = 0

    // 1. Assign Guest Permissions: READ
    grant_perm(@token, PERM_READ)
    describe_token("Guest User", token)

    // Attempt file write
    io.println("\nChecking Action: Update User Profile")
    authorize_action("Update User Profile", token, PERM_WRITE)

    // 2. Promote to Standard Editor: Grant WRITE and EXECUTE
    io.println("\n--- Promoting to Editor: Granting WRITE & EXECUTE ---")
    grant_perm(@token, PERM_WRITE | PERM_EXEC)
    describe_token("Editor", token)

    // Now update profile should succeed
    authorize_action("Update User Profile", token, PERM_WRITE)

    // Attempt administrative server shutdown
    io.println("\nChecking Action: Emergency Server Shutdown")
    let admin_req: u32 = PERM_ADMIN | PERM_AUDIT
    authorize_action("Emergency Server Shutdown", token, admin_req)

    // 3. Elevate to SuperAdmin: Grant ADMIN and AUDIT
    io.println("\n--- Elevating to SuperAdmin: Granting ADMIN & AUDIT ---")
    grant_perm(@token, admin_req)
    describe_token("SuperAdmin", token)

    // Now shutdown should succeed
    authorize_action("Emergency Server Shutdown", token, admin_req)

    // 4. Enforce Read-Only Audit Mode: Revoke WRITE & DELETE
    io.println("\n--- Lockdown: Revoking WRITE & DELETE Permissions ---")
    revoke_perm(@token, PERM_WRITE | PERM_DELETE)
    describe_token("Auditor (Read-Only Admin)", token)

    // Verify WRITE is now denied but ADMIN remains
    authorize_action("Update User Profile", token, PERM_WRITE)
    authorize_action("Emergency Server Shutdown", token, admin_req)

    io.println("==================================================")
    return 0
}
