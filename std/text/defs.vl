// std.text.defs - Text formatting constants, buffer utilities, and common helpers.
use "../mem/heap.vl"
use "../str.vl"

let TEXT_MAX_WIDTH: usize = 4096
let TEXT_DEFAULT_TAB_SIZE: usize = 4

// Returns true if byte is an ASCII horizontal space or tab.
act text_is_space(c: u8) -> bool {
    return c == ' ' as u8 or c == '\t' as u8
}

// Returns true if byte is a line break character ('\n' or '\r').
act text_is_newline(c: u8) -> bool {
    return c == '\n' as u8 or c == '\r' as u8
}

// Allocates and returns a substring of s from start to start + len.
act text_substr(s: string, start: usize, len: usize) -> string {
    if s == null or len == 0 { return "" }
    let slen = str.len(s)
    if start >= slen { return "" }
    mut real_len = len
    if start + real_len > slen {
        real_len = slen - start
    }
    mut buf: @u8 = heap_alloc(real_len + 1)
    if buf == null { return "" }
    mut i: usize = 0
    loop i < real_len {
        buf[i] = s[start + i]
        i += 1
    }
    buf[real_len] = 0 as u8
    return buf as string
}

// Allocates and returns a string consisting of `count` copies of character `c`.
act text_repeat_char(c: u8, count: usize) -> string {
    if count == 0 { return "" }
    mut buf: @u8 = heap_alloc(count + 1)
    if buf == null { return "" }
    mut i: usize = 0
    loop i < count {
        buf[i] = c
        i += 1
    }
    buf[count] = 0 as u8
    return buf as string
}

