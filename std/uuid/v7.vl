// std.uuid.v7 - RFC 9562 UUID Version 7 (Time-Ordered Monotonic) generator.
use "defs.vl"
use "../crypto/rand.vl"
use "../time.vl"

// Monotonic tracking state for sub-millisecond sequence increment
mut g_uuid_v7_last_ms: u64 = 0 as u64
mut g_uuid_v7_seq: u32 = 0 as u32

// Writes a 48-bit millisecond timestamp into bytes 0..5 (big-endian).
act uuid_write_ts48(ptr: @u8, ms: u64) {
    ptr[0] = ((ms >> 40) & (0xFF as u64)) as u8
    ptr[1] = ((ms >> 32) & (0xFF as u64)) as u8
    ptr[2] = ((ms >> 24) & (0xFF as u64)) as u8
    ptr[3] = ((ms >> 16) & (0xFF as u64)) as u8
    ptr[4] = ((ms >> 8) & (0xFF as u64)) as u8
    ptr[5] = (ms & (0xFF as u64)) as u8
}

// Generates a UUID Version 7 with an explicit Unix epoch timestamp in milliseconds, propagating errors.
act uuid_v7_at_try(timestamp_ms: u64) -> Uuid or string {
    mut u = uuid_nil()
    let ptr = (@u) as @u8

    // 1. Fill with random entropy
    crypto_random_bytes(ptr, 16) or return

    // 2. Set 48-bit Unix epoch millisecond timestamp
    uuid_write_ts48(ptr, timestamp_ms)

    // 3. Set version 7 (0111) in high nibble of byte 6
    ptr[6] = ((ptr[6] & (0x0F as u8)) | (0x70 as u8)) as u8

    // 4. Set variant 1 (10) in high bits of byte 8
    ptr[8] = ((ptr[8] & (0x3F as u8)) | (0x80 as u8)) as u8

    return u
}

// Generates a UUID Version 7 with an explicit Unix epoch timestamp in milliseconds.
// Aborts with a named fatal diagnostic if the OS entropy source is unavailable.
act uuid_v7_at(timestamp_ms: u64) -> Uuid {
    let res = uuid_v7_at_try(timestamp_ms)
    if !res.ok {
        velo_crypto_rand_fatal("uuid_v7_at: OS entropy source failed during UUID generation")
        return uuid_nil()
    }
    return res.val
}

// Generates a modern RFC 9562 UUID Version 7 (Unix time-ordered monotonic identifier), propagating errors.
act uuid_v7_try() -> Uuid or string {
    mut now_ms: u64 = time_now_epoch_ms() as u64
    mut u = uuid_nil()
    let ptr = (@u) as @u8

    // Fill trailing 8 bytes (bytes 8..15) with cryptographically secure random bytes
    let rand_buf = ((ptr as usize) + 8) as @u8
    crypto_random_bytes(rand_buf, 8) or return

    // Monotonic counter protection for calls within the exact same millisecond
    if now_ms > g_uuid_v7_last_ms {
        g_uuid_v7_last_ms = now_ms
        // Seed 12-bit sequence counter with low random bits
        let seq_seed = (rand_buf[0] as u32) | ((rand_buf[1] as u32) << 8)
        g_uuid_v7_seq = seq_seed & (0x0FFF as u32)
    } else {
        // Same millisecond or clock stepped back: monotonically increment 12-bit counter
        g_uuid_v7_seq = (g_uuid_v7_seq + (1 as u32)) & (0x0FFF as u32)
        if g_uuid_v7_seq == (0 as u32) {
            // Sequence counter overflowed within same millisecond: advance timestamp
            g_uuid_v7_last_ms += 1 as u64
        }
        now_ms = g_uuid_v7_last_ms
    }

    // Set 48-bit timestamp
    uuid_write_ts48(ptr, now_ms)

    // Set version 7 (0x70) + high 4 bits of 12-bit sequence in byte 6
    let seq_hi = ((g_uuid_v7_seq >> 8) & (0x0F as u32)) as u8
    ptr[6] = ((0x70 as u8) | seq_hi) as u8

    // Low 8 bits of sequence in byte 7
    let seq_lo = (g_uuid_v7_seq & (0xFF as u32)) as u8
    ptr[7] = seq_lo

    // Set variant 1 (0x80) in byte 8
    ptr[8] = ((ptr[8] & (0x3F as u8)) | (0x80 as u8)) as u8

    return u
}

// Generates a modern RFC 9562 UUID Version 7 (Unix time-ordered monotonic identifier).
// Aborts with a named fatal diagnostic if the OS entropy source is unavailable.
act uuid_v7() -> Uuid {
    let res = uuid_v7_try()
    if !res.ok {
        velo_crypto_rand_fatal("uuid_v7: OS entropy source failed during UUID generation")
        return uuid_nil()
    }
    return res.val
}

// Extracts the 48-bit Unix timestamp in milliseconds from a UUID Version 7.
act uuid_timestamp_ms(u: @Uuid) -> u64 {
    if u == null { return 0 as u64 }
    let ptr = u as @u8
    let b0 = ptr[0] as u64
    let b1 = ptr[1] as u64
    let b2 = ptr[2] as u64
    let b3 = ptr[3] as u64
    let b4 = ptr[4] as u64
    let b5 = ptr[5] as u64

    return (b0 << 40) | (b1 << 32) | (b2 << 24) | (b3 << 16) | (b4 << 8) | b5
}
