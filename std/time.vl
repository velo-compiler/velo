// Pure Velo standard time library (zero C runtime dependencies).
// Provides high-resolution monotonic clocks, wall-clock Unix epoch timestamps,
// nanosecond Duration arithmetic, Stopwatch benchmarking, thread sleeping,
// Gregorian calendar conversions, ISO-8601 formatting, and timezone / local time.
use "time/clock.vl"
use "time/duration.vl"
use "time/sleep.vl"
use "time/calendar.vl"
use "time/tz.vl"
