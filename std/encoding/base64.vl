// std.encoding.base64 — RFC 4648 Base64 and URL-safe Base64 encoder/decoder.
use "../mem/heap.vl"

let B64_STD_CHARS: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
let B64_URL_CHARS: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// Encodes raw binary data into a standard Base64 string with padding.
act base64_encode(data: @u8, len: usize) -> string {
    return base64_encode_custom(data, len, B64_STD_CHARS, true)
}

// Encodes a string into a standard Base64 string.
act base64_encode_str(s: string) -> string {
    if s == null { return "" }
    return base64_encode(s as @u8, str.len(s))
}

// Encodes raw binary data into a URL-safe Base64 string (optionally padded).
act base64_url_encode(data: @u8, len: usize, pad: bool) -> string {
    return base64_encode_custom(data, len, B64_URL_CHARS, pad)
}

// Encodes a string into a URL-safe Base64 string.
act base64_url_encode_str(s: string, pad: bool) -> string {
    if s == null { return "" }
    return base64_url_encode(s as @u8, str.len(s), pad)
}

// Low-level configurable Base64 encoder.
act base64_encode_custom(data: @u8, len: usize, table: string, pad: bool) -> string {
    if data == null or len == 0 { return "" }

    let full_triplets = len / 3
    let remainder = len % 3

    mut out_len = full_triplets * 4
    if remainder == 1 {
        if pad { out_len += 4 } else { out_len += 2 }
    } else if remainder == 2 {
        if pad { out_len += 4 } else { out_len += 3 }
    }

    let out: @u8 = heap_alloc(out_len + 1)
    if out == null { return "" }

    mut in_idx: usize = 0
    mut out_idx: usize = 0

    loop in_idx + 2 < len {
        let b0 = data[in_idx] as u32
        let b1 = data[in_idx + 1] as u32
        let b2 = data[in_idx + 2] as u32
        let triple = (b0 << 16) | (b1 << 8) | b2

        out[out_idx] = table[((triple >> 18) & 0x3F) as usize]
        out[out_idx + 1] = table[((triple >> 12) & 0x3F) as usize]
        out[out_idx + 2] = table[((triple >> 6) & 0x3F) as usize]
        out[out_idx + 3] = table[(triple & 0x3F) as usize]

        in_idx += 3
        out_idx += 4
    }

    if remainder == 1 {
        let b0 = data[in_idx] as u32
        let triple = b0 << 16

        out[out_idx] = table[((triple >> 18) & 0x3F) as usize]
        out[out_idx + 1] = table[((triple >> 12) & 0x3F) as usize]
        out_idx += 2

        if pad {
            out[out_idx] = '=' as u8
            out[out_idx + 1] = '=' as u8
            out_idx += 2
        }
    } else if remainder == 2 {
        let b0 = data[in_idx] as u32
        let b1 = data[in_idx + 1] as u32
        let triple = (b0 << 16) | (b1 << 8)

        out[out_idx] = table[((triple >> 18) & 0x3F) as usize]
        out[out_idx + 1] = table[((triple >> 12) & 0x3F) as usize]
        out[out_idx + 2] = table[((triple >> 6) & 0x3F) as usize]
        out_idx += 3

        if pad {
            out[out_idx] = '=' as u8
            out_idx += 1
        }
    }

    out[out_idx] = 0 as u8
    return out as string
}

// Decodes a Base64 character to its 6-bit index (supports both standard and URL-safe).
act base64_char_to_val(c: u8) -> u32 {
    if c >= ('A' as u8) and c <= ('Z' as u8) {
        return (c - ('A' as u8)) as u32
    }
    if c >= ('a' as u8) and c <= ('z' as u8) {
        return (c - ('a' as u8) + 26) as u32
    }
    if c >= ('0' as u8) and c <= ('9' as u8) {
        return (c - ('0' as u8) + 52) as u32
    }
    if c == ('+' as u8) or c == ('-' as u8) {
        return 62 as u32
    }
    if c == ('/' as u8) or c == ('_' as u8) {
        return 63 as u32
    }
    return 255 as u32
}

// Checks if a string is a valid Base64 encoded payload.
act base64_is_valid(s: string) -> bool {
    if s == null { return false }
    let len = str.len(s)
    if len == 0 { return true }

    mut i: usize = 0
    mut pad_count: usize = 0

    loop i < len {
        let c = s[i]
        if c == ('=' as u8) {
            pad_count += 1
            if pad_count > 2 { return false }
        } else {
            if pad_count > 0 { return false } // No chars allowed after '='
            if base64_char_to_val(c) == 255 as u32 {
                return false
            }
        }
        i += 1
    }
    return true
}

// Decodes a Base64 string into a raw heap byte buffer.
// The actual decoded length is stored in out_len if provided.
act base64_decode(s: string, out_len: @usize) -> @u8 {
    if s == null {
        if out_len != null { out_len[0] = 0 }
        return null
    }

    let in_len = str.len(s)
    if in_len == 0 {
        if out_len != null { out_len[0] = 0 }
        let empty_buf: @u8 = heap_alloc(1)
        empty_buf[0] = 0 as u8
        return empty_buf
    }

    // Estimate maximum decoded size: (in_len * 3) / 4 + 4
    let max_bytes = ((in_len * 3) / 4) + 4
    let dest: @u8 = heap_alloc(max_bytes + 1)
    if dest == null {
        if out_len != null { out_len[0] = 0 }
        return null
    }

    mut in_idx: usize = 0
    mut dest_idx: usize = 0
    mut c0: u32 = 0 as u32
    mut c1: u32 = 0 as u32
    mut c2: u32 = 0 as u32
    mut c3: u32 = 0 as u32
    mut chunk_count: usize = 0

    loop in_idx < in_len {
        let c = s[in_idx]
        in_idx += 1

        if c == ('=' as u8) {
            // Padding reached
            break
        }

        let val = base64_char_to_val(c)
        if val < 64 as u32 {
            if chunk_count == 0 { c0 = val }
            else if chunk_count == 1 { c1 = val }
            else if chunk_count == 2 { c2 = val }
            else if chunk_count == 3 { c3 = val }
            chunk_count += 1

            if chunk_count == 4 {
                let triple = (c0 << 18) | (c1 << 12) | (c2 << 6) | c3

                dest[dest_idx] = ((triple >> 16) & 0xFF) as u8
                dest[dest_idx + 1] = ((triple >> 8) & 0xFF) as u8
                dest[dest_idx + 2] = (triple & 0xFF) as u8
                dest_idx += 3
                chunk_count = 0
            }
        }
    }

    if chunk_count == 2 {
        let triple = (c0 << 18) | (c1 << 12)
        dest[dest_idx] = ((triple >> 16) & 0xFF) as u8
        dest_idx += 1
    } else if chunk_count == 3 {
        let triple = (c0 << 18) | (c1 << 12) | (c2 << 6)
        dest[dest_idx] = ((triple >> 16) & 0xFF) as u8
        dest[dest_idx + 1] = ((triple >> 8) & 0xFF) as u8
        dest_idx += 2
    }

    dest[dest_idx] = 0 as u8
    if out_len != null {
        out_len[0] = dest_idx
    }
    return dest
}

// Decodes a Base64 string directly into a heap string.
act base64_decode_str(s: string) -> string {
    mut decoded_len: usize = 0
    let bytes = base64_decode(s, @decoded_len)
    if bytes == null { return "" }
    return bytes as string
}

// Decodes a Base64 string into a heap string, returning decoded text or error message.
act base64_to_str(s: string) -> string or string {
    if s == null { fail "null base64 string" }
    if !base64_is_valid(s) { fail "invalid base64 format or padding" }
    mut decoded_len: usize = 0
    let bytes = base64_decode(s, @decoded_len)
    if bytes == null { fail "failed to decode base64 string" }
    return bytes as string
}

// Decodes a URL-safe Base64 string directly into a heap string.
act base64_url_decode_str(s: string) -> string {
    return base64_decode_str(s)
}

// Decodes a URL-safe Base64 string into a raw heap byte buffer.
act base64_url_decode(s: string, out_len: @usize) -> @u8 {
    return base64_decode(s, out_len)
}
