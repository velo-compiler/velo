// std.http.url - HTTP URL parsing, percent-encoding, and decoding.
use "../mem/heap.vl"
use "../url.vl"

view data HttpUrl {
    scheme: string
    host: string
    port: u16
    path: string
    query: string
    hostname: string
}

// Parses an HTTP or HTTPS URL into its constituent components.
view act http_parse_url(url_str: string) -> HttpUrl {
    mut res = HttpUrl {
        scheme: "http",
        host: "127.0.0.1",
        port: 80 as u16,
        path: "/",
        query: "",
        hostname: "127.0.0.1",
    }
    if url_str == null { return res }
    let len = str.len(url_str)
    if len == 0 { return res }

    mut pos: usize = 0

    // Check scheme: "http://" or "https://"
    if str.starts_with(url_str, "http://") {
        res.scheme = "http"
        res.port = 80 as u16
        pos = 7
    } else if str.starts_with(url_str, "https://") {
        res.scheme = "https"
        res.port = 443 as u16
        pos = 8
    }

    // If string starts with '/', it's a relative path with no scheme/host
    if pos == 0 and url_str[0] == '/' as u8 {
        // Path and query only
        mut q_idx: usize = 0
        mut has_q = false
        mut k: usize = 0
        loop k < len {
            if url_str[k] == '?' as u8 and not has_q {
                q_idx = k
                has_q = true
            }
            k += 1
        }
        if has_q {
            res.path = url_substr(url_str, 0, q_idx)
            res.query = url_substr(url_str, q_idx + 1, len - (q_idx + 1))
        } else {
            res.path = url_substr(url_str, 0, len)
            res.query = ""
        }
        return res
    }

    // Parse host and optional port
    let host_start = pos
    mut host_end = len
    mut port_start: usize = 0
    mut has_port = false

    mut j = pos
    loop j < len {
        let c = url_str[j]
        if c == '/' as u8 or c == '?' as u8 {
            if not has_port {
                host_end = j
            }
            break
        }
        if c == ':' as u8 and not has_port {
            host_end = j
            port_start = j + 1
            has_port = true
        }
        j += 1
    }

    let raw_host = url_substr(url_str, host_start, host_end - host_start)
    res.hostname = raw_host
    res.host = raw_host
    if res.host == "localhost" {
        res.host = "127.0.0.1"
    }

    if has_port {
        mut p_end = len
        if j < len {
            p_end = j
        }
        let p_len = p_end - port_start
        if p_len > 0 {
            mut p_val: u32 = 0
            mut pi: usize = 0
            loop pi < p_len {
                let pc = url_str[port_start + pi]
                if pc >= '0' as u8 and pc <= '9' as u8 {
                    p_val = p_val * 10 + ((pc - ('0' as u8)) as u32)
                }
                pi += 1
            }
            res.port = p_val as u16
        }
    }

    // Parse path and query
    if j < len {
        if url_str[j] == '/' as u8 {
            let path_start = j
            mut q_pos = len
            mut has_query = false
            mut m = j
            loop m < len {
                if url_str[m] == '?' as u8 {
                    q_pos = m
                    has_query = true
                    break
                }
                m += 1
            }
            res.path = url_substr(url_str, path_start, q_pos - path_start)
            if has_query and q_pos + 1 < len {
                res.query = url_substr(url_str, q_pos + 1, len - (q_pos + 1))
            } else {
                res.query = ""
            }
        } else if url_str[j] == '?' as u8 {
            res.path = "/"
            if j + 1 < len {
                res.query = url_substr(url_str, j + 1, len - (j + 1))
            } else {
                res.query = ""
            }
        }
    } else {
        res.path = "/"
        res.query = ""
    }

    return res
}
