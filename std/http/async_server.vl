// std.http.async_server — Non-blocking asynchronous HTTP/1.1 server on std.async.
use "request.vl"
use "response.vl"
use "headers.vl"
use "status.vl"
use "fast_writer.vl"
use "../async.vl"
use "../mem/heap.vl"

data AsyncHttpExchange {
    stream: @AsyncTcpStream
    req: HttpRequest
    is_responded: bool
    conn_ptr: @void
}

data _AsyncHttpServerConn {
    stream: @AsyncTcpStream
    server_ptr: @AsyncHttpServer
    buf: @u8
    len: usize
    cap: usize
    header_end: usize
    content_length: usize
    has_header_end: bool
    is_pooled: bool
    in_use: bool
    ex: AsyncHttpExchange
}

data AsyncHttpServer {
    listener: @AsyncTcpListener
    loop_ptr: @EventLoop
    on_request: act(@AsyncHttpExchange) -> void
    is_running: bool
    conns: @_AsyncHttpServerConn
    conn_cap: usize
}

act async_http_exchange_sizeof() -> usize {
    let dummy: @AsyncHttpExchange = null
    return (dummy + 1) as usize
}

act async_http_server_sizeof() -> usize {
    let dummy: @AsyncHttpServer = null
    return (dummy + 1) as usize
}

act async_http_server_conn_sizeof() -> usize {
    let dummy: @_AsyncHttpServerConn = null
    return (dummy + 1) as usize
}

act _http_server_conn_append(conn: @_AsyncHttpServerConn, data: @u8, len: usize) {
    if conn == null or data == null or len == 0 { return }
    if conn.len + len + 1 >= conn.cap {
        let new_cap = (conn.cap * 2) + len + 16
        let new_buf = heap_alloc(new_cap) as @u8
        if new_buf == null { return }
        mut i: usize = 0
        loop i < conn.len {
            new_buf[i] = conn.buf[i]
            i += 1
        }
        if not conn.is_pooled {
            heap_free(conn.buf)
        }
        conn.buf = new_buf
        conn.cap = new_cap
        conn.is_pooled = false
    }
    mut j: usize = 0
    loop j < len {
        conn.buf[conn.len + j] = data[j]
        j += 1
    }
    conn.len += len
    conn.buf[conn.len] = 0 as u8
}

act _async_http_acquire_conn(server: @AsyncHttpServer, stream: @AsyncTcpStream) -> @_AsyncHttpServerConn {
    if server != null and server.conns != null {
        mut i: usize = 0
        loop i < server.conn_cap {
            let c = @server.conns[i]
            if not c.in_use {
                c.in_use = true
                c.stream = stream
                c.server_ptr = server
                c.len = 0
                c.header_end = 0
                c.content_length = 0
                c.has_header_end = false
                return c
            }
            i += 1
        }
    }

    let conn = heap_alloc(async_http_server_conn_sizeof()) as @_AsyncHttpServerConn
    conn.stream = stream
    conn.server_ptr = server
    conn.cap = 8192
    conn.buf = heap_alloc(conn.cap) as @u8
    conn.len = 0
    conn.header_end = 0
    conn.content_length = 0
    conn.has_header_end = false
    conn.is_pooled = false
    conn.in_use = true
    return conn
}

act _async_http_release_conn(conn: @_AsyncHttpServerConn) {
    if conn == null { return }
    if conn.is_pooled {
        conn.in_use = false
        conn.stream = null
        conn.len = 0
        conn.has_header_end = false
    } else {
        if conn.buf != null {
            heap_free(conn.buf)
            conn.buf = null
        }
        heap_free(conn as @u8)
    }
}

act _async_http_on_data(stream: @AsyncTcpStream, data: @u8, len: usize) {
    if stream == null or stream.tag == null { return }
    let conn = stream.tag as @_AsyncHttpServerConn
    _http_server_conn_append(conn, data, len)

    if not conn.has_header_end {
        mut h_end: usize = 0
        if _http_scan_header_end(conn.buf, conn.len, @h_end) {
            conn.has_header_end = true
            conn.header_end = h_end
            conn.content_length = _http_extract_content_length(conn.buf, h_end)
        }
    }

    if conn.has_header_end {
        if conn.len >= conn.header_end + conn.content_length {
            let raw_str = conn.buf as string
            let parsed_req = http_parse_request(raw_str)

            let ex = @conn.ex
            ex.stream = stream
            ex.req = parsed_req
            ex.is_responded = false
            ex.conn_ptr = conn as @void

            let srv = conn.server_ptr
            if srv != null and srv.on_request != null {
                let handler = srv.on_request
                handler(ex)
            }
        }
    }
}

act _async_http_on_close(stream: @AsyncTcpStream) {
    if stream == null or stream.tag == null { return }
    let conn = stream.tag as @_AsyncHttpServerConn
    _async_http_release_conn(conn)
}

act _async_http_on_connection(stream: @AsyncTcpStream) {
    if stream == null or stream.listener == null or stream.listener.tag == null { return }
    let server = stream.listener.tag as @AsyncHttpServer
    let conn = _async_http_acquire_conn(server, stream)
    stream.tag = conn as @void

    async_tcp_stream_on_data(stream, _async_http_on_data)
    async_tcp_stream_on_close(stream, _async_http_on_close)
}

// Binds an asynchronous non-blocking HTTP server to the specified host and port on the EventLoop
act async_http_listen(el: @EventLoop, host: string, port: u16, on_request: act(@AsyncHttpExchange) -> void) -> @AsyncHttpServer {
    if el == null or on_request == null { return null }

    let server = heap_alloc(async_http_server_sizeof()) as @AsyncHttpServer
    server.loop_ptr = el
    server.on_request = on_request
    server.is_running = true

    // Initialize 64 pre-allocated connection buffers for zero-alloc fast path
    let pool_size: usize = 64
    server.conn_cap = pool_size
    server.conns = heap_alloc(pool_size * async_http_server_conn_sizeof()) as @_AsyncHttpServerConn
    if server.conns != null {
        mut i: usize = 0
        loop i < pool_size {
            let c = @server.conns[i]
            c.stream = null
            c.server_ptr = server
            c.cap = 8192
            c.buf = heap_alloc(c.cap) as @u8
            c.len = 0
            c.header_end = 0
            c.content_length = 0
            c.has_header_end = false
            c.is_pooled = true
            c.in_use = false
            i += 1
        }
    }

    let listener = async_tcp_listen(el, host, port, _async_http_on_connection)
    if listener == null {
        if server.conns != null {
            mut j: usize = 0
            loop j < server.conn_cap {
                let c = @server.conns[j]
                if c.buf != null { heap_free(c.buf) }
                j += 1
            }
            heap_free(server.conns as @u8)
        }
        heap_free(server as @u8)
        return null
    }
    listener.tag = server as @void
    server.listener = listener
    return server
}

// Sends an HTTP response with headers and body to the client, then closes the connection
act async_http_respond(ex: @AsyncHttpExchange, status: u16, content_type: string, body: string) -> bool {
    if ex == null or ex.stream == null or ex.is_responded { return false }
    ex.is_responded = true

    let stream = ex.stream
    mut conn: @_AsyncHttpServerConn = null
    if ex.conn_ptr != null {
        conn = ex.conn_ptr as @_AsyncHttpServerConn
    }

    mut b_len: usize = 0
    if body != null {
        b_len = str.len(body)
    }

    if conn != null and conn.buf != null and (b_len + 256 <= conn.cap) {
        let buf = conn.buf
        mut pos: usize = 0

        _http_fast_write_str(buf, @pos, "HTTP/1.1 ")
        _http_fast_write_u64(buf, @pos, status as u64)
        buf[pos] = ' ' as u8; pos += 1
        _http_fast_write_str(buf, @pos, http_status_text(status))
        buf[pos] = '\r' as u8; pos += 1
        buf[pos] = '\n' as u8; pos += 1

        if content_type != null and str.len(content_type) > 0 {
            _http_fast_write_str(buf, @pos, "Content-Type: ")
            _http_fast_write_str(buf, @pos, content_type)
            buf[pos] = '\r' as u8; pos += 1
            buf[pos] = '\n' as u8; pos += 1
        }

        _http_fast_write_str(buf, @pos, "Connection: close\r\nContent-Length: ")
        _http_fast_write_u64(buf, @pos, b_len as u64)
        buf[pos] = '\r' as u8; pos += 1
        buf[pos] = '\n' as u8; pos += 1
        buf[pos] = '\r' as u8; pos += 1
        buf[pos] = '\n' as u8; pos += 1

        if b_len > 0 {
            _http_fast_write_str(buf, @pos, body)
        }

        async_tcp_stream_write(stream, buf, pos)
    } else {
        mut res = http_response_make(status, body)
        if content_type != null and str.len(content_type) > 0 {
            headers_set(@res.headers, "Content-Type", content_type)
        }
        headers_set(@res.headers, "Connection", "close")
        headers_set(@res.headers, "Content-Length", http_u64_to_str(res.content_length as u64))

        let wire_res = http_format_response(@res)
        async_tcp_stream_write_str(stream, wire_res)
        heap_free(wire_res as @u8)
        http_response_free(@res)
    }

    async_tcp_stream_close(stream)
    if conn != null {
        _async_http_release_conn(conn)
    } else {
        heap_free(ex as @u8)
    }
    return true
}

// Responds with a text/plain payload
act async_http_respond_text(ex: @AsyncHttpExchange, status: u16, text: string) -> bool {
    return async_http_respond(ex, status, "text/plain; charset=utf-8", text)
}

// Responds with an application/json payload
act async_http_respond_json(ex: @AsyncHttpExchange, status: u16, json: string) -> bool {
    return async_http_respond(ex, status, "application/json; charset=utf-8", json)
}

// Responds with a text/html payload
act async_http_respond_html(ex: @AsyncHttpExchange, status: u16, html: string) -> bool {
    return async_http_respond(ex, status, "text/html; charset=utf-8", html)
}

// Shuts down the asynchronous HTTP server listener and releases resources
act async_http_server_close(server: @AsyncHttpServer) {
    if server == null or not server.is_running { return }
    server.is_running = false
    if server.listener != null {
        async_tcp_listener_close(server.listener)
        server.listener = null
    }
    if server.conns != null {
        mut i: usize = 0
        loop i < server.conn_cap {
            let c = @server.conns[i]
            if c.buf != null {
                heap_free(c.buf)
                c.buf = null
            }
            i += 1
        }
        heap_free(server.conns as @u8)
        server.conns = null
    }
    heap_free(server as @u8)
}
