// std.http.fast_writer — Zero-allocation wire formatters and fast header scanners.
use "../mem/heap.vl"

// Scans for CRLF CRLF (\r\n\r\n) or LF LF (\n\n) to locate header end
act _http_scan_header_end(buf: @u8, len: usize, out_end: @usize) -> bool {
    if buf == null or len < 4 { return false }
    mut i: usize = 0
    loop i + 3 < len {
        if buf[i] == '\r' as u8 and buf[i + 1] == '\n' as u8 and
           buf[i + 2] == '\r' as u8 and buf[i + 3] == '\n' as u8 {
            out_end[0] = i + 4
            return true
        }
        if buf[i] == '\n' as u8 and buf[i + 1] == '\n' as u8 {
            out_end[0] = i + 2
            return true
        }
        i += 1
    }
    return false
}

// Case-insensitive extractor for Content-Length header value
act _http_extract_content_length(buf: @u8, header_end: usize) -> usize {
    if buf == null or header_end < 16 { return 0 }
    let target = "content-length"
    let tlen: usize = 14
    mut i: usize = 0
    loop i + tlen < header_end {
        mut match = true
        mut k: usize = 0
        loop k < tlen {
            mut c = buf[i + k]
            if c >= 'A' as u8 and c <= 'Z' as u8 { c = c + (32 as u8) }
            if c != target[k] as u8 {
                match = false
                break
            }
            k += 1
        }
        if match {
            mut pos = i + tlen
            loop pos < header_end and (buf[pos] == ':' as u8 or buf[pos] == ' ' as u8 or buf[pos] == '\t' as u8) {
                pos += 1
            }
            mut val: usize = 0
            loop pos < header_end and buf[pos] >= '0' as u8 and buf[pos] <= '9' as u8 {
                val = val * 10 + ((buf[pos] - ('0' as u8)) as usize)
                pos += 1
            }
            return val
        }
        i += 1
    }
    return 0
}

act _http_fast_write_u64(buf: @u8, pos: @usize, val: u64) {
    if val == (0 as u64) {
        buf[pos[0]] = '0' as u8
        pos[0] = pos[0] + 1
        return
    }
    mut v = val
    mut digits: usize = 0
    loop v > (0 as u64) {
        digits += 1
        v = v / (10 as u64)
    }
    v = val
    mut idx = pos[0] + digits - 1
    loop v > (0 as u64) {
        buf[idx] = ('0' as u8) + ((v % (10 as u64)) as u8)
        v = v / (10 as u64)
        if idx > 0 { idx -= 1 }
    }
    pos[0] = pos[0] + digits
}

act _http_fast_write_str(buf: @u8, pos: @usize, s: string) {
    if s == null { return }
    let len = str.len(s)
    mut i: usize = 0
    loop i < len {
        buf[pos[0]] = s[i] as u8
        pos[0] = pos[0] + 1
        i += 1
    }
}
