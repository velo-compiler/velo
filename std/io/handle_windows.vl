// Raw OS standard handle and file descriptor provider for Windows.
// Backed directly by Win32 kernel services (GetStdHandle, WriteFile, ReadFile, CreateFileA, etc.).

// Standard Handle and Seek Constants
let INVALID_HANDLE: usize = (0 - 1) as usize

let IO_SEEK_SET: i32 = 0
let IO_SEEK_CUR: i32 = 1
let IO_SEEK_END: i32 = 2

// File Open Mode Flags
let IO_READ: u32 = 1
let IO_WRITE: u32 = 2
let IO_APPEND: u32 = 4
let IO_CREATE: u32 = 8
let IO_TRUNCATE: u32 = 16

// Strong typed OS file handle wrapper
data FileHandle {
    os_handle: usize
}

// Foreign interface to Windows kernel services
extern act GetStdHandle(nStdHandle: u32) -> @u8
extern act WriteFile(hFile: @u8, lpBuffer: @u8, nBytesToWrite: u32, lpBytesWritten: @u32, lpOverlapped: @u8) -> i32
extern act ReadFile(hFile: @u8, lpBuffer: @u8, nBytesToRead: u32, lpBytesRead: @u32, lpOverlapped: @u8) -> i32
extern act SetFilePointerEx(hFile: @u8, liDistanceToMove: i64, lpNewFilePointer: @i64, dwMoveMethod: u32) -> i32
extern act GetFileSizeEx(hFile: @u8, lpFileSize: @i64) -> i32
extern act CloseHandle(hObject: @void) -> i32
extern act CreateFileA(lpFileName: @u8, dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: @u8, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: @u8) -> @u8
extern act velo_fs_remove(path: string) -> bool

// Retrieves raw OS standard input handle (STDIN)
act io_stdin_handle() -> FileHandle {
    let std_in = (0 - 10) as u32
    let h = GetStdHandle(std_in)
    return FileHandle { os_handle: h as usize }
}

// Retrieves raw OS standard output handle (STDOUT)
act io_stdout_handle() -> FileHandle {
    let std_out = (0 - 11) as u32
    let h = GetStdHandle(std_out)
    return FileHandle { os_handle: h as usize }
}

// Retrieves raw OS standard error handle (STDERR)
act io_stderr_handle() -> FileHandle {
    let std_err = (0 - 12) as u32
    let h = GetStdHandle(std_err)
    return FileHandle { os_handle: h as usize }
}

// Checks if a handle is valid (non-null and not INVALID_HANDLE_VALUE)
act io_is_valid_handle(h: FileHandle) -> bool {
    return h.os_handle != 0 and h.os_handle != INVALID_HANDLE
}

// Performs a raw unbuffered write of data to the given OS handle.
// Automatically chunks requests exceeding 2GB. Returns total bytes written.
act io_raw_write(h: FileHandle, data: @u8, len: usize) -> usize {
    if !io_is_valid_handle(h) or data == null or len == 0 {
        return 0
    }
    let base_addr: usize = data as usize
    mut total_written: usize = 0
    mut remaining = len
    loop remaining > 0 {
        mut chunk: u32 = 0x7FFFFFFF as u32
        if (remaining as u64) < (chunk as u64) {
            chunk = remaining as u32
        }
        mut written: u32 = 0
        let cur_ptr = (base_addr + total_written) as @u8
        let ok = WriteFile(h.os_handle as @u8, cur_ptr, chunk, @written, null)
        if ok == 0 or written == 0 as u32 {
            break
        }
        total_written += written as usize
        remaining -= written as usize
    }
    return total_written
}

// Performs a raw unbuffered read from the given OS handle into buf.
// Returns the number of bytes read (> 0), 0 on EOF, or -1 on error.
act io_raw_read(h: FileHandle, buf: @u8, max_len: usize) -> isize {
    if !io_is_valid_handle(h) or buf == null or max_len == 0 {
        return -1
    }
    mut chunk: u32 = 0x7FFFFFFF as u32
    if (max_len as u64) < (chunk as u64) {
        chunk = max_len as u32
    }
    mut read_bytes: u32 = 0
    let ok = ReadFile(h.os_handle as @u8, buf, chunk, @read_bytes, null)
    if ok == 0 {
        return -1
    }
    return read_bytes as isize
}

// Repositions read/write file offset.
// whence: SEEK_SET (0), SEEK_CUR (1), SEEK_END (2).
// Returns new offset or -1 on error.
act io_raw_seek(h: FileHandle, offset: i64, whence: i32) -> i64 {
    if !io_is_valid_handle(h) {
        return -1 as i64
    }
    mut move_method: u32 = 0 as u32
    if whence == IO_SEEK_CUR {
        move_method = 1 as u32
    } else if whence == IO_SEEK_END {
        move_method = 2 as u32
    }
    mut new_pos: i64 = 0
    let ok = SetFilePointerEx(h.os_handle as @u8, offset, @new_pos, move_method)
    if ok == 0 {
        return -1 as i64
    }
    return new_pos
}

// Returns the file size in bytes, or -1 on error.
act io_file_size(h: FileHandle) -> i64 {
    if !io_is_valid_handle(h) {
        return -1 as i64
    }
    mut size: i64 = 0
    let ok = GetFileSizeEx(h.os_handle as @u8, @size)
    if ok == 0 {
        return -1 as i64
    }
    return size
}

// Closes a file handle. Standard handles (stdin/stdout/stderr) are protected from closure.
act io_file_close(h: FileHandle) -> bool {
    if !io_is_valid_handle(h) {
        return false
    }
    let stdin_h = io_stdin_handle().os_handle
    let stdout_h = io_stdout_handle().os_handle
    let stderr_h = io_stderr_handle().os_handle
    if h.os_handle == stdin_h or h.os_handle == stdout_h or h.os_handle == stderr_h {
        return false
    }
    let res = CloseHandle(h.os_handle as @void)
    return res != 0
}

// Opens a file by C-string path with mode_flags (combination of IO_READ, IO_WRITE, IO_CREATE, IO_TRUNCATE, IO_APPEND).
act io_file_open(path: @u8, flags: u32) -> FileHandle {
    if path == null {
        return FileHandle { os_handle: INVALID_HANDLE }
    }
    mut access: u32 = 0
    if (flags & IO_READ) != 0 as u32 {
        access = access | (0x80000000 as u32)
    }
    if (flags & IO_WRITE) != 0 as u32 or (flags & IO_APPEND) != 0 as u32 {
        access = access | (0x40000000 as u32)
    }

    mut disposition: u32 = 3 as u32 // OPEN_EXISTING
    if (flags & IO_CREATE) != 0 as u32 {
        if (flags & IO_TRUNCATE) != 0 as u32 {
            disposition = 2 as u32 // CREATE_ALWAYS
        } else {
            disposition = 4 as u32 // OPEN_ALWAYS
        }
    } else if (flags & IO_TRUNCATE) != 0 as u32 {
        disposition = 5 as u32 // TRUNCATE_EXISTING
    }

    let share: u32 = 1 as u32 | 2 as u32 // FILE_SHARE_READ | FILE_SHARE_WRITE
    let attrs: u32 = 128 as u32 // FILE_ATTRIBUTE_NORMAL

    let h = CreateFileA(path, access, share, null, disposition, attrs, null)
    let handle_val = h as usize
    if handle_val == INVALID_HANDLE {
        return FileHandle { os_handle: INVALID_HANDLE }
    }

    let fh = FileHandle { os_handle: handle_val }
    if (flags & IO_APPEND) != 0 as u32 {
        io_raw_seek(fh, 0 as i64, IO_SEEK_END)
    }
    return fh
}

// Opens a file by Velo string path literal.
act io_file_open_str(path: string, flags: u32) -> FileHandle {
    return io_file_open(path as @u8, flags)
}

// Deletes a file by C-string path.
act io_file_delete(path: @u8) -> bool {
    if path == null { return false }
    return velo_fs_remove(path as string)
}

// Deletes a file by Velo string path literal.
act io_file_delete_str(path: string) -> bool {
    return io_file_delete(path as @u8)
}
