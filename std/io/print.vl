// Pure Velo console and stream printing API (zero C runtime dependencies).
// Replaces sys.io and libc printf with buffered, formatted, deterministic output.
// Lowers directly to std.io.buffered_writer, std.fmt.itoa, and std.fmt.ftoa.

use "../mem/page.vl"
use "../str/slice.vl"
use "../fmt/itoa.vl"
use "../fmt/ftoa.vl"
use "handle.vl"
use "buffered_writer.vl"

// Global standard stream writers
mut g_stdout_writer: BufferedWriter
mut g_stdout_init: bool = false

mut g_stderr_writer: BufferedWriter
mut g_stderr_init: bool = false

mut g_atexit_registered: bool = false
mut g_fmt_buf: @u8 = null

view extern act atexit(func: act() -> void) -> i32

// Ensures standard stream cleanup hook is registered on program exit.
view act io_ensure_atexit() {
    if !g_atexit_registered {
        atexit(io_print_cleanup)
        g_atexit_registered = true
    }
}

// Lazily acquires or returns the singleton stdout BufferedWriter.
view act io_get_stdout_writer() -> @BufferedWriter {
    if !g_stdout_init {
        io_ensure_atexit()
        g_stdout_writer = writer_init(io_stdout_handle())
        g_stdout_init = true
    }
    return @g_stdout_writer
}

// Lazily acquires or returns the singleton stderr BufferedWriter.
view act io_get_stderr_writer() -> @BufferedWriter {
    if !g_stderr_init {
        io_ensure_atexit()
        g_stderr_writer = writer_init(io_stderr_handle())
        g_stderr_init = true
    }
    return @g_stderr_writer
}

// Lazily acquires a 64-byte OS virtual memory buffer for numeric formatting.
view act io_get_fmt_buf() -> @u8 {
    if g_fmt_buf == null {
        g_fmt_buf = os_page_alloc(64)
    }
    return g_fmt_buf
}

// Explicitly flushes the stdout stream.
view act io_flush_stdout() -> bool {
    if g_stdout_init {
        return writer_flush(@g_stdout_writer)
    }
    return true
}

// Explicitly flushes the stderr stream.
view act io_flush_stderr() -> bool {
    if g_stderr_init {
        return writer_flush(@g_stderr_writer)
    }
    return true
}

// Explicitly flushes both stdout and stderr.
view act io_flush_all() -> bool {
    let ok_out = io_flush_stdout()
    let ok_err = io_flush_stderr()
    return ok_out and ok_err
}

// Releases standard stream resources and format buffer.
view act io_print_cleanup() {
    if g_stdout_init {
        writer_free(@g_stdout_writer)
        g_stdout_init = false
    }
    if g_stderr_init {
        writer_free(@g_stderr_writer)
        g_stderr_init = false
    }
    if g_fmt_buf != null {
        os_page_free(g_fmt_buf, 64)
        g_fmt_buf = null
    }
}

// ============================================================================
// Generic Stream Print API (fprint / fprintln)
// ============================================================================

view act fprint(w: @BufferedWriter, s: StrSlice) {
    if w == null { return }
    writer_write_slice(w, s)
}

view act fprintln(w: @BufferedWriter, s: StrSlice) {
    if w == null { return }
    writer_write_slice(w, s)
    writer_write_byte(w, 10 as u8) // '\n'
    writer_flush(w)
}

view act fprint_str(w: @BufferedWriter, s: string) {
    fprint(w, slice_from_str(s))
}

view act fprintln_str(w: @BufferedWriter, s: string) {
    fprintln(w, slice_from_str(s))
}

view act fprintln_empty(w: @BufferedWriter) {
    if w == null { return }
    writer_write_byte(w, 10 as u8)
    writer_flush(w)
}

view act fprint_byte(w: @BufferedWriter, b: u8) {
    if w == null { return }
    writer_write_byte(w, b)
}

view act fprintln_byte(w: @BufferedWriter, b: u8) {
    if w == null { return }
    writer_write_byte(w, b)
    writer_write_byte(w, 10 as u8)
    writer_flush(w)
}

view act fprint_i64(w: @BufferedWriter, val: i64) {
    let buf = io_get_fmt_buf()
    let s = format_i64(val, buf, 64)
    fprint(w, s)
}

view act fprintln_i64(w: @BufferedWriter, val: i64) {
    let buf = io_get_fmt_buf()
    let s = format_i64(val, buf, 64)
    fprintln(w, s)
}

view act fprint_u64(w: @BufferedWriter, val: u64) {
    let buf = io_get_fmt_buf()
    let s = format_u64(val, buf, 64)
    fprint(w, s)
}

view act fprintln_u64(w: @BufferedWriter, val: u64) {
    let buf = io_get_fmt_buf()
    let s = format_u64(val, buf, 64)
    fprintln(w, s)
}

view act fprint_f64(w: @BufferedWriter, val: f64, precision: i32) {
    let buf = io_get_fmt_buf()
    let s = format_f64(val, precision, buf, 64)
    fprint(w, s)
}

view act fprintln_f64(w: @BufferedWriter, val: f64, precision: i32) {
    let buf = io_get_fmt_buf()
    let s = format_f64(val, precision, buf, 64)
    fprintln(w, s)
}

view act fprint_bool(w: @BufferedWriter, val: bool) {
    if val {
        fprint(w, slice_from_str("true"))
    } else {
        fprint(w, slice_from_str("false"))
    }
}

view act fprintln_bool(w: @BufferedWriter, val: bool) {
    if val {
        fprintln(w, slice_from_str("true"))
    } else {
        fprintln(w, slice_from_str("false"))
    }
}

// ============================================================================
// Standard Output Print API (print / println)
// ============================================================================

view act print(s: StrSlice) {
    fprint(io_get_stdout_writer(), s)
}

view act println(s: StrSlice) {
    fprintln(io_get_stdout_writer(), s)
}

view act print_str(s: string) {
    fprint_str(io_get_stdout_writer(), s)
}

view act println_str(s: string) {
    fprintln_str(io_get_stdout_writer(), s)
}

view act println_empty() {
    fprintln_empty(io_get_stdout_writer())
}

view act print_byte(b: u8) {
    fprint_byte(io_get_stdout_writer(), b)
}

view act println_byte(b: u8) {
    fprintln_byte(io_get_stdout_writer(), b)
}

view act print_i64(val: i64) {
    fprint_i64(io_get_stdout_writer(), val)
}

view act println_i64(val: i64) {
    fprintln_i64(io_get_stdout_writer(), val)
}

view act print_u64(val: u64) {
    fprint_u64(io_get_stdout_writer(), val)
}

view act println_u64(val: u64) {
    fprintln_u64(io_get_stdout_writer(), val)
}

view act print_f64(val: f64, precision: i32) {
    fprint_f64(io_get_stdout_writer(), val, precision)
}

view act println_f64(val: f64, precision: i32) {
    fprintln_f64(io_get_stdout_writer(), val, precision)
}

view act print_bool(val: bool) {
    fprint_bool(io_get_stdout_writer(), val)
}

view act println_bool(val: bool) {
    fprintln_bool(io_get_stdout_writer(), val)
}

// ============================================================================
// Standard Error Print API (eprint / eprintln)
// ============================================================================

view act eprint(s: StrSlice) {
    fprint(io_get_stderr_writer(), s)
}

view act eprintln(s: StrSlice) {
    fprintln(io_get_stderr_writer(), s)
}

view act eprint_str(s: string) {
    fprint_str(io_get_stderr_writer(), s)
}

view act eprintln_str(s: string) {
    fprintln_str(io_get_stderr_writer(), s)
}

view act eprintln_empty() {
    fprintln_empty(io_get_stderr_writer())
}

view act eprint_byte(b: u8) {
    fprint_byte(io_get_stderr_writer(), b)
}

view act eprintln_byte(b: u8) {
    fprintln_byte(io_get_stderr_writer(), b)
}

view act eprint_i64(val: i64) {
    fprint_i64(io_get_stderr_writer(), val)
}

view act eprintln_i64(val: i64) {
    fprintln_i64(io_get_stderr_writer(), val)
}

view act eprint_u64(val: u64) {
    fprint_u64(io_get_stderr_writer(), val)
}

view act eprintln_u64(val: u64) {
    fprintln_u64(io_get_stderr_writer(), val)
}

view act eprint_f64(val: f64, precision: i32) {
    fprint_f64(io_get_stderr_writer(), val, precision)
}

view act eprintln_f64(val: f64, precision: i32) {
    fprintln_f64(io_get_stderr_writer(), val, precision)
}

view act eprint_bool(val: bool) {
    fprint_bool(io_get_stderr_writer(), val)
}

view act eprintln_bool(val: bool) {
    fprintln_bool(io_get_stderr_writer(), val)
}

