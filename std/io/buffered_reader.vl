// Pure Velo buffered stream reader and line-by-line parser (zero C runtime dependencies).
// Buffers incoming data (default 4KB) from an OS FileHandle, eliminating per-byte syscalls.
// Provides fast byte reading, peek, block reading, and line-by-line input (fgets replacement).

use "../mem/page.vl"
use "../mem/ops.vl"
use "../str/slice.vl"
use "../str/builder.vl"
use "handle.vl"

view let DEFAULT_READER_BUFFER_SIZE: usize = 4096

// Buffered reader descriptor
view data BufferedReader {
    handle: FileHandle
    buf: @u8
    cap: usize
    pos: usize
    limit: usize
    owns_buf: bool
    eof: bool
}

// Initializes a buffered reader backed by an automatically allocated 4KB OS virtual page.
view act reader_init(h: FileHandle) -> BufferedReader {
    let buf = os_page_alloc(DEFAULT_READER_BUFFER_SIZE)
    return BufferedReader {
        handle: h,
        buf: buf,
        cap: DEFAULT_READER_BUFFER_SIZE,
        pos: 0,
        limit: 0,
        owns_buf: true,
        eof: false,
    }
}

// Initializes a buffered reader using a caller-provided buffer of specified capacity.
view act reader_init_with_buffer(h: FileHandle, buf: @u8, cap: usize) -> BufferedReader {
    return BufferedReader {
        handle: h,
        buf: buf,
        cap: cap,
        pos: 0,
        limit: 0,
        owns_buf: false,
        eof: false,
    }
}

// Refills the internal buffer from the underlying file handle.
// Returns the number of bytes read into the buffer, 0 on EOF, or -1 on error.
view act reader_fill(r: @BufferedReader) -> isize {
    if r == null or !io_is_valid_handle(r.handle) or r.buf == null or r.cap == 0 {
        return -1 as isize
    }
    if r.eof {
        return 0 as isize
    }
    let n = io_raw_read(r.handle, r.buf, r.cap)
    if n <= 0 as isize {
        r.pos = 0
        r.limit = 0
        if n == 0 as isize {
            r.eof = true
            return 0 as isize
        }
        return -1 as isize
    }
    r.pos = 0
    r.limit = n as usize
    return n
}

// Reads a single byte from the stream.
// Returns true on success (populating out_byte), or false on EOF/error.
view act reader_read_byte(r: @BufferedReader, out_byte: @u8) -> bool {
    if r == null { return false }
    if r.pos >= r.limit {
        let n = reader_fill(r)
        if n <= 0 as isize {
            return false
        }
    }
    if out_byte != null {
        out_byte[0] = r.buf[r.pos]
    }
    r.pos += 1
    return true
}

// Peeks at the next byte without consuming it.
// Returns true on success (populating out_byte), or false on EOF/error.
view act reader_peek_byte(r: @BufferedReader, out_byte: @u8) -> bool {
    if r == null { return false }
    if r.pos >= r.limit {
        let n = reader_fill(r)
        if n <= 0 as isize {
            return false
        }
    }
    if out_byte != null {
        out_byte[0] = r.buf[r.pos]
    }
    return true
}

// Reads up to max_len bytes into dest.
// Returns the actual number of bytes read.
view act reader_read(r: @BufferedReader, dest: @u8, max_len: usize) -> usize {
    if r == null or dest == null or max_len == 0 {
        return 0
    }
    let dest_addr: usize = dest as usize
    mut total_read: usize = 0
    mut remaining = max_len

    loop remaining > 0 {
        let available = r.limit - r.pos
        if available > 0 {
            mut to_copy = available
            if remaining < to_copy {
                to_copy = remaining
            }
            let src_ptr = (r.buf as usize + r.pos) as @u8
            let dst_ptr = (dest_addr + total_read) as @u8
            copy(dst_ptr, src_ptr, to_copy)
            r.pos += to_copy
            total_read += to_copy
            remaining -= to_copy
        } else {
            // Buffer is empty.
            if r.eof {
                break
            }
            // Direct read bypass for large requests when buffer is empty
            if remaining >= r.cap {
                let dst_ptr = (dest_addr + total_read) as @u8
                let n = io_raw_read(r.handle, dst_ptr, remaining)
                if n <= 0 as isize {
                    if n == 0 as isize { r.eof = true }
                    break
                }
                total_read += n as usize
                remaining -= n as usize
            } else {
                let n = reader_fill(r)
                if n <= 0 as isize {
                    break
                }
            }
        }
    }

    return total_read
}

// Reads bytes until newline '\n' into sb, stripping any trailing '\r'.
// Returns true if at least one byte or a newline was read, or false on EOF.
view act reader_read_line(r: @BufferedReader, sb: @StrBuilder) -> bool {
    if r == null or sb == null { return false }
    mut bytes_accumulated: usize = 0
    mut found_nl = false

    loop !found_nl {
        if r.pos >= r.limit {
            let n = reader_fill(r)
            if n <= 0 as isize {
                break // EOF or error
            }
        }

        let start_pos = r.pos
        mut end_pos = r.pos
        loop end_pos < r.limit and r.buf[end_pos] != 10 as u8 {
            end_pos += 1
        }

        let chunk_len = end_pos - start_pos
        if chunk_len > 0 {
            let slice = slice_from_raw((r.buf as usize + start_pos) as @u8, chunk_len)
            sb_append_slice(sb, slice)
            bytes_accumulated += chunk_len
        }

        if end_pos < r.limit and r.buf[end_pos] == 10 as u8 {
            r.pos = end_pos + 1 // consume '\n'
            found_nl = true
            // Strip trailing '\r' if present
            if sb.len > 0 and sb.buffer[sb.len - 1] == 13 as u8 {
                sb.len -= 1
            }
        } else {
            r.pos = end_pos
        }
    }

    if bytes_accumulated > 0 or found_nl {
        // Strip trailing '\r' if line ended at EOF without '\n'
        if sb.len > 0 and sb.buffer[sb.len - 1] == 13 as u8 {
            sb.len -= 1
        }
        return true
    }
    return false
}

// Reads the remainder of the stream into sb.
// Returns total bytes read.
view act reader_read_all(r: @BufferedReader, sb: @StrBuilder) -> usize {
    if r == null or sb == null { return 0 }
    let initial_len = sb.len
    loop {
        if r.pos >= r.limit {
            let n = reader_fill(r)
            if n <= 0 as isize {
                break
            }
        }
        let available = r.limit - r.pos
        let slice = slice_from_raw((r.buf as usize + r.pos) as @u8, available)
        sb_append_slice(sb, slice)
        r.pos = r.limit
    }
    return sb.len - initial_len
}

// Returns true if the reader has exhausted the stream (EOF and no buffered bytes remaining).
view act reader_is_eof(r: @BufferedReader) -> bool {
    if r == null { return true }
    return r.pos >= r.limit and r.eof
}

// Returns the number of unconsumed bytes currently buffered in memory.
view act reader_buffered_count(r: @BufferedReader) -> usize {
    if r == null { return 0 }
    if r.pos >= r.limit { return 0 }
    return r.limit - r.pos
}

// Frees internal buffer resources if owned.
view act reader_free(r: @BufferedReader) -> bool {
    if r == null { return false }
    if r.owns_buf and r.buf != null and r.cap > 0 {
        os_page_free(r.buf, r.cap)
        r.buf = null
    }
    r.pos = 0
    r.limit = 0
    r.cap = 0
    r.eof = true
    return true
}

