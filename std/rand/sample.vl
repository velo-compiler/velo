// std.rand.sample - Typed samplers built on top of PCG64 and Xoshiro256**.
// All functions operate on @Rng (PCG64-backed), with _x variants for Xoshiro256**.
use "../mem/heap.vl"
use "../str.vl"
use "defs.vl"
use "pcg.vl"
use "xoshiro.vl"

// ---------------------------------------------------------------------------
// Boolean
// ---------------------------------------------------------------------------

// Returns true or false with equal probability.
view act rand_bool(r: @Rng) -> bool {
    return (pcg64_next(@r.pcg) & (1 as u64)) != (0 as u64)
}

// Returns true with probability (numerator / denominator). E.g. (1, 4) = 25%.
view act rand_bool_weighted(r: @Rng, numerator: u64, denominator: u64) -> bool {
    if denominator == (0 as u64) { return false }
    if numerator >= denominator { return true }
    return pcg64_bounded(@r.pcg, denominator) < numerator
}

// ---------------------------------------------------------------------------
// Unsigned integers
// ---------------------------------------------------------------------------

// Returns a uniformly random u64 in [0, 2^64).
view act rand_u64(r: @Rng) -> u64 {
    return pcg64_next(@r.pcg)
}

// Returns a uniformly random u32 in [0, 2^32).
view act rand_u32(r: @Rng) -> u32 {
    return (pcg64_next(@r.pcg) >> 32) as u32
}

// Returns a uniformly random u64 in [min, max] (inclusive). Panics if min > max.
view act rand_range_u64(r: @Rng, min: u64, max: u64) -> u64 {
    if min >= max { return min }
    let diff: u64 = max - min
    if diff == 0xFFFFFFFFFFFFFFFF as u64 {
        return rand_u64(r)
    }
    let range: u64 = diff + (1 as u64)
    return min + pcg64_bounded(@r.pcg, range)
}

// Returns a uniformly random i64 in [min, max] (inclusive).
view act rand_range_i64(r: @Rng, min: i64, max: i64) -> i64 {
    if min >= max { return min }
    let diff: u64 = (max as u64) - (min as u64)
    if diff == 0xFFFFFFFFFFFFFFFF as u64 {
        return rand_u64(r) as i64
    }
    let range: u64 = diff + (1 as u64)
    let r_u: u64 = pcg64_bounded(@r.pcg, range)
    return ((min as u64) + r_u) as i64
}

// Returns a uniformly random i32 in [min, max] (inclusive).
view act rand_range_i32(r: @Rng, min: i32, max: i32) -> i32 {
    if min >= max { return min }
    let range: u64 = ((max as i64) - (min as i64) + 1) as u64
    let r_u: u64 = pcg64_bounded(@r.pcg, range)
    let res: i64 = (min as i64) + (r_u as i64)
    return res as i32
}

// ---------------------------------------------------------------------------
// Floating point
// ---------------------------------------------------------------------------

// Returns a uniformly random f64 in [0.0, 1.0) with 53 bits of precision.
// Uses the "multiply by 2^-53" technique for a uniform distribution.
view act rand_f64(r: @Rng) -> f64 {
    // Take 53 high bits and scale to [0, 1)
    let bits: u64 = pcg64_next(@r.pcg) >> 11
    return (bits as f64) * (1.1102230246251565e-16)
}

// Returns a uniformly random f64 in [0.0, 1.0) using Xoshiro256**.
view act rand_f64_x(r: @Xoshiro256) -> f64 {
    let bits: u64 = xoshiro256_next(r) >> 11
    return (bits as f64) * (1.1102230246251565e-16)
}

// Returns a uniformly random f64 in [lo, hi).
view act rand_range_f64(r: @Rng, lo: f64, hi: f64) -> f64 {
    if lo >= hi { return lo }
    return lo + rand_f64(r) * (hi - lo)
}

// ---------------------------------------------------------------------------
// Byte buffers
// ---------------------------------------------------------------------------

// Fills a caller-provided byte buffer with random bytes.
view act rand_fill(r: @Rng, buf: @u8, len: usize) {
    if buf == null or len == 0 { return }
    mut i: usize = 0
    loop i + 8 <= len {
        let word: u64 = pcg64_next(@r.pcg)
        buf[i]     = (word & (0xFF as u64)) as u8
        buf[i + 1] = ((word >> 8) & (0xFF as u64)) as u8
        buf[i + 2] = ((word >> 16) & (0xFF as u64)) as u8
        buf[i + 3] = ((word >> 24) & (0xFF as u64)) as u8
        buf[i + 4] = ((word >> 32) & (0xFF as u64)) as u8
        buf[i + 5] = ((word >> 40) & (0xFF as u64)) as u8
        buf[i + 6] = ((word >> 48) & (0xFF as u64)) as u8
        buf[i + 7] = ((word >> 56) & (0xFF as u64)) as u8
        i += 8
    }
    if i < len {
        let word: u64 = pcg64_next(@r.pcg)
        mut shift: u32 = 0
        loop i < len {
            buf[i] = ((word >> shift) & (0xFF as u64)) as u8
            i += 1
            shift += 8
        }
    }
}

// Allocates and returns a new heap string of byte_count random bytes.
view act rand_bytes(r: @Rng, byte_count: usize) -> @u8 {
    if byte_count == 0 { return null }
    mut buf: @u8 = heap_alloc(byte_count)
    if buf == null { return null }
    rand_fill(r, buf, byte_count)
    return buf
}

// ---------------------------------------------------------------------------
// String generation
// ---------------------------------------------------------------------------

view let RAND_ALPHA_LOWER: string = "abcdefghijklmnopqrstuvwxyz"
view let RAND_ALPHA_UPPER: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
view let RAND_DIGITS:      string = "0123456789"
view let RAND_ALPHANUMERIC: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
view let RAND_HEX_LOWER:   string = "0123456789abcdef"

// Returns a heap-allocated random string of given length, drawing characters
// from the provided alphabet. Returns null if alphabet is empty or len is 0.
view act rand_string_from(r: @Rng, alphabet: string, len: usize) -> string {
    if alphabet == null or len == 0 { return null }
    let alpha_len = str.len(alphabet)
    if alpha_len == 0 { return null }
    mut buf: @u8 = heap_alloc(len + 1)
    if buf == null { return null }
    mut i: usize = 0
    loop i < len {
        let idx = pcg64_bounded(@r.pcg, alpha_len as u64) as usize
        buf[i] = alphabet[idx]
        i += 1
    }
    buf[len] = 0 as u8
    return buf as string
}

// Returns a random lowercase alphanumeric string of given length.
view act rand_string(r: @Rng, len: usize) -> string {
    return rand_string_from(r, RAND_ALPHANUMERIC, len)
}

// Returns a random lowercase hexadecimal string of given length.
view act rand_hex_string(r: @Rng, len: usize) -> string {
    return rand_string_from(r, RAND_HEX_LOWER, len)
}

// ---------------------------------------------------------------------------
// Shuffling
// ---------------------------------------------------------------------------

// Fisher-Yates in-place shuffle of a u64 array of `count` elements.
view act rand_shuffle_u64(r: @Rng, arr: @u64, count: usize) {
    if arr == null or count <= 1 { return }
    mut i: usize = count - 1
    loop i > 0 {
        let j: usize = pcg64_bounded(@r.pcg, (i + 1) as u64) as usize
        let tmp: u64 = arr[i]
        arr[i] = arr[j]
        arr[j] = tmp
        i -= 1
    }
}

// Fisher-Yates in-place shuffle of an i64 array of `count` elements.
view act rand_shuffle_i64(r: @Rng, arr: @i64, count: usize) {
    if arr == null or count <= 1 { return }
    mut i: usize = count - 1
    loop i > 0 {
        let j: usize = pcg64_bounded(@r.pcg, (i + 1) as u64) as usize
        let tmp: i64 = arr[i]
        arr[i] = arr[j]
        arr[j] = tmp
        i -= 1
    }
}

// Fisher-Yates in-place shuffle of a byte buffer of `count` bytes.
view act rand_shuffle_bytes(r: @Rng, buf: @u8, count: usize) {
    if buf == null or count <= 1 { return }
    mut i: usize = count - 1
    loop i > 0 {
        let j: usize = pcg64_bounded(@r.pcg, (i + 1) as u64) as usize
        let tmp: u8 = buf[i]
        buf[i] = buf[j]
        buf[j] = tmp
        i -= 1
    }
}

// ---------------------------------------------------------------------------
// Sampling
// ---------------------------------------------------------------------------

// Returns a uniformly random index in [0, count). Returns 0 if count == 0.
view act rand_index(r: @Rng, count: usize) -> usize {
    if count == 0 { return 0 }
    return pcg64_bounded(@r.pcg, count as u64) as usize
}

// ---------------------------------------------------------------------------
// Xoshiro256** convenience wrappers
// ---------------------------------------------------------------------------

// Returns a uniformly random u64 from Xoshiro256**.
view act rand_u64_x(r: @Xoshiro256) -> u64 {
    return xoshiro256_next(r)
}

// Returns a uniformly random u64 in [min, max] from Xoshiro256**.
view act rand_range_u64_x(r: @Xoshiro256, min: u64, max: u64) -> u64 {
    if min >= max { return min }
    let diff: u64 = max - min
    if diff == 0xFFFFFFFFFFFFFFFF as u64 {
        return rand_u64_x(r)
    }
    let range: u64 = diff + (1 as u64)
    return min + xoshiro256_bounded(r, range)
}

