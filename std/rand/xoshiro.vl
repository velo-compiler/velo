// std.rand.xoshiro - Xoshiro256** core algorithm.
// Reference: Blackman & Vigna (2019) - https://prng.di.unimi.it/
// Extremely fast, 256-bit state, excellent statistical properties.
// All bits pass BigCrush and PractRand. Period: 2^256 - 1.
use "defs.vl"

// Rotates a u64 left by k bits.
view act xoshiro_rotl(x: u64, k: u32) -> u64 {
    let rk = k & (63 as u32)
    let lk = (64 as u32) - rk
    return (x << rk) | (x >> lk)
}

// Advances the Xoshiro256** state and returns the next output u64.
view act xoshiro256_next(rng: @Xoshiro256) -> u64 {
    let result: u64 = xoshiro_rotl(rng.s1 * (5 as u64), 7 as u32) * (9 as u64)
    let t: u64 = rng.s1 << 17
    rng.s2 = rng.s2 ^ rng.s0
    rng.s3 = rng.s3 ^ rng.s1
    rng.s1 = rng.s1 ^ rng.s2
    rng.s0 = rng.s0 ^ rng.s3
    rng.s2 = rng.s2 ^ t
    rng.s3 = xoshiro_rotl(rng.s3, 45 as u32)
    return result
}

// Returns a uniformly distributed u64 in [0, bound) with no modulo bias.
view act xoshiro256_bounded(rng: @Xoshiro256, bound: u64) -> u64 {
    if bound <= (1 as u64) { return 0 as u64 }
    let neg_bound: u64 = (0 as u64) - bound
    let threshold: u64 = neg_bound % bound
    loop {
        let r: u64 = xoshiro256_next(rng)
        if r >= threshold {
            return r % bound
        }
    }
    return 0 as u64
}

// Xoshiro256** jump function: advances state by 2^128 steps.
// Equivalent to calling xoshiro256_next() 2^128 times.
// Use to create non-overlapping sequences for parallel independent streams.
view act xoshiro256_jump(rng: @Xoshiro256) {
    let J0: u64 = 0x180EC6D33CFD0ABA as u64
    let J1: u64 = 0xD5A61266F0C9392C as u64
    let J2: u64 = 0xA9582618E03FC9AA as u64
    let J3: u64 = 0x39ABDC4529B1661C as u64

    mut s0: u64 = 0 as u64
    mut s1: u64 = 0 as u64
    mut s2: u64 = 0 as u64
    mut s3: u64 = 0 as u64

    mut jumps: @u64 = null
    mut jbuf: @u64 = null
    mut j_buf_raw: @u8 = null

    // Unroll the jump polynomial evaluation over the 4 constants
    mut b: u32 = 0
    loop b < 64 {
        if ((J0 >> b) & (1 as u64)) != (0 as u64) {
            s0 = s0 ^ rng.s0
            s1 = s1 ^ rng.s1
            s2 = s2 ^ rng.s2
            s3 = s3 ^ rng.s3
        }
        xoshiro256_next(rng)
        b += 1
    }
    b = 0
    loop b < 64 {
        if ((J1 >> b) & (1 as u64)) != (0 as u64) {
            s0 = s0 ^ rng.s0
            s1 = s1 ^ rng.s1
            s2 = s2 ^ rng.s2
            s3 = s3 ^ rng.s3
        }
        xoshiro256_next(rng)
        b += 1
    }
    b = 0
    loop b < 64 {
        if ((J2 >> b) & (1 as u64)) != (0 as u64) {
            s0 = s0 ^ rng.s0
            s1 = s1 ^ rng.s1
            s2 = s2 ^ rng.s2
            s3 = s3 ^ rng.s3
        }
        xoshiro256_next(rng)
        b += 1
    }
    b = 0
    loop b < 64 {
        if ((J3 >> b) & (1 as u64)) != (0 as u64) {
            s0 = s0 ^ rng.s0
            s1 = s1 ^ rng.s1
            s2 = s2 ^ rng.s2
            s3 = s3 ^ rng.s3
        }
        xoshiro256_next(rng)
        b += 1
    }

    rng.s0 = s0
    rng.s1 = s1
    rng.s2 = s2
    rng.s3 = s3
}

