// std.rand.pcg - PCG64 (Permuted Congruential Generator) core algorithm.
// Reference: O'Neill, M.E. (2014) - https://www.pcg-random.org/
// Statistical quality: passes BigCrush and PractRand. Period: 2^64.
use "defs.vl"

// Rotates a u64 left by k bits.
act pcg64_rotl(x: u64, k: u32) -> u64 {
    let rk = k & (63 as u32)
    let lk = (64 as u32) - rk
    return (x << rk) | (x >> lk)
}

// Advances the PCG64 state and returns the next output u64 value.
// Uses the PCG-XSH-RR (xorshift high, random rotation) output function.
act pcg64_next(rng: @Pcg64) -> u64 {
    let oldstate: u64 = rng.state
    rng.state = oldstate * (0x5851F42D4C957F2D as u64) + rng.inc
    // XSH-RR output: 64-bit variant using upper bits of 128-bit state
    // Simplified to: xorshift the state then rotate
    let xorshifted: u64 = ((oldstate >> 18) ^ oldstate) >> 27
    let rot: u32 = (oldstate >> 59) as u32
    return pcg64_rotl(xorshifted, (64 as u32) - rot)
}

// Returns a uniformly distributed u64 in [0, bound) with no modulo bias.
// Uses the Lemire fast bounded rejection-sampling algorithm.
act pcg64_bounded(rng: @Pcg64, bound: u64) -> u64 {
    if bound <= (1 as u64) { return 0 as u64 }
    // threshold = (-bound) % bound (computed in u64)
    let neg_bound: u64 = (0 as u64) - bound
    let threshold: u64 = neg_bound % bound
    loop {
        let r: u64 = pcg64_next(rng)
        if r >= threshold {
            return r % bound
        }
    }
    return 0 as u64
}

// Advances the PCG64 state by delta steps in O(log delta) time.
// Useful for jumping forward in the sequence without generating each value.
act pcg64_advance(rng: @Pcg64, delta: u64) {
    mut acc_mult: u64 = 1 as u64
    mut acc_plus: u64 = 0 as u64
    mut cur_mult: u64 = 0x5851F42D4C957F2D as u64
    mut cur_plus: u64 = rng.inc
    mut mdelta: u64 = delta

    loop mdelta > (0 as u64) {
        if (mdelta & (1 as u64)) != (0 as u64) {
            acc_mult = acc_mult * cur_mult
            acc_plus = acc_plus * cur_mult + cur_plus
        }
        cur_plus = (cur_mult + (1 as u64)) * cur_plus
        cur_mult = cur_mult * cur_mult
        mdelta >>= 1
    }
    rng.state = acc_mult * rng.state + acc_plus
}

