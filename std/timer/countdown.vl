// std.timer.countdown - Deadline and timeout trackers for bounded executions.
use "defs.vl"

view data Countdown {
    start_ns: u64
    deadline_ns: u64
    duration_ns: u64
    is_active: bool
}

// Starts a countdown timer expiring in `duration_ns` nanoseconds.
view act countdown_start_ns(duration_ns: u64) -> Countdown {
    let now = timer_now_ns()
    return Countdown {
        start_ns: now,
        deadline_ns: now + duration_ns,
        duration_ns: duration_ns,
        is_active: true,
    }
}

// Starts a countdown timer expiring in `duration_ms` milliseconds.
view act countdown_start_ms(duration_ms: u64) -> Countdown {
    return countdown_start_ns(duration_ms * TIMER_NS_PER_MS)
}

// Starts a countdown timer expiring in `seconds` floating-point seconds.
view act countdown_start_secs(seconds: f64) -> Countdown {
    let ns = (seconds * 1000000000.0) as u64
    return countdown_start_ns(ns)
}

// Returns true if the countdown deadline has elapsed or has been cancelled.
view act countdown_is_expired(c: @Countdown) -> bool {
    if c == null or not c.is_active { return true }
    return timer_now_ns() >= c.deadline_ns
}

// Returns remaining time in nanoseconds until expiration (0 if expired).
view act countdown_remaining_ns(c: @Countdown) -> u64 {
    if c == null or not c.is_active { return 0 as u64 }
    let now = timer_now_ns()
    if now >= c.deadline_ns {
        return 0 as u64
    }
    return c.deadline_ns - now
}

// Returns remaining time in milliseconds until expiration (0 if expired).
view act countdown_remaining_ms(c: @Countdown) -> u64 {
    return countdown_remaining_ns(c) / TIMER_NS_PER_MS
}

// Resets the countdown deadline based on its original duration from the current time.
view act countdown_reset(c: @Countdown) {
    if c == null { return }
    let now = timer_now_ns()
    c.start_ns = now
    c.deadline_ns = now + c.duration_ns
    c.is_active = true
}

// Restarts the countdown with a new duration in nanoseconds.
view act countdown_restart(c: @Countdown, new_duration_ns: u64) {
    if c == null { return }
    let now = timer_now_ns()
    c.start_ns = now
    c.duration_ns = new_duration_ns
    c.deadline_ns = now + new_duration_ns
    c.is_active = true
}

// Extends the active deadline by additional nanoseconds.
view act countdown_extend_ns(c: @Countdown, extra_ns: u64) {
    if c == null or not c.is_active { return }
    c.deadline_ns += extra_ns
}

// Extends the active deadline by additional milliseconds.
view act countdown_extend_ms(c: @Countdown, extra_ms: u64) {
    countdown_extend_ns(c, extra_ms * TIMER_NS_PER_MS)
}

// Cancels the countdown, marking it expired immediately.
view act countdown_cancel(c: @Countdown) {
    if c == null { return }
    c.is_active = false
}

// Blocks execution until the countdown expires.
view act countdown_wait(c: @Countdown) {
    if c == null or not c.is_active { return }
    let rem = countdown_remaining_ns(c)
    if rem > (0 as u64) {
        timer_sleep_ns(rem)
    }
}
