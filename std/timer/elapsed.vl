// std.timer.elapsed - High-resolution monotonic interval timer.
use "defs.vl"

data Timer {
    start_ns: u64
    stop_ns: u64
    elapsed_accum_ns: u64
    is_running: bool
}

// Creates a new stopped Timer with zero elapsed time.
act timer_new() -> Timer {
    return Timer {
        start_ns: 0 as u64,
        stop_ns: 0 as u64,
        elapsed_accum_ns: 0 as u64,
        is_running: false,
    }
}

// Creates and immediately starts a new Timer running.
act timer_start() -> Timer {
    return Timer {
        start_ns: timer_now_ns(),
        stop_ns: 0 as u64,
        elapsed_accum_ns: 0 as u64,
        is_running: true,
    }
}

// Resets the timer to 0 elapsed time and stops running.
act timer_reset(t: @Timer) {
    if t == null { return }
    t.start_ns = 0 as u64
    t.stop_ns = 0 as u64
    t.elapsed_accum_ns = 0 as u64
    t.is_running = false
}

// Resets elapsed time to 0 and immediately begins measuring.
act timer_restart(t: @Timer) {
    if t == null { return }
    t.start_ns = timer_now_ns()
    t.stop_ns = 0 as u64
    t.elapsed_accum_ns = 0 as u64
    t.is_running = true
}

// Starts measuring time if currently stopped.
act timer_start_running(t: @Timer) {
    if t == null or t.is_running { return }
    t.start_ns = timer_now_ns()
    t.is_running = true
}

// Stops measuring time and records accumulated duration.
act timer_stop(t: @Timer) {
    if t == null or not t.is_running { return }
    let now = timer_now_ns()
    if now >= t.start_ns {
        t.elapsed_accum_ns += (now - t.start_ns)
    }
    t.stop_ns = now
    t.is_running = false
}

// Resumes measuring time after being stopped, preserving previously accumulated duration.
act timer_resume(t: @Timer) {
    if t == null or t.is_running { return }
    t.start_ns = timer_now_ns()
    t.is_running = true
}

// Returns the total elapsed time in nanoseconds.
act timer_elapsed_ns(t: @Timer) -> u64 {
    if t == null { return 0 as u64 }
    if t.is_running {
        let now = timer_now_ns()
        mut cur: u64 = 0 as u64
        if now >= t.start_ns {
            cur = now - t.start_ns
        }
        return t.elapsed_accum_ns + cur
    }
    return t.elapsed_accum_ns
}

// Returns the total elapsed time in microseconds.
act timer_elapsed_us(t: @Timer) -> u64 {
    return timer_elapsed_ns(t) / TIMER_NS_PER_US
}

// Returns the total elapsed time in milliseconds.
act timer_elapsed_ms(t: @Timer) -> u64 {
    return timer_elapsed_ns(t) / TIMER_NS_PER_MS
}

// Returns the total elapsed time as floating-point seconds.
act timer_elapsed_secs(t: @Timer) -> f64 {
    let ns = timer_elapsed_ns(t)
    return (ns as f64) / 1000000000.0
}

// Returns elapsed nanoseconds since last start or lap, and restarts lap measurement without stopping.
act timer_lap_ns(t: @Timer) -> u64 {
    if t == null { return 0 as u64 }
    let elapsed = timer_elapsed_ns(t)
    t.start_ns = timer_now_ns()
    t.elapsed_accum_ns = 0 as u64
    return elapsed
}

// Returns elapsed milliseconds since last start or lap, and restarts lap measurement.
act timer_lap_ms(t: @Timer) -> u64 {
    return timer_lap_ns(t) / TIMER_NS_PER_MS
}

// Returns true if the timer is actively running.
act timer_is_running(t: @Timer) -> bool {
    if t == null { return false }
    return t.is_running
}
