// std.async.poller_linux — Linux socket I/O multiplexer powered by epoll(7).
//
// Phase 70 / Task 70.4: Replaces poll(2) with epoll(7) for O(1) event scaling
// and edge-triggered event capability. Generic poll(2) is preserved in
// poller_posix.vl for unknown POSIX targets.
use "types.vl"
use "../mem/heap.vl"

// Linux epoll constants (<sys/epoll.h>)
let EPOLLIN_LINUX: u32 = 1
let EPOLLOUT_LINUX: u32 = 4
let EPOLLERR_LINUX: u32 = 8
let EPOLLHUP_LINUX: u32 = 16
let EPOLLRDHUP_LINUX: u32 = 8192
let EPOLLET_LINUX: u32 = 2147483648

let EPOLL_CTL_ADD: i32 = 1
let EPOLL_CTL_DEL: i32 = 2
let EPOLL_CTL_MOD: i32 = 3
let EPOLL_CLOEXEC: i32 = 524288

// Linux struct epoll_event layout (packed 12 bytes on x86-64)
data EpollEvent #packed {
    events: u32
    fd: i64
}

extern act epoll_create1(flags: i32) -> i32
extern act epoll_create(size: i32) -> i32
extern act epoll_ctl(epfd: i32, op: i32, fd: i32, event: @EpollEvent) -> i32
extern act epoll_wait(epfd: i32, events: @EpollEvent, maxevents: i32, timeout: i32) -> i32
extern act close(fd: i32) -> i32

act epoll_event_sizeof() -> usize {
    let dummy: @EpollEvent = null
    return (dummy + 1) as usize
}

data Poller {
    epfd: i32
    events_buf: @EpollEvent
    count: usize
    cap: usize
}

act async_to_epoll_events(events: u32) -> u32 {
    mut ep_ev: u32 = 0 as u32
    if (events & ASYNC_EVENT_READ) != (0 as u32) {
        ep_ev = ep_ev | EPOLLIN_LINUX | EPOLLRDHUP_LINUX
    }
    if (events & ASYNC_EVENT_WRITE) != (0 as u32) {
        ep_ev = ep_ev | EPOLLOUT_LINUX
    }
    return ep_ev
}

act epoll_to_async_events(ep_ev: u32) -> u32 {
    mut ev: u32 = 0 as u32
    if (ep_ev & EPOLLIN_LINUX) != (0 as u32) {
        ev = ev | ASYNC_EVENT_READ
    }
    if (ep_ev & EPOLLOUT_LINUX) != (0 as u32) {
        ev = ev | ASYNC_EVENT_WRITE
    }
    if (ep_ev & EPOLLERR_LINUX) != (0 as u32) {
        ev = ev | ASYNC_EVENT_ERROR
    }
    if (ep_ev & (EPOLLHUP_LINUX | EPOLLRDHUP_LINUX)) != (0 as u32) {
        ev = ev | ASYNC_EVENT_HANGUP
    }
    return ev
}

act poller_init(initial_cap: usize) -> Poller {
    mut c = initial_cap
    if c < 4 { c = 4 }
    mut ep = epoll_create1(EPOLL_CLOEXEC)
    if ep < 0 {
        ep = epoll_create(1024)
    }
    let buf = heap_alloc(c * epoll_event_sizeof()) as @EpollEvent
    return Poller {
        epfd: ep,
        events_buf: buf,
        count: 0,
        cap: c,
    }
}

act poller_free(p: @Poller) {
    if p == null { return }
    if p.epfd >= 0 {
        close(p.epfd)
        p.epfd = -1
    }
    if p.events_buf != null {
        heap_free(p.events_buf as @u8)
        p.events_buf = null
    }
    p.count = 0
    p.cap = 0
}

act poller_ensure_cap(p: @Poller, needed: usize) {
    if p.cap >= needed { return }
    mut new_cap = p.cap * 2
    if new_cap < needed { new_cap = needed }
    let new_buf = heap_alloc(new_cap * epoll_event_sizeof()) as @EpollEvent
    if new_buf == null { return }
    if p.events_buf != null {
        heap_free(p.events_buf as @u8)
    }
    p.events_buf = new_buf
    p.cap = new_cap
}

act poller_add(p: @Poller, fd: i64, events: u32) -> bool {
    if p == null or p.epfd < 0 or fd < 0 { return false }
    mut ev = EpollEvent {
        events: async_to_epoll_events(events),
        fd: fd,
    }
    let rc = epoll_ctl(p.epfd, EPOLL_CTL_ADD, fd as i32, @ev)
    if rc == 0 {
        p.count += 1
        poller_ensure_cap(p, p.count)
        return true
    }
    return false
}

act poller_modify(p: @Poller, fd: i64, events: u32) -> bool {
    if p == null or p.epfd < 0 or fd < 0 { return false }
    mut ev = EpollEvent {
        events: async_to_epoll_events(events),
        fd: fd,
    }
    let rc = epoll_ctl(p.epfd, EPOLL_CTL_MOD, fd as i32, @ev)
    return rc == 0
}

act poller_remove(p: @Poller, fd: i64) -> bool {
    if p == null or p.epfd < 0 or fd < 0 { return false }
    mut ev = EpollEvent {
        events: 0 as u32,
        fd: 0 as i64,
    }
    let rc = epoll_ctl(p.epfd, EPOLL_CTL_DEL, fd as i32, @ev)
    if rc == 0 {
        if p.count > 0 { p.count -= 1 }
        return true
    }
    return false
}

act poller_poll(p: @Poller, timeout_ms: i32, out_events: @AsyncEvent, max_events: usize) -> i32 {
    if p == null or p.epfd < 0 or out_events == null or max_events == 0 { return 0 }
    if p.count == 0 {
        return 0
    }

    mut limit = max_events
    if limit > p.cap {
        limit = p.cap
    }

    let rc = epoll_wait(p.epfd, p.events_buf, limit as i32, timeout_ms)
    if rc <= 0 { return 0 }

    mut out_count: usize = 0
    mut i: usize = 0
    loop i < (rc as usize) and out_count < max_events {
        let ep_ev = p.events_buf[i].events
        let ev_mask = epoll_to_async_events(ep_ev)
        if ev_mask != (0 as u32) {
            out_events[out_count] = AsyncEvent {
                fd: p.events_buf[i].fd,
                events: ev_mask,
                user_data: null,
            }
            out_count += 1
        }
        i += 1
    }
    return out_count as i32
}
