// Pure Velo Regular Expression Parser & Thompson NFA Compiler.
// Translates POSIX ERE patterns (literals, escapes, character classes, anchors,
// quantifiers * + ?, alternation |, and groups) into an NFA state graph.

use "../mem/heap.vl"
use "../mem/ops.vl"
use "../str/slice.vl"
use "defs.vl"

// Fragment of an NFA with entry state and dangling output arrow list
view data NfaFrag {
    start: i32
    arrow_start: usize
    arrow_count: usize
}

// Internal compiler state
view data NfaBuilder {
    states: @NfaState
    state_count: usize
    state_cap: usize
    classes: @CharClass
    class_count: usize
    class_cap: usize
    ranges: @CharRange
    range_count: usize
    range_cap: usize
    arrows: @i32
    arrow_count: usize
    arrow_cap: usize
    had_error: bool
}

view data RegexParser {
    src: @u8
    len: usize
    pos: usize
    had_error: bool
}

act builder_init() -> NfaBuilder {
    return NfaBuilder {
        states: heap_alloc(64 * 32) as @NfaState, state_count: 0, state_cap: 64,
        classes: heap_alloc(16 * 24) as @CharClass, class_count: 0, class_cap: 16,
        ranges: heap_alloc(32 * 8) as @CharRange, range_count: 0, range_cap: 32,
        arrows: heap_alloc(64 * 4) as @i32, arrow_count: 0, arrow_cap: 64,
        had_error: false,
    }
}

act add_state(b: @NfaBuilder, kind: i32, c: u8, out1: i32, out2: i32, class_idx: i32) -> i32 {
    if b.state_count >= b.state_cap {
        let new_cap = b.state_cap * 2
        let new_mem = heap_realloc(b.states as @u8, new_cap * 32) as @NfaState
        if new_mem == null { b.had_error = true; return -1 }
        b.states = new_mem
        b.state_cap = new_cap
    }
    let idx = b.state_count as i32
    b.states[b.state_count] = NfaState {
        kind: kind, c: c, out1: out1, out2: out2, class_idx: class_idx,
    }
    b.state_count += 1
    return idx
}

act add_arrow(b: @NfaBuilder, arrow_id: i32) -> usize {
    if b.arrow_count >= b.arrow_cap {
        let new_cap = b.arrow_cap * 2
        let new_mem = heap_realloc(b.arrows as @u8, new_cap * 4) as @i32
        if new_mem == null { b.had_error = true; return 0 }
        b.arrows = new_mem
        b.arrow_cap = new_cap
    }
    let idx = b.arrow_count
    b.arrows[idx] = arrow_id
    b.arrow_count += 1
    return idx
}

act patch_list(b: @NfaBuilder, arrow_start: usize, arrow_count: usize, target: i32) {
    mut i: usize = 0
    loop i < arrow_count {
        let arrow_id = b.arrows[arrow_start + i]
        let s_idx = (arrow_id / 2) as usize
        let is_out2 = (arrow_id % 2) == 1
        if s_idx < b.state_count {
            if is_out2 { b.states[s_idx].out2 = target } else { b.states[s_idx].out1 = target }
        }
        i += 1
    }
}

act merge_arrows(b: @NfaBuilder, a_start: usize, a_count: usize, b_start: usize, b_count: usize) -> usize {
    let new_start = b.arrow_count
    mut i: usize = 0
    loop i < a_count {
        add_arrow(b, b.arrows[a_start + i])
        i += 1
    }
    mut j: usize = 0
    loop j < b_count {
        add_arrow(b, b.arrows[b_start + j])
        j += 1
    }
    return new_start
}

act add_range(b: @NfaBuilder, min_c: u8, max_c: u8) -> usize {
    if b.range_count >= b.range_cap {
        let new_cap = b.range_cap * 2
        let new_mem = heap_realloc(b.ranges as @u8, new_cap * 8) as @CharRange
        if new_mem == null { b.had_error = true; return 0 }
        b.ranges = new_mem
        b.range_cap = new_cap
    }
    let idx = b.range_count
    b.ranges[idx] = CharRange { min_c: min_c, max_c: max_c }
    b.range_count += 1
    return idx
}

act add_class(b: @NfaBuilder, negated: bool, r_start: usize, r_count: usize) -> i32 {
    if b.class_count >= b.class_cap {
        let new_cap = b.class_cap * 2
        let new_mem = heap_realloc(b.classes as @u8, new_cap * 24) as @CharClass
        if new_mem == null { b.had_error = true; return -1 }
        b.classes = new_mem
        b.class_cap = new_cap
    }
    let idx = b.class_count as i32
    b.classes[b.class_count] = CharClass {
        negated: negated, range_start: r_start, range_count: r_count,
    }
    b.class_count += 1
    return idx
}

act add_class_frag(b: @NfaBuilder, negated: bool, r_start: usize, r_count: usize) -> NfaFrag {
    let c_idx = add_class(b, negated, r_start, r_count)
    let s_idx = add_state(b, PATT_STATE_CLASS, 0 as u8, -1, -1, c_idx)
    let a_start = add_arrow(b, s_idx * 2)
    return NfaFrag { start: s_idx, arrow_start: a_start, arrow_count: 1 }
}

act add_char_frag(b: @NfaBuilder, c: u8) -> NfaFrag {
    let s_idx = add_state(b, PATT_STATE_CHAR, c, -1, -1, -1)
    let a_start = add_arrow(b, s_idx * 2)
    return NfaFrag { start: s_idx, arrow_start: a_start, arrow_count: 1 }
}

act parser_peek(p: @RegexParser) -> u8 {
    if p.pos >= p.len { return 0 as u8 }
    return p.src[p.pos]
}

act parser_next(p: @RegexParser) -> u8 {
    if p.pos >= p.len { return 0 as u8 }
    let c = p.src[p.pos]
    p.pos += 1
    return c
}

act parse_char_class(p: @RegexParser, b: @NfaBuilder) -> NfaFrag {
    parser_next(p) // consume '['
    mut negated = false
    if parser_peek(p) == (94 as u8) { parser_next(p); negated = true }
    let r_start = b.range_count
    mut r_count: usize = 0
    if parser_peek(p) == (93 as u8) { parser_next(p); add_range(b, 93 as u8, 93 as u8); r_count += 1 }
    loop p.pos < p.len and parser_peek(p) != (93 as u8) {
        let c1 = parser_next(p)
        if parser_peek(p) == (45 as u8) and p.pos + 1 < p.len and p.src[p.pos + 1] != (93 as u8) {
            parser_next(p)
            let c2 = parser_next(p)
            add_range(b, c1, c2)
            r_count += 1
        } else {
            add_range(b, c1, c1)
            r_count += 1
        }
    }
    if parser_peek(p) == (93 as u8) { parser_next(p) }
    return add_class_frag(b, negated, r_start, r_count)
}

act parse_escape_atom(p: @RegexParser, b: @NfaBuilder) -> NfaFrag {
    parser_next(p) // consume '\'
    let c = parser_next(p)
    if c == (100 as u8) { // \d
        let r_start = add_range(b, 48 as u8, 57 as u8)
        return add_class_frag(b, false, r_start, 1)
    }
    if c == (68 as u8) { // \D
        let r_start = add_range(b, 48 as u8, 57 as u8)
        return add_class_frag(b, true, r_start, 1)
    }
    if c == (119 as u8) { // \w
        let r_start = add_range(b, 97 as u8, 122 as u8)
        add_range(b, 65 as u8, 90 as u8)
        add_range(b, 48 as u8, 57 as u8)
        add_range(b, 95 as u8, 95 as u8)
        return add_class_frag(b, false, r_start, 4)
    }
    if c == (87 as u8) { // \W
        let r_start = add_range(b, 97 as u8, 122 as u8)
        add_range(b, 65 as u8, 90 as u8)
        add_range(b, 48 as u8, 57 as u8)
        add_range(b, 95 as u8, 95 as u8)
        return add_class_frag(b, true, r_start, 4)
    }
    if c == (115 as u8) { // \s
        let r_start = add_range(b, 32 as u8, 32 as u8)
        add_range(b, 9 as u8, 13 as u8)
        return add_class_frag(b, false, r_start, 2)
    }
    if c == (83 as u8) { // \S
        let r_start = add_range(b, 32 as u8, 32 as u8)
        add_range(b, 9 as u8, 13 as u8)
        return add_class_frag(b, true, r_start, 2)
    }
    mut lit = c
    if c == (116 as u8) { lit = 9 as u8 }
    if c == (110 as u8) { lit = 10 as u8 }
    if c == (114 as u8) { lit = 13 as u8 }
    return add_char_frag(b, lit)
}

act parse_atom(p: @RegexParser, b: @NfaBuilder) -> NfaFrag {
    let c = parser_peek(p)
    if c == (40 as u8) { // '('
        parser_next(p)
        let frag = parse_regex_expr(p, b)
        if parser_peek(p) == (41 as u8) { parser_next(p) }
        return frag
    }
    if c == (91 as u8) { return parse_char_class(p, b) }
    if c == (92 as u8) { return parse_escape_atom(p, b) }
    if c == (46 as u8) { // '.'
        parser_next(p)
        let s_idx = add_state(b, PATT_STATE_DOT, 0 as u8, -1, -1, -1)
        let a_start = add_arrow(b, s_idx * 2)
        return NfaFrag { start: s_idx, arrow_start: a_start, arrow_count: 1 }
    }
    if c == (94 as u8) { // '^'
        parser_next(p)
        let s_idx = add_state(b, PATT_STATE_ANCHOR_START, 0 as u8, -1, -1, -1)
        let a_start = add_arrow(b, s_idx * 2)
        return NfaFrag { start: s_idx, arrow_start: a_start, arrow_count: 1 }
    }
    if c == (36 as u8) { // '$'
        parser_next(p)
        let s_idx = add_state(b, PATT_STATE_ANCHOR_END, 0 as u8, -1, -1, -1)
        let a_start = add_arrow(b, s_idx * 2)
        return NfaFrag { start: s_idx, arrow_start: a_start, arrow_count: 1 }
    }
    parser_next(p)
    return add_char_frag(b, c)
}

act parse_factor(p: @RegexParser, b: @NfaBuilder) -> NfaFrag {
    mut frag = parse_atom(p, b)
    let q = parser_peek(p)
    if q == (42 as u8) { // '*'
        parser_next(p)
        let split = add_state(b, PATT_STATE_SPLIT, 0 as u8, frag.start, -1, -1)
        patch_list(b, frag.arrow_start, frag.arrow_count, split)
        let a_start = add_arrow(b, split * 2 + 1)
        return NfaFrag { start: split, arrow_start: a_start, arrow_count: 1 }
    }
    if q == (43 as u8) { // '+'
        parser_next(p)
        let split = add_state(b, PATT_STATE_SPLIT, 0 as u8, frag.start, -1, -1)
        patch_list(b, frag.arrow_start, frag.arrow_count, split)
        let a_start = add_arrow(b, split * 2 + 1)
        return NfaFrag { start: frag.start, arrow_start: a_start, arrow_count: 1 }
    }
    if q == (63 as u8) { // '?'
        parser_next(p)
        let split = add_state(b, PATT_STATE_SPLIT, 0 as u8, frag.start, -1, -1)
        let a_split = add_arrow(b, split * 2 + 1)
        let merged = merge_arrows(b, frag.arrow_start, frag.arrow_count, a_split, 1)
        return NfaFrag { start: split, arrow_start: merged, arrow_count: frag.arrow_count + 1 }
    }
    return frag
}

act parse_branch(p: @RegexParser, b: @NfaBuilder) -> NfaFrag {
    mut first = true
    mut combined = NfaFrag { start: -1, arrow_start: 0, arrow_count: 0 }
    loop p.pos < p.len {
        let c = parser_peek(p)
        if c == (124 as u8) or c == (41 as u8) { break }
        let next_frag = parse_factor(p, b)
        if first {
            combined = next_frag
            first = false
        } else {
            patch_list(b, combined.arrow_start, combined.arrow_count, next_frag.start)
            combined = NfaFrag {
                start: combined.start,
                arrow_start: next_frag.arrow_start,
                arrow_count: next_frag.arrow_count,
            }
        }
    }
    if first {
        let split = add_state(b, PATT_STATE_SPLIT, 0 as u8, -1, -1, -1)
        let a_start = add_arrow(b, split * 2)
        return NfaFrag { start: split, arrow_start: a_start, arrow_count: 1 }
    }
    return combined
}

act parse_regex_expr(p: @RegexParser, b: @NfaBuilder) -> NfaFrag {
    mut frag1 = parse_branch(p, b)
    loop parser_peek(p) == (124 as u8) { // '|'
        parser_next(p)
        let frag2 = parse_branch(p, b)
        let split = add_state(b, PATT_STATE_SPLIT, 0 as u8, frag1.start, frag2.start, -1)
        let merged_start = merge_arrows(b, frag1.arrow_start, frag1.arrow_count, frag2.arrow_start, frag2.arrow_count)
        frag1 = NfaFrag {
            start: split,
            arrow_start: merged_start,
            arrow_count: frag1.arrow_count + frag2.arrow_count,
        }
    }
    return frag1
}

// Compiles a regex string slice into an executable Pattern NFA.
view act compile_pattern(pat_slice: StrSlice) -> Pattern {
    if pat_slice.ptr == null or pat_slice.len == 0 {
        mut empty_b = builder_init()
        let match_state = add_state(@empty_b, PATT_STATE_MATCH, 0 as u8, -1, -1, -1)
        let sc_curr = heap_alloc(16 * 4) as @i32
        let sc_next = heap_alloc(16 * 4) as @i32
        let sc_vis = heap_alloc(16 * 4) as @i32
        set(sc_vis as @u8, 0 as u8, 16 * 4)
        return Pattern {
            states: empty_b.states, state_count: empty_b.state_count, state_cap: empty_b.state_cap,
            start_state: match_state, anchored_start: false, anchored_end: false,
            classes: empty_b.classes, class_count: empty_b.class_count,
            ranges: empty_b.ranges, range_count: empty_b.range_count,
            scratch_curr: sc_curr, scratch_next: sc_next, scratch_visited: sc_vis, step_id: 1, valid: true,
        }
    }
    mut p = RegexParser { src: pat_slice.ptr, len: pat_slice.len, pos: 0, had_error: false }
    mut b = builder_init()
    let frag = parse_regex_expr(@p, @b)
    let match_state = add_state(@b, PATT_STATE_MATCH, 0 as u8, -1, -1, -1)
    patch_list(@b, frag.arrow_start, frag.arrow_count, match_state)
    let is_anchored_start = (pat_slice.len > 0 and pat_slice.ptr[0] == 94 as u8)
    let is_anchored_end = (pat_slice.len > 0 and pat_slice.ptr[pat_slice.len - 1] == 36 as u8)
    heap_free(b.arrows as @u8)

    let alloc_cnt = if b.state_count < 16 { 16 as usize } else { b.state_count }
    let sc_curr = heap_alloc(alloc_cnt * 4) as @i32
    let sc_next = heap_alloc(alloc_cnt * 4) as @i32
    let sc_vis = heap_alloc(alloc_cnt * 4) as @i32
    set(sc_vis as @u8, 0 as u8, alloc_cnt * 4)

    return Pattern {
        states: b.states, state_count: b.state_count, state_cap: b.state_cap,
        start_state: frag.start, anchored_start: is_anchored_start, anchored_end: is_anchored_end,
        classes: b.classes, class_count: b.class_count,
        ranges: b.ranges, range_count: b.range_count,
        scratch_curr: sc_curr, scratch_next: sc_next, scratch_visited: sc_vis, step_id: 1,
        valid: !b.had_error and !p.had_error,
    }
}

// Frees pattern heap allocations
view act pattern_free(p: @Pattern) {
    if p == null { return }
    if p.states != null { heap_free(p.states as @u8); p.states = null }
    if p.classes != null { heap_free(p.classes as @u8); p.classes = null }
    if p.ranges != null { heap_free(p.ranges as @u8); p.ranges = null }
    if p.scratch_curr != null { heap_free(p.scratch_curr as @u8); p.scratch_curr = null }
    if p.scratch_next != null { heap_free(p.scratch_next as @u8); p.scratch_next = null }
    if p.scratch_visited != null { heap_free(p.scratch_visited as @u8); p.scratch_visited = null }
    p.state_count = 0
    p.valid = false
}
