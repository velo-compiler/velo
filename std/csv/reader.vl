// std.csv.reader — RFC 4180 compliant streaming CSV record parser (zero C runtime dependencies).
// Provides zero-allocation field views for in-memory StrSlice input, incremental streaming over
// @BufferedReader with arena-reset bounded memory, arena-backed unescaping for doubled-quote
// fields, CRLF/LF/CR record termination, blank-line skipping, and per-row error diagnostics.
use "../mem/arena.vl"
use "../mem/ops.vl"
use "../str/slice.vl"
use "../io/buffered_reader.vl"
use "common.vl"
use "stream.vl"

// Initializes a CSV reader over a StrSlice view.
view act csv_reader_init(s: StrSlice) -> CsvReader {
    return CsvReader {
        stream: null,
        src: s,
        pos: 0,
        row: 0,
        had_error: false,
        err_row: 0,
        err_msg: slice_from_raw(null, 0),
        is_stream: false,
        is_eof: s.len == 0,
    }
}

// Initializes a CSV reader over a null-terminated Velo string.
view act csv_reader_init_str(s: string) -> CsvReader {
    return csv_reader_init(slice_from_str(s))
}

// Initializes an incremental streaming CSV reader over an @BufferedReader.
view act csv_reader_init_stream(stream: @BufferedReader) -> CsvReader {
    return CsvReader {
        stream: stream,
        src: slice_from_raw(null, 0),
        pos: 0,
        row: 0,
        had_error: false,
        err_row: 0,
        err_msg: slice_from_raw(null, 0),
        is_stream: true,
        is_eof: stream == null,
    }
}

// Returns true when the reader has consumed all input or recorded an error.
view act csv_reader_done(r: @CsvReader) -> bool {
    if r == null or r.had_error { return true }
    if r.is_stream {
        return r.is_eof or (r.stream != null and reader_is_eof(r.stream))
    }
    return r.pos >= r.src.len
}

// Consumes record terminator bytes from in-memory slice.
view act csv_consume_newlines(r: @CsvReader) {
    loop r.pos < r.src.len {
        let b = r.src.ptr[r.pos]
        if b != CSV_LF and b != CSV_CR { break }
        r.pos += 1
    }
}

// Parses an in-memory quoted field starting after opening quote.
view act csv_scan_quoted(r: @CsvReader, arena: @Arena, out_slice: @StrSlice) -> bool {
    let start = r.pos + 1
    mut k = start
    mut pairs = 0
    loop k < r.src.len {
        let c = r.src.ptr[k]
        if c == CSV_DQUOTE {
            if k + 1 < r.src.len and r.src.ptr[k + 1] == CSV_DQUOTE {
                k += 2
                pairs += 1
                continue
            }
            break
        }
        k += 1
    }
    if k >= r.src.len {
        csv_set_error(r, "unterminated quoted field", r.row + 1)
        r.pos = r.src.len
        return false
    }
    let content_len = k - start - pairs
    mut fslice = slice_from_raw(null, 0)
    if pairs == 0 {
        fslice = slice_from_raw(r.src.ptr + start, content_len)
    } else {
        let buf = arena_alloc(arena, content_len, 1)
        if buf != null {
            mut src_i = start
            mut dst_i: usize = 0
            loop src_i < k {
                let c = r.src.ptr[src_i]
                if c == CSV_DQUOTE and src_i + 1 < k and r.src.ptr[src_i + 1] == CSV_DQUOTE {
                    buf[dst_i] = CSV_DQUOTE
                    src_i += 2
                } else {
                    buf[dst_i] = c
                    src_i += 1
                }
                dst_i += 1
            }
            fslice = slice_from_raw(buf, content_len)
        }
    }
    out_slice[0] = fslice
    r.pos = k + 1
    return true
}

// Parses a single in-memory field.
view act csv_parse_field(r: @CsvReader, arena: @Arena, record_row: usize) -> @CsvField {
    let node = csv_field_alloc(arena)
    if node == null {
        csv_set_error(r, "out of arena memory", record_row)
        return null
    }
    mut fslice = slice_from_raw(null, 0)
    mut quoted = false
    if r.src.ptr[r.pos] == CSV_DQUOTE {
        quoted = true
        if !csv_scan_quoted(r, arena, @fslice) { return null }
        if r.pos < r.src.len {
            let c = r.src.ptr[r.pos]
            if c != CSV_COMMA and c != CSV_LF and c != CSV_CR {
                csv_set_error(r, "stray data after closing quote", record_row)
                r.pos = r.src.len
                return null
            }
        }
    } else {
        let start = r.pos
        mut k = r.pos
        loop k < r.src.len {
            let c = r.src.ptr[k]
            if c == CSV_COMMA or c == CSV_LF or c == CSV_CR { break }
            k += 1
        }
        fslice = slice_sub(r.src, start, k)
        r.pos = k
    }
    node.slice = fslice
    node.quoted = quoted
    node.next = null
    return node
}

// Reads next in-memory record.
view act csv_read_record_mem(r: @CsvReader, arena: @Arena, out: @CsvRecord) -> bool {
    csv_consume_newlines(r)
    if r.pos >= r.src.len { return false }
    let record_row = r.row + 1
    mut head: @CsvField = null
    mut tail: @CsvField = null
    mut count: usize = 0
    loop {
        let field_node = csv_parse_field(r, arena, record_row)
        if field_node == null { return false }
        if head == null { head = field_node } else { tail.next = field_node }
        tail = field_node
        count += 1
        if r.pos < r.src.len {
            let c = r.src.ptr[r.pos]
            if c == CSV_COMMA {
                r.pos += 1
                continue
            }
            if c == CSV_LF {
                r.pos += 1
                break
            }
            if c == CSV_CR {
                r.pos += 1
                if r.pos < r.src.len and r.src.ptr[r.pos] == CSV_LF {
                    r.pos += 1
                }
                break
            }
            csv_set_error(r, "unexpected character in record", record_row)
            r.pos = r.src.len
            return false
        }
        break
    }
    if out != null {
        out.ok = true
        out.row = record_row
        out.count = count
        out.first = head
    }
    r.row = record_row
    return true
}

// Reads the next RFC 4180 record into out (a linked list of field views in arena memory).
// Returns true when a record was parsed; false at clean end-of-input or after parse error.
view act csv_read_record(r: @CsvReader, arena: @Arena, out: @CsvRecord) -> bool {
    if r == null or r.had_error { return false }
    if out != null {
        out.ok = false
        out.row = 0
        out.count = 0
        out.first = null
    }
    if r.is_stream {
        return csv_read_record_stream(r, arena, out)
    }
    return csv_read_record_mem(r, arena, out)
}
