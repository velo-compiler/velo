// Pure Velo hash map lifecycle & advanced operations (zero C runtime dependencies).
// Provides tombstone deletion (map_take / map_delete), tombstone slot recycling,
// automatic table compaction on deletion churn, capacity shrinking, and key/value
// extraction into dynamic shelves.

use "../mem/heap.vl"
use "../mem/ops.vl"
use "../str/slice.vl"
use "shelf.vl"
use "hash.vl"
use "map.vl"

// Rebuilds live rows in-place at the current capacity, purging all tombstones.
view act map_compact(m: @RawMap) -> bool {
    if m == null or m.cap == 0 or m.hashes == null {
        return false
    }

    let nkeys = heap_alloc(m.ksz * m.cap)
    let nvals = heap_alloc(m.vsz * m.cap)
    let nhash = heap_alloc(8 * m.cap) as @u64
    if nkeys == null or nvals == null or nhash == null {
        if nkeys != null { heap_free(nkeys) }
        if nvals != null { heap_free(nvals) }
        if nhash != null { heap_free(nhash as @u8) }
        return false
    }

    set(nhash as @u8, 0 as u8, 8 * m.cap)

    mut i: usize = 0
    loop i < m.cap {
        let h = m.hashes[i]
        if h != HASH_EMPTY and h != HASH_TOMBSTONE {
            mut at: usize = (h as usize) & (m.cap - 1)
            loop nhash[at] != HASH_EMPTY {
                at = (at + 1) & (m.cap - 1)
            }
            nhash[at] = h

            let src_k = (m.keys as usize + i * m.ksz) as @u8
            let dst_k = (nkeys as usize + at * m.ksz) as @u8
            copy(dst_k, src_k, m.ksz)

            let src_v = (m.vals as usize + i * m.vsz) as @u8
            let dst_v = (nvals as usize + at * m.vsz) as @u8
            copy(dst_v, src_v, m.vsz)
        }
        i += 1
    }

    heap_free(m.keys)
    heap_free(m.vals)
    heap_free(m.hashes as @u8)

    m.keys = nkeys
    m.vals = nvals
    m.hashes = nhash
    m.tomb = 0
    return true
}

// Shrinks the map's capacity down to fit live elements, reclaiming unused memory.
view act map_shrink_to_fit(m: @RawMap) -> bool {
    if m == null or m.cap <= 8 {
        return false
    }
    mut min_cap: usize = 8
    if m.len > 0 {
        // Find minimum power of two capacity keeping load factor <= 75%
        let needed: usize = (m.len * 4 + 2) / 3
        min_cap = map_round_pow2(needed)
        if min_cap < 8 { min_cap = 8 }
    }
    if min_cap >= m.cap {
        return false
    }

    let nkeys = heap_alloc(m.ksz * min_cap)
    let nvals = heap_alloc(m.vsz * min_cap)
    let nhash = heap_alloc(8 * min_cap) as @u64
    if nkeys == null or nvals == null or nhash == null {
        if nkeys != null { heap_free(nkeys) }
        if nvals != null { heap_free(nvals) }
        if nhash != null { heap_free(nhash as @u8) }
        return false
    }

    set(nhash as @u8, 0 as u8, 8 * min_cap)

    if m.len > 0 {
        mut i: usize = 0
        loop i < m.cap {
            let h = m.hashes[i]
            if h != HASH_EMPTY and h != HASH_TOMBSTONE {
                mut at: usize = (h as usize) & (min_cap - 1)
                loop nhash[at] != HASH_EMPTY {
                    at = (at + 1) & (min_cap - 1)
                }
                nhash[at] = h

                let src_k = (m.keys as usize + i * m.ksz) as @u8
                let dst_k = (nkeys as usize + at * m.ksz) as @u8
                copy(dst_k, src_k, m.ksz)

                let src_v = (m.vals as usize + i * m.vsz) as @u8
                let dst_v = (nvals as usize + at * m.vsz) as @u8
                copy(dst_v, src_v, m.vsz)
            }
            i += 1
        }
    }

    heap_free(m.keys)
    heap_free(m.vals)
    heap_free(m.hashes as @u8)

    m.keys = nkeys
    m.vals = nvals
    m.hashes = nhash
    m.cap = min_cap
    m.tomb = 0
    return true
}

// Removes key from the map, copying out the previous value.
// Marks slot as a tombstone and triggers in-place compaction if tombstones exceed 50% cap.
view act map_take(m: @RawMap, key: @u8, out_val: @u8) -> bool {
    if m == null or key == null or m.cap == 0 or m.hashes == null or m.len == 0 {
        return false
    }
    let h = hash_map_key(key, m.ksz, m.kstring)
    mut at: usize = (h as usize) & (m.cap - 1)

    loop m.hashes[at] != HASH_EMPTY {
        if m.hashes[at] == h {
            let key_slot = (m.keys as usize + at * m.ksz) as @u8
            if hash_map_key_eq(key, key_slot, m.ksz, m.kstring) {
                if out_val != null {
                    let val_slot = (m.vals as usize + at * m.vsz) as @u8
                    copy(out_val, val_slot, m.vsz)
                }
                m.hashes[at] = HASH_TOMBSTONE
                m.len -= 1
                m.tomb += 1

                // Compact in place if tombstones exceed half capacity
                if m.tomb > (m.cap >> 1) {
                    map_compact(m)
                }
                return true
            }
        }
        at = (at + 1) & (m.cap - 1)
    }
    return false
}

// Removes key from the map without copying out the value.
view act map_delete(m: @RawMap, key: @u8) -> bool {
    return map_take(m, key, null)
}

// Extracts all active keys into a fresh dynamic RawShelf in hash order.
view act map_keys_to_shelf(m: @RawMap) -> RawShelf {
    if m == null or m.len == 0 or m.hashes == null {
        return shelf_create(8, 0)
    }
    mut s = shelf_create(m.ksz, m.len)
    mut i: usize = 0
    loop i < m.cap {
        let h = m.hashes[i]
        if h != HASH_EMPTY and h != HASH_TOMBSTONE {
            let k_ptr = (m.keys as usize + i * m.ksz) as @u8
            shelf_push(@s, k_ptr)
        }
        i += 1
    }
    return s
}

// Extracts all active values into a fresh dynamic RawShelf in hash order.
view act map_values_to_shelf(m: @RawMap) -> RawShelf {
    if m == null or m.len == 0 or m.hashes == null {
        return shelf_create(8, 0)
    }
    mut s = shelf_create(m.vsz, m.len)
    mut i: usize = 0
    loop i < m.cap {
        let h = m.hashes[i]
        if h != HASH_EMPTY and h != HASH_TOMBSTONE {
            let v_ptr = (m.vals as usize + i * m.vsz) as @u8
            shelf_push(@s, v_ptr)
        }
        i += 1
    }
    return s
}

// Copies all active keys and values into contiguous destination buffers.
// Returns the total number of entries written.
view act map_copy_entries(m: @RawMap, out_keys: @u8, out_vals: @u8) -> usize {
    if m == null or m.len == 0 or m.hashes == null { return 0 }
    mut count: usize = 0
    mut i: usize = 0
    loop i < m.cap {
        let h = m.hashes[i]
        if h != HASH_EMPTY and h != HASH_TOMBSTONE {
            if out_keys != null {
                let src_k = (m.keys as usize + i * m.ksz) as @u8
                let dst_k = (out_keys as usize + count * m.ksz) as @u8
                copy(dst_k, src_k, m.ksz)
            }
            if out_vals != null {
                let src_v = (m.vals as usize + i * m.vsz) as @u8
                let dst_v = (out_vals as usize + count * m.vsz) as @u8
                copy(dst_v, src_v, m.vsz)
            }
            count += 1
        }
        i += 1
    }
    return count
}

// --- Typed convenience helpers ---

view act map_delete_str(m: @RawMap, key: string) -> bool {
    mut k = key
    let pk: @string = @k
    return map_delete(m, pk as @u8)
}

view act map_take_str_i64(m: @RawMap, key: string, out_val: @i64) -> bool {
    mut k = key
    let pk: @string = @k
    if out_val == null {
        return map_delete(m, pk as @u8)
    }
    let p_out: @i64 = out_val
    return map_take(m, pk as @u8, p_out as @u8)
}

view act map_take_str_slice(m: @RawMap, key: string, out_val: @StrSlice) -> bool {
    mut k = key
    let pk: @string = @k
    if out_val == null {
        return map_delete(m, pk as @u8)
    }
    let p_out: @StrSlice = out_val
    return map_take(m, pk as @u8, p_out as @u8)
}

view act map_delete_i64(m: @RawMap, key: i64) -> bool {
    mut k = key
    let pk: @i64 = @k
    return map_delete(m, pk as @u8)
}

view act map_take_i64_i64(m: @RawMap, key: i64, out_val: @i64) -> bool {
    mut k = key
    let pk: @i64 = @k
    if out_val == null {
        return map_delete(m, pk as @u8)
    }
    let p_out: @i64 = out_val
    return map_take(m, pk as @u8, p_out as @u8)
}

view act map_delete_u64(m: @RawMap, key: u64) -> bool {
    mut k = key
    let pk: @u64 = @k
    return map_delete(m, pk as @u8)
}

view act map_take_u64_u64(m: @RawMap, key: u64, out_val: @u64) -> bool {
    mut k = key
    let pk: @u64 = @k
    if out_val == null {
        return map_delete(m, pk as @u8)
    }
    let p_out: @u64 = out_val
    return map_take(m, pk as @u8, p_out as @u8)
}

