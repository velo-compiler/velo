// Pure Velo high-performance hashing algorithms (zero C runtime dependencies).
// Provides FNV-1a (64-bit & 32-bit), MurmurHash3 (32-bit x86), DJB2, SDBM,
// SplitMix64 integer mixer, hash combination, string/slice hashing, and
// map sentinel marking contract for open-addressing hash collections.

use "../mem/ops.vl"
use "../str/slice.vl"

// Map sentinel constants matching Velo hash table doctrine
view let HASH_EMPTY: u64 = 0 as u64
view let HASH_TOMBSTONE: u64 = 2 as u64

// 32-bit left rotation helper.
view act hash_rotl32(x: u32, r: u32) -> u32 {
    return (x << r) | (x >> (32 - r))
}

// 64-bit right rotation helper.
view act hash_rotr64(x: u64, r: u64) -> u64 {
    return (x >> r) | (x << (64 - r))
}

// 64-bit FNV-1a hash over a byte buffer.
view act hash_fnv1a(data: @u8, len: usize) -> u64 {
    return hash_fnv1a_with_seed(data, len, 0xcbf29ce484222325 as u64)
}

// 64-bit FNV-1a hash with custom seed.
view act hash_fnv1a_with_seed(data: @u8, len: usize, seed: u64) -> u64 {
    mut h: u64 = seed
    let prime: u64 = 0x00000100000001b3 as u64
    if data == null { return h }
    mut i: usize = 0
    loop i < len {
        h = h ^ (data[i] as u64)
        h = h * prime
        i += 1
    }
    return h
}

// 32-bit FNV-1a hash over a byte buffer.
view act hash_fnv1a_32(data: @u8, len: usize) -> u32 {
    return hash_fnv1a_32_with_seed(data, len, 0x811c9dc5 as u32)
}

// 32-bit FNV-1a hash with custom seed.
view act hash_fnv1a_32_with_seed(data: @u8, len: usize, seed: u32) -> u32 {
    mut h: u32 = seed
    let prime: u32 = 0x01000193 as u32
    if data == null { return h }
    mut i: usize = 0
    loop i < len {
        h = h ^ (data[i] as u32)
        h = h * prime
        i += 1
    }
    return h
}

// MurmurHash3 32-bit (x86) hash. Excellent avalanche distribution.
view act hash_murmur3_32(data: @u8, len: usize, seed: u32) -> u32 {
    if data == null or len == 0 { return seed }
    let c1: u32 = 0xcc9e2d51 as u32
    let c2: u32 = 0x1b873593 as u32
    mut h: u32 = seed

    let nblocks: usize = len / 4
    mut i: usize = 0
    loop i < nblocks {
        let offset: usize = i * 4
        let b0 = data[offset] as u32
        let b1 = data[offset + 1] as u32
        let b2 = data[offset + 2] as u32
        let b3 = data[offset + 3] as u32
        mut k: u32 = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

        k = k * c1
        k = hash_rotl32(k, 15)
        k = k * c2

        h = h ^ k
        h = hash_rotl32(h, 13)
        h = h * (5 as u32) + (0xe6546b64 as u32)
        i += 1
    }

    let tail_offset: usize = nblocks * 4
    let rem: usize = len & 3
    mut k1: u32 = 0
    if rem == 3 {
        k1 = k1 ^ ((data[tail_offset + 2] as u32) << 16)
    }
    if rem >= 2 {
        k1 = k1 ^ ((data[tail_offset + 1] as u32) << 8)
    }
    if rem >= 1 {
        k1 = k1 ^ (data[tail_offset] as u32)
        k1 = k1 * c1
        k1 = hash_rotl32(k1, 15)
        k1 = k1 * c2
        h = h ^ k1
    }

    h = h ^ (len as u32)
    h = h ^ (h >> 16)
    h = h * (0x85ebca6b as u32)
    h = h ^ (h >> 13)
    h = h * (0xc2b2ae35 as u32)
    h = h ^ (h >> 16)
    return h
}

// DJB2 hash algorithm (Daniel J. Bernstein). Fast string and byte hash.
view act hash_djb2(data: @u8, len: usize) -> u64 {
    if data == null or len == 0 { return 5381 as u64 }
    mut h: u64 = 5381 as u64
    mut i: usize = 0
    loop i < len {
        h = ((h << 5) + h) + (data[i] as u64)
        i += 1
    }
    return h
}

// SDBM hash algorithm (Sleepycat Software dbm).
view act hash_sdbm(data: @u8, len: usize) -> u64 {
    if data == null or len == 0 { return 0 as u64 }
    mut h: u64 = 0 as u64
    mut i: usize = 0
    loop i < len {
        h = (data[i] as u64) + (h << 6) + (h << 16) - h
        i += 1
    }
    return h
}

// SplitMix64 universal 64-bit integer hash / mixer.
view act hash_splitmix64(x: u64) -> u64 {
    mut z = x + (0x9e3779b97f4a7c15 as u64)
    z = (z ^ (z >> 30)) * (0xbf58476d1ce4e5b9 as u64)
    z = (z ^ (z >> 27)) * (0x94d049bb133111eb as u64)
    return z ^ (z >> 31)
}

// Hashes a 64-bit unsigned integer with full bit avalanche.
view act hash_u64(val: u64) -> u64 {
    return hash_splitmix64(val)
}

// Hashes a 64-bit signed integer.
view act hash_i64(val: i64) -> u64 {
    return hash_splitmix64(val as u64)
}

// Hashes a 32-bit unsigned integer with full bit avalanche.
view act hash_u32(val: u32) -> u32 {
    mut z = val + (0x9e3779b9 as u32)
    z = ((z >> 16) ^ z) * (0x45d9f3b as u32)
    z = ((z >> 16) ^ z) * (0x45d9f3b as u32)
    z = (z >> 16) ^ z
    return z
}

// Hashes a 32-bit signed integer.
view act hash_i32(val: i32) -> u32 {
    return hash_u32(val as u32)
}

// Hashes a pointer address.
view act hash_ptr(p: @void) -> u64 {
    return hash_splitmix64(p as usize as u64)
}

// Hashes a raw byte slice using FNV-1a.
view act hash_bytes(data: @u8, len: usize) -> u64 {
    return hash_fnv1a(data, len)
}

// Hashes a null-terminated string content.
view act hash_str(s: string) -> u64 {
    if s == null { return 0 as u64 }
    let p = s as @u8
    mut len: usize = 0
    loop p[len] != 0 as u8 {
        len += 1
    }
    return hash_fnv1a(p, len)
}

// Hashes a StrSlice.
view act hash_slice(s: StrSlice) -> u64 {
    return hash_fnv1a(s.ptr, s.len)
}

// Combines two 64-bit hashes using the golden ratio constant (Boost hash_combine).
view act hash_combine(seed: u64, next_hash: u64) -> u64 {
    let phi: u64 = 0x9e3779b97f4a7c15 as u64
    return seed ^ (next_hash + phi + (seed << 6) + (seed >> 2))
}

// --- Map Sentinel Marking Contract (for std.coll.map) ---

// Marks a live hash by forcing bit 0 to 1 (odd value >= 1; never 0=EMPTY, never 2=TOMB).
view act hash_to_live_mark(h: u64) -> u64 {
    return h | (1 as u64)
}

// Returns true if the stored slot hash represents an active live entry.
view act hash_is_live(h: u64) -> bool {
    return (h & (1 as u64)) != (0 as u64)
}

// Returns true if the slot is completely empty.
view act hash_is_empty(h: u64) -> bool {
    return h == (0 as u64)
}

// Returns true if the slot holds a tombstone marker (deleted entry).
view act hash_is_tombstone(h: u64) -> bool {
    return h == (2 as u64)
}

// Computes live map key hash for arbitrary key bytes or string keys.
view act hash_map_key(key_ptr: @u8, ksz: usize, is_str: bool) -> u64 {
    if key_ptr == null { return 1 as u64 }
    if is_str {
        let ps = key_ptr as @string
        let s = ps[0]
        if s == null { return 1 as u64 }
        let p = s as @u8
        mut len: usize = 0
        loop p[len] != 0 as u8 {
            len += 1
        }
        if len == 0 { return 1 as u64 }
        return hash_to_live_mark(hash_fnv1a(p, len))
    }
    return hash_to_live_mark(hash_fnv1a(key_ptr, ksz))
}

// Compares two keys for equality according to map key doctrine.
view act hash_map_key_eq(a: @u8, b: @u8, ksz: usize, is_str: bool) -> bool {
    if a == b { return true }
    if a == null or b == null { return false }
    if is_str {
        let ps_a = a as @string
        let ps_b = b as @string
        let s_a = ps_a[0]
        let s_b = ps_b[0]
        if s_a == s_b { return true }
        if s_a == null or s_b == null { return false }
        return slice_eq(slice_from_str(s_a), slice_from_str(s_b))
    }
    return eq(a, b, ksz)
}
