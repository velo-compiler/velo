// std.log.logger — Global logging dispatcher, configuration, and convenience acts.
use "level.vl"
use "record.vl"
use "sink.vl"
use "../mem/heap.vl"

mut g_current_log_level: u8 = 2 as u8 // Default LOG_INFO
mut g_use_colors: bool = true
mut g_log_file: string = null
mut g_console_enabled: bool = true
mut g_memory_sink_enabled: bool = false

// Configures the minimum severity level to log (messages below this level are ignored).
view act log_set_level(level: u8) {
    g_current_log_level = level
}

// Returns the active minimum severity level.
view act log_get_level() -> u8 {
    return g_current_log_level
}

// Enables or disables ANSI color escape sequences in console output.
view act log_enable_colors(enable: bool) {
    g_use_colors = enable
}

// Configures a destination file path for all log entries.
view act log_set_file(path: string) {
    g_log_file = path
}

// Enables or disables logging output to the terminal console.
view act log_enable_console(enable: bool) {
    g_console_enabled = enable
}

// Enables or disables storing entries in the in-memory inspection sink.
view act log_enable_memory_sink(enable: bool) {
    g_memory_sink_enabled = enable
}

// Core logging dispatch mechanism.
view act log_dispatch(level: u8, target: string, message: string) {
    if level < g_current_log_level {
        return
    }

    let rec = log_record_make(level, target, message)

    if g_console_enabled {
        log_sink_console(@rec, g_use_colors)
    }

    if g_log_file != null and str.len(g_log_file) > 0 {
        log_sink_file(@rec, g_log_file)
    }

    if g_memory_sink_enabled {
        log_sink_memory(@rec)
    }

    if rec.timestamp != null {
        heap_free(rec.timestamp as @u8)
    }
}

// Logs a message with TRACE severity for a specified target module.
view act log_trace(target: string, msg: string) {
    log_dispatch(0 as u8, target, msg)
}

// Logs a message with DEBUG severity for a specified target module.
view act log_debug(target: string, msg: string) {
    log_dispatch(1 as u8, target, msg)
}

// Logs a message with INFO severity for a specified target module.
view act log_info(target: string, msg: string) {
    log_dispatch(2 as u8, target, msg)
}

// Logs a message with WARN severity for a specified target module.
view act log_warn(target: string, msg: string) {
    log_dispatch(3 as u8, target, msg)
}

// Logs a message with ERROR severity for a specified target module.
view act log_error(target: string, msg: string) {
    log_dispatch(4 as u8, target, msg)
}

// Logs a message with FATAL severity for a specified target module.
view act log_fatal(target: string, msg: string) {
    log_dispatch(5 as u8, target, msg)
}

// Top-level logging shortcuts with default "app" target:
view act trace(msg: string) { log_dispatch(0 as u8, "app", msg) }
view act debug(msg: string) { log_dispatch(1 as u8, "app", msg) }
view act info(msg: string)  { log_dispatch(2 as u8, "app", msg) }
view act warn(msg: string)  { log_dispatch(3 as u8, "app", msg) }
view act error(msg: string) { log_dispatch(4 as u8, "app", msg) }
view act fatal(msg: string) { log_dispatch(5 as u8, "app", msg) }

