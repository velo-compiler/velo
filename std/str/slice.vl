// Pure Velo non-null-terminated string slice view (zero C runtime dependencies).
// Provides zero-allocation substring views, fast comparison, prefix/suffix inspection,
// and safe bounds-checked indexing.
use "../mem/ops.vl"

// Read-only view over a contiguous sequence of UTF-8 or ASCII bytes.
view data StrSlice {
    ptr: @u8,
    len: usize,
}

// Calculates byte length of a null-terminated string without C strlen.
view act raw_str_len(p: @u8) -> usize {
    if p == null {
        return 0
    }
    mut l: usize = 0
    loop p[l] != 0 as u8 {
        l += 1
    }
    return l
}

// Creates a StrSlice from a raw byte pointer and explicit length.
view act slice_from_raw(ptr: @u8, len: usize) -> StrSlice {
    if ptr == null or len == 0 {
        return StrSlice { ptr: null, len: 0 }
    }
    return StrSlice { ptr: ptr, len: len }
}

// Creates a StrSlice view directly from a Velo string.
view act slice_from_str(s: string) -> StrSlice {
    let p = s as @u8
    if p == null {
        return StrSlice { ptr: null, len: 0 }
    }
    let l = raw_str_len(p)
    return StrSlice { ptr: p, len: l }
}

// Returns true if the slice is empty or null.
view act slice_is_empty(s: StrSlice) -> bool {
    return s.len == 0 or s.ptr == null
}

// Returns the byte length of the slice.
view act slice_len(s: StrSlice) -> usize {
    return s.len
}

// Returns byte at index, or 0 if index is out of bounds.
view act slice_get(s: StrSlice, idx: usize) -> u8 {
    if s.ptr == null or idx >= s.len {
        return 0 as u8
    }
    return s.ptr[idx]
}

// Returns a sub-slice from [start, end) clamped to [0, s.len].
// Never allocates memory.
view act slice_sub(s: StrSlice, start: usize, end: usize) -> StrSlice {
    if s.ptr == null or s.len == 0 {
        return StrSlice { ptr: null, len: 0 }
    }
    mut real_start = start
    if real_start > s.len {
        real_start = s.len
    }
    mut real_end = end
    if real_end > s.len {
        real_end = s.len
    }
    if real_start >= real_end {
        return StrSlice { ptr: s.ptr + real_start, len: 0 }
    }
    return StrSlice {
        ptr: s.ptr + real_start,
        len: real_end - real_start,
    }
}

// Returns a sub-slice from [start, s.len).
view act slice_sub_from(s: StrSlice, start: usize) -> StrSlice {
    return slice_sub(s, start, s.len)
}

// Returns a sub-slice from [0, end).
view act slice_sub_to(s: StrSlice, end: usize) -> StrSlice {
    return slice_sub(s, 0, end)
}

// Returns true if both slices have identical byte content.
view act slice_eq(a: StrSlice, b: StrSlice) -> bool {
    if a.len != b.len {
        return false
    }
    if a.len == 0 {
        return true
    }
    if a.ptr == b.ptr {
        return true
    }
    if a.ptr == null or b.ptr == null {
        return false
    }
    return eq(a.ptr, b.ptr, a.len)
}

// Compares two slices for equality with a null-terminated string literal.
view act slice_eq_str(s: StrSlice, lit: string) -> bool {
    return slice_eq(s, slice_from_str(lit))
}

// Lexicographical comparison: returns <0 if a < b, 0 if a == b, >0 if a > b.
view act slice_cmp(a: StrSlice, b: StrSlice) -> i32 {
    mut min_len = a.len
    if b.len < min_len {
        min_len = b.len
    }
    mut i: usize = 0
    loop i < min_len {
        let ba: i32 = a.ptr[i] as i32
        let bb: i32 = b.ptr[i] as i32
        if ba != bb {
            if ba < bb { return -1 }
            return 1
        }
        i += 1
    }
    if a.len < b.len { return -1 }
    if a.len > b.len { return 1 }
    return 0
}

// Checks if slice starts with a given prefix.
view act slice_starts_with(s: StrSlice, prefix: StrSlice) -> bool {
    if prefix.len > s.len { return false }
    if prefix.len == 0 { return true }
    let sub = slice_sub(s, 0, prefix.len)
    return slice_eq(sub, prefix)
}

// Checks if slice ends with a given suffix.
view act slice_ends_with(s: StrSlice, suffix: StrSlice) -> bool {
    if suffix.len > s.len { return false }
    if suffix.len == 0 { return true }
    let sub = slice_sub(s, s.len - suffix.len, s.len)
    return slice_eq(sub, suffix)
}

// Copies slice bytes into a destination buffer up to dest_cap.
// Returns the number of bytes copied.
view act slice_copy_to(s: StrSlice, dest: @u8, dest_cap: usize) -> usize {
    if s.ptr == null or dest == null or dest_cap == 0 {
        return 0
    }
    mut n = s.len
    if n > dest_cap {
        n = dest_cap
    }
    copy(dest, s.ptr, n)
    return n
}

// Copies slice bytes into a destination buffer and writes a null terminator.
// Writes at most dest_cap - 1 content bytes. Returns content bytes written.
view act slice_to_cstr(s: StrSlice, dest: @u8, dest_cap: usize) -> usize {
    if dest == null or dest_cap == 0 {
        return 0
    }
    if s.ptr == null or s.len == 0 or dest_cap == 1 {
        dest[0] = 0 as u8
        return 0
    }
    mut n = s.len
    if n >= dest_cap {
        n = dest_cap - 1
    }
    copy(dest, s.ptr, n)
    dest[n] = 0 as u8
    return n
}
