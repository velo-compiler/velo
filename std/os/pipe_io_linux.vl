// std.os.pipe_io_linux — Linux anonymous pipe creation and I/O redirection via POSIX pipe().
// Zero C runtime dependencies.
use "../mem/heap.vl"
use "../mem/ops.vl"
use "../str/slice.vl"
use "../str/builder.vl"
use "proc_types.vl"
use "proc.vl"

extern act pipe(pipefd: @i32) -> i32
extern act read(fd: i32, buf: @u8, count: usize) -> isize
extern act write(fd: i32, buf: @u8, count: usize) -> isize
extern act close(fd: i32) -> i32

// Creates an anonymous OS pipe on Linux.
act os_pipe_create() -> Pipe {
    let fds = heap_alloc(8) as @i32
    if fds == null {
        return Pipe { read_handle: null, write_handle: null }
    }
    let ok = pipe(fds)
    if ok != 0 {
        heap_free(fds as @u8)
        return Pipe { read_handle: null, write_handle: null }
    }
    let r_fd = fds[0] as usize
    let w_fd = fds[1] as usize
    heap_free(fds as @u8)
    return Pipe { read_handle: r_fd as @void, write_handle: w_fd as @void }
}

act os_pipe_read(h_pipe: @void, buf: @u8, count: usize) -> usize {
    if h_pipe == null or buf == null or count == 0 { return 0 }
    let fd = (h_pipe as usize) as i32
    let res = read(fd, buf, count)
    if res <= 0 { return 0 }
    return res as usize
}

act os_pipe_write(h_pipe: @void, buf: @u8, count: usize) -> usize {
    if h_pipe == null or buf == null or count == 0 { return 0 }
    let fd = (h_pipe as usize) as i32
    let res = write(fd, buf, count)
    if res <= 0 { return 0 }
    return res as usize
}

act os_pipe_close_read(pipe: @Pipe) {
    if pipe != null and pipe.read_handle != null {
        let fd = (pipe.read_handle as usize) as i32
        close(fd)
        pipe.read_handle = null
    }
}

act os_pipe_close_write(pipe: @Pipe) {
    if pipe != null and pipe.write_handle != null {
        let fd = (pipe.write_handle as usize) as i32
        close(fd)
        pipe.write_handle = null
    }
}

act os_pipe_close(pipe: @Pipe) {
    if pipe == null { return }
    os_pipe_close_read(pipe)
    os_pipe_close_write(pipe)
}

act os_pipe_drain_streams(arena: @Arena, h_out: @void, h_err: @void, proc: @ProcessHandle) -> ProcessOutput {
    // POSIX drain stub
    return ProcessOutput {
        stdout_str: "",
        stderr_str: "",
        exit_code: 0,
        success: true,
    }
}
