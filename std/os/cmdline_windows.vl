// std.os.args_windows — Windows native command-line retrieval via kernel32.dll.
// Zero C runtime dependencies.

// Foreign interface to Windows kernel32.dll
extern act GetCommandLineA() -> @u8

// Retrieves the raw command line string of the calling process.
act os_raw_cmdline() -> string {
    let p = GetCommandLineA()
    if p == null {
        return ""
    }
    return p as string
}
