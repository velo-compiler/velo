// std.os.proc_types — Process execution descriptors, pipe handles, and return types.
// Zero C runtime dependencies.

// Represents the completion status and exit code of a spawned process.
view data ProcessResult {
    exit_code: i32,
    success: bool,
}

// Represents a live or terminated child process handle.
view data ProcessHandle {
    pid: u32,
    handle: @void,
    thread_handle: @void,
    is_alive: bool,
    signal: i32,
}

// Represents an anonymous OS pipe with read and write endpoints.
view data Pipe {
    read_handle: @void,
    write_handle: @void,
}

// Captured standard output, standard error, and exit status of a child process.
view data ProcessOutput {
    stdout_str: string,
    stderr_str: string,
    exit_code: i32,
    success: bool,
}
