// std.os.proc_types — Process execution descriptors and return types.
// Zero C runtime dependencies.

// Represents the completion status and exit code of a spawned process.
data ProcessResult {
    exit_code: i32,
    success: bool,
}

// Represents a live or terminated child process handle.
data ProcessHandle {
    pid: u32,
    handle: @void,
    thread_handle: @void,
    is_alive: bool,
}
