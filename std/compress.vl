// std.compress — Standard compression library for RFC 1951 (DEFLATE), RFC 1950 (Zlib), and RFC 1952 (Gzip).
// Provides pure-Velo compression, decompression, checksums, and streaming framing with zero C runtime dependencies.
use "compress/adler32.vl"
use "compress/inflate.vl"
use "compress/deflate.vl"
use "compress/zlib.vl"
use "compress/gzip.vl"

// Computes the RFC 1950 Adler-32 checksum of a byte buffer.
view act adler32(data: @u8, len: usize) -> u32 {
    return adler32_calc(data, len)
}

// Computes the RFC 1950 Adler-32 checksum of a string.
view act adler32_str(s: string) -> u32 {
    return adler32_calc_str(s)
}
