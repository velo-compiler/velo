// High-precision Duration and Stopwatch benchmarking utilities for Velo.
use "clock.vl"

// Represents an elapsed span of time stored with nanosecond precision.
view data Duration {
    nanos: u64
}

// Creates a Duration representing zero time.
view act duration_zero() -> Duration {
    return Duration { nanos: 0 as u64 }
}

// Creates a Duration from nanoseconds.
view act duration_from_ns(ns: u64) -> Duration {
    return Duration { nanos: ns }
}

// Creates a Duration from microseconds.
view act duration_from_us(us: u64) -> Duration {
    return Duration { nanos: us * 1000 }
}

// Creates a Duration from milliseconds.
view act duration_from_ms(ms: u64) -> Duration {
    return Duration { nanos: ms * 1000000 }
}

// Creates a Duration from whole seconds.
view act duration_from_secs(s: u64) -> Duration {
    return Duration { nanos: s * 1000000000 }
}

// Creates a Duration from fractional seconds.
view act duration_from_secs_f64(s: f64) -> Duration {
    if s <= 0.0 {
        return Duration { nanos: 0 as u64 }
    }
    let ns = (s * 1000000000.0) as u64
    return Duration { nanos: ns }
}

// Returns the duration as total nanoseconds.
view act duration_as_ns(d: Duration) -> u64 {
    return d.nanos
}

// Returns the duration as total microseconds.
view act duration_as_us(d: Duration) -> u64 {
    return d.nanos / 1000
}

// Returns the duration as total milliseconds.
view act duration_as_ms(d: Duration) -> u64 {
    return d.nanos / 1000000
}

// Returns the duration as whole seconds.
view act duration_as_secs(d: Duration) -> u64 {
    return d.nanos / 1000000000
}

// Returns the duration as fractional floating-point seconds.
view act duration_as_secs_f64(d: Duration) -> f64 {
    return (d.nanos as f64) / 1000000000.0
}

// Adds two durations.
view act duration_add(a: Duration, b: Duration) -> Duration {
    return Duration { nanos: a.nanos + b.nanos }
}

// Subtracts b from a, saturating at zero if b > a.
view act duration_sub(a: Duration, b: Duration) -> Duration {
    if a.nanos >= b.nanos {
        return Duration { nanos: a.nanos - b.nanos }
    }
    return Duration { nanos: 0 as u64 }
}

// Multiplies a duration by a scalar factor.
view act duration_scale(d: Duration, factor: u64) -> Duration {
    return Duration { nanos: d.nanos * factor }
}

// Divides a duration by a scalar divisor. Returns zero if divisor is 0.
view act duration_div(d: Duration, divisor: u64) -> Duration {
    if divisor == 0 as u64 {
        return Duration { nanos: 0 as u64 }
    }
    return Duration { nanos: d.nanos / divisor }
}

// Compares two durations: returns -1 if a < b, 0 if a == b, 1 if a > b.
view act duration_cmp(a: Duration, b: Duration) -> i32 {
    if a.nanos < b.nanos {
        return -1
    }
    if a.nanos > b.nanos {
        return 1
    }
    return 0
}

// Returns true if two durations are equal.
view act duration_eq(a: Duration, b: Duration) -> bool {
    return a.nanos == b.nanos
}

// Returns true if the duration is zero.
view act duration_is_zero(d: Duration) -> bool {
    return d.nanos == 0 as u64
}

// High-resolution benchmarking and profiling stopwatch.
view data Stopwatch {
    start_ns: u64
    elapsed_accum_ns: u64
    is_running: bool
}

// Creates and immediately starts a new Stopwatch.
view act stopwatch_start() -> Stopwatch {
    return Stopwatch {
        start_ns: time_monotonic_ns(),
        elapsed_accum_ns: 0 as u64,
        is_running: true
    }
}

// Creates a stopped Stopwatch with 0 elapsed time.
view act stopwatch_new() -> Stopwatch {
    return Stopwatch {
        start_ns: 0 as u64,
        elapsed_accum_ns: 0 as u64,
        is_running: false
    }
}

// Resets the stopwatch to 0 elapsed time and stops it.
view act stopwatch_reset(sw: @Stopwatch) {
    if sw == null { return }
    sw.start_ns = 0 as u64
    sw.elapsed_accum_ns = 0 as u64
    sw.is_running = false
}

// Starts or resumes the stopwatch.
view act stopwatch_resume(sw: @Stopwatch) {
    if sw == null or sw.is_running { return }
    sw.start_ns = time_monotonic_ns()
    sw.is_running = true
}

// Stops or pauses the stopwatch, accumulating elapsed time.
view act stopwatch_stop(sw: @Stopwatch) {
    if sw == null or !sw.is_running { return }
    let now = time_monotonic_ns()
    if now >= sw.start_ns {
        sw.elapsed_accum_ns += (now - sw.start_ns)
    }
    sw.is_running = false
}

// Returns the total elapsed duration of the stopwatch.
view act stopwatch_elapsed(sw: @Stopwatch) -> Duration {
    if sw == null { return duration_zero() }
    mut total = sw.elapsed_accum_ns
    if sw.is_running {
        let now = time_monotonic_ns()
        if now >= sw.start_ns {
            total += (now - sw.start_ns)
        }
    }
    return Duration { nanos: total }
}

// Returns total elapsed time in nanoseconds.
view act stopwatch_elapsed_ns(sw: @Stopwatch) -> u64 {
    let d = stopwatch_elapsed(sw)
    return d.nanos
}

// Returns total elapsed time in microseconds.
view act stopwatch_elapsed_us(sw: @Stopwatch) -> u64 {
    let d = stopwatch_elapsed(sw)
    return duration_as_us(d)
}

// Returns total elapsed time in milliseconds.
view act stopwatch_elapsed_ms(sw: @Stopwatch) -> u64 {
    let d = stopwatch_elapsed(sw)
    return duration_as_ms(d)
}

// Returns total elapsed time in fractional seconds.
view act stopwatch_elapsed_secs(sw: @Stopwatch) -> f64 {
    let d = stopwatch_elapsed(sw)
    return duration_as_secs_f64(d)
}

// Restarts the stopwatch from 0 and returns the previous elapsed duration.
view act stopwatch_restart(sw: @Stopwatch) -> Duration {
    let prev = stopwatch_elapsed(sw)
    if sw != null {
        sw.start_ns = time_monotonic_ns()
        sw.elapsed_accum_ns = 0 as u64
        sw.is_running = true
    }
    return prev
}

// Records a lap: returns duration since start (or previous lap) and advances the baseline.
view act stopwatch_lap(sw: @Stopwatch) -> Duration {
    if sw == null { return duration_zero() }
    let elapsed = stopwatch_elapsed(sw)
    sw.start_ns = time_monotonic_ns()
    sw.elapsed_accum_ns = 0 as u64
    return elapsed
}
