// High-resolution monotonic clock and wall-clock Unix epoch timing for Windows.
// Backed directly by Win32 kernel services (QueryPerformanceCounter, GetSystemTimeAsFileTime).

// Number of 100-nanosecond intervals between Windows FileTime epoch (1601-01-01)
// and Unix epoch (1970-01-01): 11,644,473,600 seconds * 10,000,000.
view let WINDOWS_TO_UNIX_OFFSET: u64 = 116444736000000000 as u64

// Foreign interface to Windows kernel services
view extern act QueryPerformanceCounter(lpPerformanceCount: @i64) -> i32
view extern act QueryPerformanceFrequency(lpFrequency: @i64) -> i32
view extern act GetSystemTimeAsFileTime(lpSystemTimeAsFileTime: @u64)

// Returns the frequency of the performance counter in counts per second (Hz).
view act time_frequency() -> i64 {
    mut freq: i64 = 0
    QueryPerformanceFrequency(@freq)
    return freq
}

// Returns the current performance counter ticks.
view act time_monotonic_ticks() -> i64 {
    mut counter: i64 = 0
    QueryPerformanceCounter(@counter)
    return counter
}

// Returns the current high-resolution monotonic time in nanoseconds.
view act time_monotonic_ns() -> u64 {
    mut counter: i64 = 0
    mut freq: i64 = 0
    QueryPerformanceCounter(@counter)
    QueryPerformanceFrequency(@freq)
    if freq <= 0 or counter <= 0 {
        return 0 as u64
    }
    // Overflow-safe split: whole seconds * 1e9 + remainder * 1e9 / freq
    let whole = (counter / freq) as u64
    let rem = (counter % freq) as u64
    let rem_ns = (rem * 1000000000) / (freq as u64)
    return whole * 1000000000 + rem_ns
}

// Returns the current high-resolution monotonic time in microseconds.
view act time_monotonic_us() -> u64 {
    mut counter: i64 = 0
    mut freq: i64 = 0
    QueryPerformanceCounter(@counter)
    QueryPerformanceFrequency(@freq)
    if freq <= 0 or counter <= 0 {
        return 0 as u64
    }
    let whole = (counter / freq) as u64
    let rem = (counter % freq) as u64
    let rem_us = (rem * 1000000) / (freq as u64)
    return whole * 1000000 + rem_us
}

// Returns the current high-resolution monotonic time in milliseconds.
view act time_monotonic_ms() -> u64 {
    mut counter: i64 = 0
    mut freq: i64 = 0
    QueryPerformanceCounter(@counter)
    QueryPerformanceFrequency(@freq)
    if freq <= 0 or counter <= 0 {
        return 0 as u64
    }
    let whole = (counter / freq) as u64
    let rem = (counter % freq) as u64
    let rem_ms = (rem * 1000) / (freq as u64)
    return whole * 1000 + rem_ms
}

// Returns the current monotonic time in fractional seconds.
view act time_monotonic_s() -> f64 {
    mut counter: i64 = 0
    mut freq: i64 = 0
    QueryPerformanceCounter(@counter)
    QueryPerformanceFrequency(@freq)
    if freq <= 0 {
        return 0.0
    }
    return (counter as f64) / (freq as f64)
}

// Returns current UTC time in nanoseconds since the Unix epoch (1970-01-01 00:00:00 UTC).
view act time_now_epoch_ns() -> u64 {
    mut ft: u64 = 0
    GetSystemTimeAsFileTime(@ft)
    if ft < WINDOWS_TO_UNIX_OFFSET {
        return 0 as u64
    }
    let diff = ft - WINDOWS_TO_UNIX_OFFSET
    return diff * 100
}

// Returns current UTC time in microseconds since the Unix epoch.
view act time_now_epoch_us() -> u64 {
    mut ft: u64 = 0
    GetSystemTimeAsFileTime(@ft)
    if ft < WINDOWS_TO_UNIX_OFFSET {
        return 0 as u64
    }
    let diff = ft - WINDOWS_TO_UNIX_OFFSET
    return diff / 10
}

// Returns current UTC time in milliseconds since the Unix epoch.
view act time_now_epoch_ms() -> i64 {
    mut ft: u64 = 0
    GetSystemTimeAsFileTime(@ft)
    if ft < WINDOWS_TO_UNIX_OFFSET {
        return 0
    }
    let diff = ft - WINDOWS_TO_UNIX_OFFSET
    return (diff / 10000) as i64
}

// Returns current UTC time in seconds since the Unix epoch.
view act time_now_epoch_s() -> i64 {
    mut ft: u64 = 0
    GetSystemTimeAsFileTime(@ft)
    if ft < WINDOWS_TO_UNIX_OFFSET {
        return 0
    }
    let diff = ft - WINDOWS_TO_UNIX_OFFSET
    return (diff / 10000000) as i64
}

// Returns the non-negative difference in nanoseconds between start and end.
view act time_diff_ns(start_ns: u64, end_ns: u64) -> u64 {
    if end_ns >= start_ns {
        return end_ns - start_ns
    }
    return 0 as u64
}

// Returns the non-negative difference in milliseconds between start and end.
view act time_diff_ms(start_ms: u64, end_ms: u64) -> u64 {
    if end_ms >= start_ms {
        return end_ms - start_ms
    }
    return 0 as u64
}
