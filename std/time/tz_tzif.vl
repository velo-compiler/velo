// Pure Velo TZif binary file parser (RFC 8536 / RFC 4833) and POSIX-TZ string parser.
// Provides cross-platform parsing of timezone data and transitions.
use "clock.vl"
use "calendar.vl"
use "../mem/heap.vl"

// Represents a timezone descriptor with UTC offset in seconds and daylight saving status.
view data Tz {
    name: string   // Timezone name or offset descriptor (e.g. "EST", "+05:30", "UTC")
    offset: i32    // Offset from UTC in seconds (positive east of UTC, negative west of UTC)
    dst: bool      // True if daylight saving time (DST) is active
}

// Big-endian 32-bit unsigned integer reader.
view act tz_read_be_u32(buf: @u8, off: usize) -> u32 {
    let b0 = buf[off] as u32
    let b1 = buf[off + 1] as u32
    let b2 = buf[off + 2] as u32
    let b3 = buf[off + 3] as u32
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

// Big-endian 32-bit signed integer reader.
view act tz_read_be_i32(buf: @u8, off: usize) -> i32 {
    return tz_read_be_u32(buf, off) as i32
}

// Big-endian 64-bit signed integer reader.
view act tz_read_be_i64(buf: @u8, off: usize) -> i64 {
    let high = tz_read_be_u32(buf, off) as u64
    let low = tz_read_be_u32(buf, off + 4) as u64
    return ((high << 32) | low) as i64
}

// Formats a signed offset in seconds as a standard "+HH:MM" or "-HH:MM" string.
view act tz_format_offset_name(offset_sec: i32) -> string {
    mut buf: @u8 = heap_alloc(7) as @u8
    if buf == null { return "UTC" }
    mut off = offset_sec
    mut sign = '+' as u8
    if off < 0 {
        sign = '-' as u8
        off = -off
    }
    let total_mins = off / 60
    let h = total_mins / 60
    let m = total_mins % 60
    buf[0] = sign
    buf[1] = ('0' as u8) + (((h / 10) % 10) as u8)
    buf[2] = ('0' as u8) + ((h % 10) as u8)
    buf[3] = ':' as u8
    buf[4] = ('0' as u8) + (((m / 10) % 10) as u8)
    buf[5] = ('0' as u8) + ((m % 10) as u8)
    buf[6] = 0 as u8
    return buf as string
}

// Returns the UTC standard timezone (offset 0, dst false).
view act tz_utc() -> Tz {
    return Tz {
        name: "UTC",
        offset: 0,
        dst: false
    }
}

// Creates a fixed-offset timezone descriptor with dst set to false.
view act tz_make(name: string, offset_sec: i32) -> Tz {
    return Tz {
        name: name,
        offset: offset_sec,
        dst: false
    }
}

// Creates a timezone descriptor with explicit name, offset, and dst status.
view act tz_with_dst(name: string, offset_sec: i32, dst: bool) -> Tz {
    return Tz {
        name: name,
        offset: offset_sec,
        dst: dst
    }
}

// Parses an ISO offset string ("+05:30", "-05:00", "+02", "Z", "UTC") into seconds.
view act tz_parse_offset(str_offset: string) -> i32 {
    if str_offset == null { return 0 }
    let len = str.len(str_offset)
    if len == 0 { return 0 }

    if len == 1 and str_offset[0] == 'Z' { return 0 }
    if len == 3 and str_offset[0] == 'U' and str_offset[1] == 'T' and str_offset[2] == 'C' { return 0 }

    mut i: usize = 0
    mut sign: i32 = 1
    if str_offset[0] == '+' {
        sign = 1
        i += 1
    } else if str_offset[0] == '-' {
        sign = -1
        i += 1
    }

    mut hours: i32 = 0
    loop i < len and str_offset[i] >= '0' and str_offset[i] <= '9' {
        hours = hours * 10 + ((str_offset[i] - '0') as i32)
        i += 1
    }

    if i < len and str_offset[i] == ':' {
        i += 1
    }

    mut mins: i32 = 0
    loop i < len and str_offset[i] >= '0' and str_offset[i] <= '9' {
        mins = mins * 10 + ((str_offset[i] - '0') as i32)
        i += 1
    }

    if hours >= 100 {
        mins = hours % 100
        hours = hours / 100
    }

    return sign * (hours * 3600 + mins * 60)
}

// Parses a POSIX-TZ environment variable string (e.g. "EST5EDT,M3.2.0,M11.1.0", "JST-9", "UTC0").
view act tz_parse_posix(tz_str: string) -> Tz {
    if tz_str == null { return tz_utc() }
    let len = str.len(tz_str)
    if len == 0 { return tz_utc() }

    // 1. Standard abbreviation
    mut i: usize = 0
    loop i < len and ((tz_str[i] >= 'A' and tz_str[i] <= 'Z') or (tz_str[i] >= 'a' and tz_str[i] <= 'z')) {
        i += 1
    }
    let std_name_len = i
    mut std_name: string = "UTC"
    if std_name_len > 0 {
        mut sbuf: @u8 = heap_alloc(std_name_len + 1) as @u8
        if sbuf != null {
            mut k: usize = 0
            loop k < std_name_len {
                sbuf[k] = tz_str[k]
                k += 1
            }
            sbuf[std_name_len] = 0 as u8
            std_name = sbuf as string
        }
    }

    // 2. Standard offset (POSIX: positive means west of UTC; negative means east)
    mut sign: i32 = 1
    if i < len and tz_str[i] == '-' {
        sign = -1
        i += 1
    } else if i < len and tz_str[i] == '+' {
        sign = 1
        i += 1
    }

    mut hours: i32 = 0
    loop i < len and tz_str[i] >= '0' and tz_str[i] <= '9' {
        hours = hours * 10 + ((tz_str[i] - '0') as i32)
        i += 1
    }

    mut mins: i32 = 0
    if i < len and tz_str[i] == ':' {
        i += 1
        loop i < len and tz_str[i] >= '0' and tz_str[i] <= '9' {
            mins = mins * 10 + ((tz_str[i] - '0') as i32)
            i += 1
        }
    }

    let std_offset = -sign * (hours * 3600 + mins * 60)

    if i >= len or tz_str[i] == ',' {
        return Tz { name: std_name, offset: std_offset, dst: false }
    }

    // 3. DST abbreviation
    let dst_start = i
    loop i < len and ((tz_str[i] >= 'A' and tz_str[i] <= 'Z') or (tz_str[i] >= 'a' and tz_str[i] <= 'z')) {
        i += 1
    }
    let dst_len = i - dst_start
    mut dst_name = std_name
    if dst_len > 0 {
        mut dbuf: @u8 = heap_alloc(dst_len + 1) as @u8
        if dbuf != null {
            mut k: usize = 0
            loop k < dst_len {
                dbuf[k] = tz_str[dst_start + k]
                k += 1
            }
            dbuf[dst_len] = 0 as u8
            dst_name = dbuf as string
        }
    }

    let dst_offset = std_offset + 3600

    mut is_dst = false
    let now_dt = time_now_datetime()
    let cur_m = now_dt.month
    if cur_m >= 4 and cur_m <= 10 {
        is_dst = true
    } else if cur_m == 3 and now_dt.day >= 15 {
        is_dst = true
    } else if cur_m == 11 and now_dt.day <= 7 {
        is_dst = false
    }

    if is_dst {
        return Tz { name: dst_name, offset: dst_offset, dst: true }
    }
    return Tz { name: std_name, offset: std_offset, dst: false }
}

// Parses raw TZif binary file data (RFC 8536 / RFC 4833) and resolves the active timezone for now_s.
view act tz_parse_tzif_data(buf: @u8, len: usize, now_s: i64) -> Tz {
    if buf == null or len < 44 {
        return tz_utc()
    }
    if buf[0] != ('T' as u8) or buf[1] != ('Z' as u8) or buf[2] != ('i' as u8) or buf[3] != ('f' as u8) {
        return tz_utc()
    }

    let version = buf[4]
    mut base_off: usize = 0
    mut timecnt = tz_read_be_u32(buf, 32) as usize
    mut typecnt = tz_read_be_u32(buf, 36) as usize
    mut charcnt = tz_read_be_u32(buf, 40) as usize
    mut leapcnt = tz_read_be_u32(buf, 28) as usize
    mut ttisstdcnt = tz_read_be_u32(buf, 24) as usize
    mut ttisgmtcnt = tz_read_be_u32(buf, 20) as usize

    mut use_64 = false
    if version == ('2' as u8) or version == ('3' as u8) {
        let v1_len = timecnt * 4 + timecnt + typecnt * 6 + charcnt + leapcnt * 8 + ttisstdcnt + ttisgmtcnt
        let v2_off = 44 + v1_len
        if len >= v2_off + 44 and buf[v2_off] == ('T' as u8) and buf[v2_off + 1] == ('Z' as u8) and buf[v2_off + 2] == ('i' as u8) and buf[v2_off + 3] == ('f' as u8) {
            base_off = v2_off
            timecnt = tz_read_be_u32(buf, base_off + 32) as usize
            typecnt = tz_read_be_u32(buf, base_off + 36) as usize
            charcnt = tz_read_be_u32(buf, base_off + 40) as usize
            leapcnt = tz_read_be_u32(buf, base_off + 28) as usize
            ttisstdcnt = tz_read_be_u32(buf, base_off + 24) as usize
            ttisgmtcnt = tz_read_be_u32(buf, base_off + 20) as usize
            use_64 = true
        }
    }

    let time_sz: usize = if use_64 { 8 as usize } else { 4 as usize }
    let trans_off = base_off + 44
    let indices_off = trans_off + timecnt * time_sz
    let types_off = indices_off + timecnt
    let chars_off = types_off + typecnt * 6

    if types_off + typecnt * 6 + charcnt > len {
        return tz_utc()
    }

    if use_64 {
        let v2_body_len = timecnt * 8 + timecnt + typecnt * 6 + charcnt + leapcnt * 16 + ttisstdcnt + ttisgmtcnt
        let footer_off = base_off + 44 + v2_body_len
        if len > footer_off + 2 and buf[footer_off] == ('\n' as u8) {
            mut f_end = footer_off + 1
            loop f_end < len and buf[f_end] != ('\n' as u8) {
                f_end += 1
            }
            let f_len = f_end - (footer_off + 1)
            if f_len > 0 {
                mut f_str_buf: @u8 = heap_alloc(f_len + 1) as @u8
                if f_str_buf != null {
                    mut fi: usize = 0
                    loop fi < f_len {
                        f_str_buf[fi] = buf[footer_off + 1 + fi]
                        fi += 1
                    }
                    f_str_buf[f_len] = 0 as u8
                    let parsed_posix = tz_parse_posix(f_str_buf as string)
                    heap_free(f_str_buf)
                    return parsed_posix
                }
            }
        }
    }

    if typecnt == 0 {
        return tz_utc()
    }

    mut chosen_type: usize = 0
    if timecnt == 0 {
        chosen_type = 0
    } else {
        mut first_t: i64 = 0
        if use_64 {
            first_t = tz_read_be_i64(buf, trans_off)
        } else {
            first_t = tz_read_be_i32(buf, trans_off) as i64
        }

        if now_s < first_t {
            mut ti: usize = 0
            mut found = false
            loop ti < typecnt and !found {
                let isdst = buf[types_off + ti * 6 + 4]
                if isdst == (0 as u8) {
                    chosen_type = ti
                    found = true
                }
                ti += 1
            }
        } else {
            mut k: usize = 0
            mut last_idx: usize = 0
            loop k < timecnt {
                mut trans_t: i64 = 0
                if use_64 {
                    trans_t = tz_read_be_i64(buf, trans_off + k * 8)
                } else {
                    trans_t = tz_read_be_i32(buf, trans_off + k * 4) as i64
                }
                if trans_t <= now_s {
                    last_idx = k
                } else {
                    k = timecnt
                }
                k += 1
            }
            chosen_type = buf[indices_off + last_idx] as usize
            if chosen_type >= typecnt {
                chosen_type = 0
            }
        }
    }

    let utoff = tz_read_be_i32(buf, types_off + chosen_type * 6)
    let isdst = buf[types_off + chosen_type * 6 + 4] != (0 as u8)
    let desigidx = buf[types_off + chosen_type * 6 + 5] as usize

    mut name_len: usize = 0
    loop desigidx + name_len < charcnt and buf[chars_off + desigidx + name_len] != (0 as u8) {
        name_len += 1
    }

    mut tz_name: string = "UTC"
    if name_len > 0 {
        mut nbuf: @u8 = heap_alloc(name_len + 1) as @u8
        if nbuf != null {
            mut ni: usize = 0
            loop ni < name_len {
                nbuf[ni] = buf[chars_off + desigidx + ni]
                ni += 1
            }
            nbuf[name_len] = 0 as u8
            tz_name = nbuf as string
        }
    } else {
        tz_name = tz_format_offset_name(utoff)
    }

    return Tz {
        name: tz_name,
        offset: utoff,
        dst: isdst
    }
}
