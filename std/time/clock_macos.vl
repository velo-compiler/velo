// High-resolution monotonic clock and wall-clock Unix epoch timing for macOS / Darwin.
// Backed directly by POSIX clock_gettime syscalls (supported on macOS 10.12+).

view let CLOCK_REALTIME: i32 = 0
view let CLOCK_MONOTONIC: i32 = 6 // Darwin sys/time.h CLOCK_MONOTONIC is 6

view data Timespec {
    tv_sec: i64
    tv_nsec: i64
}

view extern act clock_gettime(clk_id: i32, tp: @Timespec) -> i32

// Returns standard 1 GHz clock resolution on Darwin.
view act time_frequency() -> i64 {
    return 1000000000
}

// Returns the current monotonic clock in nanoseconds as raw ticks.
view act time_monotonic_ticks() -> i64 {
    mut ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    clock_gettime(CLOCK_MONOTONIC, @ts)
    return ts.tv_sec * 1000000000 + ts.tv_nsec
}

// Returns the current high-resolution monotonic time in nanoseconds.
view act time_monotonic_ns() -> u64 {
    mut ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    clock_gettime(CLOCK_MONOTONIC, @ts)
    if ts.tv_sec < 0 or ts.tv_nsec < 0 {
        return 0 as u64
    }
    return (ts.tv_sec as u64) * 1000000000 + (ts.tv_nsec as u64)
}

// Returns the current high-resolution monotonic time in microseconds.
view act time_monotonic_us() -> u64 {
    return time_monotonic_ns() / 1000
}

// Returns the current high-resolution monotonic time in milliseconds.
view act time_monotonic_ms() -> u64 {
    return time_monotonic_ns() / 1000000
}

// Returns the current monotonic time in fractional seconds.
view act time_monotonic_s() -> f64 {
    mut ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    clock_gettime(CLOCK_MONOTONIC, @ts)
    return (ts.tv_sec as f64) + ((ts.tv_nsec as f64) / 1000000000.0)
}

// Returns current UTC time in nanoseconds since the Unix epoch (1970-01-01 00:00:00 UTC).
view act time_now_epoch_ns() -> u64 {
    mut ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    clock_gettime(CLOCK_REALTIME, @ts)
    if ts.tv_sec < 0 or ts.tv_nsec < 0 {
        return 0 as u64
    }
    return (ts.tv_sec as u64) * 1000000000 + (ts.tv_nsec as u64)
}

// Returns current UTC time in microseconds since the Unix epoch.
view act time_now_epoch_us() -> u64 {
    return time_now_epoch_ns() / 1000
}

// Returns current UTC time in milliseconds since the Unix epoch.
view act time_now_epoch_ms() -> i64 {
    mut ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    clock_gettime(CLOCK_REALTIME, @ts)
    return ts.tv_sec * 1000 + (ts.tv_nsec / 1000000)
}

// Returns current UTC time in seconds since the Unix epoch.
view act time_now_epoch_s() -> i64 {
    mut ts = Timespec { tv_sec: 0, tv_nsec: 0 }
    clock_gettime(CLOCK_REALTIME, @ts)
    return ts.tv_sec
}

// Returns the non-negative difference in nanoseconds between start and end.
view act time_diff_ns(start_ns: u64, end_ns: u64) -> u64 {
    if end_ns >= start_ns {
        return end_ns - start_ns
    }
    return 0 as u64
}

// Returns the non-negative difference in milliseconds between start and end.
view act time_diff_ms(start_ms: u64, end_ms: u64) -> u64 {
    if end_ms >= start_ms {
        return end_ms - start_ms
    }
    return 0 as u64
}
