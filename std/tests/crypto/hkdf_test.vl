// Tests for std.crypto.hkdf (RFC 5869 and RFC 8446)
use "../../crypto/hkdf.vl"
use "../../crypto/hex.vl"
use "../../crypto/subtle.vl"
use "../../crypto/sha256.vl"
use "../../mem/heap.vl"
use "../../io/print.vl"

act main() -> i32 {
    // 1. RFC 5869 Test Case 1
    let ikm_hex = "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"
    let salt_hex = "000102030405060708090a0b0c"
    let info_hex = "f0f1f2f3f4f5f6f7f8f9"
    let expected_prk_hex = "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"
    let expected_okm_hex = "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"

    let ikm: @u8 = heap_alloc(22) as @u8
    hex_to_bytes(ikm_hex, ikm, 22)
    let salt: @u8 = heap_alloc(13) as @u8
    hex_to_bytes(salt_hex, salt, 13)
    let info: @u8 = heap_alloc(10) as @u8
    hex_to_bytes(info_hex, info, 10)

    let prk: @u8 = heap_alloc(32) as @u8
    hkdf_sha256_extract(salt, 13, ikm, 22, prk)
    let prk_hex = bytes_to_hex(prk, 32)
    if not crypto_secure_eq_str(prk_hex, expected_prk_hex) {
        println_str("HKDF Case 1 PRK mismatch")
        return 1
    }

    let okm: @u8 = heap_alloc(42) as @u8
    let ok = hkdf_sha256_expand(prk, 32, info, 10, okm, 42)
    if not ok {
        println_str("HKDF Case 1 expand failed")
        return 2
    }
    let okm_hex = bytes_to_hex(okm, 42)
    if not crypto_secure_eq_str(okm_hex, expected_okm_hex) {
        println_str("HKDF Case 1 OKM mismatch")
        return 3
    }

    // 2. Test full one-shot hkdf_sha256
    let okm2: @u8 = heap_alloc(42) as @u8
    let ok2 = hkdf_sha256(salt, 13, ikm, 22, info, 10, okm2, 42)
    if not ok2 or not crypto_secure_eq(okm, okm2, 42) {
        println_str("HKDF one-shot mismatch")
        return 4
    }

    // 3. Test TLS 1.3 Derive-Secret with RFC 8448 Early Secret derivation
    // In RFC 8448 Section 3:
    // Early Secret = HKDF-Extract(salt=00 (32 bytes), IKM=00 (32 bytes))
    // PRK = 33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a
    let zero32: @u8 = heap_alloc(32) as @u8
    crypto_zero(zero32, 32)
    let early_secret: @u8 = heap_alloc(32) as @u8
    hkdf_sha256_extract(zero32, 32, zero32, 32, early_secret)
    let early_hex = bytes_to_hex(early_secret, 32)
    let exp_early = "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"
    if not crypto_secure_eq_str(early_hex, exp_early) {
        println_str("RFC 8448 Early Secret mismatch")
        return 5
    }

    // Derive "derived" secret:
    // derived = Derive-Secret(Early Secret, "derived", "")
    // Empty SHA-256 hash = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    let empty_hash: @u8 = heap_alloc(32) as @u8
    sha256_bytes(zero32, 0, empty_hash)
    let derived: @u8 = heap_alloc(32) as @u8
    let ok_der = tls13_derive_secret(early_secret, "derived", empty_hash, derived)
    if not ok_der {
        println_str("Derive-Secret failed")
        return 6
    }
    let der_hex = bytes_to_hex(derived, 32)
    let exp_der = "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba"
    if not crypto_secure_eq_str(der_hex, exp_der) {
        println_str("RFC 8448 derived secret mismatch")
        return 7
    }

    heap_free(ikm as @void); heap_free(salt as @void); heap_free(info as @void)
    heap_free(prk as @void); heap_free(okm as @void); heap_free(okm2 as @void)
    heap_free(zero32 as @void); heap_free(early_secret as @void)
    heap_free(empty_hash as @void); heap_free(derived as @void)

    println_str("HKDF RFC 5869 & RFC 8448 tests passed")
    return 0
}
