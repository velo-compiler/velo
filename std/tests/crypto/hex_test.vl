// Tests for std.crypto.hex
use "../../crypto/hex.vl"
use "../../io.vl"
use "../../mem/heap.vl"

act main() -> i32 {
    mut b: @u8 = heap_alloc(4)
    b[0] = 0x00 as u8
    b[1] = 0x0F as u8
    b[2] = 0x10 as u8
    b[3] = 0xFF as u8

    let h = bytes_to_hex(b, 4)
    if h != "000f10ff" {
        io.println_str("FAIL: bytes_to_hex mismatch")
        heap_free(b)
        return 1
    }

    mut out: @u8 = heap_alloc(4)
    let count1 = hex_to_bytes("000f10ff", out, 4)
    if count1 != 4 or out[0] != (0 as u8) or out[1] != (15 as u8) or out[2] != (16 as u8) or out[3] != (255 as u8) {
        io.println_str("FAIL: hex_to_bytes lowercase mismatch")
        heap_free(b)
        heap_free(out)
        return 2
    }

    let count2 = hex_to_bytes("000F10FF", out, 4)
    if count2 != 4 or out[0] != (0 as u8) or out[1] != (15 as u8) or out[2] != (16 as u8) or out[3] != (255 as u8) {
        io.println_str("FAIL: hex_to_bytes uppercase mismatch")
        heap_free(b)
        heap_free(out)
        return 3
    }

    heap_free(b)
    heap_free(out)

    io.println_str("OK: std.crypto.hex tests passed")
    return 0
}
