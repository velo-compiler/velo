// Tests for std.crypto.ed25519 (RFC 8032 Section 7.1)
use "../../crypto/ed25519.vl"
use "../../crypto/hex.vl"
use "../../crypto/subtle.vl"
use "../../mem/heap.vl"
use "../../io/print.vl"

act main() -> i32 {
    // RFC 8032 Section 7.1 Test 1 (Empty message)
    let pk_hex_1  = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    let sig_hex_1 = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"

    let ok1 = ed25519_verify_str(pk_hex_1, "", sig_hex_1)
    if not ok1 {
        println_str("RFC 8032 Test 1 failed")
        return 1
    }

    // RFC 8032 Section 7.1 Test 2 (1-byte message: 0x72 "r")
    let pk_hex_2  = "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
    let sig_hex_2 = "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"

    let ok2 = ed25519_verify_str(pk_hex_2, "r", sig_hex_2)
    if not ok2 {
        println_str("RFC 8032 Test 2 failed")
        return 2
    }

    // Negative test 1: Tampered signature must fail verification
    let bad_sig = "f5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
    let ok_bad = ed25519_verify_str(pk_hex_1, "", bad_sig)
    if ok_bad {
        println_str("Ed25519 accepted tampered signature!")
        return 3
    }

    // Negative test 2: Wrong public key must fail verification
    let ok_wrong_pk = ed25519_verify_str(pk_hex_2, "", sig_hex_1)
    if ok_wrong_pk {
        println_str("Ed25519 accepted signature with wrong public key!")
        return 4
    }

    // Negative test 3: Tampered message must fail verification
    let ok_tampered_msg = ed25519_verify_str(pk_hex_2, "s", sig_hex_2)
    if ok_tampered_msg {
        println_str("Ed25519 accepted tampered message!")
        return 5
    }

    println_str("Ed25519 RFC 8032 tests passed")
    return 0
}
