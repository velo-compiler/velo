// std/tests/fixed_array_test.vl — Tests for fixed-size stack arrays ([N]T)
use std.io

act sum_bytes(p: @u8, count: usize) -> u32 {
    mut s: u32 = 0
    mut i: usize = 0
    loop i < count {
        s += p[i] as u32
        i += 1
    }
    return s
}

act first_elem(arr: [4]i32) -> i32 {
    return arr[0]
}

data BufferHolder {
    id: i32
    data: [8]u8
}

act main() {
    // 1. Zero-initialized stack buffer
    mut buf: [16]u8
    assert(buf.len == 16)
    assert(buf[0] == 0 as u8)
    assert(buf[15] == 0 as u8)

    // 2. Element mutation and read-back
    buf[0] = 42 as u8
    buf[1] = 100 as u8
    buf[15] = 99 as u8
    assert(buf[0] == 42 as u8)
    assert(buf[1] == 100 as u8)
    assert(buf[15] == 99 as u8)

    // 3. Array literal with explicit type annotation
    let primes: [4]i32 = [2, 3, 5, 7]
    assert(primes.len == 4)
    assert(primes[0] == 2)
    assert(primes[1] == 3)
    assert(primes[2] == 5)
    assert(primes[3] == 7)

    // 4. Inferred array literal
    let vals = [10, 20, 30]
    assert(vals.len == 3)
    assert(vals[0] == 10)
    assert(vals[1] == 20)
    assert(vals[2] == 30)

    // 5. Whole array copy / assignment
    mut copy_primes: [4]i32
    copy_primes = primes
    assert(copy_primes[0] == 2)
    assert(copy_primes[3] == 7)

    // 6. Raw pointer access (.ptr)
    let p = buf.ptr
    assert(p != null)
    p[2] = 88 as u8
    assert(buf[2] == 88 as u8)

    // 7. Function argument decay ([N]T -> @T)
    let sum = sum_bytes(buf, buf.len)
    assert(sum == (42 + 100 + 88 + 99) as u32)

    // 8. Function argument with fixed-size parameter ([4]i32)
    assert(first_elem(primes) == 2)

    // 9. Struct with fixed-size array field
    mut bh = BufferHolder{ id: 42, data: [1 as u8, 2 as u8, 3 as u8, 4 as u8, 5 as u8, 6 as u8, 7 as u8, 8 as u8] }
    assert(bh.id == 42)
    assert(bh.data.len == 8)
    assert(bh.data[0] == 1 as u8)
    assert(bh.data[7] == 8 as u8)
    bh.data[3] = 99 as u8
    assert(bh.data[3] == 99 as u8)

    // 10. Stack array in a loop
    mut k: usize = 0
    loop k < 16 {
        buf[k] = (k * 2) as u8
        k += 1
    }
    assert(buf[0] == 0 as u8)
    assert(buf[5] == 10 as u8)
    assert(buf[15] == 30 as u8)

    io.println("All fixed-size stack array tests passed successfully!")
}

