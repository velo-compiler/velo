use std.crypto
use std.io

act main() -> i32 {
    // 1. SHA-256
    let s = sha256_hash_str("velo")
    if s != "cd1e45e8b94d27b2562ab5ae45b4bff61e2bc89d9ca4ffe117e70aa5ac8ef1eb" {
        io.println_str("FAIL: umbrella sha256 mismatch")
        return 1
    }

    // 2. MD5
    let m = md5_hash_str("velo")
    if m != "939c04836f9dda50950db42092831eec" {
        io.println_str("FAIL: umbrella md5 mismatch")
        return 2
    }

    // 3. CRC-32
    let c = crc32_hash_str("velo")
    if c != (0x354971f5 as u32) {
        io.println_str("FAIL: umbrella crc32 mismatch")
        return 3
    }

    // 4. HMAC-SHA256
    let h = hmac_sha256_str("secret", "velo")
    if h != "3d60592aea1342a9bada59d6ebce09a52b5af47aa5f881fafb47daf55d1023b3" {
        io.println_str("FAIL: umbrella hmac mismatch")
        return 4
    }

    // 5. CSPRNG
    let rnd_hex = crypto_random_hex(8)
    if str.len(rnd_hex) != 16 {
        io.println_str("FAIL: umbrella crypto_random_hex length mismatch")
        return 5
    }

    io.println_str("PASS: std.crypto umbrella import all tests passed")
    return 0
}
