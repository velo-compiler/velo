// Comprehensive unit tests for std.validate standard library module.
use "../../validate.vl"
use "../../io.vl"

act main() -> i32 {
    // 1. String validators
    if not validate_not_blank("hello") or validate_not_blank("   \t\n  ") { return 1 }
    if not validate_length("velo", 1, 10) or validate_length("velo", 5, 10) { return 2 }
    mut non_asc: @u8 = heap_alloc(4)
    non_asc[0] = 200 as u8
    non_asc[1] = 0 as u8
    let is_non_asc = validate_ascii(non_asc as string)
    heap_free(non_asc)

    if not validate_ascii("Antigravity 2.0") or is_non_asc { return 3 }
    if not validate_alpha("VeloLang") or validate_alpha("Velo123") { return 4 }
    if not validate_alphanumeric("Velo2026") or validate_alphanumeric("Velo 2026") { return 5 }
    if not validate_numeric("1234567890") or validate_numeric("123a") { return 6 }
    if not validate_hex("deadBEEF42") or validate_hex("xyz123") { return 7 }
    if not validate_base64("VmVsb0xhbmc=") or not validate_base64("") or validate_base64("====") { return 8 }

    // 2. Numeric & Checksum validators
    if not validate_range_i64(50, 10, 100) or validate_range_i64(5, 10, 100) { return 10 }
    if not validate_range_f64(3.14, 0.0, 5.0) or validate_range_f64(10.5, 0.0, 5.0) { return 11 }
    if not validate_positive_i64(42) or validate_positive_i64(0) or validate_positive_i64(-5) { return 12 }
    if not validate_non_negative_i64(0) or not validate_non_negative_i64(10) or validate_non_negative_i64(-1) { return 13 }

    // Luhn algorithm (valid numbers: 79927398713, 49927398716)
    if not validate_luhn("79927398713") or validate_luhn("79927398714") { return 14 }
    if not validate_credit_card("4532-0150-1234-5671") or validate_credit_card("1234") { return 15 }

    // ISBN-10 (0-306-40615-2) and ISBN-13 (978-0-306-40615-7)
    if not validate_isbn10("0-306-40615-2") or validate_isbn10("0-306-40615-3") { return 16 }
    if not validate_isbn13("978-0-306-40615-7") or validate_isbn13("978-0-306-40615-0") { return 17 }

    // 3. Network & Address validators
    if not validate_ipv4("127.0.0.1") or not validate_ipv4("192.168.1.254") { return 20 }
    if validate_ipv4("256.0.0.1") or validate_ipv4("127.0.0.01") or validate_ipv4("127.0.0") { return 21 }

    if not validate_ipv6("::1") or not validate_ipv6("2001:db8::ff00:42:8329") { return 22 }
    if validate_ipv6("2001:db8:::1") or validate_ipv6("12345::1") { return 23 }

    if not validate_ip("10.0.0.1") or not validate_ip("::1") or validate_ip("not.an.ip") { return 24 }
    if not validate_port(80) or not validate_port(65535) or validate_port(0) or validate_port(65536) { return 25 }

    if not validate_mac_address("00:1A:2B:3C:4D:5E") or not validate_mac_address("00-1A-2B-3C-4D-5E") { return 26 }
    if validate_mac_address("00:1A:2B:3C:4D") or validate_mac_address("00:1Z:2B:3C:4D:5E") { return 27 }

    if not validate_hostname("api.github.com") or not validate_hostname("localhost") { return 28 }
    if validate_hostname("-invalid.com") or validate_hostname("invalid-.com") { return 29 }

    if not validate_domain("velo-lang.org") or not validate_domain("sub.example.co.uk") { return 30 }
    if validate_domain("localhost") or validate_domain("domain.c") { return 31 }

    // 4. Web & Identifier validators
    if not validate_email("user@example.com") or not validate_email("first.last+tag@sub.domain.org") { return 40 }
    if validate_email("user@") or validate_email("@domain.com") or validate_email("user..name@domain.com") { return 41 }

    if not validate_url("https://example.com/api/v1?query=1#hash") or not validate_url("http://127.0.0.1:8080/") { return 42 }
    if validate_url("htp://broken.com") or validate_url("https://") or validate_url("example.com") { return 43 }

    if not validate_uuid("6ba7b810-9dad-11d1-80b4-00c04fd430c8") or not validate_uuid("6ba7b8109dad11d180b400c04fd430c8") { return 44 }
    if validate_uuid("6ba7b810-9dad-11d1-80b4-00c04fd430cZ") { return 45 }

    if not validate_slug("standard-library-validation") or not validate_slug("velo-v2") { return 46 }
    if validate_slug("-leading") or validate_slug("trailing-") or validate_slug("double--dash") { return 47 }

    if not validate_semver("1.0.0") or not validate_semver("2.1.3-beta.1") or not validate_semver("0.1.0+20261101") { return 48 }
    if validate_semver("1.0") or validate_semver("01.2.3") or validate_semver("v1.0.0") { return 49 }

    io.println_str("std.validate tests: ALL PASSED")
    return 0
}
