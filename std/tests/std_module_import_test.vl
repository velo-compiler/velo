// Tests native 'use std.<module>' and 'use std.<submodule>.<component>' imports.
use std.io
use std.coll
use std.mem
use std.str
use std.fmt
use std.json
use std.time
use std.math
use std.os
use std.net
use std.crypto
use std.http
use std.log
use std.test
use std.encoding
use std.csv
use std.cli
use std.url
use std.rand
use std.uuid
use std.text
use std.timer
use std.validate

act main() -> i32 {
    // std.coll: dynamic shelf
    mut s = shelf_create(8, 4)
    shelf_push_i64(@s, 111)
    if shelf_get_i64(@s, 0) != 111 { shelf_free(@s); return 1 }
    shelf_free(@s)

    // std.coll: FIFO ring
    mut r = ring_create(8, 8)
    ring_put_i64(@r, 222)
    mut vr: i64 = 0
    if !ring_pop_i64(@r, @vr) or vr != 222 { ring_free(@r); return 2 }
    ring_free(@r)

    // std.coll: hash map
    mut m = map_create_str(8, 8)
    map_put_str_i64(@m, "test_k", 333)
    mut vm: i64 = 0
    if !map_get_str_i64(@m, "test_k", @vm) or vm != 333 { map_free(@m); return 3 }
    map_free(@m)

    // std.str & std.fmt: string slice and format
    let sl = slice_from_str("velo_std")
    if sl.len != 8 { return 4 }

    // std.json: parse and stringify
    mut arena = arena_init(4096)
    defer arena_reset(@arena)
    mut err = JsonParseError { message: slice_from_raw(null, 0), line: 0, col: 0 }
    let jroot = json_parse_str(@arena, "{\"k\":\"v\"}", @err)
    if jroot == null or !json_is_object(jroot) { return 5 }
    let v_str = json_obj_get_str_val(jroot, "k", "")
    if !slice_eq_str(v_str, "v") { return 6 }
    let jstr = json_stringify(@arena, jroot)
    if !slice_eq_str(jstr, "{\"k\":\"v\"}") { return 7 }

    // std.time: duration and stopwatch
    mut sw = stopwatch_start()
    let d = stopwatch_elapsed(@sw)
    let d_zero = duration_zero()
    if duration_cmp(d, d_zero) < 0 { return 8 }

    // std.math: bitwise popcount, isqrt, and trigonometry
    if popcount32(0xFF as u32) != 8 as u32 { return 9 }
    if isqrt_u64(144 as u64) != 12 as u64 { return 10 }
    let s2 = sqrt_f64(2.0)
    if abs_f64(s2 * s2 - 2.0) > 0.00001 { return 11 }

    // std.os: metadata, command-line arguments, and process spawning
    if os_get_pid() == (0 as u32) { return 12 }
    let os_args = os_tokenize_cmdline(@arena, "velo build app.vl")
    if args_count(@os_args) != 3 { return 13 }
    let r_proc = os_spawn_sync("cmd.exe /c exit 0")
    if !r_proc.success { return 14 }

    // std.net: IP address parsing, endian conversions, and socket address
    if net_htons(80) != 20480 { return 15 }
    if net_parse_ipv4("127.0.0.1") != 0x0100007F as u32 { return 16 }
    let saddr = socket_addr_make("127.0.0.1", 8080)
    if saddr.port != 8080 { return 17 }

    // std.crypto: SHA-256, MD5, CRC-32, HMAC-SHA256, CSPRNG
    let sh = sha256_hash_str("test")
    if sh != "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08" { return 18 }
    let md = md5_hash_str("test")
    if md != "098f6bcd4621d373cade4e832627b4f6" { return 19 }
    let cr = crc32_hash_str("test")
    if cr != (0xd87f7e0c as u32) { return 20 }
    let hm = hmac_sha256_str("key", "test")
    if hm != "02afb56304902c656fcb737cdd03de6205bb6d401da2812efd9b2d36a08af159" { return 21 }
    let rn = crypto_random_range(10 as u64, 20 as u64)
    if rn < (10 as u64) or rn > (20 as u64) { return 22 }

    // std.http: status codes, URL parsing, percent-encoding, request/response
    if STATUS_OK != (200 as u16) or http_status_text(STATUS_OK) != "OK" { return 23 }
    let hurl = http_parse_url("http://127.0.0.1:8080/api?v=1")
    if hurl.port != (8080 as u16) or hurl.path != "/api" { return 24 }
    let henc = url_encode("hello world")
    if henc != "hello%20world" { return 25 }

    // std.log: severity levels and in-memory logging
    log_enable_console(false)
    log_enable_memory_sink(true)
    log_clear_memory()
    info("std.log integrated test")
    if log_get_last_message() != "std.log integrated test" { return 26 }

    // std.test: assertions and runner
    test_reset()
    test_set_quiet(true)
    if !assert_true(true, "truth") { return 27 }
    if !assert_eq_i64(100 as i64, 100 as i64, "numbers equal") { return 28 }
    if !assert_eq_str("test", "test", "strings equal") { return 29 }
    if test_get_failed_asserts() != 0 { return 30 }

    // std.encoding: Base64 and Base32 codecs
    let b64_t = base64_encode_str("velo")
    if b64_t != "dmVsbw==" { return 31 }
    let b32_t = base32_encode_str("velo")
    if b32_t != "OZSWY3Y=" { return 32 }

    // std.csv: streaming record parsing and record generation
    mut csv_arena = arena_init(4096)
    defer arena_reset(@csv_arena)
    mut csv_r = csv_reader_init_str("name,qty\nwrench,4")
    mut crec = CsvRecord { row: 0, first: null, count: 0, ok: false }
    if !csv_read_record(@csv_r, @csv_arena, @crec) or crec.count != 2 { return 33 }
    if !csv_read_record(@csv_r, @csv_arena, @crec) { return 34 }
    if csv_record_field_str(@crec, 0, @csv_arena) != "wrench" { return 35 }
    let csv_fields = arena_alloc(@csv_arena, 2 * 8, 8) as @string
    if csv_fields == null { return 36 }
    csv_fields[0] = "k"
    csv_fields[1] = "v,1"
    if csv_make_row_str(csv_fields, 2, false) != "k,\"v,1\"\n" { return 37 }

    // std.cli: context initialization and query
    let cli_args = os_tokenize_cmdline(@arena, "tool --verbose")
    let d_cli: @Args = null
    let c_ptr = arena_alloc_zeroed(@arena, (d_cli + 1) as usize, 8) as @Args
    c_ptr.count = cli_args.count
    c_ptr.items = cli_args.items
    c_ptr.raw = cli_args.raw
    mut cli_p = cli_parser_init(@arena, c_ptr)
    cli_parser_flag(@cli_p, "verbose", "v", false, false, "", "verbose")
    if !cli_parse(@cli_p) { return 38 }
    if !cli_flag_bool(@cli_p, "verbose") { return 39 }

    // std.url: full URL parsing, query parameter retrieval, and URL formatting
    mut test_url = url_new()
    if !url_parse("https://user:pass@host.org:8080/path?key=value#frag", @test_url) { return 40 }
    if test_url.port != 8080 or test_url.hostname != "host.org" { return 41 }
    let qv = url_query_get(test_url.raw_query, "key")
    if qv != "value" { return 42 }
    if url_join_path("/base/", "/sub") != "/base/sub" { return 43 }

    // std.rand: PCG64 seeded PRNG, range sampling, and shuffling
    mut prng = rng_seed(12345 as u64)
    let ru = rand_range_u64(@prng, 1 as u64, 100 as u64)
    if ru < (1 as u64) or ru > (100 as u64) { return 44 }
    let rf = rand_f64(@prng)
    if rf < 0.0 or rf >= 1.0 { return 45 }
    let rs = rand_string(@prng, 8)
    if rs == null { return 46 }

    // std.uuid: v4/v7 generation, parsing, formatting
    let test_u4 = uuid_v4()
    if uuid_version(@test_u4) != 4 { return 47 }
    let test_u7 = uuid_v7()
    if uuid_version(@test_u7) != 7 { return 48 }
    let u_str = uuid_to_string(@test_u7)
    mut u_parsed = uuid_nil()
    if !uuid_parse(u_str, @u_parsed) or !uuid_eq(@test_u7, @u_parsed) { return 49 }

    // std.text: layout, alignment, wrapping, measurement, indentation
    let t_al = text_align_center("ok", 6, '=' as u8)
    if t_al != "==ok==" { return 50 }
    let t_wr = text_wrap("wrap multiple words cleanly", 14)
    if text_line_count(t_wr) < 2 { return 51 }
    let t_st = text_strip_ansi("\x1b[32mhello\x1b[0m")
    if t_st != "hello" { return 52 }
    let t_tr = text_truncate("antigravity", 7, "...")
    if t_tr != "anti..." { return 53 }

    // std.timer: high-res timer, countdown, ticker, and callback queue
    mut test_tm = timer_start()
    timer_spin_wait_us(100 as u64)
    if timer_elapsed_us(@test_tm) == (0 as u64) { return 54 }
    mut test_cd = countdown_start_ms(20 as u64)
    if countdown_is_expired(@test_cd) { return 55 }
    mut test_tk = ticker_start_ms(5 as u64)
    if ticker_ticks(@test_tk) != (0 as u64) { return 56 }
    mut test_tq = timer_queue_new(4)
    defer timer_queue_free(@test_tq)
    if timer_queue_active_count(@test_tq) != 0 { return 57 }

    // std.validate: email, ip, url, slug, credit card, range
    if !validate_email("team@velo-lang.org") { return 58 }
    if !validate_ipv4("10.0.0.1") or !validate_ipv6("::1") { return 59 }
    if !validate_url("https://velo-lang.org/docs") { return 60 }
    if !validate_slug("release-v2") { return 61 }
    if !validate_credit_card("4532015012345671") { return 62 }

    println_str("PASS: native use std.* imports succeeded")
    return 0
}
