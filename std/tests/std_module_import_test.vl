// Tests native 'use std.<module>' and 'use std.<submodule>.<component>' imports.
use std.io
use std.coll
use std.mem
use std.str
use std.fmt
use std.json
use std.time
use std.math
use std.os
use std.net

act main() -> i32 {
    // std.coll: dynamic shelf
    mut s = shelf_create(8, 4)
    shelf_push_i64(@s, 111)
    if shelf_get_i64(@s, 0) != 111 { shelf_free(@s); return 1 }
    shelf_free(@s)

    // std.coll: FIFO ring
    mut r = ring_create(8, 8)
    ring_put_i64(@r, 222)
    mut vr: i64 = 0
    if !ring_pop_i64(@r, @vr) or vr != 222 { ring_free(@r); return 2 }
    ring_free(@r)

    // std.coll: hash map
    mut m = map_create_str(8, 8)
    map_put_str_i64(@m, "test_k", 333)
    mut vm: i64 = 0
    if !map_get_str_i64(@m, "test_k", @vm) or vm != 333 { map_free(@m); return 3 }
    map_free(@m)

    // std.str & std.fmt: string slice and format
    let sl = slice_from_str("velo_std")
    if sl.len != 8 { return 4 }

    // std.json: parse and stringify
    mut arena = arena_init(4096)
    defer arena_reset(@arena)
    mut err = JsonParseError { message: slice_from_raw(null, 0), line: 0, col: 0 }
    let jroot = json_parse_str(@arena, "{\"k\":\"v\"}", @err)
    if jroot == null or !json_is_object(jroot) { return 5 }
    let v_str = json_obj_get_str_val(jroot, "k", "")
    if !slice_eq_str(v_str, "v") { return 6 }
    let jstr = json_stringify(@arena, jroot)
    if !slice_eq_str(jstr, "{\"k\":\"v\"}") { return 7 }

    // std.time: duration and stopwatch
    mut sw = stopwatch_start()
    let d = stopwatch_elapsed(@sw)
    let d_zero = duration_zero()
    if duration_cmp(d, d_zero) < 0 { return 8 }

    // std.math: bitwise popcount, isqrt, and trigonometry
    if popcount32(0xFF as u32) != 8 as u32 { return 9 }
    if isqrt_u64(144 as u64) != 12 as u64 { return 10 }
    let s2 = sqrt_f64(2.0)
    if abs_f64(s2 * s2 - 2.0) > 0.00001 { return 11 }

    // std.os: metadata, command-line arguments, and process spawning
    if os_get_pid() == (0 as u32) { return 12 }
    let os_args = os_tokenize_cmdline(@arena, "velo build app.vl")
    if args_count(@os_args) != 3 { return 13 }
    let r_proc = os_spawn_sync("cmd.exe /c exit 0")
    if !r_proc.success { return 14 }

    // std.net: IP address parsing, endian conversions, and socket address
    if net_htons(80) != 20480 { return 15 }
    if net_parse_ipv4("127.0.0.1") != 0x0100007F as u32 { return 16 }
    let saddr = socket_addr_make("127.0.0.1", 8080)
    if saddr.port != 8080 { return 17 }

    println_str("PASS: native use std.* imports succeeded")
    return 0
}

