// std.net.types (Windows) — Core networking constants for Win32/Winsock.
//
// Phase 70 / Task 70.2: these values are Win32's. `SOL_SOCKET` is 0xFFFF here
// and 1 on POSIX; `SO_REUSEADDR` is 4 here and 2 there; `AF_INET6` is 23 here
// and 10 there. A single neutral file could only be correct on one platform,
// so the constants are split per platform and the resolver picks by target
// (Phase 70 / Task 70.1). Callers keep writing `use "types.vl"`; that path
// resolves to this file when the target is windows.
//
// Constants cannot be `extern`-bound from the runtime header (only functions
// can), which is why this is a variant file rather than a header branch.

// Address Families
view let AF_UNSPEC: i32 = 0
view let AF_INET: i32 = 2
view let AF_INET6: i32 = 23 // Win32; POSIX uses 10

// Socket Types
view let SOCK_STREAM: i32 = 1 // Sequenced, reliable, two-way connection-based byte streams (TCP)
view let SOCK_DGRAM: i32 = 2  // Connectionless, unreliable datagrams of fixed maximum length (UDP)
view let SOCK_RAW: i32 = 3

// Protocols
view let IPPROTO_IP: i32 = 0
view let IPPROTO_TCP: i32 = 6
view let IPPROTO_UDP: i32 = 17

// Socket Options Levels & Names
view let SOL_SOCKET: i32 = 65535 // 0xFFFF on Win32
view let SO_DEBUG: i32 = 1
view let SO_REUSEADDR: i32 = 4
view let SO_KEEPALIVE: i32 = 8
view let SO_DONTROUTE: i32 = 16
view let SO_BROADCAST: i32 = 32
view let SO_LINGER: i32 = 128
view let SO_OOBINLINE: i32 = 256
view let SO_SNDBUF: i32 = 4097
view let SO_RCVBUF: i32 = 4098
view let SO_SNDTIMEO: i32 = 4101 // 0x1005
view let SO_RCVTIMEO: i32 = 4102 // 0x1006
view let SO_ERROR: i32 = 4103
view let SO_TYPE: i32 = 4104
view let TCP_NODELAY: i32 = 1

// Win32 Non-Blocking Mode IOCTL Command
view let FIONBIO: i32 = -2147195266 // 0x8004667E: non-blocking I/O mode

// Error Values
view let INVALID_SOCKET: i64 = -1
view let SOCKET_ERROR: i32 = -1

// True when the backend uses the Win32 socket API (WSAStartup, closesocket,
// ioctlsocket). Read by the socket variants so the platform difference is
// stated once rather than re-derived from flag values.
view let NET_WIN32_API: bool = true

// IPv4 Internet socket address structure matching struct sockaddr_in (16 bytes).
view data SockAddrIn {
    family: i16
    port: u16
    addr: u32
    zero1: i32
    zero2: i32
}

// Low-level socket handle container.
view data Socket {
    fd: i64
    family: i32
    type_: i32
    is_closed: bool
    is_nonblocking: bool
}

// High-level network endpoint address (IP string and port).
view data SocketAddr {
    ip: string
    port: u16
    raw_ip: u32
}
