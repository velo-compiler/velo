// std.net.types (macOS / Darwin) — Core networking constants for macOS BSD sockets.
//
// Phase 70 / Task 70.3: Darwin socket constants differ from both Linux and Windows.
// In particular:
//   * AF_INET6 is 30 on Darwin (10 on Linux, 23 on Windows)
//   * SOL_SOCKET is 65535 (0xffff) on Darwin (1 on Linux, 65535 on Windows)
//   * SO_REUSEADDR is 4 on Darwin (2 on Linux, 4 on Windows)
//   * SO_BROADCAST is 32 on Darwin (6 on Linux, 32 on Windows)
//   * SO_KEEPALIVE is 8 on Darwin (9 on Linux, 8 on Windows)
//
// The resolver picks this file when the target is macos (Phase 70 /
// Task 70.1), so callers keep writing `use "types.vl"`.

// Address Families
view let AF_UNSPEC: i32 = 0
view let AF_INET: i32 = 2
view let AF_INET6: i32 = 30 // Darwin sys/socket.h

// Socket Types
view let SOCK_STREAM: i32 = 1
view let SOCK_DGRAM: i32 = 2
view let SOCK_RAW: i32 = 3

// Protocols
view let IPPROTO_IP: i32 = 0
view let IPPROTO_TCP: i32 = 6
view let IPPROTO_UDP: i32 = 17

// Socket Options Levels & Names (Darwin sys/socket.h)
view let SOL_SOCKET: i32 = 65535 // 0xffff on Darwin BSD sockets
view let SO_DEBUG: i32 = 1
view let SO_REUSEADDR: i32 = 4
view let SO_KEEPALIVE: i32 = 8
view let SO_DONTROUTE: i32 = 16
view let SO_BROADCAST: i32 = 32
view let SO_LINGER: i32 = 128
view let SO_OOBINLINE: i32 = 256
view let SO_SNDBUF: i32 = 4097
view let SO_RCVBUF: i32 = 4098
view let SO_SNDTIMEO: i32 = 4101
view let SO_RCVTIMEO: i32 = 4102
view let SO_ERROR: i32 = 4103
view let SO_TYPE: i32 = 4104
view let TCP_NODELAY: i32 = 1

// Non-blocking mode is set with fcntl(F_SETFL, O_NONBLOCK) on POSIX, not with
// an ioctl. The value is kept only so the constant exists for callers that
// reference it; the socket backend does not use it.
view let FIONBIO: i32 = -2147195266

// Error Values
view let INVALID_SOCKET: i64 = -1
view let SOCKET_ERROR: i32 = -1

// False: the backend uses BSD sockets with no WSAStartup/WSACleanup handshake
// and close() rather than closesocket().
view let NET_WIN32_API: bool = false

// IPv4 Internet socket address structure matching struct sockaddr_in (16 bytes).
view data SockAddrIn {
    family: i16
    port: u16
    addr: u32
    zero1: i32
    zero2: i32
}

// Low-level socket handle container.
view data Socket {
    fd: i64
    family: i32
    type_: i32
    is_closed: bool
    is_nonblocking: bool
}

// High-level network endpoint address (IP string and port).
view data SocketAddr {
    ip: string
    port: u16
    raw_ip: u32
}
