// std.net.types — Core networking constants, protocol identifiers, and socket structures.

// Address Families
let AF_UNSPEC: i32 = 0
let AF_INET: i32 = 2
let AF_INET6: i32 = 23 // Windows AF_INET6 is 23; Linux is 10

// Socket Types
let SOCK_STREAM: i32 = 1 // Sequenced, reliable, two-way connection-based byte streams (TCP)
let SOCK_DGRAM: i32 = 2  // Connectionless, unreliable datagrams of fixed maximum length (UDP)
let SOCK_RAW: i32 = 3

// Protocols
let IPPROTO_IP: i32 = 0
let IPPROTO_TCP: i32 = 6
let IPPROTO_UDP: i32 = 17

// Socket Options Levels & Names
let SOL_SOCKET: i32 = 65535 // 0xFFFF on Win32
let SO_DEBUG: i32 = 1
let SO_REUSEADDR: i32 = 4
let SO_KEEPALIVE: i32 = 8
let SO_DONTROUTE: i32 = 16
let SO_BROADCAST: i32 = 32
let SO_LINGER: i32 = 128
let SO_OOBINLINE: i32 = 256
let SO_SNDBUF: i32 = 4097
let SO_RCVBUF: i32 = 4098
let SO_SNDTIMEO: i32 = 4101 // 0x1005
let SO_RCVTIMEO: i32 = 4102 // 0x1006
let SO_ERROR: i32 = 4103
let SO_TYPE: i32 = 4104
let TCP_NODELAY: i32 = 1

// Win32 Non-Blocking Mode IOCTL Command
let FIONBIO: i32 = -2147195266 // 0x8004667E: non-blocking I/O mode

// Error Values
let INVALID_SOCKET: i64 = -1
let SOCKET_ERROR: i32 = -1

// IPv4 Internet socket address structure matching struct sockaddr_in (16 bytes).
data SockAddrIn {
    family: i16
    port: u16
    addr: u32
    zero1: i32
    zero2: i32
}

// Low-level socket handle container.
data Socket {
    fd: i64
    family: i32
    type_: i32
    is_closed: bool
    is_nonblocking: bool
}

// High-level network endpoint address (IP string and port).
data SocketAddr {
    ip: string
    port: u16
    raw_ip: u32
}
