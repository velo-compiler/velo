// std.net.socket — Low-level cross-platform socket lifecycle, options, and I/O primitives.
use "types.vl"
use "addr.vl"
use "../mem/heap.vl"

// Foreign C / Winsock bindings
extern act WSAStartup(wVersionRequired: u16, lpWSAData: @u8) -> i32
extern act WSACleanup() -> i32
extern act socket(af: i32, type_: i32, protocol: i32) -> i64
extern act bind(s: i64, name: @SockAddrIn, namelen: i32) -> i32
extern act listen(s: i64, backlog: i32) -> i32
extern act accept(s: i64, addr: @SockAddrIn, addrlen: @i32) -> i64
extern act recv(s: i64, buf: @u8, len: i32, flags: i32) -> i32
extern act send(s: i64, buf: @u8, len: i32, flags: i32) -> i32
extern act recvfrom(s: i64, buf: @u8, len: i32, flags: i32, from: @SockAddrIn, fromlen: @i32) -> i32
extern act sendto(s: i64, buf: @u8, len: i32, flags: i32, to: @SockAddrIn, tolen: i32) -> i32
extern act closesocket(s: i64) -> i32
extern act ioctlsocket(s: i64, cmd: i32, argp: @u32) -> i32
extern act setsockopt(s: i64, level: i32, optname: i32, optval: @i32, optlen: i32) -> i32
extern act connect(s: i64, name: @SockAddrIn, namelen: i32) -> i32

mut g_net_initialized: bool = false

// Automatically initializes the underlying network subsystem (WSAStartup on Windows).
act net_ensure_init() -> bool {
    if g_net_initialized { return true }
    let wsadata: @u8 = heap_alloc(512)
    let res = WSAStartup(0x0202 as u16, wsadata)
    heap_free(wsadata)
    if res == 0 {
        g_net_initialized = true
        return true
    }
    return false
}

// Shuts down the network subsystem.
act net_shutdown() {
    if g_net_initialized {
        WSACleanup()
        g_net_initialized = false
    }
}

// Creates an un-bound, unconnected socket descriptor.
act socket_create(family: i32, type_: i32, protocol: i32) -> Socket {
    net_ensure_init()
    let fd = socket(family, type_, protocol)
    if fd < 0 {
        return Socket {
            fd: INVALID_SOCKET,
            family: family,
            type_: type_,
            is_closed: true,
            is_nonblocking: false,
        }
    }
    return Socket {
        fd: fd,
        family: family,
        type_: type_,
        is_closed: false,
        is_nonblocking: false,
    }
}

// Checks if a socket descriptor is open and valid.
act socket_is_valid(s: @Socket) -> bool {
    return s != null and s.fd != INVALID_SOCKET and not s.is_closed
}

// Closes a socket and releases its system resources.
act socket_close(s: @Socket) -> bool {
    if s == null or s.is_closed or s.fd == INVALID_SOCKET {
        return false
    }
    let res = closesocket(s.fd)
    s.is_closed = true
    s.fd = INVALID_SOCKET
    return res == 0
}

// Configures non-blocking I/O mode on the socket.
act socket_set_nonblocking(s: @Socket, nonblocking: bool) -> bool {
    if not socket_is_valid(s) { return false }
    mut mode: u32 = 0
    if nonblocking { mode = 1 as u32 }
    let res = ioctlsocket(s.fd, FIONBIO, @mode)
    if res == 0 {
        s.is_nonblocking = nonblocking
        return true
    }
    return false
}

// Enables or disables local address reuse (SO_REUSEADDR).
act socket_set_reuse_addr(s: @Socket, reuse: bool) -> bool {
    if not socket_is_valid(s) { return false }
    mut val: i32 = 0
    if reuse { val = 1 }
    let res = setsockopt(s.fd, SOL_SOCKET, SO_REUSEADDR, @val, 4)
    return res == 0
}

// Sets the send and receive timeout on the socket in milliseconds.
act socket_set_timeout(s: @Socket, timeout_ms: u32) -> bool {
    if not socket_is_valid(s) { return false }
    mut ms: i32 = timeout_ms as i32
    let r1 = setsockopt(s.fd, SOL_SOCKET, SO_RCVTIMEO, @ms, 4)
    let r2 = setsockopt(s.fd, SOL_SOCKET, SO_SNDTIMEO, @ms, 4)
    return r1 == 0 and r2 == 0
}

// Binds a socket to a local IPv4 address and port.
act socket_bind(s: @Socket, ip: string, port: u16) -> bool {
    if not socket_is_valid(s) { return false }
    mut addr: SockAddrIn
    sockaddr_in_init(@addr, ip, port)
    let res = bind(s.fd, @addr, 16)
    return res == 0
}

// Puts a stream socket into listening mode for incoming connections.
act socket_listen(s: @Socket, backlog: i32) -> bool {
    if not socket_is_valid(s) { return false }
    mut bl = backlog
    if bl <= 0 { bl = 128 }
    let res = listen(s.fd, bl)
    return res == 0
}

// Connects a stream socket to a remote server.
act socket_connect(s: @Socket, ip: string, port: u16) -> bool {
    if not socket_is_valid(s) { return false }
    mut addr: SockAddrIn
    sockaddr_in_init(@addr, ip, port)
    let res = connect(s.fd, @addr, 16)
    return res == 0
}

// Accepts an incoming connection on a listening socket.
act socket_accept(s: @Socket, out_addr: @SocketAddr) -> Socket {
    if not socket_is_valid(s) {
        return Socket {
            fd: INVALID_SOCKET,
            family: s.family,
            type_: s.type_,
            is_closed: true,
            is_nonblocking: false,
        }
    }
    mut addr: SockAddrIn
    mut len: i32 = 16
    let client_fd = accept(s.fd, @addr, @len)
    if client_fd < 0 {
        return Socket {
            fd: INVALID_SOCKET,
            family: s.family,
            type_: s.type_,
            is_closed: true,
            is_nonblocking: false,
        }
    }
    if out_addr != null {
        out_addr.port = net_ntohs(addr.port)
        out_addr.raw_ip = addr.addr
        out_addr.ip = net_format_ipv4(addr.addr)
    }
    return Socket {
        fd: client_fd,
        family: s.family,
        type_: s.type_,
        is_closed: false,
        is_nonblocking: false,
    }
}

// Transmits bytes on a connected stream socket. Returns number of bytes sent or -1 on error.
act socket_send(s: @Socket, buf: @u8, len: usize) -> i32 {
    if not socket_is_valid(s) or buf == null { return -1 }
    return send(s.fd, buf, len as i32, 0)
}

// Receives bytes from a connected stream socket. Returns number of bytes read or -1 on error.
act socket_recv(s: @Socket, buf: @u8, max_len: usize) -> i32 {
    if not socket_is_valid(s) or buf == null { return -1 }
    return recv(s.fd, buf, max_len as i32, 0)
}

// Sends a datagram to a specific remote destination. Returns bytes sent or -1 on error.
act socket_send_to(s: @Socket, buf: @u8, len: usize, dest_ip: string, dest_port: u16) -> i32 {
    if not socket_is_valid(s) or buf == null { return -1 }
    mut addr: SockAddrIn
    sockaddr_in_init(@addr, dest_ip, dest_port)
    return sendto(s.fd, buf, len as i32, 0, @addr, 16)
}

// Receives a datagram and captures the remote sender address. Returns bytes read or -1 on error.
act socket_recv_from(s: @Socket, buf: @u8, max_len: usize, out_addr: @SocketAddr) -> i32 {
    if not socket_is_valid(s) or buf == null { return -1 }
    mut addr: SockAddrIn
    mut len: i32 = 16
    let bytes = recvfrom(s.fd, buf, max_len as i32, 0, @addr, @len)
    if bytes >= 0 and out_addr != null {
        out_addr.port = net_ntohs(addr.port)
        out_addr.raw_ip = addr.addr
        out_addr.ip = net_format_ipv4(addr.addr)
    }
    return bytes
}
