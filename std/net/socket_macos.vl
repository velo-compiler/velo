// std.net.socket (macOS / Darwin) — BSD socket lifecycle, options, and I/O.
//
// Phase 70 / Task 70.3: Darwin uses standard BSD sockets with no WSAStartup/WSACleanup,
// close() rather than closesocket(), and fcntl(F_SETFL, O_NONBLOCK).
//
// macOS differs from Linux in numeric values:
//   * O_NONBLOCK is 4 (0x0004) on Darwin (2048 on Linux)
//   * F_GETFL is 3, F_SETFL is 4
use "types.vl"
use "addr.vl"
use "../mem/heap.vl"

// Darwin fcntl constants
view let F_GETFL: i32 = 3
view let F_SETFL: i32 = 4
view let O_NONBLOCK: i32 = 4 // 0x0004 on Darwin

// Foreign BSD socket bindings
view extern act socket(af: i32, type_: i32, protocol: i32) -> i32
view extern act bind(s: i32, name: @SockAddrIn, namelen: u32) -> i32
view extern act listen(s: i32, backlog: i32) -> i32
view extern act accept(s: i32, addr: @SockAddrIn, addrlen: @u32) -> i32
view extern act recv(s: i32, buf: @u8, len: usize, flags: i32) -> isize
view extern act send(s: i32, buf: @u8, len: usize, flags: i32) -> isize
view extern act recvfrom(s: i32, buf: @u8, len: usize, flags: i32, from: @SockAddrIn, fromlen: @u32) -> isize
view extern act sendto(s: i32, buf: @u8, len: usize, flags: i32, to: @SockAddrIn, tolen: u32) -> isize
view extern act close(fd: i32) -> i32
view extern act fcntl(fd: i32, cmd: i32, arg: i32) -> i32
view extern act setsockopt(s: i32, level: i32, optname: i32, optval: @i32, optlen: u32) -> i32
view extern act connect(s: i32, name: @SockAddrIn, namelen: u32) -> i32

// POSIX/Darwin sockets need no process-wide initialisation.
view act net_ensure_init() -> bool {
    return true
}

// POSIX/Darwin sockets need no process-wide teardown.
view act net_shutdown() {
}

// Creates an un-bound, unconnected socket descriptor.
view act socket_create(family: i32, type_: i32, protocol: i32) -> Socket {
    net_ensure_init()
    let fd = socket(family, type_, protocol)
    if fd < 0 {
        return Socket {
            fd: INVALID_SOCKET,
            family: family,
            type_: type_,
            is_closed: true,
            is_nonblocking: false,
        }
    }
    return Socket {
        fd: fd as i64,
        family: family,
        type_: type_,
        is_closed: false,
        is_nonblocking: false,
    }
}

// Checks if a socket descriptor is open and valid.
view act socket_is_valid(s: @Socket) -> bool {
    return s != null and s.fd != INVALID_SOCKET and not s.is_closed
}

// Closes a socket and releases its system resources.
view act socket_close(s: @Socket) -> bool {
    if s == null or s.is_closed or s.fd == INVALID_SOCKET {
        return false
    }
    let res = close(s.fd as i32)
    s.is_closed = true
    s.fd = INVALID_SOCKET
    return res == 0
}

// Configures non-blocking I/O mode on the socket.
view act socket_set_nonblocking(s: @Socket, nonblocking: bool) -> bool {
    if not socket_is_valid(s) { return false }
    let flags = fcntl(s.fd as i32, F_GETFL, 0)
    if flags < 0 { return false }
    mut next = flags
    if nonblocking {
        next = flags | O_NONBLOCK
    } else {
        next = flags & ~O_NONBLOCK
    }
    if fcntl(s.fd as i32, F_SETFL, next) != 0 { return false }
    s.is_nonblocking = nonblocking
    return true
}

// Enables or disables local address reuse (SO_REUSEADDR).
view act socket_set_reuse_addr(s: @Socket, reuse: bool) -> bool {
    if not socket_is_valid(s) { return false }
    mut val: i32 = 0
    if reuse { val = 1 }
    let res = setsockopt(s.fd as i32, SOL_SOCKET, SO_REUSEADDR, @val, 4)
    return res == 0
}

// Sets the send and receive timeout on the socket in milliseconds.
view act socket_set_timeout(s: @Socket, timeout_ms: u32) -> bool {
    if not socket_is_valid(s) { return false }
    mut ms: i32 = timeout_ms as i32
    let r1 = setsockopt(s.fd as i32, SOL_SOCKET, SO_RCVTIMEO, @ms, 4)
    let r2 = setsockopt(s.fd as i32, SOL_SOCKET, SO_SNDTIMEO, @ms, 4)
    return r1 == 0 and r2 == 0
}

// Enables or disables datagram broadcast (SO_BROADCAST).
view act socket_set_broadcast(s: @Socket, enabled: bool) -> bool {
    if not socket_is_valid(s) { return false }
    mut val: i32 = 0
    if enabled { val = 1 }
    let res = setsockopt(s.fd as i32, SOL_SOCKET, SO_BROADCAST, @val, 4)
    return res == 0
}

// Binds a socket to a local IPv4 address and port.
view act socket_bind(s: @Socket, ip: string, port: u16) -> bool {
    if not socket_is_valid(s) { return false }
    mut addr: SockAddrIn
    sockaddr_in_init(@addr, ip, port)
    let res = bind(s.fd as i32, @addr, 16)
    return res == 0
}

// Puts a stream socket into listening mode for incoming connections.
view act socket_listen(s: @Socket, backlog: i32) -> bool {
    if not socket_is_valid(s) { return false }
    mut bl = backlog
    if bl <= 0 { bl = 128 }
    let res = listen(s.fd as i32, bl)
    return res == 0
}

// Connects a stream socket to a remote server.
view act socket_connect(s: @Socket, ip: string, port: u16) -> bool {
    if not socket_is_valid(s) { return false }
    mut addr: SockAddrIn
    sockaddr_in_init(@addr, ip, port)
    let res = connect(s.fd as i32, @addr, 16)
    return res == 0
}

// Accepts an incoming connection on a listening socket.
view act socket_accept(s: @Socket, out_addr: @SocketAddr) -> Socket {
    if not socket_is_valid(s) {
        return Socket {
            fd: INVALID_SOCKET,
            family: s.family,
            type_: s.type_,
            is_closed: true,
            is_nonblocking: false,
        }
    }
    mut addr: SockAddrIn
    mut len: u32 = 16
    let client_fd = accept(s.fd as i32, @addr, @len)
    if client_fd < 0 {
        return Socket {
            fd: INVALID_SOCKET,
            family: s.family,
            type_: s.type_,
            is_closed: true,
            is_nonblocking: false,
        }
    }
    if out_addr != null {
        out_addr.port = net_ntohs(addr.port)
        out_addr.raw_ip = addr.addr
        out_addr.ip = net_format_ipv4(addr.addr)
    }
    return Socket {
        fd: client_fd as i64,
        family: s.family,
        type_: s.type_,
        is_closed: false,
        is_nonblocking: false,
    }
}

// Transmits bytes on a connected stream socket. Returns number of bytes sent or -1 on error.
view act socket_send(s: @Socket, buf: @u8, len: usize) -> i32 {
    if not socket_is_valid(s) or buf == null { return -1 }
    return send(s.fd as i32, buf, len, 0) as i32
}

// Receives bytes from a connected stream socket. Returns number of bytes read or -1 on error.
view act socket_recv(s: @Socket, buf: @u8, max_len: usize) -> i32 {
    if not socket_is_valid(s) or buf == null { return -1 }
    return recv(s.fd as i32, buf, max_len, 0) as i32
}

// Sends a datagram to a specific remote destination. Returns bytes sent or -1 on error.
view act socket_send_to(s: @Socket, buf: @u8, len: usize, dest_ip: string, dest_port: u16) -> i32 {
    if not socket_is_valid(s) or buf == null { return -1 }
    mut addr: SockAddrIn
    sockaddr_in_init(@addr, dest_ip, dest_port)
    return sendto(s.fd as i32, buf, len, 0, @addr, 16) as i32
}

// Receives a datagram and captures the remote sender address. Returns bytes read or -1 on error.
view act socket_recv_from(s: @Socket, buf: @u8, max_len: usize, out_addr: @SocketAddr) -> i32 {
    if not socket_is_valid(s) or buf == null { return -1 }
    mut addr: SockAddrIn
    mut len: u32 = 16
    let bytes = recvfrom(s.fd as i32, buf, max_len, 0, @addr, @len) as i32
    if bytes >= 0 and out_addr != null {
        out_addr.port = net_ntohs(addr.port)
        out_addr.raw_ip = addr.addr
        out_addr.ip = net_format_ipv4(addr.addr)
    }
    return bytes
}
