// Pure Velo directory scanning and iterator engine (zero kernel32 dependencies).
// Scans directories and streams directory entries through the runtime header's
// portable listing helper.
//
// Phase 70 / Task 70.2: this file used to declare FindFirstFileA/FindNextFileA/
// FindClose and parse a raw WIN32_FIND_DATAA buffer at hardcoded offsets (name
// at byte 44, size at words 7/8). Because the file carries no platform suffix,
// no variant could displace those externs and `std.fs` could not be built off
// Windows.
//
// The DirIterator shape is deliberately unchanged: `src/tooling/formatter.vl`
// reads `.h_find` directly and compares it against DIR_INVALID_HANDLE, so
// changing the fields would have meant editing the compiler to enable the
// portability fix -- the tail wagging the dog. `h_find` keeps its meaning
// ("a stream is open") and `find_data` keeps its meaning ("the backing
// storage"), with the Win32 buffer replaced by the listing block.
use "../str/slice.vl"
use "../mem/ops.vl"
use "../mem/heap.vl"
use "../coll/shelf.vl"

// Sentinel for "no open directory stream". Kept numeric and unchanged so
// existing `iter.h_find == DIR_INVALID_HANDLE` comparisons keep compiling.
view let DIR_INVALID_HANDLE: usize = (0 - 1) as usize

// Foreign interface to the runtime header's portable directory helpers.
//
// Both take a flat i64 out-buffer rather than returning a struct: the emitted C
// defines Velo `data` types itself, so a struct shared with the header would be
// declared twice (verified with a probe before choosing this shape).
view extern act velo_fs_list_dir_into(path: string, out: @i64) -> void
view extern act velo_dir_listing_free(out: @i64) -> void
view extern act velo_fs_entry_info_into(path: string, out: @i64) -> bool

// Self-contained directory entry record
view data DirEntry {
    name: @u8,
    name_len: usize,
    is_dir: bool,
    is_file: bool,
    size: i64,
}

// Directory stream iterator
view data DirIterator {
    h_find: usize,
    find_data: @u8,
    has_current: bool,
    current: DirEntry,
    // Portable listing state: the 5-word buffer from velo_fs_list_dir_into,
    // held as a byte pointer so it can be freed with heap_free like every other
    // heap block, and reinterpreted as @i64 at each access.
    listing: @u8,
    index: usize,
    dir_path: string,
}

// Returns true if name is "." or ".."
view act dir_is_dot_or_dotdot(name: @u8) -> bool {
    if name == null { return false }
    if name[0] == 46 as u8 { // '.'
        if name[1] == 0 as u8 { return true } // "."
        if name[1] == 46 as u8 and name[2] == 0 as u8 { return true } // ".."
    }
    return false
}

// Joins a directory path and a bare entry name into a fresh heap string.
view act dir_join_entry(dir_path: string, name: @u8) -> string {
    let dlen = raw_str_len(dir_path as @u8)
    let nlen = raw_str_len(name)
    let buf = heap_alloc(dlen + nlen + 2)
    if buf == null { return null }
    copy(buf, dir_path as @u8, dlen)
    mut pos = dlen
    let last_c = buf[dlen - 1]
    if last_c != 47 as u8 and last_c != 92 as u8 {
        buf[pos] = 47 as u8
        pos += 1
    }
    copy(buf + pos, name, nlen)
    buf[pos + nlen] = 0 as u8
    return buf as string
}

// Fills out_entry for the listing entry at `iter.index`.
view act dir_fill_entry(iter: @DirIterator, out_entry: @DirEntry) -> bool {
    if iter == null or out_entry == null or iter.listing == null { return false }
    let listing = iter.listing as @i64
    let count = listing[2] as usize
    if iter.index >= count { return false }

    let offsets = listing[1] as @usize
    let block = listing[0] as @u8
    let name = block + offsets[iter.index]
    let nlen = raw_str_len(name)

    out_entry.name = name
    out_entry.name_len = nlen

    // Classification needs the full path, so the entry is resolved against the
    // directory the stream was opened for. A failure to stat leaves the entry
    // as "neither file nor directory", which is honest for a dangling link.
    let full = dir_join_entry(iter.dir_path, name)
    if full != null {
        let info_buf = heap_alloc(24)
        if info_buf != null {
            let info = info_buf as @i64
            if velo_fs_entry_info_into(full, info) {
                out_entry.is_dir = info[0] != 0
                out_entry.is_file = info[1] != 0
                out_entry.size = info[2]
            } else {
                out_entry.is_dir = false
                out_entry.is_file = false
                out_entry.size = 0
            }
            heap_free(info_buf)
        }
        heap_free_str(full)
    } else {
        out_entry.is_dir = false
        out_entry.is_file = false
        out_entry.size = 0
    }
    return true
}

// Returns an iterator in the closed/empty state.
view act dir_iterator_empty() -> DirIterator {
    return DirIterator {
        h_find: DIR_INVALID_HANDLE,
        find_data: null,
        has_current: false,
        current: DirEntry { name: null, name_len: 0, is_dir: false, is_file: false, size: 0 },
        listing: null,
        index: 0,
        dir_path: null,
    }
}

// Opens a directory stream for iteration. Automatically skips "." and "..".
view act fs_dir_open(path: string) -> DirIterator {
    if path == null {
        return dir_iterator_empty()
    }
    return fs_dir_open_slice(slice_from_str(path))
}

// Opens a directory stream from a StrSlice view.
view act fs_dir_open_slice(path: StrSlice) -> DirIterator {
    if slice_is_empty(path) {
        return dir_iterator_empty()
    }

    // The helper takes a NUL-terminated path; a slice is not one.
    let dir_cstr = heap_alloc(path.len + 1)
    if dir_cstr == null {
        return dir_iterator_empty()
    }
    copy(dir_cstr, path.ptr, path.len)
    dir_cstr[path.len] = 0 as u8

    let listing_buf = heap_alloc(40)
    if listing_buf == null {
        heap_free(dir_cstr)
        return dir_iterator_empty()
    }
    let listing = listing_buf as @i64
    velo_fs_list_dir_into(dir_cstr as string, listing)

    // [3] = opened. A missing or unreadable directory closes the stream.
    if listing[3] == 0 {
        heap_free(listing_buf)
        heap_free(dir_cstr)
        return dir_iterator_empty()
    }

    mut iter = DirIterator {
        h_find: 1 as usize,   // any value but DIR_INVALID_HANDLE means "open"
        find_data: listing[0] as @u8,
        has_current: false,
        current: DirEntry { name: null, name_len: 0, is_dir: false, is_file: false, size: 0 },
        listing: listing_buf,
        index: 0,
        dir_path: dir_cstr as string,
    }

    // The listing already excludes "." and "..", so the first entry (if any) is
    // the current one.
    if listing[2] > 0 {
        iter.has_current = dir_fill_entry(@iter, @iter.current)
    }
    return iter
}

// Advances the directory iterator to the next entry. Returns true if an entry is available.
view act fs_dir_next(iter: @DirIterator) -> bool {
    if iter == null or iter.h_find == DIR_INVALID_HANDLE or iter.listing == null {
        return false
    }
    iter.index += 1
    let count = (iter.listing as @i64)[2] as usize
    if iter.index >= count {
        iter.has_current = false
        return false
    }
    iter.has_current = dir_fill_entry(iter, @iter.current)
    return iter.has_current
}

// Returns a pointer to the current entry of the iterator.
view act fs_dir_entry(iter: @DirIterator) -> @DirEntry {
    if iter == null or !iter.has_current { return null }
    return @iter.current
}

// Closes a directory iterator and releases OS resources.
view act fs_dir_close(iter: @DirIterator) {
    if iter == null { return }
    if iter.listing != null {
        velo_dir_listing_free(iter.listing as @i64)
        heap_free(iter.listing)
        iter.listing = null
    }
    iter.h_find = DIR_INVALID_HANDLE
    iter.find_data = null
    iter.has_current = false
    iter.index = 0
    if iter.dir_path != null {
        heap_free_str(iter.dir_path)
        iter.dir_path = null
    }
}

// Returns a StrSlice view over the entry name.
view act entry_name(e: @DirEntry) -> StrSlice {
    if e == null or e.name == null { return StrSlice { ptr: null, len: 0 } }
    return slice_from_raw(e.name, e.name_len)
}

// Returns entry name as a null-terminated pointer.
view act entry_name_cstr(e: @DirEntry) -> @u8 {
    if e == null { return null }
    return e.name
}

// Returns true if the entry is a directory.
view act entry_is_dir(e: @DirEntry) -> bool {
    if e == null { return false }
    return e.is_dir
}

// Returns true if the entry is a regular file.
view act entry_is_file(e: @DirEntry) -> bool {
    if e == null { return false }
    return e.is_file
}

// Returns the file size of the entry in bytes.
view act entry_size(e: @DirEntry) -> i64 {
    if e == null { return 0 }
    return e.size
}

// High-level: Reads all entry names in a directory into a RawShelf of persistent StrSlice elements.
view act fs_read_dir_names(path: string, out_shelf: @RawShelf) -> bool {
    if path == null or out_shelf == null { return false }
    mut dir_it = fs_dir_open(path)
    if dir_it.h_find == DIR_INVALID_HANDLE { return false }

    if dir_it.has_current {
        let sl = entry_name(@dir_it.current)
        let copy_buf = heap_alloc(sl.len + 1)
        if copy_buf != null {
            copy(copy_buf, sl.ptr, sl.len)
            copy_buf[sl.len] = 0 as u8
            let saved_sl = slice_from_raw(copy_buf, sl.len)
            shelf_push_slice(out_shelf, saved_sl)
        }
        loop fs_dir_next(@dir_it) {
            let next_sl = entry_name(@dir_it.current)
            let next_buf = heap_alloc(next_sl.len + 1)
            if next_buf != null {
                copy(next_buf, next_sl.ptr, next_sl.len)
                next_buf[next_sl.len] = 0 as u8
                let next_saved = slice_from_raw(next_buf, next_sl.len)
                shelf_push_slice(out_shelf, next_saved)
            }
        }
    }

    fs_dir_close(@dir_it)
    return true
}

// Frees all persistent name slices stored in out_shelf by fs_read_dir_names, then frees the shelf.
view act fs_free_dir_names(shelf: @RawShelf) {
    if shelf == null { return }
    mut i: usize = 0
    loop i < shelf.len {
        let sl = shelf_get_slice(shelf, i)
        if sl.ptr != null {
            heap_free(sl.ptr)
        }
        i += 1
    }
    shelf_free(shelf)
}

// High-level: Counts the number of entries in a directory (excluding . and ..).
view act fs_count_dir(path: string) -> i64 {
    if path == null { return 0 - 1 }
    mut dir_it = fs_dir_open(path)
    if dir_it.h_find == DIR_INVALID_HANDLE { return 0 - 1 }

    mut count: i64 = 0
    if dir_it.has_current {
        count += 1
        loop fs_dir_next(@dir_it) {
            count += 1
        }
    }

    fs_dir_close(@dir_it)
    return count
}
