// Pure Velo filesystem metadata and query engine (zero kernel32 dependencies).
//
// Phase 70 / Task 70.2: this file used to declare two Win32 externs
// (GetFileAttributesExA / GetFileAttributesA) and parse a raw WIN32_FILE_
// ATTRIBUTE_DATA buffer, in a file whose name carries no platform suffix. That
// is why `std.fs` claimed portability while being unbuildable off Windows: the
// Win32 binding lived in the neutral file, so no variant could displace it.
//
// The queries now ride the runtime header's velo_fs_stat(), which is the one
// place allowed to hold a `#if defined(_WIN32)` branch. The FileStat shape is
// unchanged, so every caller and every test keeps working, and the offsets of
// the old WIN32_FIND_DATA/DATA buffers stop being load-bearing.
use "../mem/ops.vl"
use "../mem/heap.vl"
use "../str/slice.vl"

// Foreign interface to the runtime header's portable metadata helper.
//
// The helper fills a flat i64 buffer rather than returning a struct: the C type
// would otherwise have to be declared by both this file and the header, and the
// emitted C defines Velo `data` types itself, so two definitions of one name is
// a redefinition error (verified with a probe before choosing this shape).
//
// An `extern` declaration reuses the header's `static inline` definition --
// C99 6.2.2p4 keeps internal linkage for an extern that follows a visible
// static one, the mechanism Phase 70 / Task 70.1 established.
view extern act velo_fs_stat_into(path: string, out: @i64) -> bool

// OS File metadata descriptor
view data FileStat {
    size: i64,
    is_dir: bool,
    is_file: bool,
    is_readonly: bool,
    is_symlink: bool,
    exists: bool,
    modified_time_ms: i64,
    created_time_ms: i64,
}

// Returns an empty FileStat indicating a non-existent or inaccessible file.
view act fs_stat_not_found() -> FileStat {
    return FileStat {
        size: 0,
        is_dir: false,
        is_file: false,
        is_readonly: false,
        is_symlink: false,
        exists: false,
        modified_time_ms: 0,
        created_time_ms: 0,
    }
}

// Queries file metadata for a null-terminated path pointer.
view act fs_stat(path: @u8) -> FileStat {
    if path == null {
        return fs_stat_not_found()
    }

    // 9 i64 words = 72 bytes. heap_alloc yields @u8, so the block is taken as
    // bytes and reinterpreted; freeing it needs the original byte pointer.
    let bytes = heap_alloc(72)
    if bytes == null {
        return fs_stat_not_found()
    }
    let raw = bytes as @i64
    mut i: usize = 0
    loop i < 9 {
        raw[i] = 0
        i += 1
    }

    let found = velo_fs_stat_into(path as string, raw)
    if !found {
        heap_free(bytes)
        return fs_stat_not_found()
    }

    let st = FileStat {
        size: raw[0],
        is_dir: raw[1] != 0,
        is_file: raw[2] != 0,
        is_readonly: raw[3] != 0,
        is_symlink: raw[4] != 0,
        exists: raw[5] != 0,
        modified_time_ms: raw[6],
        created_time_ms: raw[7],
    }
    heap_free(bytes)
    return st
}

// Queries file metadata for a StrSlice view.
view act fs_stat_slice(path: StrSlice) -> FileStat {
    if slice_is_empty(path) {
        return fs_stat_not_found()
    }
    let cstr = heap_alloc(path.len + 1)
    if cstr == null {
        return fs_stat_not_found()
    }
    copy(cstr, path.ptr, path.len)
    cstr[path.len] = 0 as u8

    let st = fs_stat(cstr)
    heap_free(cstr)
    return st
}

// Queries file metadata for a Velo string.
view act fs_stat_str(path: string) -> FileStat {
    if path == null {
        return fs_stat_not_found()
    }
    return fs_stat(path as @u8)
}

// Returns true if the file or directory exists.
view act fs_exists(path: string) -> bool {
    let st = fs_stat_str(path)
    return st.exists
}

// Returns true if the slice path exists.
view act fs_exists_slice(path: StrSlice) -> bool {
    let st = fs_stat_slice(path)
    return st.exists
}

// Returns true if the path exists and is a regular file.
view act fs_is_file(path: string) -> bool {
    let st = fs_stat_str(path)
    return st.exists and st.is_file
}

// Returns true if the slice path exists and is a regular file.
view act fs_is_file_slice(path: StrSlice) -> bool {
    let st = fs_stat_slice(path)
    return st.exists and st.is_file
}

// Returns true if the path exists and is a directory.
view act fs_is_dir(path: string) -> bool {
    let st = fs_stat_str(path)
    return st.exists and st.is_dir
}

// Returns true if the slice path exists and is a directory.
view act fs_is_dir_slice(path: StrSlice) -> bool {
    let st = fs_stat_slice(path)
    return st.exists and st.is_dir
}

// Returns the file size in bytes, or -1 if the file does not exist.
view act fs_file_size(path: string) -> i64 {
    let st = fs_stat_str(path)
    if !st.exists {
        return 0 - 1
    }
    return st.size
}

// Returns the file size in bytes from a slice, or -1 if the file does not exist.
view act fs_file_size_slice(path: StrSlice) -> i64 {
    let st = fs_stat_slice(path)
    if !st.exists {
        return 0 - 1
    }
    return st.size
}

// Returns true if the file exists and is marked read-only.
view act fs_is_readonly(path: string) -> bool {
    let st = fs_stat_str(path)
    return st.exists and st.is_readonly
}

// Returns true if the slice path exists and is marked read-only.
view act fs_is_readonly_slice(path: StrSlice) -> bool {
    let st = fs_stat_slice(path)
    return st.exists and st.is_readonly
}
