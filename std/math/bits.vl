// std.math.bits — Pure Velo bit manipulation intrinsics and numerical utilities.
// Zero-dependency, portable, branch-free implementations for integer bitwise operations.

// Counts the number of set bits (1-bits, Hamming weight) in a 32-bit unsigned integer.
act popcount32(x: u32) -> u32 {
    mut v = x
    v = v - ((v >> (1 as u32)) & (0x55555555 as u32))
    v = (v & (0x33333333 as u32)) + ((v >> (2 as u32)) & (0x33333333 as u32))
    v = (v + (v >> (4 as u32))) & (0x0F0F0F0F as u32)
    let sum = (v * (0x01010101 as u32)) >> (24 as u32)
    return sum & (0x3F as u32)
}

// Counts the number of set bits (1-bits, Hamming weight) in a 64-bit unsigned integer.
act popcount64(x: u64) -> u32 {
    mut v = x
    v = v - ((v >> (1 as u64)) & (0x5555555555555555 as u64))
    v = (v & (0x3333333333333333 as u64)) + ((v >> (2 as u64)) & (0x3333333333333333 as u64))
    v = (v + (v >> (4 as u64))) & (0x0F0F0F0F0F0F0F0F as u64)
    let sum = (v * (0x0101010101010101 as u64)) >> (56 as u64)
    return (sum & (0x7F as u64)) as u32
}

// Counts the number of leading zero bits in a 32-bit unsigned integer.
// Returns 32 if x is zero.
act clz32(x: u32) -> u32 {
    if x == (0 as u32) { return 32 as u32 }
    mut v = x
    v = v | (v >> (1 as u32))
    v = v | (v >> (2 as u32))
    v = v | (v >> (4 as u32))
    v = v | (v >> (8 as u32))
    v = v | (v >> (16 as u32))
    return (32 as u32) - popcount32(v)
}

// Counts the number of leading zero bits in a 64-bit unsigned integer.
// Returns 64 if x is zero.
act clz64(x: u64) -> u32 {
    if x == (0 as u64) { return 64 as u32 }
    mut v = x
    v = v | (v >> (1 as u64))
    v = v | (v >> (2 as u64))
    v = v | (v >> (4 as u64))
    v = v | (v >> (8 as u64))
    v = v | (v >> (16 as u64))
    v = v | (v >> (32 as u64))
    return (64 as u32) - popcount64(v)
}

// Counts the number of trailing zero bits in a 32-bit unsigned integer.
// Returns 32 if x is zero.
act ctz32(x: u32) -> u32 {
    if x == (0 as u32) { return 32 as u32 }
    let lowest = x & (~x + (1 as u32))
    return popcount32(lowest - (1 as u32))
}

// Counts the number of trailing zero bits in a 64-bit unsigned integer.
// Returns 64 if x is zero.
act ctz64(x: u64) -> u32 {
    if x == (0 as u64) { return 64 as u32 }
    let lowest = x & (~x + (1 as u64))
    return popcount64(lowest - (1 as u64))
}

// Reverses the byte order of a 16-bit integer (endianness swap).
act bswap16(x: u16) -> u16 {
    let hi = (x >> (8 as u16)) & (0x00FF as u16)
    let lo = (x << (8 as u16)) & (0xFF00 as u16)
    return hi | lo
}

// Reverses the byte order of a 32-bit integer (endianness swap).
act bswap32(x: u32) -> u32 {
    let b0 = (x & (0x000000FF as u32)) << (24 as u32)
    let b1 = (x & (0x0000FF00 as u32)) << (8 as u32)
    let b2 = (x & (0x00FF0000 as u32)) >> (8 as u32)
    let b3 = (x & (0xFF000000 as u32)) >> (24 as u32)
    return b0 | b1 | b2 | b3
}

// Reverses the byte order of a 64-bit integer (endianness swap).
act bswap64(x: u64) -> u64 {
    let lo32 = bswap32(x as u32) as u64
    let hi32 = bswap32((x >> (32 as u64)) as u32) as u64
    return (lo32 << (32 as u64)) | hi32
}

// Rotates the bits of a 32-bit integer to the left by shift positions.
act rotl32(x: u32, shift: u32) -> u32 {
    let s = shift & (31 as u32)
    if s == (0 as u32) { return x }
    return (x << s) | (x >> ((32 as u32) - s))
}

// Rotates the bits of a 32-bit integer to the right by shift positions.
act rotr32(x: u32, shift: u32) -> u32 {
    let s = shift & (31 as u32)
    if s == (0 as u32) { return x }
    return (x >> s) | (x << ((32 as u32) - s))
}

// Rotates the bits of a 64-bit integer to the left by shift positions.
act rotl64(x: u64, shift: u32) -> u64 {
    let s = (shift & (63 as u32)) as u64
    if s == (0 as u64) { return x }
    return (x << s) | (x >> ((64 as u64) - s))
}

// Rotates the bits of a 64-bit integer to the right by shift positions.
act rotr64(x: u64, shift: u32) -> u64 {
    let s = (shift & (63 as u32)) as u64
    if s == (0 as u64) { return x }
    return (x >> s) | (x << ((64 as u64) - s))
}

// Returns true if x is a power of 2 (i.e. x == 2^k for k >= 0).
act is_pow2_u32(x: u32) -> bool {
    if x == (0 as u32) { return false }
    return (x & (x - (1 as u32))) == (0 as u32)
}

// Returns true if x is a power of 2 (i.e. x == 2^k for k >= 0).
act is_pow2_u64(x: u64) -> bool {
    if x == (0 as u64) { return false }
    return (x & (x - (1 as u64))) == (0 as u64)
}

// Returns the smallest power of 2 greater than or equal to x.
// Returns 1 if x <= 1. Returns 0 on overflow (> 0x80000000).
act next_pow2_u32(x: u32) -> u32 {
    if x <= (1 as u32) { return 1 as u32 }
    mut v = x - (1 as u32)
    v = v | (v >> (1 as u32))
    v = v | (v >> (2 as u32))
    v = v | (v >> (4 as u32))
    v = v | (v >> (8 as u32))
    v = v | (v >> (16 as u32))
    return v + (1 as u32)
}

// Returns the smallest power of 2 greater than or equal to x.
// Returns 1 if x <= 1. Returns 0 on overflow (> 0x8000000000000000).
act next_pow2_u64(x: u64) -> u64 {
    if x <= (1 as u64) { return 1 as u64 }
    mut v = x - (1 as u64)
    v = v | (v >> (1 as u64))
    v = v | (v >> (2 as u64))
    v = v | (v >> (4 as u64))
    v = v | (v >> (8 as u64))
    v = v | (v >> (16 as u64))
    v = v | (v >> (32 as u64))
    return v + (1 as u64)
}

// Aligns a 32-bit value down to the nearest multiple of align.
act align_down_u32(val: u32, align: u32) -> u32 {
    if align <= (1 as u32) { return val }
    if (align & (align - (1 as u32))) == (0 as u32) {
        let mask = align - (1 as u32)
        return val & (~mask)
    }
    return (val / align) * align
}

// Aligns a 32-bit value up to the nearest multiple of align.
act align_up_u32(val: u32, align: u32) -> u32 {
    if align <= (1 as u32) { return val }
    if (align & (align - (1 as u32))) == (0 as u32) {
        let mask = align - (1 as u32)
        return (val + mask) & (~mask)
    }
    let rem = val % align
    if rem == (0 as u32) { return val }
    return val + (align - rem)
}

// Aligns a 64-bit value down to the nearest multiple of align.
act align_down_u64(val: u64, align: u64) -> u64 {
    if align <= (1 as u64) { return val }
    if (align & (align - (1 as u64))) == (0 as u64) {
        let mask = align - (1 as u64)
        return val & (~mask)
    }
    return (val / align) * align
}

// Aligns a 64-bit value up to the nearest multiple of align.
act align_up_u64(val: u64, align: u64) -> u64 {
    if align <= (1 as u64) { return val }
    if (align & (align - (1 as u64))) == (0 as u64) {
        let mask = align - (1 as u64)
        return (val + mask) & (~mask)
    }
    let rem = val % align
    if rem == (0 as u64) { return val }
    return val + (align - rem)
}

// Reverses the 32 bits of x in bitwise mirror order.
act reverse_bits32(x: u32) -> u32 {
    mut v = x
    v = ((v >> (1 as u32)) & (0x55555555 as u32)) | ((v & (0x55555555 as u32)) << (1 as u32))
    v = ((v >> (2 as u32)) & (0x33333333 as u32)) | ((v & (0x33333333 as u32)) << (2 as u32))
    v = ((v >> (4 as u32)) & (0x0F0F0F0F as u32)) | ((v & (0x0F0F0F0F as u32)) << (4 as u32))
    v = ((v >> (8 as u32)) & (0x00FF00FF as u32)) | ((v & (0x00FF00FF as u32)) << (8 as u32))
    return (v >> (16 as u32)) | (v << (16 as u32))
}

// Reverses the 64 bits of x in bitwise mirror order.
act reverse_bits64(x: u64) -> u64 {
    let lo = reverse_bits32(x as u32) as u64
    let hi = reverse_bits32((x >> (32 as u64)) as u32) as u64
    return (lo << (32 as u64)) | hi
}

// Tests if the bit at the given 0-based index is set (1).
act bit_get_u32(x: u32, bit: u32) -> bool {
    if bit >= (32 as u32) { return false }
    return ((x >> bit) & (1 as u32)) != (0 as u32)
}

// Sets the bit at the given 0-based index to 1.
act bit_set_u32(x: u32, bit: u32) -> u32 {
    if bit >= (32 as u32) { return x }
    return x | ((1 as u32) << bit)
}

// Clears the bit at the given 0-based index to 0.
act bit_clear_u32(x: u32, bit: u32) -> u32 {
    if bit >= (32 as u32) { return x }
    return x & (~((1 as u32) << bit))
}

// Toggles the bit at the given 0-based index.
act bit_toggle_u32(x: u32, bit: u32) -> u32 {
    if bit >= (32 as u32) { return x }
    return x ^ ((1 as u32) << bit)
}

// Tests if the bit at the given 0-based index is set (1).
act bit_get_u64(x: u64, bit: u32) -> bool {
    if bit >= (64 as u32) { return false }
    let b = bit as u64
    return ((x >> b) & (1 as u64)) != (0 as u64)
}

// Sets the bit at the given 0-based index to 1.
act bit_set_u64(x: u64, bit: u32) -> u64 {
    if bit >= (64 as u32) { return x }
    let b = bit as u64
    return x | ((1 as u64) << b)
}

// Clears the bit at the given 0-based index to 0.
act bit_clear_u64(x: u64, bit: u32) -> u64 {
    if bit >= (64 as u32) { return x }
    let b = bit as u64
    return x & (~((1 as u64) << b))
}

// Toggles the bit at the given 0-based index.
act bit_toggle_u64(x: u64, bit: u32) -> u64 {
    if bit >= (64 as u32) { return x }
    let b = bit as u64
    return x ^ ((1 as u64) << b)
}

