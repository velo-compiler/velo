// std.math.checked — Pure Velo checked and overflowing arithmetic operations.
// Predictable overflow detection, clamp-on-overflow support, and division safety.

// --- 32-bit Signed Checked Arithmetic ---

// Computes a + b. Writes wrapped sum to out_val if not null.
// Returns true if no overflow occurred, false if overflow/underflow occurred.
act checked_add_i32(a: i32, b: i32, out_val: @i32) -> bool {
    let res = a + b
    if out_val != null { out_val[0] = res }
    let max_val: i32 = 2147483647 as i32
    let min_val: i32 = (-2147483647 as i32) - (1 as i32)
    if b > (0 as i32) and a > max_val - b { return false }
    if b < (0 as i32) and a < min_val - b { return false }
    return true
}

// Computes a - b. Writes wrapped difference to out_val if not null.
// Returns true if no overflow occurred, false if overflow/underflow occurred.
act checked_sub_i32(a: i32, b: i32, out_val: @i32) -> bool {
    let res = a - b
    if out_val != null { out_val[0] = res }
    let max_val: i32 = 2147483647 as i32
    let min_val: i32 = (-2147483647 as i32) - (1 as i32)
    if b < (0 as i32) and a > max_val + b { return false }
    if b > (0 as i32) and a < min_val + b { return false }
    return true
}

// Computes a * b. Writes wrapped product to out_val if not null.
// Returns true if no overflow occurred, false if overflow/underflow occurred.
act checked_mul_i32(a: i32, b: i32, out_val: @i32) -> bool {
    let res = a * b
    if out_val != null { out_val[0] = res }
    let prod = (a as i64) * (b as i64)
    let max_val: i64 = 2147483647 as i64
    let min_val: i64 = (-2147483647 as i64) - (1 as i64)
    if prod > max_val or prod < min_val { return false }
    return true
}

// Computes a / b without undefined behaviour.
// Returns false on division by zero or when INT32_MIN / -1 overflows.
act checked_div_i32(a: i32, b: i32, out_val: @i32) -> bool {
    let min_val: i32 = (-2147483647 as i32) - (1 as i32)
    if b == (0 as i32) or (a == min_val and b == (-1 as i32)) { return false }
    if out_val != null { out_val[0] = a / b }
    return true
}

// Computes a % b without undefined behaviour.
// Returns false on division by zero or when INT32_MIN % -1 overflows.
act checked_rem_i32(a: i32, b: i32, out_val: @i32) -> bool {
    let min_val: i32 = (-2147483647 as i32) - (1 as i32)
    if b == (0 as i32) or (a == min_val and b == (-1 as i32)) { return false }
    if out_val != null { out_val[0] = a % b }
    return true
}

// --- 64-bit Signed Checked Arithmetic ---

// Computes a + b. Writes wrapped sum to out_val if not null.
// Returns true if no overflow occurred, false if overflow/underflow occurred.
act checked_add_i64(a: i64, b: i64, out_val: @i64) -> bool {
    let res = a + b
    if out_val != null { out_val[0] = res }
    let max_val: i64 = 9223372036854775807 as i64
    let min_val: i64 = (-9223372036854775807 as i64) - (1 as i64)
    if b > (0 as i64) and a > max_val - b { return false }
    if b < (0 as i64) and a < min_val - b { return false }
    return true
}

// Computes a - b. Writes wrapped difference to out_val if not null.
// Returns true if no overflow occurred, false if overflow/underflow occurred.
act checked_sub_i64(a: i64, b: i64, out_val: @i64) -> bool {
    let res = a - b
    if out_val != null { out_val[0] = res }
    let max_val: i64 = 9223372036854775807 as i64
    let min_val: i64 = (-9223372036854775807 as i64) - (1 as i64)
    if b < (0 as i64) and a > max_val + b { return false }
    if b > (0 as i64) and a < min_val + b { return false }
    return true
}

// Computes a * b. Writes wrapped product to out_val if not null.
// Returns true if no overflow occurred, false if overflow/underflow occurred.
act checked_mul_i64(a: i64, b: i64, out_val: @i64) -> bool {
    let res = a * b
    if out_val != null { out_val[0] = res }
    if a == (0 as i64) or b == (0 as i64) { return true }
    if a == (1 as i64) or b == (1 as i64) { return true }
    let max_val: i64 = 9223372036854775807 as i64
    let min_val: i64 = (-9223372036854775807 as i64) - (1 as i64)
    if a == (-1 as i64) {
        if b == min_val { return false }
        return true
    }
    if b == (-1 as i64) {
        if a == min_val { return false }
        return true
    }
    if a == min_val or b == min_val { return false }
    if a > (0 as i64) and b > (0 as i64) {
        if a > max_val / b { return false }
    } else if a > (0 as i64) and b < (0 as i64) {
        if b < min_val / a { return false }
    } else if a < (0 as i64) and b > (0 as i64) {
        if a < min_val / b { return false }
    } else {
        if (-a) > max_val / (-b) { return false }
    }
    return true
}

// Computes a / b without undefined behaviour.
// Returns false on division by zero or when INT64_MIN / -1 overflows.
act checked_div_i64(a: i64, b: i64, out_val: @i64) -> bool {
    let min_val: i64 = (-9223372036854775807 as i64) - (1 as i64)
    if b == (0 as i64) or (a == min_val and b == (-1 as i64)) { return false }
    if out_val != null { out_val[0] = a / b }
    return true
}

// Computes a % b without undefined behaviour.
// Returns false on division by zero or when INT64_MIN % -1 overflows.
act checked_rem_i64(a: i64, b: i64, out_val: @i64) -> bool {
    let min_val: i64 = (-9223372036854775807 as i64) - (1 as i64)
    if b == (0 as i64) or (a == min_val and b == (-1 as i64)) { return false }
    if out_val != null { out_val[0] = a % b }
    return true
}

// --- Unsigned Checked Arithmetic ---

// Computes a + b. Returns true if no overflow occurred.
act checked_add_u32(a: u32, b: u32, out_val: @u32) -> bool {
    let res = a + b
    if out_val != null { out_val[0] = res }
    return res >= a
}

// Computes a - b. Returns true if no underflow occurred.
act checked_sub_u32(a: u32, b: u32, out_val: @u32) -> bool {
    let res = a - b
    if out_val != null { out_val[0] = res }
    return a >= b
}

// Computes a * b. Returns true if no overflow occurred.
act checked_mul_u32(a: u32, b: u32, out_val: @u32) -> bool {
    let res = a * b
    if out_val != null { out_val[0] = res }
    let prod = (a as u64) * (b as u64)
    return prod <= (0xFFFFFFFF as u64)
}

// Computes a + b. Returns true if no overflow occurred.
act checked_add_u64(a: u64, b: u64, out_val: @u64) -> bool {
    let res = a + b
    if out_val != null { out_val[0] = res }
    return res >= a
}

// Computes a - b. Returns true if no underflow occurred.
act checked_sub_u64(a: u64, b: u64, out_val: @u64) -> bool {
    let res = a - b
    if out_val != null { out_val[0] = res }
    return a >= b
}

// Computes a * b. Returns true if no overflow occurred.
act checked_mul_u64(a: u64, b: u64, out_val: @u64) -> bool {
    let res = a * b
    if out_val != null { out_val[0] = res }
    if a == (0 as u64) or b == (0 as u64) { return true }
    let max_u64: u64 = 0xFFFFFFFFFFFFFFFF as u64
    return a <= max_u64 / b
}
