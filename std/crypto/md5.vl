// std.crypto.md5 — RFC 1321 compliant MD5 cryptographic checksum algorithm.
//
// WARNING: MD5 is cryptographically broken and vulnerable to collision attacks.
// It is deprecated and provided strictly for legacy interoperability and checksums.
// To use MD5, import via `use std.crypto.legacy`. Do not use for security-sensitive purposes.
use "../mem/heap.vl"
use "hex.vl"

// MD5 streaming state context.
view data Md5State {
    a: u32
    b: u32
    c: u32
    d: u32
    buf: @u8
    buf_len: usize
    total_bytes: u64
}

view act md5_rotl32(x: u32, n: u32) -> u32 {
    return (x << n) | (x >> ((32 as u32) - n))
}

view act md5_f(x: u32, y: u32, z: u32) -> u32 {
    return (x & y) | ((~x) & z)
}

view act md5_g(x: u32, y: u32, z: u32) -> u32 {
    return (x & z) | (y & (~z))
}

view act md5_h(x: u32, y: u32, z: u32) -> u32 {
    return x ^ y ^ z
}

view act md5_i(x: u32, y: u32, z: u32) -> u32 {
    return y ^ (x | (~z))
}

mut g_md5_t: @u32 = null

view act md5_ensure_t() {
    if g_md5_t != null { return }
    g_md5_t = heap_alloc(64 * 4) as @u32
    g_md5_t[0] = 0xd76aa478 as u32; g_md5_t[1] = 0xe8c7b756 as u32; g_md5_t[2] = 0x242070db as u32; g_md5_t[3] = 0xc1bdceee as u32
    g_md5_t[4] = 0xf57c0faf as u32; g_md5_t[5] = 0x4787c62a as u32; g_md5_t[6] = 0xa8304613 as u32; g_md5_t[7] = 0xfd469501 as u32
    g_md5_t[8] = 0x698098d8 as u32; g_md5_t[9] = 0x8b44f7af as u32; g_md5_t[10] = 0xffff5bb1 as u32; g_md5_t[11] = 0x895cd7be as u32
    g_md5_t[12] = 0x6b901122 as u32; g_md5_t[13] = 0xfd987193 as u32; g_md5_t[14] = 0xa679438e as u32; g_md5_t[15] = 0x49b40821 as u32
    g_md5_t[16] = 0xf61e2562 as u32; g_md5_t[17] = 0xc040b340 as u32; g_md5_t[18] = 0x265e5a51 as u32; g_md5_t[19] = 0xe9b6c7aa as u32
    g_md5_t[20] = 0xd62f105d as u32; g_md5_t[21] = 0x02441453 as u32; g_md5_t[22] = 0xd8a1e681 as u32; g_md5_t[23] = 0xe7d3fbc8 as u32
    g_md5_t[24] = 0x21e1cde6 as u32; g_md5_t[25] = 0xc33707d6 as u32; g_md5_t[26] = 0xf4d50d87 as u32; g_md5_t[27] = 0x455a14ed as u32
    g_md5_t[28] = 0xa9e3e905 as u32; g_md5_t[29] = 0xfcefa3f8 as u32; g_md5_t[30] = 0x676f02d9 as u32; g_md5_t[31] = 0x8d2a4c8a as u32
    g_md5_t[32] = 0xfffa3942 as u32; g_md5_t[33] = 0x8771f681 as u32; g_md5_t[34] = 0x6d9d6122 as u32; g_md5_t[35] = 0xfde5380c as u32
    g_md5_t[36] = 0xa4beea44 as u32; g_md5_t[37] = 0x4bdecfa9 as u32; g_md5_t[38] = 0xf6bb4b60 as u32; g_md5_t[39] = 0xbebfbc70 as u32
    g_md5_t[40] = 0x289b7ec6 as u32; g_md5_t[41] = 0xeaa127fa as u32; g_md5_t[42] = 0xd4ef3085 as u32; g_md5_t[43] = 0x04881d05 as u32
    g_md5_t[44] = 0xd9d4d039 as u32; g_md5_t[45] = 0xe6db99e5 as u32; g_md5_t[46] = 0x1fa27cf8 as u32; g_md5_t[47] = 0xc4ac5665 as u32
    g_md5_t[48] = 0xf4292244 as u32; g_md5_t[49] = 0x432aff97 as u32; g_md5_t[50] = 0xab9423a7 as u32; g_md5_t[51] = 0xfc93a039 as u32
    g_md5_t[52] = 0x655b59c3 as u32; g_md5_t[53] = 0x8f0ccc92 as u32; g_md5_t[54] = 0xffeff47d as u32; g_md5_t[55] = 0x85845dd1 as u32
    g_md5_t[56] = 0x6fa87e4f as u32; g_md5_t[57] = 0xfe2ce6e0 as u32; g_md5_t[58] = 0xa3014314 as u32; g_md5_t[59] = 0x4e0811a1 as u32
    g_md5_t[60] = 0xf7537e82 as u32; g_md5_t[61] = 0xbd3af235 as u32; g_md5_t[62] = 0x2ad7d2bb as u32; g_md5_t[63] = 0xeb86d391 as u32
}

view act md5_step(f_val: u32, a_in: u32, b_in: u32, x_k: u32, s_shift: u32, t_i: u32) -> u32 {
    let sum = a_in + f_val + x_k + t_i
    return b_in + md5_rotl32(sum, s_shift)
}

// Transforms a single 64-byte block for MD5.
view act md5_transform(s: @Md5State, block: @u8) {
    md5_ensure_t()
    mut x: @u32 = heap_alloc(16 * 4) as @u32

    mut j: usize = 0
    loop j < 16 {
        let b0 = block[j * 4] as u32
        let b1 = block[j * 4 + 1] as u32
        let b2 = block[j * 4 + 2] as u32
        let b3 = block[j * 4 + 3] as u32
        x[j] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
        j += 1
    }

    mut a = s.a; mut b = s.b; mut c = s.c; mut d = s.d

    // Round 1
    a = md5_step(md5_f(b, c, d), a, b, x[0], 7 as u32, g_md5_t[0])
    d = md5_step(md5_f(a, b, c), d, a, x[1], 12 as u32, g_md5_t[1])
    c = md5_step(md5_f(d, a, b), c, d, x[2], 17 as u32, g_md5_t[2])
    b = md5_step(md5_f(c, d, a), b, c, x[3], 22 as u32, g_md5_t[3])
    a = md5_step(md5_f(b, c, d), a, b, x[4], 7 as u32, g_md5_t[4])
    d = md5_step(md5_f(a, b, c), d, a, x[5], 12 as u32, g_md5_t[5])
    c = md5_step(md5_f(d, a, b), c, d, x[6], 17 as u32, g_md5_t[6])
    b = md5_step(md5_f(c, d, a), b, c, x[7], 22 as u32, g_md5_t[7])
    a = md5_step(md5_f(b, c, d), a, b, x[8], 7 as u32, g_md5_t[8])
    d = md5_step(md5_f(a, b, c), d, a, x[9], 12 as u32, g_md5_t[9])
    c = md5_step(md5_f(d, a, b), c, d, x[10], 17 as u32, g_md5_t[10])
    b = md5_step(md5_f(c, d, a), b, c, x[11], 22 as u32, g_md5_t[11])
    a = md5_step(md5_f(b, c, d), a, b, x[12], 7 as u32, g_md5_t[12])
    d = md5_step(md5_f(a, b, c), d, a, x[13], 12 as u32, g_md5_t[13])
    c = md5_step(md5_f(d, a, b), c, d, x[14], 17 as u32, g_md5_t[14])
    b = md5_step(md5_f(c, d, a), b, c, x[15], 22 as u32, g_md5_t[15])

    // Round 2
    a = md5_step(md5_g(b, c, d), a, b, x[1], 5 as u32, g_md5_t[16])
    d = md5_step(md5_g(a, b, c), d, a, x[6], 9 as u32, g_md5_t[17])
    c = md5_step(md5_g(d, a, b), c, d, x[11], 14 as u32, g_md5_t[18])
    b = md5_step(md5_g(c, d, a), b, c, x[0], 20 as u32, g_md5_t[19])
    a = md5_step(md5_g(b, c, d), a, b, x[5], 5 as u32, g_md5_t[20])
    d = md5_step(md5_g(a, b, c), d, a, x[10], 9 as u32, g_md5_t[21])
    c = md5_step(md5_g(d, a, b), c, d, x[15], 14 as u32, g_md5_t[22])
    b = md5_step(md5_g(c, d, a), b, c, x[4], 20 as u32, g_md5_t[23])
    a = md5_step(md5_g(b, c, d), a, b, x[9], 5 as u32, g_md5_t[24])
    d = md5_step(md5_g(a, b, c), d, a, x[14], 9 as u32, g_md5_t[25])
    c = md5_step(md5_g(d, a, b), c, d, x[3], 14 as u32, g_md5_t[26])
    b = md5_step(md5_g(c, d, a), b, c, x[8], 20 as u32, g_md5_t[27])
    a = md5_step(md5_g(b, c, d), a, b, x[13], 5 as u32, g_md5_t[28])
    d = md5_step(md5_g(a, b, c), d, a, x[2], 9 as u32, g_md5_t[29])
    c = md5_step(md5_g(d, a, b), c, d, x[7], 14 as u32, g_md5_t[30])
    b = md5_step(md5_g(c, d, a), b, c, x[12], 20 as u32, g_md5_t[31])

    // Round 3
    a = md5_step(md5_h(b, c, d), a, b, x[5], 4 as u32, g_md5_t[32])
    d = md5_step(md5_h(a, b, c), d, a, x[8], 11 as u32, g_md5_t[33])
    c = md5_step(md5_h(d, a, b), c, d, x[11], 16 as u32, g_md5_t[34])
    b = md5_step(md5_h(c, d, a), b, c, x[14], 23 as u32, g_md5_t[35])
    a = md5_step(md5_h(b, c, d), a, b, x[1], 4 as u32, g_md5_t[36])
    d = md5_step(md5_h(a, b, c), d, a, x[4], 11 as u32, g_md5_t[37])
    c = md5_step(md5_h(d, a, b), c, d, x[7], 16 as u32, g_md5_t[38])
    b = md5_step(md5_h(c, d, a), b, c, x[10], 23 as u32, g_md5_t[39])
    a = md5_step(md5_h(b, c, d), a, b, x[13], 4 as u32, g_md5_t[40])
    d = md5_step(md5_h(a, b, c), d, a, x[0], 11 as u32, g_md5_t[41])
    c = md5_step(md5_h(d, a, b), c, d, x[3], 16 as u32, g_md5_t[42])
    b = md5_step(md5_h(c, d, a), b, c, x[6], 23 as u32, g_md5_t[43])
    a = md5_step(md5_h(b, c, d), a, b, x[9], 4 as u32, g_md5_t[44])
    d = md5_step(md5_h(a, b, c), d, a, x[12], 11 as u32, g_md5_t[45])
    c = md5_step(md5_h(d, a, b), c, d, x[15], 16 as u32, g_md5_t[46])
    b = md5_step(md5_h(c, d, a), b, c, x[2], 23 as u32, g_md5_t[47])

    // Round 4
    a = md5_step(md5_i(b, c, d), a, b, x[0], 6 as u32, g_md5_t[48])
    d = md5_step(md5_i(a, b, c), d, a, x[7], 10 as u32, g_md5_t[49])
    c = md5_step(md5_i(d, a, b), c, d, x[14], 15 as u32, g_md5_t[50])
    b = md5_step(md5_i(c, d, a), b, c, x[5], 21 as u32, g_md5_t[51])
    a = md5_step(md5_i(b, c, d), a, b, x[12], 6 as u32, g_md5_t[52])
    d = md5_step(md5_i(a, b, c), d, a, x[3], 10 as u32, g_md5_t[53])
    c = md5_step(md5_i(d, a, b), c, d, x[10], 15 as u32, g_md5_t[54])
    b = md5_step(md5_i(c, d, a), b, c, x[1], 21 as u32, g_md5_t[55])
    a = md5_step(md5_i(b, c, d), a, b, x[8], 6 as u32, g_md5_t[56])
    d = md5_step(md5_i(a, b, c), d, a, x[15], 10 as u32, g_md5_t[57])
    c = md5_step(md5_i(d, a, b), c, d, x[6], 15 as u32, g_md5_t[58])
    b = md5_step(md5_i(c, d, a), b, c, x[13], 21 as u32, g_md5_t[59])
    a = md5_step(md5_i(b, c, d), a, b, x[4], 6 as u32, g_md5_t[60])
    d = md5_step(md5_i(a, b, c), d, a, x[11], 10 as u32, g_md5_t[61])
    c = md5_step(md5_i(d, a, b), c, d, x[2], 15 as u32, g_md5_t[62])
    b = md5_step(md5_i(c, d, a), b, c, x[9], 21 as u32, g_md5_t[63])

    s.a = s.a + a; s.b = s.b + b; s.c = s.c + c; s.d = s.d + d

    heap_free(x as @u8)
}

// Initializes an MD5 context with RFC 1321 initial state constants.
view act md5_init(s: @Md5State) {
    if s == null { return }
    s.a = 0x67452301 as u32
    s.b = 0xefcdab89 as u32
    s.c = 0x98badcfe as u32
    s.d = 0x10325476 as u32
    if s.buf == null {
        s.buf = heap_alloc(64)
    }
    s.buf_len = 0
    s.total_bytes = 0 as u64
}

// Feeds binary data into the MD5 context.
view act md5_update(s: @Md5State, data: @u8, len: usize) {
    if s == null or data == null or len == 0 { return }
    s.total_bytes = s.total_bytes + (len as u64)

    mut i: usize = 0
    loop i < len {
        s.buf[s.buf_len] = data[i]
        s.buf_len += 1
        if s.buf_len == 64 {
            md5_transform(s, s.buf)
            s.buf_len = 0
        }
        i += 1
    }
}

// Feeds string characters into the MD5 context.
view act md5_update_str(s: @Md5State, text: string) {
    if s == null or text == null { return }
    let len = str.len(text)
    if len == 0 { return }
    md5_update(s, text as @u8, len)
}

// Finalizes the MD5 hash and writes 16 raw bytes into out_digest.
view act md5_final(s: @Md5State, out_digest: @u8) {
    if s == null or out_digest == null { return }

    // 1. Append 0x80 bit
    s.buf[s.buf_len] = 0x80 as u8
    s.buf_len += 1

    // 2. Pad with zeroes
    if s.buf_len > 56 {
        loop s.buf_len < 64 {
            s.buf[s.buf_len] = 0 as u8
            s.buf_len += 1
        }
        md5_transform(s, s.buf)
        s.buf_len = 0
    }

    loop s.buf_len < 56 {
        s.buf[s.buf_len] = 0 as u8
        s.buf_len += 1
    }

    // 3. Append 64-bit length in bits (little-endian)
    let total_bits = s.total_bytes * (8 as u64)
    s.buf[56] = (total_bits & (0xFF as u64)) as u8
    s.buf[57] = ((total_bits >> 8) & (0xFF as u64)) as u8
    s.buf[58] = ((total_bits >> 16) & (0xFF as u64)) as u8
    s.buf[59] = ((total_bits >> 24) & (0xFF as u64)) as u8
    s.buf[60] = ((total_bits >> 32) & (0xFF as u64)) as u8
    s.buf[61] = ((total_bits >> 40) & (0xFF as u64)) as u8
    s.buf[62] = ((total_bits >> 48) & (0xFF as u64)) as u8
    s.buf[63] = ((total_bits >> 56) & (0xFF as u64)) as u8

    md5_transform(s, s.buf)

    // 4. Output little-endian 16-byte digest
    mut p: usize = 0
    loop p < 4 {
        mut word: u32 = 0
        if p == 0 { word = s.a }
        else if p == 1 { word = s.b }
        else if p == 2 { word = s.c }
        else { word = s.d }

        out_digest[p * 4] = (word & (0xFF as u32)) as u8
        out_digest[p * 4 + 1] = ((word >> 8) & (0xFF as u32)) as u8
        out_digest[p * 4 + 2] = ((word >> 16) & (0xFF as u32)) as u8
        out_digest[p * 4 + 3] = ((word >> 24) & (0xFF as u32)) as u8
        p += 1
    }

    if s.buf != null {
        heap_free(s.buf)
        s.buf = null
    }
}

// Computes 16 raw bytes of MD5 for a byte buffer.
view act md5_bytes(data: @u8, len: usize, out_digest: @u8) {
    mut s: Md5State
    s.buf = null
    md5_init(@s)
    md5_update(@s, data, len)
    md5_final(@s, out_digest)
}

// Finalizes the MD5 context and returns a 32-character lowercase hexadecimal string.
view act md5_final_hex(s: @Md5State) -> string {
    mut digest: @u8 = heap_alloc(16)
    md5_final(s, digest)
    let hex_res = bytes_to_hex(digest, 16)
    heap_free(digest)
    return hex_res
}

// Computes a 32-character lowercase hex string MD5 checksum.
view act md5_hash(data: @u8, len: usize) -> string {
    mut digest: @u8 = heap_alloc(16)
    md5_bytes(data, len, digest)
    let hex_res = bytes_to_hex(digest, 16)
    heap_free(digest)
    return hex_res
}

// Computes a 32-character lowercase hex string MD5 checksum of a string.
view act md5_hash_str(text: string) -> string {
    if text == null { return md5_hash(null, 0) }
    return md5_hash(text as @u8, str.len(text))
}
