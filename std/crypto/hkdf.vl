// std.crypto.hkdf — HMAC-based Extract-and-Expand Key Derivation Function (RFC 5869)
// and TLS 1.3 Key Schedule Derivation (RFC 8446 Section 7.1).
use "hmac.vl"
use "subtle.vl"
use "../mem/heap.vl"

// =========================================================================
// 1. HKDF-SHA256 (RFC 5869)
// =========================================================================

// HKDF-Extract(salt, IKM) -> PRK (32 bytes)
view act hkdf_sha256_extract(salt: @u8, salt_len: usize, ikm: @u8, ikm_len: usize, out_prk: @u8) {
    if out_prk == null { return }
    if salt == null or salt_len == 0 {
        let zero_salt: @u8 = heap_alloc(32) as @u8
        crypto_zero(zero_salt, 32)
        hmac_sha256(zero_salt, 32, ikm, ikm_len, out_prk)
        heap_free(zero_salt as @void)
    } else {
        hmac_sha256(salt, salt_len, ikm, ikm_len, out_prk)
    }
}

// HKDF-Expand(PRK, info, L) -> OKM (L bytes)
view act hkdf_sha256_expand(prk: @u8, prk_len: usize, info: @u8, info_len: usize, out_okm: @u8, okm_len: usize) -> bool {
    if prk == null or out_okm == null or okm_len == 0 { return false }
    let n = (okm_len + 31) / 32
    if n > 255 { return false }

    let t: @u8 = heap_alloc(32) as @u8
    let chunk_buf: @u8 = heap_alloc(32 + info_len + 1) as @u8
    mut t_len: usize = 0
    mut okm_pos: usize = 0

    mut round: usize = 1
    loop round <= n {
        mut chunk_pos: usize = 0
        if t_len > 0 {
            mut i: usize = 0
            loop i < t_len { chunk_buf[chunk_pos] = t[i]; chunk_pos += 1; i += 1 }
        }
        if info != null and info_len > 0 {
            mut i: usize = 0
            loop i < info_len { chunk_buf[chunk_pos] = info[i]; chunk_pos += 1; i += 1 }
        }
        chunk_buf[chunk_pos] = round as u8
        chunk_pos += 1

        hmac_sha256(prk, prk_len, chunk_buf, chunk_pos, t)
        t_len = 32

        mut copy_len: usize = 32
        if okm_pos + copy_len > okm_len {
            copy_len = okm_len - okm_pos
        }
        mut i: usize = 0
        loop i < copy_len {
            out_okm[okm_pos + i] = t[i]
            i += 1
        }
        okm_pos += copy_len
        round += 1
    }

    crypto_zero(t, 32)
    crypto_zero(chunk_buf, 32 + info_len + 1)
    heap_free(t as @void)
    heap_free(chunk_buf as @void)
    return true
}

// Full HKDF-SHA256 (Extract then Expand)
view act hkdf_sha256(salt: @u8, salt_len: usize, ikm: @u8, ikm_len: usize, info: @u8, info_len: usize, out_okm: @u8, okm_len: usize) -> bool {
    let prk: @u8 = heap_alloc(32) as @u8
    hkdf_sha256_extract(salt, salt_len, ikm, ikm_len, prk)
    let ok = hkdf_sha256_expand(prk, 32, info, info_len, out_okm, okm_len)
    crypto_zero(prk, 32)
    heap_free(prk as @void)
    return ok
}

// =========================================================================
// 2. TLS 1.3 Key Schedule Primitives (RFC 8446 Section 7.1)
// =========================================================================

// HKDF-Expand-Label(Secret, Label, Context, Length)
view act tls13_hkdf_expand_label(secret: @u8, label: string, context: @u8, context_len: usize, length: u16, out_key: @u8) -> bool {
    if secret == null or label == null or out_key == null { return false }
    let prefix = "tls13 "
    let label_len = str.len(label)
    let full_label_len = 6 + label_len
    if full_label_len > 255 or context_len > 255 { return false }

    let hkdf_label_len = 2 + 1 + full_label_len + 1 + context_len
    let hkdf_label: @u8 = heap_alloc(hkdf_label_len) as @u8
    if hkdf_label == null { return false }

    // uint16 length
    hkdf_label[0] = ((length >> 8) & 0xff) as u8
    hkdf_label[1] = (length & 0xff) as u8

    // opaque label<7..255> = "tls13 " + Label
    hkdf_label[2] = full_label_len as u8
    mut pos: usize = 3
    mut i: usize = 0
    loop i < 6 { hkdf_label[pos] = prefix[i]; pos += 1; i += 1 }
    i = 0
    loop i < label_len { hkdf_label[pos] = label[i]; pos += 1; i += 1 }

    // opaque context<0..255> = Context
    hkdf_label[pos] = context_len as u8
    pos += 1
    if context != null and context_len > 0 {
        i = 0
        loop i < context_len { hkdf_label[pos] = context[i]; pos += 1; i += 1 }
    }

    let ok = hkdf_sha256_expand(secret, 32, hkdf_label, hkdf_label_len, out_key, length as usize)
    crypto_zero(hkdf_label, hkdf_label_len)
    heap_free(hkdf_label as @void)
    return ok
}

// Derive-Secret(Secret, Label, Messages) = HKDF-Expand-Label(Secret, Label, Transcript-Hash(Messages), HashLen)
view act tls13_derive_secret(secret: @u8, label: string, transcript_hash: @u8, out_secret: @u8) -> bool {
    return tls13_hkdf_expand_label(secret, label, transcript_hash, 32, 32 as u16, out_secret)
}
