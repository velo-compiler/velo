// Pure Velo integer formatting library (zero C runtime dependencies).
// Formats u64 and i64 integers into decimal, hexadecimal, binary, and octal ASCII representations
// in caller-provided stack or regional buffers.
use "../str/slice.vl"

// Formats an unsigned 64-bit integer as decimal digits into buf.
// Writes formatted characters starting at buf[0] and ensures null-termination if buf_len allows.
// Returns a StrSlice view over the formatted digits, or an empty slice if buf is too small.
view act format_u64(val: u64, buf: @u8, buf_len: usize) -> StrSlice {
    if buf == null or buf_len == 0 {
        return StrSlice { ptr: null, len: 0 }
    }
    if val == 0 as u64 {
        buf[0] = 48 as u8
        if buf_len > 1 { buf[1] = 0 as u8 }
        return StrSlice { ptr: buf, len: 1 }
    }
    mut n = val
    mut pos = buf_len
    loop n > 0 as u64 and pos > 0 {
        pos -= 1
        buf[pos] = (48 as u64 + (n % 10 as u64)) as u8
        n = n / 10 as u64
    }
    if n > 0 as u64 {
        return StrSlice { ptr: null, len: 0 }
    }
    let len = buf_len - pos
    if pos > 0 {
        mut i: usize = 0
        loop i < len {
            buf[i] = buf[pos + i]
            i += 1
        }
    }
    if len < buf_len {
        buf[len] = 0 as u8
    }
    return StrSlice { ptr: buf, len: len }
}

// Formats a signed 64-bit integer as decimal digits with optional leading '-' into buf.
// Handles INT64_MIN (-9223372036854775808) correctly without overflow.
// Writes formatted characters starting at buf[0] and ensures null-termination if buf_len allows.
// Returns a StrSlice view over the formatted digits, or an empty slice if buf is too small.
view act format_i64(val: i64, buf: @u8, buf_len: usize) -> StrSlice {
    if buf == null or buf_len == 0 {
        return StrSlice { ptr: null, len: 0 }
    }
    if val == 0 as i64 {
        buf[0] = 48 as u8
        if buf_len > 1 { buf[1] = 0 as u8 }
        return StrSlice { ptr: buf, len: 1 }
    }
    let is_neg = val < 0 as i64
    mut n: u64 = 0
    if is_neg {
        if val == (-9223372036854775807 as i64) - (1 as i64) {
            n = 0x8000000000000000 as u64
        } else {
            n = (-val) as u64
        }
    } else {
        n = val as u64
    }
    mut pos = buf_len
    loop n > 0 as u64 and pos > 0 {
        pos -= 1
        buf[pos] = (48 as u64 + (n % 10 as u64)) as u8
        n = n / 10 as u64
    }
    if is_neg {
        if pos == 0 {
            return StrSlice { ptr: null, len: 0 }
        }
        pos -= 1
        buf[pos] = 45 as u8 // '-'
    }
    if n > 0 as u64 {
        return StrSlice { ptr: null, len: 0 }
    }
    let len = buf_len - pos
    if pos > 0 {
        mut i: usize = 0
        loop i < len {
            buf[i] = buf[pos + i]
            i += 1
        }
    }
    if len < buf_len {
        buf[len] = 0 as u8
    }
    return StrSlice { ptr: buf, len: len }
}

// Formats an unsigned 64-bit integer as hexadecimal into buf.
// Uses uppercase letters ('A'..'F') if upper is true, otherwise lowercase ('a'..'f').
view act format_hex(val: u64, upper: bool, buf: @u8, buf_len: usize) -> StrSlice {
    if buf == null or buf_len == 0 {
        return StrSlice { ptr: null, len: 0 }
    }
    if val == 0 as u64 {
        buf[0] = 48 as u8
        if buf_len > 1 { buf[1] = 0 as u8 }
        return StrSlice { ptr: buf, len: 1 }
    }
    mut n = val
    mut pos = buf_len
    mut alpha_base: u64 = 87 as u64
    if upper {
        alpha_base = 55 as u64
    }
    loop n > 0 as u64 and pos > 0 {
        pos -= 1
        let rem = n & 15 as u64
        if rem < 10 as u64 {
            buf[pos] = (48 as u64 + rem) as u8
        } else {
            buf[pos] = (alpha_base + rem) as u8
        }
        n = n >> 4
    }
    if n > 0 as u64 {
        return StrSlice { ptr: null, len: 0 }
    }
    let len = buf_len - pos
    if pos > 0 {
        mut i: usize = 0
        loop i < len {
            buf[i] = buf[pos + i]
            i += 1
        }
    }
    if len < buf_len {
        buf[len] = 0 as u8
    }
    return StrSlice { ptr: buf, len: len }
}

// Formats an unsigned 64-bit integer as binary ('0' and '1') into buf.
view act format_bin(val: u64, buf: @u8, buf_len: usize) -> StrSlice {
    if buf == null or buf_len == 0 {
        return StrSlice { ptr: null, len: 0 }
    }
    if val == 0 as u64 {
        buf[0] = 48 as u8
        if buf_len > 1 { buf[1] = 0 as u8 }
        return StrSlice { ptr: buf, len: 1 }
    }
    mut n = val
    mut pos = buf_len
    loop n > 0 as u64 and pos > 0 {
        pos -= 1
        buf[pos] = (48 as u64 + (n & 1 as u64)) as u8
        n = n >> 1
    }
    if n > 0 as u64 {
        return StrSlice { ptr: null, len: 0 }
    }
    let len = buf_len - pos
    if pos > 0 {
        mut i: usize = 0
        loop i < len {
            buf[i] = buf[pos + i]
            i += 1
        }
    }
    if len < buf_len {
        buf[len] = 0 as u8
    }
    return StrSlice { ptr: buf, len: len }
}

// Formats an unsigned 64-bit integer as octal ('0'..'7') into buf.
view act format_oct(val: u64, buf: @u8, buf_len: usize) -> StrSlice {
    if buf == null or buf_len == 0 {
        return StrSlice { ptr: null, len: 0 }
    }
    if val == 0 as u64 {
        buf[0] = 48 as u8
        if buf_len > 1 { buf[1] = 0 as u8 }
        return StrSlice { ptr: buf, len: 1 }
    }
    mut n = val
    mut pos = buf_len
    loop n > 0 as u64 and pos > 0 {
        pos -= 1
        buf[pos] = (48 as u64 + (n & 7 as u64)) as u8
        n = n >> 3
    }
    if n > 0 as u64 {
        return StrSlice { ptr: null, len: 0 }
    }
    let len = buf_len - pos
    if pos > 0 {
        mut i: usize = 0
        loop i < len {
            buf[i] = buf[pos + i]
            i += 1
        }
    }
    if len < buf_len {
        buf[len] = 0 as u8
    }
    return StrSlice { ptr: buf, len: len }
}

// Formats an unsigned 64-bit integer padded with leading zeroes up to min_digits.
view act format_u64_padded(val: u64, min_digits: usize, buf: @u8, buf_len: usize) -> StrSlice {
    if buf == null or buf_len == 0 {
        return StrSlice { ptr: null, len: 0 }
    }
    mut n = val
    mut pos = buf_len
    loop (n > 0 as u64 or (buf_len - pos) < min_digits) and pos > 0 {
        pos -= 1
        buf[pos] = (48 as u64 + (n % 10 as u64)) as u8
        n = n / 10 as u64
    }
    if n > 0 as u64 or (buf_len - pos) < min_digits {
        return StrSlice { ptr: null, len: 0 }
    }
    let len = buf_len - pos
    if pos > 0 {
        mut i: usize = 0
        loop i < len {
            buf[i] = buf[pos + i]
            i += 1
        }
    }
    if len < buf_len {
        buf[len] = 0 as u8
    }
    return StrSlice { ptr: buf, len: len }
}

// Formats an unsigned 64-bit integer in hexadecimal padded with leading zeroes up to min_digits.
view act format_hex_padded(val: u64, min_digits: usize, upper: bool, buf: @u8, buf_len: usize) -> StrSlice {
    if buf == null or buf_len == 0 {
        return StrSlice { ptr: null, len: 0 }
    }
    mut n = val
    mut pos = buf_len
    mut alpha_base: u64 = 87 as u64
    if upper {
        alpha_base = 55 as u64
    }
    loop (n > 0 as u64 or (buf_len - pos) < min_digits) and pos > 0 {
        pos -= 1
        let rem = n & 15 as u64
        if rem < 10 as u64 {
            buf[pos] = (48 as u64 + rem) as u8
        } else {
            buf[pos] = (alpha_base + rem) as u8
        }
        n = n >> 4
    }
    if n > 0 as u64 or (buf_len - pos) < min_digits {
        return StrSlice { ptr: null, len: 0 }
    }
    let len = buf_len - pos
    if pos > 0 {
        mut i: usize = 0
        loop i < len {
            buf[i] = buf[pos + i]
            i += 1
        }
    }
    if len < buf_len {
        buf[len] = 0 as u8
    }
    return StrSlice { ptr: buf, len: len }
}
