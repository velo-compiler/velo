// Pure Velo fixed-size freelist (slab) allocator (zero C library runtime dependencies).
// Provides O(1) recycling of fixed-size memory blocks without heap fragmentation.
use "arena.vl"

// Fixed-size memory block pool descriptor.
data SlabPool {
    block_size: usize
    free_head: @u8
    allocated_count: usize
    free_count: usize
    arena: Arena
}

// Initializes a fixed-size slab pool backed by an internal arena.
// block_size is clamped to at least 8 bytes and rounded up to 8-byte alignment.
act slab_init(block_size: usize, initial_capacity: usize) -> SlabPool {
    mut bsize = block_size
    // Minimum block size must accommodate an intrusive 64-bit pointer
    if bsize < 8 {
        bsize = 8
    }
    // Align block size to 8-byte boundary
    if bsize % 8 != 0 {
        let mask: usize = 7
        bsize = (bsize + mask) & ~mask
    }

    mut cap = initial_capacity
    if cap < bsize * 4 {
        cap = bsize * 4
    }

    return SlabPool{
        block_size: bsize,
        free_head: null,
        allocated_count: 0,
        free_count: 0,
        arena: arena_init(cap),
    }
}

// Allocates a fixed-size block from the slab pool.
// Reuses previously freed blocks from the freelist in O(1) before expanding the arena.
act slab_alloc(p: @SlabPool) -> @u8 {
    if p == null {
        return null
    }

    // 1. Check freelist first (O(1) pop)
    if p.free_head != null {
        let block = p.free_head
        let next_slot: @@u8 = block as @@u8
        p.free_head = next_slot[0]
        if p.free_count > 0 {
            p.free_count -= 1
        }
        p.allocated_count += 1
        return block
    }

    // 2. Freelist is empty: allocate from internal arena
    let block = arena_alloc(@p.arena, p.block_size, 8)
    if block != null {
        p.allocated_count += 1
    }
    return block
}

// Returns a block to the slab pool for immediate O(1) reuse.
act slab_free(p: @SlabPool, ptr: @u8) {
    if p == null or ptr == null {
        return
    }

    // Push block to the head of the intrusive freelist (O(1) push)
    let slot: @@u8 = ptr as @@u8
    slot[0] = p.free_head
    p.free_head = ptr

    if p.allocated_count > 0 {
        p.allocated_count -= 1
    }
    p.free_count += 1
}

// Destroys the slab pool and releases all underlying pages back to the OS.
act slab_destroy(p: @SlabPool) {
    if p != null {
        p.free_head = null
        p.allocated_count = 0
        p.free_count = 0
        arena_free(@p.arena)
    }
}
