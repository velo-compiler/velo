// std.tls.record — RFC 8446 Section 5 TLS 1.3 Record Layer.
use "../crypto/chacha20poly1305.vl"
use "../crypto/subtle.vl"
use "../mem/heap.vl"

let TLS_RECORD_CHANGE_CIPHER_SPEC: u8 = 0x14 as u8
let TLS_RECORD_ALERT: u8              = 0x15 as u8
let TLS_RECORD_HANDSHAKE: u8          = 0x16 as u8
let TLS_RECORD_APPLICATION_DATA: u8   = 0x17 as u8

let TLS_LEGACY_VERSION_MAJOR: u8 = 0x03 as u8
let TLS_LEGACY_VERSION_MINOR: u8 = 0x03 as u8

// Constructs a 12-byte AEAD nonce by XORing the 12-byte IV with the 64-bit sequence number.
act tls13_make_nonce(iv: @u8, seq: u64, out_nonce: @u8) {
    if iv == null or out_nonce == null { return }
    // First 4 bytes are untouched (seq number is 64-bit, padded with 4 zero bytes on left)
    out_nonce[0] = iv[0]
    out_nonce[1] = iv[1]
    out_nonce[2] = iv[2]
    out_nonce[3] = iv[3]

    mut j: usize = 0
    loop j < 8 {
        let shift = ((7 - j) * 8) as u64
        let b = ((seq >> shift) & (0xff as u64)) as u8
        out_nonce[4 + j] = iv[4 + j] ^ b
        j += 1
    }
}

// Encrypts a TLS 1.3 protected record into out_record.
// Out buffer must have at least 5 + pt_len + 1 + 16 bytes.
act tls13_encrypt_record(key: @u8, iv: @u8, seq: u64, content_type: u8, pt: @u8, pt_len: usize, out_record: @u8, out_rec_len: @usize) -> bool {
    if key == null or iv == null or out_record == null or out_rec_len == null { return false }

    let inner_len = pt_len + 1
    let ct_len = inner_len + 16
    if ct_len > 16384 + 256 { return false } // RFC 8446 max ciphertext size

    // Construct inner plaintext: pt || content_type
    let inner_pt: @u8 = heap_alloc(inner_len) as @u8
    if inner_pt == null { return false }
    if pt != null and pt_len > 0 {
        mut i: usize = 0
        loop i < pt_len { inner_pt[i] = pt[i]; i += 1 }
    }
    inner_pt[pt_len] = content_type

    // Build 5-byte legacy record header (AD)
    out_record[0] = TLS_RECORD_APPLICATION_DATA
    out_record[1] = TLS_LEGACY_VERSION_MAJOR
    out_record[2] = TLS_LEGACY_VERSION_MINOR
    out_record[3] = ((ct_len >> 8) & 0xff) as u8
    out_record[4] = (ct_len & 0xff) as u8

    // Generate nonce
    let nonce: @u8 = heap_alloc(12) as @u8
    tls13_make_nonce(iv, seq, nonce)

    // Encrypt
    let ct_ptr = out_record + 5
    let tag_ptr = ct_ptr + inner_len
    chacha20poly1305_encrypt(key, nonce, out_record, 5, inner_pt, inner_len, ct_ptr, tag_ptr)

    crypto_zero(inner_pt, inner_len)
    crypto_zero(nonce, 12)
    heap_free(inner_pt as @void)
    heap_free(nonce as @void)

    out_rec_len[0] = 5 + ct_len
    return true
}

// Decrypts a TLS 1.3 protected record from record_buf.
// Returns true on authenticated success, false on MAC mismatch or corruption.
act tls13_decrypt_record(key: @u8, iv: @u8, seq: u64, record_buf: @u8, record_len: usize, out_pt: @u8, out_pt_len: @usize, out_content_type: @u8) -> bool {
    if key == null or iv == null or record_buf == null or out_pt == null or out_pt_len == null or out_content_type == null {
        return false
    }
    if record_len < 5 + 16 + 1 { return false } // Header (5) + Poly1305 tag (16) + inner content type (1)

    // Validate outer header
    if record_buf[0] != TLS_RECORD_APPLICATION_DATA { return false }
    if record_buf[1] != TLS_LEGACY_VERSION_MAJOR or record_buf[2] != TLS_LEGACY_VERSION_MINOR { return false }

    let wire_ct_len = ((record_buf[3] as usize) << 8) | (record_buf[4] as usize)
    if 5 + wire_ct_len != record_len { return false }

    let ct_len = wire_ct_len - 16 // payload without Poly1305 tag
    let ct_ptr = record_buf + 5
    let tag_ptr = record_buf + 5 + ct_len

    let nonce: @u8 = heap_alloc(12) as @u8
    tls13_make_nonce(iv, seq, nonce)

    let inner_pt: @u8 = heap_alloc(ct_len) as @u8
    let ok = chacha20poly1305_decrypt(key, nonce, record_buf, 5, ct_ptr, ct_len, tag_ptr, inner_pt)

    crypto_zero(nonce, 12)
    heap_free(nonce as @void)

    if !ok {
        crypto_zero(inner_pt, ct_len)
        heap_free(inner_pt as @void)
        return false
    }

    // Strip trailing padding zeros to locate inner ContentType (RFC 8446 Section 5.4)
    mut pos: i32 = (ct_len as i32) - 1
    loop pos >= 0 and inner_pt[pos] == (0 as u8) {
        pos -= 1
    }
    if pos < 0 {
        crypto_zero(inner_pt, ct_len)
        heap_free(inner_pt as @void)
        return false // All-zero record payload has no content type
    }

    let real_type = inner_pt[pos]
    let real_pt_len = pos as usize

    mut i: usize = 0
    loop i < real_pt_len {
        out_pt[i] = inner_pt[i]
        i += 1
    }
    out_pt_len[0] = real_pt_len
    out_content_type[0] = real_type

    crypto_zero(inner_pt, ct_len)
    heap_free(inner_pt as @void)
    return true
}
