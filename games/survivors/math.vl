// 2D Vector Math and Collision Primitives for Velo Survivors.

view data Vec2 {
    x: f32
    y: f32
}

view act vec2_make(x: f32, y: f32) -> Vec2 {
    return Vec2{ x: x, y: y }
}

view act approx_sqrt(v: f32) -> f32 {
    if v <= 0.0 { return 0.0 }
    mut x = v
    if x > 1.0 { x = v * 0.5 }
    x = 0.5 * (x + v / x)
    x = 0.5 * (x + v / x)
    x = 0.5 * (x + v / x)
    x = 0.5 * (x + v / x)
    return x
}

view act vec2_dist_sq(ax: f32, ay: f32, bx: f32, by: f32) -> f32 {
    let dx = ax - bx
    let dy = ay - by
    return dx * dx + dy * dy
}

view act vec2_dist(ax: f32, ay: f32, bx: f32, by: f32) -> f32 {
    return approx_sqrt(vec2_dist_sq(ax, ay, bx, by))
}

view act vec2_norm(x: f32, y: f32) -> Vec2 {
    let d = approx_sqrt(x * x + y * y)
    if d > 0.0001 {
        return Vec2{ x: x / d, y: y / d }
    }
    return Vec2{ x: 0.0, y: 0.0 }
}

view act check_circle_collision(x1: f32, y1: f32, r1: f32, x2: f32, y2: f32, r2: f32) -> bool {
    let d_sq = vec2_dist_sq(x1, y1, x2, y2)
    let rad_sum = r1 + r2
    return d_sq < (rad_sum * rad_sum)
}

view act clamp_f32(v: f32, min_val: f32, max_val: f32) -> f32 {
    if v < min_val { return min_val }
    if v > max_val { return max_val }
    return v
}
