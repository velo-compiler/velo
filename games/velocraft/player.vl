// First-Person Player Physics, Mouse Look, and Inventory Controls for VeloCraft.

use "raylib.vl"
use "math3d.vl"
use "world.vl"

data Player {
    pos: Vector3
    yaw: f32
    pitch: f32
    vel_y: f32
    is_grounded: bool
    active_slot: i32
    step_timer: f32
}

act init_player() -> Player {
    mut p: Player
    p.pos = Vector3{ x: 8.0, y: 14.0, z: 8.0 }
    p.yaw = 0.0
    p.pitch = 0.0
    p.vel_y = 0.0
    p.is_grounded = false
    p.active_slot = 1
    p.step_timer = 0.0
    return p
}

act get_slot_block(slot: i32) -> u8 {
    if slot == 1 { return BLOCK_GRASS }
    if slot == 2 { return BLOCK_DIRT }
    if slot == 3 { return BLOCK_STONE }
    if slot == 4 { return BLOCK_WOOD }
    if slot == 5 { return BLOCK_LEAVES }
    if slot == 6 { return BLOCK_BRICK }
    return BLOCK_GRASS
}

act get_player_camera(p: @Player) -> Camera3D {
    mut cam: Camera3D
    let eye_pos = Vector3{ x: p.pos.x, y: p.pos.y + 1.6, z: p.pos.z }
    let dir = vec3_dir_from_angles(p.yaw, p.pitch)
    cam.position = eye_pos
    cam.target = vec3_add(eye_pos, dir)
    cam.up = Vector3{ x: 0.0, y: 1.0, z: 0.0 }
    cam.fovy = 65.0
    cam.projection = 0 // Perspective
    return cam
}

act update_player(p: @Player, w: @VoxelWorld, dt: f32, cursor_locked: bool) -> bool {
    mut played_step = false

    // 1. Mouse look (only when cursor is locked)
    if cursor_locked {
        let md = GetMouseDelta()
        let sens: f32 = 0.0028
        p.yaw += md.x * sens
        p.pitch -= md.y * sens

        // Clamp pitch to avoid screen flipping
        if p.pitch > 1.52 { p.pitch = 1.52 }
        if p.pitch < (0.0 - 1.52) { p.pitch = 0.0 - 1.52 }
    }

    // 2. Hotbar Selection [1] through [6]
    if IsKeyPressed(KEY_ONE) { p.active_slot = 1 }
    else if IsKeyPressed(KEY_TWO) { p.active_slot = 2 }
    else if IsKeyPressed(KEY_THREE) { p.active_slot = 3 }
    else if IsKeyPressed(KEY_FOUR) { p.active_slot = 4 }
    else if IsKeyPressed(KEY_FIVE) { p.active_slot = 5 }
    else if IsKeyPressed(KEY_SIX) { p.active_slot = 6 }

    // 3. Horizontal Movement
    let fwd = vec3_horizontal_forward(p.yaw)
    let rt = vec3_horizontal_right(p.yaw)
    mut move_x: f32 = 0.0
    mut move_z: f32 = 0.0

    if IsKeyDown(KEY_W) { move_x += fwd.x; move_z += fwd.z }
    if IsKeyDown(KEY_S) { move_x -= fwd.x; move_z -= fwd.z }
    if IsKeyDown(KEY_D) { move_x += rt.x; move_z += rt.z }
    if IsKeyDown(KEY_A) { move_x -= rt.x; move_z -= rt.z }

    let move_sq = move_x * move_x + move_z * move_z
    if move_sq > 0.0001 {
        let inv_len = 1.0 / approx_sqrt(move_sq)
        let speed: f32 = 6.2
        let step_x = move_x * inv_len * speed * dt
        let step_z = move_z * inv_len * speed * dt

        // Infinite movement without world bounds restriction
        p.pos.x += step_x
        p.pos.z += step_z

        if p.is_grounded {
            p.step_timer += dt
            if p.step_timer >= 0.35 {
                p.step_timer = 0.0
                played_step = true
            }
        }
    }

    // 4. Ground Collision & Gravity
    let bx = floor_to_i32(p.pos.x)
    let bz = floor_to_i32(p.pos.z)

    // Find highest solid block below or at player's feet
    mut ground_y: f32 = 0.0
    mut check_y = floor_to_i32(p.pos.y + 0.4)
    if check_y > 15 { check_y = 15 }
    loop check_y >= 0 {
        if world_get(w, bx, check_y, bz) != BLOCK_AIR {
            ground_y = (check_y as f32) + 1.0
            break
        }
        check_y -= 1
    }

    // Jump
    if IsKeyPressed(KEY_SPACE) and p.is_grounded {
        p.vel_y = 7.4
        p.is_grounded = false
    }

    // Gravity
    p.vel_y -= 20.0 * dt
    p.pos.y += p.vel_y * dt

    // Ground snap
    if p.pos.y <= ground_y {
        p.pos.y = ground_y
        p.vel_y = 0.0
        p.is_grounded = true
    } else {
        p.is_grounded = false
    }

    return played_step
}
