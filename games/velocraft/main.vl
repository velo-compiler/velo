// VeloCraft — 3D Voxel Sandbox in Velo powered by Raylib 6.0 3D C-FFI.

use "raylib.vl"
use "math3d.vl"
use "world.vl"
use "player.vl"
use "voxel_ray.vl"
use "fx.vl"

act get_slot_name(slot: i32) -> string {
    if slot == 1 { return "Grass Block" }
    if slot == 2 { return "Dirt" }
    if slot == 3 { return "Stone" }
    if slot == 4 { return "Wood Log" }
    if slot == 5 { return "Leaves" }
    if slot == 6 { return "Brick" }
    return "Block"
}

act draw_stars(cam_pos: Vector3) {
    let star_col = make_color(255, 255, 255, 220)
    mut i: i32 = 0
    loop i < 28 {
        let fi = i as f32
        let a = fi * 0.45
        let dist: f32 = 45.0
        let sx = cam_pos.x + approx_cos(a * 1.7) * dist
        let sy = cam_pos.y + 14.0 + ((i % 7) as f32) * 4.0
        let sz = cam_pos.z + approx_sin(a * 2.1) * dist
        DrawCube(Vector3{ x: sx, y: sy, z: sz }, 0.45, 0.45, 0.45, star_col)
        i += 1
    }
}

act draw_hud(screen_w: f32, screen_h: f32, p: @Player, hit: @RayHit, cursor_locked: bool, time_str: string, time_col: Color) {
    let cx = (screen_w * 0.5) as i32
    let cy = (screen_h * 0.5) as i32

    // 1. Center Crosshair (+)
    DrawRectangle(cx - 9, cy - 1, 18, 2, make_color(255, 255, 255, 210))
    DrawRectangle(cx - 1, cy - 9, 2, 18, make_color(255, 255, 255, 210))
    DrawCircle(cx, cy, 1.5, make_color(20, 20, 20, 255))

    // 2. Hotbar at Bottom
    let slot_size: i32 = 44
    let spacing: i32 = 6
    let total_w = 6 * slot_size + 5 * spacing
    let start_x = ((screen_w - (total_w as f32)) * 0.5) as i32
    let bar_y = (screen_h - 58.0) as i32

    mut s: i32 = 1
    loop s <= 6 {
        let sx = start_x + (s - 1) * (slot_size + spacing)
        let is_active = (s == p.active_slot)

        mut bg_col = make_color(25, 28, 34, 210)
        mut border_col = make_color(70, 75, 85, 255)
        if is_active {
            bg_col = make_color(45, 50, 60, 240)
            border_col = make_color(255, 215, 50, 255)
        }

        DrawRectangle(sx, bar_y, slot_size, slot_size, bg_col)
        DrawRectangleLines(sx, bar_y, slot_size, slot_size, border_col)
        if is_active {
            DrawRectangleLines(sx - 1, bar_y - 1, slot_size + 2, slot_size + 2, border_col)
        }

        let block_id = get_slot_block(s)
        let block_col = get_block_color(block_id)
        DrawRectangle(sx + 10, bar_y + 10, 24, 24, block_col)
        DrawRectangleLines(sx + 10, bar_y + 10, 24, 24, make_color(20, 20, 20, 100))

        mut num_str = "1"
        if s == 2 { num_str = "2" }
        else if s == 3 { num_str = "3" }
        else if s == 4 { num_str = "4" }
        else if s == 5 { num_str = "5" }
        else if s == 6 { num_str = "6" }
        DrawText(num_str, sx + 4, bar_y + 3, 12, make_color(200, 200, 200, 220))

        s += 1
    }

    // 3. Top-Left Status Card (Coordinates, Active Block, Day/Night Phase)
    DrawRectangle(10, 10, 240, 122, make_color(15, 20, 25, 190))
    DrawRectangleLines(10, 10, 240, 122, make_color(60, 70, 85, 255))
    DrawText("VELOCRAFT 3D", 18, 15, 18, make_color(255, 220, 50, 255))

    let active_name = get_slot_name(p.active_slot)
    DrawText(active_name, 18, 36, 14, make_color(100, 220, 120, 255))
    DrawText(time_str, 18, 54, 14, time_col)
    DrawText("Infinite Multi-Chunk World", 18, 72, 12, make_color(160, 220, 255, 255))
    DrawText("Fog * Clouds * Water * AO", 18, 88, 11, make_color(140, 240, 190, 255))
    DrawText("Hold [T] to Speed Up Time", 18, 104, 11, make_color(180, 200, 220, 200))

    // 4. Top-Right Controls Hint
    DrawRectangle((screen_w - 490.0) as i32, 10, 480, 28, make_color(15, 20, 25, 180))
    DrawText("[W][A][S][D] Move | [SPACE] Jump | [LMB] Mine | [RMB] Place | [ESC] Pause | [F11] Fullscreen", ((screen_w - 482.0) as i32), 16, 12, make_color(220, 220, 220, 255))

    // 5. Mouse lock status & pause modal when released
    if not cursor_locked {
        DrawRectangle(0, 0, screen_w as i32, screen_h as i32, make_color(10, 15, 20, 160))

        let box_w: i32 = 440
        let box_h: i32 = 220
        let box_x = cx - 220
        let box_y = cy - 110

        DrawRectangle(box_x, box_y, box_w, box_h, make_color(25, 30, 40, 245))
        DrawRectangleLines(box_x, box_y, box_w, box_h, make_color(255, 215, 50, 255))

        DrawText("GAME PAUSED", cx - 95, box_y + 24, 26, make_color(255, 220, 50, 255))
        DrawText("Mouse Cursor is Released", cx - 94, box_y + 64, 16, make_color(200, 220, 240, 255))

        DrawRectangle(cx - 165, box_y + 102, 330, 36, make_color(40, 55, 75, 255))
        DrawRectangleLines(cx - 165, box_y + 102, 330, 36, make_color(100, 180, 255, 255))
        DrawText("CLICK ANYWHERE OR [ESC] TO RESUME", cx - 148, box_y + 112, 14, make_color(255, 255, 255, 255))

        DrawText("Press [F11] or [F] to Toggle Fullscreen", cx - 132, box_y + 155, 15, make_color(160, 220, 160, 255))
        DrawText("Press [Close Window] to Exit", cx - 100, box_y + 182, 14, make_color(180, 180, 180, 200))
    }

    // 6. Bottom-Left Real-Time FPS Badge
    DrawRectangle(10, (screen_h - 34.0) as i32, 95, 24, make_color(0, 0, 0, 160))
    DrawFPS(16, (screen_h - 31.0) as i32)
}

act main() -> i32 {
    InitWindow(960, 640, "VeloCraft - 3D Voxel Sandbox in Velo")
    SetTargetFPS(60)
    SetExitKey(0) // Free ESC key for mouse release & pause instead of hard quitting

    InitAudioDevice()
    let snd_break = LoadSound("games/velocraft/assets/break.wav")
    let snd_place = LoadSound("games/velocraft/assets/place.wav")
    let snd_step = LoadSound("games/velocraft/assets/step.wav")
    let snd_switch = LoadSound("games/velocraft/assets/switch.wav")

    mut world = init_world()
    mut player = init_player()
    mut cursor_locked = true
    DisableCursor()

    // Initialize chunks around player spawn position
    update_world_chunks(@world, player.pos.x, player.pos.z)

    mut prev_slot = player.active_slot
    mut day_time: f32 = 0.25 // Start at pleasant morning/noon
    mut anim_time: f32 = 0.0
    mut wind_timer: f32 = 0.0

    loop not WindowShouldClose() {
        let dt = GetFrameTime()
        anim_time += dt
        wind_timer += dt * 1.5
        let screen_w = GetScreenWidth() as f32
        let screen_h = GetScreenHeight() as f32

        // 1. Advance Day / Night Cycle (90s full day, or hold [T] for fast forward)
        mut time_speed: f32 = 1.0 / 90.0
        if IsKeyDown(KEY_T) {
            time_speed = 1.0 / 7.0
        }
        day_time += dt * time_speed
        loop day_time >= 1.0 { day_time -= 1.0 }

        // Orbital angles for Sun & Moon centered around player position
        let sun_angle = day_time * 6.28318
        let sun_cos = approx_cos(sun_angle)
        let sun_sin = approx_sin(sun_angle)

        let orb_r: f32 = 48.0
        let sun_pos = Vector3{
            x: player.pos.x + sun_cos * orb_r,
            y: 6.0 + sun_sin * orb_r,
            z: player.pos.z + sun_sin * 14.0
        }
        let moon_pos = Vector3{
            x: player.pos.x - sun_cos * orb_r,
            y: 6.0 - sun_sin * orb_r,
            z: player.pos.z - sun_sin * 14.0
        }

        // Lighting, Sky Color, and Atmosphere
        mut sky_col = make_color(130, 195, 245, 255)
        mut block_tint = make_color(255, 255, 255, 255)
        mut light_mult: f32 = 1.0
        mut time_str = "Time: Day (Noon)"
        mut time_col = make_color(255, 230, 80, 255)

        if sun_sin > 0.25 {
            // Bright Day
            sky_col = make_color(130, 195, 245, 255)
            block_tint = make_color(255, 255, 255, 255)
            light_mult = 1.0
            time_str = "Time: Day (Sun High)"
            time_col = make_color(255, 230, 80, 255)
        } else if sun_sin >= (0.0 - 0.15) {
            // Golden Sunrise / Sunset
            sky_col = make_color(235, 120, 75, 255)
            block_tint = make_color(255, 185, 120, 255)
            light_mult = 0.72
            if sun_cos < 0.0 {
                time_str = "Time: Sunset (Dusk)"
            } else {
                time_str = "Time: Sunrise (Dawn)"
            }
            time_col = make_color(255, 160, 60, 255)
        } else {
            // Starry Night
            sky_col = make_color(12, 16, 30, 255)
            block_tint = make_color(140, 160, 225, 255)
            light_mult = 0.28
            time_str = "Time: Night (Moonlight)"
            time_col = make_color(150, 190, 255, 255)
        }

        // 2. Fullscreen Toggle with [F11] or [F] (when paused)
        if IsKeyPressed(KEY_F11) or (not cursor_locked and IsKeyPressed(KEY_F)) {
            ToggleFullscreen()
        }

        // 3. Toggle Mouse Lock / Release with [ESC] or [TAB]
        if IsKeyPressed(KEY_ESCAPE) or IsKeyPressed(KEY_TAB) {
            cursor_locked = not cursor_locked
            if cursor_locked { DisableCursor() }
            else { EnableCursor() }
        }

        // Click anywhere to re-capture mouse when released
        if not cursor_locked and IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
            cursor_locked = true
            DisableCursor()
        }

        // 4. Update Player & Stream Chunks (only when active)
        if cursor_locked {
            let played_step = update_player(@player, @world, dt, cursor_locked)
            if played_step {
                PlaySound(snd_step)
            }
            update_world_chunks(@world, player.pos.x, player.pos.z)
        }

        // Check hotbar switch sound
        if player.active_slot != prev_slot {
            PlaySound(snd_switch)
            prev_slot = player.active_slot
        }

        // 5. Compute Camera and Raycast Target Block
        let cam = get_player_camera(@player)
        let look_dir = vec3_dir_from_angles(player.yaw, player.pitch)
        let ray_hit = cast_voxel_ray(@world, cam.position, look_dir)

        // 6. Block Interaction (Mining & Building)
        if cursor_locked and ray_hit.has_hit {
            // Left Mouse Button: Break targeted block
            if IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
                world_set(@world, ray_hit.hit_x, ray_hit.hit_y, ray_hit.hit_z, BLOCK_AIR)
                PlaySound(snd_break)
            }

            // Right Mouse Button: Place active block
            if IsMouseButtonPressed(MOUSE_BUTTON_RIGHT) {
                let px = ray_hit.place_x
                let py = ray_hit.place_y
                let pz = ray_hit.place_z

                let pl_bx = floor_to_i32(player.pos.x)
                let pl_by = floor_to_i32(player.pos.y)
                let pl_bz = floor_to_i32(player.pos.z)
                let hits_player = (px == pl_bx and pz == pl_bz and (py == pl_by or py == pl_by + 1))

                if py >= 0 and py <= 15 and not hits_player {
                    let block_to_place = get_slot_block(player.active_slot)
                    world_set(@world, px, py, pz, block_to_place)
                    PlaySound(snd_place)
                }
            }
        }

        // 7. Render Scene
        BeginDrawing()
        ClearBackground(sky_col)

        // 3D Pass
        BeginMode3D(cam)

        // Celestial Night Stars
        if sun_sin < 0.15 {
            draw_stars(cam.position)
        }

        // Glowing Sun Sphere
        if sun_pos.y > -2.0 {
            DrawSphere(sun_pos, 4.0, make_color(255, 235, 90, 255))
            DrawCubeWires(sun_pos, 8.2, 8.2, 8.2, make_color(255, 210, 50, 90))
        }

        // Glowing Moon Cube
        if moon_pos.y > -2.0 {
            DrawCube(moon_pos, 4.4, 4.4, 4.4, make_color(225, 235, 255, 255))
            DrawCubeWires(moon_pos, 4.8, 4.8, 4.8, make_color(180, 205, 250, 120))
        }

        // Volumetric Drifting Clouds Layer
        draw_clouds(cam.position.x, cam.position.z, wind_timer, light_mult, sky_col)

        // Voxel World with Dynamic Lighting, River Valleys, and Distance Fog
        draw_world(@world, light_mult, block_tint, sky_col, cam.position.x, cam.position.z, anim_time)

        EndMode3D()

        // 2D HUD Pass
        draw_hud(screen_w, screen_h, @player, @ray_hit, cursor_locked, time_str, time_col)
        EndDrawing()
    }

    // Cleanup
    UnloadSound(snd_break)
    UnloadSound(snd_place)
    UnloadSound(snd_step)
    UnloadSound(snd_switch)
    CloseAudioDevice()
    CloseWindow()
    return 0
}
