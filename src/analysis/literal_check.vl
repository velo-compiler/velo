// Compile-time integer literal constant bounds verification and contextual type adaptation.
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/int_types.vl"
use "symbol_table.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../common/utils.vl"
use "../frontend/token.vl"

// Parses an unsigned 64-bit integer from decimal or hex text, checking for arithmetic overflow.
act parse_u64_checked(s: string, out_overflow: @bool) -> u64 {
    if s == null { return 0 as u64 }
    let len = str.len(s)
    if len == 0 { return 0 as u64 }
    mut i: usize = 0
    mut base: u64 = 10 as u64
    if len >= 2 and s[0] == '0' and (s[1] == 'x' or s[1] == 'X') {
        base = 16 as u64
        i = 2
    }
    mut res: u64 = 0 as u64
    loop i < len {
        let c = s[i]
        mut d: u64 = 0 as u64
        if c >= '0' and c <= '9' {
            d = (c - '0') as u64
        } else if c >= 'a' and c <= 'f' {
            d = ((c - 'a') as u64) + 10 as u64
        } else if c >= 'A' and c <= 'F' {
            d = ((c - 'A') as u64) + 10 as u64
        } else {
            break
        }
        if base == 10 as u64 {
            if res > 1844674407370955161_u64 or (res == 1844674407370955161_u64 and d > 5 as u64) {
                out_overflow.@ = true
                return 0 as u64
            }
        } else {
            if res > 0x0FFFFFFFFFFFFFFF_u64 {
                out_overflow.@ = true
                return 0 as u64
            }
        }
        res = res * base + d
        i += 1
    }
    return res
}

// Infers the static type of an unsuffixed non-negative integer literal using the type ladder:
// fits i32 (<= 2147483647) -> i32; else fits i64 (<= 9223372036854775807) -> i64; else fits u64 (<= 18446744073709551615) -> u64.
act infer_unsuffixed_int_type(expr: @ExprNode) -> string {
    if expr == null { return "i32" }
    mut overflow = false
    mut val_u64: u64 = 0 as u64
    if expr.str_val != null and str.len(expr.str_val) > 0 {
        val_u64 = parse_u64_checked(expr.str_val, @overflow)
    } else {
        if expr.int_val < 0 {
            val_u64 = (0 - expr.int_val) as u64
        } else {
            val_u64 = expr.int_val as u64
        }
    }
    if overflow { return "u64" }
    if val_u64 <= 2147483647_u64 { return "i32" }
    if val_u64 <= 9223372036854775807_u64 { return "i64" }
    return "u64"
}

// Infers the static type of an unsuffixed negated integer literal (-lit) using the type ladder:
// fits i32 (<= 2147483648) -> i32; else fits i64 (<= 9223372036854775808) -> i64; else error.
act infer_unsuffixed_neg_int_type(operand: @ExprNode) -> string {
    if operand == null { return "i32" }
    mut overflow = false
    mut val_u64: u64 = 0 as u64
    if operand.str_val != null and str.len(operand.str_val) > 0 {
        val_u64 = parse_u64_checked(operand.str_val, @overflow)
    } else {
        if operand.int_val < 0 {
            val_u64 = (0 - operand.int_val) as u64
        } else {
            val_u64 = operand.int_val as u64
        }
    }
    if overflow { return "i64" }
    if val_u64 <= 2147483648_u64 { return "i32" }
    if val_u64 <= 9223372036854775808_u64 { return "i64" }
    return "i64"
}

// Checks if an AST expression represents an unsuffixed integer literal.
act is_unsuffixed_int_literal(expr: @ExprNode) -> bool {
    if expr == null { return false }
    if expr.kind == EXPR_INT {
        return expr.type_name == null or str.len(expr.type_name) == 0
    }
    if expr.kind == EXPR_UNARY and expr.op == TOK_MINUS and expr.operand != null and expr.operand.kind == EXPR_INT {
        return expr.operand.type_name == null or str.len(expr.operand.type_name) == 0
    }
    return false
}

// Checks if an integer literal's constant value fits within the target type's range.
act check_int_literal_fits_type(expr: @ExprNode, target_t: string) -> bool {
    if expr == null or target_t == null { return false }
    let is_neg = (expr.kind == EXPR_UNARY and expr.op == TOK_MINUS)
    mut int_node = expr
    if is_neg { int_node = expr.operand }
    if int_node == null or int_node.kind != EXPR_INT { return false }

    if int_node.str_val != null and str.len(int_node.str_val) > 0 and int_node.str_val[0] == '\'' {
        if is_neg { return false }
        let cval = int_node.int_val
        if cval < 0 { return false }
        if target_t == "u8" { return cval <= 255 }
        if target_t == "i8" { return cval <= 127 }
        if target_t == "u16" { return cval <= 65535 }
        if target_t == "i16" { return cval <= 32767 }
        return true
    }

    mut overflow = false
    mut val_u64: u64 = 0 as u64
    if int_node.str_val != null and str.len(int_node.str_val) > 0 {
        val_u64 = parse_u64_checked(int_node.str_val, @overflow)
    } else {
        if int_node.int_val < 0 {
            if is_neg { return false }
            val_u64 = (0 - int_node.int_val) as u64
        } else {
            val_u64 = int_node.int_val as u64
        }
    }
    if overflow { return false }

    if is_neg {
        if is_unsigned_int_type(target_t) { return false }
        if target_t == "i8" { return val_u64 <= 128_u64 }
        if target_t == "i16" { return val_u64 <= 32768_u64 }
        if target_t == "i32" { return val_u64 <= 2147483648_u64 }
        if target_t == "i64" or target_t == "isize" { return val_u64 <= 9223372036854775808_u64 }
        return false
    }

    if target_t == "u8" { return val_u64 <= 255_u64 }
    if target_t == "i8" { return val_u64 <= 127_u64 }
    if target_t == "u16" { return val_u64 <= 65535_u64 }
    if target_t == "i16" { return val_u64 <= 32767_u64 }
    if target_t == "u32" { return val_u64 <= 4294967295_u64 }
    if target_t == "i32" { return val_u64 <= 2147483647_u64 }
    if target_t == "u64" or target_t == "usize" { return true }
    if target_t == "i64" or target_t == "isize" { return val_u64 <= 9223372036854775807_u64 }
    return false
}

// Extracts string representation of an integer literal for diagnostic error reporting.
act get_int_literal_text(expr: @ExprNode) -> string {
    if expr == null { return "0" }
    if expr.kind == EXPR_UNARY and expr.op == TOK_MINUS and expr.operand != null {
        mut sb = create_sb(32)
        sb_append_char(@sb, '-')
        if expr.operand.str_val != null and str.len(expr.operand.str_val) > 0 {
            sb_append_str(@sb, expr.operand.str_val)
        } else {
            sb_append_int(@sb, expr.operand.int_val)
        }
        return sb_to_string(@sb)
    }
    if expr.str_val != null and str.len(expr.str_val) > 0 {
        return expr.str_val
    }
    mut sb = create_sb(16)
    sb_append_int(@sb, expr.int_val)
    return sb_to_string(@sb)
}

// Returns true if expr is a constant expression composed entirely of unsuffixed integer literals and arithmetic operators.
act is_unsuffixed_int_expr(expr: @ExprNode) -> bool {
    if expr == null { return false }
    if is_unsuffixed_int_literal(expr) { return true }
    if expr.kind == EXPR_BINARY {
        if expr.op == TOK_STAR or expr.op == TOK_PLUS or expr.op == TOK_MINUS or expr.op == TOK_SLASH or expr.op == TOK_PERCENT or expr.op == TOK_SHL or expr.op == TOK_SHR {
            return is_unsuffixed_int_expr(expr.left) and is_unsuffixed_int_expr(expr.right)
        }
    }
    return false
}

// Validates that an unsuffixed integer literal fits within target_t and adapts its type_name.
// Reports a compile-time out-of-range diagnostic if the literal overflows target_t.
act try_adapt_int_literal(st: @SymbolTable, target_t: string, expr: @ExprNode, line: i32, col: i32) -> bool {
    if expr == null or target_t == null or st == null { return true }
    if not is_int_type(target_t) { return true }
    if expr.kind == EXPR_BINARY {
        if is_unsuffixed_int_expr(expr) {
            let lok = try_adapt_int_literal(st, target_t, expr.left, line, col)
            let rok = try_adapt_int_literal(st, target_t, expr.right, line, col)
            if lok and rok {
                expr.type_name = target_t
                return true
            }
            return false
        }
        return true
    }
    if not is_unsuffixed_int_literal(expr) { return true }

    if check_int_literal_fits_type(expr, target_t) {
        if expr.kind == EXPR_INT {
            expr.type_name = target_t
        } else if expr.kind == EXPR_UNARY and expr.op == TOK_MINUS and expr.operand != null {
            expr.operand.type_name = target_t
        }
        return true
    }

    let ltext = get_int_literal_text(expr)
    mut sb = create_sb(str.len(ltext) + str.len(target_t) + 64)
    sb_append_str(@sb, "Integer literal '")
    sb_append_str(@sb, ltext)
    sb_append_str(@sb, "' out of range for type '")
    sb_append_str(@sb, target_t)
    sb_append_str(@sb, "'")
    report_error("semantic", line, col, sb_to_string(@sb))
    st.error_count += 1
    return false
}

// Validates and infers a struct literal expression, adapting field integer literals.
act check_struct_literal(st: @SymbolTable, expr: @ExprNode) -> string {
    let st_sym = find_struct(st, expr.type_name)
    if st_sym == null {
        report_error("semantic", expr.line, expr.col, "Instantiating unknown struct type")
        st.error_count += 1
        return "unknown"
    }
    mut cur_init = expr.first_init
    loop cur_init != null {
        let f_sym = find_struct_field(st_sym, cur_init.name)
        if f_sym == null {
            report_error("semantic", cur_init.line, cur_init.col, "Unknown field in struct literal")
            st.error_count += 1
        } else {
            let adapt_ok = try_adapt_int_literal(st, f_sym.type_name, cur_init.value, cur_init.line, cur_init.col)
            let val_type = infer_expr_type(st, cur_init.value)
            if not types_are_compatible(f_sym.type_name, val_type) {
                if not adapt_ok { }
                else if is_int_type(f_sym.type_name) and is_int_type(val_type) {
                    report_error("semantic", cur_init.line, cur_init.col, int_conversion_error_msg(f_sym.type_name, val_type))
                    st.error_count += 1
                } else if is_float_type(f_sym.type_name) and is_float_type(val_type) {
                    report_error("semantic", cur_init.line, cur_init.col, float_conversion_error_msg(f_sym.type_name, val_type))
                    st.error_count += 1
                } else {
                    report_error("semantic", cur_init.line, cur_init.col, "Type mismatch in field initializer")
                    st.error_count += 1
                }
            }
        }
        cur_init = cur_init.next
    }
    mut sf = st_sym.first_field
    loop sf != null {
        mut seen_init = expr.first_init
        mut covered = false
        loop seen_init != null {
            if seen_init.name == sf.name { covered = true }
            seen_init = seen_init.next
        }
        if not covered and not sf.has_default {
            report_error("semantic", expr.line, expr.col, "Struct literal is missing field with no default")
            st.error_count += 1
        }
        sf = sf.next
    }
    return expr.type_name
}

// Adapts unsuffixed integer argument literals and verifies argument type compatibility for function calls.
act adapt_and_check_call_args(st: @SymbolTable, expr: @ExprNode, first_param: @ParamSym) {
    mut cur_a = expr.first_arg
    mut cur_p = first_param
    loop cur_a != null and cur_p != null {
        if cur_a.kind == EXPR_VARIANT and (cur_a.type_name == null or str.len(cur_a.type_name) == 0) {
            cur_a.type_name = cur_p.type_name
        }
        let adapt_ok = try_adapt_int_literal(st, cur_p.type_name, cur_a, cur_a.line, cur_a.col)
        let a_type = infer_expr_type(st, cur_a)
        if not types_are_compatible(cur_p.type_name, a_type) {
            if not adapt_ok { }
            else if is_int_type(cur_p.type_name) and is_int_type(a_type) {
                report_error("semantic", cur_a.line, cur_a.col, int_conversion_error_msg(cur_p.type_name, a_type))
                st.error_count += 1
            } else if is_float_type(cur_p.type_name) and is_float_type(a_type) {
                report_error("semantic", cur_a.line, cur_a.col, float_conversion_error_msg(cur_p.type_name, a_type))
                st.error_count += 1
            }
        }
        cur_a = cur_a.next
        cur_p = cur_p.next
    }
}

// Adapts integer literal operands in binary expressions and resolves the resulting type.
act adapt_binary_int_operands(st: @SymbolTable, expr: @ExprNode, left_t: string, right_t: string) -> string {
    mut lt = left_t
    mut rt = right_t
    if is_int_type(lt) and is_int_type(rt) {
        if is_unsuffixed_int_literal(expr.left) and not is_unsuffixed_int_literal(expr.right) {
            try_adapt_int_literal(st, rt, expr.left, expr.left.line, expr.left.col)
            lt = rt
        } else if is_unsuffixed_int_literal(expr.right) and not is_unsuffixed_int_literal(expr.left) {
            try_adapt_int_literal(st, lt, expr.right, expr.right.line, expr.right.col)
            rt = lt
        }
        if expr.op == TOK_SHL or expr.op == TOK_SHR {
            return lt
        }
        if int_type_width(rt) > int_type_width(lt) {
            return rt
        }
    }
    return lt
}
