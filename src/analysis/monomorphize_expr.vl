// Expression cloning and type inference for AST monomorphization.
use sys.io
use sys.mem
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../common/utils.vl"
use "../common/string_builder.vl"
use "monomorphize_types.vl"

// 5.2 slice 2 ladder families (mono helper — same sets as Stage 1's DYN_INT_TYPES/DYN_FLOAT_TYPES)
act is_mono_dyn_int(name: string) -> bool {
    if name == null { return false }
    if name == "i8" or name == "i16" or name == "i32" or name == "i64" { return true }
    if name == "u8" or name == "u16" or name == "u32" or name == "u64" { return true }
    if name == "usize" or name == "isize" { return true }
    return false
}

act is_mono_dyn_float(name: string) -> bool {
    return name != null and (name == "f32" or name == "f64")
}

// 5.2 slice 9: builds the canonical `ring[T]` spelling.
act mono_ring_spelling(elem: string) -> string {
    return mono_concat("ring[", mono_concat(elem, "]"))
}

// 5.2: builds the canonical `shelf[T]` spelling. Slice 10: the optional heap
// prefix rides in front (`heap shelf[T]`).
act mono_shelf_spelling(heap_pfx: string, elem: string) -> string {
    return mono_concat(heap_pfx, mono_concat("shelf[", mono_concat(elem, "]")))
}

// 5.2: the shared literal-ladder scan (the mono twin of the shelf/ring
// element ladders): homogeneous -> t0; the numeric float mix -> f64; any
// other mix -> the caller's fallback (shelf: "dyn"; ring: t0 — the checker
// rejects the mix upstream).
act mono_lit_elem_scan(e: @ExprNode, scope: @ScopeEntry, fallback: string) -> string {
    let t0 = mono_infer_type(e.first_arg, scope)
    mut is_mixed = false
    mut all_numeric = true
    mut has_float = false
    mut cur = e.first_arg.next
    loop cur != null {
        let t = mono_infer_type(cur, scope)
        if t != t0 { is_mixed = true }
        if is_mono_dyn_int(t) or is_mono_dyn_float(t) {
            if is_mono_dyn_float(t) { has_float = true }
        } else {
            all_numeric = false
        }
        cur = cur.next
    }
    if not is_mixed { return t0 }
    if all_numeric and has_float { return "f64" }
    return fallback
}

act mono_infer_type(e: @ExprNode, scope: @ScopeEntry) -> string {
    if e == null { return "i32" }
    if e.kind == EXPR_INT { return "i32" }
    if e.kind == EXPR_FLOAT { return "f32" }
    if e.kind == EXPR_STRING { return "string" }
    if e.kind == EXPR_BOOL { return "bool" }
    if e.kind == EXPR_STRUCT_LIT { return e.type_name }
    if e.kind == EXPR_VARIANT { return e.type_name }
    if e.kind == EXPR_ADDRESS_OF {
        let sub = mono_infer_type(e.operand, scope)
        return mono_concat("@", sub)
    }
    if e.kind == EXPR_DEREF {
        let sub = mono_infer_type(e.operand, scope)
        if str.len(sub) > 1 and sub[0] == '@' {
            return copy_slice_to_string(sub, 1, str.len(sub) - 1)
        }
        return sub
    }
    if e.kind == EXPR_IDENT {
        mut cur = scope
        loop cur != null {
            if cur.name == e.str_val { return cur.type_name }
            cur = cur.next
        }
    }
    if e.kind == EXPR_SHELF_LIT or e.kind == EXPR_HEAP_SHELF_LIT {
        // 5.2: shelf[T] inference — pinned elem, else the shared ladder scan
        // (the ladder scans ALL args — a heterogeneous literal inside a
        // generic must not infer from the first element). Slice 10: a heap
        // literal's spelling carries the `heap ` prefix.
        mut heap_pfx = ""
        if e.kind == EXPR_HEAP_SHELF_LIT { heap_pfx = "heap " }
        if e.type_name != null and str.len(e.type_name) > 0 { return mono_shelf_spelling(heap_pfx, e.type_name) }
        if e.first_arg != null { return mono_shelf_spelling(heap_pfx, mono_lit_elem_scan(e, scope, "dyn")) }
        return "i32"  // unannotated empty: the checker rejects it upstream
    }
    if e.kind == EXPR_RING_LIT {
        // 5.2 slice 9: best-effort ring ladder (no dyn arm — non-widenable mixes are checker-rejected corners)
        if e.type_name != null and str.len(e.type_name) > 0 { return mono_ring_spelling(e.type_name) }
        if e.first_arg != null {
            let t0 = mono_infer_type(e.first_arg, scope)
            return mono_ring_spelling(mono_lit_elem_scan(e, scope, t0))
        }
        return "i32"  // unannotated empty: the checker rejects it upstream
    }
    if e.kind == EXPR_BITSET_LIT { return "bitset" }
    if e.kind == EXPR_MAP_LIT {
        // 5.2 slice 6: best-effort Map[K, V] inference (generic T unification needs the
        // type; the strict key/value ladders ran in the checker). Pinned literals return
        // their full spelling as-is, like Stage 1.
        if e.type_name != null and str.len(e.type_name) > 0 { return e.type_name }
        if e.first_arg == null or e.first_arg.next == null { return "i32" }
        let k0 = mono_infer_type(e.first_arg, scope)
        let vk0 = mono_infer_type(e.first_arg.next, scope)
        mut keys_uniform = true
        mut vals_uniform = true
        mut all_numeric = true
        mut has_float = false
        mut cur = e.first_arg.next.next
        mut expect_key = true
        loop cur != null {
            let t = mono_infer_type(cur, scope)
            if expect_key {
                if t != k0 { keys_uniform = false }
            } else {
                if t != vk0 { vals_uniform = false }
                if is_mono_dyn_int(t) or is_mono_dyn_float(t) {
                    if is_mono_dyn_float(t) { has_float = true }
                } else {
                    all_numeric = false
                }
            }
            expect_key = not expect_key
            cur = cur.next
        }
        if not keys_uniform { return mono_map_spelling("dyn", "dyn") }  // checker rejects
        if vals_uniform { return mono_map_spelling(k0, vk0) }
        if all_numeric and has_float { return mono_map_spelling(k0, "f64") }
        return mono_map_spelling(k0, "dyn")
    }
    if e.kind == EXPR_INDEX {
        // 5.2: shelf element reads type as their element
        let tt = mono_infer_type(e.target, scope)
        let ee = mono_shelf_elem(tt)
        if ee != null { return ee }
        // 5.2 slice 6: map value reads type as the value slot
        let mv = mono_map_value(tt)
        if mv != null { return mv }
        return "i32"
    }
    if e.kind == EXPR_MEMBER {
        // 5.2: shelf .len is usize; other reads fall through to "i32"
        let tt = mono_infer_type(e.target, scope)
        if mono_shelf_elem(tt) != null and e.member_name == "len" { return "usize" }
        // 5.2 slice 6: map .len is usize; others fall through
        if mono_map_value(tt) != null and e.member_name == "len" { return "usize" }
    }
    if e.kind == EXPR_CALL {
        // 5.2: shelf receiver calls — put/insert yield void, take/remove_at
        // the element, sorted() a new shelf[elem]
        if e.callee != null and e.callee.kind == EXPR_MEMBER {
            let rt = mono_infer_type(e.callee.target, scope)
            let ee = mono_shelf_elem(rt)
            if ee != null {
                if e.callee.member_name == "put" or e.callee.member_name == "insert" { return "void" }
                if e.callee.member_name == "take" or e.callee.member_name == "remove_at" { return ee }
                if e.callee.member_name == "sorted" {
                    mut sb = create_sb(str.len(ee) + 9)
                    sb_append_str(@sb, "shelf[")
                    sb_append_str(@sb, ee)
                    sb_append_str(@sb, "]")
                    return sb_to_string(@sb)
                }
            }
            // 5.2 slice 6/7: map receiver calls — put void / get, get_or,
            // take value / has bool
            let mv = mono_map_value(rt)
            if mv != null {
                if e.callee.member_name == "put" { return "void" }; if e.callee.member_name == "has" { return "bool" }
                if e.callee.member_name == "get" or e.callee.member_name == "get_or" or e.callee.member_name == "take" { return mv }
            }
        }
        if e.callee != null and e.callee.kind == EXPR_IDENT {
            if e.callee.str_val == "f32x4" or e.callee.str_val == "f32x4_splat" { return "f32x4" }
            if e.callee.str_val == "i32x4" or e.callee.str_val == "i32x4_splat" { return "i32x4" }
        }
    }
    return "i32"
}

act mono_extract_type_arg(t: string) -> string {
    if t == null { return "i32" }
    mut clean = t
    if str.len(clean) > 0 and clean[0] == '@' {
        clean = copy_slice_to_string(clean, 1, str.len(clean) - 1)
    }
    let bracket = mono_find_char(clean, '[')
    if bracket >= 0 {
        let rbracket = mono_find_char(clean, ']')
        if rbracket > bracket {
            return copy_slice_to_string(clean, (bracket + 1) as usize, (rbracket - bracket - 1) as usize)
        }
    }
    let under = mono_find_char(clean, '_')
    if under >= 0 {
        return copy_slice_to_string(clean, (under + 1) as usize, str.len(clean) - (under as usize) - 1)
    }
    return clean
}

act mono_clone_expr(m: @Monomorphizer, e: @ExprNode, scope: @ScopeEntry, params: string, args: string) -> @ExprNode {
    if e == null { return null }
    if e.kind == EXPR_INT {
        mut node = make_int_expr(e.int_val, e.line, e.col); node.str_val = e.str_val; node.type_name = e.type_name; return node
    }
    if e.kind == EXPR_FLOAT {
        mut node = make_float_expr(e.float_val, e.line, e.col); node.str_val = e.str_val; node.type_name = e.type_name; return node
    }
    if e.kind == EXPR_STRING { return make_string_expr(e.str_val, e.line, e.col) }
    if e.kind == EXPR_BOOL { return make_bool_expr(e.bool_val, e.line, e.col) }
    if e.kind == EXPR_NULL { return make_null_expr(e.line, e.col) }
    if e.kind == EXPR_IDENT { return make_ident_expr(e.str_val, e.line, e.col) }

    if e.kind == EXPR_BINARY {
        let l = mono_clone_expr(m, e.left, scope, params, args)
        let r = mono_clone_expr(m, e.right, scope, params, args)
        return make_binary_expr(l, e.op, r, e.line, e.col)
    }
    if e.kind == EXPR_UNARY {
        let sub = mono_clone_expr(m, e.operand, scope, params, args)
        return make_unary_expr(e.op, sub, e.line, e.col)
    }
    if e.kind == EXPR_ADDRESS_OF {
        let sub = mono_clone_expr(m, e.operand, scope, params, args)
        return make_address_of_expr(sub, e.line, e.col)
    }
    if e.kind == EXPR_DEREF {
        let sub = mono_clone_expr(m, e.operand, scope, params, args)
        return make_deref_expr(sub, e.line, e.col)
    }
    if e.kind == EXPR_MEMBER {
        let sub = mono_clone_expr(m, e.target, scope, params, args)
        return make_member_expr(sub, e.member_name, e.line, e.col)
    }
    if e.kind == EXPR_INDEX {
        let sub = mono_clone_expr(m, e.target, scope, params, args)
        let idx = mono_clone_expr(m, e.index, scope, params, args)
        return make_index_expr(sub, idx, e.line, e.col)
    }
    if e.kind == EXPR_CAST {
        let sub = mono_clone_expr(m, e.operand, scope, params, args)
        mut tt = mono_subst(e.type_name, params, args)
        mono_check_type(m, tt)
        tt = mono_normalize_type(tt)
        return make_cast_expr(sub, tt, e.line, e.col)
    }
    if e.kind == EXPR_STRUCT_LIT {
        mut stype = mono_subst(e.type_name, params, args)
        mono_check_type(m, stype)
        stype = mono_normalize_type(stype)
        mut cur = e.first_init
        mut first_fi: @FieldInit = null
        mut last_fi: @FieldInit = null
        loop cur != null {
            let fval = mono_clone_expr(m, cur.value, scope, params, args)
            mut fi: @FieldInit = mem.alloc(@FieldInit, 1)
            fi.name = cur.name
            fi.value = fval
            fi.line = cur.line
            fi.col = cur.col
            fi.next = null
            if first_fi == null { first_fi = fi; last_fi = fi }
            else { last_fi.next = fi; last_fi = fi }
            cur = cur.next
        }
        return make_struct_lit_expr(stype, first_fi, e.line, e.col)
    }
    if e.kind == EXPR_VARIANT {
        mut kname = mono_subst(e.type_name, params, args)
        if kname != null {
            mono_check_type(m, kname)
            kname = mono_normalize_type(kname)
        }
        mut cur = e.first_arg
        mut first_a: @ExprNode = null
        mut last_a: @ExprNode = null
        loop cur != null {
            let a = mono_clone_expr(m, cur, scope, params, args)
            if first_a == null { first_a = a; last_a = a }
            else { last_a.next = a; last_a = a }
            cur = cur.next
        }
        return make_variant_expr(kname, e.member_name, first_a, e.arg_count, e.line, e.col)
    }
    if e.kind == EXPR_SHELF_LIT or e.kind == EXPR_HEAP_SHELF_LIT {
        // 5.2: clone the bracket-arg chain; pinned elems ride type_name.
        // Slice 10: the heap kind distinguishes the storage modifier.
        mut first_a: @ExprNode = null
        mut last_a: @ExprNode = null
        mut cur = e.first_arg
        loop cur != null {
            let a = mono_clone_expr(m, cur, scope, params, args)
            if first_a == null { first_a = a; last_a = a }
            else { last_a.next = a; last_a = a }
            cur = cur.next
        }
        let lit = make_shelf_lit_expr(first_a, e.arg_count, e.type_name, e.line, e.col)
        if e.kind == EXPR_HEAP_SHELF_LIT { lit.kind = EXPR_HEAP_SHELF_LIT }
        return lit
    }
    if e.kind == EXPR_MAP_LIT {
        // 5.2 slice 6: clone the K,V alternating chain; the pinned spelling
        // rides type_name exactly like Stage 1's kv_type carry
        mut first_a: @ExprNode = null
        mut last_a: @ExprNode = null
        mut cur = e.first_arg
        loop cur != null {
            let a = mono_clone_expr(m, cur, scope, params, args)
            if first_a == null { first_a = a; last_a = a }
            else { last_a.next = a; last_a = a }
            cur = cur.next
        }
        let lit = make_map_lit_expr(first_a, e.arg_count / 2, e.line, e.col)
        lit.type_name = e.type_name
        return lit
    }
    if e.kind == EXPR_RING_LIT or e.kind == EXPR_BITSET_LIT {
        // 5.2 slice 9: clone the bracket-arg chain; a pinned ring elem rides type_name
        mut first_a: @ExprNode = null
        mut last_a: @ExprNode = null
        mut cur = e.first_arg
        loop cur != null {
            let a = mono_clone_expr(m, cur, scope, params, args)
            if first_a == null { first_a = a; last_a = a }
            else { last_a.next = a; last_a = a }
            cur = cur.next
        }
        if e.kind == EXPR_RING_LIT {
            let lit = make_ring_lit_expr(first_a, e.arg_count, e.line, e.col)
            lit.type_name = e.type_name   // the pinned elem rides like Stage 1
            return lit
        }
        return make_bitset_lit_expr(first_a, e.arg_count, e.line, e.col)
    }
    if e.kind == EXPR_CALL {
        mut arg_count = e.arg_count
        mut first_a: @ExprNode = null
        mut last_a: @ExprNode = null
        mut cur = e.first_arg
        loop cur != null {
            let a = mono_clone_expr(m, cur, scope, params, args)
            if first_a == null { first_a = a; last_a = a }
            else { last_a.next = a; last_a = a }
            cur = cur.next
        }
        mut callee = mono_clone_expr(m, e.callee, scope, params, args)
        if callee != null and callee.kind == EXPR_MEMBER {
            let fn_tmpl = mono_find_template(m, callee.member_name)
            if fn_tmpl != null and fn_tmpl.kind == DECL_FUNCTION {
                mut recv = callee.target
                let t_type = mono_infer_type(recv, scope)
                let p0_type = fn_tmpl.node.first_param.type_name
                let is_p0_ptr = p0_type != null and str.len(p0_type) > 0 and p0_type[0] == '@'
                let is_tgt_ptr = t_type != null and str.len(t_type) > 0 and t_type[0] == '@'
                if is_p0_ptr and not is_tgt_ptr {
                    recv = make_address_of_expr(recv, recv.line, recv.col)
                }
                recv.next = first_a
                first_a = recv
                arg_count += 1
                callee = make_ident_expr(callee.member_name, callee.line, callee.col)
            }
        }
        if callee != null and callee.kind == EXPR_IDENT {
            let fn_tmpl = mono_find_template(m, callee.str_val)
            if fn_tmpl != null and fn_tmpl.kind == DECL_FUNCTION {
                mut call_targs = e.type_name
                if call_targs != null and str.len(call_targs) > 0 {
                    call_targs = mono_subst(call_targs, params, args)
                } else if first_a != null {
                    let a_type = mono_infer_type(first_a, scope)
                    call_targs = mono_extract_type_arg(a_type)
                }
                if call_targs != null {
                    let mangled = mono_concat(callee.str_val, mono_concat("_", mono_mangle_type(call_targs)))
                    mono_request(m, DECL_FUNCTION, callee.str_val, call_targs, mangled)
                    callee.str_val = mangled
                }
            }
        }
        let call_res = make_call_expr(callee, first_a, arg_count, e.line, e.col)
        return call_res
    }
    return e
}
