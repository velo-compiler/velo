// Privacy access verification algorithms and module export enforcement for Velo.
use "../common/utils.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "symbol_table.vl"
use "literal_check.vl"

// Returns the basename of a file path (e.g. "path/to/mod.vl" -> "mod.vl").
act privacy_path_basename(p: string) -> string {
    if p == null { return "" }
    let plen = str.len(p)
    mut idx = plen
    loop idx > 0 {
        idx -= 1
        if p[idx] == '/' or p[idx] == '\\' {
            let start = idx + 1
            let blen = plen - start
            return copy_slice_to_string(p, start, blen)
        }
    }
    return p
}

// Returns true if path1 and path2 refer to the same file or module.
act match_file_path(p1: string, p2: string) -> bool {
    if p1 == null or p2 == null { return false }
    if p1 == p2 { return true }
    let b1 = privacy_path_basename(p1)
    let b2 = privacy_path_basename(p2)
    return b1 == b2
}

// Finds the import declaration in importer_file that imported target_file.
act find_file_import(st: @SymbolTable, importer: string, target_file: string) -> @StmtNode {
    if st == null or importer == null or target_file == null { return null }
    mut cur = st.first_use
    loop cur != null {
        if match_file_path(cur.file_path, importer) {
            if cur.resolved_path != null and match_file_path(cur.resolved_path, target_file) {
                return cur
            }
            if cur.module_path != null and match_file_path(cur.module_path, target_file) {
                return cur
            }
        }
        cur = cur.next_use
    }
    return null
}

// Finds an active module alias in importer_file.
act find_module_alias(st: @SymbolTable, importer: string, alias: string) -> @StmtNode {
    if st == null or importer == null or alias == null { return null }
    mut cur = st.first_use
    loop cur != null {
        if match_file_path(cur.file_path, importer) {
            if cur.use_alias != null and cur.use_alias == alias {
                return cur
            }
        }
        cur = cur.next_use
    }
    return null
}

// Resolves a potentially renamed imported symbol name back to its original declaration name.
act resolve_import_rename(st: @SymbolTable, importer: string, local_name: string) -> string {
    if st == null or importer == null or local_name == null { return local_name }
    mut cur = st.first_use
    loop cur != null {
        if match_file_path(cur.file_path, importer) and cur.first_import != null {
            mut item = cur.first_import
            loop item != null {
                if item.local_name == local_name {
                    return item.orig_name
                }
                item = item.next
            }
        }
        cur = cur.next_use
    }
    return local_name
}

// Normalizes a type name (e.g. "Coord" -> "Point", "@Coord" -> "@Point") using active import renames.
act normalize_type_rename(st: @SymbolTable, file: string, type_name: string) -> string {
    if st == null or file == null or type_name == null or str.len(type_name) == 0 { return type_name }
    let clean = strip_pointer_prefix(type_name)
    let ren = resolve_import_rename(st, file, clean)
    if ren == clean { return type_name }
    if type_name[0] == '@' { return prepend_pointer_prefix(ren) }
    return ren
}

// Returns true if sym_name is imported into the importing file under access_name.
act is_in_import_list(first_item: @ImportItem, sym_name: string, access_name: string) -> bool {
    mut item = first_item
    loop item != null {
        if item.local_name == access_name and item.orig_name == sym_name {
            return true
        }
        item = item.next
    }
    return false
}

// Finds a function declared in the module targeted by mod_use.
act find_function_in_module(st: @SymbolTable, mod_use: @StmtNode, name: string) -> @FunctionSym {
    if st == null or mod_use == null or name == null { return null }
    mut cur = st.first_function
    loop cur != null {
        if cur.name == name {
            if mod_use.resolved_path != null and match_file_path(cur.file_path, mod_use.resolved_path) {
                return cur
            }
            if mod_use.module_path != null and match_file_path(cur.file_path, mod_use.module_path) {
                return cur
            }
        }
        cur = cur.next
    }
    return null
}

// Finds a struct declared in the module targeted by mod_use.
act find_struct_in_module(st: @SymbolTable, mod_use: @StmtNode, name: string) -> @StructSym {
    if st == null or mod_use == null or name == null { return null }
    mut cur = st.first_struct
    loop cur != null {
        if cur.name == name {
            if mod_use.resolved_path != null and match_file_path(cur.file_path, mod_use.resolved_path) {
                return cur
            }
            if mod_use.module_path != null and match_file_path(cur.file_path, mod_use.module_path) {
                return cur
            }
        }
        cur = cur.next
    }
    return null
}

// Finds a global variable declared in the module targeted by mod_use.
act find_global_in_module(st: @SymbolTable, mod_use: @StmtNode, name: string) -> @Symbol {
    if st == null or mod_use == null or name == null or st.global_scope == null { return null }
    mut cur = st.global_scope.first_sym
    loop cur != null {
        if cur.name == name {
            if mod_use.resolved_path != null and match_file_path(cur.file_path, mod_use.resolved_path) {
                return cur
            }
            if mod_use.module_path != null and match_file_path(cur.file_path, mod_use.module_path) {
                return cur
            }
        }
        cur = cur.next
    }
    return null
}

// Finds a global variable accessed via a module alias.
act find_aliased_global(st: @SymbolTable, alias: string, name: string, line: i32, col: i32) -> @Symbol {
    let mod_use = find_module_alias(st, st.current_file, alias)
    if mod_use == null { return null }
    let g_sym = find_global_in_module(st, mod_use, name)
    if g_sym != null and not g_sym.is_view {
        let sym_base = privacy_path_basename(g_sym.file_path)
        let cur_base = privacy_path_basename(st.current_file)
        mut sb = create_sb(128)
        sb_append_char(@sb, '\'')
        sb_append_str(@sb, g_sym.name)
        sb_append_str(@sb, "' is private to '")
        sb_append_str(@sb, sym_base)
        sb_append_str(@sb, "' and cannot be accessed from '")
        sb_append_str(@sb, cur_base)
        sb_append_char(@sb, '\'')
        report_error("semantic", line, col, sb_to_string(@sb))
        st.error_count += 1
        return null
    }
    return g_sym
}

// Returns true if expr.callee is a module alias call `alias.func(...)`.
act is_module_alias_call(st: @SymbolTable, expr: @ExprNode) -> bool {
    if expr == null or expr.callee == null or expr.callee.kind != EXPR_MEMBER { return false }
    if expr.callee.target == null or expr.callee.target.kind != EXPR_IDENT { return false }
    return find_module_alias(st, st.current_file, expr.callee.target.str_val) != null
}

// Type checks a qualified module alias call `alias.func(...)`.
act check_aliased_member_call(st: @SymbolTable, expr: @ExprNode) -> string {
    let mod_use = find_module_alias(st, st.current_file, expr.callee.target.str_val)
    if mod_use == null { return "unknown" }
    let fn_sym = find_function_in_module(st, mod_use, expr.callee.member_name)
    if fn_sym == null {
        mut sb = create_sb(128)
        sb_append_str(@sb, "Function '")
        sb_append_str(@sb, expr.callee.member_name)
        sb_append_str(@sb, "' not found in module '")
        sb_append_str(@sb, expr.callee.target.str_val)
        sb_append_char(@sb, '\'')
        report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
        st.error_count += 1
        return "void"
    }
    if not fn_sym.is_view {
        let sym_base = privacy_path_basename(fn_sym.file_path)
        let cur_base = privacy_path_basename(st.current_file)
        mut sb = create_sb(128)
        sb_append_char(@sb, '\'')
        sb_append_str(@sb, fn_sym.name)
        sb_append_str(@sb, "' is private to '")
        sb_append_str(@sb, sym_base)
        sb_append_str(@sb, "' and cannot be accessed from '")
        sb_append_str(@sb, cur_base)
        sb_append_char(@sb, '\'')
        report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
        st.error_count += 1
        return "void"
    }
    if expr.arg_count != fn_sym.param_count {
        mut sb = create_sb(96)
        sb_append_str(@sb, "Mismatched argument count in call to '")
        sb_append_str(@sb, expr.callee.member_name)
        sb_append_char(@sb, '\'')
        report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
        st.error_count += 1
    }
    adapt_and_check_call_args(st, expr, fn_sym.first_param)
    return fn_sym.return_type
}

// Returns true if the file path is within the compiler's self-hosted source tree.
act is_compiler_file(f: string) -> bool {
    if f == null { return false }
    let flen = str.len(f)
    if flen >= 4 and ((f[0] == 's' and f[1] == 'r' and f[2] == 'c' and (f[3] == '/' or f[3] == '\\')) or
                      (f[0] == '.' and f[1] == '/' and f[2] == 's' and f[3] == 'r' and f[4] == 'c') or
                      (f[0] == '.' and f[1] == '\\' and f[2] == 's' and f[3] == 'r' and f[4] == 'c')) {
        return true
    }
    // Also check for normalized Windows path containing "/src/" or "\src\"
    mut i: usize = 0
    loop i + 4 < flen {
        if (f[i] == '/' or f[i] == '\\') and f[i+1] == 's' and f[i+2] == 'r' and f[i+3] == 'c' and (f[i+4] == '/' or f[i+4] == '\\') {
            return true
        }
        i += 1
    }
    return false
}

// Checks if declaration access across files violates module privacy or import scoping.
// Unmarked declarations are private to the file where they are declared.
// Declarations marked 'view' are exported to importing modules.
act check_decl_privacy(st: @SymbolTable, name: string, access_name: string, is_view: bool, file_path: string, line: i32, col: i32) -> bool {
    // Privacy is verified during semantic analysis; codegen expression lowering is exempt
    if st.is_codegen { return true }

    // If either file path is null or empty, access is permitted (builtins / repl / single unit)
    if file_path == null or str.len(file_path) == 0 { return true }
    if st.current_file == null or str.len(st.current_file) == 0 { return true }

    // Same file access is always permitted
    if file_path == st.current_file { return true }

    // Compiler internals across src/ files share the compiler compilation unit
    if is_compiler_file(st.current_file) and is_compiler_file(file_path) { return true }

    // Check 1: Private declaration access across files
    if not is_view {
        let sym_base = privacy_path_basename(file_path)
        let cur_base = privacy_path_basename(st.current_file)

        mut sb = create_sb(128)
        sb_append_char(@sb, '\'')
        sb_append_str(@sb, name)
        sb_append_str(@sb, "' is private to '")
        sb_append_str(@sb, sym_base)
        sb_append_str(@sb, "' and cannot be accessed from '")
        sb_append_str(@sb, cur_base)
        sb_append_char(@sb, '\'')

        report_error("semantic", line, col, sb_to_string(@sb))
        st.error_count += 1
        return false
    }

    // Check 2: Import aliasing and selective imports
    let import_decl = find_file_import(st, st.current_file, file_path)
    if import_decl != null {
        // If the module was imported with an alias (`use "..." :> alias`), bare access is blocked
        if import_decl.use_alias != null and str.len(import_decl.use_alias) > 0 {
            let sym_base = privacy_path_basename(file_path)
            let cur_base = privacy_path_basename(st.current_file)

            mut sb = create_sb(128)
            sb_append_char(@sb, '\'')
            sb_append_str(@sb, name)
            sb_append_str(@sb, "' is not imported into '")
            sb_append_str(@sb, cur_base)
            sb_append_str(@sb, "' (module '")
            sb_append_str(@sb, sym_base)
            sb_append_str(@sb, "' is imported under alias '")
            sb_append_str(@sb, import_decl.use_alias)
            sb_append_str(@sb, "'; use '")
            sb_append_str(@sb, import_decl.use_alias)
            sb_append_char(@sb, '.')
            sb_append_str(@sb, name)
            sb_append_str(@sb, "')")

            report_error("semantic", line, col, sb_to_string(@sb))
            st.error_count += 1
            return false
        }
        // If the module was imported selectively (`use "..." :> { ... }`), verify name is in the list
        if import_decl.first_import != null {
            mut eff_access = access_name
            if eff_access == null or str.len(eff_access) == 0 { eff_access = name }
            if not is_in_import_list(import_decl.first_import, name, eff_access) {
                let sym_base = privacy_path_basename(file_path)
                let cur_base = privacy_path_basename(st.current_file)

                mut sb = create_sb(128)
                sb_append_char(@sb, '\'')
                sb_append_str(@sb, eff_access)
                sb_append_str(@sb, "' is not imported from '")
                sb_append_str(@sb, sym_base)
                sb_append_str(@sb, "' into '")
                sb_append_str(@sb, cur_base)
                sb_append_char(@sb, '\'')

                report_error("semantic", line, col, sb_to_string(@sb))
                st.error_count += 1
                return false
            }
        }
    }

    return true
}

// Checks privacy for a resolved function symbol.
act check_fn_privacy(st: @SymbolTable, fn_sym: @FunctionSym, access_name: string, line: i32, col: i32) -> bool {
    if fn_sym == null { return true }
    return check_decl_privacy(st, fn_sym.name, access_name, fn_sym.is_view, fn_sym.file_path, line, col)
}

// Checks privacy for a resolved struct symbol.
act check_struct_privacy(st: @SymbolTable, st_sym: @StructSym, access_name: string, line: i32, col: i32) -> bool {
    if st_sym == null { return true }
    return check_decl_privacy(st, st_sym.name, access_name, st_sym.is_view, st_sym.file_path, line, col)
}

// Checks privacy for a resolved kind symbol.
act check_kind_privacy(st: @SymbolTable, k_sym: @KindSym, access_name: string, line: i32, col: i32) -> bool {
    if k_sym == null { return true }
    return check_decl_privacy(st, k_sym.name, access_name, k_sym.is_view, k_sym.file_path, line, col)
}

// Checks privacy for a resolved pact contract symbol.
act check_pact_privacy(st: @SymbolTable, p_sym: @PactSym, access_name: string, line: i32, col: i32) -> bool {
    if p_sym == null { return true }
    return check_decl_privacy(st, p_sym.name, access_name, p_sym.is_view, p_sym.file_path, line, col)
}

// Checks privacy for a resolved global variable symbol.
act check_global_privacy(st: @SymbolTable, sym: @Symbol, access_name: string, line: i32, col: i32) -> bool {
    if sym == null or sym.kind != SYM_GLOBAL { return true }
    return check_decl_privacy(st, sym.name, access_name, sym.is_view, sym.file_path, line, col)
}

// Checks privacy when a type name (struct or kind) is referenced in code.
act check_type_privacy(st: @SymbolTable, type_name: string, line: i32, col: i32) -> bool {
    if type_name == null or str.len(type_name) == 0 { return true }
    let clean = strip_pointer_prefix(type_name)
    let resolved = resolve_import_rename(st, st.current_file, clean)
    let st_sym = find_struct(st, resolved)
    if st_sym != null { return check_struct_privacy(st, st_sym, clean, line, col) }
    let k_sym = find_kind(st, resolved)
    if k_sym != null { return check_kind_privacy(st, k_sym, clean, line, col) }
    return true
}
