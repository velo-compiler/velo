// ============================================================================
// 5.2 slice 6 — Map[K, V] core: compile-time surface checks.
//
// Mutual mirror of velo/codegen_c.py's map support (is_map_type / _map_kv /
// _map_family_error / _infer_map_literal_type / _check_map_annotation /
// _map_expect): both compiler stages reject the same programs with the same
// words. Reporting acts bump st.error_count and return "unknown" (or null
// for type extractors) so infer branches forward the failure silently.
// ============================================================================
use "type_checker.vl"
use "symbol_table.vl"
use "dyn_checks.vl"
use "shelf_checks.vl"
use "misc_checks.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../common/utils.vl"
use "../ast/expr.vl"
use "../ast/types.vl"
use "../frontend/token.vl"

// True for `Map[K, V]` (or `@Map[K, V]`). Bare `Map` reads false here — the
// parser rejects that spelling itself with the identical wording on both
// stages (`a bare 'Map' needs key and value types: use Map[K, V]`).
// Task 7.2: true when the spelling carries the heap map modifier
act starts_with_heap_map(t: string) -> bool {
    if t == null { return false }
    let len = str.len(t)
    if len < 9 { return false }
    return t[0] == 'h' and t[1] == 'e' and t[2] == 'a' and t[3] == 'p' and t[4] == ' ' and (t[5] == 'M' or t[5] == 'm') and t[6] == 'a' and t[7] == 'p' and t[8] == '['
}

// True for `Map[K, V]` (or `@Map[K, V]`, `heap Map[K, V]`). Bare `Map` reads false here.
act is_map_type(type_name: string) -> bool {
    if type_name == null { return false }
    mut clean = strip_pointer_prefix(type_name)
    if starts_with_heap_map(clean) { clean = copy_slice_to_string(clean, 5, str.len(clean) - 5) }
    let len = str.len(clean)
    if len < 6 { return false }
    if (clean[0] == 'M' or clean[0] == 'm') and clean[1] == 'a' and clean[2] == 'p' and clean[3] == '[' { return clean[len - 1] == ']' }
    return false
}

// Finds the top-level comma inside `Map[K, V]` (scan starts past `Map[`);
// returns len when none.
act map_comma_pos(clean: string, len: usize) -> usize {
    mut depth: usize = 0
    mut i: usize = 4
    loop i < len - 1 {
        if clean[i] == '[' { depth += 1 } else if clean[i] == ']' and depth > 0 { depth -= 1 } else if clean[i] == ',' and depth == 0 { return i }
        i += 1
    }
    return len
}

// True when the spelling splits into two non-empty slots.
act map_has_slots(type_name: string) -> bool {
    if not is_map_type(type_name) { return false }
    mut clean = strip_pointer_prefix(type_name)
    if starts_with_heap_map(clean) { clean = copy_slice_to_string(clean, 5, str.len(clean) - 5) }
    let len = str.len(clean)
    let comma = map_comma_pos(clean, len)
    return comma < len - 1 and comma - 4 != 0 and (len - 1) - (comma + 1) != 0
}

// Extracts the key type from `Map[K, V]` / `@Map[K, V]` / `heap Map[K, V]`.
act map_key_type(type_name: string) -> string {
    if type_name == null { return null }
    mut clean = strip_pointer_prefix(type_name)
    if starts_with_heap_map(clean) { clean = copy_slice_to_string(clean, 5, str.len(clean) - 5) }
    let len = str.len(clean)
    if len < 9 or (clean[0] != 'M' and clean[0] != 'm') or clean[1] != 'a' or clean[2] != 'p' or clean[3] != '[' or clean[len - 1] != ']' { return null }
    let comma = map_comma_pos(clean, len)
    if comma >= len - 1 or comma - 4 == 0 or (len - 1) - (comma + 1) == 0 { return null }
    mut kstart: usize = 4; loop kstart < comma and clean[kstart] == ' ' { kstart += 1 }
    mut kstop: usize = comma; loop kstop > kstart and clean[kstop - 1] == ' ' { kstop -= 1 }
    if kstop == kstart { return null }
    return copy_slice_to_string(clean, kstart, kstop - kstart)
}

// Extracts the value type (mirror of the key scan).
act map_value_type(type_name: string) -> string {
    if type_name == null { return null }
    mut clean = strip_pointer_prefix(type_name)
    if starts_with_heap_map(clean) { clean = copy_slice_to_string(clean, 5, str.len(clean) - 5) }
    let len = str.len(clean)
    if len < 9 or (clean[0] != 'M' and clean[0] != 'm') or clean[1] != 'a' or clean[2] != 'p' or clean[3] != '[' or clean[len - 1] != ']' { return null }
    let comma = map_comma_pos(clean, len)
    if comma >= len - 1 or comma - 4 == 0 or (len - 1) - (comma + 1) == 0 { return null }
    mut vstart: usize = comma + 1; loop vstart < len - 1 and clean[vstart] == ' ' { vstart += 1 }
    mut vstop: usize = len - 1; loop vstop > vstart and clean[vstop - 1] == ' ' { vstop -= 1 }
    if vstop == vstart { return null }
    return copy_slice_to_string(clean, vstart, vstop - vstart)
}

// Message joiners (string_builder grows as needed; exact sizing is a hint).
act map_join3(a: string, b: string, c: string) -> string { return map_join5(a, b, c, "", "") }
act map_join5(a: string, b: string, c: string, d: string, e: string) -> string {
    mut sb = create_sb(str.len(a) + str.len(b) + str.len(c) + str.len(d) + str.len(e) + 2)
    sb_append_str(@sb, a); sb_append_str(@sb, b); sb_append_str(@sb, c); sb_append_str(@sb, d); sb_append_str(@sb, e)
    return sb_to_string(@sb)
}

// The pinned key families: 10 integer widths + bool + string.
act is_map_key_family(name: string) -> bool {
    if name == null { return false }
    if name == "i8" or name == "i16" or name == "i32" or name == "i64" { return true }
    if name == "u8" or name == "u16" or name == "u32" or name == "u64" { return true }
    if name == "usize" or name == "isize" or name == "bool" or name == "string" { return true }
    return false
}

// The uniform key-family reject (one wording for every offender).
act map_key_family_error_text(key: string) -> string {
    return map_join3("map keys must be integer, bool, or string (got ", key, ")")
}

// Catch-all key family gate.
act map_checked_key(st: @SymbolTable, key: string, line: i32, col: i32) -> string {
    if key == null { return null }
    if is_map_key_family(key) { return key }
    report_error("semantic", line, col, map_key_family_error_text(key)); st.error_count += 1
    return null
}

// Uniform report+memo fail.
act map_fail(st: @SymbolTable, node: @ExprNode, line: i32, col: i32, msg: string) -> string {
    if msg != null and str.len(msg) > 0 { report_error("semantic", line, col, msg); st.error_count += 1 }
    if node != null { node.type_name = "unknown"; node.bool_val = true }
    return "unknown"
}

// Mut doctrine: put / index-write require a mut root binding.
act check_map_mut_binding(st: @SymbolTable, receiver: @ExprNode, verb: string, word: string) {
    if receiver == null { return }
    let root = shelf_root_binding_name(receiver)
    if root != null {
        let sym = resolve_variable(st, root)
        if sym != null and not sym.is_mut {
            report_error("semantic", receiver.line, receiver.col, map_join5("cannot ", verb, " ", word, " a map held by a let (declare with mut)")); st.error_count += 1
        }
    }
}

// Literal checker: walks the K,V,K,V… pair chain into one `Map[K, V]`
// spelling, memoized like the shelf literal (bool_val + type_name). Stage-1
// inference order: ALL keys uniform-check before the value ladder; values
// mirror the shelf element ladder exactly (widen / strict differ / dyn).
act map_literal_kv(st: @SymbolTable, expr: @ExprNode) -> string {
    if expr.bool_val { return expr.type_name }
    if expr.arg_count == 0 {
        if expr.type_name != null and str.len(expr.type_name) > 0 { expr.bool_val = true; return expr.type_name }
        if expr.kind == EXPR_HEAP_MAP_LIT {
            map_fail(st, expr, expr.line, expr.col, "cannot infer key and value types of empty map literal — annotate it (e.g. let m: heap Map[i32, string] = heap map[])")
        } else {
            map_fail(st, expr, expr.line, expr.col, "cannot infer key and value types of empty map literal — annotate it (e.g. let m: Map[i32, string] = map[])")
        }
        return "unknown"
    }
    let k0 = infer_expr_type(st, expr.first_arg)
    if k0 == "unknown" { return map_fail(st, expr, expr.line, expr.col, null) }
    if not is_map_key_family(k0) { return map_fail(st, expr, expr.first_arg.line, expr.first_arg.col, map_key_family_error_text(k0)) }
    let v0 = infer_expr_type(st, expr.first_arg.next)
    if v0 == "unknown" { return map_fail(st, expr, expr.line, expr.col, null) }
    if v0 == "@void" { return map_fail(st, expr, expr.first_arg.next.line, expr.first_arg.next.col, "map values cannot be null (use a @T pointer value)") }
    mut cur = expr.first_arg.next.next; mut expect_key = true
    loop cur != null {
        if expect_key {
            let k_t = infer_expr_type(st, cur)
            if k_t != "unknown" and k_t != k0 { return map_fail(st, expr, cur.line, cur.col, map_join5("map literal key types differ: ", k0, " vs ", k_t, "")) }
        }
        expect_key = not expect_key; cur = cur.next
    }
    mut is_mixed = false; mut all_numeric = true; mut has_float = false; mut second = ""
    if is_dyn_int_family(v0) or is_dyn_float_family(v0) { if is_dyn_float_family(v0) { has_float = true } } else { all_numeric = false }
    cur = expr.first_arg.next.next; expect_key = true
    loop cur != null {
        if not expect_key {
            let t = infer_expr_type(st, cur)
            if t == "unknown" { return map_fail(st, expr, cur.line, cur.col, null) }
            if t == "@void" { return map_fail(st, expr, cur.line, cur.col, "map values cannot be null (use a @T pointer value)") }
            if t != v0 { is_mixed = true; if str.len(second) == 0 { second = t } }
            if is_dyn_int_family(t) or is_dyn_float_family(t) { if is_dyn_float_family(t) { has_float = true } } else { all_numeric = false }
        }
        expect_key = not expect_key; cur = cur.next
    }
    mut hpfx = "Map["
    if expr.kind == EXPR_HEAP_MAP_LIT { hpfx = "heap Map[" }
    if not is_mixed { expr.type_name = map_join5(hpfx, k0, ", ", v0, "]"); expr.bool_val = true; return expr.type_name }
    if all_numeric {
        if has_float { expr.type_name = map_join5(hpfx, k0, ", ", "f64", "]"); expr.bool_val = true; return expr.type_name }
        return map_fail(st, expr, expr.line, expr.col, map_join5("map literal value types differ: ", v0, " vs ", second, ""))
    }
    let err0 = dyn_boxable_error(v0)
    if err0 != null { return map_fail(st, expr, expr.first_arg.next.line, expr.first_arg.next.col, err0) }
    cur = expr.first_arg.next.next; expect_key = true
    loop cur != null {
        if not expect_key {
            let t = infer_expr_type(st, cur)
            if t == "unknown" { return map_fail(st, expr, cur.line, cur.col, null) }
            let err = dyn_boxable_error(t)
            if err != null { return map_fail(st, expr, cur.line, cur.col, err) }
        }
        expect_key = not expect_key; cur = cur.next
    }
    expr.type_name = map_join5(hpfx, k0, ", ", "dyn", "]"); expr.bool_val = true
    return expr.type_name
}

// Builds the memoized literal's `Map[K, V]` spelling (infer entry point).
act map_inferred_type(st: @SymbolTable, expr: @ExprNode) -> string {
    return map_literal_kv(st, expr)
}

// Property reads on a map: only `.len` (usize) exists as a property.
act check_map_member_access(st: @SymbolTable, expr: @ExprNode) -> string {
    if expr.member_name == "len" { return "usize" }
    return map_fail(st, expr, expr.line, expr.col, map_join5("unknown map member '", expr.member_name, "' (put, get, has, len, get_or, take, free, destroy are available)", "", ""))
}

// Index reads: strict key typing; a read yields V (the miss fatal is runtime).
act check_map_index_read(st: @SymbolTable, expr: @ExprNode) -> string {
    let recv_t = infer_expr_type(st, expr.target)
    let k_t = map_checked_key(st, map_key_type(recv_t), expr.target.line, expr.target.col)
    if k_t == null { return "unknown" }
    let got = infer_expr_type(st, expr.index)
    if got != k_t { return map_fail(st, expr, expr.index.line, expr.index.col, map_join5("map key mismatch: expected ", k_t, " (got ", got, ")")) }
    return map_value_type(recv_t)
}

// The value-slot contract: exact V; dyn values box any boxable element.
act check_map_value_slot(st: @SymbolTable, val_node: @ExprNode, v_t: string) {
    if v_t == null { return }
    let got = infer_expr_type(st, val_node)
    if v_t == "dyn" {
        if got == "unknown" or got == "dyn" { return }
        if got == "void" { report_error("semantic", val_node.line, val_node.col, "shelf[dyn] put: cannot box a void value"); st.error_count += 1; return }
        if got == "@void" { report_error("semantic", val_node.line, val_node.col, "map values cannot be null (use a @T pointer value)"); st.error_count += 1; return }
        let err = dyn_boxable_error(got)
        if err != null { report_error("semantic", val_node.line, val_node.col, err); st.error_count += 1 }
        return
    }
    if got != v_t {
        report_error("semantic", val_node.line, val_node.col, map_join5("map value mismatch: expected ", v_t, " (got ", got, ")")); st.error_count += 1
    }
}

// Index assignment targets: explicit '=' only, mut root, strict key/value.
act check_map_assign(st: @SymbolTable, stmt: @StmtNode) {
    if stmt.op != TOK_ASSIGN { report_error("semantic", stmt.line, stmt.col, "compound assignments on maps are not supported yet — use an explicit '=' write"); st.error_count += 1; return }
    check_map_mut_binding(st, stmt.expr.target, "write", "into")
    let recv_t = infer_expr_type(st, stmt.expr.target)
    let k_t = map_checked_key(st, map_key_type(recv_t), stmt.expr.target.line, stmt.expr.target.col)
    if k_t == null { return }
    let got_key = infer_expr_type(st, stmt.expr.index)
    if got_key != k_t { report_error("semantic", stmt.expr.index.line, stmt.expr.index.col, map_join5("map key mismatch: expected ", k_t, " (got ", got_key, ")")); st.error_count += 1; return }
    check_map_value_slot(st, stmt.val_expr, map_value_type(recv_t))
}

// Member calls: put, get, has, get_or, take, free, destroy
act check_map_member_call(st: @SymbolTable, expr: @ExprNode) -> string {
    let member = expr.callee.member_name
    let recv_t = infer_expr_type(st, expr.callee.target)
    if member != "put" and member != "get" and member != "has" and member != "get_or" and member != "take" and member != "free" and member != "destroy" {
        return map_fail(st, expr, expr.line, expr.col, map_join5("unknown map member '", member, "' (put, get, has, len, get_or, take, free, destroy are available)", "", ""))
    }
    if member == "free" or member == "destroy" {
        if expr.arg_count != 0 { return map_fail(st, expr, expr.line, expr.col, map_join5("map.", member, " takes no arguments", "", "")) }
        check_map_mut_binding(st, expr.callee.target, member, "from")
        return "void"
    }
    if member == "put" { if expr.arg_count != 2 { return map_fail(st, expr, expr.line, expr.col, "map.put expects exactly 2 arguments: (map m, key, value)") } }
    else if member == "get_or" { if expr.arg_count != 2 { return map_fail(st, expr, expr.line, expr.col, "map.get_or expects exactly 2 arguments: (map m, key, default)") } }
    else { if expr.arg_count != 1 { return map_fail(st, expr, expr.line, expr.col, map_join5("map.", member, " expects exactly 1 argument: (map m, key)", "", "")) } }
    let k_t = map_checked_key(st, map_key_type(recv_t), expr.callee.target.line, expr.callee.target.col)
    if k_t == null { return "unknown" }
    let got_key = infer_expr_type(st, expr.first_arg)
    if got_key != k_t { return map_fail(st, expr, expr.first_arg.line, expr.first_arg.col, map_join5("map key mismatch: expected ", k_t, " (got ", got_key, ")")) }
    if member == "put" {
        check_map_value_slot(st, expr.first_arg.next, map_value_type(recv_t))
        check_map_mut_binding(st, expr.callee.target, "put", "into")
        return "void"
    }
    if member == "get_or" { check_map_value_slot(st, expr.first_arg.next, map_value_type(recv_t)); return map_value_type(recv_t) }
    if member == "take" { check_map_mut_binding(st, expr.callee.target, "take", "from"); return map_value_type(recv_t) }
    if member == "get" { return map_value_type(recv_t) }
    return "bool"
}

// 5.2 / 7.2: annotated map declarations
act check_map_annotation(st: @SymbolTable, decl_t: string, val: @ExprNode, line: i32, col: i32) {
    if val == null or (val.kind != EXPR_MAP_LIT and val.kind != EXPR_HEAP_MAP_LIT) { return }
    let clean = strip_pointer_prefix(decl_t)
    let ann_is_heap = starts_with_heap_map(clean)
    if not ann_is_heap and (clean == null or str.len(clean) < 5 or clean[0] != 'M' or clean[1] != 'a' or clean[2] != 'p' or clean[3] != '[') { return }
    if not map_has_slots(clean) { return }
    if map_checked_key(st, map_key_type(clean), line, col) == null { map_fail(st, val, line, col, null); return }
    let lit_is_heap = val.kind == EXPR_HEAP_MAP_LIT
    if ann_is_heap != lit_is_heap {
        mut lit_full = ""
        if val.arg_count > 0 { lit_full = map_literal_kv(st, val) } else if lit_is_heap { lit_full = "heap map[]" } else { lit_full = "map[]" }
        report_error("semantic", line, col, map_join5("map literal type ", lit_full, " does not match annotation ", decl_t, "")); st.error_count += 1
        return
    }
    if val.arg_count == 0 { val.type_name = decl_t; return }
    let lit_kv = map_literal_kv(st, val)
    if lit_kv == "unknown" or lit_kv == null { return }
    if lit_kv != decl_t {
        report_error("semantic", line, col, map_join5("map literal type ", lit_kv, " does not match annotation ", decl_t, "")); st.error_count += 1
    }
}

// 5.2 / 7.2: pin empty map in return
act pin_empty_map_return(st: @SymbolTable, val: @ExprNode, ret_t: string) {
    if val == null or (val.kind != EXPR_MAP_LIT and val.kind != EXPR_HEAP_MAP_LIT) or val.arg_count != 0 { return }
    if ret_t == null or not map_has_slots(ret_t) { return }
    if map_checked_key(st, map_key_type(ret_t), val.line, val.col) == null { map_fail(st, val, val.line, val.col, null); return }
    val.type_name = ret_t
}

// Map module calls: map.destroy(@m) / map.free(@m)
act check_map_module_call(st: @SymbolTable, expr: @ExprNode, member: string) -> string {
    if member != "destroy" and member != "free" {
        report_error("semantic", expr.line, expr.col, map_join5("unknown map function '", member, "' (destroy, free are available)", "", "")); st.error_count += 1; return "unknown"
    }
    if expr.arg_count != 1 {
        report_error("semantic", expr.line, expr.col, map_join5("map.", member, " expects exactly 1 argument: (map m)", "", "")); st.error_count += 1; return "unknown"
    }
    let arg_t = infer_expr_type(st, expr.first_arg)
    if not is_map_type(arg_t) {
        report_error("semantic", expr.first_arg.line, expr.first_arg.col, map_join5("map.", member, " argument must be a map (got ", arg_t, ")")); st.error_count += 1; return "unknown"
    }
    check_map_mut_binding(st, expr.first_arg, member, "from")
    return "void"
}

// Cross-call boundary: a map argument must string-match BOTH slots
act check_map_call_args(st: @SymbolTable, expr: @ExprNode, fn_sym: @FunctionSym) {
    mut cur_p = fn_sym.first_param; mut cur_a = expr.first_arg
    loop cur_p != null and cur_a != null {
        let want = cur_p.type_name
        if is_map_type(want) {
            let got = infer_expr_type(st, cur_a)
            if is_map_type(got) and got != want {
                report_error("semantic", expr.line, expr.col, map_join5("map argument types must match exactly: got ", got, ", expected ", want, "")); st.error_count += 1
            }
        }
        cur_p = cur_p.next; cur_a = cur_a.next
    }
}

// 5.2 slice 7: loop k of m { }
act check_map_loop_keys(st: @SymbolTable, stmt: @StmtNode) -> string {
    let coll_t = infer_expr_type(st, stmt.expr)
    let k_t = map_checked_key(st, map_key_type(coll_t), stmt.line, stmt.col)
    if k_t != null { return k_t }
    return map_fail(st, stmt.expr, stmt.line, stmt.col, map_join3("the 'of' source of a loop must be a shelf, map, or ring (got ", coll_t, ")"))
}

// Loop-of dispatch
act check_map_loop_source(st: @SymbolTable, stmt: @StmtNode) -> string {
    if is_map_type(infer_expr_type(st, stmt.expr)) { return check_map_loop_keys(st, stmt) }
    if is_ring_type(infer_expr_type(st, stmt.expr)) { return check_ring_loop_elem(st, stmt) }
    return check_shelf_loop_elem(st, stmt)
}
