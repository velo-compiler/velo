// Whole-program multi-pass semantic analysis and type verification for Velo.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "symbol_table.vl"
use "type_checker.vl"
use "type_checker_stmt.vl"
use "shelf_checks.vl"
use "literal_check.vl"
use "../ast/int_types.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"

// 2.3: Validates that a default field initializer's inferred type is compatible with the declared field type.
act check_struct_default_field(st: @SymbolTable, cur_f: @FieldNode) {
    if not cur_f.has_default or cur_f.default_value == null { return }
    let adapt_ok = try_adapt_int_literal(st, cur_f.type_name, cur_f.default_value, cur_f.line, cur_f.col)
    let def_t = infer_expr_type(st, cur_f.default_value)
    if not types_are_compatible(cur_f.type_name, def_t) {
        if not adapt_ok { }
        else if is_int_type(cur_f.type_name) and is_int_type(def_t) {
            report_error("semantic", cur_f.line, cur_f.col, int_conversion_error_msg(cur_f.type_name, def_t))
            st.error_count += 1
        } else if is_float_type(cur_f.type_name) and is_float_type(def_t) {
            report_error("semantic", cur_f.line, cur_f.col, float_conversion_error_msg(cur_f.type_name, def_t))
            st.error_count += 1
        } else {
            mut sb = create_sb(96)
            sb_append_str(@sb, "Default value type mismatch for field '")
            sb_append_str(@sb, cur_f.name)
            sb_append_str(@sb, "': expected ")
            sb_append_str(@sb, cur_f.type_name)
            sb_append_str(@sb, ", got ")
            sb_append_str(@sb, def_t)
            report_error("semantic", cur_f.line, cur_f.col, sb_to_string(@sb))
            st.error_count += 1
        }
    }
}

// 4.3: Returns true if the expression is an unconditional process exit call (os.exit, exit, etc.).
act is_exit_call_expr(e: @ExprNode) -> bool {
    if e == null { return false }
    if e.kind == EXPR_CALL and e.callee != null {
        if e.callee.kind == EXPR_MEMBER and e.callee.target != null {
            if e.callee.target.kind == EXPR_IDENT and e.callee.target.str_val == "os" and e.callee.member_name == "exit" {
                return true
            }
        }
        if e.callee.kind == EXPR_IDENT {
            let name = e.callee.str_val
            if name == "exit" or name == "os_exit" or name == "abort" {
                return true
            }
        }
    }
    return false
}

// 4.3: Returns true if the statement guarantees all control flow paths terminate in a return or process exit.
act stmt_always_returns(st: @SymbolTable, stmt: @StmtNode) -> bool {
    if stmt == null { return false }
    if stmt.kind == STMT_RETURN or stmt.kind == STMT_FAIL {
        return true
    }
    if stmt.kind == STMT_EXPR {
        return is_exit_call_expr(stmt.expr)
    }
    if stmt.kind == STMT_BLOCK {
        mut cur = stmt.first_stmt
        loop cur != null {
            if stmt_always_returns(st, cur) { return true }
            cur = cur.next
        }
        return false
    }
    if stmt.kind == STMT_UNSAFE { return stmt_always_returns(st, stmt.body) }
    if stmt.kind == STMT_IF {
        if stmt.else_branch == null { return false }
        return stmt_always_returns(st, stmt.body) and stmt_always_returns(st, stmt.else_branch)
    }
    if stmt.kind == STMT_MATCH {
        if stmt.case_count == 0 { return false }
        let k_sym = find_kind(st, stmt.type_name)
        mut has_default = false
        mut matched_variants: usize = 0
        mut cur_c = stmt.first_case
        loop cur_c != null {
            if not stmt_always_returns(st, cur_c.body) { return false }
            if cur_c.is_default { has_default = true }
            matched_variants += cur_c.val_count
            cur_c = cur_c.next
        }
        if has_default { return true }
        if k_sym != null and k_sym.variant_count > 0 and matched_variants >= k_sym.variant_count {
            return true
        }
        return false
    }
    if stmt.kind == STMT_ZONE {
        return stmt_always_returns(st, stmt.body)
    }
    if stmt.kind == STMT_LOOP {
        if stmt.expr == null and stmt.loop_start == null and not stmt.is_of {
            return stmt_always_returns(st, stmt.body)
        }
        return false
    }
    return false
}

// Executes multi-pass semantic analysis and type verification over an AST program.
act check_program(st: @SymbolTable, prog: @ProgramNode) -> bool {
    // Pass 1: Register all struct and kind declarations
    mut cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_DATA {
            let st_sym = register_struct(st, cur.name, cur.line, cur.col)
            mut cur_f = cur.first_field
            loop cur_f != null {
                struct_add_field(st_sym, cur_f.name, cur_f.type_name, cur_f.has_default, cur_f.default_value, cur_f.line, cur_f.col)
                check_struct_default_field(st, cur_f)
                cur_f = cur_f.next
            }
        } else if cur.kind == DECL_KIND {
            mut is_tu = false; mut v = cur.first_variant
            loop v != null { if v.payload_type != null or v.field_count > 0 { is_tu = true }; v = v.next }
            let k_sym = register_kind(st, cur.name, is_tu, cur.line, cur.col)
            mut cv = cur.first_variant
            loop cv != null {
                mut f_sym: @StructFieldSym = null; mut last_f: @StructFieldSym = null; mut cf = cv.first_field
                loop cf != null {
                    mut fn: @StructFieldSym = mem.alloc(@StructFieldSym, 1)
                    fn.name = cf.name; fn.type_name = cf.type_name; fn.has_default = false; fn.default_value = null
                    fn.line = cf.line; fn.col = cf.col; fn.next = null
                    if f_sym == null { f_sym = fn; last_f = fn } else { last_f.next = fn; last_f = fn }
                    cf = cf.next
                }
                kind_add_variant(k_sym, cv.name, cv.discriminant, cv.has_discriminant, cv.payload_type, f_sym, cv.field_count, cv.line, cv.col)
                cv = cv.next
            }
        }
        cur = cur.next
    }

    // Pass 1.5: Register all top-level global variables and constants
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == STMT_VAR_DECL {
            check_shelf_annotation(st, cur.type_name, cur.val_expr, cur.line, cur.col)  // 5.2: pin/reject
            check_map_annotation(st, cur.type_name, cur.val_expr, cur.line, cur.col)    // 5.2 slice 6: pin/reject
            mut inf_type = cur.type_name
            if inf_type == null or str.len(inf_type) == 0 {
                if cur.val_expr != null { inf_type = infer_expr_type(st, cur.val_expr) } else { inf_type = "i32" }
            }
            define_variable(st, cur.name, inf_type, cur.is_mut, cur.line, cur.col)
        }
        cur = cur.next
    }

    // Pass 2: Register all function & extern declarations
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_FUNCTION or cur.kind == DECL_EXTERN {
            let fn_sym = register_function(st, cur.name, cur.return_type, cur.kind == DECL_EXTERN, cur.line, cur.col)
            mut cur_p = cur.first_param
            loop cur_p != null { function_add_param(fn_sym, cur_p.name, cur_p.type_name); cur_p = cur_p.next }
        }
        cur = cur.next
    }

    // Pass 2.5: Infer return types for functions with return_type == "auto"
    mut changed = true
    mut iter: usize = 0
    loop changed and iter < 8 {
        changed = false
        iter += 1
        cur = prog.first_decl
        loop cur != null {
            if cur.kind == DECL_FUNCTION and cur.return_type != null and cur.return_type == "auto" and cur.body != null {
                enter_scope(st)
                mut cur_p = cur.first_param
                loop cur_p != null { define_parameter(st, cur_p.name, cur_p.type_name, cur_p.line, cur_p.col); cur_p = cur_p.next }
                mut inf_ret = "void"
                if cur.body.kind == STMT_BLOCK and cur.body.first_stmt != null and cur.body.first_stmt.kind == STMT_RETURN and cur.body.first_stmt.val_expr != null {
                    inf_ret = infer_expr_type(st, cur.body.first_stmt.val_expr)
                }
                exit_scope(st)
                if inf_ret != null and inf_ret != "auto" and inf_ret != "unknown" {
                    cur.return_type = inf_ret
                    let fn_sym = find_function(st, cur.name)
                    if fn_sym != null { fn_sym.return_type = inf_ret }
                    changed = true
                }
            }
            cur = cur.next
        }
    }
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_FUNCTION and cur.return_type != null and cur.return_type == "auto" {
            cur.return_type = "void"
            let fn_sym = find_function(st, cur.name)
            if fn_sym != null { fn_sym.return_type = "void" }
        }
        cur = cur.next
    }

    // Pass 3: Validate function bodies, statements, and expressions
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_FUNCTION and cur.body != null {
            st.current_func_ret_type = cur.return_type
            st.current_func_name = cur.name
            st.current_zone_depth = 0
            st.current_loop_depth = 0
            let prev_strict = st.strict_safety
            if cur.module_path != null and cur.module_path == "std" { st.strict_safety = false }
            enter_scope(st)
            mut cur_p = cur.first_param
            loop cur_p != null { define_parameter(st, cur_p.name, cur_p.type_name, cur_p.line, cur_p.col); cur_p = cur_p.next }
            check_statement(st, cur.return_type, cur.body)
            exit_scope(st)
            st.strict_safety = prev_strict
            st.current_loop_depth = 0

            if cur.name != "main" and cur.return_type != null and cur.return_type != "void" and str.len(cur.return_type) > 0 {
                if not stmt_always_returns(st, cur.body) {
                    mut msb = create_sb(96)
                    sb_append_str(@msb, "missing return statement on control path in function '")
                    sb_append_str(@msb, cur.name)
                    sb_append_char(@msb, '\'')
                    report_error("semantic", cur.line, cur.col, sb_to_string(@msb))
                    st.error_count += 1
                }
            }
        }
        if cur.kind == DECL_TEST and cur.body != null {
            st.current_func_ret_type = "void"
            st.current_func_name = cur.name
            st.current_zone_depth = 0
            st.current_loop_depth = 0
            enter_scope(st)
            check_statement(st, "void", cur.body)
            exit_scope(st)
            st.current_loop_depth = 0
        }
        cur = cur.next
    }

    return st.error_count == 0
}
