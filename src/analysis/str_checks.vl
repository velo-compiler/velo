// 5.1 String Processing Library: compile-time argument checks for the
// sys.str intrinsic namespace (every member except legacy str.len).
// Mutual mirror of velo/codegen_c.py::_str_expect / _STR_SIGS — both stages
// must reject the same programs with the same words.
// Returns false after reporting; the infer branch then yields "unknown".
// An unknown member returns true (unchanged legacy fallthrough path).
use "type_checker.vl"
use "symbol_table.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../ast/expr.vl"
use "../frontend/token.vl"

// Signature text per checked member ("" = not a checked str member).
// Must stay character-identical with velo/codegen_c.py::_STR_SIGS.
act str_member_sig(member: string) -> string {
    if member == "contains" { return ": (string s, string sub)" }
    if member == "starts_with" { return ": (string s, string prefix)" }
    if member == "ends_with" { return ": (string s, string suffix)" }
    if member == "index_of" { return ": (string s, string needle)" }
    if member == "trim" { return ": (string s)" }
    if member == "to_upper" { return ": (string s)" }
    if member == "to_lower" { return ": (string s)" }
    if member == "replace" { return ": (string s, string old, string new)" }
    if member == "concat" { return ": (string a, string b)" }
    if member == "split" { return ": (string s, string delimiter)" }
    return ""
}

// Expected argument count per checked member (same curves as _STR_SIGS).
act str_member_arity(member: string) -> i32 {
    if member == "trim" or member == "to_upper" or member == "to_lower" { return 1 }
    if member == "replace" { return 3 }
    if member == "contains" or member == "starts_with" or member == "ends_with" or member == "index_of" or member == "concat" or member == "split" { return 2 }
    return -1
}

act str_got_msg(member: string, got: string) -> string {
    let msb = create_sb(192)
    sb_append_str(@msb, "str."); sb_append_str(@msb, member); sb_append_str(@msb, " expects string arguments (got ")
    sb_append_str(@msb, got); sb_append_str(@msb, ")")
    return sb_to_string(@msb)
}

act check_str_call(st: @SymbolTable, expr: @ExprNode, member: string) -> bool {
    let arity = str_member_arity(member)
    if arity < 0 { return true }  // unknown member: keep the legacy path
    mut argc: usize = 0
    mut cur_a = expr.first_arg
    loop cur_a != null { argc += 1; cur_a = cur_a.next }
    if argc != (arity as usize) {
        let msb = create_sb(192)
        sb_append_str(@msb, "str."); sb_append_str(@msb, member); sb_append_str(@msb, " expects exactly ")
        sb_append_int(@msb, arity)
        if arity == 1 { sb_append_str(@msb, " argument") } else { sb_append_str(@msb, " arguments") }
        sb_append_str(@msb, str_member_sig(member))
        report_error("semantic", expr.line, expr.col, sb_to_string(@msb)); st.error_count += 1
        return false
    }
    mut cur = expr.first_arg
    loop cur != null {
        let t = infer_expr_type(st, cur)
        if t != "string" {
            report_error("semantic", expr.line, expr.col, str_got_msg(member, t)); st.error_count += 1
            return false
        }
        cur = cur.next
    }
    return true
}
