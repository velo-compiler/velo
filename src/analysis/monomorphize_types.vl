// Type mangling, string substitution, and queue state for AST monomorphization.
use sys.io
use sys.mem
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../common/utils.vl"
use "../common/string_builder.vl"
use "../common/diagnostics.vl"

// Tracks a registered generic template.
data GenericTemplate {
    kind: i32
    name: string
    type_params: string
    node: @StmtNode
    next: @GenericTemplate
}

// Tracks an instantiated specialization.
data InstantiatedEntry {
    mangled_name: string
    decl: @StmtNode
    next: @InstantiatedEntry
}

// Queue entry for pending specializations.
data WorklistNode {
    kind: i32
    template_name: string
    type_args: string
    mangled_name: string
    next: @WorklistNode
}

// Tracks variable types in local scope.
data ScopeEntry {
    name: string
    type_name: string
    next: @ScopeEntry
}

// Global monomorphizer state.
data Monomorphizer {
    first_template: @GenericTemplate
    first_inst: @InstantiatedEntry
    worklist_head: @WorklistNode
    worklist_tail: @WorklistNode
    first_alias: @TypeAliasEntry
}

// Tracks a registered primitive type alias (`aka Foo = u64`).
data TypeAliasEntry {
    name: string
    target: string
    next: @TypeAliasEntry
}

act mono_init(m: @Monomorphizer) {
    m.first_template = null
    m.first_inst = null
    m.worklist_head = null
    m.worklist_tail = null
    m.first_alias = null
}

act mono_find_template(m: @Monomorphizer, name: string) -> @GenericTemplate {
    mut cur = m.first_template
    loop cur != null {
        if cur.name == name { return cur }
        cur = cur.next
    }
    return null
}

act mono_is_instantiated(m: @Monomorphizer, mangled_name: string) -> bool {
    mut cur = m.first_inst
    loop cur != null {
        if cur.mangled_name == mangled_name { return true }
        cur = cur.next
    }
    mut w = m.worklist_head
    loop w != null {
        if w.mangled_name == mangled_name { return true }
        w = w.next
    }
    return false
}

act mono_request(m: @Monomorphizer, kind: i32, tname: string, targs: string, mangled: string) {
    if mono_is_instantiated(m, mangled) { return }
    mut node: @WorklistNode = mem.alloc(@WorklistNode, 1)
    node.kind = kind
    node.template_name = tname
    node.type_args = targs
    node.mangled_name = mangled
    node.next = null
    if m.worklist_tail == null {
        m.worklist_head = node
        m.worklist_tail = node
    } else {
        m.worklist_tail.next = node
        m.worklist_tail = node
    }
}

act mono_concat(a: string, b: string) -> string {
    if a == null { return b }
    if b == null { return a }
    let la = str.len(a)
    let lb = str.len(b)
    mut sb = create_sb(la + lb + 1)
    sb_append_str(@sb, a)
    sb_append_str(@sb, b)
    return sb_to_string(@sb)
}

act mono_find_char(s: string, c: u8) -> i32 {
    if s == null { return -1 }
    let len = str.len(s)
    mut i: usize = 0
    loop i < len {
        if s[i] == c { return i as i32 }
        i += 1
    }
    return -1
}

act mono_trim(s: string) -> string {
    if s == null { return null }
    let len = str.len(s)
    mut start: usize = 0
    loop start < len and (s[start] == ' ' or s[start] == '\t') { start += 1 }
    mut end = len
    loop end > start and (s[end - 1] == ' ' or s[end - 1] == '\t') { end -= 1 }
    return copy_slice_to_string(s, start, end - start)
}

act mono_str_replace(src: string, target: string, repl: string) -> string {
    if src == null or target == null or repl == null { return src }
    let slen = str.len(src)
    let tlen = str.len(target)
    if tlen == 0 or slen < tlen { return src }
    mut sb = create_sb(slen + str.len(repl) + 8)
    mut i: usize = 0
    loop i < slen {
        if i + tlen <= slen {
            mut matched = true
            mut j: usize = 0
            loop j < tlen {
                if src[i + j] != target[j] { matched = false; break }
                j += 1
            }
            if matched {
                sb_append_str(@sb, repl)
                i += tlen
                continue
            }
        }
        sb_append_char(@sb, src[i])
        i += 1
    }
    return sb_to_string(@sb)
}

act mono_mangle_type(t: string) -> string {
    if t == null { return "" }
    let len = str.len(t)
    mut sb = create_sb(len + 8)
    mut i: usize = 0
    loop i < len {
        let c = t[i]
        if c == '[' or c == ']' or c == ' ' {
            if c == '[' { sb_append_char(@sb, '_') }
        } else if c == ',' {
            sb_append_char(@sb, '_')
        } else if c == '@' {
            sb_append_str(@sb, "ptr_")
        } else {
            sb_append_char(@sb, c)
        }
        i += 1
    }
    return sb_to_string(@sb)
}

act mono_normalize_type(t: string) -> string {
    if t == null { return null }
    let len = str.len(t)
    mut at_count: usize = 0
    loop at_count < len and t[at_count] == '@' { at_count += 1 }
    mut has_bracket = false
    mut k = at_count
    loop k < len {
        if t[k] == '[' { has_bracket = true; break }
        k += 1
    }
    if not has_bracket { return t }
    let base = copy_slice_to_string(t, at_count, len - at_count)
    let mangled = mono_mangle_type(base)
    if at_count == 0 { return mangled }
    mut sb = create_sb(at_count + str.len(mangled))
    mut j: usize = 0
    loop j < at_count { sb_append_char(@sb, '@'); j += 1 }
    sb_append_str(@sb, mangled)
    return sb_to_string(@sb)
}

act mono_subst_single(t: string, p: string, a: string) -> string {
    if t == null { return null }
    if t == p { return a }
    let at_p = mono_concat("@", p)
    if t == at_p { return mono_concat("@", a) }
    let at_at_p = mono_concat("@@", p)
    if t == at_at_p { return mono_concat("@@", a) }

    let b1 = mono_concat("[", mono_concat(p, "]"))
    let r1 = mono_concat("[", mono_concat(a, "]"))
    let b2 = mono_concat("[", mono_concat(p, ", "))
    let r2 = mono_concat("[", mono_concat(a, ", "))
    let b3 = mono_concat(", ", mono_concat(p, "]"))
    let r3 = mono_concat(", ", mono_concat(a, "]"))
    let b4 = mono_concat(", ", mono_concat(p, ", "))
    let r4 = mono_concat(", ", mono_concat(a, ", "))

    mut res = mono_str_replace(t, b1, r1)
    res = mono_str_replace(res, b2, r2)
    res = mono_str_replace(res, b3, r3)
    res = mono_str_replace(res, b4, r4)
    return res
}

act mono_subst(t: string, params: string, args: string) -> string {
    if t == null or params == null or args == null { return t }
    let comma_p = mono_find_char(params, ',')
    let comma_a = mono_find_char(args, ',')
    if comma_p < 0 or comma_a < 0 {
        let p = mono_trim(params)
        let a = mono_trim(args)
        return mono_subst_single(t, p, a)
    }
    let p1 = mono_trim(copy_slice_to_string(params, 0, comma_p as usize))
    let p2 = mono_trim(copy_slice_to_string(params, (comma_p + 1) as usize, (str.len(params) - comma_p - 1) as usize))
    let a1 = mono_trim(copy_slice_to_string(args, 0, comma_a as usize))
    let a2 = mono_trim(copy_slice_to_string(args, (comma_a + 1) as usize, (str.len(args) - comma_a - 1) as usize))
    let step1 = mono_subst_single(t, p1, a1)
    return mono_subst_single(step1, p2, a2)
}

act mono_check_type(m: @Monomorphizer, t: string) {
    if t == null { return }
    let bracket_pos = mono_find_char(t, '[')
    if bracket_pos < 0 { return }
    mut at_count: usize = 0
    loop at_count < str.len(t) and t[at_count] == '@' { at_count += 1 }
    let base = copy_slice_to_string(t, at_count, (bracket_pos as usize) - at_count)
    let end_bracket = mono_find_char(t, ']')
    if end_bracket <= bracket_pos { return }
    let args = copy_slice_to_string(t, (bracket_pos + 1) as usize, (end_bracket - bracket_pos - 1) as usize)
    let tmpl = mono_find_template(m, base)
    if tmpl != null {
        let mangled = mono_concat(base, mono_concat("_", mono_mangle_type(args)))
        mono_request(m, tmpl.kind, base, args, mangled)
    }
}
