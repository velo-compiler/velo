// Type mangling, string substitution, and queue state for AST monomorphization.
use sys.io
use sys.mem
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../common/utils.vl"
use "../common/string_builder.vl"
use "../common/diagnostics.vl"
use "mono_subst.vl"

// Tracks a registered generic template.
data GenericTemplate {
    kind: i32
    name: string
    type_params: string
    node: @StmtNode
    next: @GenericTemplate
}

// Tracks an instantiated specialization.
data InstantiatedEntry {
    mangled_name: string
    decl: @StmtNode
    next: @InstantiatedEntry
}

// Queue entry for pending specializations.
data WorklistNode {
    kind: i32
    template_name: string
    type_args: string
    mangled_name: string
    next: @WorklistNode
}

// Tracks variable types in local scope.
data ScopeEntry {
    name: string
    type_name: string
    next: @ScopeEntry
}

// Tracks a registered struct declaration (regular or instantiated).
data MonoStructEntry {
    name: string
    node: @StmtNode
    next: @MonoStructEntry
}

// Global monomorphizer state.
data Monomorphizer {
    first_template: @GenericTemplate
    first_inst: @InstantiatedEntry
    worklist_head: @WorklistNode
    worklist_tail: @WorklistNode
    first_alias: @TypeAliasEntry
    first_struct: @MonoStructEntry
}

// Tracks a registered primitive type alias (`aka Foo = u64`).
data TypeAliasEntry {
    name: string
    target: string
    next: @TypeAliasEntry
}

mut g_current_mono: @Monomorphizer = null

act mono_init(m: @Monomorphizer) {
    m.first_template = null
    m.first_inst = null
    m.worklist_head = null
    m.worklist_tail = null
    m.first_alias = null
    m.first_struct = null
    g_current_mono = m
}

act mono_register_struct(m: @Monomorphizer, name: string, node: @StmtNode) {
    mut e: @MonoStructEntry = mem.alloc(@MonoStructEntry, 1)
    e.name = name
    e.node = node
    e.next = m.first_struct
    m.first_struct = e
}

act mono_find_struct(m: @Monomorphizer, name: string) -> @StmtNode {
    if name == null { return null }
    let clean = strip_pointer_prefix(name)
    mut ctx = m
    if ctx == null { ctx = g_current_mono }
    if ctx == null { return null }
    mut cur = ctx.first_struct
    loop cur != null {
        if cur.name == clean { return cur.node }
        cur = cur.next
    }
    return null
}

act mono_find_template(m: @Monomorphizer, name: string) -> @GenericTemplate {
    mut cur = m.first_template
    loop cur != null {
        if cur.name == name { return cur }
        cur = cur.next
    }
    return null
}

act mono_is_instantiated(m: @Monomorphizer, mangled_name: string) -> bool {
    mut cur = m.first_inst
    loop cur != null {
        if cur.mangled_name == mangled_name { return true }
        cur = cur.next
    }
    mut w = m.worklist_head
    loop w != null {
        if w.mangled_name == mangled_name { return true }
        w = w.next
    }
    return false
}

act mono_request(m: @Monomorphizer, kind: i32, tname: string, targs: string, mangled: string) {
    if mono_is_instantiated(m, mangled) { return }
    mut node: @WorklistNode = mem.alloc(@WorklistNode, 1)
    node.kind = kind
    node.template_name = tname
    node.type_args = targs
    node.mangled_name = mangled
    node.next = null
    if m.worklist_tail == null {
        m.worklist_head = node
        m.worklist_tail = node
    } else {
        m.worklist_tail.next = node
        m.worklist_tail = node
    }
}


// 5.2: extracts the element type from shelf[T] / @shelf[T] / heap shelf[T]; null otherwise.
act mono_shelf_elem(t: string) -> string {
    if t == null { return null }
    let len = str.len(t)
    mut at: usize = 0
    loop at < len and t[at] == '@' { at += 1 }
    if len >= at + 5 and t[at] == 'h' and t[at + 1] == 'e' and t[at + 2] == 'a' and t[at + 3] == 'p' and t[at + 4] == ' ' { at += 5 }
    if len < at + 7 { return null }
    if t[at] == 's' and t[at + 1] == 'h' and t[at + 2] == 'e' and t[at + 3] == 'l' and t[at + 4] == 'f' and t[at + 5] == '[' and t[len - 1] == ']' {
        let inner_len = (len - 1) - (at + 6)
        if inner_len == 0 { return null }
        return copy_slice_to_string(t, at + 6, inner_len)
    }
    return null
}

// 5.2 slice 6 / 7.2: extracts the KEY slot from Map[K, V] / @Map[K, V] / heap Map[K, V]; null otherwise.
act mono_map_mapkey(t: string) -> string {
    if t == null { return null }
    let len = str.len(t)
    mut at: usize = 0
    loop at < len and t[at] == '@' { at += 1 }
    if len >= at + 5 and t[at] == 'h' and t[at + 1] == 'e' and t[at + 2] == 'a' and t[at + 3] == 'p' and t[at + 4] == ' ' { at += 5 }
    if len < at + 6 { return null }
    if (t[at] != 'M' and t[at] != 'm') or t[at + 1] != 'a' or t[at + 2] != 'p' or t[at + 3] != '[' { return null }
    if t[len - 1] != ']' { return null }
    let open = at + 4
    mut depth: usize = 0
    mut i: usize = open
    loop i < len - 1 {
        if t[i] == '[' { depth += 1 } else if t[i] == ']' and depth > 0 { depth -= 1 } else if t[i] == ',' and depth == 0 {
            let key_len = i - open
            if key_len != 0 { return copy_slice_to_string(t, open, key_len) }
            return null
        }
        i += 1
    }
    return null
}

// 5.2 slice 6 / 7.2: extracts the VALUE slot.
act mono_map_value(t: string) -> string {
    if t == null { return null }
    let len = str.len(t)
    mut at: usize = 0
    loop at < len and t[at] == '@' { at += 1 }
    if len >= at + 5 and t[at] == 'h' and t[at + 1] == 'e' and t[at + 2] == 'a' and t[at + 3] == 'p' and t[at + 4] == ' ' { at += 5 }
    if len < at + 6 { return null }
    if (t[at] != 'M' and t[at] != 'm') or t[at + 1] != 'a' or t[at + 2] != 'p' or t[at + 3] != '[' { return null }
    if t[len - 1] != ']' { return null }
    mut depth: usize = 0
    mut i: usize = at + 4
    loop i < len - 1 {
        if t[i] == '[' { depth += 1 } else if t[i] == ']' and depth > 0 { depth -= 1 } else if t[i] == ',' and depth == 0 {
            let val_len = (len - 1) - (i + 1)
            if val_len != 0 { return copy_slice_to_string(t, i + 1, val_len) }
            return null
        }
        i += 1
    }
    return null
}

// 5.2 slice 6 / 7.2: builds the canonical `Map[K, V]` spelling.
act mono_map_spelling(heap_pfx: string, k: string, v: string) -> string {
    return mono_concat(heap_pfx, mono_concat("Map[", mono_concat(k, mono_concat(", ", mono_concat(v, "]")))))
}
// 5.2 slice 9: the canonical `ring[T]` spelling lives in monomorphize_expr.vl
// (mono_ring_spelling) beside its caller.

act mono_check_type(m: @Monomorphizer, t: string) {
    if t == null { return }
    let bracket_pos = mono_find_char(t, '[')
    if bracket_pos < 0 { return }
    mut at_count: usize = 0
    loop at_count < str.len(t) and t[at_count] == '@' { at_count += 1 }
    let base = copy_slice_to_string(t, at_count, (bracket_pos as usize) - at_count)
    let end_bracket = mono_find_char(t, ']')
    if end_bracket <= bracket_pos { return }
    let args = copy_slice_to_string(t, (bracket_pos + 1) as usize, (end_bracket - bracket_pos - 1) as usize)
    let tmpl = mono_find_template(m, base)
    if tmpl != null {
        let mangled = mono_concat(base, mono_concat("_", mono_mangle_type(args)))
        mono_request(m, tmpl.kind, base, args, mangled)
    }
}
