// Semantic analysis for function pointers, method receivers, and variant constructors.
use "../ast/types.vl"
use "../ast/expr.vl"
use "symbol_table.vl"
use "type_checker.vl"
use "literal_check.vl"
use "../common/act_types.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../common/utils.vl"

// Validates method receiver compatibility against the first parameter of a method.
act check_method_receiver(st: @SymbolTable, target: @ExprNode, target_t: string, expected_t: string) {
    if target == null or target_t == null or expected_t == null { return }
    let clean_exp = strip_pointer_prefix(expected_t)
    let clean_tgt = strip_pointer_prefix(target_t)
    if clean_exp != clean_tgt and not types_are_compatible(expected_t, target_t) {
        mut msg_sb = create_sb(128)
        sb_append_str(@msg_sb, "Type mismatch in method receiver: expected '")
        sb_append_str(@msg_sb, expected_t)
        sb_append_str(@msg_sb, "', got '")
        sb_append_str(@msg_sb, target_t)
        sb_append_str(@msg_sb, "'")
        report_error("semantic", target.line, target.col, sb_to_string(@msg_sb))
        st.error_count += 1
    }
}

// Validates function pointer call arguments and arity against an act(...) signature.
act check_act_call(st: @SymbolTable, expr: @ExprNode, act_type: string) -> string {
    let clean = strip_pointer_prefix(act_type)
    let ret_type = get_act_return_type(clean)
    let len = str.len(clean)
    mut i: usize = 0
    loop i < len and clean[i] != '(' { i += 1 }
    if i < len { i += 1 }

    mut p_count: usize = 0
    mut p_scan = i
    loop p_scan < len and clean[p_scan] != ')' {
        loop p_scan < len and (clean[p_scan] == ' ' or clean[p_scan] == '\t') { p_scan += 1 }
        if p_scan >= len or clean[p_scan] == ')' { break }
        p_count += 1
        loop p_scan < len and clean[p_scan] != ',' and clean[p_scan] != ')' { p_scan += 1 }
        if p_scan < len and clean[p_scan] == ',' { p_scan += 1 }
    }

    if expr.arg_count != p_count {
        report_error("semantic", expr.line, expr.col, "Mismatched argument count in function call")
        st.error_count += 1
    }

    mut cur_a = expr.first_arg
    mut arg_idx: i32 = 1
    loop i < len and clean[i] != ')' and cur_a != null {
        loop i < len and (clean[i] == ' ' or clean[i] == '\t') { i += 1 }
        if i >= len or clean[i] == ')' { break }
        mut start = i
        loop i < len and clean[i] != ',' and clean[i] != ')' { i += 1 }
        mut end = i
        loop end > start and (clean[end - 1] == ' ' or clean[end - 1] == '\t') { end -= 1 }
        let p_type = copy_slice_to_string(clean, start, end - start)

        let adapt_ok = try_adapt_int_literal(st, p_type, cur_a, cur_a.line, cur_a.col)
        let a_type = infer_expr_type(st, cur_a)
        if not types_are_compatible(p_type, a_type) {
            if not adapt_ok { }
            else if a_type != "unknown" or st.error_count == 0 {
                mut msg_sb = create_sb(128)
                sb_append_str(@msg_sb, "Type mismatch in call argument ")
                sb_append_int(@msg_sb, arg_idx)
                sb_append_str(@msg_sb, ": expected '")
                sb_append_str(@msg_sb, p_type)
                sb_append_str(@msg_sb, "', got '")
                sb_append_str(@msg_sb, a_type)
                sb_append_str(@msg_sb, "'")
                report_error("semantic", cur_a.line, cur_a.col, sb_to_string(@msg_sb))
                st.error_count += 1
            }
        }
        arg_idx += 1
        cur_a = cur_a.next
        if i < len and clean[i] == ',' { i += 1 }
    }
    return ret_type
}

// Validates Kind variant constructor arguments and arity.
act check_variant_constructor(st: @SymbolTable, expr: @ExprNode, k_sym: @KindSym, v_sym: @VariantSym) -> string {
    if v_sym.payload_type != null and str.len(v_sym.payload_type) > 0 {
        if expr.arg_count != 1 {
            report_error("semantic", expr.line, expr.col, "Mismatched argument count in variant constructor")
            st.error_count += 1
        }
        if expr.first_arg != null {
            let adapt_ok = try_adapt_int_literal(st, v_sym.payload_type, expr.first_arg, expr.line, expr.col)
            let a_type = infer_expr_type(st, expr.first_arg)
            if not types_are_compatible(v_sym.payload_type, a_type) {
                if not adapt_ok { }
                else if a_type != "unknown" or st.error_count == 0 {
                    mut msg_sb = create_sb(128)
                    sb_append_str(@msg_sb, "Type mismatch in call argument 1: expected '")
                    sb_append_str(@msg_sb, v_sym.payload_type)
                    sb_append_str(@msg_sb, "', got '")
                    sb_append_str(@msg_sb, a_type)
                    sb_append_str(@msg_sb, "'")
                    report_error("semantic", expr.first_arg.line, expr.first_arg.col, sb_to_string(@msg_sb))
                    st.error_count += 1
                }
            }
        }
    } else if v_sym.field_count > 0 {
        if expr.arg_count != v_sym.field_count {
            report_error("semantic", expr.line, expr.col, "Mismatched argument count in variant constructor")
            st.error_count += 1
        }
        mut cur_f = v_sym.first_field
        mut cur_a = expr.first_arg
        mut arg_idx: i32 = 1
        loop cur_f != null and cur_a != null {
            let adapt_ok = try_adapt_int_literal(st, cur_f.type_name, cur_a, cur_a.line, cur_a.col)
            let a_type = infer_expr_type(st, cur_a)
            if not types_are_compatible(cur_f.type_name, a_type) {
                if not adapt_ok { }
                else if a_type != "unknown" or st.error_count == 0 {
                    mut msg_sb = create_sb(128)
                    sb_append_str(@msg_sb, "Type mismatch in call argument ")
                    sb_append_int(@msg_sb, arg_idx)
                    sb_append_str(@msg_sb, ": expected '")
                    sb_append_str(@msg_sb, cur_f.type_name)
                    sb_append_str(@msg_sb, "', got '")
                    sb_append_str(@msg_sb, a_type)
                    sb_append_str(@msg_sb, "'")
                    report_error("semantic", cur_a.line, cur_a.col, sb_to_string(@msg_sb))
                    st.error_count += 1
                }
            }
            arg_idx += 1
            cur_f = cur_f.next
            cur_a = cur_a.next
        }
    } else {
        if expr.arg_count != 0 {
            report_error("semantic", expr.line, expr.col, "Variant does not take arguments")
            st.error_count += 1
        }
    }
    return k_sym.name
}
