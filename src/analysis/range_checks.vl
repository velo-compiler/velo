// Range loop semantic analysis and type checking.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "symbol_table.vl"
use "type_checker.vl"
use "literal_check.vl"
use "../ast/int_types.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"

// Checks if a loop step expression is a non-positive constant (<= 0).
act is_range_step_non_positive(expr: @ExprNode) -> bool {
    if expr == null { return false }
    if expr.kind == EXPR_UNARY and expr.op == TOK_MINUS { return true }
    if expr.kind == EXPR_INT {
        if expr.int_val < 0 { return true }
        if expr.int_val == 0 {
            if expr.str_val == null { return true }
            mut overflow = false
            let val = parse_u64_checked(expr.str_val, @overflow)
            if not overflow and val == 0 as u64 {
                return true
            }
        }
    }
    return false
}

// Checks if a loop range endpoint expression is a negative constant (< 0).
act is_range_endpoint_negative(expr: @ExprNode) -> bool {
    if expr == null { return false }
    if expr.kind == EXPR_UNARY and expr.op == TOK_MINUS { return true }
    if expr.kind == EXPR_INT and expr.int_val < 0 { return true }
    return false
}

// Determines the unified variable type for a numeric loop range [start..end],
// enforcing signed/unsigned safety and safe same-signedness widening.
act unify_loop_range_type(st: @SymbolTable, stmt: @StmtNode, start_t: string, end_t: string) -> string {
    if start_t == null or end_t == null { return "i32" }
    if start_t == end_t { return start_t }

    // Signed / unsigned mismatch between non-literal expressions: strictly reject.
    if is_signed_int_name(start_t) != is_signed_int_name(end_t) {
        mut msg = create_sb(96)
        sb_append_str(@msg, "Cannot mix ")
        if is_signed_int_name(start_t) {
            sb_append_str(@msg, "signed '")
            sb_append_str(@msg, start_t)
            sb_append_str(@msg, "' and unsigned '")
            sb_append_str(@msg, end_t)
            sb_append_str(@msg, "' in range loop. Use explicit cast 'as ")
            sb_append_str(@msg, end_t)
            sb_append_str(@msg, "'.")
        } else {
            sb_append_str(@msg, "unsigned '")
            sb_append_str(@msg, start_t)
            sb_append_str(@msg, "' and signed '")
            sb_append_str(@msg, end_t)
            sb_append_str(@msg, "' in range loop. Use explicit cast 'as ")
            sb_append_str(@msg, start_t)
            sb_append_str(@msg, "'.")
        }
        report_error("semantic", stmt.line, stmt.col, sb_to_string(@msg))
        st.error_count += 1
        return "i32"
    }

    // Both signed: widen to wider signed type without truncation.
    if is_signed_int_name(start_t) and is_signed_int_name(end_t) {
        if start_t == "i64" or end_t == "i64" { return "i64" }
        if start_t == "isize" or end_t == "isize" { return "isize" }
        if start_t == "i32" or end_t == "i32" { return "i32" }
        if start_t == "i16" or end_t == "i16" { return "i16" }
        return "i8"
    }

    // Both unsigned: widen to wider unsigned type without truncation.
    if is_unsigned_int_name(start_t) and is_unsigned_int_name(end_t) {
        if start_t == "u64" or end_t == "u64" { return "u64" }
        if start_t == "usize" or end_t == "usize" { return "usize" }
        if start_t == "u32" or end_t == "u32" { return "u32" }
        if start_t == "u16" or end_t == "u16" { return "u16" }
        return "u8"
    }

    return "i32"
}

// Validates semantic correctness of a range loop [start..end[:step]].
act check_range_loop(st: @SymbolTable, stmt: @StmtNode) -> string {
    let start_t = infer_expr_type(st, stmt.loop_start)
    let end_t = infer_expr_type(st, stmt.loop_end)

    if not is_int_type(start_t) {
        if start_t != "unknown" or st.error_count == 0 {
            mut msg = create_sb(64)
            sb_append_str(@msg, "Range loop start endpoint must be an integer type, got '")
            sb_append_str(@msg, start_t)
            sb_append_char(@msg, '\'')
            report_error("semantic", stmt.loop_start.line, stmt.loop_start.col, sb_to_string(@msg))
            st.error_count += 1
        }
    }
    if not is_int_type(end_t) {
        if end_t != "unknown" or st.error_count == 0 {
            mut msg = create_sb(64)
            sb_append_str(@msg, "Range loop end endpoint must be an integer type, got '")
            sb_append_str(@msg, end_t)
            sb_append_char(@msg, '\'')
            report_error("semantic", stmt.loop_end.line, stmt.loop_end.col, sb_to_string(@msg))
            st.error_count += 1
        }
    }

    // Determine unified element type using standard widening hierarchy
    mut of_elem = "i32"
    if start_t == "u64" or end_t == "u64" {
        of_elem = "u64"
    } else if start_t == "i64" or end_t == "i64" {
        of_elem = "i64"
    } else if start_t == "usize" or end_t == "usize" {
        of_elem = "usize"
    } else if start_t == "u32" or end_t == "u32" {
        of_elem = "u32"
    }

    // Negative endpoint check for unsigned types MUST run before literal adaptation
    if is_unsigned_int_type(of_elem) {
        if is_range_endpoint_negative(stmt.loop_start) {
            mut msg = create_sb(64)
            sb_append_str(@msg, "Range loop endpoint cannot be negative for unsigned type '")
            sb_append_str(@msg, of_elem)
            sb_append_char(@msg, '\'')
            report_error("semantic", stmt.loop_start.line, stmt.loop_start.col, sb_to_string(@msg))
            st.error_count += 1
        }
        if is_range_endpoint_negative(stmt.loop_end) {
            mut msg = create_sb(64)
            sb_append_str(@msg, "Range loop endpoint cannot be negative for unsigned type '")
            sb_append_str(@msg, of_elem)
            sb_append_char(@msg, '\'')
            report_error("semantic", stmt.loop_end.line, stmt.loop_end.col, sb_to_string(@msg))
            st.error_count += 1
        }
    }

    // Check signed/unsigned mismatch between non-literal expressions
    let is_start_lit = is_unsuffixed_int_literal(stmt.loop_start) or is_unsuffixed_int_expr(stmt.loop_start)
    let is_end_lit = is_unsuffixed_int_literal(stmt.loop_end) or is_unsuffixed_int_expr(stmt.loop_end)

    if not is_start_lit and not is_end_lit and start_t != end_t {
        if is_signed_int_name(start_t) != is_signed_int_name(end_t) {
            mut msg = create_sb(96)
            sb_append_str(@msg, "Cannot mix ")
            if is_signed_int_name(start_t) {
                sb_append_str(@msg, "signed '")
                sb_append_str(@msg, start_t)
                sb_append_str(@msg, "' and unsigned '")
                sb_append_str(@msg, end_t)
                sb_append_str(@msg, "' in range loop. Use explicit cast 'as ")
                sb_append_str(@msg, end_t)
                sb_append_str(@msg, "'.")
            } else {
                sb_append_str(@msg, "unsigned '")
                sb_append_str(@msg, start_t)
                sb_append_str(@msg, "' and signed '")
                sb_append_str(@msg, end_t)
                sb_append_str(@msg, "' in range loop. Use explicit cast 'as ")
                sb_append_str(@msg, start_t)
                sb_append_str(@msg, "'.")
            }
            report_error("semantic", stmt.line, stmt.col, sb_to_string(@msg))
            st.error_count += 1
            return "i32"
        }
    }

    // Adapt unsuffixed literals to the unified of_elem type if not negative
    if is_start_lit and not is_range_endpoint_negative(stmt.loop_start) {
        try_adapt_int_literal(st, of_elem, stmt.loop_start, stmt.loop_start.line, stmt.loop_start.col)
    }
    if is_end_lit and not is_range_endpoint_negative(stmt.loop_end) {
        try_adapt_int_literal(st, of_elem, stmt.loop_end, stmt.loop_end.line, stmt.loop_end.col)
    }

    // Step checking and adaptation
    if stmt.loop_step != null {
        if is_unsuffixed_int_literal(stmt.loop_step) or is_unsuffixed_int_expr(stmt.loop_step) {
            try_adapt_int_literal(st, of_elem, stmt.loop_step, stmt.loop_step.line, stmt.loop_step.col)
        }
        let step_t = infer_expr_type(st, stmt.loop_step)
        if not is_int_type(step_t) {
            if step_t != "unknown" or st.error_count == 0 {
                mut msg = create_sb(64)
                sb_append_str(@msg, "Range loop step must be an integer type, got '")
                sb_append_str(@msg, step_t)
                sb_append_char(@msg, '\'')
                report_error("semantic", stmt.loop_step.line, stmt.loop_step.col, sb_to_string(@msg))
                st.error_count += 1
            }
        } else if is_range_step_non_positive(stmt.loop_step) {
            report_error("semantic", stmt.loop_step.line, stmt.loop_step.col, "Range loop step must be greater than zero")
            st.error_count += 1
        }
    }

    return of_elem
}
