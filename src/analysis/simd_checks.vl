// 128-bit SIMD Vector Types: compile-time argument checks for SIMD constructors
// (f32x4, f32x4_splat, i32x4, i32x4_splat).
// Mutual mirror of velo/codegen_c.py::_lower_simd_call — both stages must reject
// the same programs with character-identical messages.
use "type_checker.vl"
use "symbol_table.vl"
use "../frontend/token.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../ast/expr.vl"
use "../ast/types.vl"

act is_simd_constructor(name: string) -> bool {
    if name == null { return false }
    return name == "f32x4" or name == "f32x4_splat" or name == "i32x4" or name == "i32x4_splat"
}

act check_simd_constructor(st: @SymbolTable, expr: @ExprNode) -> string {
    let name = expr.callee.str_val
    mut argc: usize = 0
    mut cur_a = expr.first_arg
    loop cur_a != null { argc += 1; cur_a = cur_a.next }

    if name == "f32x4" {
        if argc != 4 {
            report_error("semantic", expr.line, expr.col, "f32x4 constructor expects exactly 4 arguments: (x, y, z, w)")
            st.error_count += 1
            return "unknown"
        }
        mut cur = expr.first_arg
        loop cur != null {
            let t = infer_expr_type(st, cur)
            if t != "unknown" and not is_float_type(t) and not is_int_type(t) {
                mut sb = create_sb(96)
                sb_append_str(@sb, "f32x4 constructor arguments must be float or integer (got ")
                sb_append_str(@sb, t)
                sb_append_char(@sb, ')')
                report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
                st.error_count += 1
                return "unknown"
            }
            cur = cur.next
        }
        return "f32x4"
    }

    if name == "f32x4_splat" {
        if argc != 1 {
            report_error("semantic", expr.line, expr.col, "f32x4_splat constructor expects exactly 1 argument: (val)")
            st.error_count += 1
            return "unknown"
        }
        let t = infer_expr_type(st, expr.first_arg)
        if t != "unknown" and not is_float_type(t) and not is_int_type(t) {
            mut sb = create_sb(96)
            sb_append_str(@sb, "f32x4_splat constructor argument must be float or integer (got ")
            sb_append_str(@sb, t)
            sb_append_char(@sb, ')')
            report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
            st.error_count += 1
            return "unknown"
        }
        return "f32x4"
    }

    if name == "i32x4" {
        if argc != 4 {
            report_error("semantic", expr.line, expr.col, "i32x4 constructor expects exactly 4 arguments: (x, y, z, w)")
            st.error_count += 1
            return "unknown"
        }
        mut cur = expr.first_arg
        loop cur != null {
            let t = infer_expr_type(st, cur)
            if t != "unknown" and not is_int_type(t) {
                mut sb = create_sb(96)
                sb_append_str(@sb, "i32x4 constructor arguments must be integer (got ")
                sb_append_str(@sb, t)
                sb_append_char(@sb, ')')
                report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
                st.error_count += 1
                return "unknown"
            }
            cur = cur.next
        }
        return "i32x4"
    }

    if name == "i32x4_splat" {
        if argc != 1 {
            report_error("semantic", expr.line, expr.col, "i32x4_splat constructor expects exactly 1 argument: (val)")
            st.error_count += 1
            return "unknown"
        }
        let t = infer_expr_type(st, expr.first_arg)
        if t != "unknown" and not is_int_type(t) {
            mut sb = create_sb(96)
            sb_append_str(@sb, "i32x4_splat constructor argument must be integer (got ")
            sb_append_str(@sb, t)
            sb_append_char(@sb, ')')
            report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
            st.error_count += 1
            return "unknown"
        }
        return "i32x4"
    }

    return "unknown"
}

act simd_tok_str(op: i32) -> string {
    if op == TOK_PLUS { return "+" }
    if op == TOK_MINUS { return "-" }
    if op == TOK_STAR { return "*" }
    if op == TOK_SLASH { return "/" }
    if op == TOK_EQ { return "==" }
    if op == TOK_NEQ { return "!=" }
    if op == TOK_NOT { return "!" }
    if op == TOK_PERCENT { return "%" }
    return "op"
}

act check_simd_member_access(st: @SymbolTable, expr: @ExprNode, clean_type: string) -> string {
    let m = expr.member_name
    if m != "x" and m != "y" and m != "z" and m != "w" {
        mut sb = create_sb(96)
        sb_append_str(@sb, "unknown SIMD vector member '")
        sb_append_str(@sb, m)
        sb_append_str(@sb, "' (available: x, y, z, w)")
        report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
        st.error_count += 1
        return "unknown"
    }
    if clean_type == "f32x4" { return "f32" }
    return "i32"
}

act check_simd_index(st: @SymbolTable, expr: @ExprNode, clean_type: string) -> string {
    let it = infer_expr_type(st, expr.index)
    if it != "unknown" and not is_int_type(it) {
        mut sb = create_sb(96)
        sb_append_str(@sb, "SIMD vector index must be an integer (got ")
        sb_append_str(@sb, it)
        sb_append_char(@sb, ')')
        report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
        st.error_count += 1
        return "unknown"
    }
    if clean_type == "f32x4" { return "f32" }
    return "i32"
}

act check_simd_binary(st: @SymbolTable, expr: @ExprNode, l_t: string, r_t: string) -> string {
    if not is_simd_type(l_t) and not is_simd_type(r_t) { return null }
    if l_t != r_t {
        mut sb = create_sb(96)
        sb_append_str(@sb, "mismatched operand types for SIMD binary operator '")
        sb_append_str(@sb, simd_tok_str(expr.op))
        sb_append_str(@sb, "': ")
        sb_append_str(@sb, l_t)
        sb_append_str(@sb, " and ")
        sb_append_str(@sb, r_t)
        report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
        st.error_count += 1
        return "unknown"
    }
    if expr.op == TOK_EQ or expr.op == TOK_NEQ { return "bool" }
    if expr.op == TOK_PLUS or expr.op == TOK_MINUS or expr.op == TOK_STAR or expr.op == TOK_SLASH {
        if l_t == "i32x4" and expr.op == TOK_SLASH {
            report_error("semantic", expr.line, expr.col, "integer vector division is not supported")
            st.error_count += 1
            return "unknown"
        }
        return l_t
    }
    mut sb = create_sb(96)
    sb_append_str(@sb, "operator '")
    sb_append_str(@sb, simd_tok_str(expr.op))
    sb_append_str(@sb, "' not supported for SIMD vector type ")
    sb_append_str(@sb, l_t)
    report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
    st.error_count += 1
    return "unknown"
}

act check_simd_unary(st: @SymbolTable, expr: @ExprNode, sub_t: string) -> string {
    if not is_simd_type(sub_t) { return null }
    if expr.op == TOK_MINUS { return sub_t }
    mut sb = create_sb(96)
    sb_append_str(@sb, "unary operator '")
    sb_append_str(@sb, simd_tok_str(expr.op))
    sb_append_str(@sb, "' not supported for SIMD vector type ")
    sb_append_str(@sb, sub_t)
    report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
    st.error_count += 1
    return "unknown"
}

act check_simd_constant(st: @SymbolTable, expr: @ExprNode) -> string {
    let m = expr.member_name
    mut sb = create_sb(160)
    sb_append_str(@sb, "unknown simd constant '")
    sb_append_str(@sb, m)
    sb_append_str(@sb, "' (simd functions are: dot, min, max, sqrt)")
    if m == "dot" or m == "min" or m == "max" or m == "sqrt" {
        sb_append_str(@sb, " (functions need parens: simd.")
        sb_append_str(@sb, m)
        sb_append_str(@sb, "(...))")
    }
    report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
    st.error_count += 1
    return "unknown"
}

act check_simd_call(st: @SymbolTable, expr: @ExprNode, member: string) -> string {
    if member != "dot" and member != "min" and member != "max" and member != "sqrt" {
        mut sb = create_sb(96)
        sb_append_str(@sb, "unknown simd member '")
        sb_append_str(@sb, member)
        sb_append_str(@sb, "' (functions: dot, min, max, sqrt are available)")
        report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
        st.error_count += 1
        return "unknown"
    }

    mut argc: usize = 0
    mut cur_a = expr.first_arg
    loop cur_a != null { argc += 1; cur_a = cur_a.next }

    if member == "dot" {
        if argc != 2 {
            report_error("semantic", expr.line, expr.col, "simd.dot expects exactly 2 arguments: (f32x4 a, f32x4 b)")
            st.error_count += 1
            return "unknown"
        }
        let t0 = infer_expr_type(st, expr.first_arg)
        if t0 != "unknown" and t0 != "f32x4" {
            mut sb = create_sb(64)
            sb_append_str(@sb, "simd.dot expects f32x4 arguments (got ")
            sb_append_str(@sb, t0)
            sb_append_char(@sb, ')')
            report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
            st.error_count += 1
            return "unknown"
        }
        let t1 = infer_expr_type(st, expr.first_arg.next)
        if t1 != "unknown" and t1 != "f32x4" {
            mut sb = create_sb(64)
            sb_append_str(@sb, "simd.dot expects f32x4 arguments (got ")
            sb_append_str(@sb, t1)
            sb_append_char(@sb, ')')
            report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
            st.error_count += 1
            return "unknown"
        }
        return "f32"
    }

    if member == "sqrt" {
        if argc != 1 {
            report_error("semantic", expr.line, expr.col, "simd.sqrt expects exactly 1 argument: (f32x4 a)")
            st.error_count += 1
            return "unknown"
        }
        let t0 = infer_expr_type(st, expr.first_arg)
        if t0 != "unknown" and t0 != "f32x4" {
            mut sb = create_sb(64)
            sb_append_str(@sb, "simd.sqrt expects f32x4 argument (got ")
            sb_append_str(@sb, t0)
            sb_append_char(@sb, ')')
            report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
            st.error_count += 1
            return "unknown"
        }
        return "f32x4"
    }

    if member == "min" or member == "max" {
        if argc != 2 {
            mut sb = create_sb(64)
            sb_append_str(@sb, "simd.")
            sb_append_str(@sb, member)
            sb_append_str(@sb, " expects exactly 2 arguments: (a, b)")
            report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
            st.error_count += 1
            return "unknown"
        }
        let t0 = infer_expr_type(st, expr.first_arg)
        if t0 != "unknown" and t0 != "f32x4" and t0 != "i32x4" {
            mut sb = create_sb(64)
            sb_append_str(@sb, "simd.")
            sb_append_str(@sb, member)
            sb_append_str(@sb, " expects f32x4 or i32x4 arguments (got ")
            sb_append_str(@sb, t0)
            sb_append_char(@sb, ')')
            report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
            st.error_count += 1
            return "unknown"
        }
        let t1 = infer_expr_type(st, expr.first_arg.next)
        if t0 != "unknown" and t1 != "unknown" and t1 != t0 {
            mut sb = create_sb(80)
            sb_append_str(@sb, "simd.")
            sb_append_str(@sb, member)
            sb_append_str(@sb, " expects matching operand types (got ")
            sb_append_str(@sb, t0)
            sb_append_str(@sb, " and ")
            sb_append_str(@sb, t1)
            sb_append_char(@sb, ')')
            report_error("semantic", expr.line, expr.col, sb_to_string(@sb))
            st.error_count += 1
            return "unknown"
        }
        return t0
    }

    return "unknown"
}

