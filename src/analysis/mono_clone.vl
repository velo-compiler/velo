// Statement cloning and substitution during monomorphization.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../common/utils.vl"
use "monomorphize_types.vl"
use "monomorphize_expr.vl"
use "mono_subst.vl"
use "mono_infer.vl"
use "mono_unroll.vl"

act mono_clone_stmt(m: @Monomorphizer, s: @StmtNode, scope: @ScopeEntry, params: string, args: string, ret_type: string) -> @StmtNode {
    if s == null { return null }
    if s.kind == STMT_EXPR {
        let ex = mono_clone_expr(m, s.expr, scope, params, args)
        return make_expr_stmt(ex, s.line, s.col)
    }
    if s.kind == STMT_RETURN {
        let ex = mono_clone_expr(m, s.val_expr, scope, params, args)
        if ex != null and ex.kind == EXPR_VARIANT and ex.type_name == null { ex.type_name = ret_type }
        return make_return_stmt(ex, s.line, s.col)
    }
    if s.kind == STMT_FAIL {
        let ex = mono_clone_expr(m, s.val_expr, scope, params, args)
        return make_fail_stmt(ex, s.line, s.col)
    }
    if s.kind == STMT_BREAK { return make_break_stmt(s.line, s.col) }
    if s.kind == STMT_CONTINUE { return make_continue_stmt(s.line, s.col) }

    if s.kind == STMT_VAR_DECL {
        mut vt: string = null
        if s.type_name != null and str.len(s.type_name) > 0 {
            vt = mono_subst(s.type_name, params, args)
            mono_check_type(m, vt)
            vt = mono_normalize_type(vt)
        }
        let ve = mono_clone_expr(m, s.val_expr, scope, params, args)
        if ve != null and ve.kind == EXPR_VARIANT and (ve.type_name == null or str.len(ve.type_name) == 0) { ve.type_name = vt }
        if ve != null and ve.kind == EXPR_STRUCT_LIT and vt != null and str.len(vt) > 0 { ve.type_name = vt }
        mut inferred = vt
        if inferred == null or str.len(inferred) == 0 { inferred = mono_infer_type(ve, scope) }
        mut new_sc: @ScopeEntry = mem.alloc(@ScopeEntry, 1)
        new_sc.name = s.name; new_sc.type_name = inferred; new_sc.next = scope
        let res = make_var_decl_stmt(s.name, vt, ve, s.is_mut, s.line, s.col)
        return res
    }
    if s.kind == STMT_DESTRUCTURE {
        let ve = mono_clone_expr(m, s.val_expr, scope, params, args)
        mut first_p: @ParamNode = null
        mut last_p: @ParamNode = null
        mut cur_p = s.first_param
        loop cur_p != null {
            mut pt: string = null
            if cur_p.type_name != null and str.len(cur_p.type_name) > 0 {
                pt = mono_subst(cur_p.type_name, params, args)
                mono_check_type(m, pt)
                pt = mono_normalize_type(pt)
            }
            let np = make_param_node(cur_p.name, pt, cur_p.line, cur_p.col)
            if first_p == null { first_p = np; last_p = np }
            else { last_p.next = np; last_p = np }
            cur_p = cur_p.next
        }
        return make_destructure_stmt(first_p, s.param_count, ve, s.is_mut, s.line, s.col)
    }
    if s.kind == STMT_ASSIGN {
        let tgt = mono_clone_expr(m, s.expr, scope, params, args)
        let ve = mono_clone_expr(m, s.val_expr, scope, params, args)
        return make_assign_stmt(tgt, s.op, ve, s.line, s.col)
    }
    if s.kind == STMT_IF {
        let cond = mono_clone_expr(m, s.expr, scope, params, args)
        if cond != null and cond.kind == EXPR_BOOL {
            if cond.bool_val { return mono_clone_stmt(m, s.body, scope, params, args, ret_type) }
            if s.else_branch != null { return mono_clone_stmt(m, s.else_branch, scope, params, args, ret_type) }
            return make_block_stmt(null, 0, s.line, s.col)
        }
        let then_b = mono_clone_stmt(m, s.body, scope, params, args, ret_type)
        let else_b = mono_clone_stmt(m, s.else_branch, scope, params, args, ret_type)
        return make_if_stmt(cond, then_b, else_b, s.line, s.col)
    }
    if s.kind == STMT_BLOCK {
        mut first_s: @StmtNode = null
        mut last_s: @StmtNode = null
        mut cur = s.first_stmt
        mut cur_scope = scope
        loop cur != null {
            let cs = mono_clone_stmt(m, cur, cur_scope, params, args, ret_type)
            if cs != null and not (cs.kind == STMT_BLOCK and cs.stmt_count == 0 and cs.first_stmt == null) {
                if cs.kind == STMT_VAR_DECL {
                    mut sc: @ScopeEntry = mem.alloc(@ScopeEntry, 1)
                    sc.name = cs.name; mut sc_t = cs.type_name
                    if sc_t == null or str.len(sc_t) == 0 { sc_t = mono_infer_type(cs.val_expr, cur_scope) }
                    sc.type_name = sc_t; sc.next = cur_scope; cur_scope = sc
                }
                if cs.kind == STMT_DESTRUCTURE {
                    let rhs_t = mono_infer_type(cs.val_expr, cur_scope)
                    mut cur_p = cs.first_param
                    mut p_idx: usize = 0
                    loop cur_p != null {
                        mut sc_t = cur_p.type_name
                        if (sc_t == null or str.len(sc_t) == 0) and is_tuple_type(rhs_t) {
                            sc_t = tuple_elem_type(rhs_t, p_idx)
                        }
                        if cur_p.name != "_" {
                            mut sc: @ScopeEntry = mem.alloc(@ScopeEntry, 1)
                            sc.name = cur_p.name; sc.type_name = sc_t; sc.next = cur_scope; cur_scope = sc
                        }
                        p_idx += 1
                        cur_p = cur_p.next
                    }
                }
                if first_s == null { first_s = cs; last_s = cs }
                else { last_s.next = cs; last_s = cs }
            }
            cur = cur.next
        }
        return make_block_stmt(first_s, s.stmt_count, s.line, s.col)
    }
    if s.kind == STMT_MATCH {
        let subj = mono_clone_expr(m, s.expr, scope, params, args)
        let subj_type = mono_infer_type(subj, scope)
        mut cur_c = s.first_case
        mut first_case: @CaseNode = null
        mut last_case: @CaseNode = null
        loop cur_c != null {
            mut first_v: @ExprNode = null
            mut last_v: @ExprNode = null
            mut cv = cur_c.first_val
            loop cv != null {
                let v = mono_clone_expr(m, cv, scope, params, args)
                if v != null and v.kind == EXPR_VARIANT and v.type_name == null {
                    v.type_name = subj_type
                }
                if first_v == null { first_v = v; last_v = v }
                else { last_v.next = v; last_v = v }
                cv = cv.next
            }
            let c_body = mono_clone_stmt(m, cur_c.body, scope, params, args, ret_type)
            let case_node = make_case_node(first_v, cur_c.val_count, cur_c.is_default, c_body, cur_c.line, cur_c.col)
            if first_case == null { first_case = case_node; last_case = case_node }
            else { last_case.next = case_node; last_case = case_node }
            cur_c = cur_c.next
        }
        return make_match_stmt(subj, first_case, s.case_count, s.line, s.col)
    }
    if s.kind == STMT_LOOP {
        let unrolled = mono_unroll_loop(m, s, scope, params, args, ret_type)
        if unrolled != null { return unrolled }
        if s.loop_start != null or s.loop_end != null {
            let b = mono_clone_stmt(m, s.body, scope, params, args, ret_type)
            let st = mono_clone_expr(m, s.loop_start, scope, params, args)
            let en = mono_clone_expr(m, s.loop_end, scope, params, args)
            let sp = mono_clone_expr(m, s.loop_step, scope, params, args)
            return make_loop_stmt(s.loop_var, st, en, sp, s.is_inclusive, b, s.line, s.col)
        }
        // 5.2: shelf value loop — the iterator takes the substituted element
        // type and is pushed onto the body's scope BEFORE cloning it.
        // Slice 4: the optional index binding is a usize scope entry.
        if s.is_of {
            let coll = mono_clone_expr(m, s.expr, scope, params, args)
            let coll_t = mono_infer_type(coll, scope)
            let ee = mono_shelf_elem(coll_t)
            mut of_scope: @ScopeEntry = mem.alloc(@ScopeEntry, 1)
            of_scope.name = s.loop_var; of_scope.type_name = ee; of_scope.next = scope
            if s.loop_index != null and str.len(s.loop_index) > 0 {
                let iscope: @ScopeEntry = mem.alloc(@ScopeEntry, 1)
                iscope.name = s.loop_index; iscope.type_name = "usize"; iscope.next = of_scope
                of_scope = iscope
            }
            let of_body = mono_clone_stmt(m, s.body, of_scope, params, args, ret_type)
            return make_loop_of_stmt(s.loop_var, s.loop_index, coll, of_body, s.line, s.col)
        }
        let b = mono_clone_stmt(m, s.body, scope, params, args, ret_type)
        if s.expr != null {
            let ex = mono_clone_expr(m, s.expr, scope, params, args)
            return make_loop_expr_stmt(ex, s.is_count, b, s.line, s.col)
        }
        return make_loop_inf_stmt(b, s.line, s.col)
    }
    if s.kind == STMT_ZONE {
        let b = mono_clone_stmt(m, s.body, scope, params, args, ret_type)
        mut zs: @ExprNode = null
        if s.expr != null {
            zs = mono_clone_expr(m, s.expr, scope, params, args)
        }
        return make_zone_stmt(b, zs, s.line, s.col)
    }
    if s.kind == STMT_UNSAFE {
        let b = mono_clone_stmt(m, s.body, scope, params, args, ret_type)
        return make_unsafe_stmt(b, s.line, s.col)
    }
    if s.kind == STMT_DEFER {
        let ds = mono_clone_stmt(m, s.deferred_stmt, scope, params, args, ret_type)
        return make_defer_stmt(ds, s.line, s.col)
    }
    return s
}

