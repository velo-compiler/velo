// 5.3 Math Library: compile-time checks + constant tables for the sys.math
// namespace (slice 1: constants as bare member properties + sqrt/pow/cbrt
// calls). Mutual mirror of velo/codegen_c.py::_math_expect / MATH_CALLS /
// MATH_CONSTANTS - both stages must reject the same programs with the same
// words.
// Unknown CALL members report the closed-set wording (shelf unknown member
// precedent) and return false; constants report their mirrored wording.
// The property path returns "f64" for the four constants and reports the
// mirrored unknown-constant wording otherwise (with the parens hint when the
// member names a known function).
use "type_checker.vl"
use "symbol_table.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../ast/expr.vl"
use "../frontend/token.vl"

// Digit strings MUST stay character-identical with velo/codegen_c.py
// MATH_CONSTANTS (both compilers spell the same decimal bytes into the
// emitted C); the emit wraps them in parens on both stages.
act math_constant_digits(name: string) -> string {
    if name == "PI" { return "3.14159265358979323846" }
    if name == "TAU" { return "6.28318530717958647692" }
    if name == "RAD2DEG" { return "57.2957795130823208768" }
    if name == "DEG2RAD" { return "0.01745329251994329577" }
    return ""
}

// Signature text per checked member ("" = not a checked math member).
// Must stay character-identical with velo/codegen_c.py::MATH_CALLS
// (S2 grows the trig family — atan2 is 2-ary).
act math_member_sig(member: string) -> string {
    if member == "sqrt" { return ": (f64 x)" }
    if member == "pow" { return ": (f64 base, f64 exp)" }
    if member == "cbrt" { return ": (f64 x)" }
    if member == "sin" { return ": (f64 x)" }
    if member == "cos" { return ": (f64 x)" }
    if member == "tan" { return ": (f64 x)" }
    if member == "atan2" { return ": (f64 y, f64 x)" }
    if member == "acos" { return ": (f64 x)" }
    if member == "asin" { return ": (f64 x)" }
    if member == "exp" { return ": (f64 x)" }
    if member == "log" { return ": (f64 x)" }
    if member == "log2" { return ": (f64 x)" }
    return ""
}

// Expected argument count per checked member (same curves as MATH_CALLS).
act math_member_arity(member: string) -> i32 {
    if member == "pow" or member == "atan2" { return 2 }
    if member == "sqrt" or member == "cbrt" { return 1 }
    if member == "sin" or member == "cos" or member == "tan" { return 1 }
    if member == "acos" or member == "asin" { return 1 }
    if member == "exp" or member == "log" or member == "log2" { return 1 }
    return -1
}

// 5.3: every shipped math call yields f64 — arity-membership-driven so each
// new slice lands here for free ("" = unknown math member, not a type; the
// compare-constant hint semantics match stage 1's `member in MATH_CALLS`).
act math_member_ret(member: string) -> string {
    if math_member_arity(member) > -1 { return "f64" }
    return ""
}

// The widening accept set, identical spell list on both stages: every int
// width plus f32/f64. An int/float arg rides an emitted (double)(...) cast;
// bool/string/collection/struct args reject. Mirrors stage 1's use of
// DYN_INT_TYPES / DYN_FLOAT_TYPES.
act math_arg_ok(t: string) -> bool {
    if t == "i8" { return true }
    if t == "i16" { return true }
    if t == "i32" { return true }
    if t == "i64" { return true }
    if t == "u8" { return true }
    if t == "u16" { return true }
    if t == "u32" { return true }
    if t == "u64" { return true }
    if t == "usize" { return true }
    if t == "isize" { return true }
    if t == "f32" { return true }
    if t == "f64" { return true }
    return false
}

// Wording mirror of stage 1's got-reject (str house pattern).
act math_got_msg(member: string, got: string) -> string {
    let msb = create_sb(192)
    sb_append_str(@msb, "math."); sb_append_str(@msb, member); sb_append_str(@msb, " expects f64 (or int) arguments (got ")
    sb_append_str(@msb, got); sb_append_str(@msb, ")")
    return sb_to_string(@msb)
}

// Entry point: returns false after reporting (the infer branch then yields
// "unknown"); unknown members report the closed-set wording and return false.
act check_math_call(st: @SymbolTable, expr: @ExprNode, member: string) -> bool {
    let arity = math_member_arity(member)
    if arity < 0 {
        // 5.3: the math namespace is CLOSED for calls (shelf unknown member
        // precedent) — wording mirror of stage 1's _math_expect raise.
        let msb = create_sb(256)
        sb_append_str(@msb, "unknown math member '"); sb_append_str(@msb, member); sb_append_str(@msb, "' (functions: sqrt, pow, cbrt, sin, cos, tan, atan2, acos, asin, exp, log, log2; constants: PI, TAU, RAD2DEG, DEG2RAD are available)")
        report_error("semantic", expr.line, expr.col, sb_to_string(@msb)); st.error_count += 1
        return false
    }
    mut argc: usize = 0
    mut cur_a = expr.first_arg
    loop cur_a != null { argc += 1; cur_a = cur_a.next }
    if argc != (arity as usize) {
        let msb = create_sb(192)
        sb_append_str(@msb, "math."); sb_append_str(@msb, member); sb_append_str(@msb, " expects exactly ")
        sb_append_int(@msb, arity)
        if arity == 1 { sb_append_str(@msb, " argument") } else { sb_append_str(@msb, " arguments") }
        sb_append_str(@msb, math_member_sig(member))
        report_error("semantic", expr.line, expr.col, sb_to_string(@msb)); st.error_count += 1
        return false
    }
    mut cur = expr.first_arg
    loop cur != null {
        let t = infer_expr_type(st, cur)
        if !math_arg_ok(t) {
            report_error("semantic", expr.line, expr.col, math_got_msg(member, t)); st.error_count += 1
            return false
        }
        cur = cur.next
    }
    return true
}

// The bare-property path (math.PI): "f64" for the four constants; the
// mirrored unknown-constant wording otherwise (functions-need-parens hint
// when the member names a known call shape).
act check_math_constant(st: @SymbolTable, expr: @ExprNode) -> string {
    if str.len(math_constant_digits(expr.member_name)) > 0 { return "f64" }
    let msb = create_sb(256)
    sb_append_str(@msb, "unknown math constant '"); sb_append_str(@msb, expr.member_name); sb_append_str(@msb, "' (constants: PI, TAU, RAD2DEG, DEG2RAD)")
    if str.len(math_member_ret(expr.member_name)) > 0 {  // member names a known function shape
        sb_append_str(@msb, " (functions need parens: math.")
        sb_append_str(@msb, expr.member_name)
        sb_append_str(@msb, "(...))")
    }
    report_error("semantic", expr.line, expr.col, sb_to_string(@msb)); st.error_count += 1
    return "unknown"
}
