// Lexical scope stack, symbol registration, and struct/function registry for Velo.
use "../common/diagnostics.vl"
use "../ast/expr.vl"
use "scope.vl"

// Symbol kind constants
let SYM_VAR: i32 = 1
let SYM_PARAM: i32 = 2
let SYM_GLOBAL: i32 = 3

// Represents an individual variable or parameter symbol in a lexical scope.
data Symbol {
    name: string
    type_name: string
    kind: i32
    is_mut: bool
    line: i32
    col: i32
    zone_depth: i32
    pointer_origin_depth: i32
    orig_type: string
    is_narrowed: bool
    next: @Symbol
}

// Represents a nested lexical scope (e.g. block, function, loop).
data Scope {
    parent: @Scope
    first_sym: @Symbol
    sym_count: usize
}

// Represents a field member inside a registered struct blueprint.
data StructFieldSym {
    name: string
    type_name: string
    has_default: bool
    default_value: @ExprNode
    line: i32
    col: i32
    next: @StructFieldSym
}

// Represents a registered struct blueprint.
data StructSym {
    name: string
    first_field: @StructFieldSym
    field_count: usize
    line: i32
    col: i32
    next: @StructSym
}

// Represents a variant inside a registered kind.
data VariantSym {
    name: string
    discriminant: i32
    has_discriminant: bool
    payload_type: string
    first_field: @StructFieldSym
    field_count: usize
    line: i32
    col: i32
    next: @VariantSym
}

// Represents a registered kind (enum / tagged union).
data KindSym {
    name: string
    first_variant: @VariantSym
    variant_count: usize
    is_tagged_union: bool
    line: i32
    col: i32
    next: @KindSym
}

// Represents a formal parameter in a registered function signature.
data ParamSym {
    name: string
    type_name: string
    next: @ParamSym
}

// Represents a registered function or foreign extern signature.
data FunctionSym {
    name: string
    return_type: string
    first_param: @ParamSym
    param_count: usize
    is_extern: bool
    line: i32
    col: i32
    next: @FunctionSym
}

// Unified Symbol Table maintaining global and nested lexical scopes.
data SymbolTable {
    first_struct: @StructSym
    struct_count: usize
    first_kind: @KindSym
    kind_count: usize
    first_function: @FunctionSym
    function_count: usize
    global_scope: @Scope
    current_scope: @Scope
    error_count: usize
    has_operator_overloads: bool
    fresh_counter: usize  // 5.2: unique shelf temp names during C emission
    unsafe_shelf_index: bool  // 5.2 slice 11: --unsafe-shelf-index lowers index READS unguarded
    unsafe_array_index: bool  // 74.3: --unsafe-array-index lowers fixed array index unguarded
    is_test: bool  // 6.5: native test runner mode
    source_file: string  // 6.5: source file path for assertion diagnostics
    no_line_directives: bool  // 9.1: --no-line-directives suppresses #line directives
    zone_counter: usize
    current_func_ret_type: string
    current_func_name: string
    current_zone_depth: i32
    strict_safety: bool
    current_unsafe_depth: i32
    current_loop_depth: i32
}

// Initializes the root Symbol Table.
act init_symbol_table(st: @SymbolTable) {
    st.first_struct = null; st.struct_count = 0; st.first_kind = null; st.kind_count = 0; st.first_function = null; st.function_count = 0
    st.global_scope = create_scope(null); st.current_scope = st.global_scope; st.error_count = 0; st.has_operator_overloads = false
    st.fresh_counter = 0; st.unsafe_shelf_index = false; st.unsafe_array_index = false; st.is_test = false; st.source_file = ""; st.no_line_directives = false
    st.zone_counter = 0; st.current_func_ret_type = ""; st.current_func_name = ""; st.current_zone_depth = 0
    st.strict_safety = false; st.current_unsafe_depth = 0
    st.current_loop_depth = 0
}

// Registers a struct blueprint in the symbol table.
act register_struct(st: @SymbolTable, name: string, line: i32, col: i32) -> @StructSym {
    mut s: @StructSym = mem.alloc(@StructSym, 1)
    s.name = name
    s.first_field = null
    s.field_count = 0
    s.line = line
    s.col = col
    s.next = st.first_struct

    st.first_struct = s
    st.struct_count += 1
    return s
}

// Adds a field to a registered struct blueprint.
act struct_add_field(st_sym: @StructSym, fname: string, ftype: string, has_default: bool, default_value: @ExprNode, line: i32, col: i32) -> bool {
    mut f: @StructFieldSym = mem.alloc(@StructFieldSym, 1)
    f.name = fname
    f.type_name = ftype
    f.has_default = has_default
    f.default_value = default_value
    f.line = line
    f.col = col
    f.next = null

    if st_sym.first_field == null {
        st_sym.first_field = f
    } else {
        mut cur = st_sym.first_field
        loop cur.next != null {
            cur = cur.next
        }
        cur.next = f
    }
    st_sym.field_count += 1
    return true
}

// Finds a struct blueprint by name.
act find_struct(st: @SymbolTable, name: string) -> @StructSym {
    mut cur = st.first_struct
    loop cur != null {
        if cur.name == name {
            return cur
        }
        cur = cur.next
    }
    return null
}

// Finds a field inside a struct blueprint.
act find_struct_field(st_sym: @StructSym, fname: string) -> @StructFieldSym {
    if st_sym == null { return null }
    mut cur = st_sym.first_field
    loop cur != null {
        if cur.name == fname {
            return cur
        }
        cur = cur.next
    }
    return null
}

// Registers a function signature in the symbol table.
act register_function(st: @SymbolTable, name: string, ret_type: string, is_extern: bool, line: i32, col: i32) -> @FunctionSym {
    mut fn_sym: @FunctionSym = mem.alloc(@FunctionSym, 1)
    fn_sym.name = name
    fn_sym.return_type = ret_type
    fn_sym.first_param = null
    fn_sym.param_count = 0
    fn_sym.is_extern = is_extern
    fn_sym.line = line
    fn_sym.col = col
    fn_sym.next = st.first_function

    st.first_function = fn_sym
    st.function_count += 1
    if name != null and str.len(name) >= 8 and name[0] == 'v' and name[1] == 'e' and name[2] == 'l' and name[3] == 'o' and name[4] == '_' and name[5] == 'o' and name[6] == 'p' and name[7] == '_' {
        st.has_operator_overloads = true
    }
    return fn_sym
}

// Adds a parameter to a registered function signature.
act function_add_param(fn_sym: @FunctionSym, pname: string, ptype: string) -> bool {
    mut p: @ParamSym = mem.alloc(@ParamSym, 1)
    p.name = pname
    p.type_name = ptype
    p.next = null

    if fn_sym.first_param == null {
        fn_sym.first_param = p
    } else {
        mut cur = fn_sym.first_param
        loop cur.next != null {
            cur = cur.next
        }
        cur.next = p
    }
    fn_sym.param_count += 1
    return true
}

// Finds a registered function by name.
act find_function(st: @SymbolTable, name: string) -> @FunctionSym {
    mut cur = st.first_function
    loop cur != null {
        if cur.name == name {
            return cur
        }
        cur = cur.next
    }
    return null
}

// Registers a kind in the symbol table.
act register_kind(st: @SymbolTable, name: string, is_tagged_union: bool, line: i32, col: i32) -> @KindSym {
    mut k: @KindSym = mem.alloc(@KindSym, 1)
    k.name = name
    k.first_variant = null
    k.variant_count = 0
    k.is_tagged_union = is_tagged_union
    k.line = line
    k.col = col
    k.next = st.first_kind
    st.first_kind = k
    st.kind_count += 1
    return k
}

// Adds a variant to a registered kind.
act kind_add_variant(k_sym: @KindSym, name: string, disc: i32, has_disc: bool, ptype: string, f_field: @StructFieldSym, f_count: usize, line: i32, col: i32) -> bool {
    mut v: @VariantSym = mem.alloc(@VariantSym, 1)
    v.name = name
    v.discriminant = disc
    v.has_discriminant = has_disc
    v.payload_type = ptype
    v.first_field = f_field
    v.field_count = f_count
    v.line = line
    v.col = col
    v.next = null

    if k_sym.first_variant == null {
        k_sym.first_variant = v
    } else {
        mut cur = k_sym.first_variant
        loop cur.next != null { cur = cur.next }
        cur.next = v
    }
    k_sym.variant_count += 1
    return true
}

// Finds a registered kind by name.
act find_kind(st: @SymbolTable, name: string) -> @KindSym {
    if st == null or name == null { return null }
    mut cur = st.first_kind
    loop cur != null {
        if cur.name == name { return cur }
        cur = cur.next
    }
    return null
}

// Finds a variant inside a kind symbol.
act find_variant(k_sym: @KindSym, vname: string) -> @VariantSym {
    if k_sym == null or vname == null { return null }
    mut cur = k_sym.first_variant
    loop cur != null {
        if cur.name == vname { return cur }
        cur = cur.next
    }
    return null
}

// Finds a kind containing a variant name (used for contextual resolution).
act find_kind_by_variant(st: @SymbolTable, vname: string) -> @KindSym {
    if st == null or vname == null { return null }
    mut cur_k = st.first_kind
    loop cur_k != null {
        if find_variant(cur_k, vname) != null { return cur_k }
        cur_k = cur_k.next
    }
    return null
}
