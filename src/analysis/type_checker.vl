// Semantic analysis, type inference, and validation algorithms for Velo.
use sys.io
use sys.mem
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "symbol_table.vl"
use "../common/diagnostics.vl"


// Checks if a name represents a recognized type (primitive or user-defined struct or kind).
act is_known_type(st: @SymbolTable, name: string) -> bool {
    if name == null { return false }
    let clean = strip_pointer_prefix(name)
    if is_primitive_type(clean) { return true }
    if find_struct(st, clean) != null { return true }
    if find_kind(st, clean) != null { return true }
    return false
}

// Infers the static type of an expression AST node.
act infer_expr_type(st: @SymbolTable, expr: @ExprNode) -> string {
    if expr == null { return "void" }

    if expr.kind == EXPR_INT { if expr.type_name != null and str.len(expr.type_name) > 0 { return expr.type_name } return "i32" }
    if expr.kind == EXPR_FLOAT { if expr.type_name != null and str.len(expr.type_name) > 0 { return expr.type_name } return "f32" }
    if expr.kind == EXPR_STRING { return "string" }
    if expr.kind == EXPR_BOOL { return "bool" }
    if expr.kind == EXPR_NULL { return "@void" }

    if expr.kind == EXPR_VARIANT {
        if expr.type_name != null and str.len(expr.type_name) > 0 { return expr.type_name }
        let k_sym = find_kind_by_variant(st, expr.member_name)
        if k_sym != null {
            expr.type_name = k_sym.name
            return k_sym.name
        }
        report_error("semantic", expr.line, expr.col, "Cannot infer kind type for variant")
        st.error_count += 1
        return "unknown"
    }

    if expr.kind == EXPR_IDENT {
        let sym = resolve_variable(st, expr.str_val)
        if sym == null {
            if is_known_type(st, expr.str_val) {
                return expr.str_val
            }
            if expr.str_val == "io" or expr.str_val == "mem" or expr.str_val == "fs" or expr.str_val == "str" or expr.str_val == "sys" {
                return expr.str_val
            }
            report_error("semantic", expr.line, expr.col, "Undeclared identifier")
            st.error_count += 1
            return "unknown"
        }
        return sym.type_name
    }

    if expr.kind == EXPR_MEMBER {
        if expr.target.kind == EXPR_IDENT {
            let k_sym = find_kind(st, expr.target.str_val)
            if k_sym != null {
                let v_sym = find_variant(k_sym, expr.member_name)
                if v_sym != null { return k_sym.name }
            }
        }
        let target_type = infer_expr_type(st, expr.target)
        let clean_type = strip_pointer_prefix(target_type)
        let st_sym = find_struct(st, clean_type)
        if st_sym == null {
            report_error("semantic", expr.line, expr.col, "Member access on non-struct type")
            st.error_count += 1
            return "unknown"
        }
        let f_sym = find_struct_field(st_sym, expr.member_name)
        if f_sym == null {
            report_error("semantic", expr.line, expr.col, "Struct does not have member field")
            st.error_count += 1
            return "unknown"
        }
        return f_sym.type_name
    }

    if expr.kind == EXPR_INDEX {
        let target_type = infer_expr_type(st, expr.target)
        if target_type == "string" { return "u8" }
        if str.len(target_type) > 0 and target_type[0] == '@' { return strip_pointer_prefix(target_type) }
        report_error("semantic", expr.line, expr.col, "Cannot index non-pointer / non-string type"); st.error_count += 1; return "unknown"
    }

    if expr.kind == EXPR_DEREF {
        let sub_type = infer_expr_type(st, expr.operand)
        if str.len(sub_type) > 0 and sub_type[0] == '@' { return strip_pointer_prefix(sub_type) }
        report_error("semantic", expr.line, expr.col, "Cannot dereference non-pointer value"); st.error_count += 1; return "unknown"
    }

    if expr.kind == EXPR_ADDRESS_OF {
        let sub_type = infer_expr_type(st, expr.operand)
        return prepend_pointer_prefix(sub_type)
    }

    if expr.kind == EXPR_CAST {
        return expr.type_name
    }

    if expr.kind == EXPR_CALL {
        // Builtin intrinsics
        if expr.callee.kind == EXPR_MEMBER {
            let target = expr.callee.target
            let member = expr.callee.member_name
            if target.kind == EXPR_IDENT {
                if target.str_val == "mem" {
                    if member == "alloc" or member == "heap_alloc" {
                        if expr.first_arg != null {
                            let arg_type = infer_expr_type(st, expr.first_arg)
                            return arg_type
                        }
                    }
                    if member == "used" or member == "heap_used" { return "usize" }
                    return "void"
                }
                if target.str_val == "fs" {
                    if member == "read_file" { return "string" }
                    if member == "size" { return "usize" }
                    if member == "exists" or member == "write_file" or member == "remove" { return "bool" }
                }
                if target.str_val == "str" {
                    if member == "len" { return "usize" }
                }
                if target.str_val == "io" {
                    return "void"
                }
            }
        }

        // User functions or Kind variant constructors
        if expr.callee.kind == EXPR_MEMBER and expr.callee.target.kind == EXPR_IDENT {
            let k_sym = find_kind(st, expr.callee.target.str_val)
            if k_sym != null {
                let v_sym = find_variant(k_sym, expr.callee.member_name)
                if v_sym != null { return k_sym.name }
            }
        }
        if expr.callee.kind == EXPR_IDENT {
            let fn_sym = find_function(st, expr.callee.str_val)
            if fn_sym == null {
                report_error("semantic", expr.line, expr.col, "Call to undefined function")
                st.error_count += 1
                return "unknown"
            }
            if expr.arg_count != fn_sym.param_count {
                report_error("semantic", expr.line, expr.col, "Mismatched argument count in function call")
                st.error_count += 1
            }
            mut cur_a = expr.first_arg
            mut cur_p = fn_sym.first_param
            loop cur_a != null and cur_p != null {
                if cur_a.kind == EXPR_VARIANT and (cur_a.type_name == null or str.len(cur_a.type_name) == 0) {
                    cur_a.type_name = cur_p.type_name
                }
                cur_a = cur_a.next
                cur_p = cur_p.next
            }
            return fn_sym.return_type
        }
        return "unknown"
    }

    if expr.kind == EXPR_STRUCT_LIT {
        let st_sym = find_struct(st, expr.type_name)
        if st_sym == null {
            report_error("semantic", expr.line, expr.col, "Instantiating unknown struct type")
            st.error_count += 1
            return "unknown"
        }
        mut cur_init = expr.first_init
        loop cur_init != null {
            let f_sym = find_struct_field(st_sym, cur_init.name)
            if f_sym == null {
                report_error("semantic", cur_init.line, cur_init.col, "Unknown field in struct literal")
                st.error_count += 1
            } else {
                let val_type = infer_expr_type(st, cur_init.value)
                if not types_are_compatible(f_sym.type_name, val_type) {
                    report_error("semantic", cur_init.line, cur_init.col, "Type mismatch in field initializer")
                    st.error_count += 1
                }
            }
            cur_init = cur_init.next
        }
        return expr.type_name
    }

    if expr.kind == EXPR_BINARY {
        let left_type = infer_expr_type(st, expr.left)
        let right_type = infer_expr_type(st, expr.right)
        if expr.op == TOK_EQ or expr.op == TOK_NEQ or expr.op == TOK_LT or expr.op == TOK_LTE or expr.op == TOK_GT or expr.op == TOK_GTE or expr.op == TOK_AND or expr.op == TOK_OR {
            return "bool"
        }
        return left_type
    }

    if expr.kind == EXPR_UNARY {
        let sub_type = infer_expr_type(st, expr.operand)
        if expr.op == TOK_NOT {
            return "bool"
        }
        return sub_type
    }

    return "unknown"
}

// Validates semantic correctness of a single statement.
act check_statement(st: @SymbolTable, expected_ret_type: string, stmt: @StmtNode) {
    if stmt == null { return }

    if stmt.kind == STMT_VAR_DECL {
        if stmt.val_expr != null {
            if stmt.type_name != null and str.len(stmt.type_name) > 0 {
                if stmt.val_expr.kind == EXPR_VARIANT and (stmt.val_expr.type_name == null or str.len(stmt.val_expr.type_name) == 0) {
                    stmt.val_expr.type_name = stmt.type_name
                }
            }
            let val_type = infer_expr_type(st, stmt.val_expr)
            if stmt.type_name != null and str.len(stmt.type_name) > 0 {
                if not types_are_compatible(stmt.type_name, val_type) {
                    report_error("semantic", stmt.line, stmt.col, "Type mismatch in variable declaration")
                    st.error_count += 1
                }
            } else {
                stmt.type_name = val_type
            }
        }
        define_variable(st, stmt.name, stmt.type_name, stmt.is_mut, stmt.line, stmt.col)
    } else if stmt.kind == STMT_ASSIGN {
        let target_type = infer_expr_type(st, stmt.expr)
        if stmt.val_expr.kind == EXPR_VARIANT and (stmt.val_expr.type_name == null or str.len(stmt.val_expr.type_name) == 0) {
            stmt.val_expr.type_name = target_type
        }
        let val_type = infer_expr_type(st, stmt.val_expr)
        if not types_are_compatible(target_type, val_type) {
            report_error("semantic", stmt.line, stmt.col, "Type mismatch in assignment")
            st.error_count += 1
        }
    } else if stmt.kind == STMT_IF {
        infer_expr_type(st, stmt.expr)
        check_statement(st, expected_ret_type, stmt.body)
        if stmt.else_branch != null { check_statement(st, expected_ret_type, stmt.else_branch) }
    } else if stmt.kind == STMT_LOOP {
        if stmt.loop_start != null {
            infer_expr_type(st, stmt.loop_start)
            infer_expr_type(st, stmt.loop_end)
            if stmt.loop_step != null { infer_expr_type(st, stmt.loop_step) }
        } else if stmt.expr != null {
            infer_expr_type(st, stmt.expr)
        }
        enter_scope(st)
        mut vname = "it"
        if stmt.loop_var != null and str.len(stmt.loop_var) > 0 { vname = stmt.loop_var }
        define_variable(st, vname, "i32", false, stmt.line, stmt.col)
        check_statement(st, expected_ret_type, stmt.body)
        exit_scope(st)
    } else if stmt.kind == STMT_ZONE { check_statement(st, expected_ret_type, stmt.body)
    } else if stmt.kind == STMT_DEFER { check_statement(st, expected_ret_type, stmt.deferred_stmt)
    } else if stmt.kind == STMT_RETURN {
        if stmt.val_expr != null {
            if stmt.val_expr.kind == EXPR_VARIANT and (stmt.val_expr.type_name == null or str.len(stmt.val_expr.type_name) == 0) {
                stmt.val_expr.type_name = expected_ret_type
            }
            let ret_type = infer_expr_type(st, stmt.val_expr)
            if not types_are_compatible(expected_ret_type, ret_type) {
                report_error("semantic", stmt.line, stmt.col, "Return type mismatch")
                st.error_count += 1
            }
        }
    } else if stmt.kind == STMT_BREAK or stmt.kind == STMT_CONTINUE {
        return
    } else if stmt.kind == STMT_MATCH {
        let m_type = infer_expr_type(st, stmt.expr)
        let k_sym = find_kind(st, m_type)
        mut cur_case = stmt.first_case
        loop cur_case != null {
            enter_scope(st)
            mut val = cur_case.first_val
            loop val != null {
                if val.kind == EXPR_VARIANT and (val.type_name == null or str.len(val.type_name) == 0) { val.type_name = m_type }
                infer_expr_type(st, val)
                if k_sym != null and val.kind == EXPR_VARIANT {
                    let v_sym = find_variant(k_sym, val.member_name)
                    if v_sym != null {
                        if v_sym.field_count > 0 {
                            mut cur_b = val.first_arg; mut cur_f = v_sym.first_field
                            loop cur_b != null and cur_f != null {
                                if cur_b.kind == EXPR_IDENT { define_variable(st, cur_b.str_val, cur_f.type_name, false, cur_b.line, cur_b.col) }
                                cur_b = cur_b.next; cur_f = cur_f.next
                            }
                        } else if v_sym.payload_type != null and val.first_arg != null {
                            if val.first_arg.kind == EXPR_IDENT { define_variable(st, val.first_arg.str_val, v_sym.payload_type, false, val.first_arg.line, val.first_arg.col) }
                        }
                    }
                }
                val = val.next
            }
            if cur_case.body != null { check_statement(st, expected_ret_type, cur_case.body) }
            exit_scope(st)
            cur_case = cur_case.next
        }
    } else if stmt.kind == STMT_BLOCK {
        enter_scope(st)
        mut cur = stmt.first_stmt
        loop cur != null { check_statement(st, expected_ret_type, cur); cur = cur.next }
        exit_scope(st)
    } else if stmt.kind == STMT_EXPR { infer_expr_type(st, stmt.expr) }
}

// Executes multi-pass semantic analysis and type verification over an AST program.
act check_program(st: @SymbolTable, prog: @ProgramNode) -> bool {
    // Pass 1: Register all struct and kind declarations
    mut cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_DATA {
            let st_sym = register_struct(st, cur.name, cur.line, cur.col)
            mut cur_f = cur.first_field
            loop cur_f != null { struct_add_field(st_sym, cur_f.name, cur_f.type_name, cur_f.line, cur_f.col); cur_f = cur_f.next }
        } else if cur.kind == DECL_KIND {
            mut is_tu = false; mut v = cur.first_variant
            loop v != null { if v.payload_type != null or v.field_count > 0 { is_tu = true }; v = v.next }
            let k_sym = register_kind(st, cur.name, is_tu, cur.line, cur.col)
            mut cv = cur.first_variant
            loop cv != null {
                mut f_sym: @StructFieldSym = null; mut last_f: @StructFieldSym = null; mut cf = cv.first_field
                loop cf != null {
                    mut fn: @StructFieldSym = mem.alloc(@StructFieldSym, 1)
                    fn.name = cf.name; fn.type_name = cf.type_name; fn.line = cf.line; fn.col = cf.col; fn.next = null
                    if f_sym == null { f_sym = fn; last_f = fn } else { last_f.next = fn; last_f = fn }
                    cf = cf.next
                }
                kind_add_variant(k_sym, cv.name, cv.discriminant, cv.has_discriminant, cv.payload_type, f_sym, cv.field_count, cv.line, cv.col)
                cv = cv.next
            }
        }
        cur = cur.next
    }

    // Pass 1.5: Register all top-level global variables and constants
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == STMT_VAR_DECL {
            mut inf_type = cur.type_name
            if inf_type == null or str.len(inf_type) == 0 {
                if cur.val_expr != null { inf_type = infer_expr_type(st, cur.val_expr) } else { inf_type = "i32" }
            }
            define_variable(st, cur.name, inf_type, cur.is_mut, cur.line, cur.col)
        }
        cur = cur.next
    }

    // Pass 2: Register all function & extern declarations
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_FUNCTION or cur.kind == DECL_EXTERN {
            let fn_sym = register_function(st, cur.name, cur.return_type, cur.kind == DECL_EXTERN, cur.line, cur.col)
            mut cur_p = cur.first_param
            loop cur_p != null { function_add_param(fn_sym, cur_p.name, cur_p.type_name); cur_p = cur_p.next }
        }
        cur = cur.next
    }

    // Pass 3: Validate function bodies, statements, and expressions
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_FUNCTION and cur.body != null {
            enter_scope(st)
            mut cur_p = cur.first_param
            loop cur_p != null { define_parameter(st, cur_p.name, cur_p.type_name, cur_p.line, cur_p.col); cur_p = cur_p.next }
            check_statement(st, cur.return_type, cur.body)
            exit_scope(st)
        }
        cur = cur.next
    }

    return st.error_count == 0
}
