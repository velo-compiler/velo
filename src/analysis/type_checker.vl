// Semantic analysis, type inference, and validation algorithms for Velo.
use sys.io
use sys.mem
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "symbol_table.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../common/act_types.vl"
use "op_resolver.vl"
use "type_check_program.vl"
use "mem_checks.vl"
use "str_checks.vl"
use "shelf_checks.vl"
use "shelf_calls.vl"
use "map_checks.vl"
use "dyn_checks.vl"
use "misc_checks.vl"
use "math_checks.vl"
use "time_checks.vl"
act is_known_type(st: @SymbolTable, name: string) -> bool {
    if name == null { return false }
    let clean = strip_pointer_prefix(name)
    if is_act_type(clean) { return true }
    if is_primitive_type(clean) { return true }; if clean == "Allocator" { return true }; if clean == "Thread" { return true }; if clean == "Mutex" { return true }  // §4.1/§4.2 handles
    if is_shelf_type(clean) { return true }  // 5.2: shelf[T] is a first-class type
    if find_struct(st, clean) != null { return true }
    if find_kind(st, clean) != null { return true }
    return false
}

// Infers the static type of an expression AST node (the wall vocabulary).
act infer_expr_type(st: @SymbolTable, expr: @ExprNode) -> string {
    if expr == null { return "void" }
    if expr.kind == EXPR_INT { if expr.type_name != null and str.len(expr.type_name) > 0 { return expr.type_name } return "i32" }
    if expr.kind == EXPR_FLOAT { if expr.type_name != null and str.len(expr.type_name) > 0 { return expr.type_name } return "f32" }
    if expr.kind == EXPR_STRING { return "string" }
    if expr.kind == EXPR_BOOL { return "bool" }
    if expr.kind == EXPR_NULL { return "@void" }
    if expr.kind == EXPR_VARIANT {
        if expr.type_name != null and str.len(expr.type_name) > 0 { return expr.type_name }
        let k_sym = find_kind_by_variant(st, expr.member_name); if k_sym != null { expr.type_name = k_sym.name; return k_sym.name }
        report_error("semantic", expr.line, expr.col, "Cannot infer kind type for variant"); st.error_count += 1
        return "unknown"
    }

    if expr.kind == EXPR_SHELF_LIT or expr.kind == EXPR_HEAP_SHELF_LIT { return shelf_inferred_type(st, expr) }  // 5.2: shelf constructor literal (heap: slice 10)
    if expr.kind == EXPR_MAP_LIT { return map_inferred_type(st, expr) }  // 5.2 slice 6: map constructor literal
    if expr.kind == EXPR_RING_LIT or expr.kind == EXPR_BITSET_LIT { return check_coll9_inferred_type(st, expr) }  // 5.2 slice 9
    if expr.kind == EXPR_IDENT {
        let sym = resolve_variable(st, expr.str_val)
        if sym == null {
            let fn_sym = find_function(st, expr.str_val)
            if fn_sym != null {
                mut sb = create_sb(64); sb_append_str(@sb, "act("); mut cur_p = fn_sym.first_param; mut p_idx: usize = 0
                loop cur_p != null { if p_idx > 0 { sb_append_str(@sb, ", ") }; sb_append_str(@sb, cur_p.type_name); p_idx += 1; cur_p = cur_p.next }
                sb_append_str(@sb, ") -> "); sb_append_str(@sb, fn_sym.return_type); return sb_to_string(@sb)
            }
            if is_known_type(st, expr.str_val) { return expr.str_val }
            if expr.str_val == "io" or expr.str_val == "mem" or expr.str_val == "fs" or expr.str_val == "str" or expr.str_val == "sys" or expr.str_val == "thread" or expr.str_val == "math" or expr.str_val == "time" { return expr.str_val }  // 5.3/5.5: math + time ride the module pseudo-type
            report_error("semantic", expr.line, expr.col, "Undeclared identifier"); st.error_count += 1
            return "unknown"
        }
        return sym.type_name
    }

    if expr.kind == EXPR_MEMBER {
        if expr.target.kind == EXPR_IDENT and expr.target.str_val == "math" and find_kind(st, expr.target.str_val) == null { return check_math_constant(st, expr) }  // 5.3: constants are bare properties; unknown names reject with the mirrored wording
        if expr.target.kind == EXPR_IDENT and expr.target.str_val == "time" and find_kind(st, expr.target.str_val) == null { return check_time_constant(st, expr) }  // 5.5: time has no constants — bare reads reject with the mirrored wording
        if expr.target.kind == EXPR_IDENT {
            let k_sym = find_kind(st, expr.target.str_val)
            if k_sym != null {
                let v_sym = find_variant(k_sym, expr.member_name)
                if v_sym != null { return k_sym.name }
            }
        }
        let target_type = infer_expr_type(st, expr.target)
        let clean_type = strip_pointer_prefix(target_type)
        if target_type == "dyn" { report_error("semantic", expr.line, expr.col, dyn_gate_error()); st.error_count += 1; return "unknown" }  // 5.2 slice 2: raw dyn exposes no members — cast (as) first; Stage 1 raises the same words
        if is_shelf_type(target_type) { return check_shelf_member_access(st, expr) }  // 5.2: shelf property reads (len = usize; others are loud errors)
        if is_map_type(target_type) { return check_map_member_access(st, expr) }  // 5.2 slice 6: len = usize; others name the map surface
        if is_ring_type(target_type) or is_bitset_type(target_type) { return check_coll9_member_access(st, expr) }  // 5.2 slice 9
        let st_sym = find_struct(st, clean_type)
        if st_sym == null {
            report_error("semantic", expr.line, expr.col, "Member access on non-struct type"); st.error_count += 1
            return "unknown"
        }
        let f_sym = find_struct_field(st_sym, expr.member_name)
        if f_sym == null {
            report_error("semantic", expr.line, expr.col, "Struct does not have member field"); st.error_count += 1; return "unknown"
        }
        return f_sym.type_name
    }

    if expr.kind == EXPR_INDEX {
        let target_type = infer_expr_type(st, expr.target)
        if is_shelf_type(target_type) { return check_shelf_index_read(st, expr) }  // 5.2: bounds are runtime-checked; index type here
        if is_map_type(target_type) { return check_map_index_read(st, expr) }  // 5.2 slice 6: strict key; the miss fatal is runtime
        if is_ring_type(target_type) or is_bitset_type(target_type) { return check_coll9_index(st, expr) }  // 5.2 slice 9: no subscript
        if target_type == "string" { return "u8" }
        if str.len(target_type) > 0 and target_type[0] == '@' { return strip_pointer_prefix(target_type) }
        report_error("semantic", expr.line, expr.col, "Cannot index non-pointer / non-string type"); st.error_count += 1; return "unknown"
    }

    if expr.kind == EXPR_DEREF {
        let sub_type = infer_expr_type(st, expr.operand); if str.len(sub_type) > 0 and sub_type[0] == '@' { return strip_pointer_prefix(sub_type) }
        report_error("semantic", expr.line, expr.col, "Cannot dereference non-pointer value"); st.error_count += 1; return "unknown"
    }

    if expr.kind == EXPR_ADDRESS_OF {
        return prepend_pointer_prefix(infer_expr_type(st, expr.operand))
    }

    if expr.kind == EXPR_CAST {
        // 5.2 slice 2: unboxing a raw dyn must name an accepted target
        if infer_expr_type(st, expr.operand) == "dyn" { check_dyn_unbox_target(st, expr.type_name, expr.line, expr.col) }
        return expr.type_name
    }

    if expr.kind == EXPR_CALL {
        if expr.callee.kind == EXPR_MEMBER {  // builtin intrinsics + str/sys receivers ride the member path
            let target = expr.callee.target
            let member = expr.callee.member_name
            if target.kind == EXPR_IDENT {
                if target.str_val == "mem" {
                    if !check_mem_call(st, expr, member) { return "unknown" }
                    if member == "alloc" or member == "heap_alloc" { if expr.first_arg != null { return infer_expr_type(st, expr.first_arg) } }
                    if member == "used" or member == "heap_used" { return "usize" }
                    // §4.1: mem.current() -> @Allocator; mem.alloc_with(a, @T, count) -> @T
                    if member == "current" { return "@Allocator" }
                    if member == "alloc_with" { if expr.first_arg != null and expr.first_arg.next != null { return infer_expr_type(st, expr.first_arg.next) } }
                    // cm43: mem.realloc(ptr, @T, count) -> @T (like alloc_with)
                    if member == "realloc" { if expr.first_arg != null and expr.first_arg.next != null { return infer_expr_type(st, expr.first_arg.next) }; return "unknown" }
                    return "void"
                }
                // cm42: thread intrinsics - args are compile-checked
                if target.str_val == "thread" {
                    if !check_thread_call(st, expr, member) { return "unknown" }; if member == "spawn" { return "@Thread" }; if member == "join" { return "i32" }; if member == "mutex" { return "@Mutex" }; return "void"
                }
                if target.str_val == "fs" {
                    if member == "read_file" { return "string" }; if member == "size" { return "usize" }; if member == "exists" or member == "write_file" or member == "remove" or member == "remove_file" { return "bool" }
                }
                if target.str_val == "str" { if !check_str_call(st, expr, member) { return "unknown" }; if member == "len" { return "usize" }; if member == "contains" or member == "starts_with" or member == "ends_with" { return "bool" }; if member == "trim" or member == "replace" or member == "to_upper" or member == "to_lower" or member == "concat" { return "string" }; if member == "index_of" { return "i64" }; if member == "split" { return "shelf[string]" } }  // 5.1: -1 = not found; slice 11: split owns its tokens as a shelf
                if target.str_val == "io" { return "void" }
                if target.str_val == "math" { return check_math_call(st, expr, member) }  // 5.3 S4: arg-aware result spell; "unknown" after reporting
                if target.str_val == "time" { return check_time_call(st, expr, member) }  // 5.5: i64 clocks + void sleep; "unknown" after reporting
            }
        }
        if expr.callee.kind == EXPR_MEMBER and expr.callee.target != null and is_shelf_type(infer_expr_type(st, expr.callee.target)) { return check_shelf_member_call(st, expr) }  // 5.2: shelf receivers — put / take; slice 6: map receivers
        if expr.callee.kind == EXPR_MEMBER and expr.callee.target != null and is_map_type(infer_expr_type(st, expr.callee.target)) { return check_map_member_call(st, expr) }  // 5.2 slice 6: put / get / has
        if expr.callee.kind == EXPR_MEMBER and expr.callee.target != null and (is_ring_type(infer_expr_type(st, expr.callee.target)) or is_bitset_type(infer_expr_type(st, expr.callee.target))) { return check_coll9_member_call(st, expr) }  // 5.2 slice 9
        // 5.2 slice 9 user fns or Kind variant constructors
        if expr.callee.kind == EXPR_MEMBER and expr.callee.target.kind == EXPR_IDENT {
            let k_sym = find_kind(st, expr.callee.target.str_val)
            if k_sym != null {
                let v_sym = find_variant(k_sym, expr.callee.member_name)
                if v_sym != null { return k_sym.name }
            }
        }
        if expr.callee.kind == EXPR_MEMBER {
            let target_type = infer_expr_type(st, expr.callee.target)
            let clean_type = strip_pointer_prefix(target_type)
            let st_sym = find_struct(st, clean_type)
            if st_sym != null and find_struct_field(st_sym, expr.callee.member_name) != null {
                let f_sym = find_struct_field(st_sym, expr.callee.member_name)
                if is_act_type(f_sym.type_name) {
                    return get_act_return_type(f_sym.type_name)
                }
            }
            let fn_sym = find_function(st, expr.callee.member_name)
            if fn_sym != null {
                if expr.arg_count + 1 != fn_sym.param_count {
                    report_error("semantic", expr.line, expr.col, "Mismatched argument count in method call")
                    st.error_count += 1
                }
                return fn_sym.return_type
            }
        }
        if expr.callee.kind == EXPR_IDENT {
            let fn_sym = find_function(st, expr.callee.str_val)
            if fn_sym != null {
                if expr.arg_count != fn_sym.param_count {
                    report_error("semantic", expr.line, expr.col, "Mismatched argument count in function call")
                    st.error_count += 1
                }
                mut cur_a = expr.first_arg
                mut cur_p = fn_sym.first_param
                loop cur_a != null and cur_p != null {
                    if cur_a.kind == EXPR_VARIANT and (cur_a.type_name == null or str.len(cur_a.type_name) == 0) {
                        cur_a.type_name = cur_p.type_name
                    }
                    cur_a = cur_a.next
                    cur_p = cur_p.next
                }
                check_shelf_call_args(st, expr, fn_sym)  // 5.2: shelf elems must string-match
                check_map_call_args(st, expr, fn_sym)    // 5.2 slice 6: maps match BOTH slots
                return fn_sym.return_type
            }
            let var_sym = resolve_variable(st, expr.callee.str_val)
            if var_sym != null and is_act_type(var_sym.type_name) {
                return get_act_return_type(var_sym.type_name)
            }
            report_error("semantic", expr.line, expr.col, "Call to undefined function")
            st.error_count += 1
            return "unknown"
        }

        let callee_type = infer_expr_type(st, expr.callee)
        if is_act_type(callee_type) {
            return get_act_return_type(callee_type)
        }
        return "unknown"
    }

    if expr.kind == EXPR_STRUCT_LIT {
        let st_sym = find_struct(st, expr.type_name)
        if st_sym == null {
            report_error("semantic", expr.line, expr.col, "Instantiating unknown struct type"); st.error_count += 1; return "unknown"
        }
        mut cur_init = expr.first_init
        loop cur_init != null {
            let f_sym = find_struct_field(st_sym, cur_init.name)
            if f_sym == null {
                report_error("semantic", cur_init.line, cur_init.col, "Unknown field in struct literal"); st.error_count += 1
            } else {
                let val_type = infer_expr_type(st, cur_init.value)
                if not types_are_compatible(f_sym.type_name, val_type) {
                    report_error("semantic", cur_init.line, cur_init.col, "Type mismatch in field initializer"); st.error_count += 1
                }
            }
            cur_init = cur_init.next
        }
        mut sf = st_sym.first_field  // fields without defaults must be provided
        loop sf != null {
            mut seen_init = expr.first_init; mut covered = false
            loop seen_init != null { if seen_init.name == sf.name { covered = true }; seen_init = seen_init.next }
            if not covered and not sf.has_default {
                report_error("semantic", expr.line, expr.col, "Struct literal is missing field with no default"); st.error_count += 1
            }
            sf = sf.next
        }
        return expr.type_name
    }

    if expr.kind == EXPR_BINARY {
        let left_type = infer_expr_type(st, expr.left); let right_type = infer_expr_type(st, expr.right)
        // 5.2 slice 8: raw dyn arithmetic/compares auto-unbox; the concrete mixed-compare and string-concat walls live in dyn_checks.vl too
        let bin_t = check_dyn_binary(st, expr, left_type, right_type); if bin_t != null { return bin_t }
        let op_fn = find_binary_op(st, expr.op, left_type, right_type); if op_fn != null { return op_fn.return_type }
        if expr.op == TOK_EQ or expr.op == TOK_NEQ or expr.op == TOK_LT or expr.op == TOK_LTE or expr.op == TOK_GT or expr.op == TOK_GTE or expr.op == TOK_AND or expr.op == TOK_OR {
            return "bool"
        }
        return left_type
    }

    if expr.kind == EXPR_UNARY {
        let sub_type = infer_expr_type(st, expr.operand)
        if sub_type == "dyn" { report_error("semantic", expr.line, expr.col, dyn_gate_error()); st.error_count += 1; return "unknown" }  // slice 2: unbox with `as` first
        let op_fn = find_unary_op(st, expr.op, sub_type)
        if op_fn != null { return op_fn.return_type }
        if expr.op == TOK_NOT { return "bool" }
        return sub_type
    }

    return "unknown"
}

// Validates semantic correctness of a single statement.
act check_statement(st: @SymbolTable, expected_ret_type: string, stmt: @StmtNode) {
    if stmt == null { return }
    if stmt.kind == STMT_VAR_DECL {
        check_shelf_annotation(st, stmt.type_name, stmt.val_expr, stmt.line, stmt.col)  // 5.2: annotated shelf pins/rejects (empty literals borrow the elem)
        check_map_annotation(st, stmt.type_name, stmt.val_expr, stmt.line, stmt.col)  // 5.2 slice 6: empty literals borrow BOTH slots / reject mismatches
        check_coll9_annotation(st, stmt.type_name, stmt.val_expr, stmt.line, stmt.col)  // 5.2 slice 9: ring + bitset
        if stmt.val_expr != null {
            if stmt.type_name != null and str.len(stmt.type_name) > 0 {
                if stmt.val_expr.kind == EXPR_VARIANT and (stmt.val_expr.type_name == null or str.len(stmt.val_expr.type_name) == 0) { stmt.val_expr.type_name = stmt.type_name }
            }
            let val_type = infer_expr_type(st, stmt.val_expr)
            if stmt.type_name != null and str.len(stmt.type_name) > 0 {
                // slice 11: contextual lexing routes a bare `shelf` annotation as an
                // identifier, so the wall is name-based (Stage 1 raises in _map_type)
                if strip_pointer_prefix(stmt.type_name) == "shelf" { report_error("semantic", stmt.line, stmt.col, "a bare 'shelf' needs an element type: use shelf[T]"); st.error_count += 1 }
                else if not types_are_compatible(stmt.type_name, val_type) {
                    // 5.2 slice 11: the retired split pairing gets the dedicated words
                    if is_split_retire_pair(stmt.type_name, val_type) { report_error("semantic", stmt.line, stmt.col, split_retire_message(stmt.type_name)); st.error_count += 1 } else { report_error("semantic", stmt.line, stmt.col, "Type mismatch in variable declaration"); st.error_count += 1 }
                }
            } else {
                stmt.type_name = val_type
            }
        }
        define_variable(st, stmt.name, stmt.type_name, stmt.is_mut, stmt.line, stmt.col)
    } else if stmt.kind == STMT_ASSIGN {
        if stmt.expr != null and stmt.expr.kind == EXPR_INDEX and is_map_type(infer_expr_type(st, stmt.expr.target)) {  // 5.2 slice 6: mut / compound-assign / strict key and value
            check_map_assign(st, stmt); infer_expr_type(st, stmt.val_expr)
        } else if stmt.expr != null and stmt.expr.kind == EXPR_INDEX and is_shelf_type(infer_expr_type(st, stmt.expr.target)) { check_shelf_assign(st, stmt); infer_expr_type(st, stmt.val_expr) } else {
        let target_type = infer_expr_type(st, stmt.expr)
        if stmt.val_expr.kind == EXPR_VARIANT and (stmt.val_expr.type_name == null or str.len(stmt.val_expr.type_name) == 0) {
            stmt.val_expr.type_name = target_type
        }
        let val_type = infer_expr_type(st, stmt.val_expr)
        let base_op = get_base_assign_op(stmt.op)
        mut is_valid = types_are_compatible(target_type, val_type)
        if not is_valid and base_op != 0 {
            let op_fn = find_binary_op(st, base_op, target_type, val_type)
            if op_fn != null and types_are_compatible(target_type, op_fn.return_type) { is_valid = true }
        }
        if not is_valid {
            if is_split_retire_pair(target_type, val_type) { report_error("semantic", stmt.line, stmt.col, split_retire_message(target_type)); st.error_count += 1 } else { report_error("semantic", stmt.line, stmt.col, "Type mismatch in assignment"); st.error_count += 1 }  // slice 11: retired split pairing words
        }
        }
    } else if stmt.kind == STMT_IF {
        infer_expr_type(st, stmt.expr)
        check_statement(st, expected_ret_type, stmt.body)
        if stmt.else_branch != null { check_statement(st, expected_ret_type, stmt.else_branch) }
    } else if stmt.kind == STMT_LOOP {
        // 5.2 slice 4/7: `loop v of coll` — the iterator takes the element (K for maps); range/count/condition loops keep the house "i32" var
        mut of_elem = "i32"
        if stmt.is_of { of_elem = check_map_loop_source(st, stmt) } else if stmt.loop_start != null { infer_expr_type(st, stmt.loop_start); infer_expr_type(st, stmt.loop_end); if stmt.loop_step != null { infer_expr_type(st, stmt.loop_step) } } else if stmt.expr != null { infer_expr_type(st, stmt.expr) }
        enter_scope(st)
        mut vname = "it"
        if stmt.loop_var != null and str.len(stmt.loop_var) > 0 { vname = stmt.loop_var }
        define_variable(st, vname, of_elem, false, stmt.line, stmt.col)
        if stmt.loop_index != null and str.len(stmt.loop_index) > 0 { define_variable(st, stmt.loop_index, "usize", false, stmt.line, stmt.col) }
        check_statement(st, expected_ret_type, stmt.body)
        exit_scope(st)
    } else if stmt.kind == STMT_ZONE { check_statement(st, expected_ret_type, stmt.body)
    } else if stmt.kind == STMT_DEFER { check_statement(st, expected_ret_type, stmt.deferred_stmt)
    } else if stmt.kind == STMT_RETURN {
        if stmt.val_expr != null {
            pin_empty_shelf_return(st, stmt.val_expr, expected_ret_type)  // 5.2
            pin_empty_map_return(st, stmt.val_expr, expected_ret_type)    // 5.2 slice 6
            if stmt.val_expr.kind == EXPR_VARIANT and (stmt.val_expr.type_name == null or str.len(stmt.val_expr.type_name) == 0) {
                stmt.val_expr.type_name = expected_ret_type
            }
            let ret_type = infer_expr_type(st, stmt.val_expr)
            if not types_are_compatible(expected_ret_type, ret_type) {
                report_error("semantic", stmt.line, stmt.col, "Return type mismatch")
                st.error_count += 1
            }
        }
    } else if stmt.kind == STMT_BREAK or stmt.kind == STMT_CONTINUE {
        return
    } else if stmt.kind == STMT_MATCH {
        let m_type = infer_expr_type(st, stmt.expr)
        let k_sym = find_kind(st, m_type)
        mut cur_case = stmt.first_case
        loop cur_case != null {
            enter_scope(st)
            mut val = cur_case.first_val
            loop val != null {
                if val.kind == EXPR_VARIANT and (val.type_name == null or str.len(val.type_name) == 0) { val.type_name = m_type }
                infer_expr_type(st, val)
                if k_sym != null and val.kind == EXPR_VARIANT {
                    let v_sym = find_variant(k_sym, val.member_name)
                    if v_sym != null {
                        if v_sym.field_count > 0 {
                            mut cur_b = val.first_arg; mut cur_f = v_sym.first_field
                            loop cur_b != null and cur_f != null {
                                if cur_b.kind == EXPR_IDENT { define_variable(st, cur_b.str_val, cur_f.type_name, false, cur_b.line, cur_b.col) }
                                cur_b = cur_b.next; cur_f = cur_f.next
                            }
                        } else if v_sym.payload_type != null and val.first_arg != null {
                            if val.first_arg.kind == EXPR_IDENT { define_variable(st, val.first_arg.str_val, v_sym.payload_type, false, val.first_arg.line, val.first_arg.col) }
                        }
                    }
                }
                val = val.next
            }
            if cur_case.body != null { check_statement(st, expected_ret_type, cur_case.body) }
            exit_scope(st)
            cur_case = cur_case.next
        }
    } else if stmt.kind == STMT_BLOCK {
        enter_scope(st)
        mut cur = stmt.first_stmt
        loop cur != null { check_statement(st, expected_ret_type, cur); cur = cur.next }
        exit_scope(st)
    } else if stmt.kind == STMT_EXPR { infer_expr_type(st, stmt.expr) }
}

// cm42: compile-checks thread.* intrinsic arguments — the mirror of velo/codegen_c.py::_thread_expect (both stages reject with the same words). Returns false after reporting.
act check_thread_call(st: @SymbolTable, expr: @ExprNode, member: string) -> bool {
    if member == "mutex" { if expr.first_arg != null { report_error("semantic", expr.line, expr.col, "thread.mutex takes no arguments"); st.error_count += 1; return false }; return true }
    let want = ""
    if member == "spawn" { want = "act() -> i32" }; if member == "join" { want = "@Thread" }; if member == "acquire" or member == "release" or member == "free" { want = "@Mutex" }
    if want == "" { return true }
    if expr.first_arg == null or expr.first_arg.next != null { mut msb = create_sb(96); sb_append_str(@msb, "thread."); sb_append_str(@msb, member); sb_append_str(@msb, " takes exactly 1 argument"); report_error("semantic", expr.line, expr.col, sb_to_string(@msb)); st.error_count += 1; return false }
    let got = strip_type_spaces(infer_expr_type(st, expr.first_arg))
    if got != strip_type_spaces(want) {
        let msb = create_sb(160)
        sb_append_str(@msb, "thread."); sb_append_str(@msb, member); sb_append_str(@msb, " expects "); sb_append_str(@msb, want); sb_append_str(@msb, " (got "); sb_append_str(@msb, infer_expr_type(st, expr.first_arg)); sb_append_str(@msb, ")")
        report_error("semantic", expr.line, expr.col, sb_to_string(@msb)); st.error_count += 1
        return false
    }
    return true
}
