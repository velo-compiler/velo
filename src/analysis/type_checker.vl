// Semantic analysis, type inference, and validation algorithms for Velo.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "symbol_table.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../common/act_types.vl"
use "op_resolver.vl"
use "type_check_program.vl"
use "mem_checks.vl"
use "str_checks.vl"
use "shelf_checks.vl"
use "shelf_calls.vl"
use "map_checks.vl"
use "dyn_checks.vl"
use "misc_checks.vl"
use "math_checks.vl"
use "time_checks.vl"
use "os_checks.vl"
use "fs_checks.vl"
use "simd_checks.vl"
use "reflect_checks.vl"
act is_known_type(st: @SymbolTable, name: string) -> bool {
    if name == null { return false }
    let clean = strip_pointer_prefix(name)
    if is_act_type(clean) or is_primitive_type(clean) { return true }
    if clean == "Allocator" or clean == "Thread" or clean == "Mutex" or clean == "File" { return true }
    if is_shelf_type(clean) or find_struct(st, clean) != null or find_kind(st, clean) != null { return true }
    return false
}

// Infers the static type of an expression AST node (the wall vocabulary).
act infer_expr_type(st: @SymbolTable, expr: @ExprNode) -> string {
    if expr == null { return "void" }
    if expr.kind == EXPR_INT { if expr.type_name != null and str.len(expr.type_name) > 0 { return expr.type_name } return "i32" }
    if expr.kind == EXPR_FLOAT { if expr.type_name != null and str.len(expr.type_name) > 0 { return expr.type_name } return "f32" }
    if expr.kind == EXPR_STRING { return "string" }; if expr.kind == EXPR_BOOL { return "bool" }; if expr.kind == EXPR_NULL { return "@void" }
    if expr.kind == EXPR_VARIANT {
        if expr.type_name != null and str.len(expr.type_name) > 0 { return expr.type_name }
        let k_sym = find_kind_by_variant(st, expr.member_name); if k_sym != null { expr.type_name = k_sym.name; return k_sym.name }
        report_error("semantic", expr.line, expr.col, "Cannot infer kind type for variant"); st.error_count += 1
        return "unknown"
    }

    if expr.kind == EXPR_SHELF_LIT or expr.kind == EXPR_HEAP_SHELF_LIT { return shelf_inferred_type(st, expr) }  // 5.2: shelf constructor literal (heap: slice 10)
    if expr.kind == EXPR_MAP_LIT or expr.kind == EXPR_HEAP_MAP_LIT { return map_inferred_type(st, expr) }  // 5.2 slice 6: map constructor literal
    if expr.kind == EXPR_RING_LIT or expr.kind == EXPR_BITSET_LIT { return check_coll9_inferred_type(st, expr) }  // 5.2 slice 9
    if expr.kind == EXPR_IDENT {
        let sym = resolve_variable(st, expr.str_val)
        if sym == null {
            if is_reflect_builtin(expr.str_val) { return check_reflect_bare_constant(st, expr) }
            let fn_sym = find_function(st, expr.str_val)
            if fn_sym != null {
                mut sb = create_sb(64); sb_append_str(@sb, "act("); mut cur_p = fn_sym.first_param; mut p_idx: usize = 0
                loop cur_p != null { if p_idx > 0 { sb_append_str(@sb, ", ") }; sb_append_str(@sb, cur_p.type_name); p_idx += 1; cur_p = cur_p.next }
                sb_append_str(@sb, ") -> "); sb_append_str(@sb, fn_sym.return_type); return sb_to_string(@sb)
            }
            if is_known_type(st, expr.str_val) { return expr.str_val }
            if expr.str_val == "assert" { return "act(bool, string) -> void" }
            if expr.str_val == "io" or expr.str_val == "mem" or expr.str_val == "fs" or expr.str_val == "str" or expr.str_val == "sys" or expr.str_val == "thread" or expr.str_val == "math" or expr.str_val == "time" or expr.str_val == "os" or expr.str_val == "simd" or expr.str_val == "shelf" or expr.str_val == "map" { return expr.str_val }
            report_error("semantic", expr.line, expr.col, "Undeclared identifier"); st.error_count += 1
            return "unknown"
        }
        return sym.type_name
    }

    if expr.kind == EXPR_MEMBER {
        if expr.target.kind == EXPR_IDENT and expr.target.str_val == "math" and find_kind(st, expr.target.str_val) == null { return check_math_constant(st, expr) }; if expr.target.kind == EXPR_IDENT and expr.target.str_val == "time" and find_kind(st, expr.target.str_val) == null { return check_time_constant(st, expr) }; if expr.target.kind == EXPR_IDENT and expr.target.str_val == "os" and find_kind(st, expr.target.str_val) == null { return check_os_constant(st, expr) }; if expr.target.kind == EXPR_IDENT and expr.target.str_val == "fs" and find_kind(st, expr.target.str_val) == null { return check_fs_constant(st, expr) }; if expr.target.kind == EXPR_IDENT and expr.target.str_val == "simd" and find_kind(st, expr.target.str_val) == null { return check_simd_constant(st, expr) }
        if expr.target.kind == EXPR_IDENT {
            let k_sym = find_kind(st, expr.target.str_val)
            if k_sym != null {
                let v_sym = find_variant(k_sym, expr.member_name)
                if v_sym != null { return k_sym.name }
            }
        }
        let target_type = infer_expr_type(st, expr.target)
        let clean_type = strip_pointer_prefix(target_type)
        if is_or_type(target_type) {
            if expr.member_name == "ok" { return "bool" }
            if expr.member_name == "val" { return or_type_success(target_type) }
            if expr.member_name == "err" { return or_type_error(target_type) }
            report_error("semantic", expr.line, expr.col, "Outcome type only provides .ok, .val, and .err")
            st.error_count += 1
            return "unknown"
        }
        if target_type == "dyn" { report_error("semantic", expr.line, expr.col, dyn_gate_error()); st.error_count += 1; return "unknown" }  // 5.2 slice 2: raw dyn exposes no members — cast (as) first; Stage 1 raises the same words
        if is_shelf_type(target_type) { return check_shelf_member_access(st, expr) }  // 5.2: shelf property reads (len = usize; others are loud errors)
        if is_map_type(target_type) { return check_map_member_access(st, expr) }  // 5.2 slice 6: len = usize; others name the map surface
        if is_ring_type(target_type) or is_bitset_type(target_type) { return check_coll9_member_access(st, expr) }  // 5.2 slice 9
        if is_simd_type(clean_type) { return check_simd_member_access(st, expr, clean_type) }
        let st_sym = find_struct(st, clean_type)
        if st_sym == null { report_error("semantic", expr.line, expr.col, "Member access on non-struct type"); st.error_count += 1; return "unknown" }
        let f_sym = find_struct_field(st_sym, expr.member_name)
        if f_sym == null { report_error("semantic", expr.line, expr.col, "Struct does not have member field"); st.error_count += 1; return "unknown" }
        return f_sym.type_name
    }

    if expr.kind == EXPR_INDEX {
        let target_type = infer_expr_type(st, expr.target)
        let clean_type = strip_pointer_prefix(target_type)
        if is_simd_type(clean_type) { return check_simd_index(st, expr, clean_type) }
        if is_shelf_type(target_type) { return check_shelf_index_read(st, expr) }  // 5.2: bounds are runtime-checked; index type here
        if is_map_type(target_type) { return check_map_index_read(st, expr) }  // 5.2 slice 6: strict key; the miss fatal is runtime
        if is_ring_type(target_type) or is_bitset_type(target_type) { return check_coll9_index(st, expr) }  // 5.2 slice 9: no subscript
        if target_type == "string" { return "u8" }
        if str.len(target_type) > 0 and target_type[0] == '@' { return strip_pointer_prefix(target_type) }
        report_error("semantic", expr.line, expr.col, "Cannot index non-pointer / non-string type"); st.error_count += 1; return "unknown"
    }

    if expr.kind == EXPR_DEREF {
        let sub_type = infer_expr_type(st, expr.operand); if str.len(sub_type) > 0 and sub_type[0] == '@' { return strip_pointer_prefix(sub_type) }
        report_error("semantic", expr.line, expr.col, "Cannot dereference non-pointer value"); st.error_count += 1; return "unknown"
    }

    if expr.kind == EXPR_ADDRESS_OF { return prepend_pointer_prefix(infer_expr_type(st, expr.operand)) }
    if expr.kind == EXPR_CAST {
        if infer_expr_type(st, expr.operand) == "dyn" { check_dyn_unbox_target(st, expr.type_name, expr.line, expr.col) }
        return expr.type_name
    }

    if expr.kind == EXPR_CALL {
        if expr.callee.kind == EXPR_MEMBER {  // builtin intrinsics + str/sys receivers ride the member path
            let target = expr.callee.target
            let member = expr.callee.member_name
            if target.kind == EXPR_IDENT {
                if target.str_val == "mem" {
                    if !check_mem_call(st, expr, member) { return "unknown" }
                    if member == "alloc" or member == "heap_alloc" { if expr.first_arg != null { if expr.first_arg.next == null { return "@u8" }; return infer_expr_type(st, expr.first_arg) } }
                    if member == "used" or member == "heap_used" { return "usize" }
                    // §4.1: mem.current() -> @Allocator; mem.alloc_with(a, @T, count) -> @T
                    if member == "current" or member == "create_arena" { return "@Allocator" }; if member == "destroy_arena" { return "void" }
                    if member == "alloc_with" { if expr.first_arg != null and expr.first_arg.next != null { return infer_expr_type(st, expr.first_arg.next) } }
                    // cm43: mem.realloc(ptr, @T, count) -> @T (like alloc_with)
                    if member == "realloc" { if expr.first_arg != null and expr.first_arg.next != null { return infer_expr_type(st, expr.first_arg.next) }; return "unknown" }
                    return "void"
                }
                // cm42: thread intrinsics - args are compile-checked
                if target.str_val == "thread" {
                    if !check_thread_call(st, expr, member) { return "unknown" }; if member == "spawn" { return "@Thread" }; if member == "join" { return "i32" }; if member == "mutex" { return "@Mutex" }; return "void"
                }
                if target.str_val == "fs" { return check_fs_call(st, expr, member) }  // 5.4 S2: fs goes CLOSED — the legacy six migrate in with their exact spells, joining the metadata family
                if target.str_val == "str" { return check_str_call(st, expr, member) }  // 5.1/8.2: delegate to str_checks.vl
                if target.str_val == "io" { return "void" }
                if target.str_val == "math" { return check_math_call(st, expr, member) }; if target.str_val == "time" { return check_time_call(st, expr, member) }; if target.str_val == "os" { return check_os_call(st, expr, member) }; if target.str_val == "simd" { return check_simd_call(st, expr, member) }; if target.str_val == "shelf" { return check_shelf_module_call(st, expr, member) }; if target.str_val == "map" { return check_map_module_call(st, expr, member) }
            }
        }
        if expr.callee.kind == EXPR_MEMBER and expr.callee.target != null and is_shelf_type(infer_expr_type(st, expr.callee.target)) { return check_shelf_member_call(st, expr) }  // 5.2: shelf receivers — put / take; slice 6: map receivers
        if expr.callee.kind == EXPR_MEMBER and expr.callee.target != null and is_map_type(infer_expr_type(st, expr.callee.target)) { return check_map_member_call(st, expr) }  // 5.2 slice 6: put / get / has
        if expr.callee.kind == EXPR_MEMBER and expr.callee.target != null and (is_ring_type(infer_expr_type(st, expr.callee.target)) or is_bitset_type(infer_expr_type(st, expr.callee.target))) { return check_coll9_member_call(st, expr) }  // 5.2 slice 9
        // 5.2 slice 9 user fns or Kind variant constructors
        if expr.callee.kind == EXPR_MEMBER and expr.callee.target.kind == EXPR_IDENT {
            let k_sym = find_kind(st, expr.callee.target.str_val)
            if k_sym != null {
                let v_sym = find_variant(k_sym, expr.callee.member_name)
                if v_sym != null { return k_sym.name }
            }
        }
        if expr.callee.kind == EXPR_MEMBER {
            let target_type = infer_expr_type(st, expr.callee.target)
            let clean_type = strip_pointer_prefix(target_type)
            let st_sym = find_struct(st, clean_type)
            if st_sym != null and find_struct_field(st_sym, expr.callee.member_name) != null {
                let f_sym = find_struct_field(st_sym, expr.callee.member_name)
                if is_act_type(f_sym.type_name) {
                    return get_act_return_type(f_sym.type_name)
                }
            }
            let fn_sym = find_function(st, expr.callee.member_name)
            if fn_sym != null {
                if expr.arg_count + 1 != fn_sym.param_count { report_error("semantic", expr.line, expr.col, "Mismatched argument count in method call"); st.error_count += 1 }
                return fn_sym.return_type
            }
        }
        if expr.callee.kind == EXPR_IDENT and expr.callee.str_val == "assert" {
            if expr.arg_count < 1 or expr.arg_count > 2 { report_error("semantic", expr.line, expr.col, "assert takes 1 or 2 arguments"); st.error_count += 1 }
            if expr.first_arg != null {
                let ct = infer_expr_type(st, expr.first_arg)
                if ct != "bool" and ct != "unknown" { report_error("semantic", expr.line, expr.col, "assert condition must be a boolean expression"); st.error_count += 1 }
                if expr.first_arg.next != null {
                    let mt = infer_expr_type(st, expr.first_arg.next)
                    if mt != "string" and mt != "unknown" { report_error("semantic", expr.line, expr.col, "assert message must be a string"); st.error_count += 1 }
                }
            }
            return "void"
        }
        if expr.callee.kind == EXPR_IDENT and is_reflect_builtin(expr.callee.str_val) { return check_reflect_builtin(st, expr) }
        if expr.callee.kind == EXPR_IDENT and is_simd_constructor(expr.callee.str_val) { return check_simd_constructor(st, expr) }
        if expr.callee.kind == EXPR_IDENT {
            let fn_sym = find_function(st, expr.callee.str_val)
            if fn_sym != null {
                if expr.arg_count != fn_sym.param_count { report_error("semantic", expr.line, expr.col, "Mismatched argument count in function call"); st.error_count += 1 }
                mut cur_a = expr.first_arg
                mut cur_p = fn_sym.first_param
                loop cur_a != null and cur_p != null {
                    if cur_a.kind == EXPR_VARIANT and (cur_a.type_name == null or str.len(cur_a.type_name) == 0) {
                        cur_a.type_name = cur_p.type_name
                    }
                    cur_a = cur_a.next
                    cur_p = cur_p.next
                }
                check_shelf_call_args(st, expr, fn_sym)  // 5.2: shelf elems must string-match
                check_map_call_args(st, expr, fn_sym)    // 5.2 slice 6: maps match BOTH slots
                return fn_sym.return_type
            }
            let var_sym = resolve_variable(st, expr.callee.str_val)
            if var_sym != null and is_act_type(var_sym.type_name) {
                return get_act_return_type(var_sym.type_name)
            }
            report_error("semantic", expr.line, expr.col, "Call to undefined function")
            st.error_count += 1
            return "unknown"
        }

        let callee_type = infer_expr_type(st, expr.callee)
        if is_act_type(callee_type) {
            return get_act_return_type(callee_type)
        }
        return "unknown"
    }

    if expr.kind == EXPR_STRUCT_LIT {
        let st_sym = find_struct(st, expr.type_name)
        if st_sym == null {
            report_error("semantic", expr.line, expr.col, "Instantiating unknown struct type"); st.error_count += 1; return "unknown"
        }
        mut cur_init = expr.first_init
        loop cur_init != null {
            let f_sym = find_struct_field(st_sym, cur_init.name)
            if f_sym == null {
                report_error("semantic", cur_init.line, cur_init.col, "Unknown field in struct literal"); st.error_count += 1
            } else {
                let val_type = infer_expr_type(st, cur_init.value)
                if not types_are_compatible(f_sym.type_name, val_type) {
                    report_error("semantic", cur_init.line, cur_init.col, "Type mismatch in field initializer"); st.error_count += 1
                }
            }
            cur_init = cur_init.next
        }
        mut sf = st_sym.first_field  // fields without defaults must be provided (defaults validated in check_program)
        loop sf != null {
            mut seen_init = expr.first_init; mut covered = false
            loop seen_init != null { if seen_init.name == sf.name { covered = true }; seen_init = seen_init.next }
            if not covered and not sf.has_default {
                report_error("semantic", expr.line, expr.col, "Struct literal is missing field with no default"); st.error_count += 1
            }
            sf = sf.next
        }
        return expr.type_name
    }

    if expr.kind == EXPR_BINARY {
        let left_type = infer_expr_type(st, expr.left); let right_type = infer_expr_type(st, expr.right)
        // 5.2 slice 8: raw dyn arithmetic/compares auto-unbox; the concrete mixed-compare and string-concat walls live in dyn_checks.vl too
        let bin_t = check_dyn_binary(st, expr, left_type, right_type); if bin_t != null { return bin_t }
        let s_bin = check_simd_binary(st, expr, left_type, right_type); if s_bin != null { return s_bin }
        if expr.op == TOK_OR and is_or_type(left_type) {
            let succ_t = or_type_success(left_type)
            if not types_are_compatible(succ_t, right_type) {
                report_error("semantic", expr.line, expr.col, "Fallback type mismatch for 'or' expression")
                st.error_count += 1
            }
            return succ_t
        }
        let op_fn = find_binary_op(st, expr.op, left_type, right_type); if op_fn != null { return op_fn.return_type }
        if expr.op == TOK_EQ or expr.op == TOK_NEQ or expr.op == TOK_LT or expr.op == TOK_LTE or expr.op == TOK_GT or expr.op == TOK_GTE or expr.op == TOK_AND or expr.op == TOK_OR {
            return "bool"
        }
        return left_type
    }

    if expr.kind == EXPR_UNARY {
        let sub_type = infer_expr_type(st, expr.operand)
        if sub_type == "dyn" { report_error("semantic", expr.line, expr.col, dyn_gate_error()); st.error_count += 1; return "unknown" }  // slice 2: unbox with `as` first
        let s_un = check_simd_unary(st, expr, sub_type); if s_un != null { return s_un }
        let op_fn = find_unary_op(st, expr.op, sub_type)
        if op_fn != null { return op_fn.return_type }
        if expr.op == TOK_NOT { return "bool" }
        return sub_type
    }

    if expr.kind == EXPR_OR_RETURN {
        let op_type = infer_expr_type(st, expr.operand)
        if not is_or_type(op_type) {
            report_error("semantic", expr.line, expr.col, "'or return' requires an outcome type expression")
            st.error_count += 1
            return "unknown"
        }
        if not is_or_type(st.current_func_ret_type) {
            report_error("semantic", expr.line, expr.col, "'or return' can only be used in a function returning an 'or' type")
            st.error_count += 1
            return "unknown"
        }
        let cur_err = or_type_error(st.current_func_ret_type)
        let op_err = or_type_error(op_type)
        if not types_are_compatible(cur_err, op_err) {
            report_error("semantic", expr.line, expr.col, "Incompatible error type in 'or return' propagation")
            st.error_count += 1
            return "unknown"
        }
        return or_type_success(op_type)
    }

    return "unknown"
}


// cm42: compile-checks thread.* intrinsic arguments — the mirror of velo/codegen_c.py::_thread_expect (both stages reject with the same words). Returns false after reporting.
act check_thread_call(st: @SymbolTable, expr: @ExprNode, member: string) -> bool {
    if member == "mutex" { if expr.first_arg != null { report_error("semantic", expr.line, expr.col, "thread.mutex takes no arguments"); st.error_count += 1; return false }; return true }
    mut want = ""
    if member == "spawn" { want = "act() -> i32" }; if member == "join" { want = "@Thread" }; if member == "acquire" or member == "release" or member == "free" { want = "@Mutex" }
    if want == "" { return true }
    if expr.first_arg == null or expr.first_arg.next != null { mut msb = create_sb(96); sb_append_str(@msb, "thread."); sb_append_str(@msb, member); sb_append_str(@msb, " takes exactly 1 argument"); report_error("semantic", expr.line, expr.col, sb_to_string(@msb)); st.error_count += 1; return false }
    let got = strip_type_spaces(infer_expr_type(st, expr.first_arg))
    if got != strip_type_spaces(want) {
        mut msb = create_sb(160); sb_append_str(@msb, "thread."); sb_append_str(@msb, member); sb_append_str(@msb, " expects "); sb_append_str(@msb, want); sb_append_str(@msb, " (got "); sb_append_str(@msb, infer_expr_type(st, expr.first_arg)); sb_append_str(@msb, ")")
        report_error("semantic", expr.line, expr.col, sb_to_string(@msb)); st.error_count += 1; return false
    }
    return true
}
