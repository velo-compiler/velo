// Statement-level semantic analysis and type checking for Velo.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "symbol_table.vl"
use "type_checker.vl"
use "shelf_checks.vl"
use "map_checks.vl"
use "escape_checks.vl"
use "op_resolver.vl"
use "narrow_flow.vl"
use "tuple_checks.vl"
use "literal_check.vl"
use "range_checks.vl"
use "defer_checks.vl"
use "math_checks.vl"
use "../ast/int_types.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../common/utils.vl"
use "privacy_checks.vl"

// Enforces mutability rules: assigning to an immutable (let) variable is rejected.
act check_assign_mutability(st: @SymbolTable, target: @ExprNode, line: i32, col: i32) {
    if target == null { return }
    if target.kind == EXPR_IDENT {
        let sym = resolve_variable(st, target.str_val)
        if sym != null and not sym.is_mut {
            mut msg = create_sb(str.len(target.str_val) * 2 + 80)
            sb_append_str(@msg, "cannot assign to immutable variable '")
            sb_append_str(@msg, target.str_val)
            sb_append_str(@msg, "'. Declare with 'mut ")
            sb_append_str(@msg, target.str_val)
            sb_append_str(@msg, "' to allow mutation.")
            report_error("semantic", line, col, sb_to_string(@msg))
            st.error_count += 1
        }
    } else if target.kind == EXPR_MEMBER {
        if target.target != null and target.target.kind == EXPR_IDENT {
            let base_type = infer_expr_type(st, target.target)
            if str.len(base_type) > 0 and base_type[0] != '@' {
                let sym = resolve_variable(st, target.target.str_val)
                if sym != null and not sym.is_mut {
                    mut msg = create_sb(str.len(target.target.str_val) * 2 + 88)
                    sb_append_str(@msg, "cannot assign to field of immutable variable '")
                    sb_append_str(@msg, target.target.str_val)
                    sb_append_str(@msg, "'. Declare with 'mut ")
                    sb_append_str(@msg, target.target.str_val)
                    sb_append_str(@msg, "' to allow mutation.")
                    report_error("semantic", line, col, sb_to_string(@msg))
                    st.error_count += 1
                }
            }
        }
    } else if target.kind == EXPR_INDEX {
        if target.target != null and target.target.kind == EXPR_IDENT {
            let base_type = infer_expr_type(st, target.target)
            if str.len(base_type) > 0 and base_type[0] != '@' {
                let sym = resolve_variable(st, target.target.str_val)
                if sym != null and not sym.is_mut {
                    mut msg = create_sb(str.len(target.target.str_val) * 2 + 88)
                    sb_append_str(@msg, "cannot assign to element of immutable variable '")
                    sb_append_str(@msg, target.target.str_val)
                    sb_append_str(@msg, "'. Declare with 'mut ")
                    sb_append_str(@msg, target.target.str_val)
                    sb_append_str(@msg, "' to allow mutation.")
                    report_error("semantic", line, col, sb_to_string(@msg))
                    st.error_count += 1
                }
            }
        }
    }
}

// Validates semantic correctness of a single statement.
act check_statement(st: @SymbolTable, expected_ret_type: string, stmt: @StmtNode) {
    if stmt == null { return }
    if stmt.kind == STMT_VAR_DECL {
        if stmt.type_name != null and str.len(stmt.type_name) > 0 {
            check_type_privacy(st, stmt.type_name, stmt.line, stmt.col)
            stmt.type_name = normalize_type_rename(st, st.current_file, stmt.type_name)
        }
        check_shelf_annotation(st, stmt.type_name, stmt.val_expr, stmt.line, stmt.col)  // 5.2: annotated shelf pins/rejects (empty literals borrow the elem)
        check_map_annotation(st, stmt.type_name, stmt.val_expr, stmt.line, stmt.col)  // 5.2 slice 6: empty literals borrow BOTH slots / reject mismatches
        check_coll9_annotation(st, stmt.type_name, stmt.val_expr, stmt.line, stmt.col)  // 5.2 slice 9: ring + bitset
        if stmt.val_expr != null {
            mut adapt_ok = true
            if stmt.type_name != null and str.len(stmt.type_name) > 0 {
                if stmt.val_expr.kind == EXPR_VARIANT and (stmt.val_expr.type_name == null or str.len(stmt.val_expr.type_name) == 0) { stmt.val_expr.type_name = stmt.type_name }
                if stmt.val_expr.kind == EXPR_ARRAY_LIT and is_fixed_array_type(stmt.type_name) {
                    let elem_t = fixed_array_elem_type(stmt.type_name)
                    mut cur_elem = stmt.val_expr.first_arg
                    loop cur_elem != null {
                        try_adapt_int_literal(st, elem_t, cur_elem, cur_elem.line, cur_elem.col)
                        cur_elem = cur_elem.next
                    }
                }
                adapt_ok = try_adapt_int_literal(st, stmt.type_name, stmt.val_expr, stmt.line, stmt.col)
            }
            let val_type = infer_expr_type(st, stmt.val_expr)
            if stmt.type_name != null and str.len(stmt.type_name) > 0 {
                // slice 11: contextual lexing routes a bare `shelf` annotation as an
                // identifier, so the wall is name-based (Stage 1 raises in _map_type)
                if strip_pointer_prefix(stmt.type_name) == "shelf" { report_error("semantic", stmt.line, stmt.col, "a bare 'shelf' needs an element type: use shelf[T]"); st.error_count += 1 }
                else if not types_are_compatible(stmt.type_name, val_type) {
                    if not adapt_ok { }
                    else if is_split_retire_pair(stmt.type_name, val_type) { report_error("semantic", stmt.line, stmt.col, split_retire_message(stmt.type_name)); st.error_count += 1 }
                    else if is_int_type(stmt.type_name) and is_int_type(val_type) { report_error("semantic", stmt.line, stmt.col, int_conversion_error_msg(stmt.type_name, val_type)); st.error_count += 1 }
                    else if is_float_type(stmt.type_name) and is_float_type(val_type) { report_error("semantic", stmt.line, stmt.col, float_conversion_error_msg(stmt.type_name, val_type)); st.error_count += 1 }
                    else { report_error("semantic", stmt.line, stmt.col, "Type mismatch in variable declaration"); st.error_count += 1 }
                }
            } else {
                stmt.type_name = val_type
            }
        }
        define_variable(st, stmt.name, stmt.type_name, stmt.is_mut, stmt.line, stmt.col)
        if stmt.val_expr != null {
            check_escape_assign(st, make_ident_expr(stmt.name, stmt.line, stmt.col), stmt.val_expr, stmt.line, stmt.col)
        }
    } else if stmt.kind == STMT_DESTRUCTURE {
        check_destructure_stmt(st, stmt)
    } else if stmt.kind == STMT_ASSIGN {
        if stmt.expr != null and stmt.expr.kind == EXPR_INDEX and is_map_type(infer_expr_type(st, stmt.expr.target)) {  // 5.2 slice 6: mut / compound-assign / strict key and value
            check_map_assign(st, stmt); infer_expr_type(st, stmt.val_expr)
        } else if stmt.expr != null and stmt.expr.kind == EXPR_INDEX and is_shelf_type(infer_expr_type(st, stmt.expr.target)) { check_shelf_assign(st, stmt); infer_expr_type(st, stmt.val_expr) } else {
        check_assign_mutability(st, stmt.expr, stmt.line, stmt.col)
        check_escape_assign(st, stmt.expr, stmt.val_expr, stmt.line, stmt.col)
        let target_type = infer_expr_type(st, stmt.expr)
        if stmt.val_expr.kind == EXPR_VARIANT and (stmt.val_expr.type_name == null or str.len(stmt.val_expr.type_name) == 0) {
            stmt.val_expr.type_name = target_type
        }
        if stmt.val_expr.kind == EXPR_ARRAY_LIT and is_fixed_array_type(target_type) {
            let elem_t = fixed_array_elem_type(target_type)
            mut cur_elem = stmt.val_expr.first_arg
            loop cur_elem != null {
                try_adapt_int_literal(st, elem_t, cur_elem, cur_elem.line, cur_elem.col)
                cur_elem = cur_elem.next
            }
        }
        let adapt_ok = try_adapt_int_literal(st, target_type, stmt.val_expr, stmt.line, stmt.col)
        let val_type = infer_expr_type(st, stmt.val_expr)
        check_div_zero_assign(st, stmt)
        let base_op = get_base_assign_op(stmt.op)
        mut is_valid = types_are_compatible(target_type, val_type)
        if not is_valid and base_op != 0 {
            let op_fn = find_binary_op(st, base_op, target_type, val_type)
            if op_fn != null and types_are_compatible(target_type, op_fn.return_type) { is_valid = true }
        }
        if not is_valid {
            if not adapt_ok { }
            else if is_split_retire_pair(target_type, val_type) { report_error("semantic", stmt.line, stmt.col, split_retire_message(target_type)); st.error_count += 1 }
            else if is_int_type(target_type) and is_int_type(val_type) { report_error("semantic", stmt.line, stmt.col, int_conversion_error_msg(target_type, val_type)); st.error_count += 1 }
            else if is_float_type(target_type) and is_float_type(val_type) { report_error("semantic", stmt.line, stmt.col, float_conversion_error_msg(target_type, val_type)); st.error_count += 1 }
            else { report_error("semantic", stmt.line, stmt.col, "Type mismatch in assignment"); st.error_count += 1 }
        }
        }
    } else if stmt.kind == STMT_IF {
        require_bool_condition(st, stmt.expr)
        enter_scope(st)
        apply_flow_narrowing(st, stmt.expr, true)
        check_statement(st, expected_ret_type, stmt.body)
        exit_scope(st)
        if stmt.else_branch != null {
            enter_scope(st)
            apply_flow_narrowing(st, stmt.expr, false)
            check_statement(st, expected_ret_type, stmt.else_branch)
            exit_scope(st)
        }
    } else if stmt.kind == STMT_LOOP {
        // 5.2 slice 4/7: `loop v of coll` - the iterator takes the element (K for maps); range/count/condition loops widen appropriately
        mut of_elem = "i32"
        if stmt.is_of {
            of_elem = check_map_loop_source(st, stmt)
        } else if stmt.loop_start != null {
            of_elem = check_range_loop(st, stmt)
        } else if stmt.expr != null {
            let expr_t = infer_expr_type(st, stmt.expr)
            if is_int_type(expr_t) {
                stmt.is_count = true
                of_elem = expr_t
            } else if expr_t == "bool" {
                stmt.is_count = false
                of_elem = "i32"
            } else {
                if expr_t != "unknown" or st.error_count == 0 {
                    mut msg = create_sb(64)
                    sb_append_str(@msg, "Loop expression must be an integer (count) or 'bool' (condition), got '")
                    sb_append_str(@msg, expr_t)
                    sb_append_char(@msg, '\'')
                    report_error("semantic", stmt.line, stmt.col, sb_to_string(@msg))
                    st.error_count += 1
                }
            }
        }
        stmt.type_name = of_elem
        enter_scope(st)
        mut vname = "it"
        if stmt.loop_var != null and str.len(stmt.loop_var) > 0 { vname = stmt.loop_var }
        define_variable(st, vname, of_elem, false, stmt.line, stmt.col)
        if stmt.loop_index != null and str.len(stmt.loop_index) > 0 { define_variable(st, stmt.loop_index, "usize", false, stmt.line, stmt.col) }
        // Phase 62: `break`/`continue` bind to the nearest lexically enclosing loop.
        st.current_loop_depth += 1
        check_statement(st, expected_ret_type, stmt.body)
        st.current_loop_depth -= 1
        exit_scope(st)
    } else if stmt.kind == STMT_ZONE {
        if stmt.expr != null { infer_expr_type(st, stmt.expr) }
        st.current_zone_depth += 1
        check_statement(st, expected_ret_type, stmt.body)
        st.current_zone_depth -= 1
    } else if stmt.kind == STMT_DEFER {
        // Phase 69: a deferred transfer has no defined target at cleanup time, and
        // lowering one re-enters the cleanup chain being emitted (stack overflow,
        // no diagnostic). Reject it here so `velo check` owns the rule.
        if defer_body_transfers(stmt.deferred_stmt) {
            let kw = find_defer_transfer_keyword(stmt.deferred_stmt)
            report_error("semantic", stmt.line, stmt.col, str.concat("'defer' cannot defer ", str.concat(kw, ": a deferred transfer has no defined target at cleanup time")))
            st.error_count += 1
        }
        check_statement(st, expected_ret_type, stmt.deferred_stmt)
    } else if stmt.kind == STMT_RETURN {
        if stmt.val_expr != null {
            check_escape_return(st, stmt.val_expr, expected_ret_type, stmt.line, stmt.col)
            pin_empty_shelf_return(st, stmt.val_expr, expected_ret_type)  // 5.2
            pin_empty_map_return(st, stmt.val_expr, expected_ret_type)    // 5.2 slice 6
            if stmt.val_expr.kind == EXPR_VARIANT and (stmt.val_expr.type_name == null or str.len(stmt.val_expr.type_name) == 0) {
                stmt.val_expr.type_name = expected_ret_type
            }
            mut expected = expected_ret_type
            if is_or_type(expected_ret_type) { expected = or_type_success(expected_ret_type) }
            let adapt_ok = try_adapt_int_literal(st, expected, stmt.val_expr, stmt.line, stmt.col)
            let ret_type = infer_expr_type(st, stmt.val_expr)
            if not types_are_compatible(expected, ret_type) and not types_are_compatible(expected_ret_type, ret_type) {
                if not adapt_ok { }
                else if is_int_type(expected) and is_int_type(ret_type) { report_error("semantic", stmt.line, stmt.col, int_conversion_error_msg(expected, ret_type)); st.error_count += 1 }
                else if is_float_type(expected) and is_float_type(ret_type) { report_error("semantic", stmt.line, stmt.col, float_conversion_error_msg(expected, ret_type)); st.error_count += 1 }
                else { report_error("semantic", stmt.line, stmt.col, "Return type mismatch"); st.error_count += 1 }
            }
        } else if expected_ret_type != null and expected_ret_type != "void" and str.len(expected_ret_type) > 0 {
            if not is_or_type(expected_ret_type) or or_type_success(expected_ret_type) != "void" {
                report_error("semantic", stmt.line, stmt.col, "A function returning a value must return an expression")
                st.error_count += 1
            }
        }
    } else if stmt.kind == STMT_FAIL {
        if not is_or_type(expected_ret_type) {
            report_error("semantic", stmt.line, stmt.col, "'fail' can only be used in a function returning an 'or' type")
            st.error_count += 1
        } else if stmt.val_expr != null {
            check_escape_fail(st, stmt.val_expr, expected_ret_type, stmt.line, stmt.col)
            let err_t = or_type_error(expected_ret_type)
            try_adapt_int_literal(st, err_t, stmt.val_expr, stmt.line, stmt.col)
            let val_t = infer_expr_type(st, stmt.val_expr)
            if not types_are_compatible(err_t, val_t) {
                if is_int_type(err_t) and is_int_type(val_t) { report_error("semantic", stmt.line, stmt.col, int_conversion_error_msg(err_t, val_t)); st.error_count += 1 }
                else { report_error("semantic", stmt.line, stmt.col, "Fail payload type mismatch"); st.error_count += 1 }
            }
        } else {
            report_error("semantic", stmt.line, stmt.col, "'fail' statement requires an error value")
            st.error_count += 1
        }
    } else if stmt.kind == STMT_BREAK or stmt.kind == STMT_CONTINUE {
        // Phase 62: the nearest lexically enclosing loop is the only legal target;
        // `on` is a branch, never a loop (SPEC 7.3). Rejecting here keeps the rule
        // in the checker so `velo check` (no codegen) owns it.
        if st.current_loop_depth <= 0 {
            if stmt.kind == STMT_BREAK { report_error("semantic", stmt.line, stmt.col, "break statement not within a loop") }
            else { report_error("semantic", stmt.line, stmt.col, "continue statement not within a loop") }
            st.error_count += 1
        }
        return
    } else if stmt.kind == STMT_MATCH {
        let m_type = infer_expr_type(st, stmt.expr); stmt.type_name = m_type; let k_sym = find_kind(st, m_type); mut cur_case = stmt.first_case
        loop cur_case != null {
            enter_scope(st); mut val = cur_case.first_val
            loop val != null {
                if val.kind == EXPR_VARIANT and (val.type_name == null or str.len(val.type_name) == 0) { val.type_name = m_type }
                let val_t = infer_expr_type(st, val)
                if m_type != "unknown" and val_t != "unknown" and not types_are_compatible(m_type, val_t) and not types_are_compatible(val_t, m_type) {
                    report_error("semantic", val.line, val.col, "Pattern type does not match subject type in 'on' statement")
                    st.error_count += 1
                }
                if k_sym != null and val.kind == EXPR_VARIANT {
                    let v_sym = find_variant(k_sym, val.member_name)
                    if v_sym != null {
                        if v_sym.field_count > 0 {
                            mut cur_b = val.first_arg; mut cur_f = v_sym.first_field
                            loop cur_b != null and cur_f != null {
                                if cur_b.kind == EXPR_IDENT { define_variable(st, cur_b.str_val, cur_f.type_name, false, cur_b.line, cur_b.col) }
                                cur_b = cur_b.next; cur_f = cur_f.next
                            }
                        } else if v_sym.payload_type != null and val.first_arg != null {
                            if val.first_arg.kind == EXPR_IDENT { define_variable(st, val.first_arg.str_val, v_sym.payload_type, false, val.first_arg.line, val.first_arg.col) }
                        }
                    }
                }
                val = val.next
            }
            if (m_type == "?string" or is_optional_type(m_type)) and not cur_case.is_default and cur_case.first_val != null and cur_case.first_val.kind != EXPR_NULL {
                if stmt.expr.kind == EXPR_IDENT {
                    narrow_variable(st, stmt.expr.str_val, optional_inner_type(m_type), m_type)
                }
            }
            if cur_case.body != null { check_statement(st, expected_ret_type, cur_case.body) }
            exit_scope(st); cur_case = cur_case.next
        }
    } else if stmt.kind == STMT_BLOCK {
        st.check_depth += 1
        if st.check_depth > 128 {
            diag_stage_arg("semantic", "VELO-E0021", stmt.line, stmt.col, "block nesting depth exceeds limit of 128")
            st.error_count += 1
            st.check_depth -= 1
            return
        }
        enter_scope(st); mut cur = stmt.first_stmt
        loop cur != null {
            check_statement(st, expected_ret_type, cur)
            if cur.kind == STMT_IF and cur.else_branch == null and stmt_unconditionally_exits(cur.body) {
                apply_flow_narrowing(st, cur.expr, false)
            }
            cur = cur.next
        }
        exit_scope(st)
        st.check_depth -= 1
    } else if stmt.kind == STMT_UNSAFE {
        st.current_unsafe_depth += 1
        check_statement(st, expected_ret_type, stmt.body)
        st.current_unsafe_depth -= 1
    } else if stmt.kind == STMT_EXPR { infer_expr_type(st, stmt.expr) }
}

