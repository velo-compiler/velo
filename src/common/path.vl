// File system path manipulation utilities for Velo.
use sys.mem
use "utils.vl"

// Extracts the file stem from a path (e.g. "examples/01_hello.vl" -> "01_hello").
act get_file_stem(path: string) -> string {
    if path == null { return "output" }
    let plen = str.len(path)
    if plen == 0 { return "output" }

    mut last_slash: i32 = -1
    mut last_dot: i32 = -1
    mut i: usize = 0
    loop i < plen {
        let c = path[i]
        if c == '/' or c == '\\' {
            last_slash = i as i32
        } else if c == '.' {
            last_dot = i as i32
        }
        i += 1
    }

    let start = (last_slash + 1) as usize
    mut end = plen
    if last_dot > last_slash {
        end = last_dot as usize
    }
    if end <= start {
        return "output"
    }
    return copy_slice_to_string(path, start, end - start)
}

// Extracts the directory component from a path (e.g. "examples/08_mult/main.vl" -> "examples/08_mult").
act get_dir_name(path: string) -> string {
    if path == null { return "." }
    let plen = str.len(path)
    if plen == 0 { return "." }

    mut last_slash: i32 = -1
    mut i: usize = 0
    loop i < plen {
        let c = path[i]
        if c == '/' or c == '\\' {
            last_slash = i as i32
        }
        i += 1
    }

    if last_slash <= 0 {
        return "."
    }
    return copy_slice_to_string(path, 0, last_slash as usize)
}

// Canonicalizes path by resolving '.' and '..' segments and converting backslashes to forward slashes.
act canonicalize_path(path: string) -> string {
    if path == null { return null }
    let plen = str.len(path)
    if plen == 0 { return "" }

    // Allocate array of segment strings (up to 32 path depth)
    mut stack: @string = mem.alloc(@string, 32)
    mut stack_lens: @usize = mem.alloc(@usize, 32)
    mut stack_size: usize = 0

    mut seg_start: usize = 0
    mut i: usize = 0
    loop i <= plen {
        mut c: u8 = '/'
        if i < plen {
            c = path[i]
        }
        if c == '/' or c == '\\' {
            if i > seg_start {
                let slen = i - seg_start
                let is_dot = (slen == 1 and path[seg_start] == '.')
                let is_dotdot = (slen == 2 and path[seg_start] == '.' and path[seg_start + 1] == '.')

                if is_dot {
                    // Skip current directory segment '.'
                } else if is_dotdot {
                    if stack_size > 0 {
                        let prev_len = stack_lens[stack_size - 1]
                        let prev_ptr = stack[stack_size - 1]
                        let prev_is_dotdot = (prev_len == 2 and prev_ptr[0] == '.' and prev_ptr[1] == '.')
                        if prev_is_dotdot {
                            stack[stack_size] = copy_slice_to_string(path, seg_start, slen)
                            stack_lens[stack_size] = slen
                            stack_size += 1
                        } else {
                            stack_size -= 1
                        }
                    } else {
                        stack[stack_size] = copy_slice_to_string(path, seg_start, slen)
                        stack_lens[stack_size] = slen
                        stack_size += 1
                    }
                } else {
                    if stack_size < 32 {
                        stack[stack_size] = copy_slice_to_string(path, seg_start, slen)
                        stack_lens[stack_size] = slen
                        stack_size += 1
                    }
                }
            }
            seg_start = i + 1
        }
        i += 1
    }

    if stack_size == 0 {
        return "."
    }

    // Calculate total joined length
    mut total_len: usize = 0
    mut k: usize = 0
    loop k < stack_size {
        total_len += stack_lens[k]
        if k + 1 < stack_size {
            total_len += 1
        }
        k += 1
    }

    mut out_buf: @u8 = mem.alloc(@u8, total_len + 1)
    mut pos: usize = 0
    mut m: usize = 0
    loop m < stack_size {
        let seg_len = stack_lens[m]
        let seg_ptr = stack[m]
        mut b: usize = 0
        loop b < seg_len {
            out_buf[pos] = seg_ptr[b]
            pos += 1
            b += 1
        }
        if m + 1 < stack_size {
            out_buf[pos] = '/'
            pos += 1
        }
        m += 1
    }
    out_buf[pos] = 0 as u8
    return out_buf as string
}

// Combines a directory path and relative filename (e.g. "src" + "main.vl" -> "src/main.vl").
act combine_paths(dir: string, file: string) -> string {
    if dir == null or dir == "." { return canonicalize_path(file) }
    if file == null { return canonicalize_path(dir) }
    let dlen = str.len(dir)
    let flen = str.len(file)
    let total_len = dlen + 1 + flen
    mut buf: @u8 = mem.alloc(@u8, total_len + 1)
    mut i: usize = 0
    loop i < dlen {
        buf[i] = dir[i]
        i += 1
    }
    buf[dlen] = '/'
    mut j: usize = 0
    loop j < flen {
        buf[dlen + 1 + j] = file[j]
        j += 1
    }
    buf[total_len] = 0 as u8
    return canonicalize_path(buf as string)
}

// Normalizes path separators to backslashes for shell command execution.
act to_native_path(path: string) -> string {
    if path == null { return null }
    let plen = str.len(path)
    mut buf: @u8 = mem.alloc(@u8, plen + 1)
    mut i: usize = 0
    loop i < plen {
        let c = path[i]
        if c == '/' {
            buf[i] = '\\'
        } else {
            buf[i] = c
        }
        i += 1
    }
    buf[plen] = 0 as u8
    return buf as string
}
