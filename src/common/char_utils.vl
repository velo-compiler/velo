// Character literal parsing helpers for Velo.
use "utils.vl"

// Returns the numeric value (0-15) of an ASCII hexadecimal character.
act char_hex_digit(c: u8) -> i32 {
    if c >= '0' and c <= '9' { return (c as i32) - ('0' as i32) }
    if c >= 'a' and c <= 'f' { return (c as i32) - ('a' as i32) + 10 }
    if c >= 'A' and c <= 'F' { return (c as i32) - ('A' as i32) + 10 }
    return 0
}

// Parses a character literal ('c', '\n', '\u0041', utf-8, etc.) from source slice.
act parse_char_literal(source: string, start: usize, len: usize) -> i32 {
    if len >= 3 and source[start + 1] == '\\' {
        let esc = source[start + 2]
        if esc == 'n' { return 10 }
        if esc == 't' { return 9 }
        if esc == 'r' { return 13 }
        if esc == '0' { return 0 }
        if esc == '\'' { return 39 }
        if esc == '"' { return 34 }
        if esc == '\\' { return 92 }
        if esc == 'x' and len >= 5 {
            let p = start + 3
            return (char_hex_digit(source[p]) << 4) | char_hex_digit(source[p + 1])
        }
        if esc == 'u' and len >= 7 {
            let p = start + 3
            return (char_hex_digit(source[p]) << 12) | (char_hex_digit(source[p + 1]) << 8) | (char_hex_digit(source[p + 2]) << 4) | char_hex_digit(source[p + 3])
        }
        return esc as i32
    }
    let b0: u32 = source[start + 1] as u32
    if b0 <= 0x7F as u32 { return b0 as i32 }
    if (b0 & 0xE0 as u32) == 0xC0 as u32 and len >= 4 {
        let b1: u32 = source[start + 2] as u32
        return (((b0 & 0x1F as u32) << 6) | (b1 & 0x3F as u32)) as i32
    }
    if (b0 & 0xF0 as u32) == 0xE0 as u32 and len >= 5 {
        let b1: u32 = source[start + 2] as u32
        let b2: u32 = source[start + 3] as u32
        return (((b0 & 0x0F as u32) << 12) | ((b1 & 0x3F as u32) << 6) | (b2 & 0x3F as u32)) as i32
    }
    if (b0 & 0xF8 as u32) == 0xF0 as u32 and len >= 6 {
        let b1: u32 = source[start + 2] as u32
        let b2: u32 = source[start + 3] as u32
        let b3: u32 = source[start + 4] as u32
        return (((b0 & 0x07 as u32) << 18) | ((b1 & 0x3F as u32) << 12) | ((b2 & 0x3F as u32) << 6) | (b3 & 0x3F as u32)) as i32
    }
    return b0 as i32
}
