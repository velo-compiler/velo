use std.io
use std.mem
use std.str
use "string_builder.vl"

// In-memory diagnostic record for LSP and language tooling.
data InMemDiag {
    filename: string,
    line: i32,
    col: i32,
    severity: i32,
    message: string,
    next: @InMemDiag,
}

mut g_diag_collector_active: bool = false
mut g_diag_head: @InMemDiag = null
mut g_diag_tail: @InMemDiag = null
mut g_diag_count: i32 = 0

// Activates the in-memory diagnostic collector.
act diag_collector_start() {
    diag_collector_clear()
    g_diag_collector_active = true
}

// Deactivates the in-memory diagnostic collector.
act diag_collector_stop() {
    g_diag_collector_active = false
}

// Clears and frees all accumulated in-memory diagnostics.
act diag_collector_clear() {
    mut cur = g_diag_head
    loop cur != null {
        let nxt = cur.next
        if cur.filename != null { mem.free(cur.filename as @u8) }
        if cur.message != null { mem.free(cur.message as @u8) }
        mem.free(cur as @u8)
        cur = nxt
    }
    g_diag_head = null
    g_diag_tail = null
    g_diag_count = 0
}

// Duplicates a null-terminated string to persistent heap memory.
act diag_heap_copy(s: string) -> string {
    if s == null { return null }
    let n = str.len(s)
    let buf: @u8 = mem.heap_alloc(@u8, n + 1)
    mut i: usize = 0
    loop i < n {
        buf[i] = s[i]
        i += 1
    }
    buf[n] = 0 as u8
    return buf as string
}

// Appends an in-memory diagnostic record to the active collector.
act diag_collector_add(filename: string, line: i32, col: i32, severity: i32, message: string) {
    let node: @InMemDiag = mem.heap_alloc(@InMemDiag, 1)
    node.filename = diag_heap_copy(filename)
    node.line = line
    node.col = col
    node.severity = severity
    node.message = diag_heap_copy(message)
    node.next = null

    if g_diag_head == null {
        g_diag_head = node
        g_diag_tail = node
    } else {
        g_diag_tail.next = node
        g_diag_tail = node
    }
    g_diag_count += 1
}

// Formats and reports a compiler error at a specific source location.
//
// Parameters:
//   filename: Path to the source file where the error occurred.
//   line: 1-indexed source line number.
//   col: 1-indexed source column number.
//   message: Explanatory error message.
act report_error(filename: string, line: i32, col: i32, message: string) {
    if g_diag_collector_active {
        diag_collector_add(filename, line, col, 1, message)
        return
    }
    println_str("[Velo Error] {filename}:{line}:{col} - {message}")
}

// Formats and reports a compiler warning at a specific source location.
act report_warning(filename: string, line: i32, col: i32, message: string) {
    if g_diag_collector_active {
        diag_collector_add(filename, line, col, 2, message)
        return
    }
    println_str("[Velo Warning] {filename}:{line}:{col} - {message}")
}

// Reports a general compiler error not bound to a specific source line.
act report_simple_error(message: string) {
    if g_diag_collector_active {
        diag_collector_add("", 0, 0, 1, message)
        return
    }
    println_str("[Velo Error] {message}")
}

// ---------------------------------------------------------------------------
// Error Code Registry (VELO-E####) and diagnostic emission helpers.
// ---------------------------------------------------------------------------

// Resolves human-readable summary for a registered error code.
act error_code_message(code: string) -> string {
    if code == "VELO-E0001" { return "Undeclared identifier" }
    if code == "VELO-E0002" { return "Mismatched argument count in function call" }
    if code == "VELO-E0003" { return "Array index out of bounds" }
    if code == "VELO-E0004" { return "Array index must be an integer" }
    if code == "VELO-E0005" { return "Division by zero" }
    if code == "VELO-E0006" { return "Modulo by zero" }
    if code == "VELO-E0007" { return "Instantiating unknown struct type" }
    if code == "VELO-E0008" { return "Unknown field in struct literal" }
    if code == "VELO-E0009" { return "Struct literal is missing field with no default" }
    if code == "VELO-E0010" { return "Mismatched element type in array literal" }
    if code == "VELO-E0011" { return "Cannot infer kind type for variant" }
    if code == "VELO-E0012" { return "Mismatched argument count in variant constructor" }
    if code == "VELO-E0013" { return "Tuple index out of bounds" }
    if code == "VELO-E0014" { return "Range loop step must be greater than zero" }
    if code == "VELO-E0015" { return "shelf elements cannot be null (use a @T pointer element)" }
    if code == "VELO-E0016" { return "shelf[dyn] put: cannot box a void value" }
    if code == "VELO-E0017" { return "map values cannot be null (use a @T pointer value)" }
    if code == "VELO-E0018" { return "cannot infer element type of empty shelf literal — annotate it (e.g. let e: shelf[i32] = shelf[])" }
    if code == "VELO-E0019" { return "cannot infer element type of empty ring literal — annotate it (e.g. let r: ring[i32] = ring[])" }
    if code == "VELO-E0020" { return "Raw pointer dereference requires an 'unsafe { ... }' block when compiling with --strict-safety." }
    return "Unknown compiler diagnostic"
}

// Normalizes error codes like "E0001" or "0001" into canonical "VELO-E0001".
act normalize_error_code(raw: string) -> string {
    if raw == null { return "" }
    let n = str.len(raw)
    if n == 10 and raw[0] == 'V' and raw[1] == 'E' and raw[2] == 'L' and raw[3] == 'O' {
        return raw
    }
    if n == 5 and (raw[0] == 'E' or raw[0] == 'e') {
        mut sb = create_sb(16)
        sb_append_str(@sb, "VELO-")
        sb_append_char(@sb, 'E')
        mut i: usize = 1
        loop i < n {
            sb_append_char(@sb, raw[i])
            i += 1
        }
        return sb_to_string(@sb)
    }
    if n == 4 {
        mut sb = create_sb(16)
        sb_append_str(@sb, "VELO-E")
        sb_append_str(@sb, raw)
        return sb_to_string(@sb)
    }
    return raw
}

// Returns detailed explanation for `velo explain <CODE>`.
act error_code_explain(code: string) -> string {
    let norm = normalize_error_code(code)
    if norm == "VELO-E0001" { return "VELO-E0001: Undeclared identifier\nAn identifier was referenced in an expression, but no symbol with that name exists in the current scope." }
    if norm == "VELO-E0002" { return "VELO-E0002: Mismatched argument count in function call\nA function or method call passed a different number of arguments than expected by its signature." }
    if norm == "VELO-E0003" { return "VELO-E0003: Array index out of bounds\nA fixed-size array was accessed with a constant index >= array length, or negative." }
    if norm == "VELO-E0004" { return "VELO-E0004: Array index must be an integer\nAn array subscript expression was provided with a non-integer index type." }
    if norm == "VELO-E0005" { return "VELO-E0005: Division by zero\nA division expression has a constant zero divisor." }
    if norm == "VELO-E0006" { return "VELO-E0006: Modulo by zero\nA modulo expression has a constant zero divisor." }
    if norm == "VELO-E0007" { return "VELO-E0007: Instantiating unknown struct type\nA struct literal refers to a struct type that has not been defined." }
    if norm == "VELO-E0008" { return "VELO-E0008: Unknown field in struct literal\nA struct literal specifies a field name not present in the struct definition." }
    if norm == "VELO-E0009" { return "VELO-E0009: Struct literal is missing field with no default\nA struct literal omitted a required field without a default value." }
    if norm == "VELO-E0010" { return "VELO-E0010: Mismatched element type in array literal\nElements of an array literal evaluate to incompatible types without an explicit annotation." }
    if norm == "VELO-E0011" { return "VELO-E0011: Cannot infer kind type for variant\nA bare variant literal cannot be resolved to an unambiguous kind type." }
    if norm == "VELO-E0012" { return "VELO-E0012: Mismatched argument count in variant constructor\nA variant constructor was called with an incorrect number of arguments." }
    if norm == "VELO-E0013" { return "VELO-E0013: Tuple index out of bounds\nA tuple index exceeds the number of elements in the tuple." }
    if norm == "VELO-E0014" { return "VELO-E0014: Range loop step must be greater than zero\nA range loop step was zero or negative." }
    if norm == "VELO-E0015" { return "VELO-E0015: shelf elements cannot be null (use a @T pointer element)\nA shelf literal cannot store bare untyped null." }
    if norm == "VELO-E0016" { return "VELO-E0016: shelf[dyn] put: cannot box a void value\nCannot box an expression that evaluates to void." }
    if norm == "VELO-E0017" { return "VELO-E0017: map values cannot be null (use a @T pointer value)\nA map literal cannot store bare untyped null values." }
    if norm == "VELO-E0018" { return "VELO-E0018: cannot infer element type of empty shelf literal — annotate it\nAn empty shelf literal requires a type annotation." }
    if norm == "VELO-E0019" { return "VELO-E0019: cannot infer element type of empty ring literal — annotate it\nAn empty ring literal requires a type annotation." }
    if norm == "VELO-E0020" { return "VELO-E0020: Raw pointer dereference requires an 'unsafe { ... }' block\nWith --strict-safety, raw pointer dereferences must be enclosed in unsafe blocks." }
    return "Unknown error code. See docs/ERRORS.md for the full error registry."
}

// Emits a registered diagnostic error at the given source position (stage defaults to 'semantic').
act diag(code: string, line: i32, col: i32) {
    diag_stage("semantic", code, line, col)
}

// Emits a registered diagnostic error at the given stage and position.
act diag_stage(stage: string, code: string, line: i32, col: i32) {
    let msg = error_code_message(code)
    report_error(stage, line, col, "[{code}] {msg}")
}

// Emits a registered diagnostic error with custom explanatory argument.
act diag_arg(code: string, line: i32, col: i32, arg: string) {
    diag_stage_arg("semantic", code, line, col, arg)
}

act diag_stage_arg(stage: string, code: string, line: i32, col: i32, arg: string) {
    let msg = error_code_message(code)
    report_error(stage, line, col, "[{code}] {msg}: {arg}")
}

// ---------------------------------------------------------------------------
// 6.3 S1: the source-snippet block renderer. A block is ADDITIVE output
// printed right after a positioned one-liner wire row (whose bytes never
// change). Byte spec:
//     {file}:{line}:{col}: {severity}: {message}
//     {line} | {line_text}
//     " "*(w+1) + "| " + " "*(col-1) + "^"       (w = decimal digits of line)
// line_text is the row's source line with each tab flattened to one space and
// a trailing \r stripped; a past-EOF line yields an empty text row with the
// caret at the formula position. Cols count BYTES here (Stage 1 counts code
// points; identical for all ASCII house fixtures — documented residue).
// ---------------------------------------------------------------------------

// Copies the wanted 1-based line's bytes: tabs flattened to one space, a
// trailing \r stripped, and interior bytes kept verbatim (byte model).
act pretty_line_text(source: string, want_line: i32) -> string {
    let n = str.len(source)
    // Advance to the first byte of the wanted line (or EOF for past-EOF rows).
    mut start: usize = 0
    mut line_no: i32 = 1
    loop line_no < want_line and start < n {
        if source[start] == '\n' {
            line_no += 1
        }
        start += 1
    }
    // The line ends at the next newline (or EOF); strip one trailing \r.
    mut end = start
    loop end < n {
        if source[end] == '\n' {
            break
        }
        end += 1
    }
    if end > start and source[end - 1] == '\r' {
        end -= 1
    }
    // Byte-copy with tabs flattened (deterministic; no width-dependent pad).
    let raw_len = end - start
    mut buf: @u8 = mem.alloc(@u8, raw_len + 1)
    mut w: usize = 0
    mut k = start
    loop k < end {
        if source[k] == '\t' {
            buf[w] = ' '
        } else {
            buf[w] = source[k]
        }
        w += 1
        k += 1
    }
    buf[w] = 0 as u8
    return buf as string
}

// Counts the decimal digits of n — the gutter width (no min-width padding).
act pretty_digit_count(n: i32) -> usize {
    if n <= 0 {
        return 1
    }
    mut v = n
    mut c: usize = 1
    loop v > 9 {
        v /= 10
        c += 1
    }
    return c
}

// Appends `count` spaces to sb — the alignment/caret pad construction helper.
act pretty_pad_spaces(sb: @StringBuilder, count: usize) {
    mut i: usize = 0
    loop i < count {
        sb_append_char(sb, ' ')
        i += 1
    }
}

// 6.3 S4: Color state for diagnostic snippet blocks.
mut g_pretty_color: bool = false

act pretty_set_color(enabled: bool) {
    g_pretty_color = enabled
}

act pretty_get_color() -> bool {
    return g_pretty_color
}

// Renders one diagnostic's source-snippet block (spec above). Stage 2 calls
// it via report_parse for parse rows; Stage 1 mirrors the exact bytes in
// velo/pretty_diag.py.
act pretty_render_block(file: string, line: i32, col: i32, length: usize, message: string, sev: string, source: string) {
    if g_diag_collector_active {
        return
    }
    if g_pretty_color {
        if sev == "error" {
            println_str("{file}:{line}:{col}: \x1b[31merror\x1b[0m: {message}")
        } else if sev == "warning" {
            println_str("{file}:{line}:{col}: \x1b[33mwarning\x1b[0m: {message}")
        } else {
            println_str("{file}:{line}:{col}: {sev}: {message}")
        }
    } else {
        println_str("{file}:{line}:{col}: {sev}: {message}")
    }
    let src_line = pretty_line_text(source, line)
    println_str("{line} | {src_line}")
    let w = pretty_digit_count(line)
    mut span_len: usize = 1
    if length > 1 {
        span_len = length
    }
    mut pad = create_sb(w + (col as usize) + span_len + 16)
    pretty_pad_spaces(@pad, w + 1)
    sb_append_str(@pad, "| ")
    mut caret_pad: usize = 0
    if col > 1 {
        caret_pad = (col - 1) as usize
    }
    pretty_pad_spaces(@pad, caret_pad)
    if g_pretty_color {
        sb_append_str(@pad, "\x1b[1m")
    }
    mut s: usize = 0
    loop s < span_len {
        sb_append_char(@pad, '^')
        s += 1
    }
    if g_pretty_color {
        sb_append_str(@pad, "\x1b[0m")
    }
    println_str(sb_to_string(@pad))
}
