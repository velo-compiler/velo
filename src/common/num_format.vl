// Numeric literal formatting and suffix extraction helpers for C99 emission.
use "utils.vl"
use "num_utils.vl"

// Extracts the explicit type suffix from a number literal (e.g. "u8", "i64", "f64").
act extract_literal_suffix(source: string, start: usize, len: usize) -> string {
    if len >= 5 {
        let s5 = copy_slice_to_string(source, start + len - 5, 5)
        if s5 == "usize" or s5 == "isize" { return s5 }
    }
    if len >= 3 {
        let s3 = copy_slice_to_string(source, start + len - 3, 3)
        if s3 == "u16" or s3 == "u32" or s3 == "u64" or s3 == "i16" or s3 == "i32" or s3 == "i64" or s3 == "f32" or s3 == "f64" {
            return s3
        }
    }
    if len >= 2 {
        let s2 = copy_slice_to_string(source, start + len - 2, 2)
        if s2 == "u8" or s2 == "i8" { return s2 }
    }
    if len >= 1 {
        let c = source[start + len - 1]
        if (c == 'f' or c == 'F') and not (len >= 2 and (source[start + 1] == 'x' or source[start + 1] == 'X')) {
            return "f32"
        }
    }
    return ""
}

// Formats a literal into a C99-compatible numeric string, removing underscores and adapting suffixes.
act format_c_number_literal(source: string, start: usize, len: usize, is_float: bool) -> string {
    if len >= 1 and source[start] == '\'' {
        return copy_slice_to_string(source, start, len)
    }

    let suffix = extract_literal_suffix(source, start, len)
    let s_len = str.len(suffix)
    let digits_len = len - s_len

    // Binary and Octal literals (0b..., 0o...) -> convert to integer decimal string
    if digits_len >= 2 and source[start] == '0' and (source[start + 1] == 'b' or source[start + 1] == 'B' or source[start + 1] == 'o' or source[start + 1] == 'O') {
        let b = source[start + 1]
        mut val: u64 = 0u64
        if b == 'b' or b == 'B' {
            let lit = parse_bin_int_literal(source, start, len)
            val = lit.val
        } else {
            let lit = parse_oct_int_literal(source, start, len)
            val = lit.val
        }
        mut sfx_c = ""
        if suffix == "u64" or suffix == "usize" { sfx_c = "ULL" }
        else if suffix == "i64" or suffix == "isize" { sfx_c = "LL" }
        else if suffix == "u32" or suffix == "u16" or suffix == "u8" { sfx_c = "U" }
        return u64_to_decimal_string(val, sfx_c)
    }

    // Decimal and Hexadecimal: copy digits omitting '_' underscores
    mut buf: @u8 = mem.alloc(@u8, digits_len + 16)
    mut count: usize = 0
    mut has_dot = false
    mut has_exp = false

    let is_hex = digits_len >= 2 and source[start] == '0' and (source[start + 1] == 'x' or source[start + 1] == 'X')
    if not is_float and not is_hex {
        // Strip leading zeros for decimal integer literals to avoid C treating them as octal
        mut first_non_zero: usize = start + digits_len
        mut j = start
        loop j < start + digits_len {
            let c = source[j]
            if c >= '1' and c <= '9' {
                first_non_zero = j
                j = start + digits_len
            } else {
                j += 1
            }
        }
        if first_non_zero == start + digits_len {
            buf[count] = '0'
            count += 1
        } else {
            mut i = first_non_zero
            loop i < start + digits_len {
                let c = source[i]
                if c != '_' {
                    buf[count] = c
                    count += 1
                }
                i += 1
            }
        }
    } else {
        mut i = start
        loop i < start + digits_len {
            let c = source[i]
            if c != '_' {
                if c == '.' { has_dot = true }
                if c == 'e' or c == 'E' { has_exp = true }
                buf[count] = c
                count += 1
            }
            i += 1
        }
    }

    // Append C-compatible suffix
    if is_float {
        if not has_dot and not has_exp {
            buf[count] = '.'; buf[count + 1] = '0'; count += 2
        }
        if suffix != "f64" {
            buf[count] = 'f'; count += 1
        }
    } else {
        if suffix == "u64" or suffix == "usize" {
            buf[count] = 'U'; buf[count + 1] = 'L'; buf[count + 2] = 'L'; count += 3
        } else if suffix == "i64" or suffix == "isize" {
            buf[count] = 'L'; buf[count + 1] = 'L'; count += 2
        } else if suffix == "u32" or suffix == "u16" or suffix == "u8" {
            buf[count] = 'U'; count += 1
        }
    }

    buf[count] = 0 as u8
    return buf as string
}
