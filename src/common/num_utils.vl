// Numeric literal parsing and C99 literal formatting helpers.
use "utils.vl"
use "char_utils.vl"
use "float_utils.vl"
use "num_format.vl"

// Wide integer literal representation: holds magnitude (u64), base (2, 8, 10, 16),
// sign flag, and an explicit overflow flag.
data IntLiteral {
    val: u64
    base: i32
    is_neg: bool
    overflow: bool
}

// Constructs an IntLiteral with explicit field values.
act make_int_literal(val: u64, base: i32, is_neg: bool, overflow: bool) -> IntLiteral {
    return IntLiteral{ val: val, base: base, is_neg: is_neg, overflow: overflow }
}

// Constructs a valid, non-negative, non-overflowing IntLiteral.
act make_int_literal_val(val: u64, base: i32) -> IntLiteral {
    return IntLiteral{ val: val, base: base, is_neg: false, overflow: false }
}

// Constructs an explicit overflow IntLiteral marker.
act make_int_literal_overflow(base: i32, is_neg: bool) -> IntLiteral {
    return IntLiteral{ val: 0u64, base: base, is_neg: is_neg, overflow: true }
}

// Returns true if the literal fits within signed 32-bit integer range [-2147483648, 2147483647].
act int_lit_fits_i32(lit: IntLiteral) -> bool {
    if lit.overflow { return false }
    if lit.is_neg { return lit.val <= 2147483648u64 }
    return lit.val <= 2147483647u64
}

// Returns true if the literal fits within unsigned 32-bit integer range [0, 4294967295].
act int_lit_fits_u32(lit: IntLiteral) -> bool {
    if lit.overflow or lit.is_neg { return false }
    return lit.val <= 4294967295u64
}

// Returns true if the literal fits within signed 64-bit integer range [-9223372036854775808, 9223372036854775807].
act int_lit_fits_i64(lit: IntLiteral) -> bool {
    if lit.overflow { return false }
    if lit.is_neg { return lit.val <= 0x8000000000000000u64 }
    return lit.val <= 0x7FFFFFFFFFFFFFFFu64
}

// Returns true if the literal fits within unsigned 64-bit integer range [0, 18446744073709551615].
act int_lit_fits_u64(lit: IntLiteral) -> bool {
    return not lit.overflow and not lit.is_neg
}

// Safely converts an IntLiteral to signed 32-bit integer without truncation.
// Returns false if the value does not fit i32 or has overflow set.
act int_lit_to_i32_checked(lit: IntLiteral, out_val: @i32) -> bool {
    if out_val == null or not int_lit_fits_i32(lit) { return false }
    if lit.is_neg {
        if lit.val == 2147483648u64 {
            out_val[0] = -2147483647 - 1
        } else {
            out_val[0] = -((lit.val as u32) as i32)
        }
    } else {
        out_val[0] = (lit.val as u32) as i32
    }
    return true
}

// Safely converts an IntLiteral to unsigned 64-bit integer without truncation.
// Returns false if the value is negative or has overflow set.
act int_lit_to_u64_checked(lit: IntLiteral, out_val: @u64) -> bool {
    if out_val == null or lit.overflow or lit.is_neg { return false }
    out_val[0] = lit.val
    return true
}

// Safely converts an IntLiteral to signed 64-bit integer without truncation.
// Returns false if the value does not fit i64 or has overflow set.
act int_lit_to_i64_checked(lit: IntLiteral, out_val: @i64) -> bool {
    if out_val == null or not int_lit_fits_i64(lit) { return false }
    if lit.is_neg {
        if lit.val == 0x8000000000000000u64 {
            out_val[0] = -9223372036854775807i64 - 1i64
        } else {
            out_val[0] = -(lit.val as i64)
        }
    } else {
        out_val[0] = lit.val as i64
    }
    return true
}

// Formats an unsigned 64-bit integer into a decimal string with an optional suffix.
act u64_to_decimal_string(val: u64, suffix: string) -> string {
    mut buf: @u8 = mem.alloc(@u8, 32)
    mut count: usize = 0
    if val == 0u64 {
        buf[0] = '0'
        count = 1
    } else {
        mut temp: @u8 = mem.alloc(@u8, 24)
        mut tc: usize = 0
        mut n = val
        loop n > 0u64 {
            temp[tc] = ('0' as u8) + ((n % 10u64) as u8)
            n = n / 10u64
            tc += 1
        }
        loop tc > 0 {
            tc -= 1
            buf[count] = temp[tc]
            count += 1
        }
    }
    if suffix != null {
        mut s_idx: usize = 0
        let s_len = str.len(suffix)
        loop s_idx < s_len {
            buf[count] = suffix[s_idx]
            count += 1
            s_idx += 1
        }
    }
    buf[count] = 0 as u8
    return buf as string
}

// Parses a decimal integer literal from an ASCII slice into the wide IntLiteral model.
// Gating: checks for overflow beyond UINT64_MAX (18446744073709551615) and rejects malformed characters.
act parse_decimal_int_literal(source: string, start: usize, len: usize) -> IntLiteral {
    let suffix = extract_literal_suffix(source, start, len)
    let s_len = str.len(suffix)
    let digits_len = len - s_len

    mut val: u64 = 0u64
    mut overflow = false
    mut has_digits = false
    mut i = start
    let end = start + digits_len

    loop i < end {
        let c = source[i]
        if c == '_' {
            i += 1
        } else if c >= '0' and c <= '9' {
            has_digits = true
            let digit = ((c as u64) - ('0' as u64))
            if not overflow {
                if val > 1844674407370955161u64 or (val == 1844674407370955161u64 and digit > 5u64) {
                    overflow = true
                } else {
                    val = val * 10u64 + digit
                }
            }
            i += 1
        } else {
            overflow = true
            i = end
        }
    }
    if not has_digits { overflow = true }
    return make_int_literal(val, 10, false, overflow)
}

// Returns the numeric value (0-15) of an ASCII hexadecimal character.
act parse_hex_digit(c: u8) -> i32 {
    if c >= '0' and c <= '9' { return (c as i32) - ('0' as i32) }
    if c >= 'a' and c <= 'f' { return (c as i32) - ('a' as i32) + 10 }
    if c >= 'A' and c <= 'F' { return (c as i32) - ('A' as i32) + 10 }
    return 0
}

// Parses an integer or character literal value from an ASCII slice.
act parse_int_from_slice(source: string, start: usize, len: usize) -> i32 {
    if len >= 2 and source[start] == '\'' {
        return parse_char_literal(source, start, len)
    }

    if len >= 2 and source[start] == '0' {
        let b = source[start + 1]
        if b == 'x' or b == 'X' {
            let hex_lit = parse_hex_int_literal(source, start, len)
            return hex_lit.val as i32
        } else if b == 'b' or b == 'B' {
            let bin_lit = parse_bin_int_literal(source, start, len)
            return bin_lit.val as i32
        } else if b == 'o' or b == 'O' {
            let oct_lit = parse_oct_int_literal(source, start, len)
            return oct_lit.val as i32
        }
    }
    let dec_lit = parse_decimal_int_literal(source, start, len)
    return dec_lit.val as i32
}

// Parses a hexadecimal integer literal (0x... or 0X...) into the wide IntLiteral model.
// Gating: checks for overflow beyond UINT64_MAX (0xFFFFFFFFFFFFFFFF) and rejects empty or malformed hex digits.
act parse_hex_int_literal(source: string, start: usize, len: usize) -> IntLiteral {
    let suffix = extract_literal_suffix(source, start, len)
    let s_len = str.len(suffix)
    let digits_len = len - s_len

    if digits_len < 3 or source[start] != '0' {
        return make_int_literal_overflow(16, false)
    }
    let pfx = source[start + 1]
    if pfx != 'x' and pfx != 'X' {
        return make_int_literal_overflow(16, false)
    }

    mut val: u64 = 0u64
    mut overflow = false
    mut has_digits = false
    mut i = start + 2
    let end = start + digits_len

    loop i < end {
        let c = source[i]
        if c == '_' {
            i += 1
        } else if (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F') {
            has_digits = true
            let digit = (char_hex_digit(c) as u32) as u64
            if not overflow {
                if val > 0x0FFFFFFFFFFFFFFFu64 {
                    overflow = true
                } else {
                    val = (val << 4u64) | digit
                }
            }
            i += 1
        } else {
            overflow = true
            i = end
        }
    }
    if not has_digits { overflow = true }
    return make_int_literal(val, 16, false, overflow)
}

// Parses a binary integer literal (0b... or 0B...) into the wide IntLiteral model.
// Gating: checks for overflow beyond UINT64_MAX, rejects empty (0b only) or invalid binary digits.
act parse_bin_int_literal(source: string, start: usize, len: usize) -> IntLiteral {
    let suffix = extract_literal_suffix(source, start, len)
    let s_len = str.len(suffix)
    let digits_len = len - s_len

    if digits_len < 3 or source[start] != '0' {
        return make_int_literal_overflow(2, false)
    }
    let pfx = source[start + 1]
    if pfx != 'b' and pfx != 'B' {
        return make_int_literal_overflow(2, false)
    }

    mut val: u64 = 0u64
    mut overflow = false
    mut has_digits = false
    mut i = start + 2
    let end = start + digits_len

    loop i < end {
        let c = source[i]
        if c == '_' {
            i += 1
        } else if c == '0' or c == '1' {
            has_digits = true
            let digit = ((c as i32) - ('0' as i32)) as u64
            if not overflow {
                if val > 0x7FFFFFFFFFFFFFFFu64 {
                    overflow = true
                } else {
                    val = (val << 1u64) | digit
                }
            }
            i += 1
        } else {
            overflow = true
            i = end
        }
    }
    if not has_digits { overflow = true }
    return make_int_literal(val, 2, false, overflow)
}

// Parses an octal integer literal (0o... or 0O...) into the wide IntLiteral model.
// Gating: checks for overflow beyond UINT64_MAX, rejects empty (0o only) or invalid octal digits.
act parse_oct_int_literal(source: string, start: usize, len: usize) -> IntLiteral {
    let suffix = extract_literal_suffix(source, start, len)
    let s_len = str.len(suffix)
    let digits_len = len - s_len

    if digits_len < 3 or source[start] != '0' {
        return make_int_literal_overflow(8, false)
    }
    let pfx = source[start + 1]
    if pfx != 'o' and pfx != 'O' {
        return make_int_literal_overflow(8, false)
    }

    mut val: u64 = 0u64
    mut overflow = false
    mut has_digits = false
    mut i = start + 2
    let end = start + digits_len

    loop i < end {
        let c = source[i]
        if c == '_' {
            i += 1
        } else if c >= '0' and c <= '7' {
            has_digits = true
            let digit = ((c as i32) - ('0' as i32)) as u64
            if not overflow {
                if val > 0x1FFFFFFFFFFFFFFFu64 {
                    overflow = true
                } else {
                    val = (val << 3u64) | digit
                }
            }
            i += 1
        } else {
            overflow = true
            i = end
        }
    }
    if not has_digits { overflow = true }
    return make_int_literal(val, 8, false, overflow)
}

