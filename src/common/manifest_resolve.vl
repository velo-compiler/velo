// Dependency resolution for package manifests (Phase 72 / Tasks 72.1 & 72.2).
// Resolves 'local', 'git', and 'registry' dependencies with fail-closed diagnostics.
extern act system(cmd: string) -> i32
extern act velo_host_getenv(key: string) -> string

use std.io
use std.fs
use std.path
use std.json
use "manifest.vl"
use "semver.vl"
use "string_builder.vl"
use "utils.vl"

data DepLocation {
    path: string
    commit: string
    version: string
    archive_url: string
    expected_hash: string
    has_error: bool
    error_msg: string
}

// Converts a StrSlice to a null-terminated string.
act json_slice_to_str(s: StrSlice) -> string {
    if s.ptr == null or s.len == 0 { return "" }
    mut buf: @u8 = mem.alloc(@u8, s.len + 1)
    mut i: usize = 0
    loop i < s.len {
        buf[i] = s.ptr[i]
        i += 1
    }
    buf[s.len] = 0 as u8
    return buf as string
}

// Executes an external command string via the C runtime.
act run_sys_cmd(cmd: string) -> i32 {
    return system(cmd)
}

// Resolves a dependency specification to a local directory location and commit/version.
act manifest_resolve_dep(dep: @DependencySpec) -> DepLocation {
    return manifest_resolve_dep_in(".", dep)
}

// Resolves a dependency specification relative to a base manifest directory.
act manifest_resolve_dep_in(m_dir: string, dep: @DependencySpec) -> DepLocation {
    return manifest_resolve_dep_full(m_dir, dep, false, "")
}

// Resolves a dependency with full options (insecure TLS override, custom registry URL).
act manifest_resolve_dep_full(m_dir: string, dep: @DependencySpec, insecure: bool, registry_override: string) -> DepLocation {
    mut loc = DepLocation{ path: "", commit: "", version: "", archive_url: "", expected_hash: "", has_error: false, error_msg: "" }
    if dep == null {
        loc.has_error = true
        loc.error_msg = "[Velo Error] Null dependency specification"
        return loc
    }

    if str.contains(dep.name, "/") or str.contains(dep.name, "\\") or str.contains(dep.name, "..") {
        loc.has_error = true
        loc.error_msg = "[Velo Error] Invalid dependency name '" + dep.name + "': contains path separators"
        return loc
    }

    if dep.kind == "local" {
        if dep.source == null or str.len(dep.source) == 0 {
            loc.has_error = true
            loc.error_msg = "[Velo Error] Local dependency '" + dep.name + "' has empty path."
            return loc
        }
        mut resolved_path = dep.source
        let is_abs = str.starts_with(dep.source, "/") or str.starts_with(dep.source, "\\") or (str.len(dep.source) > 2 and dep.source[1] == ':')
        if !is_abs and m_dir != null and str.len(m_dir) > 0 and m_dir != "." {
            resolved_path = path_join_str(m_dir, dep.source)
        }
        if !fs_exists(resolved_path) {
            loc.has_error = true
            loc.error_msg = "[Velo Error] Local dependency '" + dep.name + "' not found at path '" + resolved_path + "'"
            return loc
        }
        loc.path = resolved_path
        loc.commit = ""
        loc.version = if str.len(dep.tag) > 0 { dep.tag } else { "local" }
        return loc
    }

    if dep.kind == "git" {
        if dep.source == null or str.len(dep.source) == 0 {
            loc.has_error = true
            loc.error_msg = "[Velo Error] Git dependency '" + dep.name + "' has empty repository URL."
            return loc
        }

        mut deps_parent = ".velo_cache/deps"
        if m_dir != null and str.len(m_dir) > 0 and m_dir != "." {
            deps_parent = path_join_str(m_dir, ".velo_cache/deps")
        }
        if !fs_exists(deps_parent) {
            fs_create_dir_all(deps_parent)
        }

        // 1. Check git availability using safe probe output file in .velo_cache
        let git_check_file = path_join_str(deps_parent, "_git_probe.tmp")
        mut probe_sb = create_sb(128)
        sb_append_str(@probe_sb, "git --version > ")
        sb_append_str(@probe_sb, quote_path(git_check_file))
        sb_append_str(@probe_sb, " 2>&1")
        let probe_cmd = sb_to_string(@probe_sb)
        let probe_res = run_sys_cmd(probe_cmd)
        if fs_exists(git_check_file) {
            fs_remove_file_str(git_check_file)
        }
        if probe_res != 0 {
            loc.has_error = true
            loc.error_msg = "[Velo Error] 'git' executable not found in PATH. Git is required to resolve dependency '" + dep.name + "' from '" + dep.source + "'. Please install Git and ensure it is available in your PATH."
            return loc
        }

        let dest_path = path_join_str(deps_parent, dep.name)

        // 2. Clone if destination directory does not exist
        if !fs_exists(dest_path) {
            mut clone_sb = create_sb(512)
            sb_append_str(@clone_sb, "git clone --depth 1")
            if dep.tag != null and str.len(dep.tag) > 0 {
                sb_append_str(@clone_sb, " --branch ")
                sb_append_str(@clone_sb, quote_path(dep.tag))
            }
            sb_append_char(@clone_sb, ' ')
            sb_append_str(@clone_sb, quote_path(dep.source))
            sb_append_char(@clone_sb, ' ')
            sb_append_str(@clone_sb, quote_path(dest_path))

            let clone_err_file = path_join_str(deps_parent, "_clone_err.tmp")
            sb_append_str(@clone_sb, " 2> ")
            sb_append_str(@clone_sb, quote_path(clone_err_file))

            let clone_cmd = sb_to_string(@clone_sb)
            let clone_res = run_sys_cmd(clone_cmd)
            mut clone_err = ""
            if fs_exists(clone_err_file) {
                let err_content = fs_read_to_str(clone_err_file)
                if err_content != null { clone_err = str.trim(err_content) }
                fs_remove_file_str(clone_err_file)
            }

            if clone_res != 0 or !fs_exists(dest_path) {
                loc.has_error = true
                mut err_msg = "[Velo Error] Failed to clone git dependency '" + dep.name + "' from '" + dep.source + "'"
                if str.len(clone_err) > 0 {
                    err_msg = err_msg + ": " + clone_err
                }
                loc.error_msg = err_msg
                return loc
            }
        }

        // 3. Run git rev-parse HEAD inside dest_path to capture exact commit hash
        let rev_out_file = path_join_str(dest_path, "_head_rev.tmp")
        mut rev_sb = create_sb(256)
        sb_append_str(@rev_sb, "git -C ")
        sb_append_str(@rev_sb, quote_path(dest_path))
        sb_append_str(@rev_sb, " rev-parse HEAD > ")
        sb_append_str(@rev_sb, quote_path(rev_out_file))
        sb_append_str(@rev_sb, " 2>&1")
        let rev_cmd = sb_to_string(@rev_sb)
        let rev_res = run_sys_cmd(rev_cmd)

        mut commit_sha = ""
        if fs_exists(rev_out_file) {
            let sha_content = fs_read_to_str(rev_out_file)
            if sha_content != null { commit_sha = str.trim(sha_content) }
            fs_remove_file_str(rev_out_file)
        }

        if rev_res != 0 or str.len(commit_sha) == 0 {
            loc.has_error = true
            loc.error_msg = "[Velo Error] Failed to get git commit for dependency '" + dep.name + "'"
            return loc
        }

        loc.path = dest_path
        loc.commit = commit_sha
        loc.version = if str.len(dep.tag) > 0 { dep.tag } else { commit_sha }
        return loc
    }

    if dep.kind == "registry" {
        if dep.source == null or str.len(dep.source) == 0 {
            loc.has_error = true
            loc.error_msg = "[Velo Error] Registry dependency '" + dep.name + "' has empty version string."
            return loc
        }

        // Validate semver requirement syntax (Phase 72 / Task 72.4)
        let req = semver_parse_req(dep.source)
        if !req.is_valid {
            loc.has_error = true
            loc.error_msg = "[Velo Error] Invalid or ambiguous semver requirement '" + dep.source + "' for dependency '" + dep.name + "'. Supported operators are '=', '^', '~', and '>='; " + req.error_msg
            return loc
        }

        // Determine registry base URL
        mut reg_url = registry_override
        if str.len(reg_url) == 0 {
            reg_url = velo_host_getenv("VELO_REGISTRY")
        }
        if str.len(reg_url) == 0 {
            reg_url = "https://pkg.velolang.org"
        }
        let rlen = str.len(reg_url)
        if rlen > 0 and reg_url[rlen - 1] == '/' {
            reg_url = copy_slice_to_string(reg_url, 0, rlen - 1)
        }

        // Build index URL: <reg_url>/<dep.name>/index.json
        mut url_sb = create_sb(256)
        sb_append_str(@url_sb, reg_url)
        sb_append_char(@url_sb, '/')
        sb_append_str(@url_sb, dep.name)
        sb_append_str(@url_sb, "/index.json")
        let index_url = sb_to_string(@url_sb)

        // Validate transport security (Phase 73 / Task 72.2)
        let is_https = str.starts_with(index_url, "https://")
        let is_http = str.starts_with(index_url, "http://")

        if is_http and !insecure {
            loc.has_error = true
            loc.error_msg = "[Velo Error] Plaintext HTTP registry URL '" + index_url + "' is disallowed without explicit --insecure flag."
            return loc
        }
        if is_http and insecure {
            println_str("[Velo Warning] Insecure connection to '" + index_url + "': cleartext HTTP used.")
        }
        if is_https and insecure {
            println_str("[Velo Warning] TLS certificate verification disabled via --insecure for registry '" + index_url + "'.")
        }

        mut deps_parent = ".velo_cache/deps"
        if m_dir != null and str.len(m_dir) > 0 and m_dir != "." {
            deps_parent = path_join_str(m_dir, ".velo_cache/deps")
        }
        if !fs_exists(deps_parent) {
            fs_create_dir_all(deps_parent)
        }

        // Check curl availability
        let curl_check_file = path_join_str(deps_parent, "_curl_probe.tmp")
        mut probe_sb = create_sb(128)
        sb_append_str(@probe_sb, "curl --version > ")
        sb_append_str(@probe_sb, quote_path(curl_check_file))
        sb_append_str(@probe_sb, " 2>&1")
        let probe_cmd = sb_to_string(@probe_sb)
        let probe_res = run_sys_cmd(probe_cmd)
        if fs_exists(curl_check_file) {
            fs_remove_file_str(curl_check_file)
        }
        if probe_res != 0 {
            loc.has_error = true
            loc.error_msg = "[Velo Error] 'curl' executable not found in PATH. Curl is required to fetch registry dependencies from '" + index_url + "'. Please install Curl and ensure it is available in your PATH."
            return loc
        }

        // Fetch index.json to a temporary file
        let index_tmp_file = path_join_str(deps_parent, dep.name + "_index.json.tmp")
        let curl_err_file = path_join_str(deps_parent, dep.name + "_curl_err.tmp")

        mut curl_sb = create_sb(512)
        sb_append_str(@curl_sb, "curl -sSf -L")
        if insecure {
            sb_append_str(@curl_sb, " -k")
        }
        sb_append_char(@curl_sb, ' ')
        sb_append_str(@curl_sb, quote_path(index_url))
        sb_append_str(@curl_sb, " -o ")
        sb_append_str(@curl_sb, quote_path(index_tmp_file))
        sb_append_str(@curl_sb, " 2> ")
        sb_append_str(@curl_sb, quote_path(curl_err_file))
        let curl_cmd = sb_to_string(@curl_sb)
        let curl_res = run_sys_cmd(curl_cmd)

        mut curl_err = ""
        if fs_exists(curl_err_file) {
            let err_txt = fs_read_to_str(curl_err_file)
            if err_txt != null { curl_err = str.trim(err_txt) }
            fs_remove_file_str(curl_err_file)
        }

        if curl_res != 0 or !fs_exists(index_tmp_file) {
            loc.has_error = true
            mut msg = "[Velo Error] Failed to fetch registry index from '" + index_url + "'"
            if str.len(curl_err) > 0 {
                msg = msg + ": " + curl_err
            }
            loc.error_msg = msg
            return loc
        }

        let index_content = fs_read_to_str(index_tmp_file)
        fs_remove_file_str(index_tmp_file)
        if index_content == null or str.len(index_content) == 0 {
            loc.has_error = true
            loc.error_msg = "[Velo Error] Empty registry index received from '" + index_url + "'"
            return loc
        }

        // Parse JSON index
        mut doc = json_parse_doc_str(index_content, 65536)
        if doc.root == null or doc.root.kind != JSON_OBJECT {
            json_doc_free(@doc)
            loc.has_error = true
            loc.error_msg = "[Velo Error] Invalid JSON in registry index from '" + index_url + "'"
            return loc
        }

        mut versions_obj: @JsonValue = json_obj_get_str(doc.root, "versions")
        if versions_obj == null or versions_obj.kind != JSON_OBJECT {
            versions_obj = doc.root
        }

        mut best_obj: @JsonValue = null
        mut best_ver = SemVer{ major: -1, minor: -1, patch: -1, is_valid: false }
        mut best_key = ""

        mut cur_child = versions_obj.first_child
        loop cur_child != null {
            let ver_key = json_slice_to_str(cur_child.key)
            if str.len(ver_key) > 0 and cur_child.kind == JSON_OBJECT {
                let parsed_ver = semver_parse(ver_key)
                if parsed_ver.is_valid and semver_satisfies(@parsed_ver, @req) {
                    if !best_ver.is_valid or semver_cmp(@parsed_ver, @best_ver) > 0 {
                        best_ver = parsed_ver
                        best_key = ver_key
                        best_obj = cur_child
                    }
                }
            }
            cur_child = cur_child.next
        }

        if best_obj == null {
            json_doc_free(@doc)
            loc.has_error = true
            loc.error_msg = "[Velo Error] Version '" + dep.source + "' of package '" + dep.name + "' not found in registry index at '" + index_url + "'"
            return loc
        }

        let url_slice = json_obj_get_str_val(best_obj, "url", "")
        let sha_slice = json_obj_get_str_val(best_obj, "sha256", "")
        let pkg_url = json_slice_to_str(url_slice)
        let expected_sha = json_slice_to_str(sha_slice)
        json_doc_free(@doc)

        if str.len(pkg_url) == 0 {
            loc.has_error = true
            loc.error_msg = "[Velo Error] Registry index entry for '" + dep.name + "@" + best_key + "' is missing 'url' field"
            return loc
        }
        if str.len(expected_sha) == 0 {
            loc.has_error = true
            loc.error_msg = "[Velo Error] Registry index entry for '" + dep.name + "@" + best_key + "' is missing 'sha256' field"
            return loc
        }

        let dest_path = path_join_str(deps_parent, dep.name)
        loc.path = dest_path
        loc.commit = expected_sha
        loc.version = best_key
        loc.archive_url = pkg_url
        loc.expected_hash = expected_sha
        loc.has_error = false
        return loc
    }

    loc.has_error = true
    loc.error_msg = "[Velo Error] Unknown dependency kind '" + dep.kind + "' for dependency '" + dep.name + "'"
    return loc
}
