// Floating-point literal parsing helpers for Velo.
use "utils.vl"

// Parses a 32-bit floating point value from an ASCII slice.
act parse_float_from_slice(source: string, start: usize, len: usize) -> f32 {
    mut i = start
    let end = start + len
    mut int_part: f32 = 0.0
    mut frac_part: f32 = 0.0
    mut divisor: f32 = 1.0
    mut has_dot: bool = false
    mut in_exponent: bool = false
    mut exp_neg: bool = false
    mut exp_val: i32 = 0

    loop i < end {
        let c = source[i]
        if c == '_' {
            i += 1
        } else if c == '.' and not in_exponent and not has_dot {
            has_dot = true
            i += 1
        } else if (c == 'e' or c == 'E') and not in_exponent {
            in_exponent = true
            i += 1
            if i < end and source[i] == '-' {
                exp_neg = true
                i += 1
            } else if i < end and source[i] == '+' {
                i += 1
            }
        } else if c >= '0' and c <= '9' {
            let digit = ((c as i32) - ('0' as i32)) as f32
            if in_exponent {
                exp_val = exp_val * 10 + ((c as i32) - ('0' as i32))
            } else if not has_dot {
                int_part = int_part * 10.0 + digit
            } else {
                divisor = divisor * 10.0
                frac_part = frac_part + (digit / divisor)
            }
            i += 1
        } else {
            i = end
        }
    }

    mut base_val = int_part + frac_part
    if in_exponent and exp_val > 0 {
        mut factor: f32 = 1.0
        mut k = 0
        loop k < exp_val {
            factor = factor * 10.0
            k += 1
        }
        if exp_neg {
            base_val = base_val / factor
        } else {
            base_val = base_val * factor
        }
    }
    return base_val
}
