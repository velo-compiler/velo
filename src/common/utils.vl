use sys.mem
use "path.vl"

// Character classification and scanning helper functions.

// Checks if a byte is ASCII horizontal whitespace (space, tab, carriage return).
act is_whitespace(c: u8) -> bool {
    return c == ' ' or c == '\t' or c == '\r'
}

// Checks if a byte is a newline separator.
act is_newline(c: u8) -> bool {
    return c == '\n'
}

// Checks if a byte is an alphabetic character [a-zA-Z].
act is_alpha(c: u8) -> bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

// Checks if a byte is a decimal digit [0-9].
act is_digit(c: u8) -> bool {
    return c >= '0' and c <= '9'
}

// Checks if a byte can begin an identifier [a-zA-Z_].
act is_ident_start(c: u8) -> bool {
    return is_alpha(c) or c == '_'
}

// Checks if a byte can continue an identifier [a-zA-Z0-9_].
act is_ident_part(c: u8) -> bool {
    return is_alpha(c) or is_digit(c) or c == '_'
}

// Allocates a null-terminated string copy of a slice inside the active zone arena.
act copy_slice_to_string(source: string, start: usize, len: usize) -> string {
    mut buf: @u8 = mem.alloc(@u8, len + 1)
    mut i: usize = 0
    while i < len {
        buf[i] = source[start + i]
        i += 1
    }
    buf[len] = 0 as u8
    return buf as string
}

// Returns the numeric value (0-15) of an ASCII hexadecimal character.
act parse_hex_digit(c: u8) -> i32 {
    if c >= '0' and c <= '9' { return (c as i32) - ('0' as i32) }
    if c >= 'a' and c <= 'f' { return (c as i32) - ('a' as i32) + 10 }
    if c >= 'A' and c <= 'F' { return (c as i32) - ('A' as i32) + 10 }
    return 0
}

// Parses an integer or character literal value from an ASCII slice.
act parse_int_from_slice(source: string, start: usize, len: usize) -> i32 {
    if len >= 2 and source[start] == '\'' {
        if source[start + 1] == '\\' {
            if len >= 3 {
                let esc = source[start + 2]
                if esc == 'n' { return 10 }
                if esc == 't' { return 9 }
                if esc == 'r' { return 13 }
                if esc == '0' { return 0 }
                if esc == '\'' { return 39 }
                if esc == '"' { return 34 }
                if esc == '\\' { return 92 }
                if esc == 'x' and len >= 5 {
                    let p = start + 3
                    return (parse_hex_digit(source[p]) << 4) | parse_hex_digit(source[p + 1])
                }
                if esc == 'u' and len >= 7 {
                    let p = start + 3
                    return (parse_hex_digit(source[p]) << 12) | (parse_hex_digit(source[p + 1]) << 8) | (parse_hex_digit(source[p + 2]) << 4) | parse_hex_digit(source[p + 3])
                }
                return esc as i32
            }
        }
        return source[start + 1] as i32
    }

    mut i = start
    let end = start + len
    mut base: i32 = 10
    if len >= 2 and source[start] == '0' {
        let b = source[start + 1]
        if b == 'x' or b == 'X' {
            base = 16
            i = start + 2
        } else if b == 'b' or b == 'B' {
            base = 2
            i = start + 2
        } else if b == 'o' or b == 'O' {
            base = 8
            i = start + 2
        }
    }

    mut result: i32 = 0
    while i < end {
        let c = source[i]
        if c == '_' {
            i += 1
        } else {
            mut digit: i32 = -1
            if c >= '0' and c <= '9' {
                digit = (c as i32) - ('0' as i32)
            } else if c >= 'a' and c <= 'f' {
                digit = (c as i32) - ('a' as i32) + 10
            } else if c >= 'A' and c <= 'F' {
                digit = (c as i32) - ('A' as i32) + 10
            }

            if digit >= 0 and digit < base {
                result = result * base + digit
                i += 1
            } else {
                i = end
            }
        }
    }
    return result
}

// Parses a 32-bit floating point value from an ASCII slice.
act parse_float_from_slice(source: string, start: usize, len: usize) -> f32 {
    mut i = start
    let end = start + len
    mut int_part: f32 = 0.0
    mut frac_part: f32 = 0.0
    mut divisor: f32 = 1.0
    mut has_dot: bool = false
    mut in_exponent: bool = false
    mut exp_neg: bool = false
    mut exp_val: i32 = 0

    while i < end {
        let c = source[i]
        if c == '_' {
            i += 1
        } else if c == '.' and not in_exponent and not has_dot {
            has_dot = true
            i += 1
        } else if (c == 'e' or c == 'E') and not in_exponent {
            in_exponent = true
            i += 1
            if i < end and source[i] == '-' {
                exp_neg = true
                i += 1
            } else if i < end and source[i] == '+' {
                i += 1
            }
        } else if c >= '0' and c <= '9' {
            let digit = ((c as i32) - ('0' as i32)) as f32
            if in_exponent {
                exp_val = exp_val * 10 + ((c as i32) - ('0' as i32))
            } else if not has_dot {
                int_part = int_part * 10.0 + digit
            } else {
                divisor = divisor * 10.0
                frac_part = frac_part + (digit / divisor)
            }
            i += 1
        } else {
            i = end
        }
    }

    mut base_val = int_part + frac_part
    if in_exponent and exp_val > 0 {
        mut factor: f32 = 1.0
        mut k = 0
        while k < exp_val {
            factor = factor * 10.0
            k += 1
        }
        if exp_neg {
            base_val = base_val / factor
        } else {
            base_val = base_val * factor
        }
    }
    return base_val
}

// Extracts the explicit type suffix from a number literal (e.g. "u8", "i64", "f64").
act extract_literal_suffix(source: string, start: usize, len: usize) -> string {
    if len >= 5 {
        let s5 = copy_slice_to_string(source, start + len - 5, 5)
        if s5 == "usize" { return "usize" }
        if s5 == "isize" { return "isize" }
    }
    if len >= 3 {
        let s3 = copy_slice_to_string(source, start + len - 3, 3)
        if s3 == "u16" { return "u16" }
        if s3 == "u32" { return "u32" }
        if s3 == "u64" { return "u64" }
        if s3 == "i16" { return "i16" }
        if s3 == "i32" { return "i32" }
        if s3 == "i64" { return "i64" }
        if s3 == "f32" { return "f32" }
        if s3 == "f64" { return "f64" }
    }
    if len >= 2 {
        let s2 = copy_slice_to_string(source, start + len - 2, 2)
        if s2 == "u8" { return "u8" }
        if s2 == "i8" { return "i8" }
    }
    if len >= 1 {
        let c = source[start + len - 1]
        if (c == 'f' or c == 'F') and not (len >= 2 and (source[start + 1] == 'x' or source[start + 1] == 'X')) {
            return "f32"
        }
    }
    return ""
}

// Formats a literal into a C99-compatible numeric string, removing underscores and adapting suffixes.
act format_c_number_literal(source: string, start: usize, len: usize, is_float: bool) -> string {
    if len >= 1 and source[start] == '\'' {
        return copy_slice_to_string(source, start, len)
    }

    let suffix = extract_literal_suffix(source, start, len)
    let s_len = str.len(suffix)
    let digits_len = len - s_len

    // Binary and Octal literals (0b..., 0o...) -> convert to integer decimal string
    if digits_len >= 2 and source[start] == '0' and (source[start + 1] == 'b' or source[start + 1] == 'B' or source[start + 1] == 'o' or source[start + 1] == 'O') {
        let val = parse_int_from_slice(source, start, len)
        mut buf: @u8 = mem.alloc(@u8, 32)
        mut count: usize = 0
        mut n = val
        if n == 0 {
            buf[0] = '0'
            count = 1
        } else {
            mut temp: @u8 = mem.alloc(@u8, 16)
            mut tc: usize = 0
            while n > 0 {
                temp[tc] = ('0' as u8) + ((n % 10) as u8)
                n = n / 10
                tc += 1
            }
            while tc > 0 {
                tc -= 1
                buf[count] = temp[tc]
                count += 1
            }
        }
        if suffix == "u64" or suffix == "usize" {
            buf[count] = 'U'; buf[count + 1] = 'L'; buf[count + 2] = 'L'; count += 3
        } else if suffix == "i64" or suffix == "isize" {
            buf[count] = 'L'; buf[count + 1] = 'L'; count += 2
        } else if suffix == "u32" or suffix == "u16" or suffix == "u8" {
            buf[count] = 'U'; count += 1
        }
        buf[count] = 0 as u8
        return buf as string
    }

    // Decimal and Hexadecimal: copy digits omitting '_' underscores
    mut buf: @u8 = mem.alloc(@u8, digits_len + 16)
    mut count: usize = 0
    mut has_dot = false
    mut has_exp = false
    mut i = start
    while i < start + digits_len {
        let c = source[i]
        if c == '.' { has_dot = true }
        if c == 'e' or c == 'E' { has_exp = true }
        if c != '_' {
            buf[count] = c
            count += 1
        }
        i += 1
    }

    if is_float {
        if not has_dot and not has_exp {
            buf[count] = '.'; buf[count + 1] = '0'; count += 2
        }
        if suffix != "f64" {
            buf[count] = 'f'; count += 1
        }
    } else {
        if suffix == "u64" or suffix == "usize" {
            buf[count] = 'U'; buf[count + 1] = 'L'; buf[count + 2] = 'L'; count += 3
        } else if suffix == "i64" or suffix == "isize" {
            buf[count] = 'L'; buf[count + 1] = 'L'; count += 2
        } else if suffix == "u32" or suffix == "u16" or suffix == "u8" {
            buf[count] = 'U'; count += 1
        }
    }

    buf[count] = 0 as u8
    return buf as string
}

// Decodes a string literal (raw backtick or standard double-quoted) into C-ready escaped format.
act process_string_literal(source: string, start: usize, len: usize) -> string {
    if len < 2 { return "" }
    let quote = source[start]
    let content_len = len - 2

    // 1. Raw multi-line string literal (`...`)
    if quote == '`' {
        mut buf: @u8 = mem.alloc(@u8, content_len * 2 + 1)
        mut count: usize = 0
        mut i: usize = 0
        while i < content_len {
            let c = source[start + 1 + i]
            if c == '\r' {
                if i + 1 < content_len and source[start + 1 + i + 1] == '\n' { i += 1 }
                buf[count] = '\\'; buf[count + 1] = 'n'; count += 2
            } else if c == '\n' {
                buf[count] = '\\'; buf[count + 1] = 'n'; count += 2
            } else if c == '\\' {
                buf[count] = '\\'; buf[count + 1] = '\\'; count += 2
            } else if c == '"' {
                buf[count] = '\\'; buf[count + 1] = '"'; count += 2
            } else {
                buf[count] = c; count += 1
            }
            i += 1
        }
        buf[count] = 0 as u8
        return buf as string
    }

    // 2. Standard double-quoted string literal ("...")
    mut buf: @u8 = mem.alloc(@u8, content_len * 2 + 1)
    mut count: usize = 0
    mut i: usize = 0
    while i < content_len {
        let c = source[start + 1 + i]
        if c == '\\' and i + 1 < content_len {
            let esc = source[start + 1 + i + 1]
            if esc == 'u' and i + 5 < content_len {
                let p = start + 1 + i + 2
                let cp = (parse_hex_digit(source[p]) << 12) | (parse_hex_digit(source[p + 1]) << 8) | (parse_hex_digit(source[p + 2]) << 4) | parse_hex_digit(source[p + 3])
                i += 6
                if cp < 128 {
                    if cp == 10 { buf[count] = '\\'; buf[count + 1] = 'n'; count += 2 }
                    else if cp == 9 { buf[count] = '\\'; buf[count + 1] = 't'; count += 2 }
                    else if cp == 13 { buf[count] = '\\'; buf[count + 1] = 'r'; count += 2 }
                    else if cp == 34 { buf[count] = '\\'; buf[count + 1] = '"'; count += 2 }
                    else if cp == 92 { buf[count] = '\\'; buf[count + 1] = '\\'; count += 2 }
                    else if cp == 0 { buf[count] = '\\'; buf[count + 1] = '0'; count += 2 }
                    else { buf[count] = cp as u8; count += 1 }
                } else if cp <= 2047 {
                    buf[count] = (192 | (cp >> 6)) as u8; count += 1
                    buf[count] = (128 | (cp & 63)) as u8; count += 1
                } else {
                    buf[count] = (224 | (cp >> 12)) as u8; count += 1
                    buf[count] = (128 | ((cp >> 6) & 63)) as u8; count += 1
                    buf[count] = (128 | (cp & 63)) as u8; count += 1
                }
            } else if esc == 'x' and i + 3 < content_len {
                let p = start + 1 + i + 2
                let b = (parse_hex_digit(source[p]) << 4) | parse_hex_digit(source[p + 1])
                i += 4
                if b == 10 { buf[count] = '\\'; buf[count + 1] = 'n'; count += 2 }
                else if b == 9 { buf[count] = '\\'; buf[count + 1] = 't'; count += 2 }
                else if b == 13 { buf[count] = '\\'; buf[count + 1] = 'r'; count += 2 }
                else if b == 34 { buf[count] = '\\'; buf[count + 1] = '"'; count += 2 }
                else if b == 92 { buf[count] = '\\'; buf[count + 1] = '\\'; count += 2 }
                else if b == 0 { buf[count] = '\\'; buf[count + 1] = '0'; count += 2 }
                else { buf[count] = b as u8; count += 1 }
            } else {
                buf[count] = '\\'; buf[count + 1] = esc; count += 2
                i += 2
            }
        } else {
            buf[count] = c; count += 1; i += 1
        }
    }
    buf[count] = 0 as u8
    return buf as string
}
