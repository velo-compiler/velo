use sys.mem
use "num_utils.vl"

// Character classification and scanning helper functions.

// Checks if a byte is ASCII horizontal whitespace (space, tab, carriage return).
act is_whitespace(c: u8) -> bool {
    return c == ' ' or c == '\t' or c == '\r'
}

// Checks if a byte is a newline separator.
act is_newline(c: u8) -> bool {
    return c == '\n'
}

// Checks if a byte is an alphabetic character [a-zA-Z].
act is_alpha(c: u8) -> bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

// Checks if a byte is a decimal digit [0-9].
act is_digit(c: u8) -> bool {
    return c >= '0' and c <= '9'
}

// Checks if a byte can begin an identifier [a-zA-Z_].
act is_ident_start(c: u8) -> bool {
    return is_alpha(c) or c == '_'
}

// Checks if a byte can continue an identifier [a-zA-Z0-9_].
act is_ident_part(c: u8) -> bool {
    return is_alpha(c) or is_digit(c) or c == '_'
}

// Allocates a null-terminated string copy of a slice inside the active zone arena.
act copy_slice_to_string(source: string, start: usize, len: usize) -> string {
    mut buf: @u8 = mem.alloc(@u8, len + 1)
    mut i: usize = 0
    loop i < len {
        buf[i] = source[start + i]
        i += 1
    }
    buf[len] = 0 as u8
    return buf as string
}

// Decodes a string literal (raw backtick or standard double-quoted) into C-ready escaped format.
act process_string_literal(source: string, start: usize, len: usize) -> string {
    if len < 2 { return "" }
    let quote = source[start]
    let content_len = len - 2

    // 1. Raw multi-line string literal (`...`)
    if quote == '`' {
        mut buf: @u8 = mem.alloc(@u8, content_len * 2 + 1)
        mut count: usize = 0
        mut i: usize = 0
        loop i < content_len {
            let c = source[start + 1 + i]
            if c == '\r' {
                if i + 1 < content_len and source[start + 1 + i + 1] == '\n' { i += 1 }
                buf[count] = '\\'; buf[count + 1] = 'n'; count += 2
            } else if c == '\n' {
                buf[count] = '\\'; buf[count + 1] = 'n'; count += 2
            } else if c == '\\' {
                buf[count] = '\\'; buf[count + 1] = '\\'; count += 2
            } else if c == '"' {
                buf[count] = '\\'; buf[count + 1] = '"'; count += 2
            } else {
                buf[count] = c; count += 1
            }
            i += 1
        }
        buf[count] = 0 as u8
        return buf as string
    }

    // 2. Standard double-quoted string literal ("...")
    mut buf: @u8 = mem.alloc(@u8, content_len * 2 + 1)
    mut count: usize = 0
    mut i: usize = 0
    loop i < content_len {
        let c = source[start + 1 + i]
        if c == '\\' and i + 1 < content_len {
            let esc = source[start + 1 + i + 1]
            if esc == 'u' and i + 5 < content_len {
                let p = start + 1 + i + 2
                let cp = (parse_hex_digit(source[p]) << 12) | (parse_hex_digit(source[p + 1]) << 8) | (parse_hex_digit(source[p + 2]) << 4) | parse_hex_digit(source[p + 3])
                i += 6
                if cp < 128 {
                    if cp == 10 { buf[count] = '\\'; buf[count + 1] = 'n'; count += 2 }
                    else if cp == 9 { buf[count] = '\\'; buf[count + 1] = 't'; count += 2 }
                    else if cp == 13 { buf[count] = '\\'; buf[count + 1] = 'r'; count += 2 }
                    else if cp == 34 { buf[count] = '\\'; buf[count + 1] = '"'; count += 2 }
                    else if cp == 92 { buf[count] = '\\'; buf[count + 1] = '\\'; count += 2 }
                    else if cp == 0 { buf[count] = '\\'; buf[count + 1] = '0'; count += 2 }
                    else { buf[count] = cp as u8; count += 1 }
                } else if cp <= 2047 {
                    buf[count] = (192 | (cp >> 6)) as u8; count += 1
                    buf[count] = (128 | (cp & 63)) as u8; count += 1
                } else {
                    buf[count] = (224 | (cp >> 12)) as u8; count += 1
                    buf[count] = (128 | ((cp >> 6) & 63)) as u8; count += 1
                    buf[count] = (128 | (cp & 63)) as u8; count += 1
                }
            } else if esc == 'x' and i + 3 < content_len {
                let p = start + 1 + i + 2
                let b = (parse_hex_digit(source[p]) << 4) | parse_hex_digit(source[p + 1])
                i += 4
                if b == 10 { buf[count] = '\\'; buf[count + 1] = 'n'; count += 2 }
                else if b == 9 { buf[count] = '\\'; buf[count + 1] = 't'; count += 2 }
                else if b == 13 { buf[count] = '\\'; buf[count + 1] = 'r'; count += 2 }
                else if b == 34 { buf[count] = '\\'; buf[count + 1] = '"'; count += 2 }
                else if b == 92 { buf[count] = '\\'; buf[count + 1] = '\\'; count += 2 }
                else if b == 0 { buf[count] = '\\'; buf[count + 1] = '0'; count += 2 }
                else { buf[count] = b as u8; count += 1 }
            } else {
                buf[count] = '\\'; buf[count + 1] = esc; count += 2
                i += 2
            }
        } else {
            buf[count] = c; count += 1; i += 1
        }
    }
    buf[count] = 0 as u8
    return buf as string
}
