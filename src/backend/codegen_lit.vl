// C99 numeric and integer literal emission helpers.
use "../ast/types.vl"
use "../ast/expr.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../analysis/literal_check.vl"
use "../analysis/reflect_checks.vl"
use "../common/string_builder.vl"
use "../common/utils.vl"

// Emits an EXPR_INT literal node safely into a C99 string builder.
act emit_c_int_literal(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    if expr == null { return }
    if expr.str_val != null and str.len(expr.str_val) > 0 {
        sb_append_str(sb, expr.str_val)
    } else {
        sb_append_int(sb, expr.int_val)
    }
}

// Emits a negated integer literal expression safely. Returns true if handled as a wide/boundary literal.
act try_emit_c_neg_int_literal(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode, sub_type: string) -> bool {
    if expr == null or expr.operand == null or expr.operand.kind != EXPR_INT { return false }
    let op = expr.operand
    mut overflow = false
    mut val_u64: u64 = 0 as u64
    if op.str_val != null and str.len(op.str_val) > 0 {
        val_u64 = parse_u64_checked(op.str_val, @overflow)
    } else {
        if op.int_val < 0 {
            val_u64 = (0 - op.int_val) as u64
        } else {
            val_u64 = op.int_val as u64
        }
    }
    if overflow { return false }

    // INT64_MIN: (-9223372036854775808).
    // In C, -9223372036854775808ULL is unsigned, causing comparison (< 0) and division to produce positive values.
    // Emitting (-9223372036854775807LL - 1LL) guarantees standard C99 signed 64-bit int64_t representation.
    if val_u64 == 9223372036854775808_u64 {
        sb_append_str(sb, "(-9223372036854775807LL - 1LL)")
        return true
    }

    // INT32_MIN: (-2147483648).
    // When typed as i32, emit (-2147483647 - 1) to keep 32-bit int type without promoting to long long.
    if val_u64 == 2147483648_u64 {
        if sub_type == "i32" or (expr.type_name != null and expr.type_name == "i32") {
            sb_append_str(sb, "(-2147483647 - 1)")
            return true
        }
        sb_append_str(sb, "(-2147483648LL)")
        return true
    }

    return false
}

// Safely extracts a constant integer endpoint's 64-bit magnitude and sign without 32-bit truncation.
act get_range_endpoint_const(expr: @ExprNode, out_val: @u64, out_neg: @bool) -> bool {
    if expr == null or out_val == null or out_neg == null { return false }
    if expr.kind == EXPR_INT {
        out_neg[0] = false
        if expr.str_val != null and str.len(expr.str_val) > 0 {
            mut overflow = false
            let u = parse_u64_checked(expr.str_val, @overflow)
            if not overflow {
                out_val[0] = u
                return true
            }
        }
        if expr.int_val < 0 {
            out_val[0] = (0 - expr.int_val) as u64
            out_neg[0] = true
        } else {
            out_val[0] = expr.int_val as u64
        }
        return true
    }
    if expr.kind == EXPR_UNARY and expr.op == TOK_MINUS and expr.operand != null and expr.operand.kind == EXPR_INT {
        let op = expr.operand
        out_neg[0] = true
        if op.str_val != null and str.len(op.str_val) > 0 {
            mut overflow = false
            let u = parse_u64_checked(op.str_val, @overflow)
            if not overflow {
                out_val[0] = u
                return true
            }
        }
        if op.int_val < 0 {
            out_val[0] = (0 - op.int_val) as u64
        } else {
            out_val[0] = op.int_val as u64
        }
        return true
    }
    return false
}

// Returns true if the loop range represents a descending count (start > end).
act is_reverse_loop_range(start_expr: @ExprNode, end_expr: @ExprNode) -> bool {
    mut s_val: u64 = 0u64
    mut s_neg = false
    mut e_val: u64 = 0u64
    mut e_neg = false
    if get_range_endpoint_const(start_expr, @s_val, @s_neg) and get_range_endpoint_const(end_expr, @e_val, @e_neg) {
        if s_neg and not e_neg { return false }
        if not s_neg and e_neg {
            if s_val == 0u64 and e_val == 0u64 { return false }
            return true
        }
        if s_neg and e_neg {
            return s_val < e_val
        }
        return s_val > e_val
    }
    return false
}

// Returns true if start, end, and optional step are all compile-time integer constants.
act is_literal_range_step(start_expr: @ExprNode, end_expr: @ExprNode, step_expr: @ExprNode) -> bool {
    mut s_val: u64 = 0u64
    mut s_neg = false
    mut e_val: u64 = 0u64
    mut e_neg = false
    if not (get_range_endpoint_const(start_expr, @s_val, @s_neg) and get_range_endpoint_const(end_expr, @e_val, @e_neg)) {
        return false
    }
    if step_expr != null {
        mut st_val: u64 = 0u64
        mut st_neg = false
        if not get_range_endpoint_const(step_expr, @st_val, @st_neg) {
            return false
        }
    }
    return true
}

// Maps a Velo numeric type name to the corresponding C99 loop variable declaration type.
// The `int32_t` fallback is defensive: a loop whose type reaches here as
// anything unrecognised is an internal error, not a licence to narrow. W1
// (SPEC 7.2 item 9) requires the induction to be at least as wide as its
// bounds, so every 64-bit type in the type system must be listed explicitly.
act loop_var_c_type(type_name: string) -> string {
    if type_name == null { return "int32_t " }
    if type_name == "i64" { return "int64_t " }
    if type_name == "u64" { return "uint64_t " }
    if type_name == "usize" { return "size_t " }
    if type_name == "isize" { return "ptrdiff_t " }
    if type_name == "u32" { return "uint32_t " }
    if type_name == "i16" { return "int16_t " }
    if type_name == "u16" { return "uint16_t " }
    if type_name == "i8" { return "int8_t " }
    if type_name == "u8" { return "uint8_t " }
    return "int32_t "
}
