// Package command dispatcher for 'velo pkg' (check, lock, install, update, build, run)
use std.io
use std.fs
use "../common/string_builder.vl"
use "../common/utils.vl"
use "../common/manifest.vl"
use "driver_cc.vl"
use "driver.vl"
use "pkg_lock.vl"
use "pkg_install.vl"
use "pkg_inspect.vl"
use "pkg_publish.vl"

// Parses common package command arguments (manifest path, --insecure, --registry).
act parse_pkg_args(argc: i32, argv: @string, out_insecure: @bool, out_reg: @string) -> string {
    mut m_path = ""
    out_insecure[0] = false
    out_reg[0] = ""
    mut i: i32 = 3
    loop i < argc {
        let arg = argv[i]
        if arg == "--insecure" {
            out_insecure[0] = true
        } else if arg == "--registry" and i + 1 < argc {
            out_reg[0] = argv[i + 1]
            i += 1
        } else if str.len(arg) > 11 and str.starts_with(arg, "--registry=") {
            out_reg[0] = copy_slice_to_string(arg, 11, str.len(arg) - 11)
        } else if str.len(m_path) == 0 and not str.starts_with(arg, "--") {
            m_path = arg
        }
        i += 1
    }
    if str.len(m_path) == 0 { m_path = "velo.pkg" }
    return resolve_manifest_path(m_path)
}

// Appends manifest link items (libs or flags) to linker StringBuilder.
act append_pkg_linker_items(sb: @StringBuilder, first: @ManifestStringItem, is_lib: bool) {
    mut cur = first
    loop cur != null {
        if sb.len > 0 { sb_append_char(sb, ' ') }
        let val = cur.value
        let vlen = str.len(val)
        if is_lib {
            if vlen > 2 and val[0] == '-' and val[1] == 'l' {
                sb_append_str(sb, val)
            } else {
                sb_append_str(sb, "-l")
                sb_append_str(sb, val)
            }
        } else {
            sb_append_str(sb, val)
        }
        cur = cur.next
    }
}

// Resolves a directory or file path to a manifest path (defaults to velo.pkg).
act resolve_manifest_path(input_path: string) -> string {
    if input_path == null or str.len(input_path) == 0 {
        return "velo.pkg"
    }
    if fs_is_dir(input_path) {
        return path_join_str(input_path, "velo.pkg")
    }
    return input_path
}

// Resolves default output binary path (bin/<pkg_name>.exe if bin/ exists, else <pkg_name>.exe).
act resolve_default_output_exe(m_dir: string, pkg_name: string) -> string {
    let bin_dir = path_join_str(m_dir, "bin")
    mut name_sb = create_sb(64)
    sb_append_str(@name_sb, pkg_name)
    sb_append_str(@name_sb, ".exe")
    let exe_name = sb_to_string(@name_sb)
    if fs_is_dir(bin_dir) {
        return path_join_str(bin_dir, exe_name)
    }
    return path_join_str(m_dir, exe_name)
}

// Handles execution of 'velo pkg <subcmd>' (check, build, run).
act handle_pkg_command(argc: i32, argv: @string, unsafe_index: bool) -> i32 {
    mut sub_cmd = "check"
    if argc > 2 {
        sub_cmd = argv[2]
    }

    if sub_cmd == "help" or sub_cmd == "--help" or sub_cmd == "-h" {
        println_str("Usage:")
        println_str("  velo pkg check [path]              Validate a velo.pkg manifest and verify velo.lock")
        println_str("  velo pkg lock [path]               Generate or update velo.lock with dependency hashes")
        println_str("  velo pkg install [path]            Install and verify dependencies against velo.lock")
        println_str("  velo pkg update [path]             Update dependencies and regenerate velo.lock")
        println_str("  velo pkg tree [path]               Display dependency tree")
        println_str("  velo pkg verify [path]             Verify dependencies and report drift (read-only)")
        println_str("  velo pkg publish [path]            Package and generate registry index entry to paste")
        println_str("  velo pkg build [path] [-o <bin>]   Build project defined by velo.pkg")
        println_str("  velo pkg run [path] [-- args...]   Build and run project defined by velo.pkg")
        return 0
    }

    if sub_cmd == "check" {
        mut m_path = "velo.pkg"
        if argc > 3 {
            m_path = argv[3]
        }
        m_path = resolve_manifest_path(m_path)
        let m = manifest_load(m_path)
        if m.has_error {
            println_str(m.error_msg)
            return 1
        }
        let m_dir = path_dirname_to_str(m_path)
        let lock_path = path_join_str(m_dir, "velo.lock")
        if fs_exists(lock_path) {
            let lock = lockfile_load(lock_path)
            if lock.has_error {
                println_str(lock.error_msg)
                return 1
            }
            if not verify_lockfile_integrity(@m, m_dir, @lock) {
                return 1
            }
            println_str("[Velo] Verified velo.lock checksums ({m.dep_count} dependencies).")
        }
        print_str("[Velo] Valid package manifest: ")
        print_str(m.pkg.name)
        print_str(" v")
        print_str(m.pkg.version)
        print_str(" (")
        print_str(m.pkg.entry)
        println_str(")")
        return 0
    }

    if sub_cmd == "lock" {
        mut insecure = false
        mut reg_override = ""
        let m_path = parse_pkg_args(argc, argv, @insecure, @reg_override)
        let m = manifest_load(m_path)
        if m.has_error { println_str(m.error_msg); return 1 }
        let m_dir = path_dirname_to_str(m_path)
        if not install_all_dependencies(@m, m_dir, insecure, reg_override) {
            return 1
        }
        let lock = generate_lockfile_from_manifest(@m, m_dir)
        let lock_text = lockfile_serialize(@lock)
        let lock_path = path_join_str(m_dir, "velo.lock")
        if not fs_write_str(lock_path, lock_text) {
            println_str("[Velo Error] Failed to write lockfile: {lock_path}")
            return 1
        }
        println_str("[Velo] Successfully generated velo.lock with {lock.count} dependencies.")
        return 0
    }

    if sub_cmd == "install" {
        mut insecure = false
        mut reg_override = ""
        let m_path = parse_pkg_args(argc, argv, @insecure, @reg_override)
        let m = manifest_load(m_path)
        if m.has_error { println_str(m.error_msg); return 1 }
        let m_dir = path_dirname_to_str(m_path)
        let lock_path = path_join_str(m_dir, "velo.lock")

        // 1. Fetch every non-local dependency (Security Invariant I72.1)
        if not install_all_dependencies(@m, m_dir, insecure, reg_override) {
            return 1
        }

        // 2. If lockfile does not exist, generate and write it
        if not fs_exists(lock_path) {
            let lock = generate_lockfile_from_manifest(@m, m_dir)
            let lock_text = lockfile_serialize(@lock)
            if not fs_write_str(lock_path, lock_text) {
                println_str("[Velo Error] Failed to write lockfile: {lock_path}")
                return 1
            }
            println_str("[Velo] Created velo.lock with {lock.count} dependencies.")
            println_str("[Velo] All dependencies installed and locked successfully.")
            return 0
        }

        // 3. Verify lockfile integrity against fetched files on disk (Security Invariants I72.2 & I72.4)
        let lock = lockfile_load(lock_path)
        if lock.has_error { println_str(lock.error_msg); return 1 }
        if not verify_lockfile_integrity(@m, m_dir, @lock) {
            return 1
        }
        println_str("[Velo] All {m.dep_count} dependencies verified against velo.lock.")
        println_str("[Velo] Dependencies installation complete.")
        return 0
    }

    if sub_cmd == "update" {
        mut insecure = false
        mut reg_override = ""
        let m_path = parse_pkg_args(argc, argv, @insecure, @reg_override)
        let m = manifest_load(m_path)
        if m.has_error { println_str(m.error_msg); return 1 }
        let m_dir = path_dirname_to_str(m_path)

        if not install_all_dependencies(@m, m_dir, insecure, reg_override) {
            return 1
        }
        let lock = generate_lockfile_from_manifest(@m, m_dir)
        let lock_text = lockfile_serialize(@lock)
        let lock_path = path_join_str(m_dir, "velo.lock")
        if not fs_write_str(lock_path, lock_text) {
            println_str("[Velo Error] Failed to write lockfile: {lock_path}")
            return 1
        }
        println_str("[Velo] Successfully updated velo.lock with {lock.count} dependencies.")
        return 0
    }

    if sub_cmd == "tree" {
        mut m_path = "velo.pkg"
        if argc > 3 {
            m_path = argv[3]
        }
        return pkg_tree_run(resolve_manifest_path(m_path))
    }

    if sub_cmd == "verify" {
        mut m_path = "velo.pkg"
        if argc > 3 {
            m_path = argv[3]
        }
        return pkg_verify_run(resolve_manifest_path(m_path))
    }

    if sub_cmd == "publish" {
        return pkg_publish_run(argc, argv)
    }

    if sub_cmd == "build" or sub_cmd == "run" {
        mut manifest_path = ""
        mut output_exe = ""
        mut cc = "gcc"
        mut debug_mode: bool = false
        mut release_mode: bool = false
        mut opt_level = ""
        mut linker_sb = create_sb(256)
        mut run_args_sb = create_sb(256)
        mut after_double_dash = false

        mut i: i32 = 3
        loop i < argc {
            let arg = argv[i]
            if after_double_dash {
                if run_args_sb.len > 0 { sb_append_char(@run_args_sb, ' ') }
                sb_append_str(@run_args_sb, arg)
            } else if arg == "--" {
                after_double_dash = true
            } else if arg == "--cc" and i + 1 < argc {
                cc = argv[i + 1]
                i += 1
            } else if str.len(arg) > 5 and arg[0] == '-' and arg[1] == '-' and arg[2] == 'c' and arg[3] == 'c' and arg[4] == '=' {
                cc = copy_slice_to_string(arg, 5, str.len(arg) - 5)
            } else if arg == "-o" and i + 1 < argc {
                output_exe = argv[i + 1]
                i += 1
            } else if arg == "--debug" {
                debug_mode = true
            } else if arg == "--release" {
                release_mode = true
            } else if arg == "-O" and i + 1 < argc {
                opt_level = argv[i + 1]
                i += 1
            } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'O' {
                opt_level = copy_slice_to_string(arg, 2, str.len(arg) - 2)
            } else if arg == "-l" and i + 1 < argc {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, "-l")
                sb_append_str(@linker_sb, argv[i + 1])
                i += 1
            } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'l' {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, arg)
            } else if arg == "-L" and i + 1 < argc {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, "-L")
                sb_append_str(@linker_sb, quote_path(path_to_native_str(argv[i + 1])))
                i += 1
            } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'L' {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, "-L")
                let raw_arg = copy_slice_to_string(arg, 2, str.len(arg) - 2)
                sb_append_str(@linker_sb, quote_path(path_to_native_str(raw_arg)))
            } else if arg != "--unsafe-shelf-index" and arg != "--unsafe-array-index" and arg != "--unsafe-index" {
                if str.len(manifest_path) == 0 {
                    let is_pkg_file = fs_is_file(arg) or str.ends_with(arg, ".pkg")
                    let is_dir = fs_is_dir(arg)
                    if is_pkg_file or is_dir or not fs_exists("velo.pkg") {
                        manifest_path = arg
                    } else {
                        manifest_path = "velo.pkg"
                        if run_args_sb.len > 0 { sb_append_char(@run_args_sb, ' ') }
                        sb_append_str(@run_args_sb, arg)
                    }
                } else {
                    if run_args_sb.len > 0 { sb_append_char(@run_args_sb, ' ') }
                    sb_append_str(@run_args_sb, arg)
                }
            }
            i += 1
        }

        if str.len(manifest_path) == 0 {
            manifest_path = "velo.pkg"
        }
        manifest_path = resolve_manifest_path(manifest_path)

        if cc != "gcc" and cc != "cl" and cc != "clang" {
            println_str("[Velo Error] Unknown C compiler backend '{cc}'. Expected 'gcc', 'clang', or 'cl'.")
            return 1
        }
        if debug_mode and release_mode {
            println_str("[Velo Error] Cannot specify both --debug and --release")
            return 1
        }

        let m = manifest_load(manifest_path)
        if m.has_error {
            println_str(m.error_msg)
            return 1
        }

        let m_dir = path_dirname_to_str(manifest_path)
        let entry_path = path_join_str(m_dir, m.pkg.entry)
        if not fs_exists(entry_path) {
            println_str("[Velo Error] Entry source file not found: {entry_path}")
            return 1
        }

        let lock_path = path_join_str(m_dir, "velo.lock")
        if fs_exists(lock_path) {
            let lock = lockfile_load(lock_path)
            if lock.has_error { println_str(lock.error_msg); return 1 }
            if not verify_lockfile_integrity(@m, m_dir, @lock) {
                return 1
            }
        }

        append_pkg_linker_items(@linker_sb, m.link.first_lib, true)
        append_pkg_linker_items(@linker_sb, m.link.first_flag, false)
        let linker_flags = sb_to_string(@linker_sb)
        let opt_flags = resolve_opt_flags(debug_mode, release_mode, opt_level)

        if sub_cmd == "build" {
            if str.len(output_exe) == 0 {
                output_exe = resolve_default_output_exe(m_dir, m.pkg.name)
            }
            mut ok = false
            zone {
                ok = build_executable(entry_path, output_exe, unsafe_index, opt_flags, linker_flags, cc)
                if ok {
                    println_str("[Velo] Successfully built binary!")
                } else {
                    println_str("[Velo Error] Build failed.")
                }
            }
            if ok { return 0 }
            return 1
        }

        // sub_cmd == "run"
        mut exe_sb = create_sb(128)
        sb_append_str(@exe_sb, ".velo_cache/")
        sb_append_str(@exe_sb, m.pkg.name)
        sb_append_str(@exe_sb, ".exe")
        let run_exe_path = sb_to_string(@exe_sb)

        mut ok = false
        zone {
            ok = build_executable(entry_path, run_exe_path, unsafe_index, opt_flags, linker_flags, cc)
        }
        if not ok {
            return 1
        }
        let run_args = sb_to_string(@run_args_sb)
        let run_cmd = assemble_runner_cmd(cc, run_exe_path, run_args)
        return os_system(run_cmd)
    }

    println_str("[Velo Error] Unknown 'pkg' subcommand '{sub_cmd}'.")
    return 1
}
