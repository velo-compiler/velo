// ============================================================================
// 5.2 Dynamic Collections — shelf member-call C emission (put/take from
// slice 1; sorted/insert/remove_at from slice 3). Split from shelf_gen.vl
// to stay under the 400-line budget. The C text matches velo/codegen_c.py's
// emit branches byte for byte.
// ============================================================================
use sys.mem
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../analysis/shelf_checks.vl"
use "../analysis/dyn_checks.vl"
use "../common/string_builder.vl"
use "../common/act_types.vl"
use "codegen_types.vl"
use "codegen_expr.vl"
use "shelf_gen.vl"

// The C operator fragment for a raw-dyn compare (tri-state mapped against 0)
// and the arith op character for velo_dyn_arith (Stage 1: the f-string
// literals in _emit_dyn_binop — same characters).
act dyn_compare_c_op(op: i32) -> string {
    if op == TOK_EQ { return "== 0" }
    if op == TOK_NEQ { return "!= 0" }
    if op == TOK_LT { return "< 0" }
    if op == TOK_LTE { return "<= 0" }
    if op == TOK_GT { return "> 0" }
    return ">= 0"
}

act dyn_arith_c_char(op: i32) -> string {
    if op == TOK_PLUS { return "+" }
    if op == TOK_MINUS { return "-" }
    if op == TOK_STAR { return "*" }
    if op == TOK_SLASH { return "/" }
    return "%"
}

// 5.2 slice 8 — lowers a raw-dyn binop: both operands bound once into
// VeloDyn temps (left first — evaluation order pinned), the concrete side
// boxed by its Velo type through emit_dyn_box, then the runtime ladder
// helper. The ladder and family rules live ONLY in velo_runtime.h, so the
// stages cannot diverge on them (Stage 1: _emit_dyn_binop — identical C).
act emit_dyn_binop(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode, ltype: string, rtype: string) {
    if expr.op == TOK_PLUS or expr.op == TOK_MINUS or expr.op == TOK_STAR or expr.op == TOK_SLASH or expr.op == TOK_PERCENT {
        sb_append_str(sb, "velo_dyn_arith('")
        sb_append_str(sb, dyn_arith_c_char(expr.op))
        sb_append_str(sb, "', (")
        if ltype == "dyn" {
            emit_c_expr(sb, st, expr.left)
        } else {
            emit_dyn_box(sb, st, ltype, expr.left)
        }
        sb_append_str(sb, "), (")
        if rtype == "dyn" {
            emit_c_expr(sb, st, expr.right)
        } else {
            emit_dyn_box(sb, st, rtype, expr.right)
        }
        sb_append_str(sb, "))")
    } else {
        sb_append_str(sb, "(velo_dyn_compare((")
        if ltype == "dyn" {
            emit_c_expr(sb, st, expr.left)
        } else {
            emit_dyn_box(sb, st, ltype, expr.left)
        }
        sb_append_str(sb, "), (")
        if rtype == "dyn" {
            emit_c_expr(sb, st, expr.right)
        } else {
            emit_dyn_box(sb, st, rtype, expr.right)
        }
        sb_append_str(sb, ")) ")
        sb_append_str(sb, dyn_compare_c_op(expr.op))
        sb_append_str(sb, ")")
    }
}

act emit_shelf_member_call(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    let member = expr.callee.member_name
    let recv_t = infer_expr_type(st, expr.callee.target)
    let elem = shelf_raw_elem(recv_t)
    if member == "put" {
        if elem == "dyn" {
            sb_append_str(sb, "velo_shelf_put_dyn(")
            emit_shelf_recv(sb, st, expr.callee.target)
            sb_append_str(sb, ", (")
            let raw = infer_expr_type(st, expr.first_arg)
            if raw == "dyn" {
                emit_c_expr(sb, st, expr.first_arg)
            } else {
                emit_dyn_box(sb, st, raw, expr.first_arg)
            }
            sb_append_str(sb, "))")
            return
        }
        let elem_c = map_type_to_c(elem)
        sb_append_str(sb, "velo_shelf_put(")
        emit_shelf_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ", &(")
        if not str.starts_with(elem_c, "const ") {
            sb_append_str(sb, "const ")
        }
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "){ ")
        emit_c_expr(sb, st, expr.first_arg)
        sb_append_str(sb, " }, (usize)sizeof(")
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "))")
        return
    }
    if member == "take" {
        sb_append_str(sb, "(*((")
        sb_append_str(sb, map_type_to_c(elem))
        sb_append_str(sb, "*)velo_shelf_take(")
        emit_shelf_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ")))")
        return
    }
    if member == "insert" {
        let elem_arg = expr.first_arg.next
        if elem == "dyn" {
            sb_append_str(sb, "velo_shelf_insert_dyn(")
            emit_shelf_recv(sb, st, expr.callee.target)
            sb_append_str(sb, ", (usize)(")
            emit_c_expr(sb, st, expr.first_arg)
            sb_append_str(sb, "), (")
            let raw = infer_expr_type(st, elem_arg)
            if raw == "dyn" {
                emit_c_expr(sb, st, elem_arg)
            } else {
                emit_dyn_box(sb, st, raw, elem_arg)
            }
            sb_append_str(sb, "))")
            return
        }
        let elem_c = map_type_to_c(elem)
        sb_append_str(sb, "velo_shelf_insert(")
        emit_shelf_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ", (usize)(")
        emit_c_expr(sb, st, expr.first_arg)
        sb_append_str(sb, "), &(")
        if not str.starts_with(elem_c, "const ") {
            sb_append_str(sb, "const ")
        }
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "){ ")
        emit_c_expr(sb, st, elem_arg)
        sb_append_str(sb, " }, (usize)sizeof(")
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "))")
        return
    }
    if member == "remove_at" {
        // Returns the removed element BY VALUE (the runtime stash-copies
        // the victim before shifting the tail).
        sb_append_str(sb, "(*((")
        sb_append_str(sb, map_type_to_c(elem))
        sb_append_str(sb, "*)velo_shelf_remove_at(")
        emit_shelf_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ", (usize)(")
        emit_c_expr(sb, st, expr.first_arg)
        sb_append_str(sb, "))))")
        return
    }
    if member == "sorted" {
        sb_append_str(sb, "velo_shelf_sorted_")
        sb_append_str(sb, elem)
        sb_append_str(sb, "(")
        emit_shelf_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ")")
        return
    }
    if member == "reversed" {
        sb_append_str(sb, "velo_shelf_reversed(")
        emit_shelf_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ")")
        return
    }
    if member == "join" {
        sb_append_str(sb, "velo_shelf_join_")
        sb_append_str(sb, elem)
        sb_append_str(sb, "(")
        emit_shelf_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ", (const char*)(")
        emit_c_expr(sb, st, expr.first_arg)
        sb_append_str(sb, "))")
        return
    }
    if member == "free" or member == "destroy" {
        sb_append_str(sb, "velo_shelf_free(")
        emit_shelf_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ")")
        return
    }
    // checker handles unknown members; emit the property for totality
    emit_c_expr(sb, st, expr.callee.target)
    sb_append_char(sb, '.')
    sb_append_str(sb, member)
}

act emit_shelf_module_call(sb: @StringBuilder, st: @SymbolTable, member: string, expr: @ExprNode) {
    if member == "free" or member == "destroy" {
        sb_append_str(sb, "velo_shelf_free(")
        emit_shelf_recv(sb, st, expr.first_arg)
        sb_append_str(sb, ")")
    }
}
