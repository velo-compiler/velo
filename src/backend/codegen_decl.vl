// C99 type declarations, structs, kinds, and extern definitions emitter.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../common/string_builder.vl"
use "../common/utils.vl"
use "../common/act_types.vl"
use "codegen_expr.vl"
use "codegen_line.vl"
use "outcome_gen.vl"
use "array_gen.vl"

// Checks if a function name corresponds to an anonymous lifted function.
act is_anon_act_name(name: string) -> bool {
    if name == null { return false }
    let len = str.len(name)
    if len >= 15 and name[0] == '_' and name[1] == 'v' and name[2] == 'e' and name[3] == 'l' and name[4] == 'o' {
        return true
    }
    return false
}

// Emits a C function pointer typedef: `typedef <ret> (*<mangled>)(<params>);`
act emit_act_typedef(sb: @StringBuilder, act_type: string) {
    let clean = strip_pointer_prefix(act_type)
    let len = str.len(clean)
    let ret_type = get_act_return_type(clean)
    let ret_c = map_type_to_c(ret_type)
    let mangled = mangle_act_type(clean)

    sb_append_str(sb, "typedef ")
    sb_append_str(sb, ret_c)
    sb_append_str(sb, " (*")
    sb_append_str(sb, mangled)
    sb_append_str(sb, ")(")

    mut i: usize = 0
    loop i < len and clean[i] != '(' { i += 1 }
    if i < len { i += 1 }

    mut p_count: usize = 0
    loop i < len and clean[i] != ')' {
        loop i < len and (clean[i] == ' ' or clean[i] == '\t') { i += 1 }
        if i >= len or clean[i] == ')' { break }
        mut start = i
        loop i < len and clean[i] != ',' and clean[i] != ')' { i += 1 }
        mut end = i
        loop end > start and (clean[end - 1] == ' ' or clean[end - 1] == '\t') { end -= 1 }
        let p_str = copy_slice_to_string(clean, start, end - start)
        let p_c = map_type_to_c(p_str)
        if p_count > 0 { sb_append_str(sb, ", ") }
        sb_append_str(sb, p_c)
        p_count += 1
        if i < len and clean[i] == ',' { i += 1 }
    }

    if p_count == 0 {
        sb_append_str(sb, "void")
    }
    sb_append_str(sb, ");\n")
}

// Scans a statement AST node recursively for function pointer types.
act scan_stmt_act_types(s: @StmtNode, list: @@ActTypeNode) {
    if s == null { return }
    if s.kind == STMT_VAR_DECL {
        if s.type_name != null and is_act_type(s.type_name) {
            act_types_add(list, s.type_name)
        }
    } else if s.kind == STMT_BLOCK {
        mut cur = s.first_stmt
        loop cur != null {
            scan_stmt_act_types(cur, list)
            cur = cur.next
        }
    } else if s.kind == STMT_IF {
        scan_stmt_act_types(s.body, list)
        if s.else_branch != null { scan_stmt_act_types(s.else_branch, list) }
    } else if s.kind == STMT_LOOP {
        scan_stmt_act_types(s.body, list)
    } else if s.kind == STMT_ZONE {
        scan_stmt_act_types(s.body, list)
    } else if s.kind == STMT_MATCH {
        mut c = s.first_case
        loop c != null {
            if c.body != null { scan_stmt_act_types(c.body, list) }
            c = c.next
        }
    }
}

// Scans an entire AST program for all used function pointer types.
act scan_program_act_types(prog: @ProgramNode, list: @@ActTypeNode) {
    mut cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_DATA {
            mut cur_f = cur.first_field
            loop cur_f != null {
                if cur_f.type_name != null and is_act_type(cur_f.type_name) {
                    act_types_add(list, cur_f.type_name)
                }
                cur_f = cur_f.next
            }
        } else if cur.kind == DECL_KIND {
            mut cv = cur.first_variant
            loop cv != null {
                if cv.payload_type != null and is_act_type(cv.payload_type) {
                    act_types_add(list, cv.payload_type)
                }
                mut cf = cv.first_field
                loop cf != null {
                    if cf.type_name != null and is_act_type(cf.type_name) {
                        act_types_add(list, cf.type_name)
                    }
                    cf = cf.next
                }
                cv = cv.next
            }
        } else if cur.kind == DECL_FUNCTION or cur.kind == DECL_EXTERN {
            if cur.return_type != null and is_act_type(cur.return_type) {
                act_types_add(list, cur.return_type)
            }
            mut cur_p = cur.first_param
            loop cur_p != null {
                if cur_p.type_name != null and is_act_type(cur_p.type_name) {
                    act_types_add(list, cur_p.type_name)
                }
                cur_p = cur_p.next
            }
            if cur.body != null {
                scan_stmt_act_types(cur.body, list)
            }
        } else if cur.kind == STMT_VAR_DECL {
            if cur.type_name != null and is_act_type(cur.type_name) {
                act_types_add(list, cur.type_name)
            }
        }
        cur = cur.next
    }
}

// Emits C function parameter list `(type1 p1, type2 p2)`.
act emit_param_list(sb: @StringBuilder, first_param: @ParamNode, param_count: usize) {
    sb_append_char(sb, '(')
    if param_count == 0 {
        sb_append_str(sb, "void")
    } else {
        mut cur_p = first_param
        loop cur_p != null {
            if is_fixed_array_type(cur_p.type_name) {
                emit_c_typed_var(sb, cur_p.type_name, cur_p.name)
            } else {
                sb_append_str(sb, map_type_to_c(cur_p.type_name))
                sb_append_char(sb, ' ')
                sb_append_str(sb, cur_p.name)
            }
            if cur_p.next != null { sb_append_str(sb, ", ") }
            cur_p = cur_p.next
        }
    }
    sb_append_char(sb, ')')
}

// Emits all type declarations, structs, kinds, aliases, globals, and extern prototypes.
act emit_type_declarations(sb: @StringBuilder, st: @SymbolTable, prog: @ProgramNode) {
    // 2. Struct and Kind forward declarations
    mut cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_DATA {
            sb_append_str(sb, "typedef struct "); sb_append_str(sb, cur.name); sb_append_char(sb, ' '); sb_append_str(sb, cur.name); sb_append_str(sb, ";\n")
        } else if cur.kind == DECL_KIND {
            let k_sym = find_kind(st, cur.name)
            if k_sym != null and k_sym.is_tagged_union {
                sb_append_str(sb, "typedef struct "); sb_append_str(sb, cur.name); sb_append_char(sb, ' '); sb_append_str(sb, cur.name); sb_append_str(sb, ";\n")
            } else {
                sb_append_str(sb, "typedef int32_t "); sb_append_str(sb, cur.name); sb_append_str(sb, ";\n")
            }
        }
        cur = cur.next
    }
    sb_append_line(sb, "", 0)

    // 2.2 Type alias declarations (`aka EntityId = u64`)
    cur = prog.first_decl
    mut found_alias = false
    loop cur != null {
        if cur.kind == DECL_TYPE_ALIAS {
            if not found_alias { sb_append_str(sb, "/* Type aliases */\n"); found_alias = true }
            sb_append_str(sb, "typedef "); sb_append_str(sb, map_type_to_c(cur.type_name)); sb_append_char(sb, ' ')
            sb_append_str(sb, cur.name); sb_append_str(sb, ";\n")
        }
        cur = cur.next
    }
    if found_alias { sb_append_line(sb, "", 0) }

    // 2.1 Function pointer typedefs
    mut act_list: @ActTypeNode = null
    scan_program_act_types(prog, @act_list)
    if act_list != null {
        sb_append_str(sb, "/* Function pointer typedefs */\n")
        mut cur_act = act_list
        loop cur_act != null {
            emit_act_typedef(sb, cur_act.type_name)
            cur_act = cur_act.next
        }
        sb_append_str(sb, "\n")
    }

    // 2.5 Kind definitions (enums and tagged union structs)
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_KIND {
            let k_sym = find_kind(st, cur.name)
            mut is_tu = false
            if k_sym != null and k_sym.is_tagged_union { is_tu = true }
            sb_append_str(sb, "enum {\n")
            mut cv = cur.first_variant; mut vi: i32 = 0
            loop cv != null {
                sb_append_indent(sb, 1)
                sb_append_str(sb, cur.name); sb_append_char(sb, '_'); sb_append_str(sb, cv.name)
                sb_append_str(sb, " = ")
                if cv.has_discriminant { sb_append_int(sb, cv.discriminant) } else { sb_append_int(sb, vi) }
                sb_append_str(sb, ",\n")
                cv = cv.next
                vi += 1
            }
            sb_append_str(sb, "};\n\n")

            if is_tu {
                cv = cur.first_variant
                loop cv != null {
                    if cv.field_count > 0 {
                        sb_append_str(sb, "typedef struct ")
                        sb_append_str(sb, cur.name); sb_append_char(sb, '_'); sb_append_str(sb, cv.name); sb_append_str(sb, "_Payload {\n")
                        mut cf = cv.first_field
                        loop cf != null {
                            sb_append_indent(sb, 1)
                            sb_append_str(sb, map_type_to_c(cf.type_name))
                            sb_append_char(sb, ' ')
                            sb_append_str(sb, cf.name)
                            sb_append_str(sb, ";\n")
                            cf = cf.next
                        }
                        sb_append_str(sb, "} "); sb_append_str(sb, cur.name); sb_append_char(sb, '_'); sb_append_str(sb, cv.name); sb_append_str(sb, "_Payload;\n\n")
                    }
                    cv = cv.next
                }

                sb_append_str(sb, "struct "); sb_append_str(sb, cur.name); sb_append_str(sb, " {\n")
                sb_append_indent(sb, 1); sb_append_str(sb, "int32_t kind;\n")
                sb_append_indent(sb, 1); sb_append_str(sb, "union {\n")
                cv = cur.first_variant
                loop cv != null {
                    if cv.field_count > 0 {
                        sb_append_indent(sb, 2)
                        sb_append_str(sb, cur.name); sb_append_char(sb, '_'); sb_append_str(sb, cv.name); sb_append_str(sb, "_Payload ")
                        sb_append_str(sb, cv.name); sb_append_str(sb, ";\n")
                    } else if cv.payload_type != null {
                        sb_append_indent(sb, 2)
                        sb_append_str(sb, map_type_to_c(cv.payload_type))
                        sb_append_char(sb, ' ')
                        sb_append_str(sb, cv.name); sb_append_str(sb, ";\n")
                    }
                    cv = cv.next
                }
                sb_append_indent(sb, 1); sb_append_str(sb, "} as;\n")
                sb_append_str(sb, "};\n\n")
            }
        }
        cur = cur.next
    }

    // 3. Struct full definitions
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_DATA {
            if cur.align_bytes > 0 or cur.is_packed {
                sb_append_str(sb, "struct __attribute__((")
                mut attr_first = true
                if cur.align_bytes > 0 {
                    sb_append_str(sb, "aligned("); sb_append_int(sb, cur.align_bytes); sb_append_char(sb, ')')
                    attr_first = false
                }
                if cur.is_packed { if not attr_first { sb_append_str(sb, ", ") }; sb_append_str(sb, "packed") }
                sb_append_str(sb, ")) ")
            } else { sb_append_str(sb, "struct ") }
            sb_append_str(sb, cur.name); sb_append_str(sb, " {\n")
            mut cur_f = cur.first_field
            loop cur_f != null {
                sb_append_indent(sb, 1)
                if is_fixed_array_type(cur_f.type_name) {
                    emit_c_typed_var(sb, cur_f.type_name, cur_f.name)
                } else {
                    sb_append_str(sb, map_type_to_c(cur_f.type_name)); sb_append_char(sb, ' '); sb_append_str(sb, cur_f.name)
                }
                sb_append_str(sb, ";\n")
                cur_f = cur_f.next
            }
            sb_append_str(sb, "};\n\n")
        }
        cur = cur.next
    }

    // 3.5. Algebraic Outcome (T or E) typedefs and fallback helpers
    mut or_list: @OrTypeNode = null
    scan_program_or_types(prog, @or_list)
    if or_list != null {
        emit_or_type_declarations(sb, or_list)
    }

    // 4. Extern function declarations
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_EXTERN {
            sb_append_str(sb, "extern "); sb_append_str(sb, map_type_to_c(cur.return_type)); sb_append_char(sb, ' '); sb_append_str(sb, cur.name)
            emit_param_list(sb, cur.first_param, cur.param_count)
            sb_append_str(sb, ";\n")
        }
        cur = cur.next
    }
    sb_append_line(sb, "", 0)

    // 4.5. Top-level global variables and constants
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == STMT_VAR_DECL {
            emit_line_directive(sb, st, cur.line)
            mut inferred_type = cur.type_name
            if inferred_type == null or str.len(inferred_type) == 0 {
                if cur.val_expr != null { inferred_type = infer_expr_type(st, cur.val_expr) } else { inferred_type = "i32" }
            }
            if is_fixed_array_type(inferred_type) {
                emit_array_var_decl(sb, st, cur, 0)
            } else {
                sb_append_str(sb, map_type_to_c(inferred_type)); sb_append_char(sb, ' '); sb_append_str(sb, cur.name)
                if cur.val_expr != null { sb_append_str(sb, " = "); emit_c_expr(sb, st, cur.val_expr) }
                sb_append_str(sb, ";\n")
            }
        }
        cur = cur.next
    }
    sb_append_line(sb, "", 0)
}

