// C99 expression code generator for Velo AST expressions.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../analysis/str_checks.vl"
use "../analysis/math_checks.vl"
use "../analysis/dyn_checks.vl"
use "../common/string_builder.vl"
use "../common/act_types.vl"
use "codegen_io.vl"
use "../analysis/op_resolver.vl"
use "codegen_types.vl"
use "shelf_gen.vl"
use "shelf_calls_gen.vl"
use "ring_gen.vl"
use "struct_lit_gen.vl"
use "map_gen.vl"
use "math_gen.vl"
use "time_gen.vl"
use "os_gen.vl"
use "fs_gen.vl"
use "simd_gen.vl"
use "array_gen.vl"
use "tuple_gen.vl"
use "codegen_line.vl"
use "../common/diagnostics.vl"
use "reflect_gen.vl"
use "codegen_call.vl"
use "codegen_lit.vl"
use "../analysis/scope.vl"
use "../analysis/narrow_flow.vl"

act emit_if_branch(sb: @StringBuilder, st: @SymbolTable, branch: @ExprNode, target_t: string) {
    if is_optional_type(target_t) {
        let inner = optional_inner_type(target_t)
        if inner[0] != '@' and inner != "string" {
            let opt_c = opt_type_c_name(target_t)
            if branch.kind == EXPR_NULL { sb_append_char(sb, '('); sb_append_str(sb, opt_c); sb_append_str(sb, "){ .has = false }"); return }
            let bt = infer_expr_type(st, branch)
            if not is_optional_type(bt) { sb_append_char(sb, '('); sb_append_str(sb, opt_c); sb_append_str(sb, "){ .has = true, .val = "); emit_c_expr(sb, st, branch); sb_append_str(sb, " }"); return }
        }
    }
    emit_c_expr(sb, st, branch)
}

act emit_if_expr(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    let cond_t = infer_expr_type(st, expr.left)
    if cond_t != "bool" {
        report_error("backend", expr.line, expr.col, "Condition in 'if' expression must be of type 'bool' (defense in depth)")
        st.error_count += 1; return
    }
    sb_append_str(sb, "(("); emit_c_expr(sb, st, expr.left); sb_append_str(sb, ") ? (")
    enter_scope(st); apply_flow_narrowing(st, expr.left, true); emit_if_branch(sb, st, expr.right, expr.type_name); exit_scope(st)
    sb_append_str(sb, ") : ("); enter_scope(st); apply_flow_narrowing(st, expr.left, false); emit_if_branch(sb, st, expr.operand, expr.type_name); exit_scope(st); sb_append_str(sb, "))")
}

// Emits C99 code for an AST expression into a StringBuilder.
act emit_c_expr(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    if expr == null { return }

    // 1. Literal expressions
    if expr.kind == EXPR_INT { emit_c_int_literal(sb, st, expr); return }
    if expr.kind == EXPR_FLOAT { if expr.str_val != null and str.len(expr.str_val) > 0 { sb_append_str(sb, expr.str_val) } else { sb_append_float(sb, expr.float_val) }; return }
    if expr.kind == EXPR_STRING { emit_string_expr(sb, st, expr); return }
    if expr.kind == EXPR_BOOL { if expr.bool_val { sb_append_str(sb, "true") } else { sb_append_str(sb, "false") }; return }
    if expr.kind == EXPR_NULL { sb_append_str(sb, "NULL"); return }
    if expr.kind == EXPR_IDENT {
        let sym = resolve_variable(st, expr.str_val)
        if sym != null and sym.is_narrowed {
            let inner = optional_inner_type(sym.orig_type)
            if inner[0] != '@' and inner != "string" { sb_append_str(sb, expr.str_val); sb_append_str(sb, ".val"); return }
        }
        sb_append_str(sb, expr.str_val); return
    }
    if expr.kind == EXPR_SHELF_LIT or expr.kind == EXPR_HEAP_SHELF_LIT { emit_shelf_literal(sb, st, expr); return }  // 5.2 (heap: slice 10)
    if expr.kind == EXPR_MAP_LIT or expr.kind == EXPR_HEAP_MAP_LIT { emit_map_literal(sb, st, expr); return }  // 5.2 slice 6 / 7.2
    if expr.kind == EXPR_RING_LIT or expr.kind == EXPR_BITSET_LIT { emit_coll9_literal(sb, st, expr); return }  // 5.2 slice 9
    if expr.kind == EXPR_VARIANT {
        mut kname = expr.type_name; mut k_sym: @KindSym = null
        if kname != null and str.len(kname) > 0 { k_sym = find_kind(st, kname) }
        if k_sym == null { k_sym = find_kind_by_variant(st, expr.member_name) }
        if k_sym == null or not k_sym.is_tagged_union {
            if k_sym != null { sb_append_str(sb, k_sym.name); sb_append_char(sb, '_') }
            sb_append_str(sb, expr.member_name); return
        }
        sb_append_char(sb, '('); sb_append_str(sb, k_sym.name); sb_append_str(sb, "){ .kind = ")
        sb_append_str(sb, k_sym.name); sb_append_char(sb, '_'); sb_append_str(sb, expr.member_name)
        if expr.first_arg != null {
            let v_sym = find_variant(k_sym, expr.member_name)
            sb_append_str(sb, ", .as = { ."); sb_append_str(sb, expr.member_name); sb_append_str(sb, " = ")
            if v_sym != null and v_sym.field_count > 0 {
                sb_append_str(sb, "{ ")
                mut cur_f = v_sym.first_field; mut cur_a = expr.first_arg
                loop cur_f != null and cur_a != null {
                    sb_append_char(sb, '.'); sb_append_str(sb, cur_f.name); sb_append_str(sb, " = ")
                    emit_c_expr(sb, st, cur_a)
                    if cur_f.next != null { sb_append_str(sb, ", ") }
                    cur_f = cur_f.next; cur_a = cur_a.next
                }
                sb_append_str(sb, " }")
            } else {
                emit_c_expr(sb, st, expr.first_arg)
            }
            sb_append_str(sb, " }")
        }
        sb_append_str(sb, " }")
        return
    }

    // 2. Unary & Address-of & Dereference
    if expr.kind == EXPR_ADDRESS_OF { sb_append_str(sb, "(&("); emit_c_expr(sb, st, expr.operand); sb_append_str(sb, "))"); return }
    if expr.kind == EXPR_DEREF { sb_append_str(sb, "(*("); emit_c_expr(sb, st, expr.operand); sb_append_str(sb, "))"); return }
    if expr.kind == EXPR_UNARY {
        if expr.op == TOK_MINUS and expr.operand != null and expr.operand.kind == EXPR_INT {
            mut nt = expr.operand.type_name
            if nt == null or str.len(nt) == 0 { nt = expr.type_name }
            if nt == null or str.len(nt) == 0 { nt = infer_unsuffixed_neg_int_type(expr.operand) }
            if try_emit_c_neg_int_literal(sb, st, expr, nt) { return }
            sb_append_str(sb, "(-"); emit_c_int_literal(sb, st, expr.operand); sb_append_str(sb, ")"); return
        }
        let sub_type = infer_expr_type(st, expr.operand)
        if is_simd_type(strip_pointer_prefix(sub_type)) { emit_simd_unary(sb, st, expr); return }
        let op_fn = find_unary_op(st, expr.op, sub_type)
        if op_fn != null {
            sb_append_str(sb, op_fn.name); sb_append_char(sb, '(')
            let p0 = op_fn.first_param
            let p0_ptr = p0 != null and str.len(p0.type_name) > 0 and p0.type_name[0] == '@'
            let s_ptr = str.len(sub_type) > 0 and sub_type[0] == '@'
            if p0_ptr and not s_ptr { sb_append_str(sb, "&(") }
            if s_ptr and not p0_ptr { sb_append_str(sb, "*(") }
            emit_c_expr(sb, st, expr.operand)
            if (p0_ptr and not s_ptr) or (s_ptr and not p0_ptr) { sb_append_char(sb, ')') }
            sb_append_char(sb, ')')
            return
        }
        sb_append_str(sb, "(")
        if expr.op == TOK_NOT { sb_append_str(sb, "!") } else if expr.op == TOK_TILDE { sb_append_str(sb, "~") } else { sb_append_str(sb, "-") }
        emit_c_expr(sb, st, expr.operand)
        sb_append_str(sb, ")")
        return
    }

    // 3. Member access with auto-dereference (-> vs .)
    if expr.kind == EXPR_MEMBER {
        if expr.target.kind == EXPR_IDENT and expr.target.str_val == "math" and find_kind(st, expr.target.str_val) == null {  // 5.3: constants emit the shared decimal literals; typing happened in check_math_constant
            let digits = math_constant_digits(expr.member_name)
            if str.len(digits) > 0 { sb_append_str(sb, "("); sb_append_str(sb, digits); sb_append_str(sb, ")"); return }
        }
        if expr.target.kind == EXPR_IDENT {
            let k_sym = find_kind(st, expr.target.str_val)
            if k_sym != null {
                let v_sym = find_variant(k_sym, expr.member_name)
                if v_sym != null {
                    if not k_sym.is_tagged_union {
                        sb_append_str(sb, k_sym.name); sb_append_char(sb, '_'); sb_append_str(sb, expr.member_name)
                    } else {  // tagged union: a struct literal wrap (compressed — 5.3 ceiling discipline)
                        sb_append_char(sb, '('); sb_append_str(sb, k_sym.name); sb_append_str(sb, "){ .kind = "); sb_append_str(sb, k_sym.name); sb_append_char(sb, '_'); sb_append_str(sb, expr.member_name); sb_append_str(sb, " }")
                    }
                    return
                }
            }
        }
        let target_type = infer_expr_type(st, expr.target)
        if is_optional_type(target_type) {
            let inner = optional_inner_type(target_type)
            if inner[0] == '@' or inner == "string" {
                if expr.member_name == "has" {
                    sb_append_str(sb, "((")
                    emit_c_expr(sb, st, expr.target)
                    sb_append_str(sb, ") != NULL)")
                } else if expr.member_name == "val" {
                    sb_append_char(sb, '(')
                    emit_c_expr(sb, st, expr.target)
                    sb_append_char(sb, ')')
                }
            } else {
                sb_append_char(sb, '(')
                emit_c_expr(sb, st, expr.target)
                sb_append_char(sb, ')')
                sb_append_char(sb, '.')
                sb_append_str(sb, expr.member_name)
            }
            return
        }
        if is_or_type(target_type) {
            sb_append_char(sb, '(')
            emit_c_expr(sb, st, expr.target)
            sb_append_char(sb, ')')
            if str.len(target_type) > 0 and target_type[0] == '@' { sb_append_str(sb, "->") } else { sb_append_str(sb, ".") }
            if expr.member_name == "ok" {
                sb_append_str(sb, "ok")
            } else {
                sb_append_str(sb, "as.")
                sb_append_str(sb, expr.member_name)
            }
            return
        }
        if is_simd_type(strip_pointer_prefix(target_type)) { emit_simd_member(sb, st, expr, target_type); return }
        let clean_tt = strip_pointer_prefix(target_type)
        if is_fixed_array_type(clean_tt) { emit_array_member(sb, st, expr, clean_tt); return }
        if is_tuple_type(clean_tt) { emit_tuple_member(sb, st, expr, target_type); return }
        emit_c_expr(sb, st, expr.target)
        if str.len(target_type) > 0 and target_type[0] == '@' { sb_append_str(sb, "->") } else { sb_append_str(sb, ".") }; sb_append_str(sb, expr.member_name); return
    }

    // 4. Array indexing
    if expr.kind == EXPR_INDEX {
        let tt = infer_expr_type(st, expr.target)
        if is_simd_type(strip_pointer_prefix(tt)) { emit_simd_index(sb, st, expr, tt); return }
        if is_shelf_form(tt) { emit_shelf_index(sb, st, expr); return }
        if is_map_form(tt) { emit_map_index(sb, st, expr); return }
        emit_c_expr(sb, st, expr.target); sb_append_char(sb, '[')
        emit_c_expr(sb, st, expr.index); sb_append_char(sb, ']'); return
    }

    // 5. Explicit cast (5.2 slice 2: a cast off a raw dyn unboxes instead)
    if expr.kind == EXPR_CAST {
        if infer_expr_type(st, expr.operand) == "dyn" {
            emit_dyn_unbox(sb, st, expr.operand, expr.type_name)
            return
        }
        sb_append_str(sb, "(("); sb_append_str(sb, map_type_to_c(expr.type_name)); sb_append_str(sb, ")(")
        emit_c_expr(sb, st, expr.operand)
        sb_append_str(sb, "))")
        return
    }

    // 6. Struct instantiation literal (omitted fields fall back to their declared defaults)
    if expr.kind == EXPR_STRUCT_LIT { emit_struct_lit_expr(sb, st, expr); return }
    if expr.kind == EXPR_ARRAY_LIT { emit_array_lit(sb, st, expr); return }
    if expr.kind == EXPR_TUPLE_LIT { emit_tuple_lit(sb, st, expr); return }

    // 7. Binary expression
    if expr.kind == EXPR_BINARY {
        let ltype = infer_expr_type(st, expr.left)
        let rtype = infer_expr_type(st, expr.right)
        if expr.op == TOK_DOUBLE_QUESTION {
            let inner = optional_inner_type(ltype)
            if inner[0] == '@' or inner == "string" {
                let c_type = map_type_to_c(inner)
                sb_append_str(sb, "((")
                sb_append_str(sb, c_type)
                sb_append_str(sb, ")velo_opt_coalesce_ptr(")
                emit_c_expr(sb, st, expr.left)
                sb_append_str(sb, ", ")
                emit_c_expr(sb, st, expr.right)
                sb_append_str(sb, "))")
            } else {
                sb_append_str(sb, "(("); emit_c_expr(sb, st, expr.left); sb_append_str(sb, ").has ? ("); emit_c_expr(sb, st, expr.left); sb_append_str(sb, ").val : ("); emit_c_expr(sb, st, expr.right); sb_append_str(sb, "))")
            }
            return
        }
        if expr.op == TOK_OR and is_or_type(ltype) {
            sb_append_str(sb, or_type_c_name(ltype)); sb_append_str(sb, "_fallback("); emit_c_expr(sb, st, expr.left); sb_append_str(sb, ", "); emit_c_expr(sb, st, expr.right); sb_append_char(sb, ')'); return
        }
        if is_simd_type(ltype) or is_simd_type(rtype) { emit_simd_binary(sb, st, expr, ltype, rtype); return }
        // 5.2 slice 8: raw dyn arithmetic/compares auto-unbox — identical C with Stage 1's _emit_dyn_binop
        if ltype == "dyn" or rtype == "dyn" {
            emit_dyn_binop(sb, st, expr, ltype, rtype)
            return
        }
        let op_fn = find_binary_op(st, expr.op, ltype, rtype)
        if op_fn != null {
            sb_append_str(sb, op_fn.name); sb_append_char(sb, '(')
            let p0 = op_fn.first_param
            mut p1: @ParamSym = null
            if p0 != null { p1 = p0.next }
            let p0_ptr = p0 != null and str.len(p0.type_name) > 0 and p0.type_name[0] == '@'
            let l_ptr = str.len(ltype) > 0 and ltype[0] == '@'
            if p0_ptr and not l_ptr { sb_append_str(sb, "&(") } else if l_ptr and not p0_ptr { sb_append_str(sb, "*(") }
            emit_c_expr(sb, st, expr.left)
            if (p0_ptr and not l_ptr) or (l_ptr and not p0_ptr) { sb_append_char(sb, ')') }
            sb_append_str(sb, ", ")
            let p1_ptr = p1 != null and str.len(p1.type_name) > 0 and p1.type_name[0] == '@'
            let r_ptr = str.len(rtype) > 0 and rtype[0] == '@'
            if p1_ptr and not r_ptr { sb_append_str(sb, "&(") } else if r_ptr and not p1_ptr { sb_append_str(sb, "*(") }
            emit_c_expr(sb, st, expr.right)
            if (p1_ptr and not r_ptr) or (r_ptr and not p1_ptr) { sb_append_char(sb, ')') }
            sb_append_char(sb, ')')
            return
        }
        if expr.op == TOK_PLUS {
            let ltype = infer_expr_type(st, expr.left); let rtype = infer_expr_type(st, expr.right)
            if ltype == "string" and rtype == "string" {
                sb_append_str(sb, "velo_str_concat("); emit_c_expr(sb, st, expr.left); sb_append_str(sb, ", "); emit_c_expr(sb, st, expr.right); sb_append_char(sb, ')')
                return
            }
        }
        if expr.op == TOK_EQ or expr.op == TOK_NEQ {
            let ltype = infer_expr_type(st, expr.left)
            let rtype = infer_expr_type(st, expr.right)
            if is_optional_type(ltype) and expr.right.kind == EXPR_NULL {
                let inner = optional_inner_type(ltype)
                if inner[0] != '@' and inner != "string" {
                    if expr.op == TOK_NEQ { sb_append_char(sb, '('); emit_c_expr(sb, st, expr.left); sb_append_str(sb, ".has)"); return }
                    else { sb_append_str(sb, "(!"); emit_c_expr(sb, st, expr.left); sb_append_str(sb, ".has)"); return }
                }
            }
            if is_optional_type(rtype) and expr.left.kind == EXPR_NULL {
                let inner = optional_inner_type(rtype)
                if inner[0] != '@' and inner != "string" {
                    if expr.op == TOK_NEQ { sb_append_char(sb, '('); emit_c_expr(sb, st, expr.right); sb_append_str(sb, ".has)"); return }
                    else { sb_append_str(sb, "(!"); emit_c_expr(sb, st, expr.right); sb_append_str(sb, ".has)"); return }
                }
            }
            if expr.left.kind != EXPR_NULL and expr.right.kind != EXPR_NULL and ltype != "@void" and rtype != "@void" and (ltype == "string" and rtype == "string") {
                if expr.left.kind == EXPR_CALL or expr.right.kind == EXPR_CALL {
                    if expr.op == TOK_EQ { sb_append_str(sb, "velo_str_eq(") } else { sb_append_str(sb, "velo_str_neq(") }
                    emit_c_expr(sb, st, expr.left); sb_append_str(sb, ", "); emit_c_expr(sb, st, expr.right); sb_append_char(sb, ')')
                    return
                }
                sb_append_str(sb, "(("); emit_c_expr(sb, st, expr.left); sb_append_str(sb, " != NULL && "); emit_c_expr(sb, st, expr.right); sb_append_str(sb, " != NULL) ? (strcmp(")
                emit_c_expr(sb, st, expr.left); sb_append_str(sb, ", "); emit_c_expr(sb, st, expr.right)
                if expr.op == TOK_EQ { sb_append_str(sb, ") == 0) : (") } else { sb_append_str(sb, ") != 0) : (") }
                emit_c_expr(sb, st, expr.left); sb_append_char(sb, ' '); sb_append_str(sb, op_to_c_str(expr.op)); sb_append_char(sb, ' '); emit_c_expr(sb, st, expr.right); sb_append_str(sb, "))")
                return
            }
        }

        // Safe mixed signed vs unsigned integer comparisons (Bug 4.2)
        if expr.op == TOK_EQ or expr.op == TOK_NEQ or expr.op == TOK_LT or expr.op == TOK_LTE or expr.op == TOK_GT or expr.op == TOK_GTE {
            let ltype = infer_expr_type(st, expr.left)
            let rtype = infer_expr_type(st, expr.right)
            mut l_signed = is_signed_int_type(ltype)
            mut l_unsigned = is_unsigned_int_type(ltype)
            mut r_signed = is_signed_int_type(rtype)
            mut r_unsigned = is_unsigned_int_type(rtype)
            if expr.left.kind == EXPR_INT and (expr.left.type_name == null or str.len(expr.left.type_name) == 0) and int_literal_exceeds_i64(expr.left.str_val) {
                l_signed = false
                l_unsigned = true
            }
            if expr.right.kind == EXPR_INT and (expr.right.type_name == null or str.len(expr.right.type_name) == 0) and int_literal_exceeds_i64(expr.right.str_val) {
                r_signed = false
                r_unsigned = true
            }
            if (l_signed and r_unsigned) or (l_unsigned and r_signed) {
                mut fn_name = "velo_cmp_eq"
                if expr.op == TOK_NEQ { fn_name = "velo_cmp_ne" }
                else if expr.op == TOK_LT { fn_name = "velo_cmp_lt" }
                else if expr.op == TOK_LTE { fn_name = "velo_cmp_le" }
                else if expr.op == TOK_GT { fn_name = "velo_cmp_gt" }
                else if expr.op == TOK_GTE { fn_name = "velo_cmp_ge" }
                sb_append_str(sb, fn_name)
                if l_signed { sb_append_str(sb, "_s_u(") } else { sb_append_str(sb, "_u_s(") }
                emit_c_expr(sb, st, expr.left)
                sb_append_str(sb, ", ")
                emit_c_expr(sb, st, expr.right)
                sb_append_char(sb, ')')
                return
            }
        }

        if emit_div_or_mod(sb, st, expr, ltype, rtype) { return }
        sb_append_char(sb, '('); emit_c_expr(sb, st, expr.left); sb_append_char(sb, ' ')
        sb_append_str(sb, op_to_c_str(expr.op)); sb_append_char(sb, ' '); emit_c_expr(sb, st, expr.right); sb_append_char(sb, ')')
        return
    }

    // 8. Function call / Intrinsics
    if expr.kind == EXPR_CALL { emit_call_expr(sb, st, expr); return }

    // 9. Outcome propagation expression (`expr or return`)
    if expr.kind == EXPR_OR_RETURN {
        let op_t = infer_expr_type(st, expr.operand); let c_op_t = map_type_to_c(op_t); let ret_c = map_type_to_c(st.current_func_ret_type)
        st.fresh_counter += 1; let tmp_id = st.fresh_counter as i32
        sb_append_str(sb, "({ "); sb_append_str(sb, c_op_t); sb_append_str(sb, " __or_tmp_"); sb_append_int(sb, tmp_id); sb_append_str(sb, " = ")
        emit_c_expr(sb, st, expr.operand)
        sb_append_str(sb, "; if (!__or_tmp_"); sb_append_int(sb, tmp_id); sb_append_str(sb, ".ok) return ("); sb_append_str(sb, ret_c); sb_append_str(sb, "){ .ok = false, .as = { .err = __or_tmp_"); sb_append_int(sb, tmp_id); sb_append_str(sb, ".as.err } }; ")
        sb_append_str(sb, "__or_tmp_"); sb_append_int(sb, tmp_id); sb_append_str(sb, ".as.val; })")
        return
    }

    // 10. Optional unwrap expression (`expr!`)
    if expr.kind == EXPR_UNWRAP {
        let op_t = infer_expr_type(st, expr.operand)
        let inner = optional_inner_type(op_t)
        if inner[0] == '@' or inner == "string" {
            sb_append_str(sb, "(("); sb_append_str(sb, map_type_to_c(inner)); sb_append_str(sb, ")velo_opt_unwrap_ptr(")
            emit_c_expr(sb, st, expr.operand); sb_append_str(sb, ", \""); emit_source_path(sb, st); sb_append_str(sb, "\", ")
            sb_append_int(sb, expr.line); sb_append_str(sb, ", "); sb_append_int(sb, expr.col); sb_append_str(sb, "))")
        } else {
            sb_append_str(sb, "velo_opt_unwrap_"); sb_append_str(sb, inner); sb_append_char(sb, '(')
            emit_c_expr(sb, st, expr.operand); sb_append_str(sb, ", \""); emit_source_path(sb, st); sb_append_str(sb, "\", ")
            sb_append_int(sb, expr.line); sb_append_str(sb, ", "); sb_append_int(sb, expr.col); sb_append_char(sb, ')')
        }
        return
    }

    // 11. Conditional if-else expression (`if c { a } else { b }`)
    if expr.kind == EXPR_IF { emit_if_expr(sb, st, expr); return }
}
