// C99 expression code generator for Velo AST expressions.
use sys.io
use sys.mem
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../analysis/str_checks.vl"
use "../common/string_builder.vl"
use "../common/act_types.vl"
use "codegen_io.vl"
use "../analysis/op_resolver.vl"
use "codegen_types.vl"
use "shelf_gen.vl"
use "shelf_calls_gen.vl"
use "struct_lit_gen.vl"
use "map_gen.vl"

// Emits C99 code for an AST expression into a StringBuilder.
act emit_c_expr(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    if expr == null { return }

    // 1. Literal expressions
    if expr.kind == EXPR_INT {
        if expr.str_val != null and str.len(expr.str_val) > 0 {
            sb_append_str(sb, expr.str_val)
        } else {
            sb_append_int(sb, expr.int_val)
        }
        return
    }
    if expr.kind == EXPR_FLOAT {
        if expr.str_val != null and str.len(expr.str_val) > 0 {
            sb_append_str(sb, expr.str_val)
        } else {
            sb_append_float(sb, expr.float_val)
        }
        return
    }
    if expr.kind == EXPR_STRING { sb_append_char(sb, '"'); sb_append_str(sb, expr.str_val); sb_append_char(sb, '"'); return }
    if expr.kind == EXPR_BOOL { if expr.bool_val { sb_append_str(sb, "true") } else { sb_append_str(sb, "false") }; return }
    if expr.kind == EXPR_NULL { sb_append_str(sb, "NULL"); return }
    if expr.kind == EXPR_IDENT { sb_append_str(sb, expr.str_val); return }
    if expr.kind == EXPR_SHELF_LIT { emit_shelf_literal(sb, st, expr); return }  // 5.2
    if expr.kind == EXPR_MAP_LIT { emit_map_literal(sb, st, expr); return }  // 5.2 slice 6
    if expr.kind == EXPR_VARIANT {
        mut kname = expr.type_name
        mut k_sym: @KindSym = null
        if kname != null and str.len(kname) > 0 { k_sym = find_kind(st, kname) }
        if k_sym == null { k_sym = find_kind_by_variant(st, expr.member_name) }
        if k_sym == null or not k_sym.is_tagged_union {
            if k_sym != null { sb_append_str(sb, k_sym.name); sb_append_char(sb, '_') }
            sb_append_str(sb, expr.member_name)
            return
        }
        sb_append_char(sb, '('); sb_append_str(sb, k_sym.name); sb_append_str(sb, "){ .kind = ")
        sb_append_str(sb, k_sym.name); sb_append_char(sb, '_'); sb_append_str(sb, expr.member_name)
        if expr.first_arg != null {
            let v_sym = find_variant(k_sym, expr.member_name)
            sb_append_str(sb, ", .as = { ."); sb_append_str(sb, expr.member_name); sb_append_str(sb, " = ")
            if v_sym != null and v_sym.field_count > 0 {
                sb_append_str(sb, "{ ")
                mut cur_f = v_sym.first_field; mut cur_a = expr.first_arg
                loop cur_f != null and cur_a != null {
                    sb_append_char(sb, '.'); sb_append_str(sb, cur_f.name); sb_append_str(sb, " = ")
                    emit_c_expr(sb, st, cur_a)
                    if cur_f.next != null { sb_append_str(sb, ", ") }
                    cur_f = cur_f.next; cur_a = cur_a.next
                }
                sb_append_str(sb, " }")
            } else {
                emit_c_expr(sb, st, expr.first_arg)
            }
            sb_append_str(sb, " }")
        }
        sb_append_str(sb, " }")
        return
    }

    // 2. Unary & Address-of & Dereference
    if expr.kind == EXPR_ADDRESS_OF { sb_append_str(sb, "(&("); emit_c_expr(sb, st, expr.operand); sb_append_str(sb, "))"); return }
    if expr.kind == EXPR_DEREF { sb_append_str(sb, "(*("); emit_c_expr(sb, st, expr.operand); sb_append_str(sb, "))"); return }
    if expr.kind == EXPR_UNARY {
        let sub_type = infer_expr_type(st, expr.operand)
        let op_fn = find_unary_op(st, expr.op, sub_type)
        if op_fn != null {
            sb_append_str(sb, op_fn.name); sb_append_char(sb, '(')
            let p0 = op_fn.first_param
            let p0_ptr = p0 != null and str.len(p0.type_name) > 0 and p0.type_name[0] == '@'
            let s_ptr = str.len(sub_type) > 0 and sub_type[0] == '@'
            if p0_ptr and not s_ptr { sb_append_str(sb, "&(") }
            if s_ptr and not p0_ptr { sb_append_str(sb, "*(") }
            emit_c_expr(sb, st, expr.operand)
            if (p0_ptr and not s_ptr) or (s_ptr and not p0_ptr) { sb_append_char(sb, ')') }
            sb_append_char(sb, ')')
            return
        }
        sb_append_str(sb, "(")
        if expr.op == TOK_NOT {
            sb_append_str(sb, "!")
        } else if expr.op == TOK_TILDE {
            sb_append_str(sb, "~")
        } else {
            sb_append_str(sb, "-")
        }
        emit_c_expr(sb, st, expr.operand)
        sb_append_str(sb, ")")
        return
    }

    // 3. Member access with auto-dereference (-> vs .)
    if expr.kind == EXPR_MEMBER {
        if expr.target.kind == EXPR_IDENT {
            let k_sym = find_kind(st, expr.target.str_val)
            if k_sym != null {
                let v_sym = find_variant(k_sym, expr.member_name)
                if v_sym != null {
                    if not k_sym.is_tagged_union {
                        sb_append_str(sb, k_sym.name); sb_append_char(sb, '_'); sb_append_str(sb, expr.member_name)
                    } else {
                        sb_append_char(sb, '('); sb_append_str(sb, k_sym.name); sb_append_str(sb, "){ .kind = ")
                        sb_append_str(sb, k_sym.name); sb_append_char(sb, '_'); sb_append_str(sb, expr.member_name)
                        sb_append_str(sb, " }")
                    }
                    return
                }
            }
        }
        let target_type = infer_expr_type(st, expr.target)
        emit_c_expr(sb, st, expr.target)
        if str.len(target_type) > 0 and target_type[0] == '@' { sb_append_str(sb, "->") } else { sb_append_str(sb, ".") }
        sb_append_str(sb, expr.member_name)
        return
    }

    // 4. Array indexing
    if expr.kind == EXPR_INDEX {
        // 5.2: shelf element reads lower onto velo_shelf_get (bounds-checked)
        if is_shelf_form(infer_expr_type(st, expr.target)) {
            emit_shelf_index(sb, st, expr)
            return
        }
        // 5.2 slice 6: map value reads lower onto velo_map_copy_out (fatal miss)
        if is_map_form(infer_expr_type(st, expr.target)) {
            emit_map_index(sb, st, expr)
            return
        }
        emit_c_expr(sb, st, expr.target)
        sb_append_char(sb, '[')
        emit_c_expr(sb, st, expr.index)
        sb_append_char(sb, ']')
        return
    }

    // 5. Explicit cast (5.2 slice 2: a cast off a raw dyn unboxes instead)
    if expr.kind == EXPR_CAST {
        if infer_expr_type(st, expr.operand) == "dyn" {
            emit_dyn_unbox(sb, st, expr.operand, expr.type_name)
            return
        }
        sb_append_str(sb, "(("); sb_append_str(sb, map_type_to_c(expr.type_name)); sb_append_str(sb, ")(")
        emit_c_expr(sb, st, expr.operand)
        sb_append_str(sb, "))")
        return
    }

    // 6. Struct instantiation literal (omitted fields fall back to their declared defaults)
    if expr.kind == EXPR_STRUCT_LIT { emit_struct_lit_expr(sb, st, expr); return }

    // 7. Binary expression
    if expr.kind == EXPR_BINARY {
        let ltype = infer_expr_type(st, expr.left)
        let rtype = infer_expr_type(st, expr.right)
        let op_fn = find_binary_op(st, expr.op, ltype, rtype)
        if op_fn != null {
            sb_append_str(sb, op_fn.name); sb_append_char(sb, '(')
            let p0 = op_fn.first_param
            mut p1: @ParamSym = null
            if p0 != null { p1 = p0.next }
            let p0_ptr = p0 != null and str.len(p0.type_name) > 0 and p0.type_name[0] == '@'
            let l_ptr = str.len(ltype) > 0 and ltype[0] == '@'
            if p0_ptr and not l_ptr { sb_append_str(sb, "&(") }
            if l_ptr and not p0_ptr { sb_append_str(sb, "*(") }
            emit_c_expr(sb, st, expr.left)
            if (p0_ptr and not l_ptr) or (l_ptr and not p0_ptr) { sb_append_char(sb, ')') }
            sb_append_str(sb, ", ")
            let p1_ptr = p1 != null and str.len(p1.type_name) > 0 and p1.type_name[0] == '@'
            let r_ptr = str.len(rtype) > 0 and rtype[0] == '@'
            if p1_ptr and not r_ptr { sb_append_str(sb, "&(") }
            if r_ptr and not p1_ptr { sb_append_str(sb, "*(") }
            emit_c_expr(sb, st, expr.right)
            if (p1_ptr and not r_ptr) or (r_ptr and not p1_ptr) { sb_append_char(sb, ')') }
            sb_append_char(sb, ')')
            return
        }
        if expr.op == TOK_EQ or expr.op == TOK_NEQ {
            let ltype = infer_expr_type(st, expr.left)
            let rtype = infer_expr_type(st, expr.right)
            if ltype == "string" or rtype == "string" {
                sb_append_str(sb, "((")
                emit_c_expr(sb, st, expr.left)
                sb_append_str(sb, " != NULL && ")
                emit_c_expr(sb, st, expr.right)
                sb_append_str(sb, " != NULL) ? (strcmp(")
                emit_c_expr(sb, st, expr.left)
                sb_append_str(sb, ", ")
                emit_c_expr(sb, st, expr.right)
                if expr.op == TOK_EQ {
                    sb_append_str(sb, ") == 0) : (")
                } else {
                    sb_append_str(sb, ") != 0) : (")
                }
                emit_c_expr(sb, st, expr.left)
                sb_append_char(sb, ' ')
                sb_append_str(sb, op_to_c_str(expr.op))
                sb_append_char(sb, ' ')
                emit_c_expr(sb, st, expr.right)
                sb_append_str(sb, "))")
                return
            }
        }

        sb_append_char(sb, '(')
        emit_c_expr(sb, st, expr.left)
        sb_append_char(sb, ' ')
        sb_append_str(sb, op_to_c_str(expr.op))
        sb_append_char(sb, ' ')
        emit_c_expr(sb, st, expr.right)
        sb_append_char(sb, ')')
        return
    }

    // 8. Function call / Intrinsics
    if expr.kind == EXPR_CALL {
        if expr.callee.kind == EXPR_MEMBER and expr.callee.target.kind == EXPR_IDENT {
            let k_sym = find_kind(st, expr.callee.target.str_val)
            if k_sym != null {
                let v_sym = find_variant(k_sym, expr.callee.member_name)
                if v_sym != null {
                    sb_append_char(sb, '('); sb_append_str(sb, k_sym.name); sb_append_str(sb, "){ .kind = ")
                    sb_append_str(sb, k_sym.name); sb_append_char(sb, '_'); sb_append_str(sb, v_sym.name)
                    if expr.first_arg != null {
                        sb_append_str(sb, ", .as = { ."); sb_append_str(sb, v_sym.name); sb_append_str(sb, " = ")
                        if v_sym.field_count > 0 {
                            sb_append_str(sb, "{ ")
                            mut cur_f = v_sym.first_field; mut cur_a = expr.first_arg
                            loop cur_f != null and cur_a != null {
                                sb_append_char(sb, '.'); sb_append_str(sb, cur_f.name); sb_append_str(sb, " = ")
                                emit_c_expr(sb, st, cur_a)
                                if cur_f.next != null { sb_append_str(sb, ", ") }
                                cur_f = cur_f.next; cur_a = cur_a.next
                            }
                            sb_append_str(sb, " }")
                        } else {
                            emit_c_expr(sb, st, expr.first_arg)
                        }
                        sb_append_str(sb, " }")
                    }
                    sb_append_str(sb, " }")
                    return
                }
            }
        }
        if expr.callee.kind == EXPR_MEMBER {
            let target = expr.callee.target
            let member = expr.callee.member_name
            if target.kind == EXPR_IDENT {
                if target.str_val == "mem" {
                    if member == "alloc" {
                        let elem_type = map_type_to_c(strip_pointer_prefix(infer_expr_type(st, expr.first_arg))); sb_append_str(sb, "(("); sb_append_str(sb, elem_type); sb_append_str(sb, "*)velo_mem_alloc(sizeof(")
                        sb_append_str(sb, elem_type); sb_append_str(sb, "), (size_t)("); emit_c_expr(sb, st, expr.first_arg.next); sb_append_str(sb, ")))"); return
                    }
                    if member == "heap_alloc" {
                        let elem_type = map_type_to_c(strip_pointer_prefix(infer_expr_type(st, expr.first_arg))); sb_append_str(sb, "(("); sb_append_str(sb, elem_type); sb_append_str(sb, "*)velo_heap_alloc(sizeof(")
                        sb_append_str(sb, elem_type); sb_append_str(sb, "), (size_t)("); emit_c_expr(sb, st, expr.first_arg.next); sb_append_str(sb, ")))"); return
                    }
                    if member == "free" { sb_append_str(sb, "velo_heap_free((void*)("); emit_c_expr(sb, st, expr.first_arg); sb_append_str(sb, "))"); return }
                    // cm43: realloc keeps heap size-header + ledger; copy/move/set map onto the C memcpy trio
                    if member == "realloc" {
                        let elem_type = map_type_to_c(strip_pointer_prefix(infer_expr_type(st, expr.first_arg.next))); sb_append_str(sb, "(("); sb_append_str(sb, elem_type); sb_append_str(sb, "*)velo_heap_realloc((void*)(")
                        if expr.first_arg != null { emit_c_expr(sb, st, expr.first_arg) } else { sb_append_str(sb, "NULL") }; sb_append_str(sb, "), sizeof("); sb_append_str(sb, elem_type); sb_append_str(sb, "), (long long)("); if expr.first_arg.next.next != null { emit_c_expr(sb, st, expr.first_arg.next.next) } else { sb_append_str(sb, "0") }; sb_append_str(sb, ")))"); return
                    }
                    if member == "copy" or member == "move" or member == "set" { let cfn = "velo_byte_copy"
                        if member == "move" { cfn = "velo_byte_move" }; if member == "set" { cfn = "velo_byte_set" }; sb_append_str(sb, cfn); sb_append_str(sb, "("); sb_append_str(sb, "(void*)(")
                        if expr.first_arg != null { emit_c_expr(sb, st, expr.first_arg) }; sb_append_str(sb, ")")
                        if member == "set" { sb_append_str(sb, ", (int)(") } else { sb_append_str(sb, ", (void*)(") }; if expr.first_arg.next != null { emit_c_expr(sb, st, expr.first_arg.next) }; sb_append_str(sb, ")"); sb_append_str(sb, ", (long long)(")
                        if expr.first_arg.next.next != null { emit_c_expr(sb, st, expr.first_arg.next.next) } else { sb_append_str(sb, "0") }; sb_append_str(sb, "))"); return
                    }
                    if member == "used" { sb_append_str(sb, "velo_mem_used()"); return }
                    if member == "heap_used" { sb_append_str(sb, "velo_heap_used()"); return }
                    // §4.1: mem.current() -> active arena; mem.alloc_with(a, @T, count) -> @T
                    if member == "current" { sb_append_str(sb, "velo_zone_active()"); return }  // §4.1/§4.2
                    if member == "alloc_with" {
                        let elem_type = map_type_to_c(strip_pointer_prefix(infer_expr_type(st, expr.first_arg.next))); sb_append_str(sb, "(("); sb_append_str(sb, elem_type); sb_append_str(sb, "*)velo_alloc_with((VeloAllocator)(")
                        emit_c_expr(sb, st, expr.first_arg); sb_append_str(sb, "), sizeof("); sb_append_str(sb, elem_type); sb_append_str(sb, "), (size_t)(")
                        emit_c_expr(sb, st, expr.first_arg.next.next); sb_append_str(sb, ")))"); return
                    }
                }
                // §4.2: spawn/join zero-arg i32 acts (@Thread = VeloThreadCtx*); @Mutex ops are opaque void*
                if target.str_val == "thread" and member == "spawn" { sb_append_str(sb, "velo_thread_spawn((VeloThreadFn)("); if expr.first_arg != null { emit_c_expr(sb, st, expr.first_arg) } else { sb_append_str(sb, "NULL") }; sb_append_str(sb, "))"); return }; if target.str_val == "thread" and member == "join" { sb_append_str(sb, "velo_thread_join("); if expr.first_arg != null { emit_c_expr(sb, st, expr.first_arg) } else { sb_append_str(sb, "NULL") }; sb_append_str(sb, ")"); return }
                if target.str_val == "thread" and member == "mutex" { sb_append_str(sb, "velo_mutex_create()"); return }; if target.str_val == "thread" and member == "acquire" { sb_append_str(sb, "velo_mutex_acquire((void*)("); if expr.first_arg != null { emit_c_expr(sb, st, expr.first_arg) } else { sb_append_str(sb, "NULL") }; sb_append_str(sb, "))"); return }
                if target.str_val == "thread" and member == "release" { sb_append_str(sb, "velo_mutex_release((void*)("); if expr.first_arg != null { emit_c_expr(sb, st, expr.first_arg) } else { sb_append_str(sb, "NULL") }; sb_append_str(sb, "))"); return }; if target.str_val == "thread" and member == "free" { sb_append_str(sb, "velo_mutex_destroy((void*)("); if expr.first_arg != null { emit_c_expr(sb, st, expr.first_arg) } else { sb_append_str(sb, "NULL") }; sb_append_str(sb, "))"); return }
                if target.str_val == "fs" {
                    if member == "read_file" { sb_append_str(sb, "velo_fs_read_file("); emit_c_expr(sb, st, expr.first_arg); sb_append_str(sb, ")"); return }
                    if member == "write_file" {
                        sb_append_str(sb, "velo_fs_write_file(")
                        emit_c_expr(sb, st, expr.first_arg); sb_append_str(sb, ", "); emit_c_expr(sb, st, expr.first_arg.next)
                        sb_append_str(sb, ")")
                        return
                    }
                    if member == "exists" { sb_append_str(sb, "velo_fs_exists("); emit_c_expr(sb, st, expr.first_arg); sb_append_str(sb, ")"); return }
                    if member == "size" { sb_append_str(sb, "velo_fs_size("); emit_c_expr(sb, st, expr.first_arg); sb_append_str(sb, ")"); return }
                    if member == "remove" or member == "remove_file" { sb_append_str(sb, "velo_fs_remove("); emit_c_expr(sb, st, expr.first_arg); sb_append_str(sb, ")"); return }
                }
                if target.str_val == "str" and member == "len" { sb_append_str(sb, "((usize)strlen("); emit_c_expr(sb, st, expr.first_arg); sb_append_str(sb, "))"); return }
                if target.str_val == "str" and str.len(str_member_sig(member)) > 0 {  // 5.1: library members map 1:1 onto velo_str_* runtime helpers
                    sb_append_str(sb, "velo_str_"); sb_append_str(sb, member); sb_append_char(sb, '(')
                    mut a = expr.first_arg; loop a != null { emit_c_expr(sb, st, a); if a.next != null { sb_append_str(sb, ", ") }; a = a.next }
                    sb_append_char(sb, ')'); return
                }
                if target.str_val == "io" { emit_io_call(sb, st, member, expr.first_arg); return }
            }
        }
        // 5.2: shelf receivers — put / take lower onto VeloShelf helpers
        if expr.callee.kind == EXPR_MEMBER {
            if is_shelf_form(infer_expr_type(st, expr.callee.target)) {
                emit_shelf_member_call(sb, st, expr)
                return
            }
            if is_map_form(infer_expr_type(st, expr.callee.target)) {  // 5.2 slice 6: put / get / has
                emit_map_member_call(sb, st, expr)
                return
            }
        }
        if expr.callee.kind == EXPR_MEMBER {
            let target_type = infer_expr_type(st, expr.callee.target)
            let clean_type = strip_pointer_prefix(target_type)
            let st_sym = find_struct(st, clean_type)
            if st_sym == null or find_struct_field(st_sym, expr.callee.member_name) == null {
                let fn_sym = find_function(st, expr.callee.member_name)
                if fn_sym != null {
                    sb_append_str(sb, fn_sym.name)
                    sb_append_char(sb, '(')
                    let p0_type = fn_sym.first_param.type_name
                    let is_tgt_ptr = target_type != null and str.len(target_type) > 0 and target_type[0] == '@'
                    let is_p0_ptr = p0_type != null and str.len(p0_type) > 0 and p0_type[0] == '@'
                    if is_p0_ptr and not is_tgt_ptr {
                        sb_append_str(sb, "(&(")
                        emit_c_expr(sb, st, expr.callee.target)
                        sb_append_str(sb, "))")
                    } else if is_tgt_ptr and not is_p0_ptr {
                        sb_append_str(sb, "(*(")
                        emit_c_expr(sb, st, expr.callee.target)
                        sb_append_str(sb, "))")
                    } else {
                        emit_c_expr(sb, st, expr.callee.target)
                    }
                    if expr.first_arg != null {
                        sb_append_str(sb, ", ")
                    }
                    mut cur_a = expr.first_arg
                    loop cur_a != null {
                        emit_c_expr(sb, st, cur_a)
                        if cur_a.next != null {
                            sb_append_str(sb, ", ")
                        }
                        cur_a = cur_a.next
                    }
                    sb_append_char(sb, ')')
                    return
                }
            }
        }

        // Standard function call
        emit_c_expr(sb, st, expr.callee)
        sb_append_char(sb, '(')
        mut cur_arg = expr.first_arg
        loop cur_arg != null {
            emit_c_expr(sb, st, cur_arg)
            if cur_arg.next != null {
                sb_append_str(sb, ", ")
            }
            cur_arg = cur_arg.next
        }
        sb_append_char(sb, ')')
    }
}
