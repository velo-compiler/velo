// Shared type and operator mapping utilities for C99 code generation.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../common/utils.vl"
use "../common/string_builder.vl"
use "../common/act_types.vl"
use "../analysis/misc_checks.vl"

// Typed C representation metadata for code generation.
data CType {
    name: string
    width: i32
    is_signed: bool
    needs_space: bool
}

// Constructs a typed CType descriptor.
act make_ctype(name: string, width: i32, is_signed: bool, needs_space: bool) -> CType {
    return CType {
        name: name,
        width: width,
        is_signed: is_signed,
        needs_space: needs_space,
    }
}

// Renders a CType into a StringBuilder, adding trailing space if needs_space is set.
act ctype_render(sb: @StringBuilder, ct: CType) {
    if ct.name != null {
        sb_append_str(sb, ct.name)
    }
    if ct.needs_space {
        sb_append_char(sb, ' ')
    }
}

// Emits a CType into a StringBuilder followed explicitly by a single space delimiter.
act emit_type_then_space(sb: @StringBuilder, ct: CType) {
    if ct.name != null {
        sb_append_str(sb, ct.name)
    }
    sb_append_char(sb, ' ')
}

// Emits a Velo type name as C type into a StringBuilder followed explicitly by a single space delimiter.
act emit_type_str_then_space(sb: @StringBuilder, type_name: string) {
    let ct = map_type_to_ctype(type_name)
    emit_type_then_space(sb, ct)
}

// Maps primitive Velo types to their canonical typed C99 CType.
act primitive_type_to_ctype(type_name: string) -> CType {
    if type_name == null or str.len(type_name) == 0 or type_name == "void" { return make_ctype("void", 0, false, false) }
    if type_name == "i8" { return make_ctype("int8_t", 8, true, false) }
    if type_name == "i16" { return make_ctype("int16_t", 16, true, false) }
    if type_name == "i32" { return make_ctype("int32_t", 32, true, false) }
    if type_name == "i64" { return make_ctype("int64_t", 64, true, false) }
    if type_name == "u8" { return make_ctype("uint8_t", 8, false, false) }
    if type_name == "u16" { return make_ctype("uint16_t", 16, false, false) }
    if type_name == "u32" { return make_ctype("uint32_t", 32, false, false) }
    if type_name == "u64" { return make_ctype("uint64_t", 64, false, false) }
    if type_name == "f32" { return make_ctype("float", 32, true, false) }
    if type_name == "f64" { return make_ctype("double", 64, true, false) }
    if type_name == "bool" { return make_ctype("bool", 1, false, false) }
    if type_name == "usize" { return make_ctype("size_t", 64, false, false) }
    if type_name == "isize" { return make_ctype("ptrdiff_t", 64, true, false) }
    if type_name == "string" { return make_ctype("const char*", 64, false, false) }
    if type_name == "f32x4" { return make_ctype("f32x4", 128, true, false) }
    if type_name == "i32x4" { return make_ctype("i32x4", 128, true, false) }
    return make_ctype(null, 0, false, false)
}

// Maps any Velo type to its typed CType metadata.
act map_type_to_ctype(type_name: string) -> CType {
    let prim = primitive_type_to_ctype(type_name)
    if prim.name != null { return prim }
    let c_str = map_type_to_c(type_name)
    return make_ctype(c_str, 64, false, false)
}

// Maps a Velo type name to its standard C99 type string.
act map_type_to_c(type_name: string) -> string {
    let prim = primitive_type_to_ctype(type_name)
    if prim.name != null { return prim.name }
    // 5.2 slice 2: the shelf[dyn] tagged box (VeloDyn lives in velo_runtime.h)
    if type_name == "dyn" { return "VeloDyn" }
    // §4.1: @Allocator in Velo → VeloZoneArena in C (the @ prefix adds the * making VeloZoneArena*)
    if type_name == "Allocator" { return "VeloZoneArena" }
    // §4.2: @Thread → VeloThreadCtx (@ adds *); @Mutex stays an opaque void*
    if type_name == "Thread" { return "VeloThreadCtx" }; if type_name == "Mutex" { return "void" }; if type_name == "File" { return "FILE" } // 5.4 S4: @File → FILE* (streaming handles pass straight through)

    if is_act_type(type_name) {
        return mangle_act_type(type_name)
    }

    if is_optional_type(type_name) {
        let inner = optional_inner_type(type_name)
        if inner[0] == '@' or inner == "string" {
            return map_type_to_c(inner)
        }
        return opt_type_c_name(type_name)
    }

    if is_or_type(type_name) {
        return or_type_c_name(type_name)
    }

    if is_tuple_type(type_name) {
        return tuple_c_name(type_name)
    }

    // 5.2: `shelf[T]` / `@shelf[T]` / (slice 10) `heap shelf[T]` → the single
    // shared VeloShelf layout (is_shelf_form strips the heap modifier)
    if is_shelf_form(type_name) {
        if type_name[0] == '@' { return "VeloShelf*" }
        return "VeloShelf"
    }

    // 5.2 slice 6: `Map[K, V]` / `@Map[K, V]` → the single shared VeloMap layout
    if is_map_form(type_name) {
        if type_name[0] == '@' { return "VeloMap*" }
        return "VeloMap"
    }

    // 5.2 slice 9: `ring[T]` / `@ring[T]` → the single shared VeloRing layout;
    // `bitset` / `@bitset` → VeloBitset (the bare collection type)
    if is_ring_type(type_name) {
        if type_name[0] == '@' { return "VeloRing*" }
        return "VeloRing"
    }
    if is_bitset_type(type_name) {
        if type_name[0] == '@' { return "VeloBitset*" }
        return "VeloBitset"
    }

    if is_fixed_array_type(type_name) {
        let elem_c = map_type_to_c(fixed_array_elem_type(type_name))
        mut sb = create_sb(str.len(elem_c) + 2)
        sb_append_str(@sb, elem_c)
        sb_append_char(@sb, '*')
        return sb_to_string(@sb)
    }

    // Pointer types (@T, @@T)
    if type_name[0] == '@' {
        let base = strip_pointer_prefix(type_name)
        if is_fixed_array_type(base) {
            let elem_c = map_type_to_c(fixed_array_elem_type(base))
            mut sb = create_sb(str.len(elem_c) + 2)
            sb_append_str(@sb, elem_c)
            sb_append_char(@sb, '*')
            return sb_to_string(@sb)
        }
        let base_c = map_type_to_c(base)
        let plen = str.len(base_c) + 1
        mut buf: @u8 = mem.alloc(@u8, plen + 1)
        mut i: usize = 0
        loop i < str.len(base_c) {
            buf[i] = base_c[i]
            i += 1
        }
        buf[str.len(base_c)] = '*'
        buf[plen] = 0 as u8
        return buf as string
    }

    return type_name
}

// Maps an assignment operator token to its C representation.
act map_assign_op(op: i32) -> string {
    if op == TOK_PLUS_ASSIGN { return "+=" }; if op == TOK_MINUS_ASSIGN { return "-=" }; if op == TOK_STAR_ASSIGN { return "*=" }
    if op == TOK_SLASH_ASSIGN { return "/=" }; if op == TOK_AMP_ASSIGN { return "&=" }; if op == TOK_PIPE_ASSIGN { return "|=" }
    if op == TOK_CARET_ASSIGN { return "^=" }; if op == TOK_SHL_ASSIGN { return "<<=" }; if op == TOK_SHR_ASSIGN { return ">>=" }
    return "="
}

// Maps a binary operator token kind to its C99 operator string.
act op_to_c_str(op: i32) -> string {
    if op == TOK_PLUS { return "+" }; if op == TOK_MINUS { return "-" }; if op == TOK_STAR { return "*" }
    if op == TOK_SLASH { return "/" }; if op == TOK_PERCENT { return "%" }; if op == TOK_EQ { return "==" }
    if op == TOK_NEQ { return "!=" }; if op == TOK_LT { return "<" }; if op == TOK_LTE { return "<=" }
    if op == TOK_GT { return ">" }; if op == TOK_GTE { return ">=" }; if op == TOK_AND { return "&&" }
    if op == TOK_OR { return "||" }; if op == TOK_AMP { return "&" }; if op == TOK_PIPE { return "|" }
    if op == TOK_CARET { return "^" }; if op == TOK_SHL { return "<<" }; if op == TOK_SHR { return ">>" }
    return "+"
}
