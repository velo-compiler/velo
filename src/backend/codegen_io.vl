// C99 IO intrinsics and string interpolation code generator for Velo.
use sys.io
use sys.mem
use "../frontend/token.vl"
use "../frontend/lexer.vl"
use "../frontend/parser.vl"
use "../frontend/parser_binary.vl"
use "../frontend/parser_expr.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../analysis/shelf_checks.vl"
use "../analysis/dyn_checks.vl"
use "../analysis/math_checks.vl"
use "../common/string_builder.vl"
use "../common/utils.vl"
use "codegen_expr.vl"

// Resolves the type of a member access or identifier path and formats its C representation.
act resolve_path_type_and_c(st: @SymbolTable, path: string, out_c_expr: @StringBuilder) -> string {
    if path == null or str.len(path) == 0 { return "i32" }
    let plen = str.len(path)

    // Check for pointer dereference postfix: `var.@`
    if plen > 2 and path[plen - 2] == '.' and path[plen - 1] == '@' {
        let base = copy_slice_to_string(path, 0, plen - 2)
        sb_append_str(out_c_expr, "(*")
        sb_append_str(out_c_expr, base)
        sb_append_char(out_c_expr, ')')
        let sym = resolve_variable(st, base)
        if sym != null {
            return strip_pointer_prefix(sym.type_name)
        }
        return "i32"
    }

    // 5.3: math constants ride interpolations as bare member paths — the
    // shared decimal literals go into the C expr, typed f64 (mirrors stage
    // 1's _resolve_path_type / _convert_path_to_c guards)
    if plen > 5 and path[0] == 'm' and path[1] == 'a' and path[2] == 't' and path[3] == 'h' and path[4] == '.' {
        let digits = math_constant_digits(copy_slice_to_string(path, 5, plen - 5))
        if str.len(digits) > 0 {
            sb_append_str(out_c_expr, "(")
            sb_append_str(out_c_expr, digits)
            sb_append_str(out_c_expr, ")")
            return "f64"
        }
    }

    // Locate the first dot separator if one exists
    mut dot_pos: i32 = -1
    mut k: usize = 0
    loop k < plen {
        if path[k] == '.' {
            dot_pos = k as i32
            k = plen
        }
        k += 1
    }

    // Simple variable without member accesses
    if dot_pos == -1 {
        let sym = resolve_variable(st, path)
        if sym != null {
            sb_append_str(out_c_expr, path)
            return sym.type_name
        }
        return ""
    }

    // Compound dotted member path (e.g. `p.pos.x`, `tok.line`)
    let base_name = copy_slice_to_string(path, 0, dot_pos as usize)
    let sym = resolve_variable(st, base_name)
    if sym == null { return "" }
    sb_append_str(out_c_expr, base_name)
    mut curr_type = sym.type_name

    mut seg_start: usize = (dot_pos + 1) as usize
    loop seg_start < plen {
        mut seg_end = seg_start
        loop seg_end < plen and path[seg_end] != '.' {
            seg_end += 1
        }
        let field_name = copy_slice_to_string(path, seg_start, seg_end - seg_start)
        if str.len(curr_type) > 0 and curr_type[0] == '@' {
            sb_append_str(out_c_expr, "->")
        } else {
            sb_append_char(out_c_expr, '.')
        }
        sb_append_str(out_c_expr, field_name)

        let clean_type = strip_pointer_prefix(curr_type)
        let st_sym = find_struct(st, clean_type)
        if st_sym != null {
            let f_sym = find_struct_field(st_sym, field_name)
            if f_sym != null {
                curr_type = f_sym.type_name
            } else {
                curr_type = "i32"
            }
        } else {
            curr_type = "i32"
        }
        seg_start = seg_end + 1
    }
    return curr_type
}

// Parses an expression extracted from string interpolation `{...}`.
act parse_interp_expr(source: string) -> @ExprNode {
    if source == null or str.len(source) == 0 { return null }
    let slen = str.len(source)
    mut clean_src = source
    if str.contains(clean_src, "\\\"") { clean_src = str.replace(clean_src, "\\\"", "\"") }
    let clen = str.len(clean_src)
    mut lex = create_lexer(clean_src, clen, clen + 4)
    tokenize(@lex)
    if lex.token_count <= 1 { return null }
    mut p: Parser
    init_parser(@p, "<interpolated>", clean_src, lex.tokens, lex.token_count)
    let expr = parse_expression(@p)
    if p.had_error { return null }
    if p.pos < p.token_count and p.tokens[p.pos].kind != TOK_EOF { return null }
    return expr
}

// Emits code for `io.println` and `io.print` calls with full string interpolation and formatting.
act emit_io_call(sb: @StringBuilder, st: @SymbolTable, member: string, first_arg: @ExprNode) {
    let is_println = (member == "println")

    // 1. Zero arguments: `io.println()` or `io.print()`
    if first_arg == null {
        if is_println {
            sb_append_str(sb, "printf(\"\\n\")")
        } else {
            sb_append_str(sb, "((void)0)")
        }
        return
    }

    // 2. Direct non-string expression argument: `io.println(123)`, `io.println(val)`
    if first_arg.kind != EXPR_STRING {
        let arg_type = infer_expr_type(st, first_arg)
        // 5.2 slice 2: raw dyn prints nothing useful — cast (as) first
        if arg_type == "dyn" {
            report_error("backend", first_arg.line, first_arg.col, dyn_gate_error())
            st.error_count += 1
            return
        }
        if arg_type == "f32" or arg_type == "f64" {
            if is_println {
                sb_append_str(sb, "printf(\"%f\\n\", (double)(")
            } else {
                sb_append_str(sb, "printf(\"%f\", (double)(")
            }
            emit_c_expr(sb, st, first_arg)
            sb_append_str(sb, "))")
            return
        }
        if arg_type == "string" {
            if is_println {
                sb_append_str(sb, "printf(\"%s\\n\", (const char*)(")
            } else {
                sb_append_str(sb, "printf(\"%s\", (const char*)(")
            }
            emit_c_expr(sb, st, first_arg)
            sb_append_str(sb, "))")
            return
        }
        if arg_type == "bool" {
            if is_println {
                sb_append_str(sb, "printf(\"%s\\n\", ((")
            } else {
                sb_append_str(sb, "printf(\"%s\", ((")
            }
            emit_c_expr(sb, st, first_arg)
            sb_append_str(sb, ") ? \"true\" : \"false\"))")
            return
        }
        // Integer or pointer types
        if is_println {
            sb_append_str(sb, "printf(\"%lld\\n\", (long long)(")
        } else {
            sb_append_str(sb, "printf(\"%lld\", (long long)(")
        }
        emit_c_expr(sb, st, first_arg)
        sb_append_str(sb, "))")
        return
    }

    // 3. String literal argument with potential interpolation `{...}`
    let raw = first_arg.str_val
    mut fmt_sb = create_sb(str.len(raw) + 32)
    mut args_sb = create_sb(str.len(raw) * 2 + 32)
    let n = build_interp_fmt_and_args(st, raw, first_arg.line, first_arg.col, @fmt_sb, @args_sb)
    if n < 0 {
        if is_println {
            sb_append_str(sb, "printf(\"%s\\n\", (const char*)(\"")
        } else {
            sb_append_str(sb, "printf(\"%s\", (const char*)(\"")
        }
        sb_append_str(sb, raw)
        sb_append_str(sb, "\"))")
        return
    }

    sb_append_str(sb, "printf(\"")
    sb_append_str(sb, sb_to_string(@fmt_sb))
    if is_println {
        sb_append_str(sb, "\\n")
    }
    sb_append_char(sb, '"')
    if n > 0 {
        sb_append_str(sb, ", ")
        sb_append_str(sb, sb_to_string(@args_sb))
    }
    sb_append_char(sb, ')')
}

// Builds format string and arguments for an interpolated string. Returns arg_count, or -1 if no interpolation.
act build_interp_fmt_and_args(st: @SymbolTable, raw: string, line: i32, col: i32, out_fmt: @StringBuilder, out_args: @StringBuilder) -> i32 {
    if raw == null or str.len(raw) == 0 { return -1 }
    let len = str.len(raw)

    mut has_interp = false
    mut scan_i: usize = 0
    loop scan_i < len {
        if raw[scan_i] == '{' {
            mut scan_j = scan_i + 1
            loop scan_j < len and raw[scan_j] != '}' and raw[scan_j] != '{' {
                scan_j += 1
            }
            if scan_j < len and raw[scan_j] == '}' and scan_j > scan_i + 1 {
                has_interp = true
                scan_i = len
            }
        }
        scan_i += 1
    }

    if not has_interp { return -1 }

    mut arg_count: i32 = 0
    mut idx: usize = 0
    loop idx < len {
        let c = raw[idx]
        if c == '{' {
            mut depth: usize = 1
            mut close_idx = idx + 1
            loop close_idx < len and depth > 0 {
                if raw[close_idx] == '{' {
                    depth += 1
                } else if raw[close_idx] == '}' {
                    depth -= 1
                }
                if depth > 0 {
                    close_idx += 1
                }
            }
            if close_idx < len and depth == 0 and close_idx > idx + 1 {
                let path = copy_slice_to_string(raw, idx + 1, close_idx - (idx + 1))
                mut resolved_type = ""
                mut c_sb = create_sb(64)
                mut parsed_expr = parse_interp_expr(path)
                if parsed_expr != null and not is_valid_interp_expr(st, parsed_expr) {
                    parsed_expr = null
                }
                if parsed_expr != null {
                    resolved_type = infer_expr_type(st, parsed_expr)
                    emit_c_expr(@c_sb, st, parsed_expr)
                } else {
                    resolved_type = resolve_path_type_and_c(st, path, @c_sb)
                }
                if str.len(resolved_type) == 0 or resolved_type == "unknown" {
                    sb_append_char(out_fmt, '{'); sb_append_str(out_fmt, path); sb_append_char(out_fmt, '}')
                    idx = close_idx + 1
                    continue
                }
                let c_expr_str = sb_to_string(@c_sb)
                if resolved_type == "dyn" {
                    report_error("backend", line, col, dyn_gate_error())
                    st.error_count += 1
                }

                if resolved_type == "f32" or resolved_type == "f64" {
                    sb_append_str(out_fmt, "%.2f")
                    if arg_count > 0 { sb_append_str(out_args, ", ") }
                    sb_append_str(out_args, "(double)(")
                    sb_append_str(out_args, c_expr_str)
                    sb_append_char(out_args, ')')
                    arg_count += 1
                } else if resolved_type == "string" {
                    sb_append_str(out_fmt, "%s")
                    if arg_count > 0 { sb_append_str(out_args, ", ") }
                    sb_append_str(out_args, "(const char*)(")
                    sb_append_str(out_args, c_expr_str)
                    sb_append_char(out_args, ')')
                    arg_count += 1
                } else if resolved_type == "bool" {
                    sb_append_str(out_fmt, "%s")
                    if arg_count > 0 { sb_append_str(out_args, ", ") }
                    sb_append_str(out_args, "((")
                    sb_append_str(out_args, c_expr_str)
                    sb_append_str(out_args, ") ? \"true\" : \"false\")")
                    arg_count += 1
                } else {
                    sb_append_str(out_fmt, "%lld")
                    if arg_count > 0 { sb_append_str(out_args, ", ") }
                    sb_append_str(out_args, "(long long)(")
                    sb_append_str(out_args, c_expr_str)
                    sb_append_char(out_args, ')')
                    arg_count += 1
                }
                idx = close_idx + 1
            } else {
                sb_append_char(out_fmt, c)
                idx += 1
            }
        } else if c == '%' {
            sb_append_str(out_fmt, "%%")
            idx += 1
        } else {
            sb_append_char(out_fmt, c)
            idx += 1
        }
    }
    if arg_count == 0 { return -1 }
    return arg_count
}

// Emits code for a string literal expression, lowering interpolation if present.
act emit_string_expr_ex(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode, on_heap: bool) {
    if expr == null or expr.str_val == null { sb_append_str(sb, "\"\""); return }
    let raw = expr.str_val
    mut fmt_sb = create_sb(str.len(raw) + 32)
    mut args_sb = create_sb(str.len(raw) * 2 + 32)
    let n = build_interp_fmt_and_args(st, raw, expr.line, expr.col, @fmt_sb, @args_sb)
    if n < 0 {
        sb_append_char(sb, '"'); sb_append_str(sb, raw); sb_append_char(sb, '"')
        return
    }
    if on_heap {
        sb_append_str(sb, "velo_str_heap_format(\"")
    } else {
        sb_append_str(sb, "velo_str_format(\"")
    }
    sb_append_str(sb, sb_to_string(@fmt_sb))
    sb_append_char(sb, '"')
    if n > 0 {
        sb_append_str(sb, ", ")
        sb_append_str(sb, sb_to_string(@args_sb))
    }
    sb_append_char(sb, ')')
}

act emit_string_expr(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    emit_string_expr_ex(sb, st, expr, false)
}

// Emits code for sys.str library calls.
act emit_str_call(sb: @StringBuilder, st: @SymbolTable, member: string, expr: @ExprNode) {
    if member == "len" {
        sb_append_str(sb, "((usize)strlen(")
        emit_c_expr(sb, st, expr.first_arg)
        sb_append_str(sb, "))")
        return
    }
    if member == "format" or member == "heap_format" {
        let is_heap = (member == "heap_format")
        if expr.first_arg != null and expr.first_arg.next == null {
            if expr.first_arg.kind == EXPR_STRING {
                emit_string_expr_ex(sb, st, expr.first_arg, is_heap)
                return
            }
            if is_heap {
                sb_append_str(sb, "velo_str_heap_format(\"%s\", (const char*)(")
            } else {
                sb_append_str(sb, "velo_str_format(\"%s\", (const char*)(")
            }
            emit_c_expr(sb, st, expr.first_arg)
            sb_append_str(sb, "))")
            return
        }
    }
    sb_append_str(sb, "velo_str_"); sb_append_str(sb, member); sb_append_char(sb, '(')
    mut a = expr.first_arg
    loop a != null {
        emit_c_expr(sb, st, a)
        if a.next != null { sb_append_str(sb, ", ") }
        a = a.next
    }
    sb_append_char(sb, ')')
}
