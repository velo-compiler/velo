// C99 compile-time struct reflection code generator (field_count, field_name, field_type).
use sys.io
use sys.mem
use "../ast/types.vl"
use "../ast/expr.vl"
use "../analysis/symbol_table.vl"
use "../analysis/reflect_checks.vl"
use "../common/string_builder.vl"
use "codegen_expr.vl"

act emit_reflect_call(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    if expr == null or expr.callee == null { return }
    let fn_name = expr.callee.str_val
    let tname = extract_type_arg_name(expr.first_arg)
    if tname == null { return }
    let st_sym = find_struct(st, tname)
    if st_sym == null { return }

    if fn_name == "field_count" {
        sb_append_int(sb, st_sym.field_count as i64)
        return
    }

    let idx_node = expr.first_arg.next
    if idx_node == null { return }

    mut const_val: i64 = 0
    let is_const = get_reflect_const_int(idx_node, @const_val)

    if is_const {
        if const_val < 0 or (const_val as usize) >= st_sym.field_count {
            sb_append_str(sb, "\"\"")
            return
        }
        mut cur_f = st_sym.first_field
        mut fi: usize = 0
        loop fi < (const_val as usize) and cur_f != null {
            cur_f = cur_f.next
            fi += 1
        }
        if cur_f != null {
            sb_append_char(sb, '"')
            if fn_name == "field_name" {
                sb_append_str(sb, cur_f.name)
            } else {
                sb_append_str(sb, cur_f.type_name)
            }
            sb_append_char(sb, '"')
        } else {
            sb_append_str(sb, "\"\"")
        }
        return
    }

    if st_sym.field_count == 0 {
        sb_append_str(sb, "\"\"")
        return
    }

    sb_append_str(sb, "((const char*[]){ ")
    mut cur_f = st_sym.first_field
    loop cur_f != null {
        sb_append_char(sb, '"')
        if fn_name == "field_name" {
            sb_append_str(sb, cur_f.name)
        } else {
            sb_append_str(sb, cur_f.type_name)
        }
        sb_append_char(sb, '"')
        if cur_f.next != null {
            sb_append_str(sb, ", ")
        }
        cur_f = cur_f.next
    }
    sb_append_str(sb, " })[(int)(")
    emit_c_expr(sb, st, idx_node)
    sb_append_str(sb, ")]")
}
