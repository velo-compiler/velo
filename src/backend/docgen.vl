// Markdown API documentation generator for Velo source modules.
use std.io
use std.fs
use std.mem
use "../frontend/token.vl"
use "../frontend/lexer.vl"
use "../frontend/parser.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../common/string_builder.vl"
use "../common/utils.vl"
use "doc_comments.vl"
use "docgen_json.vl"

// Generates complete GitHub-flavored Markdown API documentation from an AST program.
act generate_markdown_docs(filename: string, source: string, prog: @ProgramNode) -> string {
    mut sb = create_sb(4096)

    sb_append_str(@sb, "# API Reference: `")
    sb_append_str(@sb, filename)
    sb_append_str(@sb, "`\n\n")

    // 1. Structs / Data types
    mut has_structs = false
    mut cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_DATA {
            has_structs = true
        }
        cur = cur.next
    }

    if has_structs {
        sb_append_str(@sb, "## Data Structures\n\n")
        cur = prog.first_decl
        loop cur != null {
            if cur.kind == DECL_DATA {
                sb_append_str(@sb, "### `data ")
                sb_append_str(@sb, cur.name)
                sb_append_str(@sb, "`\n\n")

                let doc = extract_doc_comment(source, cur.line)
                if str.len(doc) > 0 {
                    sb_append_str(@sb, "> ")
                    sb_append_str(@sb, doc)
                    sb_append_str(@sb, "\n\n")
                }

                sb_append_str(@sb, "| Field | Type |\n")
                sb_append_str(@sb, "| :--- | :--- |\n")
                mut cur_f = cur.first_field
                loop cur_f != null {
                    sb_append_str(@sb, "| `")
                    sb_append_str(@sb, cur_f.name)
                    sb_append_str(@sb, "` | `")
                    sb_append_str(@sb, cur_f.type_name)
                    sb_append_str(@sb, "` |\n")
                    cur_f = cur_f.next
                }
                sb_append_str(@sb, "\n")
            }
            cur = cur.next
        }
    }

    // 2. Functions
    mut has_functions = false
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_FUNCTION and cur.name != "main" {
            has_functions = true
        }
        cur = cur.next
    }

    if has_functions {
        sb_append_str(@sb, "## Functions\n\n")
        cur = prog.first_decl
        loop cur != null {
            if cur.kind == DECL_FUNCTION and cur.name != "main" {
                sb_append_str(@sb, "### `act ")
                sb_append_str(@sb, cur.name)
                sb_append_char(@sb, '(')
                mut cur_p = cur.first_param
                loop cur_p != null {
                    sb_append_str(@sb, cur_p.name)
                    sb_append_str(@sb, ": ")
                    sb_append_str(@sb, cur_p.type_name)
                    if cur_p.next != null {
                        sb_append_str(@sb, ", ")
                    }
                    cur_p = cur_p.next
                }
                sb_append_str(@sb, ") -> ")
                sb_append_str(@sb, cur.return_type)
                sb_append_str(@sb, "`\n\n")

                let doc = extract_doc_comment(source, cur.line)
                if str.len(doc) > 0 {
                    sb_append_str(@sb, "> ")
                    sb_append_str(@sb, doc)
                    sb_append_str(@sb, "\n\n")
                }
            }
            cur = cur.next
        }
    }

    // 3. Extern Declarations
    mut has_externs = false
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_EXTERN {
            has_externs = true
        }
        cur = cur.next
    }

    if has_externs {
        sb_append_str(@sb, "## External C Interfaces\n\n")
        cur = prog.first_decl
        loop cur != null {
            if cur.kind == DECL_EXTERN {
                sb_append_str(@sb, "* `extern act ")
                sb_append_str(@sb, cur.name)
                sb_append_char(@sb, '(')
                mut cur_p = cur.first_param
                loop cur_p != null {
                    sb_append_str(@sb, cur_p.name)
                    sb_append_str(@sb, ": ")
                    sb_append_str(@sb, cur_p.type_name)
                    if cur_p.next != null {
                        sb_append_str(@sb, ", ")
                    }
                    cur_p = cur_p.next
                }
                sb_append_str(@sb, ") -> ")
                sb_append_str(@sb, cur.return_type)
                sb_append_str(@sb, "`\n")
            }
            cur = cur.next
        }
        sb_append_str(@sb, "\n")
    }

    return sb_to_string(@sb)
}

// Generates Markdown or structured JSON documentation for a Velo source file.
act generate_docs_for_source_all_opts(source_path: string, json_mode: bool) -> string {
    let source = fs_read_to_str(source_path)
    if source == null {
        println_str("[Velo Error] Failed to read source file: {source_path}")
        return null
    }
    defer heap_free_str(source)

    let slen = str.len(source)
    mut lex = create_lexer(source, slen, slen + 2)
    lex.file_path = source_path
    tokenize(@lex)

    if lex.dropped_count > 0 {
        let dropped = lex.dropped_count
        println_str("[Velo Error] {source_path}: lexer token buffer too small; {dropped} tokens were truncated; documentation output would be incomplete.")
        return null
    }

    mut p: Parser
    init_parser(@p, source_path, source, lex.tokens, lex.token_count)
    let prog = parse_program(@p)
    if prog == null {
        return null
    }

    if json_mode {
        return generate_json_docs(source_path, source, prog)
    }
    return generate_markdown_docs(source_path, source, prog)
}

act generate_docs_for_source(source_path: string) -> string {
    return generate_docs_for_source_all_opts(source_path, false)
}
