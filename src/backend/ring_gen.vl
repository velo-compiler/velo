// ============================================================================
// 5.2 slice 9 — ring[T] C99 emission (the runtime VeloRing engine; the C
// text matches velo/codegen_c.py's S9 branches byte for byte). Semantic
// checks (families, mut doctrine, arity) already ran in the checker.
// ============================================================================
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../analysis/shelf_checks.vl"
use "../analysis/misc_checks.vl"
use "../common/string_builder.vl"
use "../common/act_types.vl"
use "codegen_types.vl"
use "codegen_expr.vl"
use "codegen_stmt.vl"
use "shelf_gen.vl"
use "bitset_gen.vl"

// The receiver contract (the map recv doctrine): @-pointer receivers pass
// their own pointer (the first C parameter is `VeloRing*` either way); value
// receivers take &.
act emit_ring_recv(sb: @StringBuilder, st: @SymbolTable, recv: @ExprNode) {
    let recv_t = infer_expr_type(st, recv)
    if str.len(recv_t) > 0 and recv_t[0] == '@' {
        sb_append_str(sb, "(")
        emit_c_expr(sb, st, recv)
        sb_append_str(sb, ")")
    } else {
        sb_append_str(sb, "&(")
        emit_c_expr(sb, st, recv)
        sb_append_str(sb, ")")
    }
}

// 5.2 slice 9: lowers `ring[...]` — a fresh VeloRing header plus one typed
// slot per element (left-to-right evaluation order guaranteed).
act emit_ring_literal(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    mut elem = expr.type_name
    if elem == null or str.len(elem) == 0 {
        if expr.first_arg != null {
            elem = infer_expr_type(st, expr.first_arg)
        } else {
            elem = "i64"
        }
    }
    let elem_c = map_type_to_c(elem)
    if expr.first_arg == null {
        sb_append_str(sb, "velo_ring_create_empty((usize)sizeof(")
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "))")
        return
    }
    mut count = 0
    mut cur = expr.first_arg
    loop cur != null {
        count += 1
        cur = cur.next
    }
    sb_append_str(sb, "velo_ring_create_lit((usize)sizeof(")
    sb_append_str(sb, elem_c)
    sb_append_str(sb, "), ")
    sb_append_int(sb, count)
    sb_append_str(sb, ", (")
    if not str.starts_with(elem_c, "const ") {
        sb_append_str(sb, "const ")
    }
    sb_append_str(sb, elem_c)
    sb_append_str(sb, "[]){ ")
    cur = expr.first_arg
    mut first = true
    loop cur != null {
        if not first { sb_append_str(sb, ", ") }
        first = false
        sb_append_char(sb, '(')
        emit_c_expr(sb, st, cur)
        sb_append_char(sb, ')')
        cur = cur.next
    }
    sb_append_str(sb, " })")
}

// Member calls: put void / pop value (copies out FIRST, then the head
// advances — the take discipline) / peek value (read tier).
act emit_ring_call(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    let member = expr.callee.member_name
    let recv_t = infer_expr_type(st, expr.callee.target)
    let elem = ring_elem_type(recv_t)
    let elem_c = map_type_to_c(elem)
    if member == "put" {
        sb_append_str(sb, "velo_ring_put(")
        emit_ring_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ", &(")
        if not str.starts_with(elem_c, "const ") {
            sb_append_str(sb, "const ")
        }
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "){ ")
        emit_c_expr(sb, st, expr.first_arg)
        sb_append_str(sb, " }, (usize)sizeof(")
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "))")
        return
    }
    if member == "pop" {
        sb_append_str(sb, "(*((")
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "*)velo_ring_pop_ref(")
        emit_ring_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ", (usize)sizeof(")
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "))))")
        return
    }
    if member == "peek" {
        sb_append_str(sb, "(*((const ")
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "*)velo_ring_peek_ref(")
        emit_ring_recv(sb, st, expr.callee.target)
        sb_append_str(sb, ", (usize)sizeof(")
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "))))")
        return
    }
}

// 5.2 slice 9: `loop v of r { }` — FIFO snapshot: at entry the live
// elements are copied front-to-back into a fresh element-typed arena array;
// put/pop during the body mutate the live ring, never the view. The
// optional second binding names the usize step index; empty ring → no trips.
act emit_ring_loop(sb: @StringBuilder, st: @SymbolTable, stmt: @StmtNode, indent: i32, defers: @@DeferNode) {
    let coll_t = infer_expr_type(st, stmt.expr)
    let elem = ring_elem_type(coll_t)
    let elem_c = map_type_to_c(elem)
    let src = shelf_fresh_name(st, "lsrc_")
    let cnt = shelf_fresh_name(st, "lcnt_")
    let idx = shelf_fresh_name(st, "lidx_")
    let dat = shelf_fresh_name(st, "ldat_")
    let run = shelf_fresh_name(st, "lrun_")
    mut vname = "it"
    if stmt.loop_var != null and str.len(stmt.loop_var) > 0 { vname = stmt.loop_var }
    mut iname = idx  // an explicit second binding names the step index
    if stmt.loop_index != null and str.len(stmt.loop_index) > 0 { iname = stmt.loop_index }
    sb_append_indent(sb, indent)
    sb_append_str(sb, "{ VeloRing ")
    sb_append_str(sb, src)
    sb_append_str(sb, " = ")
    if str.len(coll_t) > 0 and coll_t[0] == '@' { sb_append_str(sb, "*("); emit_c_expr(sb, st, stmt.expr); sb_append_str(sb, ")") } else { emit_c_expr(sb, st, stmt.expr) }  // @-pointers unpack to the stable view header
    sb_append_str(sb, "; const usize ")
    sb_append_str(sb, cnt)
    sb_append_str(sb, " = ")
    sb_append_str(sb, src)
    sb_append_str(sb, ".len; void* ")
    sb_append_str(sb, dat)
    sb_append_str(sb, " = velo_mem_alloc((usize)sizeof(")
    sb_append_str(sb, elem_c)
    sb_append_str(sb, "), ")
    sb_append_str(sb, cnt)
    sb_append_str(sb, "); for (size_t ")
    sb_append_str(sb, run)
    sb_append_str(sb, " = 0; ")
    sb_append_str(sb, run)
    sb_append_str(sb, " < ")
    sb_append_str(sb, cnt)
    sb_append_str(sb, "; ++")
    sb_append_str(sb, run)
    sb_append_str(sb, ") { memcpy((char*)")
    sb_append_str(sb, dat)
    sb_append_str(sb, " + ")
    sb_append_str(sb, run)
    sb_append_str(sb, " * (usize)sizeof(")
    sb_append_str(sb, elem_c)
    sb_append_str(sb, "), (const char*)")
    sb_append_str(sb, src)
    sb_append_str(sb, ".data + (((")
    sb_append_str(sb, src)
    sb_append_str(sb, ".head + ")
    sb_append_str(sb, run)
    sb_append_str(sb, ") & (")
    sb_append_str(sb, src)
    sb_append_str(sb, ".cap - 1)) * (usize)sizeof(")
    sb_append_str(sb, elem_c)
    sb_append_str(sb, ")), (usize)sizeof(")
    sb_append_str(sb, elem_c)
    sb_append_str(sb, ")); }\n")
    enter_scope(st)
    define_variable(st, vname, elem, false, stmt.line, stmt.col)
    if stmt.loop_index != null and str.len(stmt.loop_index) > 0 { define_variable(st, iname, "usize", false, stmt.line, stmt.col) }
    sb_append_indent(sb, indent)
    sb_append_str(sb, "for (usize ")
    sb_append_str(sb, iname)
    sb_append_str(sb, " = 0; ")
    sb_append_str(sb, iname)
    sb_append_str(sb, " < ")
    sb_append_str(sb, cnt)
    sb_append_str(sb, "; ++")
    sb_append_str(sb, iname)
    sb_append_str(sb, ") {\n")
    sb_append_indent(sb, indent + 1)
    sb_append_str(sb, "const ")
    sb_append_str(sb, elem_c)
    sb_append_char(sb, ' ')
    sb_append_str(sb, vname)
    sb_append_str(sb, " = ((")
    sb_append_str(sb, elem_c)
    sb_append_str(sb, "*)")
    sb_append_str(sb, dat)
    sb_append_str(sb, ")[")
    sb_append_str(sb, iname)
    sb_append_str(sb, "];\n")
    st.fresh_counter += 1
    let loop_id = st.fresh_counter
    let loop_prev = push_loop_scope(defers, loop_id)
    emit_c_block_stmts(sb, st, stmt.body, indent + 1, defers)
    pop_loop_scope(defers, loop_prev)
    exit_scope(st)
    sb_append_indent(sb, indent + 1); sb_append_str(sb, "__loop_cont_"); sb_append_int(sb, loop_id as i32); sb_append_str(sb, ": __attribute__((unused));\n")
    sb_append_indent(sb, indent)
    sb_append_str(sb, "}\n")   // for-body close
    sb_append_indent(sb, indent); sb_append_str(sb, "__loop_break_"); sb_append_int(sb, loop_id as i32); sb_append_str(sb, ": __attribute__((unused));\n")
    sb_append_indent(sb, indent)
    sb_append_str(sb, "}\n")   // snapshot view block close
}

// The codegen_expr dispatch twins — one line up there, two arms here.
act emit_coll9_literal(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    if expr.kind == EXPR_RING_LIT { emit_ring_literal(sb, st, expr); return }
    emit_bitset_literal(sb, st, expr)
}

act emit_coll9_call(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    if is_ring_type(infer_expr_type(st, expr.callee.target)) { emit_ring_call(sb, st, expr); return }
    emit_bitset_call(sb, st, expr)
}
