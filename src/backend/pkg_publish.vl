// Package publishing command: 'velo pkg publish' (Phase 72 / Task 72.6).
// Packages declared source files into a tarball, computes SHA-256 digest,
// and outputs the exact JSON entry to paste into index.json for registry publication via pull request.
extern act system(cmd: string) -> i32
extern act velo_host_getenv(key: string) -> string

use std.io
use std.fs
use std.crypto
use "../common/string_builder.vl"
use "../common/utils.vl"
use "../common/manifest.vl"
use "../common/semver.vl"

// Handles 'velo pkg publish [path] [--out <tar>] [--url <url>] [--registry <url>] [--json]'.
act pkg_publish_run(argc: i32, argv: @string) -> i32 {
    mut m_path = ""
    mut out_tar = ""
    mut custom_url = ""
    mut registry_root = ""
    mut json_output = false

    mut i: i32 = 3
    loop i < argc {
        let arg = argv[i]
        if (arg == "-o" or arg == "--out") and i + 1 < argc {
            out_tar = argv[i + 1]
            i += 1
        } else if str.len(arg) > 6 and str.starts_with(arg, "--out=") {
            out_tar = copy_slice_to_string(arg, 6, str.len(arg) - 6)
        } else if arg == "--url" and i + 1 < argc {
            custom_url = argv[i + 1]
            i += 1
        } else if str.len(arg) > 6 and str.starts_with(arg, "--url=") {
            custom_url = copy_slice_to_string(arg, 6, str.len(arg) - 6)
        } else if arg == "--registry" and i + 1 < argc {
            registry_root = argv[i + 1]
            i += 1
        } else if str.len(arg) > 11 and str.starts_with(arg, "--registry=") {
            registry_root = copy_slice_to_string(arg, 11, str.len(arg) - 11)
        } else if arg == "--json" {
            json_output = true
        } else if str.len(m_path) == 0 and not str.starts_with(arg, "--") {
            m_path = arg
        }
        i += 1
    }

    if str.len(m_path) == 0 {
        m_path = "velo.pkg"
    }
    if fs_is_dir(m_path) {
        m_path = path_join_str(m_path, "velo.pkg")
    }

    if not fs_exists(m_path) {
        println_str("[Velo Error] Package manifest not found: " + m_path)
        return 1
    }

    let m = manifest_load(m_path)
    if m.has_error {
        println_str(m.error_msg)
        return 1
    }

    if str.len(m.pkg.name) == 0 {
        println_str("[Velo Error] Package manifest must declare a valid 'name'.")
        return 1
    }
    if str.len(m.pkg.version) == 0 {
        println_str("[Velo Error] Package manifest must declare a valid 'version'.")
        return 1
    }

    let sv = semver_parse(m.pkg.version)
    if not sv.is_valid {
        println_str("[Velo Error] Invalid semver version '" + m.pkg.version + "' in package manifest.")
        return 1
    }

    let m_dir = path_dirname_to_str(m_path)
    mut base_dir = m_dir
    if str.len(base_dir) == 0 {
        base_dir = "."
    }

    let src_path = path_join_str(base_dir, "src")
    let has_src = fs_is_dir(src_path)
    let std_path = path_join_str(base_dir, "std")
    let has_std = fs_is_dir(std_path)
    mut has_entry = false
    if str.len(m.pkg.entry) > 0 {
        let entry_path = path_join_str(base_dir, m.pkg.entry)
        has_entry = fs_exists(entry_path)
    }

    if not has_src and not has_std and not has_entry {
        println_str("[Velo Error] Package contains no declared source files (expected 'src/', 'std/', or entry '" + m.pkg.entry + "').")
        return 1
    }

    if str.len(out_tar) == 0 {
        mut dist_dir = "dist"
        if base_dir != "." {
            dist_dir = path_join_str(base_dir, "dist")
        }
        if not fs_exists(dist_dir) {
            fs_create_dir_all(dist_dir)
        }
        out_tar = path_join_str(dist_dir, m.pkg.name + "-" + m.pkg.version + ".tar.gz")
    }

    let out_dir = path_dirname_to_str(out_tar)
    if str.len(out_dir) > 0 and not fs_exists(out_dir) {
        fs_create_dir_all(out_dir)
    }

    // Assemble tar -czf command
    mut tar_sb = create_sb(512)
    sb_append_str(@tar_sb, "tar -czf ")
    sb_append_str(@tar_sb, quote_path(path_to_native_str(out_tar)))
    sb_append_str(@tar_sb, " -C ")
    sb_append_str(@tar_sb, quote_path(path_to_native_str(base_dir)))
    sb_append_str(@tar_sb, " velo.pkg")
    if has_src {
        sb_append_str(@tar_sb, " src")
    }
    if has_std {
        sb_append_str(@tar_sb, " std")
    }
    if has_entry and not str.starts_with(m.pkg.entry, "src/") and not str.starts_with(m.pkg.entry, "src\\") and not str.starts_with(m.pkg.entry, "std/") and not str.starts_with(m.pkg.entry, "std\\") {
        sb_append_char(@tar_sb, ' ')
        sb_append_str(@tar_sb, quote_path(m.pkg.entry))
    }

    let tar_cmd = sb_to_string(@tar_sb)
    let rc = system(tar_cmd)
    if rc != 0 or not fs_exists(out_tar) {
        println_str("[Velo Error] Failed to create tarball archive for package '" + m.pkg.name + "'.")
        return 1
    }

    mut tar_len: usize = 0
    let tar_bytes = fs_read_bytes(out_tar, @tar_len)
    if tar_bytes == null or tar_len == 0 {
        println_str("[Velo Error] Generated tarball is empty.")
        return 1
    }

    let archive_sha = sha256_hash(tar_bytes, tar_len)

    mut archive_url = custom_url
    if str.len(archive_url) == 0 {
        if str.len(registry_root) == 0 {
            let env_reg = velo_host_getenv("VELO_REGISTRY")
            if str.len(env_reg) > 0 {
                registry_root = env_reg
            } else {
                registry_root = "https://pkg.velolang.org"
            }
        }
        archive_url = registry_root + "/tarballs/" + m.pkg.name + "-" + m.pkg.version + ".tar.gz"
    }

    if json_output {
        println_str("{")
        println_str("  \"name\": \"" + m.pkg.name + "\",")
        println_str("  \"version\": \"" + m.pkg.version + "\",")
        println_str("  \"archive\": \"" + out_tar + "\",")
        println_str("  \"url\": \"" + archive_url + "\",")
        println_str("  \"sha256\": \"" + archive_sha + "\"")
        println_str("}")
    } else {
        println_str("[Velo] Successfully packaged '" + m.pkg.name + "' v" + m.pkg.version)
        println_str("  Archive: " + out_tar)
        println_str("  SHA-256: " + archive_sha)
        println_str("")
        println_str("Paste this entry into " + m.pkg.name + "/index.json under \"versions\":")
        println_str("    \"" + m.pkg.version + "\": {")
        println_str("      \"url\": \"" + archive_url + "\",")
        println_str("      \"sha256\": \"" + archive_sha + "\"")
        println_str("    }")
        println_str("")
        println_str("Submit a Pull Request to your registry repository to publish this release.")
    }

    return 0
}
