extern act system(cmd: string) -> i32
act os_system(cmd: string) -> i32 { return system(cmd) }
// Execution, build, and test running orchestration for the compiler driver.
use std.io
use std.fs
use std.mem
use "../common/string_builder.vl"
use "../common/utils.vl"
use "driver_cc.vl"
use "driver.vl"
use "driver_cache.vl"

// Builds a native executable from a Velo source file by compiling to C and invoking the C compiler backend.
// Content-hashes the build cache: keys .velo_cache artifacts by SHA-256 of the fully resolved source closure,
// compiler version, and flags (Task 79.3 / Security Invariant I79.2).
act build_executable_all_opts(source_path: string, output_exe: string, unsafe_index: bool, opt_flags: string, linker_flags: string, cc: string, no_line_directives: bool, strict_safety: bool) -> bool {
    let stem = path_stem_to_str(source_path)
    let hash = compute_source_closure_hash(source_path, opt_flags, linker_flags, cc, unsafe_index, no_line_directives, strict_safety, false)
    if str.len(hash) == 0 {
        return false
    }

    let cached_exe = make_cached_exe_path(stem, hash, false)
    let cached_c = make_cached_c_path(stem, hash, false)

    mut out_path = output_exe
    if out_path == null or str.len(out_path) == 0 {
        mut out_sb = create_sb(128)
        sb_append_str(@out_sb, ".velo_cache/")
        sb_append_str(@out_sb, stem)
        sb_append_str(@out_sb, ".exe")
        out_path = sb_to_string(@out_sb)
    }

    // Cache hit: executable artifact already exists for this exact source closure and flag set
    if fs_exists(cached_exe) {
        record_cache_action("cache_hit", stem, hash)
        if out_path != cached_exe {
            let out_dir = path_dirname_to_str(out_path)
            if out_dir != null and str.len(out_dir) > 0 and not fs_exists(out_dir) {
                fs_create_dir_all(out_dir)
            }
            fs_copy_file_str(cached_exe, out_path, true)
        }
        return true
    }

    // Cache miss: compile to C and invoke backend C compiler
    record_cache_action("recompile", stem, hash)
    let c_code = compile_source_to_c_strict(source_path, unsafe_index, no_line_directives, strict_safety)
    if c_code == null {
        return false
    }

    fs_write_str(cached_c, c_code)

    let cmd = assemble_compiler_cmd(cc, cached_c, cached_exe, opt_flags, linker_flags)
    let res = os_system(cmd)
    if res != 0 {
        println_str("[Velo Error] {cc} compilation failed with exit code {res}")
        return false
    }

    if not fs_exists(cached_exe) {
        return false
    }

    if out_path != cached_exe {
        let out_dir = path_dirname_to_str(out_path)
        if out_dir != null and str.len(out_dir) > 0 and not fs_exists(out_dir) {
            fs_create_dir_all(out_dir)
        }
        fs_copy_file_str(cached_exe, out_path, true)
    }

    return fs_exists(out_path)
}

act build_executable_opts(source_path: string, output_exe: string, unsafe_index: bool, opt_flags: string, linker_flags: string, cc: string, no_line_directives: bool) -> bool {
    return build_executable_all_opts(source_path, output_exe, unsafe_index, opt_flags, linker_flags, cc, no_line_directives, false)
}

act build_executable(source_path: string, output_exe: string, unsafe_index: bool, opt_flags: string, linker_flags: string, cc: string) -> bool {
    return build_executable_opts(source_path, output_exe, unsafe_index, opt_flags, linker_flags, cc, false)
}

// Compiles and runs a Velo source file.
act run_source_file_all_opts(source_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, cc: string, no_line_directives: bool, strict_safety: bool) -> i32 {
    let stem = path_stem_to_str(source_path)
    let hash = compute_source_closure_hash(source_path, opt_flags, linker_flags, cc, unsafe_index, no_line_directives, strict_safety, false)
    if str.len(hash) == 0 {
        return 1
    }

    let cached_exe = make_cached_exe_path(stem, hash, false)
    if fs_exists(cached_exe) {
        record_cache_action("cache_hit", stem, hash)
        let run_cmd = assemble_runner_cmd(cc, cached_exe, null)
        return os_system(run_cmd)
    }

    let ok = build_executable_all_opts(source_path, cached_exe, unsafe_index, opt_flags, linker_flags, cc, no_line_directives, strict_safety)
    if not ok {
        return 1
    }

    let run_cmd = assemble_runner_cmd(cc, cached_exe, null)
    return os_system(run_cmd)
}

act run_source_file_opts(source_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, cc: string, no_line_directives: bool) -> i32 {
    return run_source_file_all_opts(source_path, unsafe_index, opt_flags, linker_flags, cc, no_line_directives, false)
}

act run_source_file(source_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, cc: string) -> i32 {
    return run_source_file_opts(source_path, unsafe_index, opt_flags, linker_flags, cc, false)
}

// Compiles and runs tests in a single Velo source file.
act test_source_file_opts(source_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, filter_arg: string, cc: string, no_line_directives: bool) -> i32 {
    let stem = path_stem_to_str(source_path)
    let hash = compute_source_closure_hash(source_path, opt_flags, linker_flags, cc, unsafe_index, no_line_directives, false, true)
    if str.len(hash) == 0 {
        return 1
    }

    let cached_exe = make_cached_exe_path(stem, hash, true)
    let cached_c = make_cached_c_path(stem, hash, true)

    if fs_exists(cached_exe) {
        record_cache_action("cache_hit", stem, hash)
        mut extra_sb = create_sb(64)
        if filter_arg != null and str.len(filter_arg) > 0 {
            sb_append_str(@extra_sb, "--filter ")
            sb_append_str(@extra_sb, filter_arg)
        }
        let run_cmd = assemble_runner_cmd(cc, cached_exe, sb_to_string(@extra_sb))
        return os_system(run_cmd)
    }

    record_cache_action("recompile", stem, hash)
    let c_code = compile_source_to_c_test_opts(source_path, unsafe_index, true, no_line_directives)
    if c_code == null { return 1 }

    fs_write_str(cached_c, c_code)

    let cmd = assemble_compiler_cmd(cc, cached_c, cached_exe, opt_flags, linker_flags)
    let res = os_system(cmd)
    if res != 0 {
        println_str("[Velo Error] {cc} compilation failed with exit code {res}")
        return 1
    }

    mut extra_sb = create_sb(64)
    if filter_arg != null and str.len(filter_arg) > 0 {
        sb_append_str(@extra_sb, "--filter ")
        sb_append_str(@extra_sb, filter_arg)
    }
    let run_cmd = assemble_runner_cmd(cc, cached_exe, sb_to_string(@extra_sb))
    return os_system(run_cmd)
}

act test_source_file(source_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, filter_arg: string, cc: string) -> i32 {
    return test_source_file_opts(source_path, unsafe_index, opt_flags, linker_flags, filter_arg, cc, false)
}

// Runs tests on a file or all .vl test files within a directory.
act test_target_opts(target_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, filter_arg: string, cc: string, no_line_directives: bool) -> i32 {
    if fs_is_file(target_path) {
        return test_source_file_opts(target_path, unsafe_index, opt_flags, linker_flags, filter_arg, cc, no_line_directives)
    }
    if fs_is_dir(target_path) {
        mut iter = fs_dir_open(target_path)
        mut overall: i32 = 0
        mut found = false
        if iter.has_current {
            mut has_more = true
            loop has_more {
                let e = fs_dir_entry(@iter)
                if entry_is_file(e) {
                    let entry_ptr = entry_name_cstr(e)
                    let entry = entry_ptr as string
                    let elen = str.len(entry)
                    if elen > 3 and entry[elen - 3] == '.' and entry[elen - 2] == 'v' and entry[elen - 1] == 'l' {
                        mut path_sb = create_sb(256)
                        sb_append_str(@path_sb, target_path); sb_append_char(@path_sb, '/'); sb_append_str(@path_sb, entry)
                        let full_path = sb_to_string(@path_sb)
                        let content = fs_read_to_str(full_path)
                        if content != null {
                            if str.contains(content, "test \"") or str.contains(content, "test '") {
                                found = true
                                let rc = test_source_file_opts(full_path, unsafe_index, opt_flags, linker_flags, filter_arg, cc, no_line_directives)
                                if rc != 0 { overall = rc }
                            }
                            heap_free_str(content)
                        }
                    }
                }
                has_more = fs_dir_next(@iter)
            }
        }
        fs_dir_close(@iter)
        if not found { println_str("No test files found in directory."); return 0 }
        return overall
    }
    println_str("[Velo Error] Target path not found: {target_path}")
    return 1
}

act test_target(target_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, filter_arg: string, cc: string) -> i32 {
    return test_target_opts(target_path, unsafe_index, opt_flags, linker_flags, filter_arg, cc, false)
}

