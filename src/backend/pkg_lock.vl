// Package Lockfile (velo.lock) Data Model, Serializer, Parser, and Checksum Verifier.
use std.io
use std.fs
use std.crypto
use "../common/string_builder.vl"
use "../common/utils.vl"
use "../common/manifest.vl"

data LockEntry {
    name: string
    source: string
    version: string
    hash: string
    next: @LockEntry
}

data LockFile {
    first: @LockEntry
    count: i32
    has_error: bool
    error_msg: string
}

act create_empty_lockfile() -> LockFile {
    return LockFile{
        first: null,
        count: 0,
        has_error: false,
        error_msg: ""
    }
}

act lockfile_find(lock: @LockFile, name: string) -> @LockEntry {
    if lock == null { return null }
    mut cur = lock.first
    loop cur != null {
        if cur.name == name { return cur }
        cur = cur.next
    }
    return null
}

act lockfile_add_entry(lock: @LockFile, name: string, source: string, version: string, hash: string) {
    mut entry: @LockEntry = mem.alloc(@LockEntry, 1)
    entry.name = name
    entry.source = source
    entry.version = version
    entry.hash = hash
    entry.next = null

    if lock.first == null {
        lock.first = entry
    } else {
        mut cur = lock.first
        loop cur.next != null {
            cur = cur.next
        }
        cur.next = entry
    }
    lock.count += 1
}

// Computes cryptographic SHA-256 hash for a dependency source or files.
act compute_dep_hash(m_dir: string, dep: @DependencySpec) -> string {
    mut target_path = dep.source
    if dep.kind == "git" or dep.kind == "registry" {
        mut deps_parent = ".velo_cache/deps"
        if m_dir != null and str.len(m_dir) > 0 and m_dir != "." {
            deps_parent = path_join_str(m_dir, ".velo_cache/deps")
        }
        let cached_path = path_join_str(deps_parent, dep.name)
        if fs_exists(cached_path) {
            target_path = cached_path
        }
    } else if dep.kind == "local" and not (str.starts_with(dep.source, "/") or (str.len(dep.source) > 2 and dep.source[1] == ':')) {
        target_path = path_join_str(m_dir, dep.source)
    }

    mut hash_hex = ""
    if fs_exists(target_path) {
        if fs_is_file(target_path) {
            let content = fs_read_to_str(target_path)
            if content != null {
                hash_hex = sha256_hash_str(content)
            }
        } else if fs_is_dir(target_path) {
            let pkg_file = path_join_str(target_path, "velo.pkg")
            let main_file = path_join_str(target_path, "main.vl")
            let src_main = path_join_str(target_path, "src/main.vl")
            mut combined_sb = create_sb(1024)
            if fs_is_file(pkg_file) {
                let content = fs_read_to_str(pkg_file)
                if content != null { sb_append_str(@combined_sb, content) }
            }
            if fs_is_file(main_file) {
                let content = fs_read_to_str(main_file)
                if content != null { sb_append_str(@combined_sb, content) }
            }
            if fs_is_file(src_main) {
                let content = fs_read_to_str(src_main)
                if content != null { sb_append_str(@combined_sb, content) }
            }
            if combined_sb.len > 0 {
                hash_hex = sha256_hash_str(sb_to_string(@combined_sb))
            }
        }
    }

    if str.len(hash_hex) == 0 {
        mut seed_sb = create_sb(128)
        sb_append_str(@seed_sb, dep.name)
        sb_append_char(@seed_sb, ':')
        sb_append_str(@seed_sb, dep.kind)
        sb_append_char(@seed_sb, ':')
        sb_append_str(@seed_sb, dep.source)
        if str.len(dep.tag) > 0 {
            sb_append_char(@seed_sb, '@')
            sb_append_str(@seed_sb, dep.tag)
        }
        hash_hex = sha256_hash_str(sb_to_string(@seed_sb))
    }

    mut res_sb = create_sb(80)
    sb_append_str(@res_sb, "sha256:")
    sb_append_str(@res_sb, hash_hex)
    return sb_to_string(@res_sb)
}

act lockfile_serialize(lock: @LockFile) -> string {
    mut sb = create_sb(1024)
    sb_append_str(@sb, "# Generated by Velo Package Manager (velo.lock). DO NOT EDIT MANUALLY.\n")
    sb_append_str(@sb, "# This lockfile preserves exact dependency cryptographic hashes for supply chain integrity.\n\n")

    mut cur = lock.first
    loop cur != null {
        sb_append_str(@sb, "package \"")
        sb_append_str(@sb, cur.name)
        sb_append_str(@sb, "\" = { source = \"")
        sb_append_str(@sb, cur.source)
        sb_append_str(@sb, "\", version = \"")
        sb_append_str(@sb, cur.version)
        sb_append_str(@sb, "\", hash = \"")
        sb_append_str(@sb, cur.hash)
        sb_append_str(@sb, "\" }\n")
        cur = cur.next
    }
    return sb_to_string(@sb)
}

act extract_quoted_string(s: string, start_idx: usize, out_end: @usize) -> string {
    let slen = str.len(s)
    mut i = start_idx
    loop i < slen and s[i] != '"' {
        i += 1
    }
    if i >= slen {
        out_end[0] = slen
        return ""
    }
    i += 1
    let q_start = i
    loop i < slen and s[i] != '"' {
        if s[i] == '\\' and i + 1 < slen { i += 1 }
        i += 1
    }
    let res = copy_slice_to_string(s, q_start, i - q_start)
    if i < slen { i += 1 }
    out_end[0] = i
    return res
}

act extract_field_value(s: string, key: string) -> string {
    let slen = str.len(s)
    let klen = str.len(key)
    mut i: usize = 0
    loop i + klen <= slen {
        mut match = true
        mut j: usize = 0
        loop j < klen {
            if s[i + j] != key[j] { match = false; break }
            j += 1
        }
        if match {
            mut p = i + klen
            loop p < slen and (s[p] == ' ' or s[p] == '=' or s[p] == ':') {
                p += 1
            }
            if p < slen and s[p] == '"' {
                mut end_idx: usize = 0
                return extract_quoted_string(s, p, @end_idx)
            }
        }
        i += 1
    }
    return ""
}

act lockfile_parse(source: string, filename: string) -> LockFile {
    mut lock = create_empty_lockfile()
    if source == null or str.len(source) == 0 {
        return lock
    }
    let slen = str.len(source)
    mut line_start: usize = 0
    loop line_start < slen {
        mut line_end = line_start
        loop line_end < slen and source[line_end] != '\n' {
            line_end += 1
        }
        let line = copy_slice_to_string(source, line_start, line_end - line_start)
        line_start = line_end + 1

        mut p: usize = 0
        let llen = str.len(line)
        loop p < llen and (line[p] == ' ' or line[p] == '\t' or line[p] == '\r') {
            p += 1
        }
        if p >= llen or line[p] == '#' or (p + 1 < llen and line[p] == '/' and line[p + 1] == '/') {
            // comment or blank line
        } else if str.starts_with(line, "package") {
            mut q_end: usize = 0
            let pkg_name = extract_quoted_string(line, 7, @q_end)
            let src_val = extract_field_value(line, "source")
            let ver_val = extract_field_value(line, "version")
            let hash_val = extract_field_value(line, "hash")
            if str.len(pkg_name) > 0 {
                lockfile_add_entry(@lock, pkg_name, src_val, ver_val, hash_val)
            }
        }
    }
    return lock
}

act lockfile_load(lock_path: string) -> LockFile {
    mut lock = create_empty_lockfile()
    if not fs_exists(lock_path) {
        lock.has_error = true
        lock.error_msg = "[Velo Error] Lockfile not found: " + lock_path
        return lock
    }
    let content = fs_read_to_str(lock_path)
    if content == null {
        lock.has_error = true
        lock.error_msg = "[Velo Error] Failed to read lockfile: " + lock_path
        return lock
    }
    return lockfile_parse(content, lock_path)
}

act resolve_installed_dep_version(m_dir: string, dep: @DependencySpec) -> string {
    if str.len(dep.tag) > 0 { return dep.tag }
    mut deps_parent = ".velo_cache/deps"
    if m_dir != null and str.len(m_dir) > 0 and m_dir != "." {
        deps_parent = path_join_str(m_dir, ".velo_cache/deps")
    }
    let dep_dir = path_join_str(deps_parent, dep.name)
    let pkg_file = path_join_str(dep_dir, "velo.pkg")
    if fs_exists(pkg_file) {
        let dep_m = manifest_load(pkg_file)
        if not dep_m.has_error and str.len(dep_m.pkg.version) > 0 {
            return dep_m.pkg.version
        }
    }
    return dep.source
}

act generate_lockfile_from_manifest(m: @PackageManifest, m_dir: string) -> LockFile {
    mut lock = create_empty_lockfile()
    mut cur = m.first_dep
    loop cur != null {
        let h = compute_dep_hash(m_dir, cur)
        let v = resolve_installed_dep_version(m_dir, cur)
        lockfile_add_entry(@lock, cur.name, cur.source, v, h)
        cur = cur.next
    }
    return lock
}

act verify_lockfile_integrity(m: @PackageManifest, m_dir: string, lock: @LockFile) -> bool {
    mut cur = m.first_dep
    loop cur != null {
        let entry = lockfile_find(lock, cur.name)
        if entry == null {
            println_str("[Velo Error] Dependency '{cur.name}' is missing from velo.lock. Run 'velo pkg lock' to update lockfile.")
            return false
        }
        let actual_hash = compute_dep_hash(m_dir, cur)
        if actual_hash != entry.hash {
            println_str("[Velo Error] Package checksum verification failed for '{cur.name}'.")
            println_str("  Expected: {entry.hash}")
            println_str("  Actual:   {actual_hash}")
            println_str("  Package contents may have been tampered with or modified.")
            return false
        }
        cur = cur.next
    }
    return true
}
