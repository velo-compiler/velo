// ============================================================================
// 5.4 Extended File System Primitives — sys.fs call lowering forwarder.
// Consolidates behind intrinsic_emitter.vl (Task 80.4).
// ============================================================================
use "../ast/expr.vl"
use "../analysis/symbol_table.vl"
use "../common/string_builder.vl"
use "intrinsic_emitter.vl"

act emit_fs_call(sb: @StringBuilder, st: @SymbolTable, member: string, expr: @ExprNode) {
    emit_intrinsic_call(sb, st, "fs", member, expr)
}
