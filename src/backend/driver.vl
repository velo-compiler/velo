// Foreign C system() execution interface
extern act system(command: string) -> i32

// Linked list tracking visited files to prevent circular or duplicate module parsing.
data VisitedFile {
    path: string
    next: @VisitedFile
}

// Driver state maintaining module resolution and compiler options.
data CompilerDriver {
    first_visited: @VisitedFile
    error_count: usize
    first_decl: @StmtNode
    last_decl: @StmtNode
    total_decls: usize
}

// Initializes a CompilerDriver instance.
act init_driver(d: @CompilerDriver) {
    d.first_visited = null
    d.error_count = 0
    d.first_decl = null
    d.last_decl = null
    d.total_decls = 0
}

// Checks if a module path has already been parsed.
act is_file_visited(d: @CompilerDriver, path: string) -> bool {
    mut cur = d.first_visited
    loop cur != null {
        if cur.path == path {
            return true
        }
        cur = cur.next
    }
    return false
}

// Marks a module path as visited.
act mark_file_visited(d: @CompilerDriver, path: string) {
    mut vf: @VisitedFile = mem.alloc(@VisitedFile, 1)
    vf.path = path
    vf.next = d.first_visited
    d.first_visited = vf
}

// Recursively loads a file and its imported dependencies in topological order.
act load_file_and_deps(d: @CompilerDriver, raw_path: string) {
    let file_path = canonicalize_path(raw_path)
    if is_file_visited(d, file_path) {
        return
    }
    mark_file_visited(d, file_path)

    if not fs.exists(file_path) {
        io.println("[Velo Error] Source file does not exist: {file_path}")
        d.error_count += 1
        return
    }

    let source = fs.read_file(file_path)
    if source == null {
        io.println("[Velo Error] Failed to read source file: {file_path}")
        d.error_count += 1
        return
    }
    defer mem.free(source)

    let slen = str.len(source)
    // Capacity must cover the absolute worst case: one token per source
    // character, plus EOF. A fixed cap silently truncates large files.
    mut lex = create_lexer(source, slen, slen + 2)
    lex.file_path = file_path
    tokenize(@lex)

    if lex.dropped_count > 0 {
        let dropped = lex.dropped_count
        io.println("[Velo Error] {file_path}: lexer token buffer too small; {dropped} tokens were truncated. Split this file into smaller modules.")
        d.error_count += 1
        return
    }

    mut p: Parser
    init_parser(@p, file_path, source, lex.tokens, lex.token_count)
    let prog = parse_program(@p)

    let dir = get_dir_name(file_path)

    // First pass: recursively load all imported dependencies
    mut cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_USE {
            let mod_path = cur.module_path
            if mod_path != "sys.io" and mod_path != "sys.mem" and mod_path != "sys.fs" and mod_path != "sys.thread" and mod_path != "sys.math" and mod_path != "sys.time" and mod_path != "sys.os" and mod_path != "sys.simd" {
                let resolved_path = combine_paths(dir, mod_path)
                load_file_and_deps(d, resolved_path)
            }
        }
        cur = cur.next
    }

    // Second pass: append current file's declarations to the accumulated driver decl list
    mut decl = prog.first_decl
    loop decl != null {
        let nxt = decl.next
        decl.next = null

        mut skip = false
        if decl.kind == DECL_USE {
            let mod_path = decl.module_path
            if mod_path != "sys.io" and mod_path != "sys.mem" and mod_path != "sys.fs" and mod_path != "sys.thread" and mod_path != "sys.math" and mod_path != "sys.time" and mod_path != "sys.os" and mod_path != "sys.simd" {
                skip = true
            }
        }

        if not skip {
            if d.first_decl == null {
                d.first_decl = decl
                d.last_decl = decl
            } else {
                d.last_decl.next = decl
                d.last_decl = decl
            }
            d.total_decls += 1
        }

        decl = nxt
    }
}

// Compiles a single source file into an AST program with recursive multi-file resolution.
act resolve_and_parse(d: @CompilerDriver, file_path: string) -> @ProgramNode {
    load_file_and_deps(d, file_path)
    if d.error_count > 0 or d.first_decl == null {
        return null
    }
    mut prog: @ProgramNode = mem.alloc(@ProgramNode, 1)
    prog.first_decl = d.first_decl
    prog.decl_count = d.total_decls
    return prog
}

// Translates a Velo source program into a complete, standalone C99 source string.
// Slice 11: unsafe_index carries the --unsafe-shelf-index knob to the emitter.
// 9.1: no_line_directives suppresses #line preprocessor directives.
act compile_source_to_c_test_opts(source_path: string, unsafe_index: bool, is_test: bool, no_line_directives: bool) -> string {
    mut d: CompilerDriver
    init_driver(@d)

    let raw_prog = resolve_and_parse(@d, source_path)
    if raw_prog == null or d.error_count > 0 {
        return null
    }

    let prog = monomorphize_program(raw_prog)

    mut st: SymbolTable
    init_symbol_table(@st)
    st.unsafe_shelf_index = unsafe_index
    st.is_test = is_test
    st.no_line_directives = no_line_directives
    st.source_file = source_path

    let sem_ok = check_program(@st, prog)
    if not sem_ok or st.error_count > 0 {
        io.println("[Velo Error] Semantic analysis failed with {st.error_count} errors.")
        return null
    }

    return emit_translation_unit(@st, prog)
}

act compile_source_to_c_test(source_path: string, unsafe_index: bool, is_test: bool) -> string {
    return compile_source_to_c_test_opts(source_path, unsafe_index, is_test, false)
}

act compile_source_to_c(source_path: string, unsafe_index: bool) -> string {
    return compile_source_to_c_test_opts(source_path, unsafe_index, false, false)
}

act compile_source_to_c_opts(source_path: string, unsafe_index: bool, no_line_directives: bool) -> string {
    return compile_source_to_c_test_opts(source_path, unsafe_index, false, no_line_directives)
}

// Builds a native executable from a Velo source file by compiling to C and invoking the C compiler backend.
act build_executable_opts(source_path: string, output_exe: string, unsafe_index: bool, opt_flags: string, linker_flags: string, cc: string, no_line_directives: bool) -> bool {
    let c_code = compile_source_to_c_opts(source_path, unsafe_index, no_line_directives)
    if c_code == null {
        return false
    }

    let stem = get_file_stem(source_path)
    mut c_path_sb = create_sb(128)
    sb_append_str(@c_path_sb, ".velo_cache/")
    sb_append_str(@c_path_sb, stem)
    sb_append_str(@c_path_sb, ".c")
    let c_file_path = sb_to_string(@c_path_sb)

    fs.write_file(c_file_path, c_code)

    mut out_path = output_exe
    if out_path == null or str.len(out_path) == 0 {
        mut out_sb = create_sb(128)
        sb_append_str(@out_sb, ".velo_cache/")
        sb_append_str(@out_sb, stem)
        sb_append_str(@out_sb, ".exe")
        out_path = sb_to_string(@out_sb)
    }

    let cmd = assemble_compiler_cmd(cc, c_file_path, out_path, opt_flags, linker_flags)
    let res = system(cmd)
    if res != 0 {
        io.println("[Velo Error] {cc} compilation failed with exit code {res}")
        return false
    }

    return fs.exists(out_path)
}

act build_executable(source_path: string, output_exe: string, unsafe_index: bool, opt_flags: string, linker_flags: string, cc: string) -> bool {
    return build_executable_opts(source_path, output_exe, unsafe_index, opt_flags, linker_flags, cc, false)
}

// Compiles and runs a Velo source file.
act run_source_file_opts(source_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, cc: string, no_line_directives: bool) -> i32 {
    let stem = get_file_stem(source_path)
    mut exe_sb = create_sb(128)
    sb_append_str(@exe_sb, ".velo_cache/")
    sb_append_str(@exe_sb, stem)
    sb_append_str(@exe_sb, ".exe")
    let exe_path = sb_to_string(@exe_sb)

    let ok = build_executable_opts(source_path, exe_path, unsafe_index, opt_flags, linker_flags, cc, no_line_directives)
    if not ok {
        return 1
    }

    let run_cmd = assemble_runner_cmd(cc, exe_path, null)
    return system(run_cmd)
}

act run_source_file(source_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, cc: string) -> i32 {
    return run_source_file_opts(source_path, unsafe_index, opt_flags, linker_flags, cc, false)
}

// Compiles and runs tests in a single Velo source file.
act test_source_file_opts(source_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, filter_arg: string, cc: string, no_line_directives: bool) -> i32 {
    let c_code = compile_source_to_c_test_opts(source_path, unsafe_index, true, no_line_directives)
    if c_code == null { return 1 }

    let stem = get_file_stem(source_path)
    mut c_path_sb = create_sb(128)
    sb_append_str(@c_path_sb, ".velo_cache/"); sb_append_str(@c_path_sb, stem); sb_append_str(@c_path_sb, "_test.c")
    let c_file_path = sb_to_string(@c_path_sb)
    fs.write_file(c_file_path, c_code)

    mut out_sb = create_sb(128)
    sb_append_str(@out_sb, ".velo_cache/"); sb_append_str(@out_sb, stem); sb_append_str(@out_sb, "_test.exe")
    let exe_path = sb_to_string(@out_sb)

    let cmd = assemble_compiler_cmd(cc, c_file_path, exe_path, opt_flags, linker_flags)
    let res = system(cmd)
    if res != 0 {
        io.println("[Velo Error] {cc} compilation failed with exit code {res}")
        return 1
    }

    mut extra_sb = create_sb(64)
    if filter_arg != null and str.len(filter_arg) > 0 {
        sb_append_str(@extra_sb, "--filter ")
        sb_append_str(@extra_sb, filter_arg)
    }
    let run_cmd = assemble_runner_cmd(cc, exe_path, sb_to_string(@extra_sb))
    return system(run_cmd)
}

act test_source_file(source_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, filter_arg: string, cc: string) -> i32 {
    return test_source_file_opts(source_path, unsafe_index, opt_flags, linker_flags, filter_arg, cc, false)
}

// Runs tests on a file or all .vl test files within a directory.
act test_target_opts(target_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, filter_arg: string, cc: string, no_line_directives: bool) -> i32 {
    if fs.is_file(target_path) {
        return test_source_file_opts(target_path, unsafe_index, opt_flags, linker_flags, filter_arg, cc, no_line_directives)
    }
    if fs.is_dir(target_path) {
        let entries = fs.read_dir(target_path)
        mut overall: i32 = 0
        mut found = false
        mut i: usize = 0
        loop i < entries.len {
            let entry = entries[i]
            let elen = str.len(entry)
            if elen > 3 and entry[elen - 3] == '.' and entry[elen - 2] == 'v' and entry[elen - 1] == 'l' {
                mut path_sb = create_sb(256)
                sb_append_str(@path_sb, target_path); sb_append_char(@path_sb, '/'); sb_append_str(@path_sb, entry)
                let full_path = sb_to_string(@path_sb)
                let content = fs.read_file(full_path)
                if content != null {
                    if str.contains(content, "test \"") or str.contains(content, "test '") {
                        found = true
                        let rc = test_source_file_opts(full_path, unsafe_index, opt_flags, linker_flags, filter_arg, cc, no_line_directives)
                        if rc != 0 { overall = rc }
                    }
                    mem.free(content)
                }
            }
            i += 1
        }
        if not found { io.println("No test files found in directory."); return 0 }
        return overall
    }
    io.println("[Velo Error] Target path not found: {target_path}")
    return 1
}

act test_target(target_path: string, unsafe_index: bool, opt_flags: string, linker_flags: string, filter_arg: string, cc: string) -> i32 {
    return test_target_opts(target_path, unsafe_index, opt_flags, linker_flags, filter_arg, cc, false)
}

// Generates Markdown documentation for a Velo source file.
act generate_docs_for_source(source_path: string) -> string {
    let source = fs.read_file(source_path)
    if source == null {
        io.println("[Velo Error] Failed to read source file: {source_path}")
        return null
    }
    defer mem.free(source)

    let slen = str.len(source)
    // Same capacity rule and overflow guard as load_file_and_deps.
    mut lex = create_lexer(source, slen, slen + 2)
    lex.file_path = source_path
    tokenize(@lex)

    if lex.dropped_count > 0 {
        let dropped = lex.dropped_count
        io.println("[Velo Error] {source_path}: lexer token buffer too small; {dropped} tokens were truncated; documentation output would be incomplete.")
        return null
    }

    mut p: Parser
    init_parser(@p, source_path, source, lex.tokens, lex.token_count)
    let prog = parse_program(@p)
    if prog == null {
        return null
    }

    return generate_markdown_docs(source_path, source, prog)
}
