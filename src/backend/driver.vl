// Linked list tracking visited files to prevent circular or duplicate module parsing.
data VisitedFile {
    path: string
    next: @VisitedFile
}

// Driver state maintaining module resolution and compiler options.
data CompilerDriver {
    first_visited: @VisitedFile
    error_count: usize
    first_decl: @StmtNode
    last_decl: @StmtNode
    total_decls: usize
}

// Initializes a CompilerDriver instance.
act init_driver(d: @CompilerDriver) {
    d.first_visited = null
    d.error_count = 0
    d.first_decl = null
    d.last_decl = null
    d.total_decls = 0
}

// Checks if a module path has already been parsed.
act is_file_visited(d: @CompilerDriver, path: string) -> bool {
    mut cur = d.first_visited
    loop cur != null {
        if cur.path == path {
            return true
        }
        cur = cur.next
    }
    return false
}

// Marks a module path as visited.
act mark_file_visited(d: @CompilerDriver, path: string) {
    mut vf: @VisitedFile = mem.alloc(@VisitedFile, 1)
    vf.path = path
    vf.next = d.first_visited
    d.first_visited = vf
}

// Returns true if the current host or target operating system is Windows.
act is_windows_platform() -> bool {
    return os_is_windows()
}

// Returns true if the file target is specific to another OS and must be skipped.
act should_skip_platform_file(path: string) -> bool {
    if path == null { return false }
    let is_win = is_windows_platform()
    if is_win and str.ends_with(path, "_linux.vl") {
        return true
    }
    if not is_win and str.ends_with(path, "_windows.vl") {
        return true
    }
    return false
}

// Resolves a source path to its platform-specific variant (_windows.vl or _linux.vl) if available on disk.
act resolve_platform_source_path(path: string) -> string {
    if path == null { return null }
    let plen = str.len(path)
    if plen < 3 or not str.ends_with(path, ".vl") {
        return path
    }
    if str.ends_with(path, "_windows.vl") or str.ends_with(path, "_linux.vl") {
        return path
    }

    let is_win = is_windows_platform()
    let stem = copy_slice_to_string(path, 0, plen - 3)
    if is_win {
        let win_path = str.concat(stem, "_windows.vl")
        if fs_exists(win_path) {
            return win_path
        }
    } else {
        let linux_path = str.concat(stem, "_linux.vl")
        if fs_exists(linux_path) {
            return linux_path
        }
    }
    return path
}

// Returns true if module path represents a standard library import (e.g. "std.io", "std.coll").
act is_std_module(mod_path: string) -> bool {
    if mod_path == null { return false }
    let len = str.len(mod_path)
    if len < 5 { return false }
    return mod_path[0] == 's' and mod_path[1] == 't' and mod_path[2] == 'd' and mod_path[3] == '.'
}

// Converts a dot-delimited std module path to relative file path ("std.io" -> "std/io.vl").
act std_module_to_rel_path(mod_path: string) -> string {
    if mod_path == null { return null }
    let plen = str.len(mod_path)
    mut buf: @u8 = mem.alloc(@u8, plen + 4)
    mut i: usize = 0
    loop i < plen {
        let c = mod_path[i]
        if c == '.' {
            buf[i] = '/'
        } else {
            buf[i] = c
        }
        i += 1
    }
    buf[plen] = '.'
    buf[plen + 1] = 'v'
    buf[plen + 2] = 'l'
    buf[plen + 3] = 0 as u8
    return buf as string
}

// Resolves a std module path against current directory, parent directories, or project root.
act resolve_std_module_path(dir: string, mod_path: string) -> string {
    let rel_file = std_module_to_rel_path(mod_path)
    let p1 = path_join_str(dir, rel_file)
    if fs_exists(p1) { return p1 }

    let p2 = path_join_str(dir, path_join_str("..", rel_file))
    if fs_exists(p2) { return p2 }

    let p3 = path_join_str(dir, path_join_str("../..", rel_file))
    if fs_exists(p3) { return p3 }

    if fs_exists(rel_file) { return path_normalize_str(rel_file) }

    // Check VELO_STD environment variable (direct path or ~/.velo/std)
    let env_std = os.get_env("VELO_STD")
    if str.len(env_std) > 0 {
        let p_env1 = path_join_str(env_std, rel_file)
        if fs_exists(p_env1) { return p_env1 }
        if str.len(rel_file) > 4 {
            let sub = copy_slice_to_string(rel_file, 4, str.len(rel_file) - 4)
            let p_env2 = path_join_str(env_std, sub)
            if fs_exists(p_env2) { return p_env2 }
        }
    }

    // Check VELO_HOME environment variable (e.g. ~/.velo)
    let env_home = os.get_env("VELO_HOME")
    if str.len(env_home) > 0 {
        let p_home = path_join_str(env_home, rel_file)
        if fs_exists(p_home) { return p_home }
    }

    // Check Windows user profile (~/.velo/std/...)
    let u_prof = os.get_env("USERPROFILE")
    if str.len(u_prof) > 0 {
        let pu = path_join_str(u_prof, path_join_str(".velo", rel_file))
        if fs_exists(pu) { return pu }
    }

    // Check POSIX home (~/.velo/std/...)
    let h_prof = os.get_env("HOME")
    if str.len(h_prof) > 0 {
        let ph = path_join_str(h_prof, path_join_str(".velo", rel_file))
        if fs_exists(ph) { return ph }
    }

    // System-wide fallbacks
    let p_sys1 = path_join_str("/usr/local/share/velo", rel_file)
    if fs_exists(p_sys1) { return p_sys1 }
    let p_sys2 = path_join_str("/usr/share/velo", rel_file)
    if fs_exists(p_sys2) { return p_sys2 }

    return p1
}

// Recursively loads a file and its imported dependencies in topological order.
act load_file_and_deps(d: @CompilerDriver, raw_path: string) {
    if should_skip_platform_file(raw_path) {
        return
    }
    let target_path = resolve_platform_source_path(raw_path)
    let file_path = path_normalize_str(target_path)
    if is_file_visited(d, file_path) {
        return
    }
    mark_file_visited(d, file_path)


    if not fs_exists(file_path) {
        println_str("[Velo Error] Source file does not exist: {file_path}")
        d.error_count += 1
        return
    }

    let source = fs_read_to_str(file_path)
    if source == null {
        println_str("[Velo Error] Failed to read source file: {file_path}")
        d.error_count += 1
        return
    }
    defer heap_free_str(source)

    let slen = str.len(source)
    // Capacity must cover the absolute worst case: one token per source
    // character, plus EOF. A fixed cap silently truncates large files.
    mut lex = create_lexer(source, slen, slen + 2)
    lex.file_path = file_path
    tokenize(@lex)

    if lex.dropped_count > 0 {
        let dropped = lex.dropped_count
        println_str("[Velo Error] {file_path}: lexer token buffer too small; {dropped} tokens were truncated. Split this file into smaller modules.")
        d.error_count += 1
        return
    }

    mut p: Parser
    init_parser(@p, file_path, source, lex.tokens, lex.token_count)
    let prog = parse_program(@p)

    let dir = path_dirname_to_str(file_path)

    // First pass: recursively load all imported dependencies
    mut cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_USE {
            let mod_path = cur.module_path
            if mod_path != "sys.io" and mod_path != "sys.mem" and mod_path != "sys.fs" and mod_path != "sys.thread" and mod_path != "sys.math" and mod_path != "sys.time" and mod_path != "sys.os" and mod_path != "sys.simd" {
                mut resolved_path = path_join_str(dir, mod_path)
                if is_std_module(mod_path) {
                    resolved_path = resolve_std_module_path(dir, mod_path)
                }
                load_file_and_deps(d, resolved_path)
            }
        }
        cur = cur.next
    }

    // Second pass: append current file's declarations to the accumulated driver decl list
    mut decl = prog.first_decl
    loop decl != null {
        let nxt = decl.next
        decl.next = null

        mut skip = false
        if decl.kind == DECL_USE {
            let mod_path = decl.module_path
            if mod_path != "sys.io" and mod_path != "sys.mem" and mod_path != "sys.fs" and mod_path != "sys.thread" and mod_path != "sys.math" and mod_path != "sys.time" and mod_path != "sys.os" and mod_path != "sys.simd" {
                skip = true
            }
        }

        if not skip {
            if d.first_decl == null {
                d.first_decl = decl
                d.last_decl = decl
            } else {
                d.last_decl.next = decl
                d.last_decl = decl
            }
            d.total_decls += 1
        }

        decl = nxt
    }
}

// Compiles a single source file into an AST program with recursive multi-file resolution.
act resolve_and_parse(d: @CompilerDriver, file_path: string) -> @ProgramNode {
    load_file_and_deps(d, file_path)
    if d.error_count > 0 or d.first_decl == null {
        return null
    }
    mut prog: @ProgramNode = mem.alloc(@ProgramNode, 1)
    prog.first_decl = d.first_decl
    prog.decl_count = d.total_decls
    return prog
}

// Translates a Velo source program into a complete, standalone C99 source string.
// Slice 11: unsafe_index carries the --unsafe-shelf-index knob to the emitter.
// 9.1: no_line_directives suppresses #line preprocessor directives.
act compile_source_to_c_test_opts(source_path: string, unsafe_index: bool, is_test: bool, no_line_directives: bool) -> string {
    mut d: CompilerDriver
    init_driver(@d)

    let raw_prog = resolve_and_parse(@d, source_path)
    if raw_prog == null or d.error_count > 0 {
        return null
    }

    let prog = monomorphize_program(raw_prog)

    mut st: SymbolTable
    init_symbol_table(@st)
    st.unsafe_shelf_index = unsafe_index
    st.is_test = is_test
    st.no_line_directives = no_line_directives
    st.source_file = source_path

    let sem_ok = check_program(@st, prog)
    if not sem_ok or st.error_count > 0 {
        println_str("[Velo Error] Semantic analysis failed with {st.error_count} errors.")
        return null
    }

    // The semantic gate above only covers the analysis pass. Interpolation and
    // intrinsic lowering re-enter the type checker during emission, so errors
    // raised there land in st.error_count AFTER it; without this second gate the
    // failing C is still written and the CLI reports success.
    let c_out = emit_translation_unit(@st, prog)
    if st.error_count > 0 {
        println_str("[Velo Error] Code generation failed with {st.error_count} errors.")
        return null
    }
    return c_out
}

act compile_source_to_c_test(source_path: string, unsafe_index: bool, is_test: bool) -> string {
    return compile_source_to_c_test_opts(source_path, unsafe_index, is_test, false)
}

act compile_source_to_c(source_path: string, unsafe_index: bool) -> string {
    return compile_source_to_c_test_opts(source_path, unsafe_index, false, false)
}

act compile_source_to_c_opts(source_path: string, unsafe_index: bool, no_line_directives: bool) -> string {
    return compile_source_to_c_test_opts(source_path, unsafe_index, false, no_line_directives)
}

// Generates Markdown documentation for a Velo source file.
act generate_docs_for_source(source_path: string) -> string {
    let source = fs_read_to_str(source_path)
    if source == null {
        println_str("[Velo Error] Failed to read source file: {source_path}")
        return null
    }
    defer heap_free_str(source)

    let slen = str.len(source)
    // Same capacity rule and overflow guard as load_file_and_deps.
    mut lex = create_lexer(source, slen, slen + 2)
    lex.file_path = source_path
    tokenize(@lex)

    if lex.dropped_count > 0 {
        let dropped = lex.dropped_count
        println_str("[Velo Error] {source_path}: lexer token buffer too small; {dropped} tokens were truncated; documentation output would be incomplete.")
        return null
    }

    mut p: Parser
    init_parser(@p, source_path, source, lex.tokens, lex.token_count)
    let prog = parse_program(@p)
    if prog == null {
        return null
    }

    return generate_markdown_docs(source_path, source, prog)
}
