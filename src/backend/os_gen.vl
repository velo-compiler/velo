// ============================================================================
use "../ast/expr.vl"
use "../analysis/symbol_table.vl"
use "../common/string_builder.vl"
use "intrinsic_emitter.vl"

act emit_os_call(sb: @StringBuilder, st: @SymbolTable, member: string, expr: @ExprNode) {
    emit_intrinsic_call(sb, st, "os", member, expr)
}
