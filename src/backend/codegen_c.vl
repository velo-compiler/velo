// Full C99 translation unit emitter and top-level declaration orchestrator in Velo.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../common/string_builder.vl"
use "../common/utils.vl"
use "../common/act_types.vl"
use "codegen_expr.vl"
use "codegen_stmt.vl"
use "test_gen.vl"
use "codegen_line.vl"
use "codegen_decl.vl"

// Emits complete C99 translation unit from an AST ProgramNode.
act emit_translation_unit(st: @SymbolTable, prog: @ProgramNode) -> string {
    mut sb = create_sb(4096)

    // 1. Header inclusions
    sb_append_line(@sb, "/* Generated by Velo Stage 2 Self-Hosted Compiler */", 0)
    sb_append_line(@sb, "#include \"velo_runtime.h\"", 0)
    sb_append_line(@sb, "", 0)

    // 2. Structs, types, aliases, kinds, globals, and extern prototypes
    emit_type_declarations(@sb, st, prog)

    // 5. Function forward prototypes
    if st.is_test { emit_test_prototypes(@sb, prog) }
    mut cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_FUNCTION and cur.name != "main" {
            if is_anon_act_name(cur.name) { sb_append_str(@sb, "static ") }
            sb_append_str(@sb, map_type_to_c(cur.return_type)); sb_append_char(@sb, ' '); sb_append_str(@sb, cur.name)
            emit_param_list(@sb, cur.first_param, cur.param_count); sb_append_str(@sb, ";\n")
        }
        cur = cur.next
    }
    sb_append_line(@sb, "", 0)

    // 6. Function bodies
    cur = prog.first_decl
    loop cur != null {
        if cur.kind == DECL_FUNCTION {
            emit_line_directive(@sb, st, cur.line)
            if cur.name == "main" {
                if st.is_test { sb_append_str(@sb, "static int _velo_user_main(int argc, char** argv) {\n") } else { sb_append_str(@sb, "int main(int argc, char** argv) {\n") }
                sb_append_str(@sb, "g_velo_os_argc = argc;\n"); sb_append_str(@sb, "g_velo_os_argv = argv;\n")
            } else {
                if is_anon_act_name(cur.name) { sb_append_str(@sb, "static ") }
                sb_append_str(@sb, map_type_to_c(cur.return_type)); sb_append_char(@sb, ' '); sb_append_str(@sb, cur.name)
                emit_param_list(@sb, cur.first_param, cur.param_count); sb_append_str(@sb, " {\n")
            }

            enter_scope(st)
            mut cur_param = cur.first_param
            loop cur_param != null {
                define_parameter(st, cur_param.name, cur_param.type_name, cur_param.line, cur_param.col)
                cur_param = cur_param.next
            }

            mut defers: @DeferNode = null
            emit_c_block_stmts(@sb, st, cur.body, 1, @defers)

            mut cur_d = defers
            loop cur_d != null {
                emit_c_stmt(@sb, st, cur_d.stmt, 1, @defers)
                cur_d = cur_d.next
            }

            if cur.name == "main" { sb_append_indent(@sb, 1); sb_append_str(@sb, "return 0;\n") }
            exit_scope(st)
            sb_append_str(@sb, "}\n\n")
        }
        cur = cur.next
    }

    if st.is_test {
        emit_test_functions(@sb, st, prog)
        emit_test_harness_main(@sb, prog)
    }

    return sb_to_string(@sb)
}
