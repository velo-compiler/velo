// Backend compiler driver helper for GCC and MSVC (cl.exe).
use std.fs
use sys.os
use "../common/string_builder.vl"
use "../common/utils.vl"

// Probes known Visual Studio installations for vcvars64.bat.
act find_vcvars() -> string {
    if fs_exists("C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Auxiliary/Build/vcvars64.bat") {
        return "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat"
    }
    if fs_exists("C:/Program Files/Microsoft Visual Studio/2022/Professional/VC/Auxiliary/Build/vcvars64.bat") {
        return "C:\\Program Files\\Microsoft Visual Studio\\2022\\Professional\\VC\\Auxiliary\\Build\\vcvars64.bat"
    }
    if fs_exists("C:/Program Files/Microsoft Visual Studio/2022/Enterprise/VC/Auxiliary/Build/vcvars64.bat") {
        return "C:\\Program Files\\Microsoft Visual Studio\\2022\\Enterprise\\VC\\Auxiliary\\Build\\vcvars64.bat"
    }
    if fs_exists("C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Auxiliary/Build/vcvars64.bat") {
        return "C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat"
    }
    if fs_exists("C:/Program Files (x86)/Microsoft Visual Studio/2019/Community/VC/Auxiliary/Build/vcvars64.bat") {
        return "C:\\Program Files (x86)\\Microsoft Visual Studio\\2019\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat"
    }
    if fs_exists("C:/Program Files (x86)/Microsoft Visual Studio/2019/Professional/VC/Auxiliary/Build/vcvars64.bat") {
        return "C:\\Program Files (x86)\\Microsoft Visual Studio\\2019\\Professional\\VC\\Auxiliary\\Build\\vcvars64.bat"
    }
    if fs_exists("C:/Program Files (x86)/Microsoft Visual Studio/2019/Enterprise/VC/Auxiliary/Build/vcvars64.bat") {
        return "C:\\Program Files (x86)\\Microsoft Visual Studio\\2019\\Enterprise\\VC\\Auxiliary\\Build\\vcvars64.bat"
    }
    if fs_exists("C:/Program Files (x86)/Microsoft Visual Studio/2019/BuildTools/VC/Auxiliary/Build/vcvars64.bat") {
        return "C:\\Program Files (x86)\\Microsoft Visual Studio\\2019\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat"
    }
    return null
}

// Translates linker flags (-Ldir, -llib) into MSVC /link options.
act append_msvc_linker_flags(sb: @StringBuilder, linker_flags: string, debug_mode: bool, profile_mode: bool) {
    if (linker_flags == null or str.len(linker_flags) == 0) and not debug_mode and not profile_mode {
        return
    }
    sb_append_str(sb, " /link")
    if debug_mode or profile_mode {
        sb_append_str(sb, " /DEBUG")
    }
    if profile_mode {
        sb_append_str(sb, " /PROFILE")
    }
    if linker_flags == null or str.len(linker_flags) == 0 {
        return
    }
    let len = str.len(linker_flags)
    mut i: usize = 0
    loop i < len {
        loop i < len and linker_flags[i] == ' ' {
            i += 1
        }
        if i >= len {
            break
        }
        let start = i
        mut in_quotes = false
        loop i < len and (in_quotes or linker_flags[i] != ' ') {
            if linker_flags[i] == '"' {
                in_quotes = not in_quotes
            }
            i += 1
        }
        let token = copy_slice_to_string(linker_flags, start, i - start)
        let tlen = str.len(token)
        sb_append_char(sb, ' ')
        if tlen > 2 and token[0] == '-' and token[1] == 'L' {
            sb_append_str(sb, "/LIBPATH:")
            let raw_dir = copy_slice_to_string(token, 2, tlen - 2)
            sb_append_str(sb, quote_path(path_to_native_str(raw_dir)))
        } else if tlen > 2 and token[0] == '-' and token[1] == 'l' {
            let lib_name = copy_slice_to_string(token, 2, tlen - 2)
            let llen = str.len(lib_name)
            sb_append_str(sb, lib_name)
            if not (llen > 4 and lib_name[llen - 4] == '.' and lib_name[llen - 3] == 'l' and lib_name[llen - 2] == 'i' and lib_name[llen - 1] == 'b') {
                sb_append_str(sb, ".lib")
            }
        } else {
            sb_append_str(sb, token)
        }
    }
}

// Appends a single include directory flag if the directory exists on disk.
act append_include_flag(sb: @StringBuilder, is_msvc: bool, dir_path: string) {
    if fs_exists(dir_path) {
        if is_msvc {
            sb_append_str(sb, " /I ")
        } else {
            sb_append_str(sb, " -I ")
        }
        sb_append_str(sb, quote_path(path_to_native_str(dir_path)))
    }
}

// Phase 70 / Task 70.2: absolute location of the running compiler binary,
// supplied by the runtime header. Declared `string` (const char*) so the
// emitted extern declaration matches `static inline const char*
// velo_host_exe_path(void)` exactly; C99 6.2.2p4 keeps the inline definition's
// internal linkage, so the call resolves to the copy in this translation unit.
extern act velo_host_exe_path() -> string

// Appends every existing include directory named `include_name` that sits next
// to the running compiler binary, and returns true when at least one was added.
//
// `bin/velo.exe` inside a source checkout needs two parent hops to reach the
// repository root, while the release archive keeps `runtime/` beside the binary,
// so all three positions are probed. Parents are taken with dirname rather than
// a ".." segment so the result stays absolute and needs no normalization.
act append_binary_relative_include(sb: @StringBuilder, is_msvc: bool, include_name: string) -> bool {
    let exe = velo_host_exe_path()
    if exe == null or str.len(exe) == 0 {
        return false
    }
    let exe_dir = path_dirname_to_str(exe)
    if exe_dir == null or str.len(exe_dir) == 0 {
        return false
    }
    mut found = false
    let beside = path_join_str(exe_dir, include_name)
    if fs_exists(beside) {
        append_include_flag(sb, is_msvc, beside)
        found = true
    }
    let up_one = path_dirname_to_str(exe_dir)
    if up_one != null and str.len(up_one) > 0 {
        let one_up = path_join_str(up_one, include_name)
        if fs_exists(one_up) {
            append_include_flag(sb, is_msvc, one_up)
            found = true
        }
        let up_two = path_dirname_to_str(up_one)
        if up_two != null and str.len(up_two) > 0 {
            let two_up = path_join_str(up_two, include_name)
            if fs_exists(two_up) {
                append_include_flag(sb, is_msvc, two_up)
                found = true
            }
        }
    }
    return found
}

// Appends runtime include directories (in-tree runtime, VELO_INCLUDE, ~/.velo/include, ~/.velo/runtime).
act append_runtime_includes(sb: @StringBuilder, is_msvc: bool) {
    // The in-tree header is located through the running binary, not through the
    // working directory. "-I runtime" is resolved against the caller's CWD, so it
    // only matched when the compiler was invoked from the repository root; from
    // any other directory it silently matched nothing and the search fell
    // through to a stale installed copy under ~/.velo/include. A header older
    // than the compiler then wins the include, and every helper the compiler
    // emits a call to but the stale header does not declare fails at link time.
    //
    // Absolute binary-relative paths are appended first so the header that
    // ships with this compiler always wins. The relative flags survive only as a
    // fallback for an installation whose binary cannot report its own path.
    mut resolved = append_binary_relative_include(sb, is_msvc, "runtime")
    if append_binary_relative_include(sb, is_msvc, "velo/runtime") {
        resolved = true
    }
    if not resolved {
        if is_msvc {
            sb_append_str(sb, " /I \"runtime\" /I \"velo/runtime\"")
        } else {
            sb_append_str(sb, " -I \"runtime\" -I \"velo/runtime\"")
        }
    }

    let env_inc = os.get_env("VELO_INCLUDE")
    if str.len(env_inc) > 0 {
        append_include_flag(sb, is_msvc, env_inc)
    }

    let env_home = os.get_env("VELO_HOME")
    if str.len(env_home) > 0 {
        append_include_flag(sb, is_msvc, path_join_str(env_home, "include"))
        append_include_flag(sb, is_msvc, path_join_str(env_home, "runtime"))
    }

    let u_prof = os.get_env("USERPROFILE")
    if str.len(u_prof) > 0 {
        append_include_flag(sb, is_msvc, path_join_str(u_prof, ".velo/include"))
        append_include_flag(sb, is_msvc, path_join_str(u_prof, ".velo/runtime"))
    }

    let h_prof = os.get_env("HOME")
    if str.len(h_prof) > 0 {
        append_include_flag(sb, is_msvc, path_join_str(h_prof, ".velo/include"))
        append_include_flag(sb, is_msvc, path_join_str(h_prof, ".velo/runtime"))
    }

    append_include_flag(sb, is_msvc, "/usr/local/include/velo")
    append_include_flag(sb, is_msvc, "/usr/include/velo")
}

// Assembles MSVC cl.exe compilation command.
act assemble_msvc_compile_cmd(c_file_path: string, out_exe_path: string, opt_flags: string, linker_flags: string) -> string {
    mut cmd_sb = create_sb(512)
    let vcvars = find_vcvars()
    if vcvars != null {
        sb_append_str(@cmd_sb, "call ")
        sb_append_str(@cmd_sb, quote_path(vcvars))
        sb_append_str(@cmd_sb, " >nul && ")
    }
    sb_append_str(@cmd_sb, "cl /nologo /TC /W3 /wd4090 /wd4996 /D_CRT_SECURE_NO_WARNINGS ")
    append_runtime_includes(@cmd_sb, true)
    sb_append_str(@cmd_sb, " ")
    let env_cflags = os.get_env("VELO_CFLAGS")
    if str.len(env_cflags) > 0 {
        sb_append_str(@cmd_sb, env_cflags)
        sb_append_str(@cmd_sb, " ")
    }
    mut is_debug = false
    mut is_profile = false
    if opt_flags != null and str.contains(opt_flags, "-pg") {
        is_profile = true
    }
    if opt_flags == null or str.len(opt_flags) == 0 {
        sb_append_str(@cmd_sb, "/O2 ")
    } else if str.contains(opt_flags, "-O0") or str.contains(opt_flags, "-g") {
        is_debug = true
        sb_append_str(@cmd_sb, "/Od /Zi /DVELO_DEBUG ")
    } else if str.contains(opt_flags, "-O1") {
        sb_append_str(@cmd_sb, "/O1 ")
    } else {
        sb_append_str(@cmd_sb, "/O2 ")
    }
    if is_profile and not is_debug {
        sb_append_str(@cmd_sb, "/Zi ")
    }
    if str.contains(opt_flags, "-DVELO_UNSAFE_HEAP") {
        sb_append_str(@cmd_sb, "/DVELO_UNSAFE_HEAP ")
    }
    sb_append_str(@cmd_sb, quote_path(path_to_native_str(c_file_path)))
    sb_append_str(@cmd_sb, " /Fe:")
    sb_append_str(@cmd_sb, quote_path(path_to_native_str(out_exe_path)))
    append_msvc_linker_flags(@cmd_sb, linker_flags, is_debug, is_profile)
    let env_ldflags = os.get_env("VELO_LDFLAGS")
    if str.len(env_ldflags) > 0 {
        sb_append_str(@cmd_sb, " ")
        sb_append_str(@cmd_sb, env_ldflags)
    }
    return sb_to_string(@cmd_sb)
}

// Assembles GCC or Clang compilation command.
act assemble_gcc_compile_cmd(cc: string, c_file_path: string, out_exe_path: string, opt_flags: string, linker_flags: string) -> string {
    mut cmd_sb = create_sb(512)
    if fs_exists("C:/msys64/ucrt64/bin/gcc.exe") {
        sb_append_str(@cmd_sb, "set PATH=C:\\msys64\\ucrt64\\bin;%PATH% && ")
    }
    mut actual_cc = cc
    if actual_cc == "gcc" {
        let env_cc = os.get_env("CC")
        if str.len(env_cc) > 0 and (env_cc == "clang" or str.contains(env_cc, "clang")) {
            actual_cc = "clang"
        }
    }
    if actual_cc == "clang" {
        sb_append_str(@cmd_sb, "clang ")
    } else {
        sb_append_str(@cmd_sb, "gcc ")
    }
    if opt_flags != null and str.len(opt_flags) > 0 {
        sb_append_str(@cmd_sb, opt_flags)
        sb_append_str(@cmd_sb, " ")
    } else {
        sb_append_str(@cmd_sb, "-O2 ")
    }
    sb_append_str(@cmd_sb, "-fwrapv -std=c99 ")
    append_runtime_includes(@cmd_sb, false)
    sb_append_str(@cmd_sb, " ")
    let env_cflags = os.get_env("VELO_CFLAGS")
    if str.len(env_cflags) > 0 {
        sb_append_str(@cmd_sb, env_cflags)
        sb_append_str(@cmd_sb, " ")
    }
    sb_append_str(@cmd_sb, quote_path(path_to_native_str(c_file_path)))
    if linker_flags != null and str.len(linker_flags) > 0 {
        sb_append_str(@cmd_sb, " ")
        sb_append_str(@cmd_sb, linker_flags)
    }
    let env_ldflags = os.get_env("VELO_LDFLAGS")
    if str.len(env_ldflags) > 0 {
        sb_append_str(@cmd_sb, " ")
        sb_append_str(@cmd_sb, env_ldflags)
    }
    if fs_exists("C:/Windows") or fs_exists("C:/msys64/ucrt64/bin/gcc.exe") {
        sb_append_str(@cmd_sb, " -lws2_32 -ladvapi32")
    } else {
        sb_append_str(@cmd_sb, " -lm -lpthread")
    }
    sb_append_str(@cmd_sb, " -o ")
    sb_append_str(@cmd_sb, quote_path(path_to_native_str(out_exe_path)))
    return sb_to_string(@cmd_sb)
}

// Assembles the C compiler invocation command for either GCC, Clang, or MSVC cl.
act assemble_compiler_cmd(cc: string, c_file_path: string, out_exe_path: string, opt_flags: string, linker_flags: string) -> string {
    if cc == "cl" {
        return assemble_msvc_compile_cmd(c_file_path, out_exe_path, opt_flags, linker_flags)
    }
    return assemble_gcc_compile_cmd(cc, c_file_path, out_exe_path, opt_flags, linker_flags)
}

// Assembles executable runner command.
act assemble_runner_cmd(cc: string, exe_path: string, extra_args: string) -> string {
    mut run_sb = create_sb(256)
    if cc != "cl" and fs_exists("C:/msys64/ucrt64/bin/gcc.exe") {
        sb_append_str(@run_sb, "set PATH=C:\\msys64\\ucrt64\\bin;%PATH% && ")
    }
    sb_append_str(@run_sb, quote_path(path_to_native_str(exe_path)))
    if extra_args != null and str.len(extra_args) > 0 {
        sb_append_str(@run_sb, " ")
        sb_append_str(@run_sb, extra_args)
    }
    return sb_to_string(@run_sb)
}

// 6.2 Optimization Flags & Build Modes
act resolve_opt_flags(debug_mode: bool, release_mode: bool, opt_level: string) -> string {
    mut sb = create_sb(64)
    if opt_level != null and str.len(opt_level) > 0 {
        sb_append_str(@sb, "-O")
        sb_append_str(@sb, opt_level)
    } else if debug_mode {
        sb_append_str(@sb, "-O0")
    } else if release_mode {
        sb_append_str(@sb, "-O3")
    } else {
        sb_append_str(@sb, "-O2")
    }
    if debug_mode {
        sb_append_str(@sb, " -g -DVELO_DEBUG")
    }
    if release_mode {
        sb_append_str(@sb, " -flto")
    }
    return sb_to_string(@sb)
}
