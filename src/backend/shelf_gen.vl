// ============================================================================
// 5.2 Dynamic Collections (shelf) — C99 emission helpers.
// Lowers the shelf surface onto the shared runtime layout (VeloShelf +
// velo_shelf_* helpers in velo_runtime.h). Semantic checks (mut doctrine,
// homogeneous literals, row-copy writes, index types) already ran in the
// checker; this file only shapes the C.
// ============================================================================
use sys.mem
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../analysis/shelf_checks.vl"
use "../analysis/dyn_checks.vl"
use "../common/string_builder.vl"
use "../common/act_types.vl"
use "codegen_types.vl"
use "codegen_expr.vl"
use "codegen_stmt.vl"
use "shelf_helpers.vl"

// 5.2 slice 8 — the raw-dyn binop emit (emit_dyn_binop) and its op mappers
// live in shelf_calls_gen.vl beside the member-call emitters (the 400-line
// budget split); the box/unbox helpers stay here.

// Emits the shelf constructor literal as a GCC statement expression that
// binds each element once into a typed temp (left-to-right) and puts it.
act emit_shelf_literal(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    mut elem = expr.type_name
    if elem == null or str.len(elem) == 0 { 
        elem = infer_expr_type(st, expr.first_arg)
    }
    let elem_c = map_type_to_c(elem)
    mut src_c = "0"
    if expr.kind == EXPR_HEAP_SHELF_LIT {
        src_c = "VELO_SHELF_HEAP_SRC"
    }
    if expr.first_arg == null {
        sb_append_str(sb, "velo_shelf_create_empty((usize)sizeof(")
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "), ")
        sb_append_str(sb, src_c)
        sb_append_char(sb, ')')
        return
    }
    mut count = 0
    mut cur = expr.first_arg
    loop cur != null {
        count += 1
        cur = cur.next
    }
    sb_append_str(sb, "velo_shelf_create_lit((usize)sizeof(")
    sb_append_str(sb, elem_c)
    sb_append_str(sb, "), ")
    sb_append_int(sb, count)
    sb_append_str(sb, ", (")
    if not str.starts_with(elem_c, "const ") {
        sb_append_str(sb, "const ")
    }
    sb_append_str(sb, elem_c)
    sb_append_str(sb, "[]){ ")
    cur = expr.first_arg
    mut first = true
    loop cur != null {
        if not first { sb_append_str(sb, ", ") }
        first = false
        sb_append_char(sb, '(')
        if elem == "dyn" {
            let raw = infer_expr_type(st, cur)
            if raw == "dyn" {
                emit_c_expr(sb, st, cur)
            } else {
                emit_dyn_box(sb, st, raw, cur)
            }
        } else {
            emit_c_expr(sb, st, cur)
        }
        sb_append_char(sb, ')')
        cur = cur.next
    }
    sb_append_str(sb, " }, ")
    sb_append_str(sb, src_c)
    sb_append_char(sb, ')')
}

// A shelf read lowers onto velo_shelf_get; value receivers take &, @-receivers
// pass their own pointer.
act emit_shelf_get(sb: @StringBuilder, st: @SymbolTable, recv: @ExprNode, idx: @ExprNode, elem_c: string) {
    // 5.2 slice 11: the --unsafe-shelf-index knob — the unguarded read;
    // out-of-range indexes are silent UB (documented; flag-gated, writes
    // stay guarded because they mutate length state)
    if st.unsafe_shelf_index {
        sb_append_str(sb, "(((")
        sb_append_str(sb, elem_c)
        sb_append_str(sb, "*)(")
        emit_shelf_recv(sb, st, recv)
        sb_append_str(sb, ")->data)[(usize)(")
        emit_c_expr(sb, st, idx)
        sb_append_str(sb, ")])")
        return
    }
    sb_append_str(sb, "(*((")
    sb_append_str(sb, elem_c)
    sb_append_str(sb, "*)velo_shelf_get(")
    emit_shelf_recv(sb, st, recv)
    sb_append_str(sb, ", (usize)(")
    emit_c_expr(sb, st, idx)
    sb_append_str(sb, "))))")
}

act emit_shelf_recv(sb: @StringBuilder, st: @SymbolTable, recv: @ExprNode) {
    let recv_t = infer_expr_type(st, recv)
    if str.len(recv_t) > 0 and recv_t[0] == '@' {
        sb_append_str(sb, "(")
        emit_c_expr(sb, st, recv)
        sb_append_str(sb, ")")
    } else {
        sb_append_str(sb, "&(")
        emit_c_expr(sb, st, recv)
        sb_append_str(sb, ")")
    }
}

// Index read: `(*((T*)velo_shelf_get(recv, (usize)(idx))))` with loud OOB in the helper.
act emit_shelf_index(sb: @StringBuilder, st: @SymbolTable, expr: @ExprNode) {
    let recv_t = infer_expr_type(st, expr.target)
    emit_shelf_get(sb, st, expr.target, expr.index, map_type_to_c(shelf_raw_elem(recv_t)))
}

// Generator: unique temporary names for shelf statement expressions.
act shelf_fresh_name(st: @SymbolTable, prefix: string) -> string {
    mut sb = create_sb(str.len(prefix) + 22)
    sb_append_str(@sb, "_velo_")
    sb_append_str(@sb, prefix)
    sb_append_int(@sb, st.fresh_counter + 1)
    st.fresh_counter += 1
    return sb_to_string(@sb)
}

// Indexed write: `{ T _velo_set_N = (v); velo_shelf_set(recv, (usize)(i),
// (const void*)(&(_velo_set_N)), (usize)sizeof(T)); }`
act emit_shelf_set(sb: @StringBuilder, st: @SymbolTable, stmt: @StmtNode, indent: i32) {
    let recv_t = infer_expr_type(st, stmt.expr.target)
    let elem = shelf_raw_elem(recv_t)
    let elem_c = map_type_to_c(elem)
    let slot = shelf_fresh_name(st, "set_")
    sb_append_indent(sb, indent)
    sb_append_str(sb, "{ ")
    sb_append_str(sb, elem_c)
    sb_append_char(sb, ' ')
    sb_append_str(sb, slot)
    sb_append_str(sb, " = (")
    if elem == "dyn" {
        // 5.2 slice 2: box the written value into the tag
        let raw = infer_expr_type(st, stmt.val_expr)
        if raw == "dyn" {
            emit_c_expr(sb, st, stmt.val_expr)
        } else {
            emit_dyn_box(sb, st, raw, stmt.val_expr)
        }
    } else {
        emit_c_expr(sb, st, stmt.val_expr)
    }
    sb_append_str(sb, "); velo_shelf_set(")
    emit_shelf_recv(sb, st, stmt.expr.target)
    sb_append_str(sb, ", (usize)(")
    emit_c_expr(sb, st, stmt.expr.index)
    sb_append_str(sb, "), (const void*)(&(")
    sb_append_str(sb, slot)
    sb_append_str(sb, ")), (usize)sizeof(")
    sb_append_str(sb, elem_c)
    sb_append_str(sb, ")); }\n")
}

// `loop v of coll` — snapshot semantics: evaluate the source ONCE into a
// stable view (copied struct header + copied data pointer/len), then walk.
// Puts inside the body mutate the shelf, never the view.
act emit_shelf_loop(sb: @StringBuilder, st: @SymbolTable, stmt: @StmtNode, indent: i32, defers: @@DeferNode) {
    let coll_t = infer_expr_type(st, stmt.expr)
    let elem = shelf_raw_elem(coll_t)
    let elem_c = map_type_to_c(elem)
    let src = shelf_fresh_name(st, "lsrc_")
    let cnt = shelf_fresh_name(st, "lcnt_")
    let idx = shelf_fresh_name(st, "lidx_")
    let dat = shelf_fresh_name(st, "ldat_")
    mut vname = "it"
    if stmt.loop_var != null and str.len(stmt.loop_var) > 0 { vname = stmt.loop_var }
    // 5.2 slice 4: an explicit second binding names the step index (usize);
    // the C counter uses the user's name so the index is readable in the body.
    mut iname = idx
    if stmt.loop_index != null and str.len(stmt.loop_index) > 0 { iname = stmt.loop_index }
    sb_append_indent(sb, indent)
    sb_append_str(sb, "{ VeloShelf ")
    sb_append_str(sb, src)
    sb_append_str(sb, " = (")
    if str.len(coll_t) > 0 and coll_t[0] == '@' {
        // @-pointer sources are unpacked into the stable view header
        sb_append_str(sb, "*(")
        emit_c_expr(sb, st, stmt.expr)
        sb_append_str(sb, ")")
    } else {
        emit_c_expr(sb, st, stmt.expr)
    }
    sb_append_str(sb, "); ")
    sb_append_str(sb, "const usize ")
    sb_append_str(sb, cnt)
    sb_append_str(sb, " = ")
    sb_append_str(sb, src)
    sb_append_str(sb, ".len; void* ")
    sb_append_str(sb, dat)
    sb_append_str(sb, " = ")
    sb_append_str(sb, src)
    sb_append_str(sb, ".data;")
    sb_append_str(sb, "\n")
    sb_append_indent(sb, indent)
    sb_append_str(sb, "for (usize ")
    sb_append_str(sb, iname)
    sb_append_str(sb, " = 0; ")
    sb_append_str(sb, iname)
    sb_append_str(sb, " < ")
    sb_append_str(sb, cnt)
    sb_append_str(sb, "; ++")
    sb_append_str(sb, iname)
    sb_append_str(sb, ") {\n")
    enter_scope(st)
    define_variable(st, vname, elem, false, stmt.line, stmt.col)
    if stmt.loop_index != null and str.len(stmt.loop_index) > 0 { define_variable(st, iname, "usize", false, stmt.line, stmt.col) }
    sb_append_indent(sb, indent + 1)
    sb_append_str(sb, "const ")
    sb_append_str(sb, elem_c)
    sb_append_char(sb, ' ')
    sb_append_str(sb, vname)
    sb_append_str(sb, " = ((")
    sb_append_str(sb, elem_c)
    sb_append_str(sb, "*)")
    sb_append_str(sb, dat)
    sb_append_str(sb, ")[")
    sb_append_str(sb, iname)
    sb_append_str(sb, "];\n")
    emit_c_block_stmts(sb, st, stmt.body, indent + 1, defers)
    exit_scope(st)
    sb_append_indent(sb, indent)   // for-body close
    sb_append_str(sb, "}\n")
    sb_append_indent(sb, indent)   // snapshot view block close
    sb_append_str(sb, "}\n")
}
