// Range loop code generation helpers for Velo compiler backend.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../analysis/range_checks.vl"
use "../ast/int_types.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "codegen_lit.vl"
use "codegen_expr.vl"

// Emits the C99 `for (...)` header for range-based loop statements.
act emit_range_loop_header(sb: @StringBuilder, st: @SymbolTable, stmt: @StmtNode, c_type: string, vname: string) {
    if is_literal_range_step(stmt.loop_start, stmt.loop_end, stmt.loop_step) {
        let is_rev = is_reverse_loop_range(stmt.loop_start, stmt.loop_end)
        sb_append_str(sb, "for ("); sb_append_str(sb, c_type); sb_append_str(sb, vname); sb_append_str(sb, " = ")
        emit_c_expr(sb, st, stmt.loop_start)
        sb_append_str(sb, "; "); sb_append_str(sb, vname)
        if is_rev {
            if stmt.is_inclusive { sb_append_str(sb, " >= ") } else { sb_append_str(sb, " > ") }
        } else {
            if stmt.is_inclusive { sb_append_str(sb, " <= ") } else { sb_append_str(sb, " < ") }
        }
        emit_c_expr(sb, st, stmt.loop_end)
        sb_append_str(sb, "; "); sb_append_str(sb, vname)
        if stmt.loop_step != null {
            if is_range_step_non_positive(stmt.loop_step) {
                report_error("backend", stmt.loop_step.line, stmt.loop_step.col, "Range loop step must be greater than zero (defense in depth)")
                st.error_count += 1
                return
            }
            if is_rev { sb_append_str(sb, " -= ") } else { sb_append_str(sb, " += ") }
            emit_c_expr(sb, st, stmt.loop_step)
        } else {
            if is_rev { sb_append_str(sb, "--") } else { sb_append_str(sb, "++") }
        }
        sb_append_str(sb, ") {\n")
        return
    }

    // Dynamic range: evaluate start, end, and optional step exactly once into temporaries,
    // and lower runtime dynamic direction selection based on start > end.
    sb_append_str(sb, "for (")
    sb_append_str(sb, c_type)
    sb_append_str(sb, "__start_")
    sb_append_str(sb, vname)
    sb_append_str(sb, " = (")
    emit_c_expr(sb, st, stmt.loop_start)
    sb_append_str(sb, "), __end_")
    sb_append_str(sb, vname)
    sb_append_str(sb, " = (")
    emit_c_expr(sb, st, stmt.loop_end)
    sb_append_str(sb, ")")
    if stmt.loop_step != null {
        sb_append_str(sb, ", __step_")
        sb_append_str(sb, vname)
        sb_append_str(sb, " = (")
        emit_c_expr(sb, st, stmt.loop_step)
        sb_append_str(sb, ")")
    }
    sb_append_str(sb, ", __rev_")
    sb_append_str(sb, vname)
    sb_append_str(sb, " = (__start_")
    sb_append_str(sb, vname)
    sb_append_str(sb, " > __end_")
    sb_append_str(sb, vname)
    sb_append_str(sb, "), ")
    sb_append_str(sb, vname)
    sb_append_str(sb, " = __start_")
    sb_append_str(sb, vname)
    sb_append_str(sb, "; ")

    // Runtime condition: __rev ? (v > end) : (v < end) [or >= and <= for inclusive]
    sb_append_str(sb, "__rev_")
    sb_append_str(sb, vname)
    sb_append_str(sb, " ? (")
    sb_append_str(sb, vname)
    if stmt.is_inclusive {
        sb_append_str(sb, " >= __end_")
    } else {
        sb_append_str(sb, " > __end_")
    }
    sb_append_str(sb, vname)
    sb_append_str(sb, ") : (")
    sb_append_str(sb, vname)
    if stmt.is_inclusive {
        sb_append_str(sb, " <= __end_")
    } else {
        sb_append_str(sb, " < __end_")
    }
    sb_append_str(sb, vname)
    sb_append_str(sb, "); ")

    // Runtime increment: __rev ? (v -= step) : (v += step) [or -- and ++]
    sb_append_str(sb, "__rev_")
    sb_append_str(sb, vname)
    sb_append_str(sb, " ? (")
    sb_append_str(sb, vname)
    if stmt.loop_step != null {
        sb_append_str(sb, " -= __step_")
        sb_append_str(sb, vname)
        sb_append_str(sb, ") : (")
        sb_append_str(sb, vname)
        sb_append_str(sb, " += __step_")
        sb_append_str(sb, vname)
    } else {
        sb_append_str(sb, "--) : (")
        sb_append_str(sb, vname)
        sb_append_str(sb, "++")
    }
    sb_append_str(sb, ")")
    sb_append_str(sb, ") {\n")
}

// Emits a runtime guard at the start of the loop body for dynamic range steps,
// guaranteeing that steps <= 0 (or == 0 for unsigned) fail fast before any iteration.
act emit_range_step_guard(sb: @StringBuilder, stmt: @StmtNode, vname: string, indent: i32) {
    if stmt == null or stmt.loop_step == null { return }
    if is_literal_range_step(stmt.loop_start, stmt.loop_end, stmt.loop_step) { return }

    sb_append_indent(sb, indent)
    sb_append_str(sb, "if (__step_")
    sb_append_str(sb, vname)
    if is_unsigned_int_name(stmt.type_name) {
        sb_append_str(sb, " == 0) { ")
    } else {
        sb_append_str(sb, " <= 0) { ")
    }
    sb_append_str(sb, "velo_panic_range_step(")
    mut num_sb = create_sb(16)
    sb_append_int(@num_sb, stmt.loop_step.line)
    sb_append_str(sb, sb_to_string(@num_sb))
    sb_append_str(sb, ", ")
    mut col_sb = create_sb(16)
    sb_append_int(@col_sb, stmt.loop_step.col)
    sb_append_str(sb, sb_to_string(@col_sb))
    sb_append_str(sb, "); }\n")
}

