// C99 statement code generator for Velo AST statements.
use "../frontend/token.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../analysis/symbol_table.vl"
use "../analysis/type_checker.vl"
use "../analysis/map_checks.vl"
use "../common/string_builder.vl"
use "../analysis/op_resolver.vl"
use "../analysis/narrow_flow.vl"
use "codegen_expr.vl"
use "shelf_gen.vl"
use "map_gen.vl"
use "shelf_calls_gen.vl"
use "ring_gen.vl"
use "simd_gen.vl"
use "codegen_line.vl"
use "codegen_match.vl"
use "outcome_gen.vl"
use "array_gen.vl"

// Intrusive linked list node maintaining active LIFO deferred statements and zone cleanups.
data DeferNode {
    is_zone: bool
    is_loop: bool
    stmt: @StmtNode
    zone_id: usize
    zone_has_expr: bool
    zone_is_arena: bool
    next: @DeferNode
}

// Pushes a loop boundary marker onto the LIFO cleanup stack.
act push_loop_scope(defers: @@DeferNode) -> @DeferNode {
    let prev = defers.@
    mut ld: @DeferNode = mem.alloc(@DeferNode, 1)
    ld.is_loop = true; ld.is_zone = false; ld.stmt = null; ld.zone_id = 0
    ld.zone_has_expr = false; ld.zone_is_arena = false; ld.next = defers.@
    defers.@ = ld
    return prev
}

// Pops the loop boundary marker from the LIFO cleanup stack.
act pop_loop_scope(defers: @@DeferNode, prev: @DeferNode) {
    defers.@ = prev
}

// Emits an individual deferred statement or zone scope cleanup.
act emit_c_cleanup(sb: @StringBuilder, st: @SymbolTable, cur_d: @DeferNode, indent: i32, defers: @@DeferNode) {
    if cur_d == null or cur_d.is_loop { return }
    if not cur_d.is_zone {
        emit_c_stmt(sb, st, cur_d.stmt, indent, defers)
    } else {
        sb_append_indent(sb, indent); sb_append_str(sb, "velo_zone_pop(__zone_wm_"); sb_append_int(sb, cur_d.zone_id as i32); sb_append_str(sb, ");\n")
        if cur_d.zone_has_expr {
            sb_append_indent(sb, indent)
            if cur_d.zone_is_arena { sb_append_str(sb, "velo_zone_leave_arena(__zone_prev_") }
            else { sb_append_str(sb, "velo_zone_leave(__zone_prev_") }
            sb_append_int(sb, cur_d.zone_id as i32); sb_append_str(sb, ");\n")
        }
    }
}

// Emits statements inside a block node.
act emit_c_block_stmts(sb: @StringBuilder, st: @SymbolTable, block: @StmtNode, indent: i32, defers: @@DeferNode) {
    if block == null { return }
    enter_scope(st)
    mut cur = block.first_stmt
    loop cur != null {
        emit_c_stmt(sb, st, cur, indent, defers)
        if cur.kind == STMT_IF and cur.else_branch == null and stmt_unconditionally_exits(cur.body) {
            apply_flow_narrowing(st, cur.expr, false)
        }
        cur = cur.next
    }
    exit_scope(st)
}

// Emits an individual statement into the C output stream.
act emit_c_stmt(sb: @StringBuilder, st: @SymbolTable, stmt: @StmtNode, indent: i32, defers: @@DeferNode) {
    if stmt == null { return }
    if stmt.kind != STMT_DEFER { emit_line_directive(sb, st, stmt.line) }

    // 1. Variable declaration
    if stmt.kind == STMT_VAR_DECL {
        if is_fixed_array_type(stmt.type_name) { emit_array_var_decl(sb, st, stmt, indent); return }
        if stmt.val_expr != null and stmt.val_expr.kind == EXPR_OR_RETURN {
            emit_or_return_var_decl(sb, st, stmt, indent, defers)
            return
        }
        define_variable(st, stmt.name, stmt.type_name, stmt.is_mut, stmt.line, stmt.col)
        sb_append_indent(sb, indent); sb_append_str(sb, map_type_to_c(stmt.type_name)); sb_append_char(sb, ' '); sb_append_str(sb, stmt.name)
        if stmt.val_expr != null {
            sb_append_str(sb, " = ")
            if is_optional_type(stmt.type_name) {
                let inner = optional_inner_type(stmt.type_name)
                if inner[0] != '@' and inner != "string" {
                    let val_t = infer_expr_type(st, stmt.val_expr)
                    let opt_c = opt_type_c_name(stmt.type_name)
                    if stmt.val_expr.kind == EXPR_NULL {
                        sb_append_char(sb, '('); sb_append_str(sb, opt_c); sb_append_str(sb, "){ .has = false }")
                    } else if not is_optional_type(val_t) {
                        sb_append_char(sb, '('); sb_append_str(sb, opt_c); sb_append_str(sb, "){ .has = true, .val = "); emit_c_expr(sb, st, stmt.val_expr); sb_append_str(sb, " }")
                    } else { emit_c_expr(sb, st, stmt.val_expr) }
                } else { emit_c_expr(sb, st, stmt.val_expr) }
            } else { emit_c_expr(sb, st, stmt.val_expr) }
        }
        sb_append_str(sb, ";\n"); return
    }

    // 2. Assignment statement
    if stmt.kind == STMT_ASSIGN {
        if stmt.expr != null and stmt.op == TOK_ASSIGN and is_fixed_array_type(infer_expr_type(st, stmt.expr)) {
            emit_array_assign(sb, st, stmt, indent); return
        }
        if stmt.val_expr != null and stmt.val_expr.kind == EXPR_OR_RETURN {
            emit_or_return_assign(sb, st, stmt, indent, defers)
            return
        }
        if is_simd_assign(st, stmt) { emit_simd_assign(sb, st, stmt, indent); return }
        // 5.2 slice 6: map indexed writes (m[k] = v) lower onto velo_map_put
        if stmt.expr != null and stmt.expr.kind == EXPR_INDEX {
            if is_map_form(infer_expr_type(st, stmt.expr.target)) { emit_map_set(sb, st, stmt, indent); return }
            if is_shelf_form(infer_expr_type(st, stmt.expr.target)) { emit_shelf_set(sb, st, stmt, indent); return }
        }
        let base_op = get_base_assign_op(stmt.op)
        if base_op != 0 and st.has_operator_overloads {
            let target_t = infer_expr_type(st, stmt.expr)
            let val_t = infer_expr_type(st, stmt.val_expr)
            let op_fn = find_binary_op(st, base_op, target_t, val_t)
            if op_fn != null {
                sb_append_indent(sb, indent)
                emit_c_expr(sb, st, stmt.expr)
                sb_append_str(sb, " = ")
                sb_append_str(sb, op_fn.name)
                sb_append_char(sb, '(')
                let p0 = op_fn.first_param
                mut p1: @ParamSym = null
                if p0 != null { p1 = p0.next }
                let p0_ptr = p0 != null and str.len(p0.type_name) > 0 and p0.type_name[0] == '@'
                let t_ptr = str.len(target_t) > 0 and target_t[0] == '@'
                if p0_ptr and not t_ptr { sb_append_str(sb, "&(") }
                if t_ptr and not p0_ptr { sb_append_str(sb, "*(") }
                emit_c_expr(sb, st, stmt.expr)
                if (p0_ptr and not t_ptr) or (t_ptr and not p0_ptr) { sb_append_char(sb, ')') }
                sb_append_str(sb, ", ")
                let p1_ptr = p1 != null and str.len(p1.type_name) > 0 and p1.type_name[0] == '@'
                let v_ptr = str.len(val_t) > 0 and val_t[0] == '@'
                if p1_ptr and not v_ptr { sb_append_str(sb, "&(") }
                if v_ptr and not p1_ptr { sb_append_str(sb, "*(") }
                emit_c_expr(sb, st, stmt.val_expr)
                if (p1_ptr and not v_ptr) or (v_ptr and not p1_ptr) { sb_append_char(sb, ')') }
                sb_append_str(sb, ");\n")
                return
            }
        }
        let target_t = infer_expr_type(st, stmt.expr)
        if stmt.op == TOK_PLUS_ASSIGN and target_t == "string" {
            sb_append_indent(sb, indent); emit_c_expr(sb, st, stmt.expr); sb_append_str(sb, " = velo_str_concat(")
            emit_c_expr(sb, st, stmt.expr); sb_append_str(sb, ", "); emit_c_expr(sb, st, stmt.val_expr); sb_append_str(sb, ");\n")
            return
        }
        if stmt.op == TOK_EQ and is_optional_type(target_t) {
            let inner = optional_inner_type(target_t)
            if inner[0] != '@' and inner != "string" {
                let val_t = infer_expr_type(st, stmt.val_expr)
                let opt_c = opt_type_c_name(target_t)
                sb_append_indent(sb, indent)
                emit_c_expr(sb, st, stmt.expr)
                sb_append_str(sb, " = ")
                if stmt.val_expr.kind == EXPR_NULL {
                    sb_append_char(sb, '('); sb_append_str(sb, opt_c); sb_append_str(sb, "){ .has = false };\n")
                } else if not is_optional_type(val_t) {
                    sb_append_char(sb, '('); sb_append_str(sb, opt_c); sb_append_str(sb, "){ .has = true, .val = "); emit_c_expr(sb, st, stmt.val_expr); sb_append_str(sb, " };\n")
                } else {
                    emit_c_expr(sb, st, stmt.val_expr); sb_append_str(sb, ";\n")
                }
                return
            }
        }
        sb_append_indent(sb, indent); emit_c_expr(sb, st, stmt.expr); sb_append_char(sb, ' '); sb_append_str(sb, map_assign_op(stmt.op))
        sb_append_char(sb, ' '); emit_c_expr(sb, st, stmt.val_expr); sb_append_str(sb, ";\n")
        return
    }

    // 3. Expression statement
    if stmt.kind == STMT_EXPR {
        if stmt.expr != null and stmt.expr.kind == EXPR_OR_RETURN {
            emit_or_return_expr(sb, st, stmt, indent, defers)
            return
        }
        sb_append_indent(sb, indent)
        emit_c_expr(sb, st, stmt.expr)
        sb_append_str(sb, ";\n")
        return
    }

    // 4. If / Else statement
    if stmt.kind == STMT_IF {
        sb_append_indent(sb, indent)
        sb_append_str(sb, "if ("); emit_c_expr(sb, st, stmt.expr); sb_append_str(sb, ") {\n")
        enter_scope(st)
        apply_flow_narrowing(st, stmt.expr, true)
        emit_c_block_stmts(sb, st, stmt.body, indent + 1, defers)
        exit_scope(st)
        sb_append_indent(sb, indent); sb_append_str(sb, "}")
        if stmt.else_branch != null {
            if stmt.else_branch.kind == STMT_IF {
                if not st.no_line_directives and stmt.else_branch.line > 0 { sb_append_str(sb, " else\n") } else { sb_append_str(sb, " else ") }
                emit_c_stmt(sb, st, stmt.else_branch, indent, defers)
            } else {
                sb_append_str(sb, " else {\n")
                enter_scope(st)
                apply_flow_narrowing(st, stmt.expr, false)
                emit_c_block_stmts(sb, st, stmt.else_branch, indent + 1, defers)
                exit_scope(st)
                sb_append_indent(sb, indent); sb_append_str(sb, "}\n")
            }
        } else { sb_append_char(sb, '\n') }
        return
    }

    // 5. Unified loop statement (infinite, repeat, condition, and range)
    if stmt.kind == STMT_LOOP {
        mut vname = "it"
        if stmt.loop_var != null and str.len(stmt.loop_var) > 0 { vname = stmt.loop_var }
        // 5.2: shelf value loop — snapshot iteration with an element-typed var
        if stmt.is_of {
            // 5.2 slice 7: map sources iterate KEYS (K-typed, hash order)
            if is_map_type(infer_expr_type(st, stmt.expr)) {
                emit_map_loop(sb, st, stmt, indent, defers)
                return
            }
            // 5.2 slice 9: ring sources iterate FIFO (front to back)
            if is_ring_type(infer_expr_type(st, stmt.expr)) {
                emit_ring_loop(sb, st, stmt, indent, defers)
                return
            }
            emit_shelf_loop(sb, st, stmt, indent, defers)
            return
        }
        sb_append_indent(sb, indent)
        if stmt.loop_start == null and stmt.loop_end == null {
            if stmt.expr != null {
                mut is_cnt = stmt.is_count
                if not is_cnt and stmt.expr.kind == EXPR_IDENT {
                    let et = infer_expr_type(st, stmt.expr)
                    if et == "i32" or et == "i64" or et == "u32" or et == "usize" { is_cnt = true }
                }
                sb_append_str(sb, "for (int32_t "); sb_append_str(sb, vname); sb_append_str(sb, " = 0; ")
                if is_cnt { sb_append_str(sb, vname); sb_append_str(sb, " < ("); emit_c_expr(sb, st, stmt.expr); sb_append_char(sb, ')') }
                else { sb_append_char(sb, '('); emit_c_expr(sb, st, stmt.expr); sb_append_char(sb, ')') }
                sb_append_str(sb, "; "); sb_append_str(sb, vname); sb_append_str(sb, "++) {\n")
            } else {
                sb_append_str(sb, "for (int32_t "); sb_append_str(sb, vname); sb_append_str(sb, " = 0; ; "); sb_append_str(sb, vname); sb_append_str(sb, "++) {\n")
            }
        } else {
            mut is_rev = false
            if stmt.loop_start.kind == EXPR_INT and stmt.loop_end.kind == EXPR_INT and stmt.loop_start.int_val > stmt.loop_end.int_val { is_rev = true }
            sb_append_str(sb, "for (int32_t "); sb_append_str(sb, vname); sb_append_str(sb, " = ")
            emit_c_expr(sb, st, stmt.loop_start)
            sb_append_str(sb, "; "); sb_append_str(sb, vname)
            if is_rev { if stmt.is_inclusive { sb_append_str(sb, " >= ") } else { sb_append_str(sb, " > ") } } else { if stmt.is_inclusive { sb_append_str(sb, " <= ") } else { sb_append_str(sb, " < ") } }
            emit_c_expr(sb, st, stmt.loop_end)
            sb_append_str(sb, "; "); sb_append_str(sb, vname)
            if stmt.loop_step != null {
                if is_rev { sb_append_str(sb, " -= ") } else { sb_append_str(sb, " += ") }
                emit_c_expr(sb, st, stmt.loop_step)
            } else { if is_rev { sb_append_str(sb, "--") } else { sb_append_str(sb, "++") } }
            sb_append_str(sb, ") {\n")
        }
        enter_scope(st)
        define_variable(st, vname, "i32", false, stmt.line, stmt.col)
        let loop_prev = push_loop_scope(defers)
        emit_c_block_stmts(sb, st, stmt.body, indent + 1, defers)
        pop_loop_scope(defers, loop_prev)
        exit_scope(st)
        sb_append_indent(sb, indent)
        sb_append_str(sb, "}\n")
        return
    }

    // 7. Zone arena scoping (`zone { }`, `zone <bytes> { }`, or `zone <arena> { }`).
    if stmt.kind == STMT_ZONE {
        st.zone_counter += 1
        let zid = st.zone_counter
        sb_append_indent(sb, indent)
        sb_append_str(sb, "{\n")
        sb_append_indent(sb, indent + 1)
        mut is_arena: bool = false
        if stmt.expr != null {
            let et = infer_expr_type(st, stmt.expr)
            if et == "@Allocator" or et == "Allocator" {
                is_arena = true
                sb_append_str(sb, "VeloZoneArena* __zone_prev_")
                sb_append_int(sb, zid as i32)
                sb_append_str(sb, " = velo_zone_enter_arena((VeloZoneArena*)(")
            } else {
                sb_append_str(sb, "VeloZoneArena* __zone_prev_")
                sb_append_int(sb, zid as i32)
                sb_append_str(sb, " = velo_zone_enter((size_t)(")
            }
            emit_c_expr(sb, st, stmt.expr); sb_append_str(sb, "));\n")
            sb_append_indent(sb, indent + 1)
        }
        sb_append_str(sb, "size_t __zone_wm_")
        sb_append_int(sb, zid as i32)
        sb_append_str(sb, " = velo_zone_push();\n")

        let zone_df_target: @DeferNode = defers.@
        mut zd: @DeferNode = mem.alloc(@DeferNode, 1)
        zd.is_zone = true
        zd.is_loop = false
        zd.zone_id = zid
        zd.zone_has_expr = stmt.expr != null
        zd.zone_is_arena = is_arena
        zd.stmt = null
        zd.next = defers.@
        defers.@ = zd

        emit_c_block_stmts(sb, st, stmt.body, indent + 1, defers)
        mut df_cur = defers.@
        loop df_cur != zone_df_target {
            emit_c_cleanup(sb, st, df_cur, indent + 1, defers)
            df_cur = df_cur.next
        }
        defers.@ = zone_df_target
        sb_append_indent(sb, indent)
        sb_append_str(sb, "}\n")
        return
    }

    // 8. Defer statement (records deferred statement on LIFO stack)
    if stmt.kind == STMT_DEFER {
        mut d: @DeferNode = mem.alloc(@DeferNode, 1)
        d.is_zone = false
        d.is_loop = false
        d.stmt = stmt.deferred_stmt
        d.zone_id = 0
        d.zone_has_expr = false
        d.zone_is_arena = false
        d.next = defers.@
        defers.@ = d
        return
    }

    // 9. Return statement (unrolls active defers and zone cleanups in LIFO order)
    if stmt.kind == STMT_RETURN {
        emit_return_stmt(sb, st, stmt, indent, defers)
        return
    }

    // 9.5. Fail statement
    if stmt.kind == STMT_FAIL {
        emit_fail_stmt(sb, st, stmt, indent, defers)
        return
    }

    // 10. Break statement (unrolls loop-local zone cleanups before breaking)
    if stmt.kind == STMT_BREAK {
        mut cur_d = defers.@
        loop cur_d != null and not cur_d.is_loop {
            emit_c_cleanup(sb, st, cur_d, indent, defers)
            cur_d = cur_d.next
        }
        sb_append_indent(sb, indent); sb_append_str(sb, "break;\n"); return
    }

    // 11. Continue statement (unrolls loop-local zone cleanups before continuing)
    if stmt.kind == STMT_CONTINUE {
        mut cur_d = defers.@
        loop cur_d != null and not cur_d.is_loop {
            emit_c_cleanup(sb, st, cur_d, indent, defers)
            cur_d = cur_d.next
        }
        sb_append_indent(sb, indent); sb_append_str(sb, "continue;\n"); return
    }

    // 11.5. Nested Block statement (unrolled loops, scoped blocks)
    if stmt.kind == STMT_BLOCK {
        sb_append_indent(sb, indent); sb_append_str(sb, "{\n")
        emit_c_block_stmts(sb, st, stmt, indent + 1, defers)
        sb_append_indent(sb, indent); sb_append_str(sb, "}\n"); return
    }

    // 12. Match / Switch statement
    if stmt.kind == STMT_MATCH {
        emit_match_stmt(sb, st, stmt, indent, defers)
        return
    }
}
