// CLI command handlers for `velo run` and `velo build`.
use std.io
use "backend/driver.vl"
use "backend/driver_determinism.vl"
use "common/string_builder.vl"
use "common/utils.vl"

// Prints the command-line usage manual.
act print_usage() {
    println_str("Velo Programming Language Compiler (Self-Hosted v2.0)")
    println_str("Usage:")
    println_str("  velo run <source.vl> [--cc gcc|clang|cl] [-l<lib>] [-L<dir>] [--debug|--release|--profile] [-O<level>] [--no-line-directives] [--unsafe-heap]")
    println_str("  velo build <source.vl> [-o <bin>] [--verify-determinism] [--cc gcc|clang|cl] [-l<lib>] [-L<dir>] [--debug|--release|--profile] [--no-line-directives] [--unsafe-heap]")
    println_str("  velo emit-c <source.vl> [-o <out.c>] [--no-line-directives] Emit generated C99 code")
    println_str("  velo check <source.vl> [--json] [--color auto|always|never]")
    println_str("  velo doc <source.vl> [-o <out>] [--json] Extract API documentation to Markdown or JSON")
    println_str("  velo test [path] [--cc gcc|clang|cl] [--filter <pattern>] Run native tests")
    println_str("  velo pkg check [path]              Validate a velo.pkg package manifest")
    println_str("  velo pkg lock [path]               Generate or update velo.lock with dependency hashes")
    println_str("  velo pkg install [path]            Install and verify dependencies against velo.lock")
    println_str("  velo pkg update [path]             Update dependencies and regenerate velo.lock")
    println_str("  velo pkg tree [path]               Display dependency tree")
    println_str("  velo pkg verify [path]             Verify dependencies and report drift (read-only)")
    println_str("  velo pkg publish [path]            Package and generate registry index entry to paste")
    println_str("  velo pkg build [path] [-o <bin>]   Build project defined by velo.pkg")
    println_str("  velo pkg run [path] [-- args...]   Build and run project defined by velo.pkg")
    println_str("  velo fmt [path] [--check]          Format Velo source files canonically")
    println_str("  velo explain <code-or-id>          Explain compiler diagnostic code")
    println_str("  velo repl                          Start interactive Velo REPL")
    println_str("  velo lsp                           Start Velo Language Server (LSP stdio)")
    println_str("  velo version                       Display compiler version")
    println_str("  velo help                          Display this help manual")
}

// Handles `velo run <source.vl> [opts...]`.
act handle_run_cmd_opts(argc: i32, argv: @string, unsafe_index: bool, no_line_directives: bool, strict_safety: bool) -> i32 {
    if argc < 3 {
        println_str("[Velo Error] 'run' requires a source file path")
        return 1
    }
    mut source_file = ""
    mut cc = "gcc"
    mut debug_mode: bool = false
    mut release_mode: bool = false
    mut profile_mode: bool = false
    mut unsafe_heap: bool = false
    mut opt_level = ""
    mut linker_sb = create_sb(256)
    mut i: i32 = 2
    loop i < argc {
        let arg = argv[i]
        if arg == "--cc" and i + 1 < argc {
            cc = argv[i + 1]
            i += 1
        } else if str.len(arg) > 5 and arg[0] == '-' and arg[1] == '-' and arg[2] == 'c' and arg[3] == 'c' and arg[4] == '=' {
            cc = copy_slice_to_string(arg, 5, str.len(arg) - 5)
        } else if arg == "--debug" {
            debug_mode = true
        } else if arg == "--release" {
            release_mode = true
        } else if arg == "--profile" {
            profile_mode = true
        } else if arg == "--unsafe-heap" {
            unsafe_heap = true
        } else if arg == "-O" and i + 1 < argc {
            opt_level = argv[i + 1]
            i += 1
        } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'O' {
            opt_level = copy_slice_to_string(arg, 2, str.len(arg) - 2)
        } else if arg == "-l" and i + 1 < argc {
            if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
            sb_append_str(@linker_sb, "-l")
            sb_append_str(@linker_sb, argv[i + 1])
            i += 1
        } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'l' {
            if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
            sb_append_str(@linker_sb, arg)
        } else if arg == "-L" and i + 1 < argc {
            if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
            sb_append_str(@linker_sb, "-L")
            sb_append_str(@linker_sb, quote_path(path_to_native_str(argv[i + 1])))
            i += 1
        } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'L' {
            if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
            sb_append_str(@linker_sb, "-L")
            let raw_arg = copy_slice_to_string(arg, 2, str.len(arg) - 2)
            sb_append_str(@linker_sb, quote_path(path_to_native_str(raw_arg)))
        } else if arg != "--unsafe-shelf-index" and arg != "--unsafe-array-index" and arg != "--unsafe-index" and arg != "--unsafe-heap" and arg != "--no-line-directives" and arg != "--strict-safety" and str.len(source_file) == 0 {
            source_file = arg
        }
        i += 1
    }
    if str.len(source_file) == 0 {
        println_str("[Velo Error] 'run' requires a source file path")
        return 1
    }
    if cc != "gcc" and cc != "cl" and cc != "clang" {
        println_str("[Velo Error] Unknown C compiler backend '{cc}'. Expected 'gcc', 'clang', or 'cl'.")
        return 1
    }
    if (debug_mode and release_mode) or (debug_mode and profile_mode) or (release_mode and profile_mode) {
        println_str("[Velo Error] Cannot combine conflicting build modes (--debug, --release, --profile)")
        return 1
    }
    mut opt_flags = resolve_opt_flags(debug_mode, release_mode, opt_level)
    if profile_mode {
        mut p_sb = create_sb(str.len(opt_flags) + 16)
        sb_append_str(@p_sb, opt_flags); sb_append_str(@p_sb, " -pg"); opt_flags = sb_to_string(@p_sb)
    }
    if unsafe_heap {
        mut u_sb = create_sb(str.len(opt_flags) + 32)
        sb_append_str(@u_sb, opt_flags); sb_append_str(@u_sb, " -DVELO_UNSAFE_HEAP"); opt_flags = sb_to_string(@u_sb)
    }
    let linker_flags = sb_to_string(@linker_sb)
    mut exit_code = 0
    zone {
        exit_code = run_source_file_all_opts(source_file, unsafe_index, opt_flags, linker_flags, cc, no_line_directives, strict_safety)
    }
    return exit_code
}

act handle_run_cmd(argc: i32, argv: @string, unsafe_index: bool, no_line_directives: bool) -> i32 {
    return handle_run_cmd_opts(argc, argv, unsafe_index, no_line_directives, false)
}

// Handles `velo build <source.vl> [opts...]`.
act handle_build_cmd_opts(argc: i32, argv: @string, unsafe_index: bool, no_line_directives: bool, strict_safety: bool) -> i32 {
    if argc < 3 {
        println_str("[Velo Error] 'build' requires a source file path")
        return 1
    }
    mut source_file = ""
    mut output_exe = ""
    mut cc = "gcc"
    mut debug_mode: bool = false
    mut release_mode: bool = false
    mut profile_mode: bool = false
    mut unsafe_heap: bool = false
    mut verify_determinism: bool = false
    mut opt_level = ""
    mut linker_sb = create_sb(256)
    mut i: i32 = 2
    loop i < argc {
        let arg = argv[i]
        if arg == "--cc" and i + 1 < argc {
            cc = argv[i + 1]
            i += 1
        } else if str.len(arg) > 5 and arg[0] == '-' and arg[1] == '-' and arg[2] == 'c' and arg[3] == 'c' and arg[4] == '=' {
            cc = copy_slice_to_string(arg, 5, str.len(arg) - 5)
        } else if arg == "-o" and i + 1 < argc {
            output_exe = argv[i + 1]
            i += 1
        } else if arg == "--debug" {
            debug_mode = true
        } else if arg == "--release" {
            release_mode = true
        } else if arg == "--profile" {
            profile_mode = true
        } else if arg == "--unsafe-heap" {
            unsafe_heap = true
        } else if arg == "--verify-determinism" {
            verify_determinism = true
        } else if arg == "-O" and i + 1 < argc {
            opt_level = argv[i + 1]
            i += 1
        } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'O' {
            opt_level = copy_slice_to_string(arg, 2, str.len(arg) - 2)
        } else if arg == "-l" and i + 1 < argc {
            if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
            sb_append_str(@linker_sb, "-l")
            sb_append_str(@linker_sb, argv[i + 1])
            i += 1
        } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'l' {
            if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
            sb_append_str(@linker_sb, arg)
        } else if arg == "-L" and i + 1 < argc {
            if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
            sb_append_str(@linker_sb, "-L")
            sb_append_str(@linker_sb, quote_path(path_to_native_str(argv[i + 1])))
            i += 1
        } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'L' {
            if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
            sb_append_str(@linker_sb, "-L")
            let raw_arg = copy_slice_to_string(arg, 2, str.len(arg) - 2)
            sb_append_str(@linker_sb, quote_path(path_to_native_str(raw_arg)))
        } else if arg != "--unsafe-shelf-index" and arg != "--unsafe-array-index" and arg != "--unsafe-index" and arg != "--unsafe-heap" and arg != "--no-line-directives" and arg != "--strict-safety" and str.len(source_file) == 0 {
            source_file = arg
        }
        i += 1
    }
    if verify_determinism and str.len(source_file) == 0 {
        if fs_exists("src/main.vl") {
            source_file = "src/main.vl"
        }
    }
    if str.len(source_file) == 0 {
        println_str("[Velo Error] 'build' requires a source file path")
        return 1
    }
    if cc != "gcc" and cc != "cl" and cc != "clang" {
        println_str("[Velo Error] Unknown C compiler backend '{cc}'. Expected 'gcc', 'clang', or 'cl'.")
        return 1
    }
    if (debug_mode and release_mode) or (debug_mode and profile_mode) or (release_mode and profile_mode) {
        println_str("[Velo Error] Cannot combine conflicting build modes (--debug, --release, --profile)")
        return 1
    }
    mut opt_flags = resolve_opt_flags(debug_mode, release_mode, opt_level)
    if profile_mode {
        mut p_sb = create_sb(str.len(opt_flags) + 16)
        sb_append_str(@p_sb, opt_flags); sb_append_str(@p_sb, " -pg"); opt_flags = sb_to_string(@p_sb)
    }
    if unsafe_heap {
        mut u_sb = create_sb(str.len(opt_flags) + 32)
        sb_append_str(@u_sb, opt_flags); sb_append_str(@u_sb, " -DVELO_UNSAFE_HEAP"); opt_flags = sb_to_string(@u_sb)
    }
    let linker_flags = sb_to_string(@linker_sb)
    if verify_determinism {
        mut det_rc = 0
        zone {
            det_rc = verify_build_determinism(source_file, output_exe, unsafe_index, opt_flags, linker_flags, cc, no_line_directives, strict_safety)
        }
        return det_rc
    }
    mut ok = false
    zone {
        ok = build_executable_all_opts(source_file, output_exe, unsafe_index, opt_flags, linker_flags, cc, no_line_directives, strict_safety)
        if ok {
            println_str("[Velo] Successfully built binary!")
        } else {
            println_str("[Velo Error] Build failed.")
        }
    }
    if ok {
        return 0
    }
    return 1
}

act handle_build_cmd(argc: i32, argv: @string, unsafe_index: bool, no_line_directives: bool) -> i32 {
    return handle_build_cmd_opts(argc, argv, unsafe_index, no_line_directives, false)
}
