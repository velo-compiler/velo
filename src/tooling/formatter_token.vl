// Lexical token scanner for the Velo standalone code formatter.
use "../common/utils.vl"

let FMT_TOK_EOF: i32 = 0
let FMT_TOK_NEWLINE: i32 = 1
let FMT_TOK_COMMENT_LINE: i32 = 2
let FMT_TOK_COMMENT_BLOCK: i32 = 3
let FMT_TOK_STRING: i32 = 4
let FMT_TOK_RAW_STRING: i32 = 5
let FMT_TOK_CHAR: i32 = 6
let FMT_TOK_NUMBER: i32 = 7
let FMT_TOK_IDENT: i32 = 8
let FMT_TOK_KEYWORD: i32 = 9
let FMT_TOK_SYMBOL: i32 = 10

data FmtToken {
    kind: i32
    text: string
    line: i32
    col: i32
}

data FmtTokenList {
    tokens: @FmtToken
    len: usize
    cap: usize
}

act create_fmt_token_list(initial_cap: usize) -> FmtTokenList {
    mut cap = initial_cap
    if cap < 128 { cap = 128 }
    mut buf: @FmtToken = mem.alloc(@FmtToken, cap)
    return FmtTokenList{
        tokens: buf,
        len: 0,
        cap: cap,
    }
}

act add_fmt_token(list: @FmtTokenList, kind: i32, text: string, line: i32, col: i32) {
    if list.len >= list.cap {
        let new_cap = list.cap * 2
        mut new_buf: @FmtToken = mem.alloc(@FmtToken, new_cap)
        mut k: usize = 0
        loop k < list.len {
            new_buf[k] = list.tokens[k]
            k += 1
        }
        list.tokens = new_buf
        list.cap = new_cap
    }
    list.tokens[list.len] = FmtToken{
        kind: kind,
        text: text,
        line: line,
        col: col,
    }
    list.len += 1
}

act check_fmt_keyword(source: string, start: usize, len: usize) -> bool {
    if len == 2 {
        if source[start] == 'i' and source[start + 1] == 'f' { return true }
        if source[start] == 'i' and source[start + 1] == 'n' { return true }
        if source[start] == 'a' and source[start + 1] == 's' { return true }
        if source[start] == 'o' and source[start + 1] == 'r' { return true }
        if source[start] == 'o' and source[start + 1] == 'n' { return true }
        if source[start] == 'o' and source[start + 1] == 'p' { return true }
        if source[start] == 'o' and source[start + 1] == 'f' { return true }
    } else if len == 3 {
        if source[start] == 'a' and source[start + 1] == 'c' and source[start + 2] == 't' { return true }
        if source[start] == 'm' and source[start + 1] == 'u' and source[start + 2] == 't' { return true }
        if source[start] == 'l' and source[start + 1] == 'e' and source[start + 2] == 't' { return true }
        if source[start] == 'u' and source[start + 1] == 's' and source[start + 2] == 'e' { return true }
        if source[start] == 'a' and source[start + 1] == 'n' and source[start + 2] == 'd' { return true }
        if source[start] == 'n' and source[start + 1] == 'o' and source[start + 2] == 't' { return true }
        if source[start] == 'm' and source[start + 1] == 'a' and source[start + 2] == 'p' { return true }
    } else if len == 4 {
        if source[start] == 'd' and source[start + 1] == 'a' and source[start + 2] == 't' and source[start + 3] == 'a' { return true }
        if source[start] == 'e' and source[start + 1] == 'l' and source[start + 2] == 's' and source[start + 3] == 'e' { return true }
        if source[start] == 'l' and source[start + 1] == 'o' and source[start + 2] == 'o' and source[start + 3] == 'p' { return true }
        if source[start] == 'z' and source[start + 1] == 'o' and source[start + 2] == 'n' and source[start + 3] == 'e' { return true }
        if source[start] == 't' and source[start + 1] == 'r' and source[start + 2] == 'u' and source[start + 3] == 'e' { return true }
        if source[start] == 'n' and source[start + 1] == 'u' and source[start + 2] == 'l' and source[start + 3] == 'l' { return true }
        if source[start] == 'k' and source[start + 1] == 'i' and source[start + 2] == 'n' and source[start + 3] == 'd' { return true }
        if source[start] == 'r' and source[start + 1] == 'i' and source[start + 2] == 'n' and source[start + 3] == 'g' { return true }
        if source[start] == 'h' and source[start + 1] == 'e' and source[start + 2] == 'a' and source[start + 3] == 'p' { return true }
        if source[start] == 't' and source[start + 1] == 'e' and source[start + 2] == 's' and source[start + 3] == 't' { return true }
        if source[start] == 'f' and source[start + 1] == 'a' and source[start + 2] == 'i' and source[start + 3] == 'l' { return true }
    } else if len == 5 {
        if source[start] == 'd' and source[start + 1] == 'e' and source[start + 2] == 'f' and source[start + 3] == 'e' and source[start + 4] == 'r' { return true }
        if source[start] == 'f' and source[start + 1] == 'a' and source[start + 2] == 'l' and source[start + 3] == 's' and source[start + 4] == 'e' { return true }
        if source[start] == 'b' and source[start + 1] == 'r' and source[start + 2] == 'e' and source[start + 3] == 'a' and source[start + 4] == 'k' { return true }
        if source[start] == 's' and source[start + 1] == 'h' and source[start + 2] == 'e' and source[start + 3] == 'l' and source[start + 4] == 'f' { return true }
    } else if len == 6 {
        if source[start] == 'r' and source[start + 1] == 'e' and source[start + 2] == 't' and source[start + 3] == 'u' and source[start + 4] == 'r' and source[start + 5] == 'n' { return true }
        if source[start] == 'e' and source[start + 1] == 'x' and source[start + 2] == 't' and source[start + 3] == 'e' and source[start + 4] == 'r' and source[start + 5] == 'n' { return true }
        if source[start] == 'b' and source[start + 1] == 'i' and source[start + 2] == 't' and source[start + 3] == 's' and source[start + 4] == 'e' and source[start + 5] == 't' { return true }
        if source[start] == 'u' and source[start + 1] == 'n' and source[start + 2] == 's' and source[start + 3] == 'a' and source[start + 4] == 'f' and source[start + 5] == 'e' { return true }
    } else if len == 8 {
        if source[start] == 'c' and source[start + 1] == 'o' and source[start + 2] == 'n' and source[start + 3] == 't' and source[start + 4] == 'i' and source[start + 5] == 'n' and source[start + 6] == 'u' and source[start + 7] == 'e' { return true }
    }
    return false
}

act tokenize_for_fmt(source: string) -> FmtTokenList {
    mut list = create_fmt_token_list(512)
    if source == null { return list }
    let n = str.len(source)
    mut i: usize = 0
    mut line: i32 = 1
    mut col: i32 = 1

    loop i < n {
        let c = source[i]
        let start_pos = i
        let start_line = line
        let start_col = col

        if c == '\n' {
            add_fmt_token(@list, FMT_TOK_NEWLINE, "\n", start_line, start_col)
            i += 1
            line += 1
            col = 1
        } else if c == '\r' {
            if i + 1 < n and source[i + 1] == '\n' {
                add_fmt_token(@list, FMT_TOK_NEWLINE, "\n", start_line, start_col)
                i += 2
                line += 1
                col = 1
            } else {
                add_fmt_token(@list, FMT_TOK_NEWLINE, "\n", start_line, start_col)
                i += 1
                line += 1
                col = 1
            }
        } else if is_whitespace(c) {
            i += 1
            col += 1
        } else if c == '/' and i + 1 < n and source[i + 1] == '/' {
            loop i < n and source[i] != '\n' and source[i] != '\r' {
                i += 1
            }
            let text = copy_slice_to_string(source, start_pos, i - start_pos)
            add_fmt_token(@list, FMT_TOK_COMMENT_LINE, text, start_line, start_col)
            col += (i - start_pos) as i32
        } else if c == '/' and i + 1 < n and source[i + 1] == '*' {
            i += 2
            col += 2
            mut depth: usize = 1
            loop i + 1 < n and depth > 0 {
                if source[i] == '/' and source[i + 1] == '*' {
                    depth += 1
                    i += 2
                    col += 2
                } else if source[i] == '*' and source[i + 1] == '/' {
                    depth -= 1
                    i += 2
                    col += 2
                } else if source[i] == '\n' {
                    i += 1
                    line += 1
                    col = 1
                } else {
                    i += 1
                    col += 1
                }
            }
            if depth > 0 { i = n }
            let text = copy_slice_to_string(source, start_pos, i - start_pos)
            add_fmt_token(@list, FMT_TOK_COMMENT_BLOCK, text, start_line, start_col)
        } else if c == '`' {
            i += 1
            col += 1
            loop i < n and source[i] != '`' {
                if source[i] == '\n' {
                    line += 1
                    col = 1
                } else {
                    col += 1
                }
                i += 1
            }
            if i < n { i += 1; col += 1 }
            let text = copy_slice_to_string(source, start_pos, i - start_pos)
            add_fmt_token(@list, FMT_TOK_RAW_STRING, text, start_line, start_col)
        } else if c == '"' {
            i += 1
            col += 1
            loop i < n and source[i] != '"' {
                if source[i] == '\\' and i + 1 < n {
                    i += 2
                    col += 2
                } else if source[i] == '\n' or source[i] == '\r' {
                    break
                } else {
                    i += 1
                    col += 1
                }
            }
            if i < n and source[i] == '"' { i += 1; col += 1 }
            let text = copy_slice_to_string(source, start_pos, i - start_pos)
            add_fmt_token(@list, FMT_TOK_STRING, text, start_line, start_col)
        } else if c == '\'' {
            i += 1
            col += 1
            loop i < n and source[i] != '\'' {
                if source[i] == '\\' and i + 1 < n {
                    i += 2
                    col += 2
                } else if source[i] == '\n' or source[i] == '\r' {
                    break
                } else {
                    i += 1
                    col += 1
                }
            }
            if i < n and source[i] == '\'' { i += 1; col += 1 }
            let text = copy_slice_to_string(source, start_pos, i - start_pos)
            add_fmt_token(@list, FMT_TOK_CHAR, text, start_line, start_col)
        } else if is_ident_start(c) {
            loop i < n and is_ident_part(source[i]) {
                i += 1
                col += 1
            }
            let tok_len = i - start_pos
            let is_kw = check_fmt_keyword(source, start_pos, tok_len)
            let text = copy_slice_to_string(source, start_pos, tok_len)
            if is_kw {
                add_fmt_token(@list, FMT_TOK_KEYWORD, text, start_line, start_col)
            } else {
                add_fmt_token(@list, FMT_TOK_IDENT, text, start_line, start_col)
            }
        } else if is_digit(c) {
            if c == '0' and i + 1 < n and (source[i + 1] == 'x' or source[i + 1] == 'X' or source[i + 1] == 'b' or source[i + 1] == 'B' or source[i + 1] == 'o' or source[i + 1] == 'O') {
                i += 2
                col += 2
                loop i < n and (is_digit(source[i]) or (source[i] >= 'a' and source[i] <= 'f') or (source[i] >= 'A' and source[i] <= 'F') or source[i] == '_') {
                    i += 1
                    col += 1
                }
            } else {
                loop i < n and (is_digit(source[i]) or source[i] == '_') {
                    i += 1
                    col += 1
                }
                if i + 1 < n and source[i] == '.' and is_digit(source[i + 1]) {
                    i += 2
                    col += 2
                    loop i < n and (is_digit(source[i]) or source[i] == '_') {
                        i += 1
                        col += 1
                    }
                }
                if i < n and (source[i] == 'e' or source[i] == 'E') {
                    i += 1
                    col += 1
                    if i < n and (source[i] == '+' or source[i] == '-') {
                        i += 1
                        col += 1
                    }
                    loop i < n and is_digit(source[i]) {
                        i += 1
                        col += 1
                    }
                }
            }
            if i < n and is_alpha(source[i]) {
                loop i < n and is_ident_part(source[i]) {
                    i += 1
                    col += 1
                }
            }
            let text = copy_slice_to_string(source, start_pos, i - start_pos)
            add_fmt_token(@list, FMT_TOK_NUMBER, text, start_line, start_col)
        } else {
            mut sym_len: usize = 1
            if i + 2 < n {
                let c0 = source[i]
                let c1 = source[i + 1]
                let c2 = source[i + 2]
                if (c0 == '<' and c1 == '<' and c2 == '=') or (c0 == '>' and c1 == '>' and c2 == '=') or (c0 == '.' and c1 == '.' and c2 == '=') {
                    sym_len = 3
                }
            }
            if sym_len == 1 and i + 1 < n {
                let c0 = source[i]
                let c1 = source[i + 1]
                if (c0 == '-' and c1 == '>') or (c0 == '=' and c1 == '>') or (c0 == '=' and c1 == '=') or (c0 == '!' and c1 == '=') or (c0 == '<' and c1 == '=') or (c0 == '>' and c1 == '=') or (c0 == '+' and c1 == '=') or (c0 == '-' and c1 == '=') or (c0 == '*' and c1 == '=') or (c0 == '/' and c1 == '=') or (c0 == '&' and c1 == '=') or (c0 == '|' and c1 == '=') or (c0 == '^' and c1 == '=') or (c0 == '<' and c1 == '<') or (c0 == '>' and c1 == '>') or (c0 == '.' and c1 == '.') or (c0 == '?' and c1 == '?') {
                    sym_len = 2
                }
            }
            let text = copy_slice_to_string(source, start_pos, sym_len)
            add_fmt_token(@list, FMT_TOK_SYMBOL, text, start_line, start_col)
            i += sym_len
            col += sym_len as i32
        }
    }
    return list
}
