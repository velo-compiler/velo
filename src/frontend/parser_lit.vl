// ============================================================================
// 5.2 slice 9 — ring[T] + bitset literal parsing. Split from parser_expr.vl
// to stay under the 400-line budget (the shelf_calls_gen.vl doctrine). The
// bracket-list walk mirrors the shelf literal arm; the element ladders and
// mut/arity contracts live in the checkers (ring_checks.vl/bitset_checks.vl).
// ============================================================================
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "../common/utils.vl"
use "../common/num_utils.vl"
use "token.vl"
use "parser.vl"
use "parser_binary.vl"

// Walks `e0, e1, ...` inside already-consumed brackets into the first_arg
// chain. Empty lists leave first null with count 0.
act parse_lit_bracket_list(p: @Parser) -> @ExprNode {
    mut first: @ExprNode = null
    mut last: @ExprNode = null
    mut count: usize = 0
    if not parser_check(p, TOK_RBRACKET) {
        mut more = true
        loop more {
            let e = parse_expression(p)
            if e != null {
                if first == null {
                    first = e
                    last = e
                } else {
                    last.next = e
                    last = e
                }
                count += 1
            }
            if not parser_match(p, TOK_COMMA) {
                more = false
            }
        }
    }
    return first
}

// Captures the parsed chain shape without a second walk: the caller needs
// BOTH the head and the count, so this wrapper rebuilds count from the chain.
act lit_chain_count(first: @ExprNode) -> usize {
    mut n: usize = 0
    mut cur = first
    loop cur != null {
        n += 1
        cur = cur.next
    }
    return n
}

// 5.2 slice 9: `ring[v0, v1, ...]` — the shelf bracket-value shape. An empty
// `ring[]` needs an annotation (the checker rejects the empty infer).
act parse_ring_literal(p: @Parser) -> @ExprNode {
    let ring_tok = parser_advance(p)
    parser_consume(p, TOK_LBRACKET, "Expected '[' after 'ring' (ring literal: ring[1, 2, 3])")
    let first = parse_lit_bracket_list(p)
    parser_consume(p, TOK_RBRACKET, "Expected ']' at end of ring literal")
    return make_ring_lit_expr(first, lit_chain_count(first), ring_tok.line, ring_tok.col)
}

// 5.2 slice 9: `bitset[i0, i1, ...]` — integer-typed elements lower to set()
// calls; `bitset[]` infers `bitset` with no annotation.
act parse_bitset_literal(p: @Parser) -> @ExprNode {
    let bs_tok = parser_advance(p)
    parser_consume(p, TOK_LBRACKET, "Expected '[' after 'bitset' (bitset literal: bitset[1, 9])")
    let first = parse_lit_bracket_list(p)
    parser_consume(p, TOK_RBRACKET, "Expected ']' at end of bitset literal")
    return make_bitset_lit_expr(first, lit_chain_count(first), bs_tok.line, bs_tok.col)
}

// The parser_expr dispatch twin — one line up there, two arms here.
act parse_coll9_literal(p: @Parser) -> @ExprNode {
    if parser_check(p, TOK_RING) { return parse_ring_literal(p) }
    return parse_bitset_literal(p)
}

// Task 7.2: `heap shelf[...]` or `heap map[...]` literal parser
act parse_heap_literal(p: @Parser) -> @ExprNode {
    parser_advance(p)   // `heap`
    if parser_match(p, TOK_MAP) {
        let map_tok = parser_previous(p)
        parser_consume(p, TOK_LBRACKET, "Expected '[' after 'heap map' (heap map literal: heap map[1: \"a\", 2: \"b\"])")
        mut first_elem: @ExprNode = null
        mut last_elem: @ExprNode = null
        mut elem_count: usize = 0
        if not parser_check(p, TOK_RBRACKET) {
            mut more_pairs = true
            loop more_pairs {
                let ka = parse_expression(p)
                if ka != null { if first_elem == null { first_elem = ka; last_elem = ka } else { last_elem.next = ka; last_elem = ka }; elem_count += 1 }
                parser_consume(p, TOK_COLON, "Expected ':' between a map key and value (heap map[k: v])")
                let va = parse_expression(p)
                if va != null { if first_elem == null { first_elem = va; last_elem = va } else { last_elem.next = va; last_elem = va }; elem_count += 1 }
                if not parser_match(p, TOK_COMMA) { more_pairs = false }
            }
        }
        parser_consume(p, TOK_RBRACKET, "Expected ']' at end of heap map literal")
        return make_heap_map_lit_expr(first_elem, elem_count / 2, map_tok.line, map_tok.col)
    }
    let shelf_tok = parser_advance(p)   // `shelf`
    parser_consume(p, TOK_LBRACKET, "Expected '[' after 'heap shelf' (heap shelf literal: heap shelf[1, 2])")
    let first = parse_lit_bracket_list(p)
    parser_consume(p, TOK_RBRACKET, "Expected ']' at end of heap shelf literal")
    return make_heap_shelf_lit_expr(first, lit_chain_count(first), shelf_tok.line, shelf_tok.col)
}

act parse_heap_shelf_literal(p: @Parser) -> @ExprNode {
    return parse_heap_literal(p)
}

// Parses an integer literal token into an ExprNode.
// Integrates wide IntLiteral parsing for decimal literals (Task 53.3).
act parse_int_literal_expr(p: @Parser) -> @ExprNode {
    let tok = parser_advance(p)
    // 1. Character literal ('c', '\n', '\u0041', etc.)
    if tok.length >= 1 and p.source[tok.start] == '\'' {
        let val = parse_int_from_slice(p.source, tok.start, tok.length)
        mut node = make_int_expr(val, tok.line, tok.col)
        if (tok.length >= 3 and p.source[tok.start + 1] == '\\' and (p.source[tok.start + 2] == 'u' or p.source[tok.start + 2] == 'x')) or val > 127 {
            node.str_val = ""
        } else {
            node.str_val = copy_slice_to_string(p.source, tok.start, tok.length)
        }
        return node
    }

    // 2. Base check: hex (0x/0X), bin (0b/0B), oct (0o/0O) vs decimal
    mut is_prefixed = false
    if tok.length >= 2 and p.source[tok.start] == '0' {
        let b = p.source[tok.start + 1]
        if b == 'x' or b == 'X' or b == 'b' or b == 'B' or b == 'o' or b == 'O' {
            is_prefixed = true
        }
    }

    let sfx = extract_literal_suffix(p.source, tok.start, tok.length)
    if not is_prefixed {
        // Decimal integer literal
        let lit = parse_decimal_int_literal(p.source, tok.start, tok.length)
        if lit.overflow {
            report_parse(p, p.filename, tok.line, tok.col, tok.length, "Integer literal exceeds 64-bit unsigned maximum (18446744073709551615)")
            p.had_error = true
            return make_int_expr(0, tok.line, tok.col)
        }

        mut i32_val: i32 = 0
        int_lit_to_i32_checked(lit, @i32_val)
        mut node = make_int_expr(i32_val, tok.line, tok.col)

        if str.len(sfx) > 0 {
            node.type_name = sfx
            node.str_val = format_c_number_literal(p.source, tok.start, tok.length, false)
        } else {
            // Unsuffixed literal type ladder:
            // fits i32 -> default i32
            // else fits i64 -> "i64"
            // else fits u64 -> "u64"
            if lit.val > 9223372036854775807u64 {
                node.type_name = "u64"
                node.str_val = u64_to_decimal_string(lit.val, "ULL")
            } else if lit.val > 2147483647u64 {
                node.type_name = "i64"
                node.str_val = u64_to_decimal_string(lit.val, "LL")
            } else {
                node.str_val = format_c_number_literal(p.source, tok.start, tok.length, false)
            }
        }
        return node
    }

    // Prefixed (hex, bin, oct) - handled in Tasks 53.4 and 53.5
    let val = parse_int_from_slice(p.source, tok.start, tok.length)
    mut node = make_int_expr(val, tok.line, tok.col)
    node.str_val = format_c_number_literal(p.source, tok.start, tok.length, false)
    if str.len(sfx) > 0 {
        node.type_name = sfx
    }
    return node
}
