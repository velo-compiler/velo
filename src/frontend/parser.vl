// Main recursive descent parser driver and top-level declaration analyzer for Velo.
use "token.vl"
use "../common/utils.vl"
use "../common/num_utils.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "parser_core.vl"
use "parser_expr.vl"
use "parser_binary.vl"
use "parser_stmt.vl"
use "parser_decl.vl"

// Helper to apply '@' pointer prefixes, '?' optional prefixes, and 'or' outcome types.
act wrap_type_modifiers(p: @Parser, base_type: string, at_count: usize, is_opt: bool, allow_or: bool) -> string {
    mut res = base_type
    if at_count > 0 {
        let total_len = at_count + str.len(res)
        mut buf: @u8 = mem.alloc(@u8, total_len + 1)
        mut i: usize = 0
        loop i < at_count { buf[i] = '@'; i += 1 }
        mut j: usize = 0
        loop j < str.len(res) { buf[at_count + j] = res[j]; j += 1 }
        buf[total_len] = 0 as u8
        res = buf as string
    }
    if is_opt or parser_match(p, TOK_QUESTION) {
        mut qsb = create_sb(str.len(res) + 2)
        sb_append_char(@qsb, '?')
        sb_append_str(@qsb, res)
        res = sb_to_string(@qsb)
    }
    if allow_or and parser_match(p, TOK_OR) {
        let err_type = parse_type_annotation_ex(p, true)
        mut osb = create_sb(str.len(res) + str.len(err_type) + 4)
        sb_append_str(@osb, res)
        sb_append_str(@osb, " or ")
        sb_append_str(@osb, err_type)
        res = sb_to_string(@osb)
    }
    return res
}

// Parses type annotations with pointer prefixes, function pointer types, and generic arguments.
act parse_type_annotation_ex(p: @Parser, allow_or: bool) -> string {
    mut is_opt = false
    if parser_match(p, TOK_QUESTION) {
        is_opt = true
    }
    mut at_count: usize = 0
    loop parser_match(p, TOK_AT) {
        at_count += 1
    }

    if parser_match(p, TOK_ACT) {
        parser_consume(p, TOK_LPAREN, "Expected '(' after 'act' in function type")
        mut sb = create_sb(64)
        sb_append_str(@sb, "act(")
        mut count: usize = 0
        loop not parser_check(p, TOK_RPAREN) and not parser_check(p, TOK_EOF) {
            let atype = parse_type_annotation_ex(p, false)
            if count > 0 {
                sb_append_str(@sb, ", ")
            }
            sb_append_str(@sb, atype)
            count += 1
            if not parser_match(p, TOK_COMMA) {
                break
            }
        }
        parser_consume(p, TOK_RPAREN, "Expected ')' after parameter types in function type")
        sb_append_str(@sb, ") -> ")
        mut ret_type = "void"
        if parser_match(p, TOK_ARROW) {
            ret_type = parse_type_annotation_ex(p, true)
        }
        sb_append_str(@sb, ret_type)
        let act_str = sb_to_string(@sb)
        return wrap_type_modifiers(p, act_str, at_count, is_opt, false)
    }

    // Fixed-size stack array type: `[N]T`
    if parser_match(p, TOK_LBRACKET) {
        let size_tok = parser_consume(p, TOK_INT_LIT, "Expected array size inside '['")
        let size_str = copy_slice_to_string(p.source, size_tok.start, size_tok.length)
        let lit = parse_decimal_int_literal(p.source, size_tok.start, size_tok.length)
        if lit.overflow or lit.val > 2147483647u64 {
            report_parse(p, p.filename, size_tok.line, size_tok.col, size_tok.length, "Fixed-size array length exceeds 32-bit integer range")
            p.had_error = true
        } else if lit.val == 0u64 {
            report_parse(p, p.filename, size_tok.line, size_tok.col, size_tok.length, "Fixed-size array length must be greater than zero")
            p.had_error = true
        }
        parser_consume(p, TOK_RBRACKET, "Expected ']' after array size")
        let elem_type = parse_type_annotation_ex(p, false)
        mut sb = create_sb(str.len(size_str) + str.len(elem_type) + 4)
        sb_append_char(@sb, '[')
        sb_append_str(@sb, size_str)
        sb_append_char(@sb, ']')
        sb_append_str(@sb, elem_type)
        let arr_res = sb_to_string(@sb)
        return wrap_type_modifiers(p, arr_res, at_count, is_opt, allow_or)
    }

    // Tuple type: `(T0, T1, ...)`
    if parser_match(p, TOK_LPAREN) {
        mut sb = create_sb(64)
        sb_append_char(@sb, '(')
        mut count: usize = 0
        loop not parser_check(p, TOK_RPAREN) and not parser_check(p, TOK_EOF) {
            let elem_t = parse_type_annotation_ex(p, false)
            if count > 0 {
                sb_append_str(@sb, ", ")
            }
            sb_append_str(@sb, elem_t)
            count += 1
            if not parser_match(p, TOK_COMMA) {
                break
            }
        }
        parser_consume(p, TOK_RPAREN, "Expected ')' after tuple element types")
        sb_append_char(@sb, ')')
        mut tup_res = sb_to_string(@sb)
        if count == 1 and str.len(tup_res) > 2 {
            tup_res = copy_slice_to_string(tup_res, 1, str.len(tup_res) - 2)
        }
        return wrap_type_modifiers(p, tup_res, at_count, is_opt, allow_or)
    }

    // 5.2: `shelf` is a reserved type keyword - annotations spell shelf[T]
    mut base_tok_kind = TOK_IDENTIFIER
    if parser_check(p, TOK_SHELF) {
        base_tok_kind = TOK_SHELF
    }
    // 5.2 slice 9: ring[T] needs its slot; bitset is legal bare (the first bare collection type)
    if parser_check(p, TOK_RING) { base_tok_kind = TOK_RING }
    if parser_check(p, TOK_BITSET) { base_tok_kind = TOK_BITSET }
    if parser_check(p, TOK_MAP) { base_tok_kind = TOK_MAP }
    // 5.2 slice 10 / Task 7.2: `heap shelf[T]` / `heap Map[K, V]` - the modifier prefixes the spelling
    mut heap_prefix = false
    if parser_check(p, TOK_HEAP) {
        parser_advance(p)
        heap_prefix = true
        if parser_check(p, TOK_SHELF) { base_tok_kind = TOK_SHELF } else if parser_check(p, TOK_MAP) { base_tok_kind = TOK_MAP } else { base_tok_kind = TOK_IDENTIFIER }
    }
    let type_tok = parser_consume(p, base_tok_kind, "Expected type name")
    mut raw_name = copy_slice_to_string(p.source, type_tok.start, type_tok.length)
    if raw_name == "map" { raw_name = "Map" }
    // 5.2 slice 10: splice the modifier into the canonical spelling
    mut base_name = raw_name
    if heap_prefix {
        mut hsb = create_sb(str.len(raw_name) + 8)
        sb_append_str(@hsb, "heap ")
        sb_append_str(@hsb, raw_name)
        base_name = sb_to_string(@hsb)
    }

    // 5.2: a bare `shelf` has no element type to lower - the loud parse error (Stage 1's words)
    if base_tok_kind == TOK_SHELF and not heap_prefix and not parser_check(p, TOK_LBRACKET) {
        report_parse(p, p.filename, type_tok.line, type_tok.col, type_tok.length, "a bare 'shelf' needs an element type: use shelf[T]")
        p.had_error = true
    }
    // 5.2 slice 10 / Task 7.2: bare heap collection rejects
    if heap_prefix and not parser_check(p, TOK_LBRACKET) {
        if raw_name == "Map" {
            report_parse(p, p.filename, type_tok.line, type_tok.col, type_tok.length, "a bare 'heap Map' needs key and value types: use heap Map[K, V]")
        } else {
            report_parse(p, p.filename, type_tok.line, type_tok.col, type_tok.length, "a bare 'heap shelf' needs an element type: use heap shelf[T]")
        }
        p.had_error = true
    }
    // 5.2 slice 9: a bare `ring` needs its element - same-trade parse reject
    if base_tok_kind == TOK_RING and not parser_check(p, TOK_LBRACKET) {
        report_parse(p, p.filename, type_tok.line, type_tok.col, type_tok.length, "a bare 'ring' needs an element type: use ring[T]")
        p.had_error = true
    }
    // 5.2 slice 6: a bare `Map` needs BOTH slots - the same-trade parse reject (Stage 1's words)
    if raw_name == "Map" and not heap_prefix and not parser_check(p, TOK_LBRACKET) {
        report_parse(p, p.filename, type_tok.line, type_tok.col, type_tok.length, "a bare 'Map' needs key and value types: use Map[K, V]")
        p.had_error = true
    }
    if parser_match(p, TOK_LBRACKET) {
        mut sb = create_sb(64)
        sb_append_str(@sb, base_name)
        sb_append_char(@sb, '[')
        mut count: usize = 0
        loop not parser_check(p, TOK_RBRACKET) and not parser_check(p, TOK_EOF) {
            let atype = parse_type_annotation(p)
            if count > 0 {
                sb_append_str(@sb, ", ")
            }
            sb_append_str(@sb, atype)
            count += 1
            if not parser_match(p, TOK_COMMA) {
                break
            }
        }
        parser_consume(p, TOK_RBRACKET, "Expected ']' after type arguments")
        sb_append_char(@sb, ']')
        base_name = sb_to_string(@sb)
    }

    return wrap_type_modifiers(p, base_name, at_count, is_opt, allow_or)
}

act parse_type_annotation(p: @Parser) -> string {
    return parse_type_annotation_ex(p, true)
}

act parse_type_annotation_no_or(p: @Parser) -> string {
    return parse_type_annotation_ex(p, false)
}

// Parses a top-level declaration (data, act, extern, use, global let/mut).
act parse_top_level_declaration(p: @Parser) -> @StmtNode {
    parser_skip_newlines(p)
    if parser_is_at_end(p) {
        return null
    }

    if parser_check(p, TOK_USE) { return parse_use_decl(p) }
    if parser_check(p, TOK_DATA) { return parse_data_decl(p) }
    if parser_check(p, TOK_PACT) { return parse_pact_decl(p) }
    if parser_check(p, TOK_KIND) { return parse_kind_decl(p) }
    if parser_check(p, TOK_ACT) { return parse_function_decl(p) }
    if parser_check(p, TOK_TEST) { return parse_test_decl(p) }
    if parser_check(p, TOK_EXTERN) { return parse_extern_decl(p) }
    if parser_check(p, TOK_LET) or parser_check(p, TOK_MUT) { return parse_statement(p) }
    // Contextual 'aka' keyword: `aka Alias = <primitive>` at top level.
    let top_tok = parser_peek(p, 0)
    if top_tok.kind == TOK_IDENTIFIER and top_tok.length == 3 {
        let src = p.source
        if src[top_tok.start] == 'a' and src[top_tok.start + 1] == 'k' and src[top_tok.start + 2] == 'a' {
            return parse_type_alias_decl(p)
        }
    }

    let tok = parser_peek(p, 0)
    report_parse(p, p.filename, tok.line, tok.col, tok.length, "Unexpected top-level token")
    p.had_error = true
    parser_advance(p)
    return null
}

// Parses the whole token stream into a complete AST Program representation.
act parse_program(p: @Parser) -> @ProgramNode {
    parser_skip_newlines(p)
    mut first_decl: @StmtNode = null
    mut last_decl: @StmtNode = null
    mut count: usize = 0

    loop not parser_is_at_end(p) {
        let decl = parse_top_level_declaration(p)
        if decl != null {
            if first_decl == null {
                first_decl = decl
                last_decl = decl
            } else {
                last_decl.next = decl
                last_decl = decl
            }
            count += 1
        }
        parser_skip_newlines(p)
    }

    // Append lifted anonymous function declarations to the end of the program
    if p.first_anon != null {
        if first_decl == null {
            first_decl = p.first_anon
        } else {
            last_decl.next = p.first_anon
        }
        count += p.anon_count
    }

    return make_program_node(first_decl, count)
}
