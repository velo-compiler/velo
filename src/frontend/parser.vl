// Main recursive descent parser driver and top-level declaration analyzer for Velo.
use sys.io
use sys.mem
use "token.vl"
use "../common/utils.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "parser_expr.vl"
use "parser_binary.vl"
use "parser_stmt.vl"
use "parser_decl.vl"

// Maintains the state of the recursive descent parser.
data Parser {
    filename: string
    source: string
    tokens: @Token
    token_count: usize
    pos: usize
    had_error: bool
    anon_counter: i32
    first_anon: @StmtNode
    last_anon: @StmtNode
    anon_count: usize
}

// Initializes a Parser instance.
act init_parser(p: @Parser, filename: string, source: string, tokens: @Token, count: usize) {
    p.filename = filename
    p.source = source
    p.tokens = tokens
    p.token_count = count
    p.pos = 0
    p.had_error = false
    p.anon_counter = 0
    p.first_anon = null
    p.last_anon = null
    p.anon_count = 0
}

// Appends a lifted anonymous function declaration to the parser's collection.
act parser_add_anon_decl(p: @Parser, decl: @StmtNode) {
    if decl == null { return }
    if p.first_anon == null {
        p.first_anon = decl
        p.last_anon = decl
    } else {
        p.last_anon.next = decl
        p.last_anon = decl
    }
    p.anon_count += 1
}

// Generates the next unique lifted anonymous function identifier.
act parser_next_anon_name(p: @Parser) -> string {
    let id = p.anon_counter
    p.anon_counter += 1
    mut sb = create_sb(32)
    sb_append_str(@sb, "_velo_anon_act_")
    sb_append_int(@sb, id)
    return sb_to_string(@sb)
}

// Peeks ahead at a token with an offset without consuming it.
act parser_peek(p: @Parser, offset: usize) -> Token {
    let idx = p.pos + offset
    if idx < p.token_count {
        return p.tokens[idx]
    }
    if p.token_count > 0 {
        return p.tokens[p.token_count - 1]
    }
    return Token{ kind: TOK_EOF, start: 0, length: 0, line: 1, col: 1 }
}

// Checks if the parser has consumed all tokens.
act parser_is_at_end(p: @Parser) -> bool {
    let tok = parser_peek(p, 0)
    return tok.kind == TOK_EOF
}

// Consumes and returns the current token, advancing parser position.
act parser_advance(p: @Parser) -> Token {
    let tok = parser_peek(p, 0)
    if tok.kind != TOK_EOF {
        p.pos += 1
    }
    return tok
}

// Checks if current token matches the expected kind.
act parser_check(p: @Parser, kind: i32) -> bool {
    let tok = parser_peek(p, 0)
    // TOK_KIND, TOK_OP, and TOK_DATA are reserved keywords that are also valid
    // as identifier spellings in name positions (contextual keywords).
    if kind == TOK_IDENTIFIER and (tok.kind == TOK_KIND or tok.kind == TOK_OP or tok.kind == TOK_DATA) { return true }
    return tok.kind == kind
}

// Consumes the current token if it matches kind, returning true.
act parser_match(p: @Parser, kind: i32) -> bool {
    if parser_check(p, kind) {
        parser_advance(p)
        return true
    }
    return false
}

// Consumes the expected token kind or reports a syntax error.
act parser_consume(p: @Parser, kind: i32, err_msg: string) -> Token {
    let tok = parser_peek(p, 0)
    if parser_check(p, kind) {
        return parser_advance(p)
    }
    report_error(p.filename, tok.line, tok.col, err_msg)
    p.had_error = true
    return tok
}

// Skips consecutive statement delimiters (newlines and semicolons).
act parser_skip_newlines(p: @Parser) {
    loop parser_check(p, TOK_NEWLINE) or parser_check(p, TOK_SEMICOLON) {
        parser_advance(p)
    }
}

// Extracts unquoted and formatted string literal text.
act get_string_literal_text(source: string, tok: Token) -> string {
    return process_string_literal(source, tok.start, tok.length)
}

// Determines whether the lookahead matches a struct literal pattern.
act is_struct_literal(p: @Parser) -> bool {
    let tok0 = parser_peek(p, 0)
    let tok1 = parser_peek(p, 1)
    if tok0.kind != TOK_IDENTIFIER { return false }
    let first_char = p.source[tok0.start]
    if first_char < 'A' or first_char > 'Z' { return false }

    mut idx: usize = 1
    if tok1.kind == TOK_LBRACKET {
        mut depth: usize = 1
        idx = 2
        loop p.pos + idx < p.token_count and depth > 0 {
            let t = parser_peek(p, idx)
            if t.kind == TOK_LBRACKET { depth += 1 }
            else if t.kind == TOK_RBRACKET { depth -= 1 }
            idx += 1
        }
        if depth > 0 { return false }
    }

    let brace_tok = parser_peek(p, idx)
    if brace_tok.kind != TOK_LBRACE { return false }
    idx += 1

    loop p.pos + idx < p.token_count {
        let t = parser_peek(p, idx)
        if t.kind != TOK_NEWLINE and t.kind != TOK_SEMICOLON {
            if t.kind == TOK_RBRACE { return true }
            if t.kind == TOK_IDENTIFIER or t.kind == TOK_KIND {
                let next_t = parser_peek(p, idx + 1)
                if next_t.kind == TOK_COLON { return true }
            }
            return false
        }
        idx += 1
    }
    return false
}

// Checks if lookahead matches a generic function call `[TypeArgs](...)`.
act is_generic_call(p: @Parser) -> bool {
    if not parser_check(p, TOK_LBRACKET) { return false }
    mut depth: usize = 1
    mut idx: usize = 1
    loop p.pos + idx < p.token_count and depth > 0 {
        let t = parser_peek(p, idx)
        if t.kind == TOK_LBRACKET { depth += 1 }
        else if t.kind == TOK_RBRACKET { depth -= 1 }
        idx += 1
    }
    if depth > 0 { return false }
    let next_tok = parser_peek(p, idx)
    return next_tok.kind == TOK_LPAREN
}

// Parses type annotations with pointer prefixes, function pointer types, and generic arguments.
act parse_type_annotation(p: @Parser) -> string {
    mut at_count: usize = 0
    loop parser_match(p, TOK_AT) {
        at_count += 1
    }

    if parser_match(p, TOK_ACT) {
        parser_consume(p, TOK_LPAREN, "Expected '(' after 'act' in function type")
        mut sb = create_sb(64)
        sb_append_str(@sb, "act(")
        mut count: usize = 0
        loop not parser_check(p, TOK_RPAREN) and not parser_check(p, TOK_EOF) {
            let atype = parse_type_annotation(p)
            if count > 0 {
                sb_append_str(@sb, ", ")
            }
            sb_append_str(@sb, atype)
            count += 1
            if not parser_match(p, TOK_COMMA) {
                break
            }
        }
        parser_consume(p, TOK_RPAREN, "Expected ')' after parameter types in function type")
        sb_append_str(@sb, ") -> ")
        mut ret_type = "void"
        if parser_match(p, TOK_ARROW) {
            ret_type = parse_type_annotation(p)
        }
        sb_append_str(@sb, ret_type)
        let act_str = sb_to_string(@sb)
        if at_count == 0 {
            return act_str
        }
        let total_len = at_count + str.len(act_str)
        mut buf: @u8 = mem.alloc(@u8, total_len + 1)
        mut i: usize = 0
        loop i < at_count { buf[i] = '@'; i += 1 }
        mut j: usize = 0
        loop j < str.len(act_str) { buf[at_count + j] = act_str[j]; j += 1 }
        buf[total_len] = 0 as u8
        return buf as string
    }

    let type_tok = parser_consume(p, TOK_IDENTIFIER, "Expected type name")
    let raw_name = copy_slice_to_string(p.source, type_tok.start, type_tok.length)

    mut base_name = raw_name
    if parser_match(p, TOK_LBRACKET) {
        mut sb = create_sb(64)
        sb_append_str(@sb, raw_name)
        sb_append_char(@sb, '[')
        mut count: usize = 0
        loop not parser_check(p, TOK_RBRACKET) and not parser_check(p, TOK_EOF) {
            let atype = parse_type_annotation(p)
            if count > 0 {
                sb_append_str(@sb, ", ")
            }
            sb_append_str(@sb, atype)
            count += 1
            if not parser_match(p, TOK_COMMA) {
                break
            }
        }
        parser_consume(p, TOK_RBRACKET, "Expected ']' after type arguments")
        sb_append_char(@sb, ']')
        base_name = sb_to_string(@sb)
    }

    if at_count == 0 {
        return base_name
    }
    let total_len = at_count + str.len(base_name)
    mut buf: @u8 = mem.alloc(@u8, total_len + 1)
    mut i: usize = 0
    loop i < at_count {
        buf[i] = '@'
        i += 1
    }
    mut j: usize = 0
    loop j < str.len(base_name) {
        buf[at_count + j] = base_name[j]
        j += 1
    }
    buf[total_len] = 0 as u8
    return buf as string
}

// Parses a top-level declaration (data, act, extern, use, global let/mut).
act parse_top_level_declaration(p: @Parser) -> @StmtNode {
    parser_skip_newlines(p)
    if parser_is_at_end(p) {
        return null
    }

    if parser_check(p, TOK_USE) {
        return parse_use_decl(p)
    }
    if parser_check(p, TOK_DATA) {
        return parse_data_decl(p)
    }
    if parser_check(p, TOK_KIND) {
        return parse_kind_decl(p)
    }
    if parser_check(p, TOK_ACT) {
        return parse_function_decl(p)
    }
    if parser_check(p, TOK_EXTERN) {
        return parse_extern_decl(p)
    }
    if parser_check(p, TOK_LET) or parser_check(p, TOK_MUT) {
        return parse_statement(p)
    }
    // Contextual 'aka' keyword: `aka Alias = <primitive>` at top level.
    let top_tok = parser_peek(p, 0)
    if top_tok.kind == TOK_IDENTIFIER and top_tok.length == 3 {
        let src = p.source
        if src[top_tok.start] == 'a' and src[top_tok.start + 1] == 'k' and src[top_tok.start + 2] == 'a' {
            if parser_peek(p, 1).kind == TOK_IDENTIFIER {
                return parse_type_alias_decl(p)
            }
        }
    }

    let tok = parser_peek(p, 0)
    report_error(p.filename, tok.line, tok.col, "Unexpected top-level token")
    p.had_error = true
    parser_advance(p)
    return null
}

// Parses a complete Velo translation unit into an AST ProgramNode.
act parse_program(p: @Parser) -> @ProgramNode {
    parser_skip_newlines(p)
    mut first_decl: @StmtNode = null
    mut last_decl: @StmtNode = null
    mut count: usize = 0

    loop not parser_is_at_end(p) {
        let decl = parse_top_level_declaration(p)
        if decl != null {
            if first_decl == null {
                first_decl = decl
                last_decl = decl
            } else {
                last_decl.next = decl
                last_decl = decl
            }
            count += 1
        }
        parser_skip_newlines(p)
    }

    if p.first_anon != null {
        if first_decl == null {
            first_decl = p.first_anon
        } else {
            last_decl.next = p.first_anon
        }
        count += p.anon_count
    }

    mut prog: @ProgramNode = mem.alloc(@ProgramNode, 1)
    prog.first_decl = first_decl
    prog.decl_count = count
    return prog
}
