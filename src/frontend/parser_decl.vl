// Top-level declaration parsing (use, act, extern, test) and generic parameters for Velo.
use "token.vl"
use "../common/utils.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../common/op_types.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "parser.vl"
use "parser_expr.vl"
use "parser_stmt.vl"
use "parser_decl_types.vl"

// Parses a module import declaration (`use "path.vl"` or `use "path.vl" :> alias` or `use "path.vl" :> { ... }`).
act parse_use_decl(p: @Parser) -> @StmtNode {
    let use_tok = parser_consume(p, TOK_USE, "Expected 'use'")
    mut mod_path = ""
    if parser_check(p, TOK_STRING_LIT) {
        let str_tok = parser_advance(p)
        mod_path = get_string_literal_text(p.source, str_tok)
    } else {
        let first_part_tok = parser_consume(p, TOK_IDENTIFIER, "Expected module path after 'use'")
        mod_path = copy_slice_to_string(p.source, first_part_tok.start, first_part_tok.length)

        loop parser_match(p, TOK_DOT) {
            let part_tok = parser_consume(p, TOK_IDENTIFIER, "Expected module component after '.'")
            let part_str = copy_slice_to_string(p.source, part_tok.start, part_tok.length)
            let total_len = str.len(mod_path) + 1 + str.len(part_str)
            mut buf: @u8 = mem.alloc(@u8, total_len + 1)
            mut i: usize = 0
            loop i < str.len(mod_path) {
                buf[i] = mod_path[i]
                i += 1
            }
            buf[str.len(mod_path)] = '.'
            mut j: usize = 0
            loop j < str.len(part_str) {
                buf[str.len(mod_path) + 1 + j] = part_str[j]
                j += 1
            }
            buf[total_len] = 0 as u8
            mod_path = buf as string
        }
    }

    mut node = make_use_decl(mod_path, use_tok.line, use_tok.col)
    node.file_path = p.filename

    if parser_match(p, TOK_COLON_GT) {
        if parser_check(p, TOK_IDENTIFIER) {
            let alias_tok = parser_advance(p)
            node.use_alias = copy_slice_to_string(p.source, alias_tok.start, alias_tok.length)
        } else if parser_match(p, TOK_LBRACE) {
            parser_skip_newlines(p)
            mut last_item: @ImportItem = null
            loop not parser_check(p, TOK_RBRACE) and not parser_check(p, TOK_EOF) {
                let name_tok = parser_consume(p, TOK_IDENTIFIER, "Expected imported symbol name")
                let orig_name = copy_slice_to_string(p.source, name_tok.start, name_tok.length)
                mut local_name = orig_name
                if parser_match(p, TOK_COLON_GT) {
                    let ren_tok = parser_consume(p, TOK_IDENTIFIER, "Expected alias name after ':>'")
                    local_name = copy_slice_to_string(p.source, ren_tok.start, ren_tok.length)
                }
                mut item: @ImportItem = mem.alloc(@ImportItem, 1)
                item.orig_name = orig_name
                item.local_name = local_name
                item.line = name_tok.line
                item.col = name_tok.col
                item.next = null

                if node.first_import == null {
                    node.first_import = item
                    last_item = item
                } else {
                    last_item.next = item
                    last_item = item
                }

                parser_skip_newlines(p)
                if not parser_match(p, TOK_COMMA) {
                    break
                }
                parser_skip_newlines(p)
            }
            parser_consume(p, TOK_RBRACE, "Expected '}' after imported symbols list")
        } else {
            report_parse(p, p.filename, use_tok.line, use_tok.col, 2, "Expected alias identifier or '{' after ':>'")
            p.had_error = true
        }
    }

    parser_skip_newlines(p)
    return node
}

// Parses a function declaration (`act Name[T](params) -> RetType { ... }` or `act op +(...)`).
act parse_function_decl(p: @Parser) -> @StmtNode {
    let act_tok = parser_consume(p, TOK_ACT, "Expected 'act'")
    mut fname = ""
    mut is_op = false
    mut op_kind = 0
    if parser_check(p, TOK_OP) and is_op_token(parser_peek(p, 1).kind) {
        parser_advance(p)
        is_op = true
        let op_tok = parser_advance(p)
        op_kind = op_tok.kind
    } else {
        let name_tok = parser_consume(p, TOK_IDENTIFIER, "Expected function name")
        fname = copy_slice_to_string(p.source, name_tok.start, name_tok.length)
    }
    let type_params = parse_type_params(p)

    parser_consume(p, TOK_LPAREN, "Expected '(' after function name")

    mut first_param: @ParamNode = null
    mut last_param: @ParamNode = null
    mut count: usize = 0

    if not parser_check(p, TOK_RPAREN) {
        mut more_params = true
        loop more_params {
            let pname_tok = parser_consume_ident(p, "Expected parameter name")
            let pname = copy_slice_to_string(p.source, pname_tok.start, pname_tok.length)
            parser_consume(p, TOK_COLON, "Expected ':' after parameter name")
            let ptype = parse_type_annotation(p)
            let pnode = make_param_node(pname, ptype, pname_tok.line, pname_tok.col)

            if first_param == null {
                first_param = pnode
                last_param = pnode
            } else {
                last_param.next = pnode
                last_param = pnode
            }
            count += 1

            if not parser_match(p, TOK_COMMA) {
                more_params = false
            }
        }
    }

    parser_consume(p, TOK_RPAREN, "Expected ')' after parameters")

    mut ret_type = "void"
    mut has_ret = false
    if parser_match(p, TOK_ARROW) {
        ret_type = parse_type_annotation(p)
        has_ret = true
    }

    if is_op {
        fname = mangle_op_func_name(op_kind, first_param, count)
    }

    parser_skip_newlines(p)
    mut body: @StmtNode = null
    if parser_match(p, TOK_FAT_ARROW) {
        parser_skip_newlines(p)
        let expr = parse_expression(p)
        let ret_stmt = make_return_stmt(expr, expr.line, expr.col)
        body = make_block_stmt(ret_stmt, 1 as usize, expr.line, expr.col)
        if not has_ret {
            ret_type = "auto"
        }
    } else {
        body = parse_block(p)
    }
    mut node = make_function_decl(fname, first_param, count, ret_type, body, act_tok.line, act_tok.col)
    node.type_params = type_params
    node.op = op_kind
    return node
}

// Parses an external foreign function declaration (`extern act Name(...) -> RetType`).
act parse_extern_decl(p: @Parser) -> @StmtNode {
    let ext_tok = parser_consume(p, TOK_EXTERN, "Expected 'extern'")
    parser_consume(p, TOK_ACT, "Expected 'act' after 'extern'")
    let name_tok = parser_consume(p, TOK_IDENTIFIER, "Expected external function name")
    let fname = copy_slice_to_string(p.source, name_tok.start, name_tok.length)

    parser_consume(p, TOK_LPAREN, "Expected '(' after function name")

    mut first_param: @ParamNode = null
    mut last_param: @ParamNode = null
    mut count: usize = 0

    if not parser_check(p, TOK_RPAREN) {
        mut more_params = true
        loop more_params {
            let pname_tok = parser_consume_ident(p, "Expected parameter name")
            let pname = copy_slice_to_string(p.source, pname_tok.start, pname_tok.length)
            parser_consume(p, TOK_COLON, "Expected ':' after parameter name")
            let ptype = parse_type_annotation(p)
            let pnode = make_param_node(pname, ptype, pname_tok.line, pname_tok.col)

            if first_param == null {
                first_param = pnode
                last_param = pnode
            } else {
                last_param.next = pnode
                last_param = pnode
            }
            count += 1

            if not parser_match(p, TOK_COMMA) {
                more_params = false
            }
        }
    }

    parser_consume(p, TOK_RPAREN, "Expected ')' after parameters")

    mut ret_type = "void"
    if parser_match(p, TOK_ARROW) {
        ret_type = parse_type_annotation(p)
    }

    parser_skip_newlines(p)
    return make_extern_decl(fname, first_param, count, ret_type, ext_tok.line, ext_tok.col)
}

// Parses a test block declaration (`test "name" { ... }`).
act parse_test_decl(p: @Parser) -> @StmtNode {
    let test_tok = parser_consume(p, TOK_TEST, "Expected 'test'")
    mut name = "unnamed"
    if parser_check(p, TOK_STRING_LIT) {
        let name_tok = parser_advance(p)
        name = get_string_literal_text(p.source, name_tok)
    } else if parser_check(p, TOK_IDENTIFIER) {
        let name_tok = parser_advance(p)
        name = copy_slice_to_string(p.source, name_tok.start, name_tok.length)
    } else {
        report_parse(p, p.filename, test_tok.line, test_tok.col, test_tok.length, "Expected test name string literal or identifier after 'test'")
        p.had_error = true
    }
    parser_skip_newlines(p)
    let body = parse_block(p)
    return make_test_decl(name, body, test_tok.line, test_tok.col)
}
