// Top-level declaration parsing (use, data, kind, act, extern) and generic parameters for Velo.
use sys.io
use sys.mem
use "token.vl"
use "../common/utils.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../common/op_types.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "parser.vl"
use "parser_expr.vl"
use "parser_stmt.vl"

// Parses optional type parameters e.g. `[T]` or `[K, V]`.
act parse_type_params(p: @Parser) -> string {
    if not parser_match(p, TOK_LBRACKET) {
        return null
    }
    mut sb = create_sb(64)
    mut count: usize = 0
    loop not parser_check(p, TOK_RBRACKET) and not parser_check(p, TOK_EOF) {
        let p_tok = parser_consume(p, TOK_IDENTIFIER, "Expected type parameter name")
        let pname = copy_slice_to_string(p.source, p_tok.start, p_tok.length)
        if count > 0 {
            sb_append_str(@sb, ", ")
        }
        sb_append_str(@sb, pname)
        count += 1
        if not parser_match(p, TOK_COMMA) {
            break
        }
    }
    parser_consume(p, TOK_RBRACKET, "Expected ']' after type parameters")
    return sb_to_string(@sb)
}

// Parses a module import declaration (`use "path.vl"` or `use sys.io`).
act parse_use_decl(p: @Parser) -> @StmtNode {
    let use_tok = parser_consume(p, TOK_USE, "Expected 'use'")
    if parser_check(p, TOK_STRING_LIT) {
        let str_tok = parser_advance(p)
        let mod_path = get_string_literal_text(p.source, str_tok)
        parser_skip_newlines(p)
        return make_use_decl(mod_path, use_tok.line, use_tok.col)
    }

    let first_part_tok = parser_consume(p, TOK_IDENTIFIER, "Expected module path after 'use'")
    mut mod_path = copy_slice_to_string(p.source, first_part_tok.start, first_part_tok.length)

    loop parser_match(p, TOK_DOT) {
        let part_tok = parser_consume(p, TOK_IDENTIFIER, "Expected module component after '.'")
        let part_str = copy_slice_to_string(p.source, part_tok.start, part_tok.length)
        let total_len = str.len(mod_path) + 1 + str.len(part_str)
        mut buf: @u8 = mem.alloc(@u8, total_len + 1)
        mut i: usize = 0
        loop i < str.len(mod_path) {
            buf[i] = mod_path[i]
            i += 1
        }
        buf[str.len(mod_path)] = '.'
        mut j: usize = 0
        loop j < str.len(part_str) {
            buf[str.len(mod_path) + 1 + j] = part_str[j]
            j += 1
        }
        buf[total_len] = 0 as u8
        mod_path = buf as string
    }

    parser_skip_newlines(p)
    return make_use_decl(mod_path, use_tok.line, use_tok.col)
}

// Parses a constant field default initializer (literal or unary minus on a numeric literal).
act parse_field_default(p: @Parser) -> @ExprNode {
    if parser_match(p, TOK_MINUS) {
        let tok = parser_peek(p, 0)
        if tok.kind != TOK_INT_LIT and tok.kind != TOK_FLOAT_LIT {
            report_error("parse", tok.line, tok.col, "Field default after '-' must be a numeric literal")
        }
        let val = parse_expression(p)
        return make_unary_expr(TOK_MINUS, val, tok.line, tok.col)
    }
    let tok = parser_peek(p, 0)
    if not (tok.kind == TOK_INT_LIT or tok.kind == TOK_FLOAT_LIT or tok.kind == TOK_STRING_LIT or tok.kind == TOK_TRUE or tok.kind == TOK_FALSE) {
        report_error("parse", tok.line, tok.col, "Field default must be a constant literal (number, string, or bool)")
    }
    return parse_expression(p)
}

// Reports whether a type alias target base is a supported primitive.
act is_alias_target_primitive(base: string) -> bool {
    if base == "i8" { return true } else if base == "i16" { return true } else if base == "i32" { return true }
    else if base == "i64" { return true } else if base == "u8" { return true } else if base == "u16" { return true }
    else if base == "u32" { return true } else if base == "u64" { return true } else if base == "f32" { return true }
    else if base == "f64" { return true } else if base == "bool" { return true } else if base == "usize" { return true }
    else if base == "isize" { return true } else if base == "string" { return true }
    return false
}

// Parses a primitive type alias declaration (`aka EntityId = u64`).
act parse_type_alias_decl(p: @Parser) -> @StmtNode {
    parser_advance(p)
    let name_tok = parser_consume(p, TOK_IDENTIFIER, "Expected alias name after 'aka'")
    let aname = copy_slice_to_string(p.source, name_tok.start, name_tok.length)
    parser_consume(p, TOK_ASSIGN, "Expected '=' in type alias")
    let target = parse_type_annotation(p)
    mut base = target
    if str.len(base) > 0 and base[0] == '@' {
        base = copy_slice_to_string(base, 1, str.len(base) - 1)
    }
    if not is_alias_target_primitive(base) {
        report_error("parse", name_tok.line, name_tok.col, "Type alias target must be a primitive type (or @primitive)")
    }
    parser_match(p, TOK_SEMICOLON)
    parser_skip_newlines(p)
    return make_type_alias_decl(aname, target, name_tok.line, name_tok.col)
}

// Parses a struct data blueprint declaration (`data Name[T] { ... }`).
act parse_data_decl(p: @Parser) -> @StmtNode {
    let data_tok = parser_consume(p, TOK_DATA, "Expected 'data'")
    let name_tok = parser_consume(p, TOK_IDENTIFIER, "Expected struct name after 'data'")
    let sname = copy_slice_to_string(p.source, name_tok.start, name_tok.length)
    let type_params = parse_type_params(p)

    parser_skip_newlines(p)

    // Struct layout attributes: `#align(N)` and `#packed` (contextual names).
    mut align_bytes: i32 = 0
    mut is_packed = false
    loop parser_check(p, TOK_HASH) {
        parser_advance(p)
        let attr_tok = parser_consume(p, TOK_IDENTIFIER, "Expected attribute name after '#'")
        let attr_name = copy_slice_to_string(p.source, attr_tok.start, attr_tok.length)
        if attr_name == "align" {
            parser_consume(p, TOK_LPAREN, "Expected '(' after '#align'")
            let align_tok = parser_consume(p, TOK_INT_LIT, "Expected integer alignment after '#align('")
            align_bytes = parse_int_from_slice(p.source, align_tok.start, align_tok.length)
            parser_consume(p, TOK_RPAREN, "Expected ')' after alignment value")
        } else if attr_name == "packed" {
            is_packed = true
        } else {
            report_error("parse", attr_tok.line, attr_tok.col, "Unknown data attribute (expected 'align' or 'packed')")
        }
    }

    parser_consume(p, TOK_LBRACE, "Expected '{' after struct name")
    parser_skip_newlines(p)

    mut first_field: @FieldNode = null
    mut last_field: @FieldNode = null
    mut count: usize = 0

    loop not parser_check(p, TOK_RBRACE) and not parser_check(p, TOK_EOF) {
        let fname_tok = parser_consume(p, TOK_IDENTIFIER, "Expected field name")
        let fname = copy_slice_to_string(p.source, fname_tok.start, fname_tok.length)
        parser_consume(p, TOK_COLON, "Expected ':' after field name")
        let ftype = parse_type_annotation(p)
        mut f_default: @ExprNode = null
        mut f_has_def = false
        if parser_match(p, TOK_ASSIGN) {
            f_default = parse_field_default(p)
            f_has_def = true
        }
        let fnode = make_field_node(fname, ftype, f_has_def, f_default, fname_tok.line, fname_tok.col)

        if first_field == null {
            first_field = fnode
            last_field = fnode
        } else {
            last_field.next = fnode
            last_field = fnode
        }
        count += 1

        parser_skip_newlines(p)
        parser_match(p, TOK_COMMA)
        parser_skip_newlines(p)
    }

    parser_consume(p, TOK_RBRACE, "Expected '}' after struct body")
    mut node = make_data_decl(sname, first_field, count, align_bytes, is_packed, data_tok.line, data_tok.col)
    node.type_params = type_params
    return node
}

// Parses an enum / tagged union declaration (`kind Name[T] { ... }`).
act parse_kind_decl(p: @Parser) -> @StmtNode {
    let kind_tok = parser_consume(p, TOK_KIND, "Expected 'kind'")
    let name_tok = parser_consume(p, TOK_IDENTIFIER, "Expected kind name after 'kind'")
    let kname = copy_slice_to_string(p.source, name_tok.start, name_tok.length)
    let type_params = parse_type_params(p)

    parser_skip_newlines(p)
    parser_consume(p, TOK_LBRACE, "Expected '{' after kind name")
    parser_skip_newlines(p)

    mut first_var: @VariantNode = null
    mut last_var: @VariantNode = null
    mut count: usize = 0

    loop not parser_check(p, TOK_RBRACE) and not parser_check(p, TOK_EOF) {
        let vname_tok = parser_consume(p, TOK_IDENTIFIER, "Expected variant name")
        let vname = copy_slice_to_string(p.source, vname_tok.start, vname_tok.length)
        mut disc: i32 = 0
        mut has_disc = false
        mut ptype: string = null
        mut first_field: @FieldNode = null
        mut last_field: @FieldNode = null
        mut f_count: usize = 0

        if parser_match(p, TOK_ASSIGN) {
            let num_tok = parser_consume(p, TOK_INT_LIT, "Expected integer discriminant after '='")
            disc = parse_int_from_slice(p.source, num_tok.start, num_tok.length)
            has_disc = true
        } else if parser_match(p, TOK_COLON) {
            ptype = parse_type_annotation(p)
        } else if parser_match(p, TOK_LPAREN) {
            if not parser_check(p, TOK_RPAREN) {
                loop {
                    let fname_tok = parser_consume(p, TOK_IDENTIFIER, "Expected field name")
                    let fname = copy_slice_to_string(p.source, fname_tok.start, fname_tok.length)
                    parser_consume(p, TOK_COLON, "Expected ':' after field name")
                    let ftype = parse_type_annotation(p)
                    let f_node = make_field_node(fname, ftype, false, null, fname_tok.line, fname_tok.col)
                    if first_field == null {
                        first_field = f_node
                        last_field = f_node
                    } else {
                        last_field.next = f_node
                        last_field = f_node
                    }
                    f_count += 1
                    if not parser_match(p, TOK_COMMA) { break }
                }
            }
            parser_consume(p, TOK_RPAREN, "Expected ')' after variant fields")
        }

        let var_node = make_variant_node(vname, disc, has_disc, ptype, first_field, f_count, vname_tok.line, vname_tok.col)
        if first_var == null {
            first_var = var_node
            last_var = var_node
        } else {
            last_var.next = var_node
            last_var = var_node
        }
        count += 1
        parser_skip_newlines(p)
        parser_match(p, TOK_COMMA)
        parser_skip_newlines(p)
    }

    parser_consume(p, TOK_RBRACE, "Expected '}' after kind body")
    mut node = make_kind_decl(kname, first_var, count, kind_tok.line, kind_tok.col)
    node.type_params = type_params
    return node
}

// Parses a function declaration (`act Name[T](params) -> RetType { ... }` or `act op +(...)`).
act parse_function_decl(p: @Parser) -> @StmtNode {
    let act_tok = parser_consume(p, TOK_ACT, "Expected 'act'")
    mut fname = ""
    mut is_op = false
    mut op_kind = 0
    if parser_check(p, TOK_OP) and is_op_token(parser_peek(p, 1).kind) {
        parser_advance(p)
        is_op = true
        let op_tok = parser_advance(p)
        op_kind = op_tok.kind
    } else {
        let name_tok = parser_consume(p, TOK_IDENTIFIER, "Expected function name")
        fname = copy_slice_to_string(p.source, name_tok.start, name_tok.length)
    }
    let type_params = parse_type_params(p)

    parser_consume(p, TOK_LPAREN, "Expected '(' after function name")

    mut first_param: @ParamNode = null
    mut last_param: @ParamNode = null
    mut count: usize = 0

    if not parser_check(p, TOK_RPAREN) {
        mut more_params = true
        loop more_params {
            let pname_tok = parser_consume(p, TOK_IDENTIFIER, "Expected parameter name")
            let pname = copy_slice_to_string(p.source, pname_tok.start, pname_tok.length)
            parser_consume(p, TOK_COLON, "Expected ':' after parameter name")
            let ptype = parse_type_annotation(p)
            let pnode = make_param_node(pname, ptype, pname_tok.line, pname_tok.col)

            if first_param == null {
                first_param = pnode
                last_param = pnode
            } else {
                last_param.next = pnode
                last_param = pnode
            }
            count += 1

            if not parser_match(p, TOK_COMMA) {
                more_params = false
            }
        }
    }

    parser_consume(p, TOK_RPAREN, "Expected ')' after parameters")

    mut ret_type = "void"
    if parser_match(p, TOK_ARROW) {
        ret_type = parse_type_annotation(p)
    }

    if is_op {
        fname = mangle_op_func_name(op_kind, first_param, count)
    }

    parser_skip_newlines(p)
    let body = parse_block(p)
    mut node = make_function_decl(fname, first_param, count, ret_type, body, act_tok.line, act_tok.col)
    node.type_params = type_params
    node.op = op_kind
    return node
}

// Parses an external foreign function declaration (`extern act Name(...) -> RetType`).
act parse_extern_decl(p: @Parser) -> @StmtNode {
    let ext_tok = parser_consume(p, TOK_EXTERN, "Expected 'extern'")
    parser_consume(p, TOK_ACT, "Expected 'act' after 'extern'")
    let name_tok = parser_consume(p, TOK_IDENTIFIER, "Expected external function name")
    let fname = copy_slice_to_string(p.source, name_tok.start, name_tok.length)

    parser_consume(p, TOK_LPAREN, "Expected '(' after function name")

    mut first_param: @ParamNode = null
    mut last_param: @ParamNode = null
    mut count: usize = 0

    if not parser_check(p, TOK_RPAREN) {
        mut more_params = true
        loop more_params {
            let pname_tok = parser_consume(p, TOK_IDENTIFIER, "Expected parameter name")
            let pname = copy_slice_to_string(p.source, pname_tok.start, pname_tok.length)
            parser_consume(p, TOK_COLON, "Expected ':' after parameter name")
            let ptype = parse_type_annotation(p)
            let pnode = make_param_node(pname, ptype, pname_tok.line, pname_tok.col)

            if first_param == null {
                first_param = pnode
                last_param = pnode
            } else {
                last_param.next = pnode
                last_param = pnode
            }
            count += 1

            if not parser_match(p, TOK_COMMA) {
                more_params = false
            }
        }
    }

    parser_consume(p, TOK_RPAREN, "Expected ')' after parameters")

    mut ret_type = "void"
    if parser_match(p, TOK_ARROW) {
        ret_type = parse_type_annotation(p)
    }

    parser_skip_newlines(p)
    return make_extern_decl(fname, first_param, count, ret_type, ext_tok.line, ext_tok.col)
}
