// Statement parsing and control flow AST generation for Velo.
use sys.io
use sys.mem
use "token.vl"
use "../common/utils.vl"
use "../common/diagnostics.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "parser.vl"
use "parser_expr.vl"

// Parses a code block enclosed in curly braces `{ ... }`.
act parse_block(p: @Parser) -> @StmtNode {
    let lbrace = parser_consume(p, TOK_LBRACE, "Expected '{'")
    parser_skip_newlines(p)

    mut first_stmt: @StmtNode = null
    mut last_stmt: @StmtNode = null
    mut count: usize = 0

    loop not parser_check(p, TOK_RBRACE) and not parser_check(p, TOK_EOF) {
        let stmt = parse_statement(p)
        if stmt != null {
            if first_stmt == null {
                first_stmt = stmt
                last_stmt = stmt
            } else {
                last_stmt.next = stmt
                last_stmt = stmt
            }
            count += 1
        }
        parser_skip_newlines(p)
    }

    parser_consume(p, TOK_RBRACE, "Expected '}' at end of block")
    return make_block_stmt(first_stmt, count, lbrace.line, lbrace.col)
}

// Parses an `if` conditional statement with optional `else` or `else if` branches.
act parse_if_stmt(p: @Parser) -> @StmtNode {
    let if_tok = parser_consume(p, TOK_IF, "Expected 'if'")
    let condition = parse_expression(p)
    parser_skip_newlines(p)
    let then_branch = parse_block(p)

    mut else_branch: @StmtNode = null
    parser_skip_newlines(p)
    if parser_match(p, TOK_ELSE) {
        parser_skip_newlines(p)
        if parser_check(p, TOK_IF) {
            else_branch = parse_if_stmt(p)
        } else {
            else_branch = parse_block(p)
        }
    }
    return make_if_stmt(condition, then_branch, else_branch, if_tok.line, if_tok.col)
}

// Parses a `loop` statement supporting infinite, repeat, named range, and anonymous range loops.
act parse_loop_stmt(p: @Parser) -> @StmtNode {
    let loop_tok = parser_consume(p, TOK_LOOP, "Expected 'loop'")
    parser_skip_newlines(p)

    // 1. Infinite loop: loop { ... }
    if parser_check(p, TOK_LBRACE) {
        let body = parse_block(p)
        return make_loop_inf_stmt(body, loop_tok.line, loop_tok.col)
    }

    // 1.5. Shelf value loop: loop <var> [of <collection> | , <index> of
    //      <collection>] { ... } — 5.2 slice 4 adds the optional second
    //      binding (the usize index); more than two bindings rejects.
    if parser_check(p, TOK_IDENTIFIER) {
        let next_tok = parser_peek(p, 1)
        if next_tok.kind == TOK_OF or next_tok.kind == TOK_COMMA {
            let iter_tok = parser_advance(p)
            let iter_name = copy_slice_to_string(p.source, iter_tok.start, iter_tok.length)
            mut index_name: string = null
            if parser_match(p, TOK_COMMA) {
                let idx_tok = parser_advance(p)
                index_name = copy_slice_to_string(p.source, idx_tok.start, idx_tok.length)
                if parser_check(p, TOK_COMMA) {
                    parser_advance(p)
                    report_parse(p, p.filename, idx_tok.line, idx_tok.col, "loop of takes at most two bindings (value, then index)")
                    p.had_error = true
                    // best effort: drop the extra bindings so parsing resumes
                    // at the collection (one defect, one error)
                    mut guard = 0
                    loop not parser_check(p, TOK_OF) and not parser_check(p, TOK_LBRACE) and guard < 64 {
                        parser_advance(p)
                        guard += 1
                    }
                }
                parser_consume(p, TOK_OF, "Expected 'of' after loop bindings")
            } else {
                parser_consume(p, TOK_OF, "Expected 'of' after loop variable")
            }
            let coll_expr = parse_expression(p)
            let body = parse_block(p)
            return make_loop_of_stmt(iter_name, index_name, coll_expr, body, loop_tok.line, loop_tok.col)
        }
    }

    // 2. Named range loop: loop <var> in <start>..<end>[:<step>] { ... }
    if parser_check(p, TOK_IDENTIFIER) {
        let next_tok = parser_peek(p, 1)
        if next_tok.kind == TOK_IN {
            let iter_tok = parser_advance(p)
            let iter_name = copy_slice_to_string(p.source, iter_tok.start, iter_tok.length)
            parser_consume(p, TOK_IN, "Expected 'in' after loop variable")
            let start_expr = parse_expression(p)
            mut is_inc = false
            if parser_match(p, TOK_DOTDOTEQ) {
                is_inc = true
            } else {
                parser_consume(p, TOK_DOTDOT, "Expected '..' or '..=' in range specification")
            }
            let end_expr = parse_expression(p)
            mut step_expr: @ExprNode = null
            if parser_match(p, TOK_COLON) {
                step_expr = parse_expression(p)
            }
            parser_skip_newlines(p)
            let body = parse_block(p)
            return make_loop_stmt(iter_name, start_expr, end_expr, step_expr, is_inc, body, loop_tok.line, loop_tok.col)
        }
    }

    // 3. Anonymous range or expression (count / condition) loop:
    let first_expr = parse_expression(p)
    if parser_check(p, TOK_DOTDOT) or parser_check(p, TOK_DOTDOTEQ) {
        mut is_inc = false
        if parser_match(p, TOK_DOTDOTEQ) {
            is_inc = true
        } else {
            parser_advance(p)
        }
        let end_expr = parse_expression(p)
        mut step_expr: @ExprNode = null
        if parser_match(p, TOK_COLON) {
            step_expr = parse_expression(p)
        }
        parser_skip_newlines(p)
        let body = parse_block(p)
        return make_loop_stmt("it", first_expr, end_expr, step_expr, is_inc, body, loop_tok.line, loop_tok.col)
    }

    // Expression loop: count repeat or boolean condition
    parser_skip_newlines(p)
    let body = parse_block(p)
    let is_count = (first_expr.kind == EXPR_INT)
    return make_loop_expr_stmt(first_expr, is_count, body, loop_tok.line, loop_tok.col)
}

// Parses an `on <expr> { ... }` branching statement.
act parse_on_stmt(p: @Parser) -> @StmtNode {
    let on_tok = parser_consume(p, TOK_ON, "Expected 'on'")
    let expr = parse_expression(p)
    parser_skip_newlines(p)
    parser_consume(p, TOK_LBRACE, "Expected '{' after on expression")
    parser_skip_newlines(p)

    mut first_case: @CaseNode = null
    mut last_case: @CaseNode = null
    mut case_count: usize = 0

    loop not parser_check(p, TOK_RBRACE) and not parser_check(p, TOK_EOF) {
        let cur = parser_peek(p, 0)
        mut is_default = false
        mut first_val: @ExprNode = null
        mut val_count: usize = 0

        if cur.kind == TOK_ELSE {
            parser_advance(p)
            is_default = true
            if parser_check(p, TOK_FAT_ARROW) or parser_check(p, TOK_COLON) {
                parser_advance(p)
            }
        } else if cur.kind == TOK_IDENTIFIER and cur.length == 1 and p.source[cur.start] == '_' {
            parser_advance(p)
            is_default = true
            if parser_check(p, TOK_FAT_ARROW) or parser_check(p, TOK_COLON) {
                parser_advance(p)
            }
        } else {
            first_val = parse_expression(p)
            mut cur_val = first_val
            val_count = 1
            loop parser_match(p, TOK_COMMA) {
                let next_val = parse_expression(p)
                cur_val.next = next_val
                cur_val = next_val
                val_count += 1
            }
            if parser_check(p, TOK_FAT_ARROW) or parser_check(p, TOK_COLON) {
                parser_advance(p)
            } else {
                report_parse(p, "parser", cur.line, cur.col, "Expected '=>' or ':' after pattern")
                p.had_error = true
            }
        }

        parser_skip_newlines(p)
        mut body: @StmtNode = null
        if parser_check(p, TOK_LBRACE) {
            body = parse_block(p)
        } else {
            let stmt = parse_statement(p)
            if stmt != null {
                body = make_block_stmt(stmt, 1, stmt.line, stmt.col)
            }
        }

        let case_node = make_case_node(first_val, val_count, is_default, body, cur.line, cur.col)
        if first_case == null {
            first_case = case_node
            last_case = case_node
        } else {
            last_case.next = case_node
            last_case = case_node
        }
        case_count += 1
        parser_skip_newlines(p)
    }

    parser_consume(p, TOK_RBRACE, "Expected '}' at end of on block")
    return make_match_stmt(expr, first_case, case_count, on_tok.line, on_tok.col)
}

// Parses any Velo statement (variable declarations, control flow, assignments, calls).
act parse_statement(p: @Parser) -> @StmtNode {
    parser_skip_newlines(p)

    // 1. Defer statement
    if parser_check(p, TOK_DEFER) {
        let defer_tok = parser_advance(p)
        let stmt = parse_statement(p)
        return make_defer_stmt(stmt, defer_tok.line, defer_tok.col)
    }

    // 2. Zone statement (`zone { ... }` or §4.1 `zone <bytes> { ... }`)
    if parser_check(p, TOK_ZONE) {
        let zone_tok = parser_advance(p)
        parser_skip_newlines(p)
        mut size: @ExprNode = null
        if not parser_check(p, TOK_LBRACE) {
            size = parse_expression(p)
            parser_skip_newlines(p)
        }
        let body = parse_block(p)
        return make_zone_stmt(body, size, zone_tok.line, zone_tok.col)
    }

    // 3. Mutable variable declaration: `mut x = val` or `mut x: Type = val`
    if parser_check(p, TOK_MUT) {
        let mut_tok = parser_advance(p)
        let name_tok = parser_consume(p, TOK_IDENTIFIER, "Expected variable name after 'mut'")
        let name = copy_slice_to_string(p.source, name_tok.start, name_tok.length)
        mut type_name = ""
        if parser_match(p, TOK_COLON) {
            type_name = parse_type_annotation(p)
        }
        mut val: @ExprNode = null
        if parser_match(p, TOK_ASSIGN) {
            val = parse_expression(p)
        }
        parser_skip_newlines(p)
        return make_var_decl_stmt(name, type_name, val, true, mut_tok.line, mut_tok.col)
    }

    // 4. Immutable variable declaration: `let x = val` or `let x: Type = val`
    if parser_check(p, TOK_LET) {
        let let_tok = parser_advance(p)
        let name_tok = parser_consume(p, TOK_IDENTIFIER, "Expected variable name after 'let'")
        let name = copy_slice_to_string(p.source, name_tok.start, name_tok.length)
        mut type_name = ""
        if parser_match(p, TOK_COLON) {
            type_name = parse_type_annotation(p)
        }
        mut val: @ExprNode = null
        if parser_match(p, TOK_ASSIGN) {
            val = parse_expression(p)
        }
        parser_skip_newlines(p)
        return make_var_decl_stmt(name, type_name, val, false, let_tok.line, let_tok.col)
    }

    // 5. Short explicit variable declaration: `name: Type = val`
    if parser_check(p, TOK_IDENTIFIER) {
        let next_tok = parser_peek(p, 1)
        if next_tok.kind == TOK_COLON {
            let name_tok = parser_advance(p)
            parser_advance(p) // consume ':'
            let type_name = parse_type_annotation(p)
            mut val: @ExprNode = null
            if parser_match(p, TOK_ASSIGN) {
                val = parse_expression(p)
            }
            parser_skip_newlines(p)
            return make_var_decl_stmt(copy_slice_to_string(p.source, name_tok.start, name_tok.length), type_name, val, false, name_tok.line, name_tok.col)
        }
    }

    // 6. Control flow constructs
    if parser_check(p, TOK_IF) {
        return parse_if_stmt(p)
    }
    if parser_check(p, TOK_LOOP) {
        return parse_loop_stmt(p)
    }
    if parser_check(p, TOK_ON) {
        return parse_on_stmt(p)
    }

    // 7. Return statement
    if parser_check(p, TOK_RETURN) {
        let ret_tok = parser_advance(p)
        mut val: @ExprNode = null
        if not parser_check(p, TOK_NEWLINE) and not parser_check(p, TOK_SEMICOLON) and not parser_check(p, TOK_RBRACE) and not parser_check(p, TOK_EOF) {
            val = parse_expression(p)
        }
        parser_skip_newlines(p)
        return make_return_stmt(val, ret_tok.line, ret_tok.col)
    }

    // 7.5. Break statement
    if parser_check(p, TOK_BREAK) {
        let tok = parser_advance(p)
        parser_skip_newlines(p)
        return make_break_stmt(tok.line, tok.col)
    }

    // 7.6. Continue statement
    if parser_check(p, TOK_CONTINUE) {
        let tok = parser_advance(p)
        parser_skip_newlines(p)
        return make_continue_stmt(tok.line, tok.col)
    }

    // 8. Assignment or Expression Statement
    let expr = parse_expression(p)
    if expr == null {
        return null
    }

    let cur = parser_peek(p, 0)
    if cur.kind == TOK_ASSIGN or cur.kind == TOK_PLUS_ASSIGN or cur.kind == TOK_MINUS_ASSIGN or cur.kind == TOK_STAR_ASSIGN or cur.kind == TOK_SLASH_ASSIGN or cur.kind == TOK_AMP_ASSIGN or cur.kind == TOK_PIPE_ASSIGN or cur.kind == TOK_CARET_ASSIGN or cur.kind == TOK_SHL_ASSIGN or cur.kind == TOK_SHR_ASSIGN {
        parser_advance(p)
        let val = parse_expression(p)
        parser_skip_newlines(p)
        return make_assign_stmt(expr, cur.kind, val, expr.line, expr.col)
    }

    parser_skip_newlines(p)
    return make_expr_stmt(expr, expr.line, expr.col)
}
