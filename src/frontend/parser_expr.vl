// Expression parsing algorithms and Pratt precedence parser for Velo.
use sys.io
use sys.mem
use "token.vl"
use "../common/utils.vl"
use "../common/diagnostics.vl"
use "../common/string_builder.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "parser.vl"
use "parser_binary.vl"
use "parser_stmt.vl"
use "parser_lit.vl"
use "parser_primary.vl"

// Parses postfix expressions: field access, dereference, array indexing, casting, function calls.
act parse_postfix(p: @Parser) -> @ExprNode {
    mut expr = parse_primary(p)
    if expr == null {
        return null
    }

    mut parsing_postfix = true
    loop parsing_postfix {
        if parser_match(p, TOK_DOT) {
            if parser_match(p, TOK_AT) {
                let at_tok = parser_peek(p, 0)
                expr = make_deref_expr(expr, at_tok.line, at_tok.col)
            } else if is_contextual_ident_tok(parser_peek(p, 0).kind) or parser_check(p, TOK_AND) {
                let mem_tok = parser_advance(p)
                let mname = copy_slice_to_string(p.source, mem_tok.start, mem_tok.length)
                expr = make_member_expr(expr, mname, mem_tok.line, mem_tok.col)
            } else {
                let mem_tok = parser_peek(p, 0)
                report_parse(p, p.filename, mem_tok.line, mem_tok.col, mem_tok.length, "Expected member name after '.'")
                p.had_error = true
            }
        } else if parser_check(p, TOK_LBRACKET) and is_generic_call(p) {
            parser_advance(p) // consume '['
            mut sb = create_sb(64)
            mut count: usize = 0
            loop not parser_check(p, TOK_RBRACKET) and not parser_check(p, TOK_EOF) {
                let atype = parse_type_annotation(p)
                if count > 0 {
                    sb_append_str(@sb, ", ")
                }
                sb_append_str(@sb, atype)
                count += 1
                if not parser_match(p, TOK_COMMA) {
                    break
                }
            }
            parser_consume(p, TOK_RBRACKET, "Expected ']' after generic type arguments")
            let type_args_str = sb_to_string(@sb)
            let lp = parser_consume(p, TOK_LPAREN, "Expected '(' after generic type arguments")
            mut first_arg: @ExprNode = null
            mut last_arg: @ExprNode = null
            mut arg_count: usize = 0
            if not parser_check(p, TOK_RPAREN) {
                mut more_args = true
                loop more_args {
                    let arg = parse_expression(p)
                    if arg != null {
                        if first_arg == null {
                            first_arg = arg
                            last_arg = arg
                        } else {
                            last_arg.next = arg
                            last_arg = arg
                        }
                        arg_count += 1
                    }
                    if not parser_match(p, TOK_COMMA) {
                        more_args = false
                    }
                }
            }
            parser_consume(p, TOK_RPAREN, "Expected ')' after argument list")
            expr = make_call_expr(expr, first_arg, arg_count, lp.line, lp.col)
            expr.type_name = type_args_str
        } else if parser_match(p, TOK_LBRACKET) {
            let lb = parser_peek(p, 0)
            let idx_expr = parse_expression(p)
            parser_consume(p, TOK_RBRACKET, "Expected ']' after array index")
            expr = make_index_expr(expr, idx_expr, lb.line, lb.col)
        } else if parser_match(p, TOK_AS) {
            let as_tok = parser_peek(p, 0)
            let target_type = parse_type_annotation(p)
            expr = make_cast_expr(expr, target_type, as_tok.line, as_tok.col)
        } else if parser_match(p, TOK_LPAREN) {
            let lp = parser_peek(p, 0)
            mut first_arg: @ExprNode = null
            mut last_arg: @ExprNode = null
            mut count: usize = 0
            if not parser_check(p, TOK_RPAREN) {
                mut more_args = true
                loop more_args {
                    let arg = parse_expression(p)
                    if arg != null {
                        if first_arg == null {
                            first_arg = arg
                            last_arg = arg
                        } else {
                            last_arg.next = arg
                            last_arg = arg
                        }
                        count += 1
                    }
                    if not parser_match(p, TOK_COMMA) {
                        more_args = false
                    }
                }
            }
            parser_consume(p, TOK_RPAREN, "Expected ')' after argument list")
            expr = make_call_expr(expr, first_arg, count, lp.line, lp.col)
        } else {
            parsing_postfix = false
        }
    }
    return expr
}

// Parses prefix unary operations: `@x` (address-of), `-x`, `!x`, `not x`, `~x`.
act parse_unary(p: @Parser) -> @ExprNode {
    if parser_check(p, TOK_AT) or parser_check(p, TOK_MINUS) or parser_check(p, TOK_NOT) or parser_check(p, TOK_TILDE) {
        let op_tok = parser_advance(p)
        let operand = parse_unary(p)
        if op_tok.kind == TOK_AT {
            return make_address_of_expr(operand, op_tok.line, op_tok.col)
        }
        return make_unary_expr(op_tok.kind, operand, op_tok.line, op_tok.col)
    }
    return parse_postfix(p)
}
