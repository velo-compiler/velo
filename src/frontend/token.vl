// Token definitions for the Velo programming language.

// Special tokens
let TOK_EOF: i32 = 0
let TOK_NEWLINE: i32 = 1
let TOK_SEMICOLON: i32 = 2

// Literals
let TOK_IDENTIFIER: i32 = 10
let TOK_INT_LIT: i32 = 11
let TOK_FLOAT_LIT: i32 = 12
let TOK_STRING_LIT: i32 = 13

// Keywords
let TOK_ACT: i32 = 20
let TOK_DATA: i32 = 21
let TOK_MUT: i32 = 22
let TOK_LET: i32 = 23
let TOK_IF: i32 = 24
let TOK_ELSE: i32 = 25
let TOK_LOOP: i32 = 27
let TOK_IN: i32 = 28
let TOK_RETURN: i32 = 29
let TOK_ZONE: i32 = 30
let TOK_DEFER: i32 = 31
let TOK_EXTERN: i32 = 32
let TOK_USE: i32 = 33
let TOK_TRUE: i32 = 34
let TOK_FALSE: i32 = 35
let TOK_NULL: i32 = 36
let TOK_AS: i32 = 37
let TOK_AND: i32 = 38
let TOK_OR: i32 = 39
let TOK_NOT: i32 = 40
let TOK_BREAK: i32 = 41
let TOK_CONTINUE: i32 = 42
let TOK_ON: i32 = 43
let TOK_DOTDOTEQ: i32 = 44
let TOK_KIND: i32 = 45
let TOK_OP: i32 = 46
let TOK_SHELF: i32 = 47
let TOK_OF: i32 = 48
let TOK_MAP: i32 = 49          // 5.2 slice 6: `map` (literal keyword; `Map[K, V]` stays an identifier)
let TOK_RING: i32 = 148        // 5.2 slice 9: `ring` (literal keyword; type spelling ring[T])
let TOK_BITSET: i32 = 149      // 5.2 slice 9: `bitset` (literal keyword; bare type spelling)
let TOK_HEAP: i32 = 152        // 5.2 slice 10: `heap` (the heap-shelf storage modifier)
let TOK_TEST: i32 = 153        // 6.5: `test` keyword for native test declarations
let TOK_FAIL: i32 = 155        // Algebraic error handling: `fail` keyword
let TOK_UNSAFE: i32 = 156      // 48.1: `unsafe` block keyword
let TOK_PACT: i32 = 157        // 77.3: `pact` static contract keyword
let TOK_VIEW: i32 = 158        // 77.4: `view` module privacy keyword
let TOK_SIZEOF: i32 = 159      // `sizeof` keyword

// Operators & Punctuation
let TOK_AT: i32 = 50           // @
let TOK_PLUS: i32 = 51         // +
let TOK_MINUS: i32 = 52        // -
let TOK_STAR: i32 = 53         // *
let TOK_SLASH: i32 = 54        // /
let TOK_PERCENT: i32 = 55      // %
let TOK_DOT: i32 = 56          // .
let TOK_DOTDOT: i32 = 57       // ..
let TOK_ARROW: i32 = 58        // ->
let TOK_COLON: i32 = 59        // :
let TOK_COMMA: i32 = 60        // ,
let TOK_ASSIGN: i32 = 61       // =
let TOK_EQ: i32 = 62           // ==
let TOK_NEQ: i32 = 63          // !=
let TOK_LT: i32 = 64           // <
let TOK_LTE: i32 = 65          // <=
let TOK_GT: i32 = 66           // >
let TOK_GTE: i32 = 67          // >=
let TOK_PLUS_ASSIGN: i32 = 68  // +=
let TOK_MINUS_ASSIGN: i32 = 69 // -=
let TOK_STAR_ASSIGN: i32 = 70  // *=
let TOK_SLASH_ASSIGN: i32 = 71 // /=
let TOK_LPAREN: i32 = 72       // (
let TOK_RPAREN: i32 = 73       // )
let TOK_LBRACE: i32 = 74       // {
let TOK_RBRACE: i32 = 75       // }
let TOK_LBRACKET: i32 = 76     // [
let TOK_RBRACKET: i32 = 77     // ]

// Bitwise Operators & Assignments
let TOK_AMP: i32 = 80          // &
let TOK_PIPE: i32 = 81         // |
let TOK_CARET: i32 = 82        // ^
let TOK_TILDE: i32 = 83        // ~
let TOK_SHL: i32 = 84          // <<
let TOK_SHR: i32 = 85          // >>
let TOK_AMP_ASSIGN: i32 = 86   // &=
let TOK_PIPE_ASSIGN: i32 = 87  // |=
let TOK_CARET_ASSIGN: i32 = 88 // ^=
let TOK_SHL_ASSIGN: i32 = 89   // <<=
let TOK_SHR_ASSIGN: i32 = 90   // >>=
let TOK_FAT_ARROW: i32 = 91    // =>
let TOK_HASH: i32 = 92         // # (struct attribute marker)
let TOK_QUESTION: i32 = 93     // ?
let TOK_DOUBLE_QUESTION: i32 = 94 // ??
let TOK_BANG: i32 = 95         // !
let TOK_COLON_GT: i32 = 96     // :>

// Represents a single token descriptor.
// To avoid string copies during lexing, the token holds offset and length into the source buffer.
data Token {
    kind: i32
    start: usize
    length: usize
    line: i32
    col: i32
}

// Returns human-readable representation of a token kind.
act token_name(kind: i32) -> string {
    if kind == TOK_EOF { return "EOF" }
    if kind == TOK_NEWLINE { return "NEWLINE" }
    if kind == TOK_SEMICOLON { return ";" }
    if kind == TOK_IDENTIFIER { return "IDENTIFIER" }
    if kind == TOK_INT_LIT { return "INT_LIT" }
    if kind == TOK_FLOAT_LIT { return "FLOAT_LIT" }
    if kind == TOK_STRING_LIT { return "STRING_LIT" }
    if kind == TOK_ACT { return "act" }
    if kind == TOK_DATA { return "data" }
    if kind == TOK_MUT { return "mut" }
    if kind == TOK_LET { return "let" }
    if kind == TOK_IF { return "if" }
    if kind == TOK_ELSE { return "else" }
    if kind == TOK_LOOP { return "loop" }
    if kind == TOK_IN { return "in" }
    if kind == TOK_RETURN { return "return" }
    if kind == TOK_ZONE { return "zone" }
    if kind == TOK_DEFER { return "defer" }
    if kind == TOK_EXTERN { return "extern" }
    if kind == TOK_USE { return "use" }
    if kind == TOK_TRUE { return "true" }
    if kind == TOK_FALSE { return "false" }
    if kind == TOK_NULL { return "null" }
    if kind == TOK_AS { return "as" }
    if kind == TOK_AND { return "and" }
    if kind == TOK_OR { return "or" }
    if kind == TOK_NOT { return "not" }
    if kind == TOK_BREAK { return "break" }
    if kind == TOK_CONTINUE { return "continue" }
    if kind == TOK_FAIL { return "fail" }
    if kind == TOK_AT { return "@" }
    if kind == TOK_LBRACE { return "{" }
    if kind == TOK_RBRACE { return "}" }
    if kind == TOK_LPAREN { return "(" }
    if kind == TOK_RPAREN { return ")" }
    if kind == TOK_COLON { return ":" }
    if kind == TOK_ASSIGN { return "=" }
    if kind == TOK_ARROW { return "->" }
    if kind == TOK_AMP { return "&" }
    if kind == TOK_PIPE { return "|" }
    if kind == TOK_CARET { return "^" }
    if kind == TOK_TILDE { return "~" }
    if kind == TOK_SHL { return "<<" }
    if kind == TOK_SHR { return ">>" }
    if kind == TOK_ON { return "on" }
    if kind == TOK_FAT_ARROW { return "=>" }
    if kind == TOK_DOTDOTEQ { return "..=" }
    if kind == TOK_KIND { return "kind" }
    if kind == TOK_OP { return "op" }
    if kind == TOK_HASH { return "#" }
    if kind == TOK_QUESTION { return "?" }
    if kind == TOK_DOUBLE_QUESTION { return "??" }
    if kind == TOK_BANG { return "!" }
    if kind == TOK_UNSAFE { return "unsafe" }
    if kind == TOK_PACT { return "pact" }
    if kind == TOK_VIEW { return "view" }
    if kind == TOK_SIZEOF { return "sizeof" }
    if kind == TOK_COLON_GT { return ":>" }
    return "TOKEN"
}
