// Native Language Server Protocol (LSP) Server for Velo.
// Implements document synchronization and message dispatching.

use std.io
use std.mem
use std.str
use std.json
use std.fs
use "../common/string_builder.vl"
use "../common/utils.vl"
use "transport.vl"
use "analysis.vl"
use "doc_store.vl"
use "symbols.vl"
use "hover.vl"
use "definition.vl"
use "completion.vl"
use "rename.vl"
use "code_action.vl"

// Processes 'textDocument/documentSymbol' request.
act lsp_handle_document_symbol(state: @LspServerState, id_node: @JsonValue, params: @JsonValue) {
    if params == null or params.kind != JSON_OBJECT {
        lsp_send_empty_document_symbols(id_node)
        return
    }
    let td = json_obj_get_str(params, "textDocument")
    if td == null or td.kind != JSON_OBJECT {
        lsp_send_empty_document_symbols(id_node)
        return
    }
    mut uri_str: string = null
    mut needs_free: bool = false
    let text = lsp_get_doc_text(state, json_obj_get_str(td, "uri"), @uri_str, @needs_free)
    if text != null {
        lsp_send_document_symbols(id_node, text)
        if needs_free {
            mem.free(text as @u8)
            mem.free(uri_str as @u8)
        }
    } else {
        lsp_send_empty_document_symbols(id_node)
    }
}

// Processes 'textDocument/hover' request.
act lsp_handle_hover(state: @LspServerState, id_node: @JsonValue, params: @JsonValue) {
    if params == null or params.kind != JSON_OBJECT {
        lsp_send_null_hover(id_node)
        return
    }
    let td = json_obj_get_str(params, "textDocument")
    let pos = json_obj_get_str(params, "position")
    if td == null or td.kind != JSON_OBJECT or pos == null or pos.kind != JSON_OBJECT {
        lsp_send_null_hover(id_node)
        return
    }
    let line_node = json_obj_get_str(pos, "line")
    let char_node = json_obj_get_str(pos, "character")
    if line_node == null or char_node == null {
        lsp_send_null_hover(id_node)
        return
    }
    mut uri_str: string = null
    mut needs_free: bool = false
    let text = lsp_get_doc_text(state, json_obj_get_str(td, "uri"), @uri_str, @needs_free)
    if text != null {
        lsp_send_hover_result(id_node, uri_str, text, line_node.int_val as i32, char_node.int_val as i32)
        if needs_free {
            mem.free(text as @u8)
            mem.free(uri_str as @u8)
        }
    } else {
        lsp_send_null_hover(id_node)
    }
}

// Processes 'textDocument/definition' request.
act lsp_handle_definition(state: @LspServerState, id_node: @JsonValue, params: @JsonValue) {
    if params == null or params.kind != JSON_OBJECT {
        lsp_send_null_definition(id_node)
        return
    }
    let td = json_obj_get_str(params, "textDocument")
    let pos = json_obj_get_str(params, "position")
    if td == null or td.kind != JSON_OBJECT or pos == null or pos.kind != JSON_OBJECT {
        lsp_send_null_definition(id_node)
        return
    }
    let line_node = json_obj_get_str(pos, "line")
    let char_node = json_obj_get_str(pos, "character")
    if line_node == null or char_node == null {
        lsp_send_null_definition(id_node)
        return
    }
    mut uri_str: string = null
    mut needs_free: bool = false
    let text = lsp_get_doc_text(state, json_obj_get_str(td, "uri"), @uri_str, @needs_free)
    if text != null {
        lsp_send_definition_result(id_node, state, uri_str, text, line_node.int_val as i32, char_node.int_val as i32)
        if needs_free {
            mem.free(text as @u8)
            mem.free(uri_str as @u8)
        }
    } else {
        lsp_send_null_definition(id_node)
    }
}

// Dispatches a parsed JSON-RPC message. Returns true if server should terminate.
act lsp_dispatch_message(state: @LspServerState, msg: string) -> bool {
    let doc = json_parse_doc_str(msg, 65536)
    if !doc.ok or doc.root == null {
        return false
    }
    defer json_doc_free(@doc)

    let root = doc.root
    let id_node = json_obj_get_str(root, "id")
    let method_node = json_obj_get_str(root, "method")
    let params_node = json_obj_get_str(root, "params")

    if method_node == null or method_node.kind != JSON_STRING {
        return false
    }

    let m = method_node.str_val

    if slice_eq_str(m, "initialize") {
        lsp_send_initialize_result(id_node)
        return false
    }

    if slice_eq_str(m, "initialized") {
        return false
    }

    if slice_eq_str(m, "shutdown") {
        state.is_shutdown = true
        lsp_send_shutdown_result(id_node)
        return false
    }

    if slice_eq_str(m, "exit") {
        return true
    }

    if slice_eq_str(m, "textDocument/didOpen") {
        if params_node != null and params_node.kind == JSON_OBJECT {
            lsp_handle_did_open(state, params_node)
        }
        return false
    }

    if slice_eq_str(m, "textDocument/didChange") {
        if params_node != null and params_node.kind == JSON_OBJECT {
            lsp_handle_did_change(state, params_node)
        }
        return false
    }

    if slice_eq_str(m, "textDocument/didClose") {
        if params_node != null and params_node.kind == JSON_OBJECT {
            lsp_handle_did_close(state, params_node)
        }
        return false
    }

    if slice_eq_str(m, "textDocument/didSave") {
        if params_node != null and params_node.kind == JSON_OBJECT {
            lsp_handle_did_save(state, params_node)
        }
        return false
    }

    if slice_eq_str(m, "textDocument/documentSymbol") {
        if id_node != null {
            lsp_handle_document_symbol(state, id_node, params_node)
        }
        return false
    }

    if slice_eq_str(m, "textDocument/hover") {
        if id_node != null {
            lsp_handle_hover(state, id_node, params_node)
        }
        return false
    }

    if slice_eq_str(m, "textDocument/definition") {
        if id_node != null {
            lsp_handle_definition(state, id_node, params_node)
        }
        return false
    }

    if slice_eq_str(m, "textDocument/completion") {
        if id_node != null {
            lsp_handle_completion(state, id_node, params_node)
        }
        return false
    }

    if slice_eq_str(m, "textDocument/prepareRename") {
        if id_node != null {
            lsp_handle_prepare_rename(state, id_node, params_node)
        }
        return false
    }

    if slice_eq_str(m, "textDocument/rename") {
        if id_node != null {
            lsp_handle_rename(state, id_node, params_node)
        }
        return false
    }

    if slice_eq_str(m, "textDocument/codeAction") {
        if id_node != null {
            lsp_handle_code_action(state, id_node, params_node)
        }
        return false
    }

    // Unhandled request method
    if id_node != null {
        lsp_send_method_not_found(id_node)
    }

    return false
}

// Main CLI entry point for 'velo lsp' (runs language server over stdio).
act handle_lsp_command() -> i32 {
    let stdin_h = io_stdin_handle()
    if !io_is_valid_handle(stdin_h) {
        println_str("[Velo Error] Failed to acquire stdin handle for LSP")
        return 1
    }
    mut r = reader_init(stdin_h)
    defer reader_free(@r)

    mut line_buf: @u8 = mem.heap_alloc(@u8, 512)

    mut state = LspServerState {
        first_doc: null,
        is_shutdown: false,
    }

    loop {
        let msg = read_lsp_message(@r, line_buf)
        if msg == null {
            break
        }
        let should_exit = lsp_dispatch_message(@state, msg)
        if str.len(msg) > 0 {
            mem.free(msg as @u8)
        }
        if should_exit {
            break
        }
    }

    if line_buf != null {
        mem.free(line_buf)
    }

    // Free all remaining open documents
    mut cur = state.first_doc
    loop cur != null {
        let nxt = cur.next
        if cur.uri != null {
            mem.free(cur.uri as @u8)
        }
        if cur.text != null {
            mem.free(cur.text as @u8)
        }
        mem.free(cur as @u8)
        cur = nxt
    }
    state.first_doc = null

    if state.is_shutdown {
        return 0
    }
    return 0
}
