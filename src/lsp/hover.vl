// Rich Markdown hover tooltip provider for Velo LSP.
// Resolves identifier type signatures, origins, and doc comments on hover.

use std.io
use std.mem
use std.str
use std.json
use std.fs
use "../common/string_builder.vl"
use "../common/utils.vl"
use "../common/diagnostics.vl"
use "../frontend/token.vl"
use "../frontend/lexer.vl"
use "../frontend/parser.vl"
use "../frontend/parser_expr.vl"
use "../frontend/parser_binary.vl"
use "../frontend/parser_stmt.vl"
use "../frontend/parser_decl.vl"
use "../ast/types.vl"
use "../ast/expr.vl"
use "../ast/stmt.vl"
use "transport.vl"
use "analysis.vl"

// Appends a StrSlice into a StringBuilder.
act lsp_hover_append_slice(sb: @StringBuilder, sl: StrSlice) {
    mut i: usize = 0
    loop i < sl.len {
        sb_append_char(sb, sl.ptr[i])
        i += 1
    }
}

// Emits an empty hover response (result: null).
act lsp_send_null_hover(id_node: @JsonValue) {
    mut sb = create_sb(128)
    sb_append_str(@sb, "{\"jsonrpc\":\"2.0\",\"id\":")
    lsp_append_id(@sb, id_node)
    sb_append_str(@sb, ",\"result\":null}")
    let payload = sb_to_string(@sb)
    lsp_send_payload(payload)
}

// Extracts the identifier word and character span at the given 0-based cursor line/column.
act lsp_hover_extract_word(text: string, line0: i32, char0: i32, out_name: @u8, out_start: @i32, out_end: @i32) -> bool {
    let tlen = str.len(text)
    mut cur_line: i32 = 0
    mut line_start: usize = 0
    mut i: usize = 0
    loop i < tlen {
        if cur_line == line0 { break }
        if text[i] == '\n' as u8 {
            cur_line += 1
            line_start = i + 1
        }
        i += 1
    }
    if cur_line != line0 or line_start >= tlen { return false }

    mut line_end: usize = line_start
    loop line_end < tlen and text[line_end] != '\n' as u8 and text[line_end] != '\r' as u8 {
        line_end += 1
    }
    let line_len = line_end - line_start
    if line_len == 0 { return false }

    mut pos: usize = char0 as usize
    if pos >= line_len {
        if line_len > 0 { pos = line_len - 1 } else { return false }
    }

    if !is_ident_part(text[line_start + pos]) {
        if pos > 0 and is_ident_part(text[line_start + pos - 1]) {
            pos = pos - 1
        } else {
            return false
        }
    }

    mut s_pos: usize = pos
    loop s_pos > 0 and is_ident_part(text[line_start + s_pos - 1]) {
        s_pos -= 1
    }
    mut e_pos: usize = pos
    loop e_pos < line_len and is_ident_part(text[line_start + e_pos]) {
        e_pos += 1
    }

    let word_len = e_pos - s_pos
    mut is_let_mut = false
    if word_len == 3 and text[line_start + s_pos] == 'l' as u8 and text[line_start + s_pos + 1] == 'e' as u8 and text[line_start + s_pos + 2] == 't' as u8 {
        is_let_mut = true
    } else if word_len == 3 and text[line_start + s_pos] == 'm' as u8 and text[line_start + s_pos + 1] == 'u' as u8 and text[line_start + s_pos + 2] == 't' as u8 {
        is_let_mut = true
    }

    if is_let_mut {
        mut next_pos = e_pos
        loop next_pos < line_len and (text[line_start + next_pos] == ' ' as u8 or text[line_start + next_pos] == '\t' as u8) {
            next_pos += 1
        }
        if next_pos < line_len and is_ident_part(text[line_start + next_pos]) {
            s_pos = next_pos
            e_pos = next_pos
            loop e_pos < line_len and is_ident_part(text[line_start + e_pos]) {
                e_pos += 1
            }
        }
    }

    let final_len = e_pos - s_pos
    if final_len == 0 or final_len >= 128 { return false }
    mut k: usize = 0
    loop k < final_len {
        out_name[k] = text[line_start + s_pos + k]
        k += 1
    }
    out_name[final_len] = 0 as u8
    out_start.@ = s_pos as i32
    out_end.@ = e_pos as i32
    return true
}

// Recursively searches a statement tree for a local variable declaration matching target.
act lsp_find_local_in_stmt(stmt: @StmtNode, target: string, max_line: i32, out_type: @string) -> bool {
    if stmt == null { return false }
    if stmt.kind == STMT_VAR_DECL {
        if stmt.line <= max_line and slice_eq_str(slice_from_str(target), stmt.name) {
            if stmt.type_name != null and str.len(stmt.type_name) > 0 {
                out_type.@ = stmt.type_name
            } else if stmt.val_expr != null {
                if stmt.val_expr.kind == EXPR_STRUCT_LIT and stmt.val_expr.type_name != null {
                    out_type.@ = stmt.val_expr.type_name
                } else if stmt.val_expr.kind == EXPR_INT {
                    out_type.@ = "i32"
                } else if stmt.val_expr.kind == EXPR_FLOAT {
                    out_type.@ = "f64"
                } else if stmt.val_expr.kind == EXPR_STRING {
                    out_type.@ = "string"
                } else if stmt.val_expr.kind == EXPR_BOOL {
                    out_type.@ = "bool"
                } else {
                    out_type.@ = "inferred"
                }
            } else {
                out_type.@ = "inferred"
            }
            return true
        }
    }
    if stmt.kind == STMT_BLOCK {
        mut cur = stmt.first_stmt
        loop cur != null {
            if lsp_find_local_in_stmt(cur, target, max_line, out_type) {
                return true
            }
            cur = cur.next
        }
    } else if stmt.kind == STMT_IF {
        if lsp_find_local_in_stmt(stmt.body, target, max_line, out_type) { return true }
        if lsp_find_local_in_stmt(stmt.else_branch, target, max_line, out_type) { return true }
    } else if stmt.kind == STMT_LOOP {
        if lsp_find_local_in_stmt(stmt.body, target, max_line, out_type) { return true }
    }
    return false
}

// Formats Markdown representation of a top-level AST declaration.
act lsp_format_decl_markdown(sb: @StringBuilder, decl: @StmtNode, filename: StrSlice) {
    if decl.kind == DECL_FUNCTION {
        sb_append_str(sb, "**act** `")
        sb_append_str(sb, decl.name)
        sb_append_char(sb, '(')
        mut p = decl.first_param
        mut pi: i32 = 0
        loop p != null {
            if pi > 0 { sb_append_str(sb, ", ") }
            sb_append_str(sb, p.name)
            sb_append_str(sb, ": ")
            if p.type_name != null { sb_append_str(sb, p.type_name) }
            pi += 1
            p = p.next
        }
        sb_append_str(sb, ") -> ")
        if decl.return_type != null and str.len(decl.return_type) > 0 {
            sb_append_str(sb, decl.return_type)
        } else {
            sb_append_str(sb, "void")
        }
        sb_append_str(sb, "`\n\n*declared in ")
        lsp_hover_append_slice(sb, filename)
        sb_append_char(sb, ':')
        sb_append_int(sb, decl.line)
        sb_append_char(sb, '*')
    } else if decl.kind == DECL_DATA {
        sb_append_str(sb, "**data** `")
        sb_append_str(sb, decl.name)
        sb_append_char(sb, '`')
        mut f = decl.first_field
        loop f != null {
            sb_append_str(sb, "  \n- `")
            sb_append_str(sb, f.name)
            sb_append_str(sb, ": ")
            if f.type_name != null { sb_append_str(sb, f.type_name) }
            sb_append_char(sb, '`')
            f = f.next
        }
        sb_append_str(sb, "\n\n*declared in ")
        lsp_hover_append_slice(sb, filename)
        sb_append_char(sb, ':')
        sb_append_int(sb, decl.line)
        sb_append_char(sb, '*')
    } else if decl.kind == DECL_KIND {
        sb_append_str(sb, "**kind** `")
        sb_append_str(sb, decl.name)
        sb_append_str(sb, "`  \nvariants: ")
        mut v = decl.first_variant
        mut vi: i32 = 0
        loop v != null {
            if vi > 0 { sb_append_str(sb, ", ") }
            sb_append_str(sb, v.name)
            vi += 1
            v = v.next
        }
        sb_append_str(sb, "\n\n*declared in ")
        lsp_hover_append_slice(sb, filename)
        sb_append_char(sb, ':')
        sb_append_int(sb, decl.line)
        sb_append_char(sb, '*')
    } else if decl.kind == DECL_TYPE_ALIAS {
        sb_append_str(sb, "**aka** `")
        sb_append_str(sb, decl.name)
        sb_append_str(sb, " = ")
        if decl.type_name != null { sb_append_str(sb, decl.type_name) }
        sb_append_str(sb, "`\n\n*declared in ")
        lsp_hover_append_slice(sb, filename)
        sb_append_char(sb, ':')
        sb_append_int(sb, decl.line)
        sb_append_char(sb, '*')
    } else if decl.kind == DECL_EXTERN {
        sb_append_str(sb, "**extern** `")
        sb_append_str(sb, decl.name)
        sb_append_str(sb, "`\n\n*declared in ")
        lsp_hover_append_slice(sb, filename)
        sb_append_char(sb, ':')
        sb_append_int(sb, decl.line)
        sb_append_char(sb, '*')
    }
}

// Processes textDocument/hover request and transmits Markdown hover response.
act lsp_send_hover_result(id_node: @JsonValue, uri: string, text: string, line0: i32, char0: i32) {
    if text == null or str.len(text) == 0 {
        lsp_send_null_hover(id_node)
        return
    }

    mut word_buf: @u8 = mem.heap_alloc(@u8, 128)
    defer mem.free(word_buf)
    mut start_col: i32 = 0
    mut end_col: i32 = 0

    let ok = lsp_hover_extract_word(text, line0, char0, word_buf, @start_col, @end_col)
    if !ok {
        lsp_send_null_hover(id_node)
        return
    }

    let target_name = word_buf as string
    mut md_sb = create_sb(512)
    mut found = false

    diag_collector_start()

    zone {
        let slen = str.len(text)
        mut lex = create_lexer(text, slen, slen + 2)
        tokenize(@lex)

        if lex.dropped_count == 0 {
            mut p: Parser
            init_parser(@p, "memory.vl", text, lex.tokens, lex.token_count)
            let prog = parse_program(@p)

            if prog != null {
                // 1. Look for enclosing act and check parameters/locals
                mut enclosing_act: @StmtNode = null
                mut cur = prog.first_decl
                loop cur != null {
                    if cur.kind == DECL_FUNCTION and cur.line <= line0 + 1 {
                        enclosing_act = cur
                    }
                    cur = cur.next
                }

                if enclosing_act != null {
                    // Check params
                    mut pcur = enclosing_act.first_param
                    loop pcur != null {
                        if slice_eq_str(slice_from_str(target_name), pcur.name) {
                            sb_append_str(@md_sb, "`param **")
                            sb_append_str(@md_sb, target_name)
                            sb_append_str(@md_sb, "**: ")
                            if pcur.type_name != null { sb_append_str(@md_sb, pcur.type_name) }
                            sb_append_char(@md_sb, '`')
                            found = true
                            break
                        }
                        pcur = pcur.next
                    }

                    // Check locals
                    if !found and enclosing_act.body != null {
                        mut ltype: string = null
                        if lsp_find_local_in_stmt(enclosing_act.body, target_name, line0 + 1, @ltype) {
                            sb_append_str(@md_sb, "`local **")
                            sb_append_str(@md_sb, target_name)
                            sb_append_str(@md_sb, "**: ")
                            if ltype != null { sb_append_str(@md_sb, ltype) }
                            sb_append_char(@md_sb, '`')
                            found = true
                        }
                    }
                }

                // 2. Check top-level declarations in the document
                if !found {
                    mut dcur = prog.first_decl
                    loop dcur != null {
                        if dcur.name != null and slice_eq_str(slice_from_str(target_name), dcur.name) {
                            let doc_path = lsp_uri_to_path(uri)
                            let bname = path_basename_str(doc_path)
                            lsp_format_decl_markdown(@md_sb, dcur, bname)
                            found = true
                            break
                        }
                        dcur = dcur.next
                    }
                }
            }
        }
    }

    diag_collector_stop()
    diag_collector_clear()

    // 3. Fallback check for common standard library symbols
    if !found {
        if slice_eq_str(slice_from_str(target_name), "println_str") or slice_eq_str(slice_from_str(target_name), "println") {
            sb_append_str(@md_sb, "**act** `println_str(s: string) -> void`\n\n*standard library std.io*")
            found = true
        } else if slice_eq_str(slice_from_str(target_name), "print_str") or slice_eq_str(slice_from_str(target_name), "print") {
            sb_append_str(@md_sb, "**act** `print_str(s: string) -> void`\n\n*standard library std.io*")
            found = true
        } else if slice_eq_str(slice_from_str(target_name), "fs_read_to_str") {
            sb_append_str(@md_sb, "**act** `fs_read_to_str(path: string) -> string`\n\n*standard library std.fs*")
            found = true
        } else if slice_eq_str(slice_from_str(target_name), "path_join_str") {
            sb_append_str(@md_sb, "**act** `path_join_str(base: string, sub: string) -> string`\n\n*standard library std.path*")
            found = true
        }
    }

    if !found {
        lsp_send_null_hover(id_node)
        return
    }

    mut res_sb = create_sb(512)
    sb_append_str(@res_sb, "{\"jsonrpc\":\"2.0\",\"id\":")
    lsp_append_id(@res_sb, id_node)
    sb_append_str(@res_sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")
    let md_str = sb_to_string(@md_sb)
    lsp_json_escape(@res_sb, md_str)
    mem.free(md_str as @u8)
    sb_append_str(@res_sb, "\"},\"range\":{\"start\":{\"line\":")
    sb_append_int(@res_sb, line0)
    sb_append_str(@res_sb, ",\"character\":")
    sb_append_int(@res_sb, start_col)
    sb_append_str(@res_sb, "},\"end\":{\"line\":")
    sb_append_int(@res_sb, line0)
    sb_append_str(@res_sb, ",\"character\":")
    sb_append_int(@res_sb, end_col)
    sb_append_str(@res_sb, "}}}}")

    let payload = sb_to_string(@res_sb)
    lsp_send_payload(payload)
}
