// Abstract Syntax Tree statement and declaration nodes for the Velo programming language.
use "expr.vl"
use "stmt_factory.vl"

// Statement kind constants
let STMT_EXPR: i32 = 201
let STMT_VAR_DECL: i32 = 202
let STMT_ASSIGN: i32 = 203
let STMT_RETURN: i32 = 204
let STMT_IF: i32 = 205
let STMT_LOOP: i32 = 207
let STMT_ZONE: i32 = 208
let STMT_DEFER: i32 = 209
let STMT_BLOCK: i32 = 210
let STMT_BREAK: i32 = 211
let STMT_CONTINUE: i32 = 212
let STMT_MATCH: i32 = 213
let STMT_FAIL: i32 = 214

// Top-level declaration kind constants
let DECL_DATA: i32 = 301
let DECL_FUNCTION: i32 = 302
let DECL_EXTERN: i32 = 303
let DECL_USE: i32 = 304
let DECL_KIND: i32 = 305
let DECL_TYPE_ALIAS: i32 = 306
let DECL_TEST: i32 = 307

data VariantNode {
    name: string
    discriminant: i32
    has_discriminant: bool
    payload_type: string
    first_field: @FieldNode
    field_count: usize
    line: i32
    col: i32
    next: @VariantNode
}

data CaseNode {
    first_val: @ExprNode
    val_count: usize
    is_default: bool
    body: @StmtNode
    line: i32
    col: i32
    next: @CaseNode
}

data ParamNode {
    name: string
    type_name: string
    line: i32
    col: i32
    next: @ParamNode
}

data FieldNode {
    name: string
    type_name: string
    has_default: bool
    default_value: @ExprNode
    line: i32
    col: i32
    next: @FieldNode
}

// Unified AST Statement & Declaration Node (allocated inside the active zone arena).
data StmtNode {
    kind: i32
    line: i32
    col: i32
    // Identification & Types
    name: string
    type_name: string
    is_mut: bool
    // Expressions
    expr: @ExprNode
    val_expr: @ExprNode
    op: i32
    // Block / Control Flow children
    first_stmt: @StmtNode
    stmt_count: usize
    else_branch: @StmtNode
    body: @StmtNode
    deferred_stmt: @StmtNode
    // Loop constructs
    loop_var: string
    loop_start: @ExprNode
    loop_end: @ExprNode
    loop_step: @ExprNode
    is_inclusive: bool
    is_count: bool
    is_of: bool
    loop_index: string  // 5.2 slice 4: the optional second OF binding (the usize index)
    // Match / Switch constructs
    first_case: @CaseNode
    case_count: usize
    // Function / Struct / Extern / Kind / Use payloads
    first_param: @ParamNode
    param_count: usize
    return_type: string
    first_field: @FieldNode
    field_count: usize
    first_variant: @VariantNode
    variant_count: usize
    type_params: string
    module_path: string
    // Struct layout attributes (`#align(N)` / `#packed`); DECL_DATA only
    align_bytes: i32
    is_packed: bool
    // Intrusive linked list pointer for sequence of statements / declarations
    next: @StmtNode
}

// Represents the root AST node containing all top-level declarations.
data ProgramNode {
    first_decl: @StmtNode
    decl_count: usize
}
