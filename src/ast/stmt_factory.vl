// Factory functions for creating AST statement and declaration nodes.
use sys.mem
use "expr.vl"
use "stmt.vl"

// Creates an expression statement (`expr`).
act make_expr_stmt(expr: @ExprNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_EXPR
    node.expr = expr
    node.line = line
    node.col = col
    return node
}

// Creates a variable declaration statement (`let x = val` or `mut y: i32 = val`).
act make_var_decl_stmt(name: string, type_name: string, val: @ExprNode, is_mut: bool, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_VAR_DECL
    node.name = name
    node.type_name = type_name
    node.val_expr = val
    node.is_mut = is_mut
    node.line = line
    node.col = col
    return node
}

// Creates an assignment statement (`target = val`, `target += val`, etc.).
act make_assign_stmt(target: @ExprNode, op: i32, val: @ExprNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_ASSIGN
    node.expr = target
    node.op = op
    node.val_expr = val
    node.line = line
    node.col = col
    return node
}

// Creates a return statement (`return` or `return expr`).
act make_return_stmt(val: @ExprNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_RETURN
    node.val_expr = val
    node.line = line
    node.col = col
    return node
}

// Creates an if statement with optional else/elif branch.
act make_if_stmt(cond: @ExprNode, then_body: @StmtNode, else_branch: @StmtNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_IF
    node.expr = cond
    node.body = then_body
    node.else_branch = else_branch
    node.line = line
    node.col = col
    return node
}

// Creates a range loop statement (`loop i in start..end:step { ... }`).
act make_loop_stmt(var_name: string, start_expr: @ExprNode, end_expr: @ExprNode, step_expr: @ExprNode, is_inclusive: bool, body: @StmtNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_LOOP; node.loop_var = var_name; node.loop_start = start_expr; node.loop_end = end_expr
    node.loop_step = step_expr; node.is_inclusive = is_inclusive; node.is_of = false; node.body = body
    node.line = line; node.col = col
    return node
}

// Creates an expression loop statement (count repeat or condition).
act make_loop_expr_stmt(expr: @ExprNode, is_count: bool, body: @StmtNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_LOOP; node.loop_var = "it"; node.expr = expr; node.is_count = is_count
    node.is_of = false; node.body = body; node.loop_index = null
    node.line = line; node.col = col
    return node
}

// Creates an infinite loop statement (`loop { ... }`).
act make_loop_inf_stmt(body: @StmtNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_LOOP; node.loop_var = "it"; node.is_of = false; node.body = body; node.loop_index = null
    node.line = line; node.col = col
    return node
}

// 5.2: creates a shelf value loop statement (`loop v of coll { ... }`).
// Collection rides the `expr` slot; `is_of` = snapshot iteration. Slice 4:
// `index_name` (may be null) = the optional second binding (usize step index).
act make_loop_of_stmt(var_name: string, index_name: string, coll_expr: @ExprNode, body: @StmtNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_LOOP; node.loop_var = var_name; node.loop_index = index_name; node.expr = coll_expr
    node.is_of = true; node.body = body
    node.line = line; node.col = col
    return node
}

// Creates a memory arena zone statement. `size` (optional) = §4.1 private-arena capacity; null = default arena.
act make_zone_stmt(body: @StmtNode, size: @ExprNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_ZONE; node.body = body
    node.expr = size
    node.line = line
    node.col = col
    return node
}

// Creates a deferred execution statement (`defer <stmt>`).
act make_defer_stmt(stmt: @StmtNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_DEFER
    node.deferred_stmt = stmt
    node.line = line
    node.col = col
    return node
}

// Creates a code block statement (`{ stmt1; stmt2; ... }`).
act make_block_stmt(first_stmt: @StmtNode, count: usize, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_BLOCK
    node.first_stmt = first_stmt
    node.stmt_count = count
    node.line = line
    node.col = col
    return node
}

// Creates a break statement (`break`).
act make_break_stmt(line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_BREAK
    node.line = line
    node.col = col
    return node
}

// Creates a continue statement (`continue`).
act make_continue_stmt(line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_CONTINUE
    node.line = line
    node.col = col
    return node
}

// Creates a match branch case node.
act make_case_node(first_val: @ExprNode, val_count: usize, is_default: bool, body: @StmtNode, line: i32, col: i32) -> @CaseNode {
    mut node: @CaseNode = mem.alloc(@CaseNode, 1)
    node.first_val = first_val
    node.val_count = val_count
    node.is_default = is_default
    node.body = body
    node.line = line
    node.col = col
    return node
}

// Creates a match / switch statement.
act make_match_stmt(expr: @ExprNode, first_case: @CaseNode, case_count: usize, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = STMT_MATCH
    node.expr = expr
    node.first_case = first_case
    node.case_count = case_count
    node.line = line
    node.col = col
    return node
}

// Creates a top-level struct data declaration (`data Name { ... }`).
act make_data_decl(name: string, first_field: @FieldNode, count: usize, align_bytes: i32, is_packed: bool, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = DECL_DATA
    node.name = name
    node.first_field = first_field
    node.field_count = count
    node.align_bytes = align_bytes
    node.is_packed = is_packed
    node.line = line
    node.col = col
    return node
}

// Creates a top-level type alias declaration (`aka EntityId = u64`).
act make_type_alias_decl(name: string, target: string, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = DECL_TYPE_ALIAS
    node.name = name
    node.type_name = target
    node.line = line
    node.col = col
    return node
}

// Creates a top-level function declaration (`act Name(params) -> RetType { ... }`).
act make_function_decl(name: string, first_param: @ParamNode, param_count: usize, ret_type: string, body: @StmtNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = DECL_FUNCTION
    node.name = name
    node.first_param = first_param
    node.param_count = param_count
    node.return_type = ret_type
    node.body = body
    node.line = line
    node.col = col
    return node
}

// Creates an external foreign function declaration (`extern act Name(params) -> RetType`).
act make_extern_decl(name: string, first_param: @ParamNode, param_count: usize, ret_type: string, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = DECL_EXTERN
    node.name = name
    node.first_param = first_param
    node.param_count = param_count
    node.return_type = ret_type
    node.line = line
    node.col = col
    return node
}

// Creates a module import statement (`use "module.vl"` or `use sys.io`).
act make_use_decl(mod_path: string, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = DECL_USE; node.module_path = mod_path; node.line = line; node.col = col
    return node
}

// Creates a parameter descriptor node.
act make_param_node(name: string, type_name: string, line: i32, col: i32) -> @ParamNode {
    mut p: @ParamNode = mem.alloc(@ParamNode, 1)
    p.name = name; p.type_name = type_name; p.line = line; p.col = col; p.next = null
    return p
}

// Creates a struct field descriptor node.
act make_field_node(name: string, type_name: string, has_default: bool, default_value: @ExprNode, line: i32, col: i32) -> @FieldNode {
    mut f: @FieldNode = mem.alloc(@FieldNode, 1)
    f.name = name; f.type_name = type_name; f.has_default = has_default; f.default_value = default_value; f.line = line; f.col = col; f.next = null
    return f
}

// Creates a kind (enum / tagged union) declaration node.
act make_kind_decl(name: string, first_variant: @VariantNode, count: usize, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = DECL_KIND; node.name = name; node.first_variant = first_variant; node.variant_count = count; node.line = line; node.col = col
    return node
}

// Creates a variant descriptor node.
act make_variant_node(name: string, disc: i32, has_disc: bool, ptype: string, f_field: @FieldNode, f_count: usize, line: i32, col: i32) -> @VariantNode {
    mut v: @VariantNode = mem.alloc(@VariantNode, 1)
    v.name = name; v.discriminant = disc; v.has_discriminant = has_disc; v.payload_type = ptype; v.first_field = f_field; v.field_count = f_count; v.line = line; v.col = col; v.next = null
    return v
}

// Creates a test declaration node (`test "name" { ... }`).
act make_test_decl(name: string, body: @StmtNode, line: i32, col: i32) -> @StmtNode {
    mut node: @StmtNode = mem.alloc(@StmtNode, 1)
    node.kind = DECL_TEST; node.name = name; node.body = body; node.line = line; node.col = col
    return node
}

// Creates the root program node containing all declarations.
act make_program_node(first_decl: @StmtNode, count: usize) -> @ProgramNode {
    mut prog: @ProgramNode = mem.alloc(@ProgramNode, 1)
    prog.first_decl = first_decl
    prog.decl_count = count
    return prog
}
