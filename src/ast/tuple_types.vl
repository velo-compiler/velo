// Tuple type representation, parsing, and C name mangling utilities for Velo.
use "../common/utils.vl"
use "../common/string_builder.vl"

// Checks if a type name represents a tuple type (e.g. "(string, bool)" or "@(i32, f64)").
act is_tuple_type(name: string) -> bool {
    if name == null { return false }
    mut clean = name
    loop str.len(clean) > 0 and clean[0] == '@' {
        clean = copy_slice_to_string(clean, 1, str.len(clean) - 1)
    }
    let len = str.len(clean)
    if len < 5 or clean[0] != '(' or clean[len - 1] != ')' { return false }
    mut depth: usize = 0
    mut has_comma = false
    mut i: usize = 0
    loop i < len {
        let c = clean[i]
        if c == '(' or c == '[' { depth += 1 }
        else if c == ')' or c == ']' { depth -= 1 }
        else if c == ',' and depth == 1 { has_comma = true }
        i += 1
    }
    return has_comma
}

// Counts the number of element types in a tuple type string.
act tuple_elem_count(name: string) -> usize {
    if not is_tuple_type(name) { return 0 }
    mut clean = name
    loop str.len(clean) > 0 and clean[0] == '@' {
        clean = copy_slice_to_string(clean, 1, str.len(clean) - 1)
    }
    let len = str.len(clean)
    mut depth: usize = 0
    mut count: usize = 1
    mut i: usize = 0
    loop i < len {
        let c = clean[i]
        if c == '(' or c == '[' { depth += 1 }
        else if c == ')' or c == ']' { depth -= 1 }
        else if c == ',' and depth == 1 { count += 1 }
        i += 1
    }
    return count
}

// Extracts the i-th element type string from a tuple type "(T0, T1, ...)".
act tuple_elem_type(name: string, target_idx: usize) -> string {
    mut clean = name
    loop str.len(clean) > 0 and clean[0] == '@' {
        clean = copy_slice_to_string(clean, 1, str.len(clean) - 1)
    }
    let len = str.len(clean)
    mut depth: usize = 0
    mut cur_idx: usize = 0
    mut start_pos: usize = 1
    mut i: usize = 0
    loop i < len {
        let c = clean[i]
        if c == '(' or c == '[' { depth += 1 }
        else if c == ')' or c == ']' { depth -= 1 }
        if (c == ',' and depth == 1) or (i == len - 1 and depth == 0) {
            if cur_idx == target_idx {
                mut seg_start = start_pos
                loop seg_start < i and clean[seg_start] == ' ' { seg_start += 1 }
                return copy_slice_to_string(clean, seg_start, i - seg_start)
            }
            cur_idx += 1
            start_pos = i + 1
        }
        i += 1
    }
    return ""
}

// Generates a valid C struct identifier for a tuple type (e.g. "_Velo_Tuple_string_bool").
act tuple_c_name(name: string) -> string {
    if name == null { return "" }
    mut clean = name
    loop str.len(clean) > 0 and clean[0] == '@' {
        clean = copy_slice_to_string(clean, 1, str.len(clean) - 1)
    }
    mut sb = create_sb(str.len(clean) + 16)
    sb_append_str(@sb, "_Velo_Tuple_")
    mut i: usize = 0
    loop i < str.len(clean) {
        let c = clean[i]
        if c == '(' or c == ')' or c == ' ' {
            // skip
        } else if c == ',' {
            sb_append_char(@sb, '_')
        } else if c == '@' {
            sb_append_str(@sb, "ptr_")
        } else if c == '[' or c == ']' {
            sb_append_char(@sb, '_')
        } else {
            sb_append_char(@sb, c)
        }
        i += 1
    }
    return sb_to_string(@sb)
}

