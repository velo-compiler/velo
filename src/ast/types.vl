// Type representation and descriptors for the Velo programming language AST.

// Type kind constants
let TYPE_KIND_PRIMITIVE: i32 = 1
let TYPE_KIND_POINTER: i32 = 2
let TYPE_KIND_USER: i32 = 3
let TYPE_KIND_VOID: i32 = 4

// Represents a type descriptor in the Velo AST.
// Supports primitive types (i32, f32, bool, string, etc.),
// pointers (@T, @@T), and user-defined struct types.
data TypeNode {
    kind: i32
    name: string
    elem_type: @TypeNode
    line: i32
    col: i32
}

// Allocates and initializes a primitive type descriptor.
//
// Parameters:
//   name: Type identifier (e.g. "i32", "f32", "string", "bool").
//   line: Source line number.
//   col: Source column number.
//
// Memory Ownership:
//   Allocated inside the active zone arena.
act make_primitive_type(name: string, line: i32, col: i32) -> @TypeNode {
    mut t: @TypeNode = mem.alloc(@TypeNode, 1)
    t.kind = TYPE_KIND_PRIMITIVE
    t.name = name
    t.elem_type = null
    t.line = line
    t.col = col
    return t
}

// Allocates and initializes a pointer type descriptor (@T).
//
// Parameters:
//   elem: Pointee type descriptor.
//   line: Source line number.
//   col: Source column number.
//
// Memory Ownership:
//   Allocated inside the active zone arena.
act make_pointer_type(elem: @TypeNode, line: i32, col: i32) -> @TypeNode {
    mut t: @TypeNode = mem.alloc(@TypeNode, 1)
    t.kind = TYPE_KIND_POINTER
    t.name = ""
    t.elem_type = elem
    t.line = line
    t.col = col
    return t
}

// Allocates and initializes a user-defined struct type descriptor.
//
// Parameters:
//   name: Name of the struct (e.g. "Point", "Token").
//   line: Source line number.
//   col: Source column number.
//
// Memory Ownership:
//   Allocated inside the active zone arena.
act make_user_type(name: string, line: i32, col: i32) -> @TypeNode {
    mut t: @TypeNode = mem.alloc(@TypeNode, 1)
    t.kind = TYPE_KIND_USER
    t.name = name
    t.elem_type = null
    t.line = line
    t.col = col
    return t
}

// Allocates and initializes a void return type descriptor.
act make_void_type(line: i32, col: i32) -> @TypeNode {
    mut t: @TypeNode = mem.alloc(@TypeNode, 1)
    t.kind = TYPE_KIND_VOID
    t.name = "void"
    t.elem_type = null
    t.line = line
    t.col = col
    return t
}

// Checks if a type descriptor represents a pointer type.
act type_is_pointer(t: @TypeNode) -> bool {
    if t == null { return false }
    return t.kind == TYPE_KIND_POINTER
}

// Checks if a type name is an integer type.
act is_int_type(name: string) -> bool {
    if name == null { return false }
    if name == "i32" or name == "i64" or name == "u8" or name == "i8" or
       name == "u16" or name == "u32" or name == "u64" or name == "i16" or
       name == "usize" or name == "isize" {
        return true
    }
    return false
}

// Checks if a type name is a signed integer type.
act is_signed_int_type(name: string) -> bool {
    if name == null { return false }
    return name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize"
}

// Checks if a type name is an unsigned integer type.
act is_unsigned_int_type(name: string) -> bool {
    if name == null { return false }
    return name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize"
}

// Checks if a type name is a floating point type.
act is_float_type(name: string) -> bool {
    if name == null { return false }
    return name == "f32" or name == "f64"
}

// Checks if a type name is a SIMD vector type.
act is_simd_type(name: string) -> bool {
    if name == null { return false }
    return name == "f32x4" or name == "i32x4"
}

// Strips a leading pointer symbol '@' from a type string (e.g. "@Point" -> "Point").
act strip_pointer_prefix(type_name: string) -> string {
    if type_name == null { return "" }
    let len = str.len(type_name)
    if len > 0 and type_name[0] == '@' {
        let plen = len - 1
        mut buf: @u8 = mem.alloc(@u8, plen + 1)
        mut i: usize = 0
        loop i < plen {
            buf[i] = type_name[1 + i]
            i += 1
        }
        buf[plen] = 0 as u8
        return buf as string
    }
    return type_name
}

// Prepends a pointer symbol '@' to a type string (e.g. "i32" -> "@i32").
act prepend_pointer_prefix(type_name: string) -> string {
    if type_name == null { return "@void" }
    let len = str.len(type_name)
    let plen = len + 1
    mut buf: @u8 = mem.alloc(@u8, plen + 1)
    buf[0] = '@'
    mut i: usize = 0
    loop i < len {
        buf[1 + i] = type_name[i]
        i += 1
    }
    buf[plen] = 0 as u8
    return buf as string
}

// Checks if a type name corresponds to a primitive built-in type.
act is_primitive_type(name: string) -> bool {
    if name == null { return false }
    if is_int_type(name) or is_float_type(name) or is_simd_type(name) or name == "bool" or name == "string" or name == "void" {
        return true
    }
    return false
}

// Checks if a type name is a function pointer type (e.g. `act(...) -> Ret`).
act is_act_type_name(name: string) -> bool {
    if name == null { return false }
    let clean = strip_pointer_prefix(name)
    let len = str.len(clean)
    if len >= 4 and clean[0] == 'a' and clean[1] == 'c' and clean[2] == 't' and clean[3] == '(' {
        return true
    }
    return false
}

// Checks if two type names are structurally or nominally compatible.
act types_are_compatible(expected: string, actual: string) -> bool {
    if expected == null or actual == null { return false }
    if expected == actual { return true }
    if is_act_type_name(expected) and is_act_type_name(actual) {
        let e_clean = strip_pointer_prefix(expected)
        let a_clean = strip_pointer_prefix(actual)
        if e_clean == a_clean { return true }
    }
    if actual == "@void" and ((str.len(expected) > 0 and expected[0] == '@') or expected == "string" or is_act_type_name(expected)) { return true }
    if expected == "@void" and ((str.len(actual) > 0 and actual[0] == '@') or actual == "string" or is_act_type_name(actual)) { return true }
    if is_int_type(expected) and is_int_type(actual) { return true }
    if is_float_type(expected) and is_float_type(actual) { return true }
    if (expected == "@u8" and actual == "string") or (expected == "string" and actual == "@u8") { return true }
    return false
}

