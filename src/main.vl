// Main CLI driver and command dispatcher for the self-hosted Velo compiler.
use sys.io
use sys.fs
use "backend/driver.vl"

// Prints the command-line usage manual.
act print_usage() {
    io.println("Velo Programming Language Compiler (Self-Hosted v2.0)")
    io.println("Usage:")
    io.println("  velo run <source.vl>               Compile and run a Velo program")
    io.println("  velo build <source.vl> -o <binary> Compile to standalone native executable")
    io.println("  velo emit-c <source.vl>            Emit generated C99 code to stdout")
    io.println("  velo version                       Display compiler version")
    io.println("  velo help                          Display this help manual")
}

// Main CLI argument dispatcher.
act main(argc: i32, argv: @string) -> i32 {
    if argc < 2 {
        print_usage()
        return 0
    }

    let cmd = argv[1]

    if cmd == "version" or cmd == "--version" {
        io.println("Velo v2.0 (Self-Hosted Native Compiler)")
        io.println("Target: Standard C99 / Native Machine Code")
        return 0
    }

    if cmd == "help" or cmd == "--help" {
        print_usage()
        return 0
    }

    if cmd == "run" {
        if argc < 3 {
            io.println("[Velo Error] 'run' requires a source file path")
            return 1
        }
        let source_file = argv[2]
        mut exit_code = 0
        zone {
            exit_code = run_source_file(source_file)
        }
        return exit_code
    }

    if cmd == "emit-c" {
        if argc < 3 {
            io.println("[Velo Error] 'emit-c' requires a source file path")
            return 1
        }
        let source_file = argv[2]
        zone {
            let c_code = compile_source_to_c(source_file)
            if c_code != null {
                io.println(c_code)
            } else {
                return 1
            }
        }
        return 0
    }

    if cmd == "build" {
        if argc < 3 {
            io.println("[Velo Error] 'build' requires a source file path")
            return 1
        }
        let source_file = argv[2]
        mut output_exe = ""
        if argc >= 5 and argv[3] == "-o" {
            output_exe = argv[4]
        }
        mut ok = false
        zone {
            ok = build_executable(source_file, output_exe)
            if ok {
                io.println("[Velo] Successfully built binary!")
            } else {
                io.println("[Velo Error] Build failed.")
            }
        }
        if ok {
            return 0
        }
        return 1
    }

    io.println("[Velo Error] Unknown command: '{cmd}'. Run 'velo help' for usage.")
    return 1
}
