// Main CLI driver and command dispatcher for the self-hosted Velo compiler.
use sys.io
use sys.fs
use "backend/driver.vl"
use "backend/check.vl"
use "common/diagnostics.vl"

// Prints the command-line usage manual.
act print_usage() {
    io.println("Velo Programming Language Compiler (Self-Hosted v2.0)")
    io.println("Usage:")
    io.println("  velo run <source.vl> [-l<lib>] [-L<dir>] [--debug|--release] [-O<level>]")
    io.println("  velo build <source.vl> [-o <bin>] [-l<lib>] [-L<dir>] [--debug|--release]")
    io.println("  velo emit-c <source.vl>            Emit generated C99 code to stdout")
    io.println("  velo check <source.vl> [--json] [--color auto|always|never]")
    io.println("  velo doc <source.vl> [-o <out.md>] Extract API documentation to Markdown")
    io.println("  velo lsp                           Start Velo Language Server (LSP stdio)")
    io.println("  velo version                       Display compiler version")
    io.println("  velo help                          Display this help manual")
}

// 6.2 Optimization Flags & Build Modes
act resolve_opt_flags(debug_mode: bool, release_mode: bool, opt_level: string) -> string {
    mut sb = create_sb(64)
    if opt_level != null and str.len(opt_level) > 0 {
        sb_append_str(@sb, "-O")
        sb_append_str(@sb, opt_level)
    } else if debug_mode {
        sb_append_str(@sb, "-O0")
    } else if release_mode {
        sb_append_str(@sb, "-O3")
    } else {
        sb_append_str(@sb, "-O2")
    }
    if debug_mode {
        sb_append_str(@sb, " -g")
    }
    if release_mode {
        sb_append_str(@sb, " -flto")
    }
    return sb_to_string(@sb)
}

// Main CLI argument dispatcher.
act main(argc: i32, argv: @string) -> i32 {
    if argc < 2 {
        print_usage()
        return 0
    }

    let cmd = argv[1]
    // 5.2 slice 11: the --unsafe-shelf-index knob rides any argument position
    // (run/build/emit-c consume positional + -o slots; scan once up top).
    mut unsafe_index: bool = false
    mut si: i32 = 2
    loop si < argc {
        if argv[si] == "--unsafe-shelf-index" { unsafe_index = true }
        si += 1
    }

    if cmd == "version" or cmd == "--version" {
        io.println("Velo v2.0 (Self-Hosted Native Compiler)")
        io.println("Target: Standard C99 / Native Machine Code")
        return 0
    }

    if cmd == "help" or cmd == "--help" {
        print_usage()
        return 0
    }

    if cmd == "run" {
        if argc < 3 {
            io.println("[Velo Error] 'run' requires a source file path")
            return 1
        }
        mut source_file = ""
        mut debug_mode: bool = false
        mut release_mode: bool = false
        mut opt_level = ""
        mut linker_sb = create_sb(256)
        mut i: i32 = 2
        loop i < argc {
            let arg = argv[i]
            if arg == "--debug" {
                debug_mode = true
            } else if arg == "--release" {
                release_mode = true
            } else if arg == "-O" and i + 1 < argc {
                opt_level = argv[i + 1]
                i += 1
            } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'O' {
                opt_level = copy_slice_to_string(arg, 2, str.len(arg) - 2)
            } else if arg == "-l" and i + 1 < argc {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, "-l")
                sb_append_str(@linker_sb, argv[i + 1])
                i += 1
            } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'l' {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, arg)
            } else if arg == "-L" and i + 1 < argc {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, "-L")
                sb_append_str(@linker_sb, argv[i + 1])
                i += 1
            } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'L' {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, arg)
            } else if arg != "--unsafe-shelf-index" and str.len(source_file) == 0 {
                source_file = arg
            }
            i += 1
        }
        if str.len(source_file) == 0 {
            io.println("[Velo Error] 'run' requires a source file path")
            return 1
        }
        if debug_mode and release_mode {
            io.println("[Velo Error] Cannot specify both --debug and --release")
            return 1
        }
        let opt_flags = resolve_opt_flags(debug_mode, release_mode, opt_level)
        let linker_flags = sb_to_string(@linker_sb)
        mut exit_code = 0
        zone {
            exit_code = run_source_file(source_file, unsafe_index, opt_flags, linker_flags)
        }
        return exit_code
    }

    if cmd == "emit-c" {
        if argc < 3 {
            io.println("[Velo Error] 'emit-c' requires a source file path")
            return 1
        }
        let source_file = argv[2]
        zone {
            let c_code = compile_source_to_c(source_file, unsafe_index)
            if c_code != null {
                io.println(c_code)
            } else {
                return 1
            }
        }
        return 0
    }

    if cmd == "build" {
        if argc < 3 {
            io.println("[Velo Error] 'build' requires a source file path")
            return 1
        }
        mut source_file = ""
        mut output_exe = ""
        mut debug_mode: bool = false
        mut release_mode: bool = false
        mut opt_level = ""
        mut linker_sb = create_sb(256)
        mut i: i32 = 2
        loop i < argc {
            let arg = argv[i]
            if arg == "-o" and i + 1 < argc {
                output_exe = argv[i + 1]
                i += 1
            } else if arg == "--debug" {
                debug_mode = true
            } else if arg == "--release" {
                release_mode = true
            } else if arg == "-O" and i + 1 < argc {
                opt_level = argv[i + 1]
                i += 1
            } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'O' {
                opt_level = copy_slice_to_string(arg, 2, str.len(arg) - 2)
            } else if arg == "-l" and i + 1 < argc {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, "-l")
                sb_append_str(@linker_sb, argv[i + 1])
                i += 1
            } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'l' {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, arg)
            } else if arg == "-L" and i + 1 < argc {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, "-L")
                sb_append_str(@linker_sb, argv[i + 1])
                i += 1
            } else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'L' {
                if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }
                sb_append_str(@linker_sb, arg)
            } else if arg != "--unsafe-shelf-index" and str.len(source_file) == 0 {
                source_file = arg
            }
            i += 1
        }
        if str.len(source_file) == 0 {
            io.println("[Velo Error] 'build' requires a source file path")
            return 1
        }
        if debug_mode and release_mode {
            io.println("[Velo Error] Cannot specify both --debug and --release")
            return 1
        }
        let opt_flags = resolve_opt_flags(debug_mode, release_mode, opt_level)
        let linker_flags = sb_to_string(@linker_sb)
        mut ok = false
        zone {
            ok = build_executable(source_file, output_exe, unsafe_index, opt_flags, linker_flags)
            if ok {
                io.println("[Velo] Successfully built binary!")
            } else {
                io.println("[Velo Error] Build failed.")
            }
        }
        if ok {
            return 0
        }
        return 1
    }

    if cmd == "check" {
        if argc < 3 {
            io.println("[Velo Error] 'check' requires a source file path")
            return 1
        }
        mut source_file = ""
        mut json_mode: bool = false
        mut color_always: bool = false
        mut i: i32 = 2
        loop i < argc {
            let arg = argv[i]
            if arg == "--json" {
                json_mode = true
            } else if arg == "--color=always" {
                color_always = true
            } else if arg == "--color" and i + 1 < argc and argv[i + 1] == "always" {
                color_always = true
                i += 1
            } else if arg == "--color=never" or arg == "--color=auto" {
                // explicit never or auto
            } else if arg == "--color" and i + 1 < argc and (argv[i + 1] == "never" or argv[i + 1] == "auto") {
                i += 1
            } else if arg != "--unsafe-shelf-index" and str.len(source_file) == 0 {
                source_file = arg
            }
            i += 1
        }
        if str.len(source_file) == 0 {
            io.println("[Velo Error] 'check' requires a source file path")
            return 1
        }
        if json_mode {
            pretty_set_color(false)
            mut rc: i32 = 0
            zone {
                rc = run_check_json(source_file, unsafe_index)
            }
            return rc
        }
        pretty_set_color(color_always)
        mut ok: bool = false
        zone {
            ok = run_check_pretty(source_file, unsafe_index)
        }
        if ok {
            io.println("[Velo] Check passed: {source_file}")
            return 0
        }
        return 1
    }

    if cmd == "doc" {
        if argc < 3 {
            io.println("[Velo Error] 'doc' requires a source file path")
            return 1
        }
        let source_file = argv[2]
        mut output_file = ""
        if argc >= 5 and argv[3] == "-o" {
            output_file = argv[4]
        }
        zone {
            let docs = generate_docs_for_source(source_file)
            if docs == null {
                return 1
            }
            if str.len(output_file) > 0 {
                fs.write_file(output_file, docs)
                io.println("[Velo] Successfully generated documentation: {output_file}")
            } else {
                io.print(docs)
            }
        }
        return 0
    }

    if cmd == "lsp" {
        let rc = system("python -m velo.lsp")
        return rc
    }

    io.println("[Velo Error] Unknown command: '{cmd}'. Run 'velo help' for usage.")
    return 1
}
