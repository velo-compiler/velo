// Main CLI driver and command dispatcher for the self-hosted Velo compiler.
use std.io
use std.fs
use "backend/driver.vl"
use "backend/check.vl"
use "common/diagnostics.vl"
use "common/manifest.vl"
use "backend/driver_pkg.vl"
use "cli_cmd.vl"
use "lsp/server.vl"
use "tooling/formatter.vl"

// Main CLI argument dispatcher.
act main(argc: i32, argv: @string) -> i32 {
    if argc < 2 {
        print_usage()
        return 0
    }

    let cmd = argv[1]
    // 5.2 slice 11: the --unsafe-shelf-index knob rides any argument position
    // (run/build/emit-c consume positional + -o slots; scan once up top).
    mut unsafe_index: bool = false
    mut no_line_directives: bool = false
    mut strict_safety: bool = false
    mut si: i32 = 2
    loop si < argc {
        if argv[si] == "--unsafe-shelf-index" { unsafe_index = true }
        if argv[si] == "--no-line-directives" { no_line_directives = true }
        if argv[si] == "--strict-safety" { strict_safety = true }
        si += 1
    }

    if cmd == "version" or cmd == "--version" {
        println_str("Velo v2.0 (Self-Hosted Native Compiler)")
        println_str("Target: Standard C99 / Native Machine Code")
        return 0
    }

    if cmd == "help" or cmd == "--help" {
        print_usage()
        return 0
    }

    if cmd == "lsp" or cmd == "--lsp" {
        return handle_lsp_command()
    }

    if cmd == "run" {
        return handle_run_cmd_opts(argc, argv as @string, unsafe_index, no_line_directives, strict_safety)
    }

    if cmd == "emit-c" {
        if argc < 3 {
            println_str("[Velo Error] 'emit-c' requires a source file path")
            return 1
        }
        mut source_file = ""
        mut out_file = ""
        mut i: i32 = 2
        loop i < argc {
            let arg = argv[i]
            if (arg == "-o" or arg == "--output") and i + 1 < argc {
                out_file = argv[i + 1]
                i += 1
            } else if arg != "--unsafe-shelf-index" and arg != "--no-line-directives" and arg != "--strict-safety" and str.len(source_file) == 0 {
                source_file = arg
            }
            i += 1
        }
        if str.len(source_file) == 0 {
            println_str("[Velo Error] 'emit-c' requires a source file path")
            return 1
        }
        zone {
            let c_code = compile_source_to_c_strict(source_file, unsafe_index, no_line_directives, strict_safety)
            if c_code != null {
                if str.len(out_file) > 0 {
                    let ok = fs_write_str(out_file, c_code)
                    if not ok {
                        println_str("[Velo Error] Failed to write output file: {out_file}")
                        return 1
                    }
                } else {
                    println_str(c_code)
                }
            } else {
                return 1
            }
        }
        return 0
    }

    if cmd == "build" {
        return handle_build_cmd_opts(argc, argv as @string, unsafe_index, no_line_directives, strict_safety)
    }

    if cmd == "check" {
        if argc < 3 {
            println_str("[Velo Error] 'check' requires a source file path")
            return 1
        }
        mut source_file = ""
        mut json_mode: bool = false
        mut color_always: bool = false
        mut i: i32 = 2
        loop i < argc {
            let arg = argv[i]
            if arg == "--json" {
                json_mode = true
            } else if arg == "--color=always" {
                color_always = true
            } else if arg == "--color" and i + 1 < argc and argv[i + 1] == "always" {
                color_always = true
                i += 1
            } else if arg == "--color=never" or arg == "--color=auto" {
                // explicit never or auto
            } else if arg == "--color" and i + 1 < argc and (argv[i + 1] == "never" or argv[i + 1] == "auto") {
                i += 1
            } else if arg != "--unsafe-shelf-index" and arg != "--no-line-directives" and arg != "--strict-safety" and str.len(source_file) == 0 {
                source_file = arg
            }
            i += 1
        }
        if str.len(source_file) == 0 {
            println_str("[Velo Error] 'check' requires a source file path")
            return 1
        }
        if json_mode {
            pretty_set_color(false)
            mut rc: i32 = 0
            zone {
                rc = run_check_json_opts(source_file, unsafe_index, strict_safety)
            }
            return rc
        }
        pretty_set_color(color_always)
        mut ok: bool = false
        zone {
            ok = run_check_pretty_opts(source_file, unsafe_index, strict_safety)
        }
        if ok {
            println_str("[Velo] Check passed: {source_file}")
            return 0
        }
        return 1
    }

    if cmd == "doc" {
        if argc < 3 {
            println_str("[Velo Error] 'doc' requires a source file path")
            return 1
        }
        let source_file = argv[2]
        mut output_file = ""
        if argc >= 5 and argv[3] == "-o" {
            output_file = argv[4]
        }
        zone {
            let docs = generate_docs_for_source(source_file)
            if docs == null {
                return 1
            }
            if str.len(output_file) > 0 {
                fs_write_str(output_file, docs)
                println_str("[Velo] Successfully generated documentation: {output_file}")
            } else {
                print_str(docs); io_flush_stdout()
            }
        }
        return 0
    }

    if cmd == "test" {
        mut target_path = ""
        mut filter_arg = ""
        mut cc = "gcc"
        mut debug_mode: bool = false
        mut release_mode: bool = false
        mut opt_level = ""
        mut linker_sb = create_sb(256)
        mut i: i32 = 2
        loop i < argc {
            let arg = argv[i]
            if arg == "--cc" and i + 1 < argc { cc = argv[i + 1]; i += 1 }
            else if str.len(arg) > 5 and arg[0] == '-' and arg[1] == '-' and arg[2] == 'c' and arg[3] == 'c' and arg[4] == '=' { cc = copy_slice_to_string(arg, 5, str.len(arg) - 5) }
            else if arg == "--debug" { debug_mode = true }
            else if arg == "--release" { release_mode = true }
            else if (arg == "--filter" or arg == "-k") and i + 1 < argc { filter_arg = argv[i + 1]; i += 1 }
            else if arg == "-O" and i + 1 < argc { opt_level = argv[i + 1]; i += 1 }
            else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'O' { opt_level = copy_slice_to_string(arg, 2, str.len(arg) - 2) }
            else if arg == "-l" and i + 1 < argc { if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }; sb_append_str(@linker_sb, "-l"); sb_append_str(@linker_sb, argv[i + 1]); i += 1 }
            else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'l' { if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }; sb_append_str(@linker_sb, arg) }
            else if arg == "-L" and i + 1 < argc { if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }; sb_append_str(@linker_sb, "-L"); sb_append_str(@linker_sb, quote_path(path_to_native_str(argv[i + 1]))); i += 1 }
            else if str.len(arg) > 2 and arg[0] == '-' and arg[1] == 'L' { if linker_sb.len > 0 { sb_append_char(@linker_sb, ' ') }; sb_append_str(@linker_sb, "-L"); let raw_path = copy_slice_to_string(arg, 2, str.len(arg) - 2); sb_append_str(@linker_sb, quote_path(path_to_native_str(raw_path))) }
            else if arg != "--unsafe-shelf-index" and arg != "--no-line-directives" and str.len(target_path) == 0 { target_path = arg }
            i += 1
        }
        if str.len(target_path) == 0 { target_path = "." }
        if cc != "gcc" and cc != "cl" and cc != "clang" {
            println_str("[Velo Error] Unknown C compiler backend '{cc}'. Expected 'gcc', 'clang', or 'cl'.")
            return 1
        }
        if debug_mode and release_mode {
            println_str("[Velo Error] Cannot specify both --debug and --release")
            return 1
        }
        let opt_flags = resolve_opt_flags(debug_mode, release_mode, opt_level)
        let linker_flags = sb_to_string(@linker_sb)
        mut rc: i32 = 0
        zone {
            rc = test_target_opts(target_path, unsafe_index, opt_flags, linker_flags, filter_arg, cc, no_line_directives)
        }
        return rc
    }

    if cmd == "pkg" {
        return handle_pkg_command(argc, argv as @string, unsafe_index)
    }

    if cmd == "fmt" {
        return handle_fmt_cmd(argc, argv as @string)
    }

    println_str("[Velo Error] Unknown command: '{cmd}'. Run 'velo help' for usage.")
    return 1
}
