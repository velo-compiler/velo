# Normalize line endings so checksums, verbatim license text, and the
# bootstrap fixed point do not depend on which platform checked the tree out.
#
# `bootstrap.c` and the shipped licenses must be byte-identical everywhere:
# the release archive records their SHA-256, and the Apache-2.0 text is required
# to be verbatim. Working-tree line endings are never converted; git stores LF.
* text=auto eol=lf

# Windows batch files must keep CRLF for cmd.exe to parse them reliably.
*.bat text eol=crlf

# Binary assets: never touch.
*.png binary
*.ico binary
*.wav binary
*.exe binary
*.zip binary
*.gz binary
