// benchmark/server_velo.vl — High-performance Velo async HTTP benchmark server
use std.io
use std.async
use std.http

act on_http_request(ex: @AsyncHttpExchange, udata: @void) {
    if ex == null or ex.req.path == null { return }
    let path = ex.req.path

    if path == "/plaintext" {
        async_http_respond_text(ex, 200 as u16, "Hello, World!")
    } else if path == "/json" {
        async_http_respond_json(ex, 200 as u16, "{\"message\":\"Hello, World!\",\"status\":\"ok\"}")
    } else {
        async_http_respond_text(ex, 404 as u16, "Not Found")
    }
}

act main() -> i32 {
    let port: u16 = 8080
    mut el = loop_create()

    let server = async_http_listen(@el, "127.0.0.1", port, on_http_request, null)
    if server == null {
        io.println_str("[Velo] Failed to bind HTTP server to 127.0.0.1:8080")
        loop_free(@el)
        return 1
    }

    io.println_str("[Velo] Server listening on http://127.0.0.1:8080")
    loop_run(@el)

    async_http_server_close(server)
    loop_free(@el)
    return 0
}
