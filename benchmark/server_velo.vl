// benchmark/server_velo.vl — High-performance Velo async HTTP benchmark server
use std.io
use std.async
use std.http

act on_http_request(ex: @AsyncHttpExchange) {
    if ex == null or ex.req.path == null { return }
    let path = ex.req.path

    if path == "/plaintext" {
        async_http_respond_text(ex, 200 as u16, "Hello, World!")
    } else if path == "/json" {
        async_http_respond_json(ex, 200 as u16, "{\"message\":\"Hello, World!\",\"status\":\"ok\"}")
    } else {
        async_http_respond_text(ex, 404 as u16, "Not Found")
    }
}

act parse_port(s: string) -> u16 {
    if s == null { return 8080 as u16 }
    let len = str.len(s)
    if len == 0 { return 8080 as u16 }
    mut n: u16 = 0
    loop i in 0..len {
        let ch = s[i]
        if ch >= '0' and ch <= '9' {
            n = (n * (10 as u16)) + ((ch as u16) - ('0' as u16))
        }
    }
    if n == (0 as u16) { return 8080 as u16 }
    return n
}

act main(argc: i32, argv: @string) -> i32 {
    mut port: u16 = 8080 as u16
    if argc > 1 and argv[1] != null {
        port = parse_port(argv[1])
    }
    mut el = loop_create()

    let server = async_http_listen(@el, "127.0.0.1", port, on_http_request)
    if server == null {
        io.println("[Velo] Failed to bind HTTP server to 127.0.0.1:{port}")
        loop_free(@el)
        return 1
    }

    io.println("[Velo] Server listening on http://127.0.0.1:{port}")
    loop_run(@el)

    async_http_server_close(server)
    loop_free(@el)
    return 0
}
