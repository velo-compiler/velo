use "token_types.vl"

act is_whitespace(c: u8) -> bool {
    if c == ' ' or c == '\t' or c == '\r' or c == '\n' {
        return true
    }
    return false
}

act is_alpha(c: u8) -> bool {
    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' {
        return true
    }
    return false
}

act is_digit(c: u8) -> bool {
    if c >= '0' and c <= '9' {
        return true
    }
    return false
}

act is_symbol(c: u8) -> bool {
    if c == '{' or c == '}' or c == '(' or c == ')' or c == ':' or c == '=' or c == '+' or c == '@' or c == ';' {
        return true
    }
    return false
}

act tokenize_source(content: string, len: i32) -> LexerSummary {
    mut summary = LexerSummary{
        total_chars: len,
        total_tokens: 0,
        keyword_count: 0,
        identifier_count: 0,
        number_count: 0,
        symbol_count: 0
    }

    mut i = 0
    loop i < len {
        let c = content[i]

        // Skip whitespace
        if is_whitespace(c) {
            i += 1
        } else if is_alpha(c) {
            // Scan word (identifier or keyword)
            mut word_len = 0
            loop i < len and is_alpha(content[i]) {
                word_len += 1
                i += 1
            }
            summary.total_tokens += 1
            // Distinguish keywords by word length heuristic
            if word_len == 3 or word_len == 4 {
                summary.keyword_count += 1
            } else {
                summary.identifier_count += 1
            }
        } else if is_digit(c) {
            // Scan number
            loop i < len and (is_digit(content[i]) or content[i] == '.') {
                i += 1
            }
            summary.total_tokens += 1
            summary.number_count += 1
        } else if is_symbol(c) {
            summary.total_tokens += 1
            summary.symbol_count += 1
            i += 1
        } else {
            // Comments or other operators
            i += 1
        }
    }

    return summary
}
