// Example 16: Literal Formatting (Hex, Binary, Octal, Underscores, Scientific, Suffixes)
use sys.io

act main() {
    io.println("=== Milestone 1.3: Literal Formatting Test ===")

    // 1. Hexadecimal literals
    let hex_val = 0xFF
    let hex_color = 0xFF00AA55
    let hex_underscores = 0xAA_BB_CC_DD
    io.println("Hex 0xFF: {hex_val}")
    io.println("Hex 0xFF00AA55: {hex_color}")
    io.println("Hex with underscores 0xAA_BB_CC_DD: {hex_underscores}")

    // 2. Binary literals
    let bin_val = 0b1010
    let bin_byte = 0b1100_0011
    io.println("Binary 0b1010: {bin_val}")
    io.println("Binary 0b1100_0011: {bin_byte}")

    // 3. Octal literals
    let oct_val = 0o755
    let oct_small = 0o12
    io.println("Octal 0o755: {oct_val}")
    io.println("Octal 0o12: {oct_small}")

    // 4. Digit separators (Underscores)
    let one_million = 1_000_000
    let complex_num = 12_345_678
    io.println("One million 1_000_000: {one_million}")
    io.println("Formatted number 12_345_678: {complex_num}")

    // 5. Scientific notation
    let exp_small = 1e-4
    let exp_large = 2.5e3
    let exp_int = 1e2
    io.println("Scientific 1e-4: {exp_small}")
    io.println("Scientific 2.5e3: {exp_large}")
    io.println("Scientific 1e2: {exp_int}")

    // 6. Explicit literal suffixes
    let u8_val: u8 = 255u8
    let i64_val: i64 = 500i64
    let usize_val: usize = 1000usize
    let f32_val: f32 = 3.14f32
    let f64_val: f64 = 10.5f64
    let exp_suffixed = 1e-4f32

    io.println("Explicit suffix 255u8: {u8_val}")
    io.println("Explicit suffix 500i64: {i64_val}")
    io.println("Explicit suffix 1000usize: {usize_val}")
    io.println("Explicit suffix 3.14f32: {f32_val}")
    io.println("Explicit suffix 10.5f64: {f64_val}")
    io.println("Explicit suffix 1e-4f32: {exp_suffixed}")

    io.println("All literal formatting tests passed successfully!")
}
