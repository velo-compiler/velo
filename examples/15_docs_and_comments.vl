// Example 15: Nested Block Comments & Structured Documentation Comments
use sys.io

/*
  Outer multi-line block comment
  /*
    Nested level 1 comment
    /* Nested level 2 comment */
    Still in nested level 1
  */
  Back in outer comment
*/

/// 2D Vector coordinate blueprint.
/// Used for spatial transforms and rendering math.
data Vector2D {
    x: f32
    y: f32
}

/**
 * Creates a new 2D vector initialized with coordinates (x, y).
 */
act make_vector(x: f32, y: f32) -> Vector2D {
    /* inline comment */
    return Vector2D {
        x: x,
        y: y
    }
}

/// Computes the dot product of two 2D vectors.
act dot_product(a: Vector2D, b: Vector2D) -> f32 {
    return a.x * b.x + a.y * b.y
}

/* External C function bindings */
extern act puts(str: string) -> i32

act main() {
    io.println("=== Milestone 1.2: Comments & Documentation Test ===")

    /* Compute vector dot product */
    let v1 = make_vector(3.0, 4.0)
    let v2 = make_vector(2.0, 5.0)
    let dot = dot_product(v1, v2)

    io.println("Vector 1: ({v1.x}, {v1.y})")
    io.println("Vector 2: ({v2.x}, {v2.y})")
    io.println("Dot product: {dot}")

    puts("Puts: Native C call works!")
    io.println("All nested comment tests passed successfully!")
}
