use sys.io
use sys.fs
use sys.mem

act main() {
    io.println("--- Velo Milestone 2.2: Standard File I/O ---")

    let test_file = "velo_fs_test_temp.txt"
    let sample_payload = "Velo Native File System I/O Works!"

    // 1. Check non-existent file
    let before_exists = fs.exists(test_file)
    io.println("File exists before write: {before_exists}")

    // 2. Write file to disk
    let write_ok = fs.write_file(test_file, sample_payload)
    if write_ok {
        io.println("Successfully wrote payload to: {test_file}")
    }

    // 3. Check existence after write
    let after_exists = fs.exists(test_file)
    io.println("File exists after write: {after_exists}")

    // 4. Check file size
    let file_sz = fs.size(test_file)
    io.println("File size in bytes: {file_sz}")

    // 5. Read file contents and manage memory with defer
    let initial_heap = mem.heap_used()
    io.println("Heap before reading file: {initial_heap} bytes")

    let content = fs.read_file(test_file)
    if content != null {
        defer mem.free(content)

        let heap_with_buffer = mem.heap_used()
        io.println("Heap with read buffer active: {heap_with_buffer} bytes")

        io.println("Read file content: {content}")

        // 6. Test smart string comparison
        if content == sample_payload {
            io.println("Content match verified: read content == sample payload!")
        }
    }

    let heap_after_defer = mem.heap_used()
    io.println("Heap after buffer freed: {heap_after_defer} bytes (zero leaks!)")

    // 7. Non-existent file read check
    let missing_content = fs.read_file("completely_missing_file_xyz.txt")
    if missing_content == null {
        io.println("Missing file read returned null as expected")
    }

    // 8. Clean up temporary test file
    let remove_ok = fs.remove(test_file)
    let exists_after_remove = fs.exists(test_file)
    io.println("File exists after removal: {exists_after_remove}")

    io.println("--- Milestone 2.2 Complete! ---")
}
