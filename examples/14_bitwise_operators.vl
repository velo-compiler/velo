// Velo Milestone: Bitwise Operators & Bitmask Flags
use sys.io

act main() {
    io.println("--- Velo Milestone: Bitwise Operators ---")

    // 1. Basic Bitwise Operations
    let a: i32 = 12  // 0b1100
    let b: i32 = 10  // 0b1010

    let bit_and = a & b
    let bit_or = a | b
    let bit_xor = a ^ b
    let bit_shl = a << 2
    let bit_shr = a >> 1
    let bit_not = ~a

    io.println("a = {a}, b = {b}")
    io.println("a & b = {bit_and}")    // 12 & 10 = 8 (0b1000)
    io.println("a | b = {bit_or}")     // 12 | 10 = 14 (0b1110)
    io.println("a ^ b = {bit_xor}")    // 12 ^ 10 = 6 (0b0110)
    io.println("a << 2 = {bit_shl}")   // 12 << 2 = 48
    io.println("a >> 1 = {bit_shr}")   // 12 >> 1 = 6
    io.println("~a = {bit_not}")       // ~12 = -13

    // 2. Compound Bitwise Assignments
    mut x: i32 = 1
    x <<= 3  // 1 << 3 = 8
    io.println("After x <<= 3: {x}")

    x |= 3   // 8 | 3 = 11
    io.println("After x |= 3: {x}")

    x &= 9   // 11 (0b1011) & 9 (0b1001) = 9
    io.println("After x &= 9: {x}")

    x ^= 5   // 9 (0b1001) ^ 5 (0b0101) = 12 (0b1100)
    io.println("After x ^= 5: {x}")

    x >>= 2  // 12 >> 2 = 3
    io.println("After x >>= 2: {x}")

    // 3. Game Engine Pattern: Collision Layer Bitmasks
    let LAYER_WORLD: i32 = 1     // 1 << 0
    let LAYER_PLAYER: i32 = 2    // 1 << 1
    let LAYER_ENEMY: i32 = 4     // 1 << 2
    let LAYER_BULLET: i32 = 8    // 1 << 3

    mut player_mask: i32 = 0
    // Enable WORLD and ENEMY collision
    player_mask |= LAYER_WORLD
    player_mask |= LAYER_ENEMY
    io.println("Player collision mask: {player_mask}")

    // Check collision with ENEMY
    if (player_mask & LAYER_ENEMY) != 0 {
        io.println("Player can collide with ENEMY: true")
    } else {
        io.println("Player can collide with ENEMY: false")
    }

    // Check collision with BULLET
    if (player_mask & LAYER_BULLET) != 0 {
        io.println("Player can collide with BULLET: true")
    } else {
        io.println("Player can collide with BULLET: false")
    }

    // Disable ENEMY collision using &= ~LAYER_ENEMY
    player_mask &= ~LAYER_ENEMY
    if (player_mask & LAYER_ENEMY) == 0 {
        io.println("Player collision with ENEMY disabled: true")
    }

    io.println("--- Bitwise Operators Verified! ---")
}
