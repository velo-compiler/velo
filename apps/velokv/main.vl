// VeloKV — High-Performance Zero-GC Redis-Compatible In-Memory Key-Value Database in Velo.

use sys.io
use sys.mem
use sys.time
use "net.vl"
use "resp.vl"
use "store.vl"
use "command.vl"
use "aof.vl"

act print_banner(port: i32, aof_enabled: bool) {
    io.println("                _       _  ____      __")
    io.println(" __   _____| | ___ | |/ /\\ \\    / /")
    io.println(" \\ \\ / / _ \\ |/ _ \\| ' /  \\ \\  / / ")
    io.println("  \\ V /  __/ | (_) | . \\   \\ \\/ /  ")
    io.println("   \\_/ \\___|_|\\___/|_|\\_\\   \\__/   ")
    io.println("")
    io.println("=== VeloKV In-Memory Key-Value Database v1.0 ===")
    io.println("[*] Engine: Velo Systems Language (Zero-GC Native C99)")
    io.println("[*] Memory: Hardware Zone Arena (1-cycle instant reset)")
    io.println("[*] Protocol: Standard Redis Wire Protocol (RESP2)")
    io.println("[*] Listening on TCP port: {port}")
    if aof_enabled {
        io.println("[*] Persistence: Append-Only File (AOF) ENABLED (velokv.aof)")
    } else {
        io.println("[*] Persistence: In-Memory Only")
    }
    io.println("[*] Ready to accept client connections (redis-cli, Python, Go, Node.js)")
    io.println("--------------------------------------------------")
}

use sys.os

act main() -> i32 {
    mut port: i32 = 6389
    let args = os.args()
    if args.len > 1 {
        let p_arg = args[1]
        let parsed = parse_int(p_arg) as i32
        if parsed > 0 {
            port = parsed
        }
    }
    mut aof_enabled = true

    if not net_init() {
        io.println("[VeloKV Error] Failed to initialize TCP networking!")
        return 1
    }

    mut server_net = net_start_server(port, 64)
    if server_net.server_fd < 0 {
        port += 1
        server_net = net_start_server(port, 64)
        if server_net.server_fd < 0 {
            io.println("[VeloKV Error] Could not bind TCP server to port!")
            net_shutdown()
            return 1
        }
    }

    print_banner(port, aof_enabled)

    mut store = store_init(16384)
    mut aof = aof_open("velokv.aof", aof_enabled)

    if aof_enabled {
        let replayed = aof_replay("velokv.aof", @store)
        if replayed > 0 {
            io.println("[VeloKV AOF] Replayed {replayed} persistent commands from velokv.aof")
        }
    }

    mut running = true
    mut loop_counter: i64 = 0
    mut idle_spins: i32 = 0

    loop running {
        loop_counter += 1

        // 1. Accept incoming client connections
        let new_slot = net_poll_accept(@server_net)
        if new_slot >= 0 {
            let client = @server_net.clients[new_slot as usize]
            let rport = client.remote_port
            io.println("[VeloKV Client] Accepted connection: slot={new_slot}, port={rport}")
        }

        // 2. Poll and serve active client connections
        mut had_activity = false
        mut ci: usize = 0
        loop ci < (server_net.max_clients as usize) {
            let client = @server_net.clients[ci]
            if client.active {
                let bytes_read = net_read_client(client)
                if bytes_read > 0 {
                    had_activity = true

                    // Process all complete commands in client buffer using zone arena
                    mut process_more = true
                    loop process_more and client.read_len > 0 {
                        // Hardware Zone Arena Memory Scope:
                        // All temporary parsing strings, token arrays, and response strings
                        // are allocated on the bump arena and popped in 1 CPU cycle!
                        zone 65536 {
                            let cmd = parse_redis_command(client.read_buf, client.read_len)
                            if cmd.valid and cmd.consumed_bytes > 0 {
                                let response = execute_command(@cmd, @store, @aof)
                                net_send_response(client, response)

                                // Shift remaining bytes in read buffer
                                let consumed = cmd.consumed_bytes
                                let remaining = client.read_len - consumed
                                if remaining > 0 {
                                    mut bi: usize = 0
                                    loop bi < (remaining as usize) {
                                        client.read_buf[bi] = client.read_buf[(consumed as usize) + bi]
                                        bi += 1
                                    }
                                }
                                client.read_len = remaining
                            } else {
                                process_more = false
                            }
                        }
                    }
                } else if bytes_read == -2 {
                    // Client cleanly disconnected
                    io.println("[VeloKV Client] Disconnected: slot={ci}")
                    net_close_client(@server_net, ci as i32)
                }
            }
            ci += 1
        }

        // 3. Adaptive yielding: spin 500 times for low latency, then sleep 1ms
        if not had_activity and new_slot < 0 {
            idle_spins += 1
            if idle_spins > 500 {
                time.sleep_ms(1)
            }
        } else {
            idle_spins = 0
        }
    }

    aof_close(@aof)
    net_shutdown()
    return 0
}
