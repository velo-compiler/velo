// VeloKV Append-Only File (AOF) Persistence Logger & Replay Engine

use sys.fs
use sys.io
use "store.vl"
use "resp.vl"

view data AofLogger {
    filename: string
    file_handle: @File
    enabled: bool
    writes_count: i64
}

view act aof_open(filename: string, enabled: bool) -> AofLogger {
    mut aof: AofLogger
    aof.filename = filename
    aof.enabled = enabled
    aof.writes_count = 0

    if enabled {
        let handle: @File = fs.fopen(filename, "ab")
        aof.file_handle = handle
    }
    return aof
}

view extern act fflush(stream: @File) -> i32

view act aof_log_command(aof: @AofLogger, cmd: string) {
    if not aof.enabled { return }
    let ok = fs.fwrite(aof.file_handle, cmd)
    if ok {
        fflush(aof.file_handle)
        aof.writes_count += 1
    }
}

view act aof_close(aof: @AofLogger) {
    if aof.enabled {
        fs.fclose(aof.file_handle)
    }
}

// Replays AOF on startup: reads file, executes commands to reconstruct in-memory state
view act aof_replay(filename: string, store: @KeyValueStore) -> i32 {
    if not fs.exists(filename) {
        return 0
    }

    let content = fs.read_file(filename)
    let len = str.len(content)
    if len == 0 { return 0 }

    let bytes = content as @u8
    mut offset: i32 = 0
    mut replayed: i32 = 0

    loop offset < (len as i32) {
        let sub_ptr = (bytes as usize + offset as usize) as @u8
        let remaining = (len as i32) - offset

        let cmd = parse_redis_command(sub_ptr, remaining)
        if not cmd.valid or cmd.consumed_bytes <= 0 {
            break
        }

        // Execute mutating command
        if cmd.argc >= 3 and (cmd.args[0] == "SET" or cmd.args[0] == "set") {
            let key = cmd.args[1]
            let val = cmd.args[2]
            store_set(store, key, val, 0)
            replayed += 1
        } else if cmd.argc >= 2 and (cmd.args[0] == "DEL" or cmd.args[0] == "del") {
            let key = cmd.args[1]
            store_del(store, key)
            replayed += 1
        } else if cmd.argc >= 1 and (cmd.args[0] == "FLUSHDB" or cmd.args[0] == "flushdb") {
            store_flushdb(store)
            replayed += 1
        }

        offset += cmd.consumed_bytes
    }

    return replayed
}
