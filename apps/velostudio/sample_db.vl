// VeloStudio Sample Relational Database Generator (demo.db)
use "sqlite.vl"

act create_sample_database(filename: string) -> bool {
    let db = sqlite_open_db(filename)
    if db == 0 { return false }

    // 1. Users Table
    let sql_users = "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, name TEXT, email TEXT, department TEXT, salary REAL);"
    sqlite_execute_raw(db, sql_users)

    sqlite_execute_raw(db, "INSERT INTO users VALUES (1, 'Alice Chen', 'alice@velolang.org', 'Engineering', 142000.0);")
    sqlite_execute_raw(db, "INSERT INTO users VALUES (2, 'Marcus Vance', 'marcus@infra.net', 'DevOps', 138000.0);")
    sqlite_execute_raw(db, "INSERT INTO users VALUES (3, 'Sophia Rossi', 'sophia@design.io', 'Product', 125000.0);")
    sqlite_execute_raw(db, "INSERT INTO users VALUES (4, 'David Kim', 'david@security.com', 'Security', 155000.0);")
    sqlite_execute_raw(db, "INSERT INTO users VALUES (5, 'Elena Rostova', 'elena@systems.org', 'Core Compiler', 168000.0);")
    sqlite_execute_raw(db, "INSERT INTO users VALUES (6, 'Liam Thorne', 'liam@qa.tech', 'QA Engineering', 115000.0);")
    sqlite_execute_raw(db, "INSERT INTO users VALUES (7, 'Zoe Washington', 'zoe@ai.corp', 'Data Science', 149000.0);")
    sqlite_execute_raw(db, "INSERT INTO users VALUES (8, 'Hiroshi Tanaka', 'hiroshi@perf.jp', 'Optimization', 162000.0);")

    // 2. Products Table
    let sql_prods = "CREATE TABLE IF NOT EXISTS products (id INTEGER PRIMARY KEY, title TEXT, category TEXT, price REAL, stock INTEGER);"
    sqlite_execute_raw(db, sql_prods)

    sqlite_execute_raw(db, "INSERT INTO products VALUES (101, 'Velo Compiler Pro', 'Developer Tools', 299.00, 500);")
    sqlite_execute_raw(db, "INSERT INTO products VALUES (102, 'VeloKV Enterprise Cache', 'Database', 599.00, 250);")
    sqlite_execute_raw(db, "INSERT INTO products VALUES (103, 'Hardware Zone Profiler', 'Diagnostics', 149.00, 1200);")
    sqlite_execute_raw(db, "INSERT INTO products VALUES (104, 'Zero-Electron GUI Kit', 'UI Framework', 199.00, 850);")
    sqlite_execute_raw(db, "INSERT INTO products VALUES (105, 'Raylib 3D Shader Engine', 'Graphics', 89.00, 2100);")
    sqlite_execute_raw(db, "INSERT INTO products VALUES (106, 'Async Winsock Gateway', 'Networking', 349.00, 420);")

    // 3. Orders Table
    let sql_orders = "CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY, user_id INTEGER, product_id INTEGER, quantity INTEGER, status TEXT);"
    sqlite_execute_raw(db, sql_orders)

    sqlite_execute_raw(db, "INSERT INTO orders VALUES (1001, 1, 101, 2, 'COMPLETED');")
    sqlite_execute_raw(db, "INSERT INTO orders VALUES (1002, 2, 102, 1, 'COMPLETED');")
    sqlite_execute_raw(db, "INSERT INTO orders VALUES (1003, 3, 104, 3, 'PENDING');")
    sqlite_execute_raw(db, "INSERT INTO orders VALUES (1004, 4, 103, 1, 'PROCESSING');")
    sqlite_execute_raw(db, "INSERT INTO orders VALUES (1005, 5, 101, 5, 'COMPLETED');")
    sqlite_execute_raw(db, "INSERT INTO orders VALUES (1006, 7, 106, 1, 'SHIPPED');")
    sqlite_execute_raw(db, "INSERT INTO orders VALUES (1007, 8, 105, 4, 'COMPLETED');")

    // 4. Performance Logs Table
    let sql_logs = "CREATE TABLE IF NOT EXISTS telemetry_logs (id INTEGER PRIMARY KEY, component TEXT, latency_us INTEGER, status_code INTEGER);"
    sqlite_execute_raw(db, sql_logs)

    sqlite_execute_raw(db, "INSERT INTO telemetry_logs VALUES (1, 'VeloKV_SET', 42, 200);")
    sqlite_execute_raw(db, "INSERT INTO telemetry_logs VALUES (2, 'VeloKV_GET', 18, 200);")
    sqlite_execute_raw(db, "INSERT INTO telemetry_logs VALUES (3, 'AOF_SYNC', 125, 200);")
    sqlite_execute_raw(db, "INSERT INTO telemetry_logs VALUES (4, 'ZONE_POP', 1, 200);")
    sqlite_execute_raw(db, "INSERT INTO telemetry_logs VALUES (5, 'SQLITE_QUERY', 230, 200);")

    sqlite_close_db(db)
    return true
}
