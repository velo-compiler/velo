// VeloStudio Raylib 5.0 C-FFI Windowing, Input & 2D Graphics Engine

view data Color {
    r: u8
    g: u8
    b: u8
    a: u8
}

view act make_color(r: u8, g: u8, b: u8, a: u8) -> Color {
    return Color{ r: r, g: g, b: b, a: a }
}

view data Vector2 {
    x: f32
    y: f32
}

view data Texture2D {
    id: u32
    width: i32
    height: i32
    mipmaps: i32
    format: i32
}

view data Font {
    baseSize: i32
    glyphCount: i32
    glyphPadding: i32
    texture: Texture2D
    recs: usize
    glyphs: usize
}

// Window Management
view extern act InitWindow(width: i32, height: i32, title: string) -> void
view extern act CloseWindow() -> void
view extern act WindowShouldClose() -> bool
view extern act SetTargetFPS(fps: i32) -> void
view extern act SetWindowTitle(title: string) -> void
view extern act GetFPS() -> i32

// Timing
view extern act GetFrameTime() -> f32
view extern act GetTime() -> f64

// Drawing Lifecycle
view extern act BeginDrawing() -> void
view extern act EndDrawing() -> void
view extern act ClearBackground(color: Color) -> void

// Shapes & Primitives
view extern act DrawRectangle(posX: i32, posY: i32, width: i32, height: i32, color: Color) -> void
view extern act DrawRectangleLines(posX: i32, posY: i32, width: i32, height: i32, color: Color) -> void
view extern act DrawLine(startPosX: i32, startPosY: i32, endPosX: i32, endPosY: i32, color: Color) -> void
view extern act DrawCircle(centerX: i32, centerY: i32, radius: f32, color: Color) -> void

// Typography (Bitmap & Vector TrueType Fonts)
view extern act DrawText(text: string, posX: i32, posY: i32, fontSize: i32, color: Color) -> void
view extern act MeasureText(text: string, fontSize: i32) -> i32
view extern act LoadFontEx(fileName: string, fontSize: i32, fontChars: usize, glyphCount: i32) -> Font
view extern act SetTextureFilter(texture: Texture2D, filter: i32) -> void
view extern act DrawTextEx(font: Font, text: string, position: Vector2, fontSize: f32, spacing: f32, tint: Color) -> void
view extern act MeasureTextEx(font: Font, text: string, fontSize: f32, spacing: f32) -> Vector2
view extern act UnloadFont(font: Font) -> void

view act draw_ui_text(font: Font, text: string, posX: i32, posY: i32, fontSize: f32, color: Color) {
    let pos = Vector2{ x: posX as f32, y: posY as f32 }
    DrawTextEx(font, text, pos, fontSize, 1.0, color)
}

view act measure_ui_text_width(font: Font, text: string, fontSize: f32) -> i32 {
    let sz = MeasureTextEx(font, text, fontSize, 1.0)
    return sz.x as i32
}

// Mouse Input
view extern act GetMouseX() -> i32
view extern act GetMouseY() -> i32
view extern act IsMouseButtonPressed(button: i32) -> bool
view extern act IsMouseButtonDown(button: i32) -> bool
view extern act GetMouseWheelMove() -> f32

// Keyboard Input
view extern act IsKeyPressed(key: i32) -> bool
view extern act IsKeyDown(key: i32) -> bool
view extern act GetCharPressed() -> i32

// Input Constants
view let MOUSE_BUTTON_LEFT: i32 = 0
view let MOUSE_BUTTON_RIGHT: i32 = 1

view let KEY_BACKSPACE: i32 = 259
view let KEY_ENTER: i32 = 257
view let KEY_ESCAPE: i32 = 256
view let KEY_TAB: i32 = 258
view let KEY_RIGHT: i32 = 262
view let KEY_LEFT: i32 = 263
view let KEY_DOWN: i32 = 264
view let KEY_UP: i32 = 265
view let KEY_DELETE: i32 = 261
view let KEY_HOME: i32 = 268
view let KEY_END: i32 = 269

// File Drag & Drop
view data FilePathList {
    count: u32
    paths: @string
}

view extern act IsFileDropped() -> bool
view extern act LoadDroppedFiles() -> FilePathList
view extern act UnloadDroppedFiles(files: FilePathList) -> void

