{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Velo Package Manifest",
  "scopeName": "source.velo.pkg",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#blocks" },
    { "include": "#protocols" },
    { "include": "#properties" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.velo",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.velo",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.velo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.velo",
              "match": "\\\\[\\\\\"nrt]"
            }
          ]
        }
      ]
    },
    "blocks": {
      "patterns": [
        {
          "match": "\\b(pkg)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.declaration.block.pkg.velo" },
            "2": { "name": "string.quoted.double.package.name.velo" }
          }
        },
        {
          "name": "keyword.declaration.block.velo",
          "match": "\\b(pkg|deps|link)\\b"
        }
      ]
    },
    "protocols": {
      "patterns": [
        {
          "name": "keyword.other.protocol.velo",
          "match": "\\b(git|local)\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "\\b(version|entry|authors|description|license|libs|flags)\\b(?=\\s*:)",
          "name": "support.type.property-name.velo"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\b(?=\\s*:)",
          "name": "variable.other.property.dependency.velo"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.at.velo",
          "match": "@"
        },
        {
          "name": "punctuation.separator.key-value.colon.velo",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.velo",
          "match": ","
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.curly.velo",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.square.velo",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}

